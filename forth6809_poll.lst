E1CA 7EE403           (    forth6809.asm):03782                     JMP   THROWW
                      (    forth6809.asm):03783         
                      (    forth6809.asm):03784         ; ------------------------------------------------------------
                      (    forth6809.asm):03785         ; Multiply the unsigned double ud on the data stack by BASE and add a
                      (    forth6809.asm):03786         ; digit. (5m: the accumulator lives on the data stack, in the frame of
                      (    forth6809.asm):03787         ; >NUMBER, so no page-zero cells are needed.)
                      (    forth6809.asm):03788         ; UDMULADD
                      (    forth6809.asm):03789         ;    Inputs:
                      (    forth6809.asm):03790         ;        ud at 4,U (high cell) and 6,U (low cell), as in the >NUMBER
                      (    forth6809.asm):03791         ;        frame ( ud c-addr u )
                      (    forth6809.asm):03792         ;        RegB = digit value to add
                      (    forth6809.asm):03793         ;        BASE
                      (    forth6809.asm):03794         ;    Outputs:
                      (    forth6809.asm):03795         ;        ud = ud * BASE + digit
                      (    forth6809.asm):03796         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):03797         ; ------------------------------------------------------------
E1CD 327E             (    forth6809.asm):03798         UDMULADD:   LEAS  -2,S              ; 0,S = carry, 1,S = BASE multiplier
E1CF E7E4             (    forth6809.asm):03799                     STB   ,S
E1D1 9603             (    forth6809.asm):03800                     LDA   BASE+1
E1D3 A761             (    forth6809.asm):03801                     STA   1,S
E1D5 A647             (    forth6809.asm):03802                     LDA   7,U
E1D7 E661             (    forth6809.asm):03803                     LDB   1,S
E1D9 3D               (    forth6809.asm):03804                     MUL
E1DA EBE4             (    forth6809.asm):03805                     ADDB  ,S
E1DC 2401             (    forth6809.asm):03806                     BCC   UM0
E1DE 4C               (    forth6809.asm):03807                     INCA
E1DF E747             (    forth6809.asm):03808         UM0:        STB   7,U
E1E1 A7E4             (    forth6809.asm):03809                     STA   ,S
E1E3 A646             (    forth6809.asm):03810                     LDA   6,U
E1E5 E661             (    forth6809.asm):03811                     LDB   1,S
E1E7 3D               (    forth6809.asm):03812                     MUL
E1E8 EBE4             (    forth6809.asm):03813                     ADDB  ,S
E1EA 2401             (    forth6809.asm):03814                     BCC   UM1
E1EC 4C               (    forth6809.asm):03815                     INCA
E1ED E746             (    forth6809.asm):03816         UM1:        STB   6,U
E1EF A7E4             (    forth6809.asm):03817                     STA   ,S
E1F1 A645             (    forth6809.asm):03818                     LDA   5,U
E1F3 E661             (    forth6809.asm):03819                     LDB   1,S
E1F5 3D               (    forth6809.asm):03820                     MUL
E1F6 EBE4             (    forth6809.asm):03821                     ADDB  ,S
E1F8 2401             (    forth6809.asm):03822                     BCC   UM2
E1FA 4C               (    forth6809.asm):03823                     INCA
E1FB E745             (    forth6809.asm):03824         UM2:        STB   5,U
E1FD A7E4             (    forth6809.asm):03825                     STA   ,S
E1FF A644             (    forth6809.asm):03826                     LDA   4,U
E201 E661             (    forth6809.asm):03827                     LDB   1,S
E203 3D               (    forth6809.asm):03828                     MUL
E204 EBE4             (    forth6809.asm):03829                     ADDB  ,S
E206 2401             (    forth6809.asm):03830                     BCC   UM3
E208 4C               (    forth6809.asm):03831                     INCA
E209 E744             (    forth6809.asm):03832         UM3:        STB   4,U
E20B 3262             (    forth6809.asm):03833                     LEAS  2,S
E20D 39               (    forth6809.asm):03834                     RTS
                      (    forth6809.asm):03835         
                      (    forth6809.asm):03836         ; ------------------------------------------------------------
                      (    forth6809.asm):03837         ; >NUMBER  ( ud1 c-addr1 u1 -- ud2 c-addr2 u2 )
                      (    forth6809.asm):03838         ; Convert the string into ud1, in BASE, stopping at the first
                      (    forth6809.asm):03839         ; unconvertible character. Returns the accumulated ud2 and the
                      (    forth6809.asm):03840         ; remaining string. The conversion works in place on the three
                      (    forth6809.asm):03841         ; parameters (NUMLOOP), which are also the frame NUMBERQ builds.
                      (    forth6809.asm):03842         ; NUMLOOP
                      (    forth6809.asm):03843         ;    Inputs:
                      (    forth6809.asm):03844         ;        ( ud c-addr u ) on the data stack
                      (    forth6809.asm):03845         ;    Outputs:
                      (    forth6809.asm):03846         ;        ud accumulated; c-addr u = first unconverted character and
                      (    forth6809.asm):03847         ;        the count remaining
                      (    forth6809.asm):03848         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):03849         ; ------------------------------------------------------------
E20E                  (    forth6809.asm):03850         TONUMBERW:
E20E ECC4             (    forth6809.asm):03851         NUMLOOP:    LDD   ,U
E210 2734             (    forth6809.asm):03852                     BEQ   NLDONE
E212 AE42             (    forth6809.asm):03853                     LDX   2,U
E214 A684             (    forth6809.asm):03854                     LDA   ,X
E216 8130             (    forth6809.asm):03855                     CMPA  #'0'
E218 252C             (    forth6809.asm):03856                     BLO   NLDONE
E21A 8139             (    forth6809.asm):03857                     CMPA  #'9'
E21C 2204             (    forth6809.asm):03858                     BHI   NLALPHA
E21E 8030             (    forth6809.asm):03859                     SUBA  #'0'
E220 200C             (    forth6809.asm):03860                     BRA   NLGOT
E222 84DF             (    forth6809.asm):03861         NLALPHA:    ANDA  #$DF
E224 8141             (    forth6809.asm):03862                     CMPA  #'A'
E226 251E             (    forth6809.asm):03863                     BLO   NLDONE
E228 815A             (    forth6809.asm):03864                     CMPA  #'Z'
E22A 221A             (    forth6809.asm):03865                     BHI   NLDONE
E22C 8037             (    forth6809.asm):03866                     SUBA  #'A'-10
E22E 9103             (    forth6809.asm):03867         NLGOT:      CMPA  BASE+1
E230 2414             (    forth6809.asm):03868                     BHS   NLDONE
E232 1F89             (    forth6809.asm):03869                     TFR   A,B
E234 BDE1CD           (    forth6809.asm):03870                     JSR   UDMULADD
E237 AE42             (    forth6809.asm):03871                     LDX   2,U
E239 3001             (    forth6809.asm):03872                     LEAX  1,X
E23B AF42             (    forth6809.asm):03873                     STX   2,U
E23D ECC4             (    forth6809.asm):03874                     LDD   ,U
E23F 830001           (    forth6809.asm):03875                     SUBD  #1
E242 EDC4             (    forth6809.asm):03876                     STD   ,U
E244 20C8             (    forth6809.asm):03877                     BRA   NUMLOOP
E246 39               (    forth6809.asm):03878         NLDONE:     RTS
                      (    forth6809.asm):03879         
                      (    forth6809.asm):03880         ; ------------------------------------------------------------
                      (    forth6809.asm):03881         ; Convert a counted string to a number in BASE. A leading "-" negates
                      (    forth6809.asm):03882         ; it; a trailing "." makes it a double-cell number.
                      (    forth6809.asm):03883         ; NUMBERQ   ( c-addr -- n -1 | ud 1 | c-addr 0 )
                      (    forth6809.asm):03884         ;    Inputs:
                      (    forth6809.asm):03885         ;        c-addr of the counted string on the data stack
                      (    forth6809.asm):03886         ;    Outputs:
                      (    forth6809.asm):03887         ;        single number: n and -1
                      (    forth6809.asm):03888         ;        double number: ud (low cell below high cell) and 1
                      (    forth6809.asm):03889         ;        not a number: c-addr and 0
                      (    forth6809.asm):03890         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):03891         ; The original c-addr and the negate flag live in an S frame (0,S and
                      (    forth6809.asm):03892         ; 2,S); the count is kept in RegB. See shadow NUMBERQ.1 and
                      (    forth6809.asm):03893         ; NUMBERQ.6.
                      (    forth6809.asm):03894         ; ------------------------------------------------------------
E247 3710             (    forth6809.asm):03895         NUMBERQ:    PULU  X                 ; c-addr
E249 327D             (    forth6809.asm):03896                     LEAS  -3,S
E24B AFE4             (    forth6809.asm):03897                     STX   ,S
E24D E684             (    forth6809.asm):03898                     LDB   ,X
E24F 276D             (    forth6809.asm):03899                     BEQ   NQBAD

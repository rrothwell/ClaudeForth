E52E 3606             (    forth6809.asm):04103                     PSHU  D
E530 BDE85D           (    forth6809.asm):04104                     JSR   CCALL
E533 CC0000           (    forth6809.asm):04105                     LDD   #0
E536 3606             (    forth6809.asm):04106                     PSHU  D
E538 BDDDA2           (    forth6809.asm):04107                     JSR   CODECOMMA
E53B DC08             (    forth6809.asm):04108                     LDD   CODEHERE
E53D 830002           (    forth6809.asm):04109                     SUBD  #2
E540 3606             (    forth6809.asm):04110                     PSHU  D                 ; orig
E542 CC0001           (    forth6809.asm):04111                     LDD   #TAGFWD
E545 3606             (    forth6809.asm):04112                     PSHU  D
E547 39               (    forth6809.asm):04113                     RTS
                      (    forth6809.asm):04114         
                      (    forth6809.asm):04115         ; ------------------------------------------------------------
                      (    forth6809.asm):04116         ; REPEAT  ( C: orig dest -- )
                      (    forth6809.asm):04117         ; Compile BRANCH back to the BEGIN address and resolve the WHILE
                      (    forth6809.asm):04118         ; branch to just after it. A BEGIN frame beneath further open WHILE
                      (    forth6809.asm):04119         ; frames is found by scanning, and removed from beneath them.
                      (    forth6809.asm):04120         ; ------------------------------------------------------------
E548 3706             (    forth6809.asm):04121         REPEATW:    PULU  D
E54A 10830001         (    forth6809.asm):04122                     CMPD  #TAGFWD
E54E 2703             (    forth6809.asm):04123                     BEQ   RPOK1
E550 BDE3ED           (    forth6809.asm):04124                     JSR   CFERR
E553 3710             (    forth6809.asm):04125         RPOK1:      PULU  X                 ; orig
E555 3410             (    forth6809.asm):04126                     PSHS  X                 ; 2,S = orig (5k: S-frame)
                      (    forth6809.asm):04127         
                      (    forth6809.asm):04128                     ; Find the BEGIN frame, scanning past any open TAGFWD frames.
                      (    forth6809.asm):04129                     ; See bugfix: REPEATW.1
E557 3040             (    forth6809.asm):04130                     LEAX  0,U               ; scan from top of control stack
E559 9F16             (    forth6809.asm):04131                     STX   MSCR2             ; MSCR2 = base of scan region
E55B 9F1A             (    forth6809.asm):04132                     STX   MSCR4             ; MSCR4 = scan pointer
E55D DC1A             (    forth6809.asm):04133         RPSCAN:     LDD   MSCR4
E55F 109321           (    forth6809.asm):04134                     CMPD  CSP
E562 2603             (    forth6809.asm):04135                     BNE   RPSCANOK
E564 BDE3ED           (    forth6809.asm):04136                     JSR   CFERR             ; no matching BEGIN
E567 9E1A             (    forth6809.asm):04137         RPSCANOK:   LDX   MSCR4
E569 EC84             (    forth6809.asm):04138                     LDD   ,X
E56B 10830002         (    forth6809.asm):04139                     CMPD  #TAGBACK
E56F 2712             (    forth6809.asm):04140                     BEQ   RPFOUND
E571 10830001         (    forth6809.asm):04141                     CMPD  #TAGFWD
E575 2703             (    forth6809.asm):04142                     BEQ   RPSKIP
E577 BDE3ED           (    forth6809.asm):04143                     JSR   CFERR             ; anything else is a genuine mismatch
E57A DC1A             (    forth6809.asm):04144         RPSKIP:     LDD   MSCR4
E57C C30004           (    forth6809.asm):04145                     ADDD  #4
E57F DD1A             (    forth6809.asm):04146                     STD   MSCR4
E581 20DA             (    forth6809.asm):04147                     BRA   RPSCAN
E583 9E1A             (    forth6809.asm):04148         RPFOUND:    LDX   MSCR4             ; X = found BEGIN frame
E585 EC02             (    forth6809.asm):04149                     LDD   2,X               ; dest = BEGIN's address
E587 3406             (    forth6809.asm):04150                     PSHS  D                 ; 0,S = dest
                      (    forth6809.asm):04151         
                      (    forth6809.asm):04152                     ; Close the gap: move the frames above the BEGIN frame down 4
                      (    forth6809.asm):04153                     ; bytes, highest word first.
E589 DC1A             (    forth6809.asm):04154                     LDD   MSCR4
E58B 9316             (    forth6809.asm):04155                     SUBD  MSCR2
E58D DD18             (    forth6809.asm):04156                     STD   MSCR3             ; MSCR3 = bytes to shift
E58F 2715             (    forth6809.asm):04157                     BEQ   RPSHIFTDONE
E591 DC18             (    forth6809.asm):04158         RPSHIFT:    LDD   MSCR3
E593 830002           (    forth6809.asm):04159                     SUBD  #2
E596 DD18             (    forth6809.asm):04160                     STD   MSCR3
E598 9E16             (    forth6809.asm):04161                     LDX   MSCR2
E59A 308B             (    forth6809.asm):04162                     LEAX  D,X               ; X = MSCR2 + this pass's offset
E59C EC84             (    forth6809.asm):04163                     LDD   ,X
E59E 3004             (    forth6809.asm):04164                     LEAX  4,X
E5A0 ED84             (    forth6809.asm):04165                     STD   ,X                ; copy one word 4 bytes higher
E5A2 DC18             (    forth6809.asm):04166                     LDD   MSCR3
E5A4 26EB             (    forth6809.asm):04167                     BNE   RPSHIFT
E5A6                  (    forth6809.asm):04168         RPSHIFTDONE:
E5A6 9E16             (    forth6809.asm):04169                     LDX   MSCR2
E5A8 3004             (    forth6809.asm):04170                     LEAX  4,X
E5AA 1F13             (    forth6809.asm):04171                     TFR   X,U               ; U now excludes BEGIN frame
                      (    forth6809.asm):04172         
E5AC CCDD2E           (    forth6809.asm):04173                     LDD   #BRANCH
E5AF 3606             (    forth6809.asm):04174                     PSHU  D
E5B1 BDE85D           (    forth6809.asm):04175                     JSR   CCALL
E5B4 CC0000           (    forth6809.asm):04176                     LDD   #0
E5B7 3606             (    forth6809.asm):04177                     PSHU  D
E5B9 BDDDA2           (    forth6809.asm):04178                     JSR   CODECOMMA
E5BC EC60             (    forth6809.asm):04179                     LDD   0,S               ; target = BEGIN's address
E5BE 3606             (    forth6809.asm):04180                     PSHU  D
E5C0 DC08             (    forth6809.asm):04181                     LDD   CODEHERE
E5C2 830002           (    forth6809.asm):04182                     SUBD  #2                ; location = the operand just compiled
E5C5 3606             (    forth6809.asm):04183                     PSHU  D

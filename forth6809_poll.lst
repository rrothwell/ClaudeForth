DEF0 AF44             (    forth6809.asm):05684                     STX   4,U
DEF2 39               (    forth6809.asm):05685                     RTS
                      (    forth6809.asm):05686         
                      (    forth6809.asm):05687         ; ------------------------------------------------------------
                      (    forth6809.asm):05688         ; ?DUP  ( x -- 0 | x x )
                      (    forth6809.asm):05689         ; Duplicate the top cell if it is non-zero.
                      (    forth6809.asm):05690         ; ------------------------------------------------------------
DEF3 ECC4             (    forth6809.asm):05691         QDUPW:      LDD   ,U                ; x

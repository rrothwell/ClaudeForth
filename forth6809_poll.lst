D884 C41F             (    forth6809.asm):03679                     ANDB  #$1F
D886 3001             (    forth6809.asm):03680                     LEAX  1,X
D888 3A               (    forth6809.asm):03681                     ABX
D889 AE02             (    forth6809.asm):03682                     LDX   2,X               ; CFA field
D88B 39               (    forth6809.asm):03683                     RTS

E310 B7C009           (    forth6809.asm):04113                     STA   ACIADR
E313 39               (    forth6809.asm):04114                     RTS
                      (    forth6809.asm):04115         
                      (    forth6809.asm):04116         ; ------------------------------------------------------------
                      (    forth6809.asm):04117         ; KEY?  ( -- flag )  [polling build]
                      (    forth6809.asm):04118         ; Return true if the ACIA has a received character (RDRF set).
                      (    forth6809.asm):04119         ; ------------------------------------------------------------
E314 B6C008           (    forth6809.asm):04120         KEYQW:      LDA   ACIASR
E317 8501             (    forth6809.asm):04121                     BITA  #SR_RDRF
E319 2706             (    forth6809.asm):04122                     BEQ   KQFALSE
E31B CCFFFF           (    forth6809.asm):04123                     LDD   #TRUEV
E31E 3606             (    forth6809.asm):04124                     PSHU  D                 ; flag = true
E320 39               (    forth6809.asm):04125                     RTS
E321 CC0000           (    forth6809.asm):04126         KQFALSE:    LDD   #FALSEV
E324 3606             (    forth6809.asm):04127                     PSHU  D                 ; flag = false
E326 39               (    forth6809.asm):04128                     RTS
                      (    forth6809.asm):04129         
                      (    forth6809.asm):04130         ; ------------------------------------------------------------
                      (    forth6809.asm):04131         ; EMIT  ( char -- )  [polling build]
                      (    forth6809.asm):04132         ; Wait for TDRE, then transmit char directly.
                      (    forth6809.asm):04133         ; ------------------------------------------------------------
E327 3706             (    forth6809.asm):04134         EMITW:      PULU  D                 ; char
E329 D71E             (    forth6809.asm):04135                     STB   EMITCH
E32B B6C008           (    forth6809.asm):04136         EMITWT:     LDA   ACIASR
E32E 8502             (    forth6809.asm):04137                     BITA  #SR_TDRE
E330 27F9             (    forth6809.asm):04138                     BEQ   EMITWT
E332 961E             (    forth6809.asm):04139                     LDA   EMITCH
E334 B7C009           (    forth6809.asm):04140                     STA   ACIADR
E337 39               (    forth6809.asm):04141                     RTS
                      (    forth6809.asm):04142         
                      (    forth6809.asm):04143                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):04144         
                      (    forth6809.asm):04145         ; ------------------------------------------------------------
                      (    forth6809.asm):04146         ; ACCEPT  ( c-addr +n1 -- +n2 )
                      (    forth6809.asm):04147         ; Read a line of up to +n1 characters into the buffer at c-addr,
                      (    forth6809.asm):04148         ; echoing as it goes. Backspace and DEL erase the last character; LF
                      (    forth6809.asm):04149         ; is ignored; CR ends the line. Returns the count +n2.
                      (    forth6809.asm):04150         ; ------------------------------------------------------------
E338 335E             (    forth6809.asm):04151         ACCEPTW:    LEAU  -2,U              ; local count at 0,U; then +n1 at 2,U and
E33A CC0000           (    forth6809.asm):04152                     LDD   #0                ; c-addr at 4,U. See shadow ACCEPTW.5
E33D EDC4             (    forth6809.asm):04153                     STD   ,U
                      (    forth6809.asm):04154         
                      (    forth6809.asm):04155                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: real
                      (    forth6809.asm):04156                                             ; RTS/CTS hardware flow control already
                      (    forth6809.asm):04157                                             ; covers this, nothing extra needed
                      (    forth6809.asm):04158                     ELSE                    ; <<<<<>>>>>  polling build: tell the host it's safe to
                      (    forth6809.asm):04159                                             ; stream this line's characters
E33F BDE303           (    forth6809.asm):04160                     JSR   PUTXON
                      (    forth6809.asm):04161                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):04162         

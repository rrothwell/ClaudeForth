D7A6 3001             (    forth6809.asm):04230                     LEAX  1,X
D7A8 AF42             (    forth6809.asm):04231                     STX   2,U
D7AA ECC4             (    forth6809.asm):04232                     LDD   ,U
D7AC 830001           (    forth6809.asm):04233                     SUBD  #1
D7AF EDC4             (    forth6809.asm):04234                     STD   ,U
D7B1 20C8             (    forth6809.asm):04235                     BRA   NUMLOOP
D7B3 39               (    forth6809.asm):04236         NLDONE:     RTS
                      (    forth6809.asm):04237         
                      (    forth6809.asm):04238         ; ------------------------------------------------------------
                      (    forth6809.asm):04239         ; Convert a counted string to a number in BASE. A leading "-" negates
                      (    forth6809.asm):04240         ; it; a trailing "." makes it a double-cell number.
                      (    forth6809.asm):04241         ; NUMBERQ   ( c-addr -- n -1 | ud 1 | c-addr 0 )
                      (    forth6809.asm):04242         ;    Inputs:
                      (    forth6809.asm):04243         ;        c-addr of the counted string on the data stack
                      (    forth6809.asm):04244         ;    Outputs:
                      (    forth6809.asm):04245         ;        single number: n and -1
                      (    forth6809.asm):04246         ;        double number: ud (low cell below high cell) and 1
                      (    forth6809.asm):04247         ;        not a number: c-addr and 0
                      (    forth6809.asm):04248         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):04249         ; The original c-addr and the negate flag live in an S frame (0,S and
                      (    forth6809.asm):04250         ; 2,S); the count is kept in RegB. See shadow NUMBERQ.1 and
                      (    forth6809.asm):04251         ; NUMBERQ.6.
                      (    forth6809.asm):04252         ; ------------------------------------------------------------
D7B4 3710             (    forth6809.asm):04253         NUMBERQ:    PULU  X                 ; c-addr
D7B6 327D             (    forth6809.asm):04254                     LEAS  -3,S
D7B8 AFE4             (    forth6809.asm):04255                     STX   ,S
D7BA E684             (    forth6809.asm):04256                     LDB   ,X
D7BC 276D             (    forth6809.asm):04257                     BEQ   NQBAD
D7BE 3001             (    forth6809.asm):04258                     LEAX  1,X
                      (    forth6809.asm):04259         
                      (    forth6809.asm):04260                     ; A trailing "." means a double number: leave it out of the
                      (    forth6809.asm):04261                     ; digit count. See shadow: NUMBERQ.1
D7C0 5A               (    forth6809.asm):04262                     DECB
D7C1 A685             (    forth6809.asm):04263                     LDA   B,X
D7C3 5C               (    forth6809.asm):04264                     INCB
D7C4 812E             (    forth6809.asm):04265                     CMPA  #'.'
D7C6 2603             (    forth6809.asm):04266                     BNE   NQNOSIGN
D7C8 5A               (    forth6809.asm):04267                     DECB
D7C9 2760             (    forth6809.asm):04268                     BEQ   NQBAD             ; lone "." with nothing before it
                      (    forth6809.asm):04269         
D7CB 6F62             (    forth6809.asm):04270         NQNOSIGN:   CLR   2,S
D7CD A684             (    forth6809.asm):04271                     LDA   ,X
D7CF 812D             (    forth6809.asm):04272                     CMPA  #'-'
D7D1 2607             (    forth6809.asm):04273                     BNE   NQNOSIGN2
D7D3 6362             (    forth6809.asm):04274                     COM   2,S
D7D5 3001             (    forth6809.asm):04275                     LEAX  1,X
D7D7 5A               (    forth6809.asm):04276                     DECB
D7D8 2751             (    forth6809.asm):04277                     BEQ   NQBAD
                      (    forth6809.asm):04278         
D7DA 108E0000         (    forth6809.asm):04279         NQNOSIGN2:  LDY   #0
D7DE 3620             (    forth6809.asm):04280                     PSHU  Y                 ; ud low
D7E0 3620             (    forth6809.asm):04281                     PSHU  Y                 ; ud high
D7E2 3610             (    forth6809.asm):04282                     PSHU  X                 ; c-addr
D7E4 4F               (    forth6809.asm):04283                     CLRA
D7E5 3606             (    forth6809.asm):04284                     PSHU  D                 ; u
                      (    forth6809.asm):04285         
D7E7 BDD77B           (    forth6809.asm):04286                     JSR   NUMLOOP
                      (    forth6809.asm):04287         
D7EA ECC4             (    forth6809.asm):04288                     LDD   ,U
D7EC 263B             (    forth6809.asm):04289                     BNE   NQBADF            ; unconverted characters remain
D7EE 3344             (    forth6809.asm):04290                     LEAU  4,U               ; drop u and c-addr: ud remains
                      (    forth6809.asm):04291         

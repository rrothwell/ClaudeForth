DA02 2715             (    forth6809.asm):04997                     BEQ   RPSHIFTDONE
DA04 DC18             (    forth6809.asm):04998         RPSHIFT:    LDD   MSCR3
DA06 830002           (    forth6809.asm):04999                     SUBD  #2
DA09 DD18             (    forth6809.asm):05000                     STD   MSCR3
DA0B 9E16             (    forth6809.asm):05001                     LDX   MSCR2
DA0D 308B             (    forth6809.asm):05002                     LEAX  D,X               ; X = MSCR2 + this pass's offset
DA0F EC84             (    forth6809.asm):05003                     LDD   ,X
DA11 3004             (    forth6809.asm):05004                     LEAX  4,X
DA13 ED84             (    forth6809.asm):05005                     STD   ,X                ; copy one word 4 bytes higher
DA15 DC18             (    forth6809.asm):05006                     LDD   MSCR3

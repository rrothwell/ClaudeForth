                      (    forth6809.asm):03168         ; ------------------------------------------------------------
                      (    forth6809.asm):03169         ; DEFER!  ( xt2 xt1 -- )
                      (    forth6809.asm):03170         ; Store xt2 as the action of the deferred word xt1.
                      (    forth6809.asm):03171         ; ------------------------------------------------------------
DE4C                  (    forth6809.asm):03172         DEFERSTOREW:

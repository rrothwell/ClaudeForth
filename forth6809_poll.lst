F229 2713             (    forth6809.asm):07028                     BEQ   CMDONE            ; addressed relative to U: u at 0, c-addr2
F22B AE44             (    forth6809.asm):07029                     LDX   4,U               ; at 2, c-addr1 at 4. See shadow CMOVEW.2
F22D 308B             (    forth6809.asm):07030                     LEAX  D,X               ; end address = c-addr1 + u

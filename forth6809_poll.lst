                      (    forth6809.asm):07909         ; COMPARE  ( c-addr1 u1 c-addr2 u2 -- n )
                      (    forth6809.asm):07910         ; Compare two strings byte by byte. n is -1, 0 or 1 as the first
                      (    forth6809.asm):07911         ; string is less than, equal to or greater than the second; if one is
                      (    forth6809.asm):07912         ; a prefix of the other, the shorter is less.
                      (    forth6809.asm):07913         ; ------------------------------------------------------------
EA34 AE46             (    forth6809.asm):07914         COMPAREW:   LDX   6,U                ; Parameters stay on the data stack: u2 at 0,
EA36 10AE42           (    forth6809.asm):07915                     LDY   2,U               ; c-addr2 at 2, u1 at 4, c-addr1 at 6
EA39 EC44             (    forth6809.asm):07916                     LDD   4,U
EA3B 10A3C4           (    forth6809.asm):07917                     CMPD  ,U
EA3E 2302             (    forth6809.asm):07918                     BLS   CMMINSET

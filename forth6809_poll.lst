                      (    forth6809.asm):08543         ; ------------------------------------------------------------
                      (    forth6809.asm):08544         ; <#  ( -- )
                      (    forth6809.asm):08545         ; Start a pictured numeric output string: HLD is set to the end of
                      (    forth6809.asm):08546         ; PAD. The string is built backwards from there.
                      (    forth6809.asm):08547         ; ------------------------------------------------------------

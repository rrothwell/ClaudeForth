                      (    forth6809.asm):11011         ; ------------------------------------------------------------
                      (    forth6809.asm):11012         ; Cold start, entered from the reset vector: mask interrupts, set up
                      (    forth6809.asm):11013         ; the stacks and the direct page, clear GLOBALS, initialise the ACIA,
                      (    forth6809.asm):11014         ; unmask interrupts, run the unit tests if they are built in, then
                      (    forth6809.asm):11015         ; enter COLD.
                      (    forth6809.asm):11016         ; COLDSTRT
                      (    forth6809.asm):11017         ;    Inputs:
                      (    forth6809.asm):11018         ;        hardware reset
                      (    forth6809.asm):11019         ;    Outputs:
                      (    forth6809.asm):11020         ;        does not return
                      (    forth6809.asm):11021         ;    Registers: all registers initialised.
                      (    forth6809.asm):11022         ; ------------------------------------------------------------
FF9C                  (    forth6809.asm):11023         COLDSTRT:
FF9C 1A50             (    forth6809.asm):11024                     ORCC  #$50              ; Disable IRQ & FIRQ
FF9E 10CEC000         (    forth6809.asm):11025                     LDS   #RSTACK+1
FFA2 CEBD00           (    forth6809.asm):11026                     LDU   #DSTACK+1
FFA5 4F               (    forth6809.asm):11027                     CLRA
FFA6 1F8B             (    forth6809.asm):11028                     TFR   A,DP
                      (    forth6809.asm):11029         

                      (    forth6809.asm):02168         ; RTSCHECKLO
                      (    forth6809.asm):02169         ;    Inputs:
                      (    forth6809.asm):02170         ;        none
                      (    forth6809.asm):02171         ;    Outputs:
                      (    forth6809.asm):02172         ;        RTSSTATE = 0 and ACIACR rewritten if RTS was high and the ring is low
                      (    forth6809.asm):02173         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):02174         ; Original comment: shadow RTSCHECKLO.0.
                      (    forth6809.asm):02175         ; ------------------------------------------------------------
DA5F                  (    forth6809.asm):02176         RTSCHECKLO:
                      (    forth6809.asm):02177                     ORCC  #$10              ; mask IRQ for the critical section
                      (    forth6809.asm):02178         
                      (    forth6809.asm):02179                     JSR   INFILL
                      (    forth6809.asm):02180                     CMPA  #INLOWATER
                      (    forth6809.asm):02181                     BHI   RTSCLODONE
                      (    forth6809.asm):02182                     TST   RTSSTATE
                      (    forth6809.asm):02183                     BEQ   RTSCLODONE        ; already low - nothing to do
                      (    forth6809.asm):02184         
                      (    forth6809.asm):02185         

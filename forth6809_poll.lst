                      (    forth6809.asm):09398         ; [IF]  ( flag -- )     [ELSE]  ( -- )     [THEN]  ( -- )
                      (    forth6809.asm):09399         ; Programming-Tools conditional compilation. All three are
                      (    forth6809.asm):09400         ; immediate, so they work while interpreting and while compiling.
                      (    forth6809.asm):09401         ; [IF] with a true flag does nothing. With a false flag, and for
                      (    forth6809.asm):09402         ; [ELSE], the input is skipped word by word, counting nested
                      (    forth6809.asm):09403         ; [IF]s, up to the matching [ELSE] or [THEN]. The three names are
                      (    forth6809.asm):09404         ; matched exactly, as the dictionary matches every name. If the line
                      (    forth6809.asm):09405         ; runs out, the next line is read with REFILL; if no more input is
                      (    forth6809.asm):09406         ; available the skip ends.
                      (    forth6809.asm):09407         ; [THEN] is a marker and does nothing when it is executed.
                      (    forth6809.asm):09408         ; The nesting level is kept at 0,S.
                      (    forth6809.asm):09409         ; ------------------------------------------------------------
F2F4 3706             (    forth6809.asm):09410         BRIFW:      PULU  D
F2F6 10830000         (    forth6809.asm):09411                     CMPD  #0
F2FA 266D             (    forth6809.asm):09412                     BNE   BRTHENW           ; true: nothing to skip
F2FC CC0001           (    forth6809.asm):09413         BRELSEW:    LDD   #1
F2FF 3406             (    forth6809.asm):09414                     PSHS  D                 ; level
F301 BDE99D           (    forth6809.asm):09415         BRNEXT:     JSR   PARSENAMEW
F304 3706             (    forth6809.asm):09416                     PULU  D                 ; length
F306 3710             (    forth6809.asm):09417                     PULU  X                 ; address
F308 10830000         (    forth6809.asm):09418                     CMPD  #0

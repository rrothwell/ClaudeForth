D791 8141             (    forth6809.asm):04220                     CMPA  #'A'
D793 251E             (    forth6809.asm):04221                     BLO   NLDONE
D795 815A             (    forth6809.asm):04222                     CMPA  #'Z'
D797 221A             (    forth6809.asm):04223                     BHI   NLDONE
D799 8037             (    forth6809.asm):04224                     SUBA  #'A'-10
D79B 9103             (    forth6809.asm):04225         NLGOT:      CMPA  BASE+1
D79D 2414             (    forth6809.asm):04226                     BHS   NLDONE
D79F 1F89             (    forth6809.asm):04227                     TFR   A,B

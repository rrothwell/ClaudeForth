DE35 9E1A             (    forth6809.asm):04841         RPSCANOK:   LDX   MSCR4
DE37 EC84             (    forth6809.asm):04842                     LDD   ,X
DE39 10830002         (    forth6809.asm):04843                     CMPD  #TAGBACK
DE3D 2712             (    forth6809.asm):04844                     BEQ   RPFOUND
DE3F 10830001         (    forth6809.asm):04845                     CMPD  #TAGFWD
DE43 2703             (    forth6809.asm):04846                     BEQ   RPSKIP

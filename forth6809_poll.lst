                      (    forth6809.asm):03951         ; ------------------------------------------------------------
                      (    forth6809.asm):03952         ; Replace the first wordlist of the search order with the WID in RegX,
                      (    forth6809.asm):03953         ; or make it the only one if the order is empty.
                      (    forth6809.asm):03954         ; SETTOP
                      (    forth6809.asm):03955         ;    Inputs:

                      (    forth6809.asm):03451         ; >NUMBER  ( ud1 c-addr1 u1 -- ud2 c-addr2 u2 )
                      (    forth6809.asm):03452         ; Convert the string into ud1, in BASE, stopping at the first
                      (    forth6809.asm):03453         ; unconvertible character. Returns the accumulated ud2 and the
                      (    forth6809.asm):03454         ; remaining string. The conversion works in place on the three
                      (    forth6809.asm):03455         ; parameters (NUMLOOP), which are also the frame NUMBERQ builds.

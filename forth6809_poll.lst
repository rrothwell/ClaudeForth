DF03 AE4A             (    forth6809.asm):05906         DROTW:      LDX   10,U              ; x1
DF05 10AE48           (    forth6809.asm):05907                     LDY   8,U               ; x2
DF08 EC46             (    forth6809.asm):05908                     LDD   6,U
DF0A ED4A             (    forth6809.asm):05909                     STD   10,U
DF0C EC44             (    forth6809.asm):05910                     LDD   4,U
DF0E ED48             (    forth6809.asm):05911                     STD   8,U
DF10 EC42             (    forth6809.asm):05912                     LDD   2,U
DF12 ED46             (    forth6809.asm):05913                     STD   6,U

D32F 2606             (    forth6809.asm):03621                     BNE   STARTW
D331 3001             (    forth6809.asm):03622                     LEAX  1,X
D333 313F             (    forth6809.asm):03623                     LEAY  -1,Y
D335 20EE             (    forth6809.asm):03624                     BRA   SKIPLP
                      (    forth6809.asm):03625         
D337 AF61             (    forth6809.asm):03626         STARTW:     STX   1,S
D339 C600             (    forth6809.asm):03627                     LDB   #0
                      (    forth6809.asm):03628         
D33B 108C0000         (    forth6809.asm):03629         SCANLP:     CMPY  #0
D33F 2715             (    forth6809.asm):03630                     BEQ   ENDW
D341 A684             (    forth6809.asm):03631                     LDA   ,X
D343 A1E4             (    forth6809.asm):03632                     CMPA  ,S
D345 270B             (    forth6809.asm):03633                     BEQ   CONSUME
D347 C15A             (    forth6809.asm):03634                     CMPB  #WORDMAXCHARS     ; Length limit. See shadow: WORDW.2
D349 270B             (    forth6809.asm):03635                     BEQ   ENDW
D34B 3001             (    forth6809.asm):03636                     LEAX  1,X

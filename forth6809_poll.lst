                      (    forth6809.asm):07838         
                      (    forth6809.asm):07839         ; ------------------------------------------------------------
                      (    forth6809.asm):07840         ; .R  ( n1 n2 -- )
                      (    forth6809.asm):07841         ; Display n1 right-justified in a field of n2 characters.
                      (    forth6809.asm):07842         ; ------------------------------------------------------------
F945 3706             (    forth6809.asm):07843         DOTRW:      PULU  D                 ; n2 (width)
F947 3406             (    forth6809.asm):07844                     PSHS  D                 ; width waits on the return stack
F949 3706             (    forth6809.asm):07845                     PULU  D                 ; n1
F94B 3406             (    forth6809.asm):07846                     PSHS  D                 ; kept on S for SIGN, above the width
F94D 4D               (    forth6809.asm):07847                     TSTA
F94E 2A05             (    forth6809.asm):07848                     BPL   DRABSOK
F950 43               (    forth6809.asm):07849                     COMA
F951 53               (    forth6809.asm):07850                     COMB
F952 C30001           (    forth6809.asm):07851                     ADDD  #1
F955 3606             (    forth6809.asm):07852         DRABSOK:    PSHU  D
F957 CC0000           (    forth6809.asm):07853                     LDD   #0
F95A 3606             (    forth6809.asm):07854                     PSHU  D
F95C BDF876           (    forth6809.asm):07855                     JSR   LTNUMW
F95F BDF8D0           (    forth6809.asm):07856                     JSR   NUMSW
F962 3506             (    forth6809.asm):07857                     PULS  D
F964 3606             (    forth6809.asm):07858                     PSHU  D
F966 BDF8DC           (    forth6809.asm):07859                     JSR   SIGNW
F969 BDF8EA           (    forth6809.asm):07860                     JSR   NUMGTW
F96C 3506             (    forth6809.asm):07861                     PULS  D                 ; width
F96E 160000           (    forth6809.asm):07862                     LBRA  RTYPE
                      (    forth6809.asm):07863         
                      (    forth6809.asm):07864         ; ------------------------------------------------------------
                      (    forth6809.asm):07865         ; Type the string c-addr u right-justified in a field of D characters.
                      (    forth6809.asm):07866         ; RTYPE   ( c-addr u -- )
                      (    forth6809.asm):07867         ;    Inputs:
                      (    forth6809.asm):07868         ;        RegD = field width; the string on the data stack
                      (    forth6809.asm):07869         ;    Outputs:
                      (    forth6809.asm):07870         ;        padding spaces, then the string
                      (    forth6809.asm):07871         ;    Registers: all changed.
                      (    forth6809.asm):07872         ; ------------------------------------------------------------
F971 A3C4             (    forth6809.asm):07873         RTYPE:      SUBD  ,U                ; width - u

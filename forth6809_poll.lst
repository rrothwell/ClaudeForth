E7FE 3706             (    forth6809.asm):07536                     PULU  D                 ; u
E800 3720             (    forth6809.asm):07537                     PULU  Y                 ; c-addr
E802 3610             (    forth6809.asm):07538                     PSHU  X                 ; result c-addr
E804 3606             (    forth6809.asm):07539                     PSHU  D                 ; result u
E806 5D               (    forth6809.asm):07540                     TSTB
E807 2707             (    forth6809.asm):07541                     BEQ   SQIEND

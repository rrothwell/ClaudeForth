                      (    forth6809.asm):00306         ; SECTION 27: FORTH DICTIONARY (ROM base dictionary headers)
                      (    forth6809.asm):00307         ;
                      (    forth6809.asm):00308         ; One header per word, chained by LINK, placed at BASEDICT. Each
                      (    forth6809.asm):00309         ; header is: length|flags, name, LINK, CFA. Every CFA is the word's
                      (    forth6809.asm):00310         ; own code label (raw code entries, no trampoline), including TRUE
                      (    forth6809.asm):00311         ; and FALSE. DOES> is next to CREATE; its code label is DOESGTW
                      (    forth6809.asm):00312         ; because ">" is not valid in a label. ABORT and QUIT are
                      (    forth6809.asm):00313         ; hand-built. Headers are in search order (shadow SECTION27.1).
                      (    forth6809.asm):00314         ;
                      (    forth6809.asm):00315         ; Names containing a double-quote (S", ." and ABORT") have it split
                      (    forth6809.asm):00316         ; out of the FCC into a separate FCB $22.
                      (    forth6809.asm):00317         ; The original header comment is shadow SECTION27.0.
                      (    forth6809.asm):00318         ; ============================================================
                      (    forth6809.asm):00319         
                      (    forth6809.asm):00320                     ORG   BASEDICT
                      (    forth6809.asm):00321         ; Search order: head first, and so last in memory. See shadow SECTION27.1.
                      (    forth6809.asm):00322         ; Headers are laid out tail first, so each LINK points back to the header
                      (    forth6809.asm):00323         ; just before it in memory (0 for the first) and BASELATEST names the last.
                      (    forth6809.asm):00324         

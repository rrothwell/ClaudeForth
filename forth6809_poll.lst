DDB4 3706             (    forth6809.asm):05596                     PULU  D
DDB6 CCFFF3           (    forth6809.asm):05597                     LDD   #-13              ; -13
DDB9 3606             (    forth6809.asm):05598                     PSHU  D
DDBB BDD905           (    forth6809.asm):05599                     JSR   THROWW
DDBE 10830001         (    forth6809.asm):05600         PPFOUND:    CMPD  #1                ; 1 = immediate
DDC2 270C             (    forth6809.asm):05601                     BEQ   PPIMM
DDC4 BDDD4D           (    forth6809.asm):05602                     JSR   LITERALW
DDC7 CCDD3D           (    forth6809.asm):05603                     LDD   #COMPILECOMMAW

D7A8 39               (    forth6809.asm):04581                     RTS
D7A9 CC0087           (    forth6809.asm):04582         KEYVW:      LDD   #KEYV
D7AC 3606             (    forth6809.asm):04583                     PSHU  D
D7AE 39               (    forth6809.asm):04584                     RTS
D7AF CC0089           (    forth6809.asm):04585         KEYQVW:     LDD   #KEYQV
D7B2 3606             (    forth6809.asm):04586                     PSHU  D
D7B4 39               (    forth6809.asm):04587                     RTS
                      (    forth6809.asm):04588         

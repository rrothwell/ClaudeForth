                      (    forth6809.asm):05582         ; compiling, -13 if the name is not found.
                      (    forth6809.asm):05583         ; ------------------------------------------------------------
DD95 DC00             (    forth6809.asm):05584         POSTPONEW:  LDD   STATE
DD97 2608             (    forth6809.asm):05585                     BNE   PPSTOK

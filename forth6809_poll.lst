E287 3606             (    forth6809.asm):05666                     PSHU  D                 ; +n
E289 39               (    forth6809.asm):05667                     RTS
                      (    forth6809.asm):05668         
                      (    forth6809.asm):05669         ; ------------------------------------------------------------
                      (    forth6809.asm):05670         ; 2DUP  ( x1 x2 -- x1 x2 x1 x2 )
                      (    forth6809.asm):05671         ; Duplicate the top cell pair.

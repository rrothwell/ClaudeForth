DD24 BDD37F           (    forth6809.asm):05494                     JSR   WORDW
DD27 BDD468           (    forth6809.asm):05495                     JSR   FINDW
DD2A 3706             (    forth6809.asm):05496                     PULU  D                 ; found flag
DD2C 10830000         (    forth6809.asm):05497                     CMPD  #0
DD30 260A             (    forth6809.asm):05498                     BNE   TICKOK
DD32 3706             (    forth6809.asm):05499                     PULU  D                 ; drop the name
DD34 CCFFF3           (    forth6809.asm):05500                     LDD   #-13              ; -13
DD37 3606             (    forth6809.asm):05501                     PSHU  D
DD39 BDD905           (    forth6809.asm):05502                     JSR   THROWW

DBA3 3610             (    forth6809.asm):05041                     PSHU  X
DBA5 BDD9A5           (    forth6809.asm):05042                     JSR   PATCH
DBA8 39               (    forth6809.asm):05043         LOOPDONE:   RTS
                      (    forth6809.asm):05044         
                      (    forth6809.asm):05045         ; ------------------------------------------------------------
                      (    forth6809.asm):05046         ; Run-time end of LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):05047         ; the back-branch operand. Add 1 to the index. If the leave flag is
                      (    forth6809.asm):05048         ; set or the index has reached the limit, discard the loop frame and
                      (    forth6809.asm):05049         ; skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):05050         ; DOTEST
                      (    forth6809.asm):05051         ;    Inputs:
                      (    forth6809.asm):05052         ;        S holds return address, index, limit and leave flag (top
                      (    forth6809.asm):05053         ;        first)
                      (    forth6809.asm):05054         ;    Outputs:
                      (    forth6809.asm):05055         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):05056         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):05057         ; ------------------------------------------------------------
DBA9 EC66             (    forth6809.asm):05058         DOTEST:     LDD   6,S               ; leave flag. See bugfix: DOTEST.1
DBAB 2615             (    forth6809.asm):05059                     BNE   DTEXIT            ; set: exit
DBAD EC62             (    forth6809.asm):05060                     LDD   2,S               ; index
DBAF C30001           (    forth6809.asm):05061                     ADDD  #1
DBB2 ED62             (    forth6809.asm):05062                     STD   2,S
DBB4 10A364           (    forth6809.asm):05063                     CMPD  4,S               ; limit
DBB7 2709             (    forth6809.asm):05064                     BEQ   DTEXIT
DBB9 3510             (    forth6809.asm):05065                     PULS  X                 ; X = branch operand address
DBBB EC84             (    forth6809.asm):05066                     LDD   ,X
DBBD 308B             (    forth6809.asm):05067                     LEAX  D,X
DBBF 3410             (    forth6809.asm):05068                     PSHS  X                 ; return to loop start
DBC1 39               (    forth6809.asm):05069                     RTS
DBC2 3510             (    forth6809.asm):05070         DTEXIT:     PULS  X
DBC4 3002             (    forth6809.asm):05071                     LEAX  2,X               ; skip the branch operand
DBC6 3266             (    forth6809.asm):05072                     LEAS  6,S               ; discard the loop frame
DBC8 3410             (    forth6809.asm):05073                     PSHS  X
DBCA 39               (    forth6809.asm):05074                     RTS
                      (    forth6809.asm):05075         
                      (    forth6809.asm):05076         ; ------------------------------------------------------------
                      (    forth6809.asm):05077         ; +LOOP  ( C: dest -- )
                      (    forth6809.asm):05078         ; Compile a call to DOPLUSTEST followed by a displacement back to
                      (    forth6809.asm):05079         ; dest. For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):05080         ; ------------------------------------------------------------
DBCB 3706             (    forth6809.asm):05081         PLUSLOOPW:  PULU  D
DBCD 10830003         (    forth6809.asm):05082                     CMPD  #TAGDO
DBD1 2703             (    forth6809.asm):05083                     BEQ   PLOOPOK
DBD3 BDD93B           (    forth6809.asm):05084                     JSR   CFERR
DBD6 3706             (    forth6809.asm):05085         PLOOPOK:    PULU  D                 ; dest
DBD8 3606             (    forth6809.asm):05086                     PSHU  D                 ; park dest. See bugfix: PLUSLOOPW.1
DBDA CCDC0A           (    forth6809.asm):05087                     LDD   #DOPLUSTEST
DBDD 3606             (    forth6809.asm):05088                     PSHU  D
DBDF BDDDAB           (    forth6809.asm):05089                     JSR   CCALL
DBE2 CC0000           (    forth6809.asm):05090                     LDD   #0
DBE5 3606             (    forth6809.asm):05091                     PSHU  D
DBE7 BDD08B           (    forth6809.asm):05092                     JSR   CODECOMMA
DBEA DC08             (    forth6809.asm):05093                     LDD   CODEHERE
DBEC 830002           (    forth6809.asm):05094                     SUBD  #2
DBEF 3606             (    forth6809.asm):05095                     PSHU  D                 ; location; the parked dest is beneath

                      (    forth6809.asm):11084         
FFE7 20207761726D     (    forth6809.asm):11085         WARMMSG:    FCC   "  warm"
     0006             (    forth6809.asm):11086         WARMMSGL    EQU   *-WARMMSG
                      (    forth6809.asm):11087         

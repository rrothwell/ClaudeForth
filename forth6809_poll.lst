DCF2 CC0000           (    forth6809.asm):05288                     LDD   #0
DCF5 3606             (    forth6809.asm):05289                     PSHU  D
DCF7 BDD08B           (    forth6809.asm):05290                     JSR   CODECOMMA
DCFA DC08             (    forth6809.asm):05291                     LDD   CODEHERE
DCFC 830002           (    forth6809.asm):05292                     SUBD  #2
DCFF 3606             (    forth6809.asm):05293                     PSHU  D                 ; orig
DD01 CCDED3           (    forth6809.asm):05294                     LDD   #DROPW
DD04 3606             (    forth6809.asm):05295                     PSHU  D
DD06 BDDDAB           (    forth6809.asm):05296                     JSR   CCALL
DD09 CC0005           (    forth6809.asm):05297                     LDD   #TAGOF
DD0C 3606             (    forth6809.asm):05298                     PSHU  D

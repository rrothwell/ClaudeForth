DDA1 CC0020           (    forth6809.asm):05589         PPSTOK:     LDD   #32
DDA4 3606             (    forth6809.asm):05590                     PSHU  D
DDA6 BDD37F           (    forth6809.asm):05591                     JSR   WORDW
DDA9 BDD468           (    forth6809.asm):05592                     JSR   FINDW
DDAC 3706             (    forth6809.asm):05593                     PULU  D
DDAE 10830000         (    forth6809.asm):05594                     CMPD  #0

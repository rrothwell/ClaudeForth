                      (    forth6809.asm):08387         ; SUBSTITUTE  ( c-addr1 u1 c-addr2 u2 -- c-addr2 u3 n )
                      (    forth6809.asm):08388         ; Copy the template c-addr1 u1 to the buffer c-addr2 u2, replacing
                      (    forth6809.asm):08389         ; each %name% that matches the name registered by REPLACES with its
                      (    forth6809.asm):08390         ; text. "%%" becomes a single "%"; a %name% that does not match, and
                      (    forth6809.asm):08391         ; an unpaired "%", are copied unchanged. u3 is the output length and n
                      (    forth6809.asm):08392         ; the number of substitutions. THROW -1 if the output does not fit.
                      (    forth6809.asm):08393         ; Scratch: MSCR = read position, MSCR2 = substitution count, MSCR3 and
                      (    forth6809.asm):08394         ; MSCR4 = temporaries for each %-pair. Original comment: shadow

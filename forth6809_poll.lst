DF1B AF42             (    forth6809.asm):05917                     STX   2,U
DF1D 39               (    forth6809.asm):05918                     RTS
                      (    forth6809.asm):05919         
                      (    forth6809.asm):05920         ; ------------------------------------------------------------
                      (    forth6809.asm):05921         ; >R  ( x -- )  ( R: -- x )
                      (    forth6809.asm):05922         ; Move x from the data stack to the return stack. The return address
                      (    forth6809.asm):05923         ; of this call is on top of S, so it is lifted off and put back around
                      (    forth6809.asm):05924         ; the transfer.
                      (    forth6809.asm):05925         ; ------------------------------------------------------------
DF1E 3706             (    forth6809.asm):05926         TORW:       PULU  D                 ; x
DF20 3510             (    forth6809.asm):05927                     PULS  X
DF22 3406             (    forth6809.asm):05928                     PSHS  D
DF24 3410             (    forth6809.asm):05929                     PSHS  X
DF26 39               (    forth6809.asm):05930                     RTS
                      (    forth6809.asm):05931         
                      (    forth6809.asm):05932         ; ------------------------------------------------------------
                      (    forth6809.asm):05933         ; R>  ( -- x )  ( R: x -- )
                      (    forth6809.asm):05934         ; Move x from the return stack to the data stack. The return address
                      (    forth6809.asm):05935         ; of this call is on top of S, so it is lifted off and put back around
                      (    forth6809.asm):05936         ; the transfer.
                      (    forth6809.asm):05937         ; ------------------------------------------------------------
DF27 3510             (    forth6809.asm):05938         FROMRW:     PULS  X
DF29 3506             (    forth6809.asm):05939                     PULS  D                 ; x
DF2B 3410             (    forth6809.asm):05940                     PSHS  X
DF2D 3606             (    forth6809.asm):05941                     PSHU  D
DF2F 39               (    forth6809.asm):05942                     RTS
                      (    forth6809.asm):05943         
                      (    forth6809.asm):05944         ; ------------------------------------------------------------
                      (    forth6809.asm):05945         ; R@  ( -- x )  ( R: x -- x )
                      (    forth6809.asm):05946         ; Copy the top of the return stack to the data stack. The return
                      (    forth6809.asm):05947         ; address of this call is on top of S, so it is lifted off and put
                      (    forth6809.asm):05948         ; back around the transfer.
                      (    forth6809.asm):05949         ; ------------------------------------------------------------
DF30 3510             (    forth6809.asm):05950         RFETCHW:    PULS  X
DF32 ECE4             (    forth6809.asm):05951                     LDD   ,S                ; x
DF34 3410             (    forth6809.asm):05952                     PSHS  X
DF36 3606             (    forth6809.asm):05953                     PSHU  D
DF38 39               (    forth6809.asm):05954                     RTS
                      (    forth6809.asm):05955         
                      (    forth6809.asm):05956         ; ------------------------------------------------------------
                      (    forth6809.asm):05957         ; 2>R  ( x1 x2 -- )  ( R: -- x1 x2 )
                      (    forth6809.asm):05958         ; Move a cell pair to the return stack. R2A and R2B are scratch. The
                      (    forth6809.asm):05959         ; return address of this call is on top of S, so it is lifted off and
                      (    forth6809.asm):05960         ; put back around the transfer.
                      (    forth6809.asm):05961         ; ------------------------------------------------------------
DF39 3510             (    forth6809.asm):05962         TWOTORW:    PULS  X                 ; return address
DF3B 3706             (    forth6809.asm):05963                     PULU  D                 ; x2
DF3D 3720             (    forth6809.asm):05964                     PULU  Y                 ; x1
DF3F 3420             (    forth6809.asm):05965                     PSHS  Y
DF41 3406             (    forth6809.asm):05966                     PSHS  D
DF43 3410             (    forth6809.asm):05967                     PSHS  X

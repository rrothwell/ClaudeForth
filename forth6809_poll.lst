                      (    forth6809.asm):05628         ; OVER  ( x1 x2 -- x1 x2 x1 )
                      (    forth6809.asm):05629         ; Copy the second cell to the top.
                      (    forth6809.asm):05630         ; ------------------------------------------------------------
E25F EC42             (    forth6809.asm):05631         OVERW:      LDD   2,U               ; x1
E261 3606             (    forth6809.asm):05632                     PSHU  D
E263 39               (    forth6809.asm):05633                     RTS
                      (    forth6809.asm):05634         
                      (    forth6809.asm):05635         ; ------------------------------------------------------------
                      (    forth6809.asm):05636         ; ROT  ( x1 x2 x3 -- x2 x3 x1 )
                      (    forth6809.asm):05637         ; Rotate the third cell to the top.
                      (    forth6809.asm):05638         ; ------------------------------------------------------------

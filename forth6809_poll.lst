E5CA DC08             (    forth6809.asm):04185                     LDD   CODEHERE
E5CC 3606             (    forth6809.asm):04186                     PSHU  D
E5CE EC62             (    forth6809.asm):04187                     LDD   2,S               ; orig
E5D0 3606             (    forth6809.asm):04188                     PSHU  D
E5D2 BDE457           (    forth6809.asm):04189                     JSR   PATCH

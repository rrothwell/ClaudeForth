DCBC 10830000         (    forth6809.asm):05498                     CMPD  #0
DCC0 260A             (    forth6809.asm):05499                     BNE   TICKOK
DCC2 3706             (    forth6809.asm):05500                     PULU  D                 ; drop the name
DCC4 CCFFF3           (    forth6809.asm):05501                     LDD   #-13              ; -13
DCC7 3606             (    forth6809.asm):05502                     PSHU  D

                      (    forth6809.asm):04151         ; ------------------------------------------------------------
                      (    forth6809.asm):04152         ; Multiply the unsigned double ud on the data stack by BASE and add a
                      (    forth6809.asm):04153         ; digit. (5m: the accumulator lives on the data stack, in the frame of
                      (    forth6809.asm):04154         ; >NUMBER, so no page-zero cells are needed.)
                      (    forth6809.asm):04155         ; UDMULADD
                      (    forth6809.asm):04156         ;    Inputs:
                      (    forth6809.asm):04157         ;        ud at 4,U (high cell) and 6,U (low cell), as in the >NUMBER
                      (    forth6809.asm):04158         ;        frame ( ud c-addr u )
                      (    forth6809.asm):04159         ;        RegB = digit value to add
                      (    forth6809.asm):04160         ;        BASE
                      (    forth6809.asm):04161         ;    Outputs:
                      (    forth6809.asm):04162         ;        ud = ud * BASE + digit
                      (    forth6809.asm):04163         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):04164         ; ------------------------------------------------------------
D70B 327E             (    forth6809.asm):04165         UDMULADD:   LEAS  -2,S              ; 0,S = carry, 1,S = BASE multiplier
D70D E7E4             (    forth6809.asm):04166                     STB   ,S
D70F 9603             (    forth6809.asm):04167                     LDA   BASE+1
D711 A761             (    forth6809.asm):04168                     STA   1,S
D713 A647             (    forth6809.asm):04169                     LDA   7,U
D715 E661             (    forth6809.asm):04170                     LDB   1,S
D717 3D               (    forth6809.asm):04171                     MUL
D718 EBE4             (    forth6809.asm):04172                     ADDB  ,S
D71A 2401             (    forth6809.asm):04173                     BCC   UM0
D71C 4C               (    forth6809.asm):04174                     INCA
D71D E747             (    forth6809.asm):04175         UM0:        STB   7,U
D71F A7E4             (    forth6809.asm):04176                     STA   ,S
D721 A646             (    forth6809.asm):04177                     LDA   6,U
D723 E661             (    forth6809.asm):04178                     LDB   1,S
D725 3D               (    forth6809.asm):04179                     MUL
D726 EBE4             (    forth6809.asm):04180                     ADDB  ,S
D728 2401             (    forth6809.asm):04181                     BCC   UM1
D72A 4C               (    forth6809.asm):04182                     INCA
D72B E746             (    forth6809.asm):04183         UM1:        STB   6,U
D72D A7E4             (    forth6809.asm):04184                     STA   ,S
D72F A645             (    forth6809.asm):04185                     LDA   5,U
D731 E661             (    forth6809.asm):04186                     LDB   1,S
D733 3D               (    forth6809.asm):04187                     MUL

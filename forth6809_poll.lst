F6B9 10830000         (    forth6809.asm):09270                     CMPD  #0
F6BD 266D             (    forth6809.asm):09271                     BNE   BRTHENW           ; true: nothing to skip
F6BF CC0001           (    forth6809.asm):09272         BRELSEW:    LDD   #1
F6C2 3406             (    forth6809.asm):09273                     PSHS  D                 ; level
F6C4 BDED88           (    forth6809.asm):09274         BRNEXT:     JSR   PARSENAMEW

                      (    forth6809.asm):05488         ; '  ( "name" -- xt )
                      (    forth6809.asm):05489         ; Parse the next blank-delimited name and return its xt. THROW -13 if
                      (    forth6809.asm):05490         ; the name is not found.
                      (    forth6809.asm):05491         ; ------------------------------------------------------------

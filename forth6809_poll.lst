E538 3040             (    forth6809.asm):04516                     LEAX  0,U               ; scan from top of control stack
E53A 9F16             (    forth6809.asm):04517                     STX   MSCR2             ; MSCR2 = base of scan region
E53C 9F1A             (    forth6809.asm):04518                     STX   MSCR4             ; MSCR4 = scan pointer
E53E DC1A             (    forth6809.asm):04519         RPSCAN:     LDD   MSCR4
E540 109321           (    forth6809.asm):04520                     CMPD  CSP
E543 2603             (    forth6809.asm):04521                     BNE   RPSCANOK
E545 BDE3CE           (    forth6809.asm):04522                     JSR   CFERR             ; no matching BEGIN
E548 9E1A             (    forth6809.asm):04523         RPSCANOK:   LDX   MSCR4
E54A EC84             (    forth6809.asm):04524                     LDD   ,X
E54C 10830002         (    forth6809.asm):04525                     CMPD  #TAGBACK
E550 2712             (    forth6809.asm):04526                     BEQ   RPFOUND
E552 10830001         (    forth6809.asm):04527                     CMPD  #TAGFWD
E556 2703             (    forth6809.asm):04528                     BEQ   RPSKIP

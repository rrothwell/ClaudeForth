F915 3506             (    forth6809.asm):07814                     PULS  D
F917 3606             (    forth6809.asm):07815                     PSHU  D
F919 BDF8DC           (    forth6809.asm):07816                     JSR   SIGNW
F91C BDF8EA           (    forth6809.asm):07817                     JSR   NUMGTW
F91F BDF431           (    forth6809.asm):07818                     JSR   TYPEW
F922 CC0020           (    forth6809.asm):07819                     LDD   #32
F925 3606             (    forth6809.asm):07820                     PSHU  D
F927 BDE346           (    forth6809.asm):07821                     JSR   EMITW
F92A 39               (    forth6809.asm):07822                     RTS
                      (    forth6809.asm):07823         
                      (    forth6809.asm):07824         ; ------------------------------------------------------------
                      (    forth6809.asm):07825         ; U.  ( u -- )
                      (    forth6809.asm):07826         ; Display u in the current base, followed by a space.
                      (    forth6809.asm):07827         ; ------------------------------------------------------------
F92B CC0000           (    forth6809.asm):07828         UDOTW:      LDD   #0                ; ud high cell = 0
F92E 3606             (    forth6809.asm):07829                     PSHU  D
F930 BDF876           (    forth6809.asm):07830                     JSR   LTNUMW
F933 BDF8D0           (    forth6809.asm):07831                     JSR   NUMSW
F936 BDF8EA           (    forth6809.asm):07832                     JSR   NUMGTW
F939 BDF431           (    forth6809.asm):07833                     JSR   TYPEW
F93C CC0020           (    forth6809.asm):07834                     LDD   #32
F93F 3606             (    forth6809.asm):07835                     PSHU  D
F941 BDE346           (    forth6809.asm):07836                     JSR   EMITW

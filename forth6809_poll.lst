                      (    forth6809.asm):03668         ; ------------------------------------------------------------
                      (    forth6809.asm):03669         ; Split a header into its xt and its immediate flag.
                      (    forth6809.asm):03670         ; HDRXT
                      (    forth6809.asm):03671         ;    Inputs:
                      (    forth6809.asm):03672         ;        RegX = header
                      (    forth6809.asm):03673         ;    Outputs:
                      (    forth6809.asm):03674         ;        RegX = xt (the CFA field), RegA = length|flags byte
                      (    forth6809.asm):03675         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):03676         ; ------------------------------------------------------------
D880 A684             (    forth6809.asm):03677         HDRXT:      LDA   ,X

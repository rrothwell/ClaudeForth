                      (    forth6809.asm):03078         
                      (    forth6809.asm):03079         ; ------------------------------------------------------------
                      (    forth6809.asm):03080         ; 2VARIABLE  ( "name" -- )
                      (    forth6809.asm):03081         ; Build a word that returns the address of a new two-cell variable in

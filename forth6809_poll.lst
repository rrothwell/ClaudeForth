                      (    forth6809.asm):06949         ; ------------------------------------------------------------
                      (    forth6809.asm):06950         ; Run-time part of ."  The counted string follows the call: TYPE it
                      (    forth6809.asm):06951         ; and skip over it.
                      (    forth6809.asm):06952         ; DOTSTR
                      (    forth6809.asm):06953         ;    Inputs:
                      (    forth6809.asm):06954         ;        return address on S points at the count byte
                      (    forth6809.asm):06955         ;    Outputs:
                      (    forth6809.asm):06956         ;        string displayed; execution resumes after the string
                      (    forth6809.asm):06957         ;    Registers: RegB, RegD and RegX changed.
                      (    forth6809.asm):06958         ; ------------------------------------------------------------
F3E9 3510             (    forth6809.asm):06959         DOTSTR:     PULS  X
F3EB E684             (    forth6809.asm):06960                     LDB   ,X
F3ED 3001             (    forth6809.asm):06961                     LEAX  1,X
F3EF 3610             (    forth6809.asm):06962                     PSHU  X
F3F1 4F               (    forth6809.asm):06963                     CLRA
F3F2 3606             (    forth6809.asm):06964                     PSHU  D
F3F4 3085             (    forth6809.asm):06965                     LEAX  B,X
F3F6 3410             (    forth6809.asm):06966                     PSHS  X
F3F8 7EF431           (    forth6809.asm):06967                     JMP   TYPEW
                      (    forth6809.asm):06968         
                      (    forth6809.asm):06969         ; ------------------------------------------------------------
                      (    forth6809.asm):06970         ; ."  ( "ccc<quote>" -- )
                      (    forth6809.asm):06971         ; Compile DOTSTR followed by the string up to the closing quote as a
                      (    forth6809.asm):06972         ; counted string.
                      (    forth6809.asm):06973         ; ------------------------------------------------------------
F3FB BDF2B8           (    forth6809.asm):06974         DOTQUOTEW:  JSR   PARSEQUOTE        ; See bugfix: SQUOTEW.3
F3FE CCF3E9           (    forth6809.asm):06975                     LDD   #DOTSTR
F401 7EF2CD           (    forth6809.asm):06976                     JMP   CSTRCOMP
                      (    forth6809.asm):06977         
                      (    forth6809.asm):06978         ; ------------------------------------------------------------
                      (    forth6809.asm):06979         ; Run-time part of C"  The counted string follows the call: push its
                      (    forth6809.asm):06980         ; address and skip over it.
                      (    forth6809.asm):06981         ; DOCSTR
                      (    forth6809.asm):06982         ;    Outputs:
                      (    forth6809.asm):06983         ;        ( -- c-addr ) the count byte address; execution resumes after
                      (    forth6809.asm):06984         ;        the string
                      (    forth6809.asm):06985         ;    Registers: RegB, RegD and RegX changed.
                      (    forth6809.asm):06986         ; ------------------------------------------------------------
F404 3510             (    forth6809.asm):06987         DOCSTR:     PULS  X
F406 3610             (    forth6809.asm):06988                     PSHU  X
F408 E684             (    forth6809.asm):06989                     LDB   ,X
F40A 3001             (    forth6809.asm):06990                     LEAX  1,X
F40C 3085             (    forth6809.asm):06991                     LEAX  B,X
F40E 3410             (    forth6809.asm):06992                     PSHS  X
F410 39               (    forth6809.asm):06993                     RTS
                      (    forth6809.asm):06994         
                      (    forth6809.asm):06995         ; ------------------------------------------------------------
                      (    forth6809.asm):06996         ; C"  ( "ccc<quote>" -- )  compile: ( -- c-addr ) run-time
                      (    forth6809.asm):06997         ; Compile DOCSTR followed by the string up to the closing quote as a
                      (    forth6809.asm):06998         ; counted string. THROW -14 if not compiling.
                      (    forth6809.asm):06999         ; ------------------------------------------------------------

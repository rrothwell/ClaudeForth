E989 ECC4             (    forth6809.asm):05334         ROTW:       LDD   ,U                ; x3
E98B AE42             (    forth6809.asm):05335                     LDX   2,U               ; x2
E98D 10AE44           (    forth6809.asm):05336                     LDY   4,U               ; x1

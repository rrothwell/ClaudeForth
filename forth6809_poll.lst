E82A 10830000         (    forth6809.asm):05044                     CMPD  #0
E82E 260A             (    forth6809.asm):05045                     BNE   TICKOK
E830 3706             (    forth6809.asm):05046                     PULU  D                 ; drop the name
E832 CCFFF3           (    forth6809.asm):05047                     LDD   #-13              ; -13

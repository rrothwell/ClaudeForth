DC8B 3406             (    forth6809.asm):05204                     PSHS  D
DC8D DC16             (    forth6809.asm):05205                     LDD   MSCR2
DC8F 3406             (    forth6809.asm):05206                     PSHS  D
DC91 DC14             (    forth6809.asm):05207                     LDD   MSCR
DC93 3406             (    forth6809.asm):05208                     PSHS  D
DC95 3410             (    forth6809.asm):05209                     PSHS  X
DC97 39               (    forth6809.asm):05210                     RTS

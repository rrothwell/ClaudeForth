D87D B7C009           (    forth6809.asm):04471                     STA   ACIADR
D880 39               (    forth6809.asm):04472                     RTS
                      (    forth6809.asm):04473         
                      (    forth6809.asm):04474         ; ------------------------------------------------------------
                      (    forth6809.asm):04475         ; KEY?  ( -- flag )  [polling build]

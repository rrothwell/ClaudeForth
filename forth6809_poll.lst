                      (    forth6809.asm):07674         ; ============================================================
                      (    forth6809.asm):07675         ; SECTION 20: NUMERIC OUTPUT (pictured + direct)
                      (    forth6809.asm):07676         ; ============================================================
                      (    forth6809.asm):07677         ; ------------------------------------------------------------
                      (    forth6809.asm):07678         ; <#  ( -- )
                      (    forth6809.asm):07679         ; Start a pictured numeric output string: HLD is set to the end of
                      (    forth6809.asm):07680         ; PAD. The string is built backwards from there.
                      (    forth6809.asm):07681         ; ------------------------------------------------------------
F876 BDDDDC           (    forth6809.asm):07682         LTNUMW:     JSR   PADW
F879 3706             (    forth6809.asm):07683                     PULU  D
F87B DD1C             (    forth6809.asm):07684                     STD   HLD
F87D 39               (    forth6809.asm):07685                     RTS
                      (    forth6809.asm):07686         
                      (    forth6809.asm):07687         ; ------------------------------------------------------------
                      (    forth6809.asm):07688         ; HOLD  ( char -- )
                      (    forth6809.asm):07689         ; Add char to the front of the pictured numeric output string.
                      (    forth6809.asm):07690         ; ------------------------------------------------------------
F87E 3706             (    forth6809.asm):07691         HOLDW:      PULU  D                 ; char
F880 9E1C             (    forth6809.asm):07692                     LDX   HLD
F882 301F             (    forth6809.asm):07693                     LEAX  -1,X
F884 9F1C             (    forth6809.asm):07694                     STX   HLD
F886 E784             (    forth6809.asm):07695                     STB   ,X
F888 39               (    forth6809.asm):07696                     RTS
                      (    forth6809.asm):07697         
                      (    forth6809.asm):07698         ; ------------------------------------------------------------
                      (    forth6809.asm):07699         ; HOLDS  ( c-addr u -- )
                      (    forth6809.asm):07700         ; Add the string c-addr u to the front of the pictured numeric output
                      (    forth6809.asm):07701         ; string.
                      (    forth6809.asm):07702         ; ------------------------------------------------------------
F889 ECC4             (    forth6809.asm):07703         HOLDSW:     LDD   ,U                ; u at 0, c-addr at 2
F88B 2713             (    forth6809.asm):07704                     BEQ   HSDONE
F88D 830001           (    forth6809.asm):07705                     SUBD  #1
F890 EDC4             (    forth6809.asm):07706                     STD   ,U                ; remaining count
F892 AE42             (    forth6809.asm):07707                     LDX   2,U
F894 A68B             (    forth6809.asm):07708                     LDA   D,X               ; the last remaining character
F896 1F89             (    forth6809.asm):07709                     TFR   A,B
F898 4F               (    forth6809.asm):07710                     CLRA
F899 3606             (    forth6809.asm):07711                     PSHU  D
F89B BDF87E           (    forth6809.asm):07712                     JSR   HOLDW             ; consumes the character
F89E 20E9             (    forth6809.asm):07713                     BRA   HOLDSW
F8A0 3344             (    forth6809.asm):07714         HSDONE:     LEAU  4,U               ; drop the two parameters
F8A2 39               (    forth6809.asm):07715                     RTS
                      (    forth6809.asm):07716         
                      (    forth6809.asm):07717         ; ------------------------------------------------------------
                      (    forth6809.asm):07718         ; #  ( ud1 -- ud2 )
                      (    forth6809.asm):07719         ; Divide ud1 by BASE, add the remainder as a digit to the pictured
                      (    forth6809.asm):07720         ; numeric output string, and leave the quotient ud2.
                      (    forth6809.asm):07721         ; ------------------------------------------------------------
F8A3 BDF8B8           (    forth6809.asm):07722         NUMW:       JSR   UDDIGIT           ; ud1 is divided in place on the data stack
F8A6 810A             (    forth6809.asm):07723                     CMPA  #10
F8A8 2504             (    forth6809.asm):07724                     BLO   NDIGIT
F8AA 8B37             (    forth6809.asm):07725                     ADDA  #'A'-10
F8AC 2002             (    forth6809.asm):07726                     BRA   NHOLD
F8AE 8B30             (    forth6809.asm):07727         NDIGIT:     ADDA  #'0'
F8B0 1F89             (    forth6809.asm):07728         NHOLD:      TFR   A,B
F8B2 4F               (    forth6809.asm):07729                     CLRA
F8B3 3606             (    forth6809.asm):07730                     PSHU  D
F8B5 7EF87E           (    forth6809.asm):07731                     JMP   HOLDW
                      (    forth6809.asm):07732         
                      (    forth6809.asm):07733         ; ------------------------------------------------------------
                      (    forth6809.asm):07734         ; Divide the unsigned double on the data stack (high cell at 0,U, low
                      (    forth6809.asm):07735         ; cell at 2,U) by BASE (restoring division, 32 iterations). Only the
                      (    forth6809.asm):07736         ; low byte of BASE is used.
                      (    forth6809.asm):07737         ; UDDIGIT
                      (    forth6809.asm):07738         ;    Inputs:
                      (    forth6809.asm):07739         ;        ud on the data stack
                      (    forth6809.asm):07740         ;    Outputs:
                      (    forth6809.asm):07741         ;        ud replaced by the quotient; RegA = remainder
                      (    forth6809.asm):07742         ;    Registers: RegA and RegB changed (RegB is the loop counter).
                      (    forth6809.asm):07743         ; ------------------------------------------------------------
F8B8 4F               (    forth6809.asm):07744         UDDIGIT:    CLRA                    ; A = remainder
F8B9 C620             (    forth6809.asm):07745                     LDB   #32
F8BB 6843             (    forth6809.asm):07746         UDDLOOP:    ASL   3,U
F8BD 6942             (    forth6809.asm):07747                     ROL   2,U
F8BF 6941             (    forth6809.asm):07748                     ROL   1,U
F8C1 69C4             (    forth6809.asm):07749                     ROL   ,U
F8C3 49               (    forth6809.asm):07750                     ROLA
F8C4 9103             (    forth6809.asm):07751                     CMPA  BASE+1
F8C6 2504             (    forth6809.asm):07752                     BLO   UDNEXT
F8C8 9003             (    forth6809.asm):07753                     SUBA  BASE+1
F8CA 6C43             (    forth6809.asm):07754                     INC   3,U
F8CC 5A               (    forth6809.asm):07755         UDNEXT:     DECB
F8CD 26EC             (    forth6809.asm):07756                     BNE   UDDLOOP
F8CF 39               (    forth6809.asm):07757                     RTS
                      (    forth6809.asm):07758         
                      (    forth6809.asm):07759         ; ------------------------------------------------------------
                      (    forth6809.asm):07760         ; #S  ( ud -- 0 0 )
                      (    forth6809.asm):07761         ; Convert digits with # until the quotient is zero (at least one digit
                      (    forth6809.asm):07762         ; is produced).
                      (    forth6809.asm):07763         ; ------------------------------------------------------------
F8D0 BDF8A3           (    forth6809.asm):07764         NUMSW:      JSR   NUMW
F8D3 ECC4             (    forth6809.asm):07765                     LDD   ,U
F8D5 26F9             (    forth6809.asm):07766                     BNE   NUMSW
F8D7 EC42             (    forth6809.asm):07767                     LDD   2,U
F8D9 26F5             (    forth6809.asm):07768                     BNE   NUMSW
F8DB 39               (    forth6809.asm):07769                     RTS
                      (    forth6809.asm):07770         
                      (    forth6809.asm):07771         ; ------------------------------------------------------------
                      (    forth6809.asm):07772         ; SIGN  ( n -- )
                      (    forth6809.asm):07773         ; If n is negative, add a minus sign to the pictured numeric output
                      (    forth6809.asm):07774         ; string.
                      (    forth6809.asm):07775         ; ------------------------------------------------------------
F8DC 3706             (    forth6809.asm):07776         SIGNW:      PULU  D                 ; n
F8DE 4D               (    forth6809.asm):07777                     TSTA                    ; sign of n. See bugfix: SIGNW.1
F8DF 2A08             (    forth6809.asm):07778                     BPL   SIGNDONE
F8E1 CC002D           (    forth6809.asm):07779                     LDD   #'-'
F8E4 3606             (    forth6809.asm):07780                     PSHU  D
F8E6 BDF87E           (    forth6809.asm):07781                     JSR   HOLDW
F8E9 39               (    forth6809.asm):07782         SIGNDONE:   RTS
                      (    forth6809.asm):07783         
                      (    forth6809.asm):07784         ; ------------------------------------------------------------
                      (    forth6809.asm):07785         ; #>  ( xd -- c-addr u )
                      (    forth6809.asm):07786         ; Drop xd and return the pictured numeric output string.
                      (    forth6809.asm):07787         ; ------------------------------------------------------------
F8EA 3706             (    forth6809.asm):07788         NUMGTW:     PULU  D                 ; xd high
F8EC 3706             (    forth6809.asm):07789                     PULU  D                 ; xd low
F8EE 9E1C             (    forth6809.asm):07790                     LDX   HLD
F8F0 3610             (    forth6809.asm):07791                     PSHU  X
F8F2 BDDDDC           (    forth6809.asm):07792                     JSR   PADW
F8F5 3706             (    forth6809.asm):07793                     PULU  D
F8F7 931C             (    forth6809.asm):07794                     SUBD  HLD
F8F9 3606             (    forth6809.asm):07795                     PSHU  D
F8FB 39               (    forth6809.asm):07796                     RTS
                      (    forth6809.asm):07797         
                      (    forth6809.asm):07798         ; ------------------------------------------------------------
                      (    forth6809.asm):07799         ; .  ( n -- )
                      (    forth6809.asm):07800         ; Display n in the current base, followed by a space.
                      (    forth6809.asm):07801         ; ------------------------------------------------------------
F8FC 3706             (    forth6809.asm):07802         DOTW:       PULU  D                 ; n
F8FE 3406             (    forth6809.asm):07803                     PSHS  D                 ; n kept on S for SIGN (5m)
F900 4D               (    forth6809.asm):07804                     TSTA
F901 2A05             (    forth6809.asm):07805                     BPL   DABSOK
F903 43               (    forth6809.asm):07806                     COMA
F904 53               (    forth6809.asm):07807                     COMB
F905 C30001           (    forth6809.asm):07808                     ADDD  #1

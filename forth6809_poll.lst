                      (    forth6809.asm):04832         ;        execution continues after the string, or THROW -2
                      (    forth6809.asm):04833         ;    Registers: RegA, RegB, RegD, RegX, RegY changed.
                      (    forth6809.asm):04834         ; ------------------------------------------------------------

                      (    forth6809.asm):06258         ; Divide n1 by n2, giving the remainder n3 and the quotient n4.
                      (    forth6809.asm):06259         ; Division truncates toward zero; the remainder has the sign of the
                      (    forth6809.asm):06260         ; dividend. THROW -10 if the divisor is zero.
                      (    forth6809.asm):06261         ; ------------------------------------------------------------

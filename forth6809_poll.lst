                      (    forth6809.asm):03630         ; ------------------------------------------------------------
                      (    forth6809.asm):03631         ; Search one chain of headers for a name, ignoring smudged entries.
                      (    forth6809.asm):03632         ; Case matters. A zero-length name matches a zero-length header.
                      (    forth6809.asm):03633         ; The Search-Order design is in shadow SEARCHORDER.1.
                      (    forth6809.asm):03634         ; FDSEARCH
                      (    forth6809.asm):03635         ;    Inputs:
                      (    forth6809.asm):03636         ;        RegX = first header of the chain (0 = empty chain)
                      (    forth6809.asm):03637         ;        RegY = address of the name text
                      (    forth6809.asm):03638         ;        RegB = name length
                      (    forth6809.asm):03639         ;    Outputs:
                      (    forth6809.asm):03640         ;        RegX = the matching header, or 0 if there is none
                      (    forth6809.asm):03641         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):03642         ; ------------------------------------------------------------
D495 3424             (    forth6809.asm):03643         FDSEARCH:   PSHS  Y,B               ; 0,S = length, 1,S = name text
D497 8C0000           (    forth6809.asm):03644         FDLOOP:     CMPX  #0
D49A 2733             (    forth6809.asm):03645                     BEQ   FDRET
D49C A684             (    forth6809.asm):03646                     LDA   ,X
D49E 8540             (    forth6809.asm):03647                     BITA  #$40
D4A0 2620             (    forth6809.asm):03648                     BNE   FDNEXT            ; smudged
D4A2 841F             (    forth6809.asm):03649                     ANDA  #$1F
D4A4 A1E4             (    forth6809.asm):03650                     CMPA  ,S
D4A6 261A             (    forth6809.asm):03651                     BNE   FDNEXT
D4A8 3410             (    forth6809.asm):03652                     PSHS  X                 ; header, kept across the compare
D4AA 3001             (    forth6809.asm):03653                     LEAX  1,X
D4AC 10AE63           (    forth6809.asm):03654                     LDY   3,S               ; name text

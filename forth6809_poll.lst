DF5B EC84             (    forth6809.asm):05795                     LDD   ,X
DF5D 3406             (    forth6809.asm):05796                     PSHS  D                 ; xu waits on the return stack
DF5F EC1E             (    forth6809.asm):05797         RLOOP:      LDD   -2,X
DF61 ED84             (    forth6809.asm):05798                     STD   ,X
DF63 301E             (    forth6809.asm):05799                     LEAX  -2,X
DF65 313F             (    forth6809.asm):05800                     LEAY  -1,Y

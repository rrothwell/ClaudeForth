                      (    forth6809.asm):04198         ; ------------------------------------------------------------
                      (    forth6809.asm):04199         ; Convert a counted string to a number in BASE. A leading "-" negates
                      (    forth6809.asm):04200         ; it; a trailing "." makes it a double-cell number.
                      (    forth6809.asm):04201         ; NUMBERQ   ( c-addr -- n -1 | ud 1 | c-addr 0 )
                      (    forth6809.asm):04202         ;    Inputs:
                      (    forth6809.asm):04203         ;        c-addr of the counted string on the data stack
                      (    forth6809.asm):04204         ;    Outputs:
                      (    forth6809.asm):04205         ;        single number: n and -1
                      (    forth6809.asm):04206         ;        double number: ud (low cell below high cell) and 1
                      (    forth6809.asm):04207         ;        not a number: c-addr and 0
                      (    forth6809.asm):04208         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):04209         ; The original c-addr and the negate flag live in an S frame (0,S and
                      (    forth6809.asm):04210         ; 2,S); the count is kept in RegB. See shadow NUMBERQ.1 and
                      (    forth6809.asm):04211         ; NUMBERQ.6.
                      (    forth6809.asm):04212         ; ------------------------------------------------------------
DB34 3710             (    forth6809.asm):04213         NUMBERQ:    PULU  X                 ; c-addr
DB36 327D             (    forth6809.asm):04214                     LEAS  -3,S
DB38 AFE4             (    forth6809.asm):04215                     STX   ,S
DB3A E684             (    forth6809.asm):04216                     LDB   ,X
DB3C 276D             (    forth6809.asm):04217                     BEQ   NQBAD
DB3E 3001             (    forth6809.asm):04218                     LEAX  1,X
                      (    forth6809.asm):04219         
                      (    forth6809.asm):04220                     ; A trailing "." means a double number: leave it out of the
                      (    forth6809.asm):04221                     ; digit count. See shadow: NUMBERQ.1
DB40 5A               (    forth6809.asm):04222                     DECB
DB41 A685             (    forth6809.asm):04223                     LDA   B,X
DB43 5C               (    forth6809.asm):04224                     INCB
DB44 812E             (    forth6809.asm):04225                     CMPA  #'.'
DB46 2603             (    forth6809.asm):04226                     BNE   NQNOSIGN
DB48 5A               (    forth6809.asm):04227                     DECB
DB49 2760             (    forth6809.asm):04228                     BEQ   NQBAD             ; lone "." with nothing before it
                      (    forth6809.asm):04229         
DB4B 6F62             (    forth6809.asm):04230         NQNOSIGN:   CLR   2,S
DB4D A684             (    forth6809.asm):04231                     LDA   ,X
DB4F 812D             (    forth6809.asm):04232                     CMPA  #'-'
DB51 2607             (    forth6809.asm):04233                     BNE   NQNOSIGN2
DB53 6362             (    forth6809.asm):04234                     COM   2,S
DB55 3001             (    forth6809.asm):04235                     LEAX  1,X
DB57 5A               (    forth6809.asm):04236                     DECB
DB58 2751             (    forth6809.asm):04237                     BEQ   NQBAD
                      (    forth6809.asm):04238         
DB5A 108E0000         (    forth6809.asm):04239         NQNOSIGN2:  LDY   #0
DB5E 3620             (    forth6809.asm):04240                     PSHU  Y                 ; ud low
DB60 3620             (    forth6809.asm):04241                     PSHU  Y                 ; ud high
DB62 3610             (    forth6809.asm):04242                     PSHU  X                 ; c-addr
DB64 4F               (    forth6809.asm):04243                     CLRA
DB65 3606             (    forth6809.asm):04244                     PSHU  D                 ; u
                      (    forth6809.asm):04245         
DB67 BDDAFB           (    forth6809.asm):04246                     JSR   NUMLOOP
                      (    forth6809.asm):04247         
DB6A ECC4             (    forth6809.asm):04248                     LDD   ,U
DB6C 263B             (    forth6809.asm):04249                     BNE   NQBADF            ; unconverted characters remain
DB6E 3344             (    forth6809.asm):04250                     LEAU  4,U               ; drop u and c-addr: ud remains
                      (    forth6809.asm):04251         

                      (    forth6809.asm):04986         ; I  ( -- n )
                      (    forth6809.asm):04987         ; Push the index of the innermost loop (2,S, beyond the return
                      (    forth6809.asm):04988         ; address).
                      (    forth6809.asm):04989         ; ------------------------------------------------------------

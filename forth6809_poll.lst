                      (    forth6809.asm):04206         ; on the control-flow stack for LOOP or +LOOP.
                      (    forth6809.asm):04207         ; ------------------------------------------------------------
E5E0 CCE5F2           (    forth6809.asm):04208         DOW:        LDD   #DOSETUP
E5E3 3606             (    forth6809.asm):04209                     PSHU  D
E5E5 BDE85D           (    forth6809.asm):04210                     JSR   CCALL
E5E8 DC08             (    forth6809.asm):04211                     LDD   CODEHERE

DA5F                  (    forth6809.asm):02244         INXPE:      RTI
                      (    forth6809.asm):02245         
DA5F                  (    forth6809.asm):02246         INOK:       TFR   B,A               ; Transfer good character from the receiver.
                      (    forth6809.asm):02247                     LDX   #INBUF            ; Store it in the empty in buffer slot.
                      (    forth6809.asm):02248                     LDB   INHEAD
                      (    forth6809.asm):02249                     STA   B,X
                      (    forth6809.asm):02250                     INCB                    ; Figure out the new head,
                      (    forth6809.asm):02251                     ANDB  #INBUFSZ-1        ; pointing to the next the empty in buffer slot.
                      (    forth6809.asm):02252                     CMPB  INTAIL            ; Would the new head slot meet the tail?
                      (    forth6809.asm):02253                     BEQ   IRQDONE1          ; Don't allow it - buffer full, drop the character.
                      (    forth6809.asm):02254                     STB   INHEAD            ; New head pointer is OK so store it.
                      (    forth6809.asm):02255                     ; Commented-out code moved to shadow: INCHAR.2
                      (    forth6809.asm):02256                     ; Reuse RegB (the new head) for the fill level.
                      (    forth6809.asm):02257                     ; See shadow: INCHAR.1
                      (    forth6809.asm):02258                     SUBB  INTAIL            ; RegB: new head - tail = current fill level.
                      (    forth6809.asm):02259                     ANDB  #INBUFSZ-1
                      (    forth6809.asm):02260                     JSR   CHKHI             ; Protect the in buffer from overflow.
DA5F                  (    forth6809.asm):02261         IRQDONE1:   RTI
                      (    forth6809.asm):02262         
                      (    forth6809.asm):02263                     ; Commented-out code moved to shadow: OUTCHAR.1
                      (    forth6809.asm):02264         
DA5F                  (    forth6809.asm):02265         OUTCHAR:    LDB   OUTTAIL           ; Is the out buffer empty?
                      (    forth6809.asm):02266                     CMPB  OUTHEAD
                      (    forth6809.asm):02267                     BEQ   TXOFF             ; Yes! Stop transmitting.
                      (    forth6809.asm):02268         
                      (    forth6809.asm):02269                     LDX   #OUTBUF           ; No! The out buffer is occupied.
                      (    forth6809.asm):02270                     LDA   B,X               ; Get the character from the out buffer.
                      (    forth6809.asm):02271                     STA   ACIADR            ; Transmit the char.
                      (    forth6809.asm):02272         
                      (    forth6809.asm):02273                     INCB                    ; Update the tail pointer pointing to the next char.
                      (    forth6809.asm):02274                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02275                     STB   OUTTAIL
DA5F                  (    forth6809.asm):02276         IRQDONE2    RTI
                      (    forth6809.asm):02277         
DA5F                  (    forth6809.asm):02278         TXOFF:                              ; The output ring is empty.
                      (    forth6809.asm):02279                     ; Commented-out code moved to shadow: TXOFF.1
                      (    forth6809.asm):02280                     CLR   OUTACTIVITY
                      (    forth6809.asm):02281                     JSR   UPDATE_RTS
DA5F                  (    forth6809.asm):02282         IRQDONE3    RTI
                      (    forth6809.asm):02283         
                      (    forth6809.asm):02284                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):02285         
DA5F 3B               (    forth6809.asm):02286         IRQH:       RTI                     ; polling mode (SERIALPOLL=1) - ACIA
                      (    forth6809.asm):02287                                             ; interrupts are never enabled (see
                      (    forth6809.asm):02288                                             ; COLDSTRT's CR_POLL init), so this should
                      (    forth6809.asm):02289                                             ; never fire; kept as a safe stub matching
                      (    forth6809.asm):02290                                             ; the other unused vectors below
                      (    forth6809.asm):02291                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):02292         
                      (    forth6809.asm):02293         ; ------------------------------------------------------------
                      (    forth6809.asm):02294         ; Unused interrupt handlers: return immediately. SWIH instead
                      (    forth6809.asm):02295         ; pushes the throw code -99 and jumps to THROW.
                      (    forth6809.asm):02296         ; ------------------------------------------------------------
DA60 3B               (    forth6809.asm):02297         SWI3H:      RTI
DA61 3B               (    forth6809.asm):02298         SWI2H:      RTI
DA62 3B               (    forth6809.asm):02299         FIRQH:      RTI
DA63 3B               (    forth6809.asm):02300         NMIH:       RTI                     ; unused now that NMI -> WARM
DA64 CCFF9D           (    forth6809.asm):02301         SWIH:       LDD   #-99              ; placeholder hardware-trap code; push and
DA67 3606             (    forth6809.asm):02302                     PSHU  D                 ; JMP THROW, per the CATCH/THROW turn
DA69 7EE403           (    forth6809.asm):02303                     JMP   THROWW
                      (    forth6809.asm):02304         
                      (    forth6809.asm):02305         ; ============================================================
                      (    forth6809.asm):02306         ; SECTION 4: COLD / ABORT / QUIT  (with CATCH-wrapped INTERPRET)
                      (    forth6809.asm):02307         ; ============================================================
                      (    forth6809.asm):02308         ; ------------------------------------------------------------
                      (    forth6809.asm):02309         ; Cold start: set the dictionary, code and variable pointers to
                      (    forth6809.asm):02310         ; their application areas, BASE to 10 and the input source to the
                      (    forth6809.asm):02311         ; terminal buffer, print the sign-on banner, then enter ABORT.
                      (    forth6809.asm):02312         ; COLD
                      (    forth6809.asm):02313         ;    Inputs:
                      (    forth6809.asm):02314         ;        none (entered at reset)
                      (    forth6809.asm):02315         ;    Outputs:
                      (    forth6809.asm):02316         ;        none (does not return)
                      (    forth6809.asm):02317         ;    Registers: all changed.
                      (    forth6809.asm):02318         ; ------------------------------------------------------------
DA6C CC0240           (    forth6809.asm):02319         COLD:       LDD   #APPVARS
DA6F DD0A             (    forth6809.asm):02320                     STD   VARHERE
DA71 CC7000           (    forth6809.asm):02321                     LDD   #APPCODE
DA74 DD08             (    forth6809.asm):02322                     STD   CODEHERE
DA76 CC2000           (    forth6809.asm):02323                     LDD   #APPDICT
DA79 DD06             (    forth6809.asm):02324                     STD   DPHERE
DA7B CCDA2A           (    forth6809.asm):02325                     LDD   #BASELATEST
DA7E DD04             (    forth6809.asm):02326                     STD   LATEST
DA80 BDE0E1           (    forth6809.asm):02327                     JSR   WLINIT            ; FORTH wordlist, search order and CURRENT
                      (    forth6809.asm):02328         
DA83 CC000A           (    forth6809.asm):02329                     LDD   #10
DA86 DD02             (    forth6809.asm):02330                     STD   BASE
                      (    forth6809.asm):02331         
DA88 CC0106           (    forth6809.asm):02332                     LDD   #TIBBUF
DA8B DD39             (    forth6809.asm):02333                     STD   SRCADDR
DA8D CC0000           (    forth6809.asm):02334                     LDD   #0
DA90 DD3B             (    forth6809.asm):02335                     STD   SRCLEN
DA92 DD3D             (    forth6809.asm):02336                     STD   SRCID
                      (    forth6809.asm):02337         
DA94 8EDB3A           (    forth6809.asm):02338                     LDX   #SIGNON
DA97 3610             (    forth6809.asm):02339                     PSHU  X                 ; c-addr
DA99 CC000F           (    forth6809.asm):02340                     LDD   #SIGNONL
DA9C 3606             (    forth6809.asm):02341                     PSHU  D                 ; u
DA9E BDF412           (    forth6809.asm):02342                     JSR   TYPEW
DAA1 BDFA21           (    forth6809.asm):02343                     JSR   CRW
DAA4 2008             (    forth6809.asm):02344                     BRA   ABORT             ; Go to ABORT, skipping the ABORTW word.
                      (    forth6809.asm):02345         
                      (    forth6809.asm):02346         ; ------------------------------------------------------------
                      (    forth6809.asm):02347         ; ABORT  ( i*x -- ) ( R: j*x -- )
                      (    forth6809.asm):02348         ; Throw -1. With no CATCH frame, THROW falls into the ABORT reset below.
                      (    forth6809.asm):02349         ; ------------------------------------------------------------
DAA6 CCFFFF           (    forth6809.asm):02350         ABORTW:     LDD   #-1
DAA9 3606             (    forth6809.asm):02351                     PSHU  D                 ; throw code (-1)
DAAB 7EE403           (    forth6809.asm):02352                     JMP   THROWW
                      (    forth6809.asm):02353         
                      (    forth6809.asm):02354         ; ------------------------------------------------------------
                      (    forth6809.asm):02355         ; Reset the data stack to its base, then fall through into QUITW.
                      (    forth6809.asm):02356         ; ABORT
                      (    forth6809.asm):02357         ;    Inputs:
                      (    forth6809.asm):02358         ;        none
                      (    forth6809.asm):02359         ;    Outputs:
                      (    forth6809.asm):02360         ;        none (does not return)
                      (    forth6809.asm):02361         ;    Registers: RegU changed.
                      (    forth6809.asm):02362         ; ------------------------------------------------------------
DAAE CEBD00           (    forth6809.asm):02363         ABORT:      LDU   #SP0
                      (    forth6809.asm):02364                     ; falls through into QUIT
                      (    forth6809.asm):02365         
                      (    forth6809.asm):02366         ; ------------------------------------------------------------
                      (    forth6809.asm):02367         ; QUIT  ( -- ) ( R: i*x -- )
                      (    forth6809.asm):02368         ; Empty the return stack, set interpretation state, then loop reading
                      (    forth6809.asm):02369         ; a line and interpreting it under CATCH. Errors are reported as
                      (    forth6809.asm):02370         ; "ERROR n"; -1 (ABORT) is silent. Never returns.
                      (    forth6809.asm):02371         ; ------------------------------------------------------------
DAB1 10CEC000         (    forth6809.asm):02372         QUITW:      LDS   #RP0
DAB5 CC0000           (    forth6809.asm):02373                     LDD   #0
DAB8 DD00             (    forth6809.asm):02374                     STD   STATE             ; See bugfix: QUITW.1
                      (    forth6809.asm):02375         
DABA BDE3AE           (    forth6809.asm):02376         QLOOP:      JSR   QUERYW
                      (    forth6809.asm):02377         
DABD DC06             (    forth6809.asm):02378                     LDD   DPHERE            ; Checkpoint on the return stack. CATCH
DABF 3406             (    forth6809.asm):02379                     PSHS  D                 ; and THROW restore S, so the frame is
DAC1 DC08             (    forth6809.asm):02380                     LDD   CODEHERE          ; intact whichever way INTERPRET ends.
DAC3 3406             (    forth6809.asm):02381                     PSHS  D                 ; See shadow QLOOP.2
DAC5 DC0A             (    forth6809.asm):02382                     LDD   VARHERE
DAC7 3406             (    forth6809.asm):02383                     PSHS  D
DAC9 DC04             (    forth6809.asm):02384                     LDD   LATEST
DACB 3406             (    forth6809.asm):02385                     PSHS  D
                      (    forth6809.asm):02386         
DACD CCDF0A           (    forth6809.asm):02387                     LDD   #INTERPRET
DAD0 3606             (    forth6809.asm):02388                     PSHU  D                 ; xt
DAD2 BDE3D7           (    forth6809.asm):02389                     JSR   CATCHW
DAD5 3706             (    forth6809.asm):02390                     PULU  D                 ; throw code (0 = no error)
DAD7 3406             (    forth6809.asm):02391                     PSHS  D                 ; frame: 0,S code  2,S LATEST  4,S VARHERE
DAD9 10830000         (    forth6809.asm):02392                     CMPD  #0                ;        6,S CODEHERE  8,S DPHERE
DADD 2743             (    forth6809.asm):02393                     BEQ   QOK
                      (    forth6809.asm):02394         
DADF EC68             (    forth6809.asm):02395                     LDD   8,S
DAE1 DD06             (    forth6809.asm):02396                     STD   DPHERE
DAE3 BDE0F8           (    forth6809.asm):02397                     JSR   PRUNE             ; unlink headers newer than DPHERE
DAE6 EC66             (    forth6809.asm):02398                     LDD   6,S
DAE8 DD08             (    forth6809.asm):02399                     STD   CODEHERE
DAEA EC64             (    forth6809.asm):02400                     LDD   4,S
DAEC DD0A             (    forth6809.asm):02401                     STD   VARHERE
DAEE EC62             (    forth6809.asm):02402                     LDD   2,S
DAF0 DD04             (    forth6809.asm):02403                     STD   LATEST
DAF2 CEBD00           (    forth6809.asm):02404                     LDU   #SP0
                      (    forth6809.asm):02405         
                      (    forth6809.asm):02406                     ; Return to interpretation state after a caught error.
                      (    forth6809.asm):02407                     ; See bugfix: QLOOP.1
DAF5 CC0000           (    forth6809.asm):02408                     LDD   #0
DAF8 DD00             (    forth6809.asm):02409                     STD   STATE
                      (    forth6809.asm):02410         
DAFA ECE4             (    forth6809.asm):02411                     LDD   ,S                ; -1 is ABORT: reset silently, no "ERROR -1"
DAFC 1083FFFF         (    forth6809.asm):02412                     CMPD  #-1
DB00 2605             (    forth6809.asm):02413                     BNE   QSHOWERR
DB02 326A             (    forth6809.asm):02414                     LEAS  10,S              ; drop the frame
DB04 16FFB3           (    forth6809.asm):02415                     LBRA  QLOOP
                      (    forth6809.asm):02416         
DB07 BDFA21           (    forth6809.asm):02417         QSHOWERR:   JSR   CRW
DB0A 8EDB4D           (    forth6809.asm):02418                     LDX   #ERRMSG
DB0D 3610             (    forth6809.asm):02419                     PSHU  X                 ; c-addr
DB0F CC0008           (    forth6809.asm):02420                     LDD   #ERRMSGL
DB12 3606             (    forth6809.asm):02421                     PSHU  D                 ; u
DB14 BDF412           (    forth6809.asm):02422                     JSR   TYPEW
DB17 ECE4             (    forth6809.asm):02423                     LDD   ,S
DB19 3606             (    forth6809.asm):02424                     PSHU  D                 ; n
DB1B BDF8F0           (    forth6809.asm):02425                     JSR   DOTW
DB1E 326A             (    forth6809.asm):02426                     LEAS  10,S              ; drop the frame
DB20 2098             (    forth6809.asm):02427                     BRA   QLOOP
                      (    forth6809.asm):02428         
DB22 326A             (    forth6809.asm):02429         QOK:        LEAS  10,S              ; drop the frame
DB24 BDFA21           (    forth6809.asm):02430                     JSR   CRW               ; See bugfix: QOK.1
DB27 DC00             (    forth6809.asm):02431                     LDD   STATE
DB29 268F             (    forth6809.asm):02432                     BNE   QLOOP
DB2B 8EDB49           (    forth6809.asm):02433                     LDX   #OKMSG
DB2E 3610             (    forth6809.asm):02434                     PSHU  X                 ; c-addr
DB30 CC0004           (    forth6809.asm):02435                     LDD   #OKMSGL
DB33 3606             (    forth6809.asm):02436                     PSHU  D                 ; u
DB35 BDF412           (    forth6809.asm):02437                     JSR   TYPEW
DB38 2080             (    forth6809.asm):02438                     BRA   QLOOP
                      (    forth6809.asm):02439         
DB3A 3638303920464F52 (    forth6809.asm):02440         SIGNON:     FCC   "6809 FORTH v1.0"
     54482076312E30
     000F             (    forth6809.asm):02441         SIGNONL     EQU   *-SIGNON
DB49 20206F6B         (    forth6809.asm):02442         OKMSG:      FCC   "  ok"
     0004             (    forth6809.asm):02443         OKMSGL      EQU   *-OKMSG
DB4D 20204552524F5220 (    forth6809.asm):02444         ERRMSG:     FCC   "  ERROR "
     0008             (    forth6809.asm):02445         ERRMSGL     EQU   *-ERRMSG
                      (    forth6809.asm):02446         
                      (    forth6809.asm):02447         ; ============================================================
                      (    forth6809.asm):02448         ; SECTION 5: INNER-INTERPRETER SUPPORT (LIT, ZBRANCH, BRANCH,
                      (    forth6809.asm):02449         ; DODOES, DODEFER, EXECUTE)
                      (    forth6809.asm):02450         ; ============================================================
                      (    forth6809.asm):02451         ; ------------------------------------------------------------
                      (    forth6809.asm):02452         ; Run-time for a literal: fetch the inline cell that follows the
                      (    forth6809.asm):02453         ; calling JSR, push it, and advance the return address past it.
                      (    forth6809.asm):02454         ; LIT   ( -- x )
                      (    forth6809.asm):02455         ;    Inputs:
                      (    forth6809.asm):02456         ;        return stack top = address of the inline 16-bit literal
                      (    forth6809.asm):02457         ;    Outputs:
                      (    forth6809.asm):02458         ;        x pushed on the data stack; return address advanced by 2
                      (    forth6809.asm):02459         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02460         ; ------------------------------------------------------------
DB55 3510             (    forth6809.asm):02461         LIT:        PULS  X
DB57 EC81             (    forth6809.asm):02462                     LDD   ,X++
DB59 3606             (    forth6809.asm):02463                     PSHU  D                 ; x
DB5B 3410             (    forth6809.asm):02464                     PSHS  X
DB5D 39               (    forth6809.asm):02465                     RTS
                      (    forth6809.asm):02466         
                      (    forth6809.asm):02467         ; ------------------------------------------------------------
                      (    forth6809.asm):02468         ; Run-time for a conditional branch: take the inline offset if the
                      (    forth6809.asm):02469         ; flag is false, otherwise skip it. The offset is relative to its own
                      (    forth6809.asm):02470         ; address.
                      (    forth6809.asm):02471         ; ZBRANCH   ( flag -- )
                      (    forth6809.asm):02472         ;    Inputs:
                      (    forth6809.asm):02473         ;        flag on the data stack
                      (    forth6809.asm):02474         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02475         ;    Outputs:
                      (    forth6809.asm):02476         ;        flag removed; return address set to the branch target or past
                      (    forth6809.asm):02477         ;        the offset
                      (    forth6809.asm):02478         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02479         ; ------------------------------------------------------------
DB5E 3706             (    forth6809.asm):02480         ZBRANCH:    PULU  D                 ; flag
DB60 3510             (    forth6809.asm):02481                     PULS  X
DB62 10830000         (    forth6809.asm):02482                     CMPD  #0
DB66 2607             (    forth6809.asm):02483                     BNE   ZSKIP
DB68 EC84             (    forth6809.asm):02484                     LDD   ,X
DB6A 308B             (    forth6809.asm):02485                     LEAX  D,X
DB6C 3410             (    forth6809.asm):02486                     PSHS  X
DB6E 39               (    forth6809.asm):02487                     RTS
DB6F 3002             (    forth6809.asm):02488         ZSKIP:      LEAX  2,X
DB71 3410             (    forth6809.asm):02489                     PSHS  X
DB73 39               (    forth6809.asm):02490                     RTS
                      (    forth6809.asm):02491         
                      (    forth6809.asm):02492         ; ------------------------------------------------------------
                      (    forth6809.asm):02493         ; Run-time for an unconditional branch: add the inline offset
                      (    forth6809.asm):02494         ; (relative to its own address) to the return address.
                      (    forth6809.asm):02495         ; BRANCH
                      (    forth6809.asm):02496         ;    Inputs:
                      (    forth6809.asm):02497         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02498         ;    Outputs:
                      (    forth6809.asm):02499         ;        return address set to the branch target
                      (    forth6809.asm):02500         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02501         ; ------------------------------------------------------------
DB74 3510             (    forth6809.asm):02502         BRANCH:     PULS  X
DB76 EC84             (    forth6809.asm):02503                     LDD   ,X
DB78 308B             (    forth6809.asm):02504                     LEAX  D,X
DB7A 3410             (    forth6809.asm):02505                     PSHS  X
DB7C 39               (    forth6809.asm):02506                     RTS
                      (    forth6809.asm):02507         
                      (    forth6809.asm):02508         ; ------------------------------------------------------------
                      (    forth6809.asm):02509         ; Run-time entry of a CREATEd or DOES>-defined word. Its code is a
                      (    forth6809.asm):02510         ; trampoline: JSR DODOES, a BEHAVIOR address, then the data-field
                      (    forth6809.asm):02511         ; address. Pushes the data-field address and jumps to BEHAVIOR.
                      (    forth6809.asm):02512         ; DODOES   ( -- pfa )
                      (    forth6809.asm):02513         ;    Inputs:
                      (    forth6809.asm):02514         ;        return stack top = address of the BEHAVIOR cell in the
                      (    forth6809.asm):02515         ;        trampoline
                      (    forth6809.asm):02516         ;    Outputs:
                      (    forth6809.asm):02517         ;        pfa pushed on the data stack; control passes to BEHAVIOR
                      (    forth6809.asm):02518         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02519         ; ------------------------------------------------------------
DB7D 3510             (    forth6809.asm):02520         DODOES:     PULS  X
DB7F 10AE81           (    forth6809.asm):02521                     LDY   ,X++
DB82 EC84             (    forth6809.asm):02522                     LDD   ,X
DB84 3606             (    forth6809.asm):02523                     PSHU  D                 ; pfa
DB86 6EA4             (    forth6809.asm):02524                     JMP   ,Y
                      (    forth6809.asm):02525         
                      (    forth6809.asm):02526         ; ------------------------------------------------------------
                      (    forth6809.asm):02527         ; Default BEHAVIOR for a CREATEd word: do nothing, leaving the data-
                      (    forth6809.asm):02528         ; field address on the stack.
                      (    forth6809.asm):02529         ; DOESRT0
                      (    forth6809.asm):02530         ;    Inputs:
                      (    forth6809.asm):02531         ;        none
                      (    forth6809.asm):02532         ;    Outputs:
                      (    forth6809.asm):02533         ;        none
                      (    forth6809.asm):02534         ;    Registers: none.
                      (    forth6809.asm):02535         ; ------------------------------------------------------------
DB88 39               (    forth6809.asm):02536         DOESRT0:    RTS
                      (    forth6809.asm):02537         
                      (    forth6809.asm):02538         ; ------------------------------------------------------------
                      (    forth6809.asm):02539         ; Run-time for DOES>: patch the BEHAVIOR cell of the most recent
                      (    forth6809.asm):02540         ; definition with the code that follows the calling JSR, then return
                      (    forth6809.asm):02541         ; two levels up, skipping the rest of the defining word.
                      (    forth6809.asm):02542         ; SETDOES
                      (    forth6809.asm):02543         ;    Inputs:
                      (    forth6809.asm):02544         ;        return stack top = address after "JSR SETDOES" (the new
                      (    forth6809.asm):02545         ;        BEHAVIOR)
                      (    forth6809.asm):02546         ;        next on the return stack = the defining word's own return
                      (    forth6809.asm):02547         ;        address
                      (    forth6809.asm):02548         ;    Outputs:
                      (    forth6809.asm):02549         ;        BEHAVIOR cell of LATEST patched; control returns to the
                      (    forth6809.asm):02550         ;        defining word's caller
                      (    forth6809.asm):02551         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02552         ; ------------------------------------------------------------
DB89 3510             (    forth6809.asm):02553         SETDOES:    PULS  X                 ; X = addr right after "JSR SETDOES" - new BEHAVIOR
DB8B 1F12             (    forth6809.asm):02554                     TFR   X,Y               ; Y = new BEHAVIOR, kept across the walk
                      (    forth6809.asm):02555         
DB8D 9E04             (    forth6809.asm):02556                     LDX   LATEST
DB8F E684             (    forth6809.asm):02557                     LDB   ,X
DB91 C41F             (    forth6809.asm):02558                     ANDB  #$1F
DB93 4F               (    forth6809.asm):02559                     CLRA
DB94 308B             (    forth6809.asm):02560                     LEAX  D,X               ; header + name length
DB96 EC03             (    forth6809.asm):02561                     LDD   3,X               ; D = CFA (trampoline address), past name and LINK
DB98 C30003           (    forth6809.asm):02562                     ADDD  #3                ; +3 -> BEHAVIOR field (past JSR DODOES)
DB9B 1F01             (    forth6809.asm):02563                     TFR   D,X
                      (    forth6809.asm):02564         
DB9D 10AF84           (    forth6809.asm):02565                     STY   ,X                ; patch it
                      (    forth6809.asm):02566         
DBA0 3510             (    forth6809.asm):02567                     PULS  X                 ; X = the OUTER defining word's own return addr
DBA2 6E84             (    forth6809.asm):02568                     JMP   ,X                ; jump there directly - "double RTS"
                      (    forth6809.asm):02569         
                      (    forth6809.asm):02570         ; ------------------------------------------------------------
                      (    forth6809.asm):02571         ; BEHAVIOR of a DEFERred word: execute the xt stored in its data
                      (    forth6809.asm):02572         ; field. Tail-calls the xt, so it returns to the original caller.
                      (    forth6809.asm):02573         ; DODEFER   ( pfa -- )
                      (    forth6809.asm):02574         ;    Inputs:
                      (    forth6809.asm):02575         ;        pfa on the data stack
                      (    forth6809.asm):02576         ;    Outputs:
                      (    forth6809.asm):02577         ;        pfa removed; the stored xt is executed
                      (    forth6809.asm):02578         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02579         ; ------------------------------------------------------------
DBA4 3710             (    forth6809.asm):02580         DODEFER:    PULU  X                 ; pfa
DBA6 EC84             (    forth6809.asm):02581                     LDD   ,X
DBA8 1F01             (    forth6809.asm):02582                     TFR   D,X
DBAA 6E84             (    forth6809.asm):02583                     JMP   ,X
                      (    forth6809.asm):02584         
                      (    forth6809.asm):02585         ; ------------------------------------------------------------
                      (    forth6809.asm):02586         ; Initial xt of a DEFER: throws -21 until IS stores a real xt.
                      (    forth6809.asm):02587         ; DOABORTUNDEF
                      (    forth6809.asm):02588         ;    Inputs:
                      (    forth6809.asm):02589         ;        none
                      (    forth6809.asm):02590         ;    Outputs:
                      (    forth6809.asm):02591         ;        none (does not return)
                      (    forth6809.asm):02592         ;    Registers: RegD changed.
                      (    forth6809.asm):02593         ; ------------------------------------------------------------
DBAC                  (    forth6809.asm):02594         DOABORTUNDEF:
DBAC CCFFEB           (    forth6809.asm):02595                     LDD   #-21
DBAF 3606             (    forth6809.asm):02596                     PSHU  D                 ; throw code (-21)
DBB1 7EE403           (    forth6809.asm):02597                     JMP   THROWW
                      (    forth6809.asm):02598         
                      (    forth6809.asm):02599         ; ------------------------------------------------------------
                      (    forth6809.asm):02600         ; BEHAVIOR of a MARKER word: restore the dictionary, code and variable
                      (    forth6809.asm):02601         ; pointers and LATEST from the four cells saved when it was defined,
                      (    forth6809.asm):02602         ; then the search order state (SRCHSAVESZ bytes after them), then
                      (    forth6809.asm):02603         ; unlink every RAM header newer than DPHERE from every wordlist.
                      (    forth6809.asm):02604         ; DOMARKER   ( pfa -- )
                      (    forth6809.asm):02605         ;    Inputs:
                      (    forth6809.asm):02606         ;        pfa on the data stack (the saved cells)
                      (    forth6809.asm):02607         ;    Outputs:
                      (    forth6809.asm):02608         ;        pfa removed; DPHERE, CODEHERE, VARHERE, LATEST, WLEND, CURRENT
                      (    forth6809.asm):02609         ;        and the search order restored; wordlists pruned
                      (    forth6809.asm):02610         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02611         ; ------------------------------------------------------------
DBB4 3710             (    forth6809.asm):02612         DOMARKER:   PULU  X                 ; pfa
DBB6 EC84             (    forth6809.asm):02613                     LDD   ,X
DBB8 DD06             (    forth6809.asm):02614                     STD   DPHERE
DBBA EC02             (    forth6809.asm):02615                     LDD   2,X
DBBC DD08             (    forth6809.asm):02616                     STD   CODEHERE
DBBE EC04             (    forth6809.asm):02617                     LDD   4,X
DBC0 DD0A             (    forth6809.asm):02618                     STD   VARHERE
DBC2 EC06             (    forth6809.asm):02619                     LDD   6,X
DBC4 DD04             (    forth6809.asm):02620                     STD   LATEST
DBC6 3008             (    forth6809.asm):02621                     LEAX  8,X               ; the saved search-order state follows
DBC8 108E0045         (    forth6809.asm):02622                     LDY   #SRCHSAVE
DBCC C616             (    forth6809.asm):02623                     LDB   #SRCHSAVESZ
DBCE A680             (    forth6809.asm):02624         DMCOPY:     LDA   ,X+
DBD0 A7A0             (    forth6809.asm):02625                     STA   ,Y+
DBD2 5A               (    forth6809.asm):02626                     DECB
DBD3 26F9             (    forth6809.asm):02627                     BNE   DMCOPY
DBD5 DC06             (    forth6809.asm):02628                     LDD   DPHERE
DBD7 7EE0F8           (    forth6809.asm):02629                     JMP   PRUNE             ; unlink headers newer than DPHERE
                      (    forth6809.asm):02630         
                      (    forth6809.asm):02631         ; ------------------------------------------------------------
                      (    forth6809.asm):02632         ; EXECUTE  ( i*x xt -- j*x )
                      (    forth6809.asm):02633         ; Execute the word whose execution token is xt.
                      (    forth6809.asm):02634         ; ------------------------------------------------------------
DBDA 3710             (    forth6809.asm):02635         EXECUTEW:   PULU  X                 ; xt
DBDC AD84             (    forth6809.asm):02636                     JSR   ,X
DBDE 39               (    forth6809.asm):02637                     RTS
                      (    forth6809.asm):02638         
                      (    forth6809.asm):02639         ; ============================================================
                      (    forth6809.asm):02640         ; SECTION 6: COMMA FAMILY (factored via APPENDCELL/APPENDBYTE)
                      (    forth6809.asm):02641         ; ============================================================
                      (    forth6809.asm):02642         ; ------------------------------------------------------------
                      (    forth6809.asm):02643         ; Append a 16-bit cell to the area whose "here" pointer is at RegX
                      (    forth6809.asm):02644         ; (CODEHERE or VARHERE), and advance that pointer by 2.
                      (    forth6809.asm):02645         ; APPENDCELL   ( x -- )
                      (    forth6809.asm):02646         ;    Inputs:
                      (    forth6809.asm):02647         ;        RegX = address of the here pointer
                      (    forth6809.asm):02648         ;        x on the data stack
                      (    forth6809.asm):02649         ;    Outputs:
                      (    forth6809.asm):02650         ;        x stored at the old here value; pointer advanced by 2
                      (    forth6809.asm):02651         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02652         ; ------------------------------------------------------------
DBDF 3706             (    forth6809.asm):02653         APPENDCELL: PULU  D                 ; x
DBE1 10AE84           (    forth6809.asm):02654                     LDY   ,X
DBE4 EDA1             (    forth6809.asm):02655                     STD   ,Y++
DBE6 10AF84           (    forth6809.asm):02656                     STY   ,X
DBE9 39               (    forth6809.asm):02657                     RTS
                      (    forth6809.asm):02658         
                      (    forth6809.asm):02659         ; ------------------------------------------------------------
                      (    forth6809.asm):02660         ; Append the low byte of the top cell to the area whose "here" pointer
                      (    forth6809.asm):02661         ; is at RegX (CODEHERE or VARHERE), and advance that pointer by 1.
                      (    forth6809.asm):02662         ; APPENDBYTE   ( char -- )
                      (    forth6809.asm):02663         ;    Inputs:
                      (    forth6809.asm):02664         ;        RegX = address of the here pointer
                      (    forth6809.asm):02665         ;        char on the data stack
                      (    forth6809.asm):02666         ;    Outputs:
                      (    forth6809.asm):02667         ;        char stored at the old here value; pointer advanced by 1
                      (    forth6809.asm):02668         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02669         ; ------------------------------------------------------------
DBEA 3706             (    forth6809.asm):02670         APPENDBYTE: PULU  D                 ; char
DBEC 10AE84           (    forth6809.asm):02671                     LDY   ,X
DBEF E7A0             (    forth6809.asm):02672                     STB   ,Y+
DBF1 10AF84           (    forth6809.asm):02673                     STY   ,X
DBF4 39               (    forth6809.asm):02674                     RTS
                      (    forth6809.asm):02675         
                      (    forth6809.asm):02676         ; ------------------------------------------------------------
                      (    forth6809.asm):02677         ; ,  ( x -- )
                      (    forth6809.asm):02678         ; Append x to the code/data area (CODEHERE).
                      (    forth6809.asm):02679         ; ------------------------------------------------------------
DBF5 8E0008           (    forth6809.asm):02680         COMMAW:     LDX   #CODEHERE
DBF8 7EDBDF           (    forth6809.asm):02681                     JMP   APPENDCELL
                      (    forth6809.asm):02682         
                      (    forth6809.asm):02683         ; ------------------------------------------------------------
                      (    forth6809.asm):02684         ; CODECOMMA  ( x -- )
                      (    forth6809.asm):02685         ; Internal name for ",": append x at CODEHERE.
                      (    forth6809.asm):02686         ; ------------------------------------------------------------
DBFB 8E0008           (    forth6809.asm):02687         CODECOMMA:  LDX   #CODEHERE
DBFE 7EDBDF           (    forth6809.asm):02688                     JMP   APPENDCELL
                      (    forth6809.asm):02689         
                      (    forth6809.asm):02690         ; ------------------------------------------------------------
                      (    forth6809.asm):02691         ; C,  ( char -- )
                      (    forth6809.asm):02692         ; Append char to the code/data area (CODEHERE).
                      (    forth6809.asm):02693         ; ------------------------------------------------------------
DC01 8E0008           (    forth6809.asm):02694         CCOMMAW:    LDX   #CODEHERE
DC04 7EDBEA           (    forth6809.asm):02695                     JMP   APPENDBYTE
                      (    forth6809.asm):02696         
                      (    forth6809.asm):02697         ; ------------------------------------------------------------
                      (    forth6809.asm):02698         ; CCOMMA1  ( char -- )
                      (    forth6809.asm):02699         ; Internal name for "C,": append char at CODEHERE.
                      (    forth6809.asm):02700         ; ------------------------------------------------------------
DC07 8E0008           (    forth6809.asm):02701         CCOMMA1:    LDX   #CODEHERE
DC0A 7EDBEA           (    forth6809.asm):02702                     JMP   APPENDBYTE
                      (    forth6809.asm):02703         
                      (    forth6809.asm):02704         ; ------------------------------------------------------------
                      (    forth6809.asm):02705         ; V,  ( x -- )
                      (    forth6809.asm):02706         ; Append x to the variable area (VARHERE).
                      (    forth6809.asm):02707         ; ------------------------------------------------------------
DC0D 8E000A           (    forth6809.asm):02708         VCOMMAW:    LDX   #VARHERE
DC10 7EDBDF           (    forth6809.asm):02709                     JMP   APPENDCELL
                      (    forth6809.asm):02710         
                      (    forth6809.asm):02711         ; ------------------------------------------------------------
                      (    forth6809.asm):02712         ; VC,  ( char -- )
                      (    forth6809.asm):02713         ; Append char to the variable area (VARHERE).
                      (    forth6809.asm):02714         ; ------------------------------------------------------------
DC13 8E000A           (    forth6809.asm):02715         VCCOMMAW:   LDX   #VARHERE
DC16 7EDBEA           (    forth6809.asm):02716                     JMP   APPENDBYTE
                      (    forth6809.asm):02717         
                      (    forth6809.asm):02718         ; ------------------------------------------------------------
                      (    forth6809.asm):02719         ; ALLOT  ( n -- )
                      (    forth6809.asm):02720         ; Reserve n bytes in the code/data area by advancing CODEHERE.
                      (    forth6809.asm):02721         ; ------------------------------------------------------------
DC19 3706             (    forth6809.asm):02722         ALLOTW:     PULU  D                 ; n
DC1B 9E08             (    forth6809.asm):02723                     LDX   CODEHERE
DC1D 308B             (    forth6809.asm):02724                     LEAX  D,X
DC1F 9F08             (    forth6809.asm):02725                     STX   CODEHERE
DC21 39               (    forth6809.asm):02726                     RTS
                      (    forth6809.asm):02727         
                      (    forth6809.asm):02728         ; ------------------------------------------------------------
                      (    forth6809.asm):02729         ; VALLOT  ( n -- )
                      (    forth6809.asm):02730         ; Reserve n bytes in the variable area by advancing VARHERE.
                      (    forth6809.asm):02731         ; ------------------------------------------------------------
DC22 3706             (    forth6809.asm):02732         VALLOTW:    PULU  D                 ; n
DC24 9E0A             (    forth6809.asm):02733                     LDX   VARHERE
DC26 308B             (    forth6809.asm):02734                     LEAX  D,X
DC28 9F0A             (    forth6809.asm):02735                     STX   VARHERE
DC2A 39               (    forth6809.asm):02736                     RTS
                      (    forth6809.asm):02737         
                      (    forth6809.asm):02738         ; ------------------------------------------------------------
                      (    forth6809.asm):02739         ; HERE  ( -- addr )
                      (    forth6809.asm):02740         ; Return the next free address in the code/data area (CODEHERE).
                      (    forth6809.asm):02741         ; ------------------------------------------------------------
DC2B DC08             (    forth6809.asm):02742         HEREW:      LDD   CODEHERE
DC2D 3606             (    forth6809.asm):02743                     PSHU  D                 ; addr
DC2F 39               (    forth6809.asm):02744                     RTS
                      (    forth6809.asm):02745         
                      (    forth6809.asm):02746         ; ------------------------------------------------------------
                      (    forth6809.asm):02747         ; VHERE  ( -- addr )
                      (    forth6809.asm):02748         ; Return the next free address in the variable area (VARHERE).
                      (    forth6809.asm):02749         ; ------------------------------------------------------------
DC30 DC0A             (    forth6809.asm):02750         VHEREW:     LDD   VARHERE
DC32 3606             (    forth6809.asm):02751                     PSHU  D                 ; addr
DC34 39               (    forth6809.asm):02752                     RTS
                      (    forth6809.asm):02753         
                      (    forth6809.asm):02754         ; ------------------------------------------------------------
                      (    forth6809.asm):02755         ; PAD  ( -- c-addr )
                      (    forth6809.asm):02756         ; Return the scratch buffer address, PADOFFSET bytes above CODEHERE.
                      (    forth6809.asm):02757         ; ------------------------------------------------------------
DC35 DC08             (    forth6809.asm):02758         PADW:       LDD   CODEHERE
DC37 C30080           (    forth6809.asm):02759                     ADDD  #PADOFFSET
DC3A 3606             (    forth6809.asm):02760                     PSHU  D                 ; c-addr
DC3C 39               (    forth6809.asm):02761                     RTS
                      (    forth6809.asm):02762         
                      (    forth6809.asm):02763         ; ------------------------------------------------------------
                      (    forth6809.asm):02764         ; UNUSED  ( -- u )
                      (    forth6809.asm):02765         ; Return the number of free bytes remaining in the code/data area.
                      (    forth6809.asm):02766         ; ------------------------------------------------------------
DC3D CCB900           (    forth6809.asm):02767         UNUSEDW:    LDD   #CODETOP
DC40 9308             (    forth6809.asm):02768                     SUBD  CODEHERE
DC42 3606             (    forth6809.asm):02769                     PSHU  D                 ; u
DC44 39               (    forth6809.asm):02770                     RTS
                      (    forth6809.asm):02771         
                      (    forth6809.asm):02772         ; ------------------------------------------------------------
                      (    forth6809.asm):02773         ; VUNUSED  ( -- u )
                      (    forth6809.asm):02774         ; Return the number of free bytes remaining in the variable area.
                      (    forth6809.asm):02775         ; ------------------------------------------------------------
DC45 CC1FFF           (    forth6809.asm):02776         VUNUSEDW:   LDD   #APPVARSEND       ; See bugfix: VUNUSEDW.1
DC48 930A             (    forth6809.asm):02777                     SUBD  VARHERE
DC4A 3606             (    forth6809.asm):02778                     PSHU  D                 ; u
DC4C 39               (    forth6809.asm):02779                     RTS
                      (    forth6809.asm):02780         
                      (    forth6809.asm):02781         ; ============================================================
                      (    forth6809.asm):02782         ; SECTION 7: HEADER (factored from :/CREATE/VARIABLE)
                      (    forth6809.asm):02783         ; ============================================================
                      (    forth6809.asm):02784         ; ------------------------------------------------------------
                      (    forth6809.asm):02785         ; Build a dictionary header for the next name in the input: parse the
                      (    forth6809.asm):02786         ; name, then lay down the length byte (with the smudge bit set if
                      (    forth6809.asm):02787         ; requested), the name, the link to the previous header and the code
                      (    forth6809.asm):02788         ; field address (CODEHERE). LATEST, DPHERE and the head of the CURRENT
                      (    forth6809.asm):02789         ; wordlist are updated.
                      (    forth6809.asm):02790         ; HEADER   ( smudge-flag "name" -- )
                      (    forth6809.asm):02791         ;    Inputs:
                      (    forth6809.asm):02792         ;        smudge-flag on the data stack (non-zero hides the new word)
                      (    forth6809.asm):02793         ;        name parsed from the input stream
                      (    forth6809.asm):02794         ;    Outputs:
                      (    forth6809.asm):02795         ;        header built at DPHERE, linked into the CURRENT wordlist;
                      (    forth6809.asm):02796         ;        LATEST = address of the new header
                      (    forth6809.asm):02797         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02798         ; ------------------------------------------------------------
DC4D CC0020           (    forth6809.asm):02799         HEADER:     LDD   #32
DC50 3606             (    forth6809.asm):02800                     PSHU  D
DC52 BDDF8A           (    forth6809.asm):02801                     JSR   WORDW
DC55 3710             (    forth6809.asm):02802                     PULU  X                 ; c-addr of the name
DC57 3706             (    forth6809.asm):02803                     PULU  D                 ; smudge flag in B
DC59 A680             (    forth6809.asm):02804                     LDA   ,X+               ; name length, X = name text
DC5B 3402             (    forth6809.asm):02805                     PSHS  A                 ; 2,S = length (5k: S-frame, no scratch)
DC5D 5D               (    forth6809.asm):02806                     TSTB
DC5E 2702             (    forth6809.asm):02807                     BEQ   HDNOSM
DC60 8A40             (    forth6809.asm):02808                     ORA   #$40
DC62 109E06           (    forth6809.asm):02809         HDNOSM:     LDY   DPHERE
DC65 3420             (    forth6809.asm):02810                     PSHS  Y                 ; 0,S = address of the new header
DC67 A7A0             (    forth6809.asm):02811                     STA   ,Y+
DC69 E662             (    forth6809.asm):02812                     LDB   2,S
DC6B 2707             (    forth6809.asm):02813                     BEQ   HDNONM
DC6D A680             (    forth6809.asm):02814         HDCPY:      LDA   ,X+
DC6F A7A0             (    forth6809.asm):02815                     STA   ,Y+
DC71 5A               (    forth6809.asm):02816                     DECB
DC72 26F9             (    forth6809.asm):02817                     BNE   HDCPY
DC74 9E47             (    forth6809.asm):02818         HDNONM:     LDX   CURRENT           ; X = WID of the wordlist receiving the word
DC76 EC84             (    forth6809.asm):02819                     LDD   ,X
DC78 EDA1             (    forth6809.asm):02820                     STD   ,Y++              ; LINK = old head of that wordlist
DC7A DC08             (    forth6809.asm):02821                     LDD   CODEHERE
DC7C EDA1             (    forth6809.asm):02822                     STD   ,Y++
DC7E 109F06           (    forth6809.asm):02823                     STY   DPHERE
DC81 3506             (    forth6809.asm):02824                     PULS  D
DC83 DD04             (    forth6809.asm):02825                     STD   LATEST            ; LATEST = newest header of any wordlist
DC85 ED84             (    forth6809.asm):02826                     STD   ,X                ; and the new head of the CURRENT wordlist
DC87 3261             (    forth6809.asm):02827                     LEAS  1,S
DC89 39               (    forth6809.asm):02828                     RTS
                      (    forth6809.asm):02829         
                      (    forth6809.asm):02830         ; ============================================================
                      (    forth6809.asm):02831         ; SECTION 8: DEFINING WORDS
                      (    forth6809.asm):02832         ; ============================================================
                      (    forth6809.asm):02833         ; ------------------------------------------------------------
                      (    forth6809.asm):02834         ; :  ( "name" -- )
                      (    forth6809.asm):02835         ; Start a colon definition: parse the name, build a smudged header,
                      (    forth6809.asm):02836         ; record the new xt in CURXT, note the control-flow stack position in
                      (    forth6809.asm):02837         ; CSP and enter compile state.
                      (    forth6809.asm):02838         ; ------------------------------------------------------------
DC8A CCFFFF           (    forth6809.asm):02839         COLONW:     LDD   #TRUEV
DC8D 3606             (    forth6809.asm):02840                     PSHU  D
DC8F BDDC4D           (    forth6809.asm):02841                     JSR   HEADER
DC92 DC08             (    forth6809.asm):02842                     LDD   CODEHERE          ; Record this word's xt for RECURSE.
DC94 DD1F             (    forth6809.asm):02843                     STD   CURXT             ; See bugfix: COLONW.1
DC96 1F30             (    forth6809.asm):02844                     TFR   U,D
DC98 DD21             (    forth6809.asm):02845                     STD   CSP
DC9A CCFFFF           (    forth6809.asm):02846                     LDD   #-1
DC9D DD00             (    forth6809.asm):02847                     STD   STATE
DC9F 39               (    forth6809.asm):02848                     RTS
                      (    forth6809.asm):02849         
                      (    forth6809.asm):02850         ; ------------------------------------------------------------
                      (    forth6809.asm):02851         ; ;  ( -- )  IMMEDIATE
                      (    forth6809.asm):02852         ; End a colon definition: compile RTS, check that the control-flow
                      (    forth6809.asm):02853         ; stack is balanced (error -22 if not), clear the smudge bit of the
                      (    forth6809.asm):02854         ; new word and return to interpret state.
                      (    forth6809.asm):02855         ; ------------------------------------------------------------
DCA0 CC0039           (    forth6809.asm):02856         SEMIW:      LDD   #RTSOPC
DCA3 3606             (    forth6809.asm):02857                     PSHU  D
DCA5 BDDC07           (    forth6809.asm):02858                     JSR   CCOMMA1
DCA8 1F30             (    forth6809.asm):02859                     TFR   U,D
DCAA 109321           (    forth6809.asm):02860                     CMPD  CSP
DCAD 2703             (    forth6809.asm):02861                     BEQ   SEMIOK
DCAF BDE3CE           (    forth6809.asm):02862                     JSR   CFERR
DCB2 9E04             (    forth6809.asm):02863         SEMIOK:     LDX   LATEST
DCB4 A684             (    forth6809.asm):02864                     LDA   ,X
DCB6 84BF             (    forth6809.asm):02865                     ANDA  #$BF
DCB8 A784             (    forth6809.asm):02866                     STA   ,X
DCBA CC0000           (    forth6809.asm):02867                     LDD   #0
DCBD DD00             (    forth6809.asm):02868                     STD   STATE
DCBF 39               (    forth6809.asm):02869                     RTS
                      (    forth6809.asm):02870         
                      (    forth6809.asm):02871         ; ------------------------------------------------------------
                      (    forth6809.asm):02872         ; :NONAME  ( -- xt )
                      (    forth6809.asm):02873         ; Start an anonymous definition: no header is built and LATEST is left
                      (    forth6809.asm):02874         ; alone, so the word can never be found. Leaves the xt (the current
                      (    forth6809.asm):02875         ; CODEHERE) on the stack, records it in CURXT, notes the control-flow
                      (    forth6809.asm):02876         ; stack position in CSP and enters compile state.
                      (    forth6809.asm):02877         ; Original comment: shadow NONAMEW.0.
                      (    forth6809.asm):02878         ; ------------------------------------------------------------
DCC0 DC08             (    forth6809.asm):02879         NONAMEW:    LDD   CODEHERE
DCC2 3606             (    forth6809.asm):02880                     PSHU  D                 ; xt
DCC4 DD1F             (    forth6809.asm):02881                     STD   CURXT             ; See bugfix: NONAMEW.1
DCC6 1F30             (    forth6809.asm):02882                     TFR   U,D
DCC8 DD21             (    forth6809.asm):02883                     STD   CSP
DCCA CCFFFF           (    forth6809.asm):02884                     LDD   #-1
DCCD DD00             (    forth6809.asm):02885                     STD   STATE
DCCF 39               (    forth6809.asm):02886                     RTS
                      (    forth6809.asm):02887         
                      (    forth6809.asm):02888         ; ------------------------------------------------------------
                      (    forth6809.asm):02889         ; Common start of every DODOES-style defining word: build a header
                      (    forth6809.asm):02890         ; and compile the DODOES trampoline followed by the behaviour address.
                      (    forth6809.asm):02891         ; BLDDOES
                      (    forth6809.asm):02892         ;    Inputs:
                      (    forth6809.asm):02893         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):02894         ;    Outputs:
                      (    forth6809.asm):02895         ;        header built, trampoline and behaviour cell compiled
                      (    forth6809.asm):02896         ;    Registers: all changed.
                      (    forth6809.asm):02897         ; BLDSELF
                      (    forth6809.asm):02898         ;    Inputs:
                      (    forth6809.asm):02899         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):02900         ;    Outputs:
                      (    forth6809.asm):02901         ;        as BLDDOES, then the PFA cell compiled pointing at the
                      (    forth6809.asm):02902         ;        cell that follows it (the word's own data field)
                      (    forth6809.asm):02903         ;    Registers: all changed.
                      (    forth6809.asm):02904         ; Used by CREATE, CONSTANT, 2CONSTANT, DEFER and MARKER (BLDSELF)
                      (    forth6809.asm):02905         ; and by VALUE (BLDDOES, which supplies its own PFA).
                      (    forth6809.asm):02906         ; ------------------------------------------------------------
DCD0 3406             (    forth6809.asm):02907         BLDDOES:    PSHS  D                 ; behaviour address
DCD2 CC0000           (    forth6809.asm):02908                     LDD   #0
DCD5 3606             (    forth6809.asm):02909                     PSHU  D
DCD7 BDDC4D           (    forth6809.asm):02910                     JSR   HEADER
DCDA CCDB7D           (    forth6809.asm):02911                     LDD   #DODOES
DCDD 3606             (    forth6809.asm):02912                     PSHU  D
DCDF BDE83E           (    forth6809.asm):02913                     JSR   CCALL
DCE2 3506             (    forth6809.asm):02914                     PULS  D
DCE4 3606             (    forth6809.asm):02915                     PSHU  D                 ; behaviour address
DCE6 BDDBFB           (    forth6809.asm):02916                     JSR   CODECOMMA
DCE9 39               (    forth6809.asm):02917                     RTS
                      (    forth6809.asm):02918         

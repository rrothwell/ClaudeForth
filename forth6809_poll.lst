DED5 39               (    forth6809.asm):05655                     RTS
                      (    forth6809.asm):05656         
                      (    forth6809.asm):05657         ; ------------------------------------------------------------
                      (    forth6809.asm):05658         ; SWAP  ( x1 x2 -- x2 x1 )
                      (    forth6809.asm):05659         ; Exchange the top two cells.
                      (    forth6809.asm):05660         ; ------------------------------------------------------------

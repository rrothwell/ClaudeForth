                      (    forth6809.asm):07712         ; address and skip over it.
                      (    forth6809.asm):07713         ; DOCSTR
                      (    forth6809.asm):07714         ;    Outputs:
                      (    forth6809.asm):07715         ;        ( -- c-addr ) the count byte address; execution resumes after
                      (    forth6809.asm):07716         ;        the string

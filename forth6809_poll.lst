                      (    forth6809.asm):04667         ; Store a branch displacement: the cell at location receives target -
                      (    forth6809.asm):04668         ; location.
                      (    forth6809.asm):04669         ; PATCH   ( target location -- )
                      (    forth6809.asm):04670         ;    Inputs:
                      (    forth6809.asm):04671         ;        target and location on the data stack (location on top)
                      (    forth6809.asm):04672         ;    Outputs:
                      (    forth6809.asm):04673         ;        the cell at location holds target - location
                      (    forth6809.asm):04674         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):04675         ; ------------------------------------------------------------
DD25 3710             (    forth6809.asm):04676         PATCH:      PULU  X                 ; location
DD27 3706             (    forth6809.asm):04677                     PULU  D                 ; target
DD29 3410             (    forth6809.asm):04678                     PSHS  X
DD2B A3E1             (    forth6809.asm):04679                     SUBD  ,S++              ; target - location
DD2D ED84             (    forth6809.asm):04680                     STD   ,X
DD2F 39               (    forth6809.asm):04681                     RTS

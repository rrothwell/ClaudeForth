DE61 830002           (    forth6809.asm):04863                     SUBD  #2
DE64 DD18             (    forth6809.asm):04864                     STD   MSCR3
DE66 9E16             (    forth6809.asm):04865                     LDX   MSCR2
DE68 308B             (    forth6809.asm):04866                     LEAX  D,X               ; X = MSCR2 + this pass's offset
DE6A EC84             (    forth6809.asm):04867                     LDD   ,X
DE6C 3004             (    forth6809.asm):04868                     LEAX  4,X
DE6E ED84             (    forth6809.asm):04869                     STD   ,X                ; copy one word 4 bytes higher
DE70 DC18             (    forth6809.asm):04870                     LDD   MSCR3
DE72 26EB             (    forth6809.asm):04871                     BNE   RPSHIFT
DE74                  (    forth6809.asm):04872         RPSHIFTDONE:
DE74 9E16             (    forth6809.asm):04873                     LDX   MSCR2
DE76 3004             (    forth6809.asm):04874                     LEAX  4,X
DE78 1F13             (    forth6809.asm):04875                     TFR   X,U               ; U now excludes BEGIN frame
                      (    forth6809.asm):04876         
DE7A CCD384           (    forth6809.asm):04877                     LDD   #BRANCH

D5EE BDE12B           (    forth6809.asm):03248                     JSR   CCALL
D5F1 CCD398           (    forth6809.asm):03249                     LDD   #DOESRT0
D5F4 3606             (    forth6809.asm):03250                     PSHU  D
D5F6 BDD40B           (    forth6809.asm):03251                     JSR   CODECOMMA
D5F9 DC0A             (    forth6809.asm):03252                     LDD   VARHERE
D5FB 3606             (    forth6809.asm):03253                     PSHU  D
D5FD BDD40B           (    forth6809.asm):03254                     JSR   CODECOMMA

                      (    forth6809.asm):04963         ; ------------------------------------------------------------
                      (    forth6809.asm):04964         ; LEAVE  ( -- )
                      (    forth6809.asm):04965         ; Set the leave flag in the innermost loop frame. The loop exits at
                      (    forth6809.asm):04966         ; its next LOOP or +LOOP test.
                      (    forth6809.asm):04967         ; ------------------------------------------------------------
DEE4 CCFFFF           (    forth6809.asm):04968         LEAVEW:     LDD   #TRUEV            ; true
DEE7 ED66             (    forth6809.asm):04969                     STD   6,S               ; See bugfix: LEAVEW.1
DEE9 39               (    forth6809.asm):04970                     RTS
                      (    forth6809.asm):04971         
                      (    forth6809.asm):04972         ; ------------------------------------------------------------
                      (    forth6809.asm):04973         ; LOOP  ( C: dest -- )
                      (    forth6809.asm):04974         ; Compile a call to DOTEST followed by a displacement back to dest.
                      (    forth6809.asm):04975         ; For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):04976         ; ------------------------------------------------------------
DEEA 3706             (    forth6809.asm):04977         LOOPW:      PULU  D
DEEC 10830003         (    forth6809.asm):04978                     CMPD  #TAGDO
DEF0 2703             (    forth6809.asm):04979                     BEQ   LOOPOK
DEF2 BDDCBB           (    forth6809.asm):04980                     JSR   CFERR
DEF5 3706             (    forth6809.asm):04981         LOOPOK:     PULU  D                 ; dest
DEF7 3606             (    forth6809.asm):04982                     PSHU  D                 ; park dest. See bugfix: LOOPW.1
DEF9 CCDF29           (    forth6809.asm):04983                     LDD   #DOTEST
DEFC 3606             (    forth6809.asm):04984                     PSHU  D
DEFE BDE12B           (    forth6809.asm):04985                     JSR   CCALL
DF01 CC0000           (    forth6809.asm):04986                     LDD   #0
DF04 3606             (    forth6809.asm):04987                     PSHU  D
DF06 BDD40B           (    forth6809.asm):04988                     JSR   CODECOMMA
DF09 DC08             (    forth6809.asm):04989                     LDD   CODEHERE
DF0B 830002           (    forth6809.asm):04990                     SUBD  #2
DF0E 3606             (    forth6809.asm):04991                     PSHU  D                 ; location; the parked dest is beneath
DF10 BDDD25           (    forth6809.asm):04992                     JSR   PATCH
                      (    forth6809.asm):04993         
DF13 ECC4             (    forth6809.asm):04994                     LDD   ,U
DF15 10830007         (    forth6809.asm):04995                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: LOOPW.2
DF19 260D             (    forth6809.asm):04996                     BNE   LOOPDONE
DF1B 3706             (    forth6809.asm):04997                     PULU  D
DF1D 3710             (    forth6809.asm):04998                     PULU  X                 ; ?DO skip operand
DF1F DC08             (    forth6809.asm):04999                     LDD   CODEHERE
DF21 3606             (    forth6809.asm):05000                     PSHU  D
DF23 3610             (    forth6809.asm):05001                     PSHU  X
DF25 BDDD25           (    forth6809.asm):05002                     JSR   PATCH
DF28 39               (    forth6809.asm):05003         LOOPDONE:   RTS
                      (    forth6809.asm):05004         
                      (    forth6809.asm):05005         ; ------------------------------------------------------------
                      (    forth6809.asm):05006         ; Run-time end of LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):05007         ; the back-branch operand. Add 1 to the index. If the leave flag is
                      (    forth6809.asm):05008         ; set or the index has reached the limit, discard the loop frame and
                      (    forth6809.asm):05009         ; skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):05010         ; DOTEST
                      (    forth6809.asm):05011         ;    Inputs:
                      (    forth6809.asm):05012         ;        S holds return address, index, limit and leave flag (top
                      (    forth6809.asm):05013         ;        first)
                      (    forth6809.asm):05014         ;    Outputs:
                      (    forth6809.asm):05015         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):05016         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):05017         ; ------------------------------------------------------------
DF29 EC66             (    forth6809.asm):05018         DOTEST:     LDD   6,S               ; leave flag. See bugfix: DOTEST.1
DF2B 2615             (    forth6809.asm):05019                     BNE   DTEXIT            ; set: exit
DF2D EC62             (    forth6809.asm):05020                     LDD   2,S               ; index
DF2F C30001           (    forth6809.asm):05021                     ADDD  #1
DF32 ED62             (    forth6809.asm):05022                     STD   2,S
DF34 10A364           (    forth6809.asm):05023                     CMPD  4,S               ; limit
DF37 2709             (    forth6809.asm):05024                     BEQ   DTEXIT
DF39 3510             (    forth6809.asm):05025                     PULS  X                 ; X = branch operand address
DF3B EC84             (    forth6809.asm):05026                     LDD   ,X
DF3D 308B             (    forth6809.asm):05027                     LEAX  D,X
DF3F 3410             (    forth6809.asm):05028                     PSHS  X                 ; return to loop start
DF41 39               (    forth6809.asm):05029                     RTS
DF42 3510             (    forth6809.asm):05030         DTEXIT:     PULS  X
DF44 3002             (    forth6809.asm):05031                     LEAX  2,X               ; skip the branch operand
DF46 3266             (    forth6809.asm):05032                     LEAS  6,S               ; discard the loop frame
DF48 3410             (    forth6809.asm):05033                     PSHS  X
DF4A 39               (    forth6809.asm):05034                     RTS
                      (    forth6809.asm):05035         
                      (    forth6809.asm):05036         ; ------------------------------------------------------------
                      (    forth6809.asm):05037         ; +LOOP  ( C: dest -- )
                      (    forth6809.asm):05038         ; Compile a call to DOPLUSTEST followed by a displacement back to
                      (    forth6809.asm):05039         ; dest. For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):05040         ; ------------------------------------------------------------
DF4B 3706             (    forth6809.asm):05041         PLUSLOOPW:  PULU  D
DF4D 10830003         (    forth6809.asm):05042                     CMPD  #TAGDO
DF51 2703             (    forth6809.asm):05043                     BEQ   PLOOPOK
DF53 BDDCBB           (    forth6809.asm):05044                     JSR   CFERR
DF56 3706             (    forth6809.asm):05045         PLOOPOK:    PULU  D                 ; dest
DF58 3606             (    forth6809.asm):05046                     PSHU  D                 ; park dest. See bugfix: PLUSLOOPW.1
DF5A CCDF8A           (    forth6809.asm):05047                     LDD   #DOPLUSTEST
DF5D 3606             (    forth6809.asm):05048                     PSHU  D
DF5F BDE12B           (    forth6809.asm):05049                     JSR   CCALL
DF62 CC0000           (    forth6809.asm):05050                     LDD   #0
DF65 3606             (    forth6809.asm):05051                     PSHU  D
DF67 BDD40B           (    forth6809.asm):05052                     JSR   CODECOMMA
DF6A DC08             (    forth6809.asm):05053                     LDD   CODEHERE
DF6C 830002           (    forth6809.asm):05054                     SUBD  #2
DF6F 3606             (    forth6809.asm):05055                     PSHU  D                 ; location; the parked dest is beneath
DF71 BDDD25           (    forth6809.asm):05056                     JSR   PATCH
                      (    forth6809.asm):05057         
DF74 ECC4             (    forth6809.asm):05058                     LDD   ,U
DF76 10830007         (    forth6809.asm):05059                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: PLUSLOOPW.2
DF7A 260D             (    forth6809.asm):05060                     BNE   PLOOPDONE
DF7C 3706             (    forth6809.asm):05061                     PULU  D
DF7E 3710             (    forth6809.asm):05062                     PULU  X                 ; ?DO skip operand
DF80 DC08             (    forth6809.asm):05063                     LDD   CODEHERE
DF82 3606             (    forth6809.asm):05064                     PSHU  D
DF84 3610             (    forth6809.asm):05065                     PSHU  X
DF86 BDDD25           (    forth6809.asm):05066                     JSR   PATCH
DF89 39               (    forth6809.asm):05067         PLOOPDONE:  RTS
                      (    forth6809.asm):05068         
                      (    forth6809.asm):05069         ; ------------------------------------------------------------
                      (    forth6809.asm):05070         ; Run-time end of +LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):05071         ; the back-branch operand. Add the step to the index. If the leave
                      (    forth6809.asm):05072         ; flag is set or the index crossed the limit, discard the loop frame
                      (    forth6809.asm):05073         ; and skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):05074         ; DOPLUSTEST   ( n -- )
                      (    forth6809.asm):05075         ;    Inputs:
                      (    forth6809.asm):05076         ;        step n on the data stack; S as for DOTEST
                      (    forth6809.asm):05077         ;    Outputs:
                      (    forth6809.asm):05078         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):05079         ;    Registers: RegD and RegX changed; MSCR, MSCR2 and MSCR3 used as
                      (    forth6809.asm):05080         ;        scratch.
                      (    forth6809.asm):05081         ; ------------------------------------------------------------
DF8A 3706             (    forth6809.asm):05082         DOPLUSTEST: PULU  D                 ; n = step. See bugfix: DOPLUSTEST.1
DF8C DD14             (    forth6809.asm):05083                     STD   MSCR              ; MSCR = step
DF8E EC66             (    forth6809.asm):05084                     LDD   6,S               ; leave flag. See bugfix: DOPLUSTEST.2
DF90 262D             (    forth6809.asm):05085                     BNE   DPTEXIT           ; set: exit
DF92 EC62             (    forth6809.asm):05086                     LDD   2,S               ; old index
DF94 A364             (    forth6809.asm):05087                     SUBD  4,S               ; old_u = old_index - limit, mod 65536
DF96 DD16             (    forth6809.asm):05088                     STD   MSCR2
DF98 EC62             (    forth6809.asm):05089                     LDD   2,S
DF9A D314             (    forth6809.asm):05090                     ADDD  MSCR              ; new_index = old_index + step
DF9C ED62             (    forth6809.asm):05091                     STD   2,S
DF9E A364             (    forth6809.asm):05092                     SUBD  4,S               ; new_u = new_index - limit, mod 65536
DFA0 DD18             (    forth6809.asm):05093                     STD   MSCR3
                      (    forth6809.asm):05094                     ; Crossing test on the unsigned distances old_u and new_u: with a
                      (    forth6809.asm):05095                     ; positive step the limit was crossed if new_u < old_u, with a
                      (    forth6809.asm):05096                     ; negative step if new_u > old_u. See bugfix: DOPLUSTEST.3
DFA2 DC14             (    forth6809.asm):05097                     LDD   MSCR              ; reload the step to test its sign
DFA4 2B09             (    forth6809.asm):05098                     BMI   DPNEG
DFA6 DC18             (    forth6809.asm):05099         DPPOS:      LDD   MSCR3             ; step > 0: crossed if new_u < old_u
DFA8 109316           (    forth6809.asm):05100                     CMPD  MSCR2
DFAB 2512             (    forth6809.asm):05101                     BLO   DPTEXIT
DFAD 2007             (    forth6809.asm):05102                     BRA   DPCONT
DFAF DC18             (    forth6809.asm):05103         DPNEG:      LDD   MSCR3             ; step < 0: crossed if new_u > old_u
DFB1 109316           (    forth6809.asm):05104                     CMPD  MSCR2
DFB4 2209             (    forth6809.asm):05105                     BHI   DPTEXIT
DFB6 3510             (    forth6809.asm):05106         DPCONT:     PULS  X                 ; X = branch operand address
DFB8 EC84             (    forth6809.asm):05107                     LDD   ,X
DFBA 308B             (    forth6809.asm):05108                     LEAX  D,X
DFBC 3410             (    forth6809.asm):05109                     PSHS  X
DFBE 39               (    forth6809.asm):05110                     RTS
DFBF 3510             (    forth6809.asm):05111         DPTEXIT:    PULS  X
DFC1 3002             (    forth6809.asm):05112                     LEAX  2,X               ; skip the branch operand
DFC3 3266             (    forth6809.asm):05113                     LEAS  6,S               ; discard the loop frame
DFC5 3410             (    forth6809.asm):05114                     PSHS  X
DFC7 39               (    forth6809.asm):05115                     RTS
                      (    forth6809.asm):05116         
                      (    forth6809.asm):05117         ; ------------------------------------------------------------
                      (    forth6809.asm):05118         ; ?DO  ( C: -- orig dest )
                      (    forth6809.asm):05119         ; Compile a call to QDOSETUP with a placeholder skip operand. Leave
                      (    forth6809.asm):05120         ; orig (the skip operand address) and TAGQDO, then dest and TAGDO.
                      (    forth6809.asm):05121         ; ------------------------------------------------------------
DFC8 CCDFEE           (    forth6809.asm):05122         QDOW:       LDD   #QDOSETUP
DFCB 3606             (    forth6809.asm):05123                     PSHU  D
DFCD BDE12B           (    forth6809.asm):05124                     JSR   CCALL
DFD0 CC0000           (    forth6809.asm):05125                     LDD   #0
DFD3 3606             (    forth6809.asm):05126                     PSHU  D
DFD5 BDD40B           (    forth6809.asm):05127                     JSR   CODECOMMA
DFD8 DC08             (    forth6809.asm):05128                     LDD   CODEHERE
DFDA 830002           (    forth6809.asm):05129                     SUBD  #2
DFDD 3606             (    forth6809.asm):05130                     PSHU  D                 ; orig
DFDF CC0007           (    forth6809.asm):05131                     LDD   #TAGQDO           ; See bugfix: QDOW.1
DFE2 3606             (    forth6809.asm):05132                     PSHU  D
DFE4 DC08             (    forth6809.asm):05133                     LDD   CODEHERE
DFE6 3606             (    forth6809.asm):05134                     PSHU  D                 ; dest
DFE8 CC0003           (    forth6809.asm):05135                     LDD   #TAGDO
DFEB 3606             (    forth6809.asm):05136                     PSHU  D
DFED 39               (    forth6809.asm):05137                     RTS
                      (    forth6809.asm):05138         
                      (    forth6809.asm):05139         ; ------------------------------------------------------------
                      (    forth6809.asm):05140         ; Run-time start of ?DO. If index equals limit, branch over the whole
                      (    forth6809.asm):05141         ; loop; otherwise build the loop frame as DOSETUP does and skip the
                      (    forth6809.asm):05142         ; branch operand.
                      (    forth6809.asm):05143         ; QDOSETUP   ( limit index -- )
                      (    forth6809.asm):05144         ;    Inputs:
                      (    forth6809.asm):05145         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):05146         ;    Outputs:
                      (    forth6809.asm):05147         ;        loop skipped, or loop frame on S and operand skipped
                      (    forth6809.asm):05148         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):05149         ; ------------------------------------------------------------
DFEE 3706             (    forth6809.asm):05150         QDOSETUP:   PULU  D                 ; index
DFF0 DD14             (    forth6809.asm):05151                     STD   MSCR
DFF2 3706             (    forth6809.asm):05152                     PULU  D                 ; limit
DFF4 DD16             (    forth6809.asm):05153                     STD   MSCR2
DFF6 3510             (    forth6809.asm):05154                     PULS  X
DFF8 DC16             (    forth6809.asm):05155                     LDD   MSCR2
DFFA 109314           (    forth6809.asm):05156                     CMPD  MSCR
DFFD 2607             (    forth6809.asm):05157                     BNE   QDBUILD
DFFF EC84             (    forth6809.asm):05158                     LDD   ,X
E001 308B             (    forth6809.asm):05159                     LEAX  D,X
E003 3410             (    forth6809.asm):05160                     PSHS  X
E005 39               (    forth6809.asm):05161                     RTS
E006 3002             (    forth6809.asm):05162         QDBUILD:    LEAX  2,X
E008 CC0000           (    forth6809.asm):05163                     LDD   #0
E00B 3406             (    forth6809.asm):05164                     PSHS  D
E00D DC16             (    forth6809.asm):05165                     LDD   MSCR2
E00F 3406             (    forth6809.asm):05166                     PSHS  D
E011 DC14             (    forth6809.asm):05167                     LDD   MSCR
E013 3406             (    forth6809.asm):05168                     PSHS  D
E015 3410             (    forth6809.asm):05169                     PSHS  X
E017 39               (    forth6809.asm):05170                     RTS
                      (    forth6809.asm):05171         
                      (    forth6809.asm):05172         ; ------------------------------------------------------------
                      (    forth6809.asm):05173         ; UNLOOP  ( -- )
                      (    forth6809.asm):05174         ; Discard the loop frame (index, limit, leave flag) beneath UNLOOP's
                      (    forth6809.asm):05175         ; return address, so that a following I or J sees the enclosing loop.
                      (    forth6809.asm):05176         ; ------------------------------------------------------------
E018 3510             (    forth6809.asm):05177         UNLOOPW:    PULS  X
E01A 3266             (    forth6809.asm):05178                     LEAS  6,S
E01C 3410             (    forth6809.asm):05179                     PSHS  X
E01E 39               (    forth6809.asm):05180                     RTS
                      (    forth6809.asm):05181         
                      (    forth6809.asm):05182         ; ------------------------------------------------------------
                      (    forth6809.asm):05183         ; EXIT  ( -- )
                      (    forth6809.asm):05184         ; Compile a call to EXITUNLOOP followed by a count of the DO frames
                      (    forth6809.asm):05185         ; found on the control-flow stack. The count is not used at run time.
                      (    forth6809.asm):05186         ; A loop must be left with UNLOOP before EXIT.
                      (    forth6809.asm):05187         ; ------------------------------------------------------------
E01F 108E0000         (    forth6809.asm):05188         EXITW:      LDY   #0                ; Y = count of DO frames (5k: no scratch)
E023 1F31             (    forth6809.asm):05189                     TFR   U,X               ; X = scan pointer
E025 9C21             (    forth6809.asm):05190         EXSCAN:     CMPX  CSP
E027 270E             (    forth6809.asm):05191                     BEQ   EXSCANDONE
E029 EC84             (    forth6809.asm):05192                     LDD   ,X
E02B 10830003         (    forth6809.asm):05193                     CMPD  #TAGDO
E02F 2602             (    forth6809.asm):05194                     BNE   EXNOTDO
E031 3121             (    forth6809.asm):05195                     LEAY  1,Y
E033 3004             (    forth6809.asm):05196         EXNOTDO:    LEAX  4,X
E035 20EE             (    forth6809.asm):05197                     BRA   EXSCAN
E037                  (    forth6809.asm):05198         EXSCANDONE:
E037 3420             (    forth6809.asm):05199                     PSHS  Y                 ; the count survives CCALL on S
E039 CCE049           (    forth6809.asm):05200                     LDD   #EXITUNLOOP
E03C 3606             (    forth6809.asm):05201                     PSHU  D
E03E BDE12B           (    forth6809.asm):05202                     JSR   CCALL
E041 3506             (    forth6809.asm):05203                     PULS  D
E043 3606             (    forth6809.asm):05204                     PSHU  D
E045 BDD40B           (    forth6809.asm):05205                     JSR   CODECOMMA
E048 39               (    forth6809.asm):05206                     RTS
                      (    forth6809.asm):05207         
                      (    forth6809.asm):05208         ; ------------------------------------------------------------
                      (    forth6809.asm):05209         ; Run-time part of EXIT: drop the address of the inline count, then
                      (    forth6809.asm):05210         ; return from the definition. Loop frames are not discarded.
                      (    forth6809.asm):05211         ; EXITUNLOOP
                      (    forth6809.asm):05212         ;    Inputs:
                      (    forth6809.asm):05213         ;        S holds the address of the inline count, then the return
                      (    forth6809.asm):05214         ;        address
                      (    forth6809.asm):05215         ;    Outputs:
                      (    forth6809.asm):05216         ;        returns to the caller of the definition
                      (    forth6809.asm):05217         ;    Registers: RegX and RegY changed.
                      (    forth6809.asm):05218         ; ------------------------------------------------------------
E049 3510             (    forth6809.asm):05219         EXITUNLOOP: PULS  X                 ; See bugfix: EXITUNLOOP.1
E04B 3520             (    forth6809.asm):05220                     PULS  Y                 ; Y = return address
E04D 6EA4             (    forth6809.asm):05221                     JMP   ,Y
                      (    forth6809.asm):05222         
                      (    forth6809.asm):05223         ; ------------------------------------------------------------
                      (    forth6809.asm):05224         ; CASE  ( C: -- case-sys )
                      (    forth6809.asm):05225         ; Start a CASE structure. Leave a filler cell and TAGCASE, a 4-byte
                      (    forth6809.asm):05226         ; frame like those of DO and OF, which the EXIT scan relies on.
                      (    forth6809.asm):05227         ; ------------------------------------------------------------
E04F CC0000           (    forth6809.asm):05228         CASEW:      LDD   #0                ; filler. See bugfix: CASEW.1
E052 3606             (    forth6809.asm):05229                     PSHU  D
E054 CC0004           (    forth6809.asm):05230                     LDD   #TAGCASE
E057 3606             (    forth6809.asm):05231                     PSHU  D
E059 39               (    forth6809.asm):05232                     RTS
                      (    forth6809.asm):05233         
                      (    forth6809.asm):05234         ; ------------------------------------------------------------
                      (    forth6809.asm):05235         ; OF  ( C: -- orig )
                      (    forth6809.asm):05236         ; Compile OVER = ZBRANCH <operand> DROP. Leave orig (the operand
                      (    forth6809.asm):05237         ; address) and TAGOF.
                      (    forth6809.asm):05238         ; ------------------------------------------------------------
E05A CCE25F           (    forth6809.asm):05239         OFW:        LDD   #OVERW
E05D 3606             (    forth6809.asm):05240                     PSHU  D

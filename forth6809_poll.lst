F282 EC42             (    forth6809.asm):06687         FILLW:      LDD   2,U               ; u. char is at 0, c-addr at 4
F284 270F             (    forth6809.asm):06688                     BEQ   FDONE
F286 AE44             (    forth6809.asm):06689                     LDX   4,U
F288 318B             (    forth6809.asm):06690                     LEAY  D,X               ; end address
F28A 10AF42           (    forth6809.asm):06691                     STY   2,U               ; keep it in u's slot as the loop limit
F28D A641             (    forth6809.asm):06692                     LDA   1,U               ; fill byte. See bugfix: FILLW.1
F28F A780             (    forth6809.asm):06693         FILLOOP:    STA   ,X+

                      (    forth6809.asm):10344         ; DECOMP: SEE ( "name" -- )  Show a definition as Forth source.
                      (    forth6809.asm):10345         ;
                      (    forth6809.asm):10346         ; Every word in a colon definition is compiled as JSR xt. A few
                      (    forth6809.asm):10347         ; run-time words are followed by an inline cell (LIT, BRANCH, ZBRANCH,
                      (    forth6809.asm):10348         ; DOTEST, DOPLUSTEST, QDOSETUP, EXITUNLOOP) or counted string (DOSTR,
                      (    forth6809.asm):10349         ; DOTSTR, DOCSTR, DOABORTQUOTE); DKT lists them. IF ELSE THEN BEGIN
                      (    forth6809.asm):10350         ; UNTIL AGAIN WHILE REPEAT are rebuilt from branch targets by scanning
                      (    forth6809.asm):10351         ; the definition (DQ), so the shape is right but ENDOF and ENDCASE
                      (    forth6809.asm):10352         ; show as ELSE and THEN. A word whose first byte is neither JSR nor RTS
                      (    forth6809.asm):10353         ; is machine code: SEE lists it with DASM, up to its first RTS.
                      (    forth6809.asm):10354         ; ------------------------------------------------------------

                      (    forth6809.asm):03489         ; INTERPRET  ( -- )
                      (    forth6809.asm):03490         ; Interpret the rest of the input source: parse each word and look it
                      (    forth6809.asm):03491         ; up. A found word is executed, or compiled when STATE is compile and
                      (    forth6809.asm):03492         ; it is not immediate. Anything else is converted as a single or
                      (    forth6809.asm):03493         ; double number (compiled as literals when compiling). An unknown word
                      (    forth6809.asm):03494         ; is typed and THROW -13 is raised.
                      (    forth6809.asm):03495         ; ------------------------------------------------------------

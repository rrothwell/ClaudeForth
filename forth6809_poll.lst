F329 26F8             (    forth6809.asm):07242                     BNE   SQEFND
F32B A61F             (    forth6809.asm):07243                     LDA   -1,X
F32D AE64             (    forth6809.asm):07244         SQEPUT:     LDX   4,S
F32F A780             (    forth6809.asm):07245                     STA   ,X+
F331 AF64             (    forth6809.asm):07246                     STX   4,S
F333 20CD             (    forth6809.asm):07247                     BRA   SQEL
F335 AE64             (    forth6809.asm):07248         SQEM:       LDX   4,S

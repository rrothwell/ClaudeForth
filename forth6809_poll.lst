                      (    forth6809.asm):04379         ; ============================================================
                      (    forth6809.asm):04380         ; SECTION 10: QUERY / ACCEPT / EXPECT / KEY / KEY? / EMIT
                      (    forth6809.asm):04381         ; ============================================================
                      (    forth6809.asm):04382                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):04383         ; Unused alternative to KEY removed; see shadow X_KEY.1.
                      (    forth6809.asm):04384         
                      (    forth6809.asm):04385         ; ------------------------------------------------------------
                      (    forth6809.asm):04386         ; KEY  ( -- char )
                      (    forth6809.asm):04387         ; Wait for the next received character and return it. While waiting,
                      (    forth6809.asm):04388         ; drain the output ring by polling if RTS is high.
                      (    forth6809.asm):04389         ; ------------------------------------------------------------
D793                  (    forth6809.asm):04390         KEYACIA:
                      (    forth6809.asm):04391         
                      (    forth6809.asm):04392                     TST   RTSSTATE          ; Is throttling?
                      (    forth6809.asm):04393                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):04394         
                      (    forth6809.asm):04395                     ; IRQ stays unmasked during the flush. See bugfix: KEYW.1
                      (    forth6809.asm):04396                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):04397                                             ; by transmitting all chars.
                      (    forth6809.asm):04398         
D793                  (    forth6809.asm):04399         TRY_READ:
                      (    forth6809.asm):04400                     JSR   GETCHAR           ; Is char available in input buffer.
                      (    forth6809.asm):04401                     BCS   KEYACIA           ; No? Try again to receive a char,
                      (    forth6809.asm):04402                                             ; while still transmitting!
                      (    forth6809.asm):04403         
                      (    forth6809.asm):04404                     TFR   A,B               ; Move char result to Reg B (LSB of D)
                      (    forth6809.asm):04405                     CLRA                    ; Clear MSB.
                      (    forth6809.asm):04406                     PSHU  D                 ; char
                      (    forth6809.asm):04407         
                      (    forth6809.asm):04408                     RTS
                      (    forth6809.asm):04409         
                      (    forth6809.asm):04410         ; ------------------------------------------------------------
                      (    forth6809.asm):04411         ; KEY?  ( -- flag )
                      (    forth6809.asm):04412         ; Return true if a received character is waiting in the input ring.
                      (    forth6809.asm):04413         ; ------------------------------------------------------------
D793                  (    forth6809.asm):04414         KEYQACIA:
                      (    forth6809.asm):04415                     ; Commented-out code moved to shadow: KEYQW.1
                      (    forth6809.asm):04416         
                      (    forth6809.asm):04417                     LDA   INHEAD            ; Characters received?
                      (    forth6809.asm):04418                     CMPA  INTAIL
                      (    forth6809.asm):04419         
                      (    forth6809.asm):04420                     ; Commented-out code moved to shadow: KEYQW.2
                      (    forth6809.asm):04421         
                      (    forth6809.asm):04422                     BNE   KQTRUE            ; Yes!
                      (    forth6809.asm):04423         
                      (    forth6809.asm):04424                     LDD   #FALSEV           ; No! Return false result.
                      (    forth6809.asm):04425                     PSHU  D                 ; flag = false
                      (    forth6809.asm):04426         
                      (    forth6809.asm):04427                     RTS
                      (    forth6809.asm):04428         
D793                  (    forth6809.asm):04429         KQTRUE:
                      (    forth6809.asm):04430                     LDD   #TRUEV            ; Yes! Return true result.
                      (    forth6809.asm):04431                     PSHU  D                 ; flag = true
                      (    forth6809.asm):04432                     RTS
                      (    forth6809.asm):04433         
                      (    forth6809.asm):04434         ; Unused alternative to EMIT removed; see shadow X_EMIT.1.
                      (    forth6809.asm):04435         
                      (    forth6809.asm):04436         ; ------------------------------------------------------------
                      (    forth6809.asm):04437         ; EMIT  ( char -- )
                      (    forth6809.asm):04438         ; Transmit char through PUTCHAR (the output ring). When the ring is
                      (    forth6809.asm):04439         ; full EMIT waits for room, so no character is lost however fast the
                      (    forth6809.asm):04440         ; caller produces output. The wait needs the transmit interrupt to be
                      (    forth6809.asm):04441         ; able to run, so EMIT must not be called with interrupts masked, nor
                      (    forth6809.asm):04442         ; from an interrupt handler. See shadow EMITACIA.1.
                      (    forth6809.asm):04443         ; ------------------------------------------------------------
D793                  (    forth6809.asm):04444         EMITACIA:
                      (    forth6809.asm):04445                     PULU  D                 ; char
                      (    forth6809.asm):04446                     PSHS  B                 ; keep it while waiting
D793                  (    forth6809.asm):04447         EMWAIT:     LDB   OUTHEAD           ; Is there room for one more?
                      (    forth6809.asm):04448                     INCB
                      (    forth6809.asm):04449                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):04450                     CMPB  OUTTAIL
                      (    forth6809.asm):04451                     BNE   EMROOM            ; Yes!
                      (    forth6809.asm):04452                     TST   RTSSTATE          ; No! Is the transmit interrupt running?
                      (    forth6809.asm):04453                     BEQ   EMWAIT            ; Yes! It will make room.
                      (    forth6809.asm):04454                     PSHS  CC                ; RTS is high so the transmit interrupt
                      (    forth6809.asm):04455                     ORCC  #$50              ; is off: send one character by polling,
                      (    forth6809.asm):04456                     JSR   FLUSHOUTBUFFER    ; as PUTCHAR does.
                      (    forth6809.asm):04457                     PULS  CC
                      (    forth6809.asm):04458                     BRA   EMWAIT
D793                  (    forth6809.asm):04459         EMROOM:     PULS  A                 ; char
                      (    forth6809.asm):04460                     JSR   PUTCHAR           ; Transmit char.
                      (    forth6809.asm):04461                     RTS
                      (    forth6809.asm):04462         
                      (    forth6809.asm):04463                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):04464         ; ------------------------------------------------------------
                      (    forth6809.asm):04465         ; KEY  ( -- char )  [polling build, SERIALPOLL=1]
                      (    forth6809.asm):04466         ; Wait for RDRF and return the received character. There are no ring
                      (    forth6809.asm):04467         ; buffers, interrupts or hardware handshaking in this build; ACCEPT
                      (    forth6809.asm):04468         ; uses software XON/XOFF instead. Framing, overrun and parity errors
                      (    forth6809.asm):04469         ; are counted in FECOUNT, OVRNCOUNT and PECOUNT, and POLLREADYCNT
                      (    forth6809.asm):04470         ; counts characters already waiting when KEY was called.
                      (    forth6809.asm):04471         ; Original comment: shadow KEYW.2. KEY?, EMIT, PUTXON and PUTXOFF
                      (    forth6809.asm):04472         ; follow.
                      (    forth6809.asm):04473         ; ------------------------------------------------------------
D793                  (    forth6809.asm):04474         KEYACIA:
D793 B6C008           (    forth6809.asm):04475                     LDA   ACIASR
D796 8501             (    forth6809.asm):04476                     BITA  #SR_RDRF
D798 2705             (    forth6809.asm):04477                     BEQ   KWAIT
D79A 7C017F           (    forth6809.asm):04478                     INC   POLLREADYCNT      ; character was already queued when we
D79D 2007             (    forth6809.asm):04479                     BRA   KGOTSTAT          ; came back to poll - didn't need to wait
D79F                  (    forth6809.asm):04480         KWAIT:
D79F B6C008           (    forth6809.asm):04481         KSPIN:      LDA   ACIASR
D7A2 8501             (    forth6809.asm):04482                     BITA  #SR_RDRF
D7A4 27F9             (    forth6809.asm):04483                     BEQ   KSPIN
D7A6                  (    forth6809.asm):04484         KGOTSTAT:                           ; A holds the status byte exactly as it was
                      (    forth6809.asm):04485                                             ; when RDRF first went true - check the
                      (    forth6809.asm):04486                                             ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):04487                                             ; read, since reading ACIADR below clears
                      (    forth6809.asm):04488                                             ; RDRF and the latched error bits together
D7A6 8570             (    forth6809.asm):04489                     BITA  #SR_FE+SR_OVRN+SR_PE
D7A8 2715             (    forth6809.asm):04490                     BEQ   KGETCH
D7AA 8510             (    forth6809.asm):04491                     BITA  #SR_FE
D7AC 2703             (    forth6809.asm):04492                     BEQ   KXFE
D7AE 7C017C           (    forth6809.asm):04493                     INC   FECOUNT
D7B1 8520             (    forth6809.asm):04494         KXFE:       BITA  #SR_OVRN
D7B3 2703             (    forth6809.asm):04495                     BEQ   KXOVRN
D7B5 7C017D           (    forth6809.asm):04496                     INC   OVRNCOUNT
D7B8 8540             (    forth6809.asm):04497         KXOVRN:     BITA  #SR_PE
D7BA 2703             (    forth6809.asm):04498                     BEQ   KGETCH
D7BC 7C017E           (    forth6809.asm):04499                     INC   PECOUNT
D7BF B6C009           (    forth6809.asm):04500         KGETCH:     LDA   ACIADR
D7C2 1F89             (    forth6809.asm):04501                     TFR   A,B
D7C4 4F               (    forth6809.asm):04502                     CLRA
D7C5 3606             (    forth6809.asm):04503                     PSHU  D                 ; char
D7C7 39               (    forth6809.asm):04504                     RTS
                      (    forth6809.asm):04505         
                      (    forth6809.asm):04506         ; ------------------------------------------------------------
                      (    forth6809.asm):04507         ; Send the software flow-control character XOFF (PUTXOFF) or XON
                      (    forth6809.asm):04508         ; (PUTXON) straight to the ACIA, waiting for TDRE. The data stack is
                      (    forth6809.asm):04509         ; not touched, so ACCEPT can call these at any point.
                      (    forth6809.asm):04510         ; PUTXON / PUTXOFF
                      (    forth6809.asm):04511         ;    Inputs:
                      (    forth6809.asm):04512         ;        none
                      (    forth6809.asm):04513         ;    Outputs:
                      (    forth6809.asm):04514         ;        XON or XOFF transmitted
                      (    forth6809.asm):04515         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):04516         ; Original comment: shadow PUTXON.0.
                      (    forth6809.asm):04517         ; ------------------------------------------------------------
D7C8 8613             (    forth6809.asm):04518         PUTXOFF:    LDA   #XOFFCH
D7CA 2002             (    forth6809.asm):04519                     BRA   PUTXCH
D7CC 8611             (    forth6809.asm):04520         PUTXON:     LDA   #XONCH
D7CE 3402             (    forth6809.asm):04521         PUTXCH:     PSHS  A
D7D0 F6C008           (    forth6809.asm):04522         PXWT:       LDB   ACIASR
D7D3 C502             (    forth6809.asm):04523                     BITB  #SR_TDRE
D7D5 27F9             (    forth6809.asm):04524                     BEQ   PXWT
D7D7 3502             (    forth6809.asm):04525                     PULS  A
D7D9 B7C009           (    forth6809.asm):04526                     STA   ACIADR
D7DC 39               (    forth6809.asm):04527                     RTS
                      (    forth6809.asm):04528         
                      (    forth6809.asm):04529         ; ------------------------------------------------------------
                      (    forth6809.asm):04530         ; KEY?  ( -- flag )  [polling build]
                      (    forth6809.asm):04531         ; Return true if the ACIA has a received character (RDRF set).
                      (    forth6809.asm):04532         ; ------------------------------------------------------------

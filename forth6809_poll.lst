E26C E684             (    forth6809.asm):03512                     LDB   ,X
E26E 276D             (    forth6809.asm):03513                     BEQ   NQBAD
E270 3001             (    forth6809.asm):03514                     LEAX  1,X
                      (    forth6809.asm):03515         
                      (    forth6809.asm):03516                     ; A trailing "." means a double number: leave it out of the
                      (    forth6809.asm):03517                     ; digit count. See shadow: NUMBERQ.1

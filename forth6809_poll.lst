                      (    forth6809.asm):10868         
FFBD BDCE9F           (    forth6809.asm):10869                     JSR   INITSERIAL
                      (    forth6809.asm):10870         
FFC0 1CAF             (    forth6809.asm):10871                     ANDCC #$AF              ; Enable IRQ & FIRQ
                      (    forth6809.asm):10872         
                      (    forth6809.asm):10873                     ; IRQ and FIRQ are unmasked above. See bugfix: COLDSTRT.1
                      (    forth6809.asm):10874         
                      (    forth6809.asm):10875                     IFNE  UNITTESTS         ; >>>>>>>>>>
                      (    forth6809.asm):10876                     JSR   TSTRUNNER
                      (    forth6809.asm):10877                     ELSE                    ; <<<<<>>>>>

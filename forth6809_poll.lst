D862 AFE4             (    forth6809.asm):03653                     STX   ,S
D864 AEA4             (    forth6809.asm):03654                     LDX   ,Y                ; newest header of that wordlist
D866 10AE63           (    forth6809.asm):03655                     LDY   3,S
D869 E662             (    forth6809.asm):03656                     LDB   2,S
D86B 8DA8             (    forth6809.asm):03657                     BSR   FDSEARCH

                      (    forth6809.asm):09399         ; [IF]  ( flag -- )     [ELSE]  ( -- )     [THEN]  ( -- )
                      (    forth6809.asm):09400         ; Programming-Tools conditional compilation. All three are
                      (    forth6809.asm):09401         ; immediate, so they work while interpreting and while compiling.
                      (    forth6809.asm):09402         ; [IF] with a true flag does nothing. With a false flag, and for
                      (    forth6809.asm):09403         ; [ELSE], the input is skipped word by word, counting nested
                      (    forth6809.asm):09404         ; [IF]s, up to the matching [ELSE] or [THEN]. The three names are
                      (    forth6809.asm):09405         ; matched exactly, as the dictionary matches every name. If the line
                      (    forth6809.asm):09406         ; runs out, the next line is read with REFILL; if no more input is
                      (    forth6809.asm):09407         ; available the skip ends.
                      (    forth6809.asm):09408         ; [THEN] is a marker and does nothing when it is executed.
                      (    forth6809.asm):09409         ; The nesting level is kept at 0,S.
                      (    forth6809.asm):09410         ; ------------------------------------------------------------
F284 3706             (    forth6809.asm):09411         BRIFW:      PULU  D
F286 10830000         (    forth6809.asm):09412                     CMPD  #0
F28A 266D             (    forth6809.asm):09413                     BNE   BRTHENW           ; true: nothing to skip
F28C CC0001           (    forth6809.asm):09414         BRELSEW:    LDD   #1
F28F 3406             (    forth6809.asm):09415                     PSHS  D                 ; level
F291 BDE92D           (    forth6809.asm):09416         BRNEXT:     JSR   PARSENAMEW
F294 3706             (    forth6809.asm):09417                     PULU  D                 ; length
F296 3710             (    forth6809.asm):09418                     PULU  X                 ; address
F298 10830000         (    forth6809.asm):09419                     CMPD  #0
F29C 274E             (    forth6809.asm):09420                     BEQ   BRREFILL
F29E 10830004         (    forth6809.asm):09421                     CMPD  #4
F2A2 2734             (    forth6809.asm):09422                     BEQ   BR4
F2A4 10830006         (    forth6809.asm):09423                     CMPD  #6
F2A8 26E7             (    forth6809.asm):09424                     BNE   BRNEXT
F2AA C606             (    forth6809.asm):09425                     LDB   #6
F2AC 108EF308         (    forth6809.asm):09426                     LDY   #BRSELSE
F2B0 3410             (    forth6809.asm):09427                     PSHS  X
F2B2 BDF2FA           (    forth6809.asm):09428                     JSR   BRCMP
F2B5 3510             (    forth6809.asm):09429                     PULS  X
F2B7 2609             (    forth6809.asm):09430                     BNE   BR6B
F2B9 ECE4             (    forth6809.asm):09431                     LDD   ,S                ; [ELSE]: ends the skip at level 1
F2BB 830001           (    forth6809.asm):09432                     SUBD  #1

                      (    forth6809.asm):05398         ; 2OVER  ( x1 x2 x3 x4 -- x1 x2 x3 x4 x1 x2 )
                      (    forth6809.asm):05399         ; Copy the second cell pair to the top.
                      (    forth6809.asm):05400         ; ------------------------------------------------------------
E9D2 EC46             (    forth6809.asm):05401         DOVERW:     LDD   6,U               ; x1
E9D4 AE44             (    forth6809.asm):05402                     LDX   4,U               ; x2
E9D6 3606             (    forth6809.asm):05403                     PSHU  D
E9D8 3610             (    forth6809.asm):05404                     PSHU  X
E9DA 39               (    forth6809.asm):05405                     RTS
                      (    forth6809.asm):05406         
                      (    forth6809.asm):05407         ; ------------------------------------------------------------
                      (    forth6809.asm):05408         ; NIP  ( x1 x2 -- x2 )
                      (    forth6809.asm):05409         ; Discard the second cell.
                      (    forth6809.asm):05410         ; ------------------------------------------------------------

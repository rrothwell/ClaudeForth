                      (    forth6809.asm):05878         
                      (    forth6809.asm):05879         ; ------------------------------------------------------------
                      (    forth6809.asm):05880         ; ROLL  ( xu xu-1 ... x0 u -- xu-1 ... x0 xu )
                      (    forth6809.asm):05881         ; Move the cell u deep (0 ROLL does nothing) to the top, shifting the
                      (    forth6809.asm):05882         ; cells above it down one place. RDST holds the byte offset and RVAL

DA5F                  (    forth6809.asm):02226         IRQDONE0:   RTI                     ; Single point of exit - re-enables interrupts
                      (    forth6809.asm):02227                                             ; & restores state.
                      (    forth6809.asm):02228         
DA5F                  (    forth6809.asm):02229         INCHAR:
                      (    forth6809.asm):02230                     LDB   ACIADR            ; Get the char & clear RDRF & error flags.
                      (    forth6809.asm):02231                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):02232                                             ; Any receiver error flagged?
                      (    forth6809.asm):02233                     BEQ   INOK              ; No! - character is good, keep it.
                      (    forth6809.asm):02234         
                      (    forth6809.asm):02235                     BITA  #SR_FE            ; Yes! char is corrupted, discard it.
                      (    forth6809.asm):02236                     BEQ   INXFE             ; Tally each flagged error independently -
                      (    forth6809.asm):02237                     INC   FECOUNT           ; more than one bit can be set at once.

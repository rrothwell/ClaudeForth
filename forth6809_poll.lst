                      (    forth6809.asm):05704         ; Copy the second cell pair to the top.
                      (    forth6809.asm):05705         ; ------------------------------------------------------------
E2AD EC46             (    forth6809.asm):05706         DOVERW:     LDD   6,U               ; x1
E2AF AE44             (    forth6809.asm):05707                     LDX   4,U               ; x2
E2B1 3606             (    forth6809.asm):05708                     PSHU  D
E2B3 3610             (    forth6809.asm):05709                     PSHU  X
E2B5 39               (    forth6809.asm):05710                     RTS
                      (    forth6809.asm):05711         
                      (    forth6809.asm):05712         ; ------------------------------------------------------------
                      (    forth6809.asm):05713         ; NIP  ( x1 x2 -- x2 )

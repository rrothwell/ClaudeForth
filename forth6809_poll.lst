                      (    forth6809.asm):03742         ; ------------------------------------------------------------
                      (    forth6809.asm):03743         ; Throw -11 unless RegX is the address of a wordlist cell in use.
                      (    forth6809.asm):03744         ; WIDCHK
                      (    forth6809.asm):03745         ;    Inputs:

                      (    forth6809.asm):05700         ; ------------------------------------------------------------
DEFE CCBD00           (    forth6809.asm):05701         DEPTHW:     LDD   #SP0
DF01 3440             (    forth6809.asm):05702                     PSHS  U
DF03 A3E1             (    forth6809.asm):05703                     SUBD  ,S++
DF05 44               (    forth6809.asm):05704                     LSRA
DF06 56               (    forth6809.asm):05705                     RORB
DF07 3606             (    forth6809.asm):05706                     PSHU  D                 ; +n
DF09 39               (    forth6809.asm):05707                     RTS
                      (    forth6809.asm):05708         
                      (    forth6809.asm):05709         ; ------------------------------------------------------------
                      (    forth6809.asm):05710         ; 2DUP  ( x1 x2 -- x1 x2 x1 x2 )
                      (    forth6809.asm):05711         ; Duplicate the top cell pair.
                      (    forth6809.asm):05712         ; ------------------------------------------------------------
DF0A EC42             (    forth6809.asm):05713         DDUPW:      LDD   2,U               ; x1

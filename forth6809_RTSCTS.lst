                      (    forth6809.asm):02022         ; ------------------------------------------------------------
                      (    forth6809.asm):02023         ; If the input ring is near full and RTS is not already high,
                      (    forth6809.asm):02024         ; set RTSSTATE to INREJECT and update the ACIA to drop RTS.
                      (    forth6809.asm):02025         ; Called after a character is added to the ring.
                      (    forth6809.asm):02026         ; CHKHI
                      (    forth6809.asm):02027         ;    Inputs:
                      (    forth6809.asm):02028         ;        RegB = input ring fill level
                      (    forth6809.asm):02029         ;    Outputs:
                      (    forth6809.asm):02030         ;        RTSSTATE and ACIACR updated if the high-water mark was reached
                      (    forth6809.asm):02031         ;    Registers: RegA and CC changed.

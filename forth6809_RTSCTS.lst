E029 ED42             (    forth6809.asm):05852                     STD   2,U
E02B 3342             (    forth6809.asm):05853                     LEAU  2,U
E02D 39               (    forth6809.asm):05854                     RTS
                      (    forth6809.asm):05855         
                      (    forth6809.asm):05856         ; ------------------------------------------------------------
                      (    forth6809.asm):05857         ; TUCK  ( x1 x2 -- x2 x1 x2 )

E54E 2720             (    forth6809.asm):04518                     BEQ   THUNCAU
                      (    forth6809.asm):04519         
E550 1F14             (    forth6809.asm):04520                     TFR   X,S
E552 3506             (    forth6809.asm):04521                     PULS  D                 ; restore input source saved by CATCH
E554 DD10             (    forth6809.asm):04522                     STD   TOIN
E556 3506             (    forth6809.asm):04523                     PULS  D
E558 DD3D             (    forth6809.asm):04524                     STD   SRCID
E55A 3506             (    forth6809.asm):04525                     PULS  D
E55C DD3B             (    forth6809.asm):04526                     STD   SRCLEN
E55E 3506             (    forth6809.asm):04527                     PULS  D
E560 DD39             (    forth6809.asm):04528                     STD   SRCADDR
E562 3506             (    forth6809.asm):04529                     PULS  D
E564 1F03             (    forth6809.asm):04530                     TFR   D,U
E566 3506             (    forth6809.asm):04531                     PULS  D
E568 DD0C             (    forth6809.asm):04532                     STD   HANDLER
                      (    forth6809.asm):04533         

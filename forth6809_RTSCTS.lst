D4C8 EC66             (    forth6809.asm):03462                     LDD   6,S
D4CA 3606             (    forth6809.asm):03463                     PSHU  D
D4CC BDD1C9           (    forth6809.asm):03464                     JSR   COMMAW
D4CF EC64             (    forth6809.asm):03465                     LDD   4,S
D4D1 3606             (    forth6809.asm):03466                     PSHU  D
D4D3 BDD1C9           (    forth6809.asm):03467                     JSR   COMMAW
D4D6 EC62             (    forth6809.asm):03468                     LDD   2,S
D4D8 3606             (    forth6809.asm):03469                     PSHU  D
D4DA BDD1C9           (    forth6809.asm):03470                     JSR   COMMAW
D4DD ECE4             (    forth6809.asm):03471                     LDD   ,S
D4DF 3606             (    forth6809.asm):03472                     PSHU  D
D4E1 BDD1C9           (    forth6809.asm):03473                     JSR   COMMAW
D4E4 9E08             (    forth6809.asm):03474                     LDX   CODEHERE          ; then the search order state
D4E6 108E0045         (    forth6809.asm):03475                     LDY   #SRCHSAVE

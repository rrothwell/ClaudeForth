                      (    forth6809.asm):08128         ; ------------------------------------------------------------
                      (    forth6809.asm):08129         ; Divide the unsigned double on the data stack (high cell at 0,U, low
                      (    forth6809.asm):08130         ; cell at 2,U) by BASE (restoring division, 32 iterations). Only the
                      (    forth6809.asm):08131         ; low byte of BASE is used.
                      (    forth6809.asm):08132         ; UDDIGIT
                      (    forth6809.asm):08133         ;    Inputs:
                      (    forth6809.asm):08134         ;        ud on the data stack
                      (    forth6809.asm):08135         ;    Outputs:

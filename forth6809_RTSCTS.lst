                      (    forth6809.asm):05650         ; Run-time part of ABORT". The counted string follows the call. If
                      (    forth6809.asm):05651         ; flag is non-zero, TYPE the string and THROW -2; otherwise skip over
                      (    forth6809.asm):05652         ; the string.
                      (    forth6809.asm):05653         ; DOABORTQUOTE   ( flag -- )
                      (    forth6809.asm):05654         ;    Inputs:
                      (    forth6809.asm):05655         ;        flag on the data stack; return address on S points at the
                      (    forth6809.asm):05656         ;        count byte
                      (    forth6809.asm):05657         ;    Outputs:
                      (    forth6809.asm):05658         ;        execution continues after the string, or THROW -2
                      (    forth6809.asm):05659         ;    Registers: RegA, RegB, RegD, RegX, RegY changed.
                      (    forth6809.asm):05660         ; ------------------------------------------------------------
DF69                  (    forth6809.asm):05661         DOABORTQUOTE:
DF69 3510             (    forth6809.asm):05662                     PULS  X
DF6B E684             (    forth6809.asm):05663                     LDB   ,X
DF6D 3001             (    forth6809.asm):05664                     LEAX  1,X               ; X = text, B = length
DF6F 4F               (    forth6809.asm):05665                     CLRA
DF70 3720             (    forth6809.asm):05666                     PULU  Y                 ; flag
DF72 108C0000         (    forth6809.asm):05667                     CMPY  #0
DF76 2605             (    forth6809.asm):05668                     BNE   AQTHROW
DF78 3085             (    forth6809.asm):05669                     LEAX  B,X
DF7A 3410             (    forth6809.asm):05670                     PSHS  X

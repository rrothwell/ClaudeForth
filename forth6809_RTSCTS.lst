                      (    forth6809.asm):08823         ; ------------------------------------------------------------
                      (    forth6809.asm):08824         ; (  ( "ccc<paren>" -- )
                      (    forth6809.asm):08825         ; Parse and discard text up to the closing parenthesis.
                      (    forth6809.asm):08826         ; ------------------------------------------------------------
F0D0 CC0029           (    forth6809.asm):08827         LPARENW:    LDD   #')'
F0D3 3606             (    forth6809.asm):08828                     PSHU  D
F0D5 BDD578           (    forth6809.asm):08829                     JSR   WORDW
F0D8 3706             (    forth6809.asm):08830                     PULU  D                 ; discard c-addr. See bugfix: LPARENW.1
F0DA 39               (    forth6809.asm):08831                     RTS
                      (    forth6809.asm):08832         
                      (    forth6809.asm):08833         ; ------------------------------------------------------------
                      (    forth6809.asm):08834         ; \  ( "ccc<eol>" -- )
                      (    forth6809.asm):08835         ; Discard the rest of the input line by setting >IN to the source
                      (    forth6809.asm):08836         ; length.
                      (    forth6809.asm):08837         ; ------------------------------------------------------------
F0DB DC3B             (    forth6809.asm):08838         BACKSLASHW: LDD   SRCLEN
F0DD DD10             (    forth6809.asm):08839                     STD   TOIN
F0DF 39               (    forth6809.asm):08840                     RTS
                      (    forth6809.asm):08841         
                      (    forth6809.asm):08842         ; ============================================================
                      (    forth6809.asm):08843         ; SECTION 24: ENVIRONMENTAL QUERY / SOURCE / REFILL / EVALUATE
                      (    forth6809.asm):08844         ; ============================================================
                      (    forth6809.asm):08845         ; ------------------------------------------------------------
                      (    forth6809.asm):08846         ; SOURCE  ( -- c-addr u )
                      (    forth6809.asm):08847         ; Push the address and length of the current input source.
                      (    forth6809.asm):08848         ; ------------------------------------------------------------
F0E0 DC39             (    forth6809.asm):08849         SOURCEW:    LDD   SRCADDR
F0E2 3606             (    forth6809.asm):08850                     PSHU  D
F0E4 DC3B             (    forth6809.asm):08851                     LDD   SRCLEN
F0E6 3606             (    forth6809.asm):08852                     PSHU  D
F0E8 39               (    forth6809.asm):08853                     RTS
                      (    forth6809.asm):08854         
                      (    forth6809.asm):08855         ; ------------------------------------------------------------
                      (    forth6809.asm):08856         ; SOURCE-ID  ( -- 0 | -1 )

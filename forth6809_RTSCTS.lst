                      (    forth6809.asm):05643         ; ------------------------------------------------------------
DFD8 CC0012           (    forth6809.asm):05644         NUMTIBW:    LDD   #NTIB
DFDB 3606             (    forth6809.asm):05645                     PSHU  D
DFDD 39               (    forth6809.asm):05646                     RTS
                      (    forth6809.asm):05647         
                      (    forth6809.asm):05648         ; ============================================================
                      (    forth6809.asm):05649         ; SECTION 14: STACK MANIPULATION (Core + Core Ext + return stack)
                      (    forth6809.asm):05650         ; ============================================================
                      (    forth6809.asm):05651         ; ------------------------------------------------------------
                      (    forth6809.asm):05652         ; DUP  ( x -- x x )
                      (    forth6809.asm):05653         ; Duplicate the top cell.
                      (    forth6809.asm):05654         ; ------------------------------------------------------------
DFDE ECC4             (    forth6809.asm):05655         DUPW:       LDD   ,U                ; x
DFE0 3606             (    forth6809.asm):05656                     PSHU  D
DFE2 39               (    forth6809.asm):05657                     RTS
                      (    forth6809.asm):05658         
                      (    forth6809.asm):05659         ; ------------------------------------------------------------
                      (    forth6809.asm):05660         ; DROP  ( x -- )
                      (    forth6809.asm):05661         ; Discard the top cell.
                      (    forth6809.asm):05662         ; ------------------------------------------------------------
DFE3 3342             (    forth6809.asm):05663         DROPW:      LEAU  2,U               ; x
DFE5 39               (    forth6809.asm):05664                     RTS
                      (    forth6809.asm):05665         
                      (    forth6809.asm):05666         ; ------------------------------------------------------------
                      (    forth6809.asm):05667         ; SWAP  ( x1 x2 -- x2 x1 )
                      (    forth6809.asm):05668         ; Exchange the top two cells.
                      (    forth6809.asm):05669         ; ------------------------------------------------------------
DFE6 ECC4             (    forth6809.asm):05670         SWAPW:      LDD   ,U                ; x2
DFE8 AE42             (    forth6809.asm):05671                     LDX   2,U               ; x1
DFEA AFC4             (    forth6809.asm):05672                     STX   ,U
DFEC ED42             (    forth6809.asm):05673                     STD   2,U
DFEE 39               (    forth6809.asm):05674                     RTS
                      (    forth6809.asm):05675         
                      (    forth6809.asm):05676         ; ------------------------------------------------------------
                      (    forth6809.asm):05677         ; OVER  ( x1 x2 -- x1 x2 x1 )
                      (    forth6809.asm):05678         ; Copy the second cell to the top.
                      (    forth6809.asm):05679         ; ------------------------------------------------------------
DFEF EC42             (    forth6809.asm):05680         OVERW:      LDD   2,U               ; x1
DFF1 3606             (    forth6809.asm):05681                     PSHU  D
DFF3 39               (    forth6809.asm):05682                     RTS
                      (    forth6809.asm):05683         
                      (    forth6809.asm):05684         ; ------------------------------------------------------------
                      (    forth6809.asm):05685         ; ROT  ( x1 x2 x3 -- x2 x3 x1 )
                      (    forth6809.asm):05686         ; Rotate the third cell to the top.
                      (    forth6809.asm):05687         ; ------------------------------------------------------------
DFF4 ECC4             (    forth6809.asm):05688         ROTW:       LDD   ,U                ; x3
DFF6 AE42             (    forth6809.asm):05689                     LDX   2,U               ; x2
DFF8 10AE44           (    forth6809.asm):05690                     LDY   4,U               ; x1
DFFB 10AFC4           (    forth6809.asm):05691                     STY   ,U
DFFE ED42             (    forth6809.asm):05692                     STD   2,U
E000 AF44             (    forth6809.asm):05693                     STX   4,U
E002 39               (    forth6809.asm):05694                     RTS
                      (    forth6809.asm):05695         
                      (    forth6809.asm):05696         ; ------------------------------------------------------------
                      (    forth6809.asm):05697         ; ?DUP  ( x -- 0 | x x )
                      (    forth6809.asm):05698         ; Duplicate the top cell if it is non-zero.
                      (    forth6809.asm):05699         ; ------------------------------------------------------------
E003 ECC4             (    forth6809.asm):05700         QDUPW:      LDD   ,U                ; x
E005 10830000         (    forth6809.asm):05701                     CMPD  #0
E009 2702             (    forth6809.asm):05702                     BEQ   QDUPDONE
E00B 3606             (    forth6809.asm):05703                     PSHU  D
E00D 39               (    forth6809.asm):05704         QDUPDONE:   RTS
                      (    forth6809.asm):05705         
                      (    forth6809.asm):05706         ; ------------------------------------------------------------
                      (    forth6809.asm):05707         ; DEPTH  ( -- +n )

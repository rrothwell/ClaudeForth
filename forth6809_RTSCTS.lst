                      (    forth6809.asm):08768         ; ENVIRONMENT?  ( c-addr u -- false | i*x true )
                      (    forth6809.asm):08769         ; Look up the attribute name c-addr u first in ENVTABLE (single-cell
                      (    forth6809.asm):08770         ; values), then in ENVTABLE2 (double-cell values). If found, return
                      (    forth6809.asm):08771         ; the value and true; otherwise return false. WORDLISTS is 8, the
                      (    forth6809.asm):08772         ; number of wordlists that can exist. FLOORED is false because /, MOD and /MOD use symmetric
                      (    forth6809.asm):08773         ; division.
                      (    forth6809.asm):08774         ; Original comment: shadow ENVQW.0.
                      (    forth6809.asm):08775         ; ------------------------------------------------------------
FC35 3706             (    forth6809.asm):08776         ENVQW:      PULU  D                 ; u
FC37 3406             (    forth6809.asm):08777                     PSHS  D                 ; frame: 2,S = u, 0,S = c-addr (5k)
FC39 3706             (    forth6809.asm):08778                     PULU  D                 ; c-addr
FC3B 3406             (    forth6809.asm):08779                     PSHS  D
FC3D 8EFCD6           (    forth6809.asm):08780                     LDX   #ENVTABLE
FC40 EC84             (    forth6809.asm):08781         ENVLOOP:    LDD   ,X
FC42 10830000         (    forth6809.asm):08782                     CMPD  #0
FC46 272D             (    forth6809.asm):08783                     BEQ   ENV2START         ; end of table: try ENVTABLE2
FC48 3410             (    forth6809.asm):08784                     PSHS  X                 ; See bugfix: ENVQW.2 (frame now +2)
FC4A 3606             (    forth6809.asm):08785                     PSHU  D
FC4C EC02             (    forth6809.asm):08786                     LDD   2,X
FC4E 3606             (    forth6809.asm):08787                     PSHU  D
FC50 EC62             (    forth6809.asm):08788                     LDD   2,S               ; c-addr
FC52 3606             (    forth6809.asm):08789                     PSHU  D
FC54 EC64             (    forth6809.asm):08790                     LDD   4,S               ; u
FC56 3606             (    forth6809.asm):08791                     PSHU  D
FC58 BDF681           (    forth6809.asm):08792                     JSR   COMPAREW
FC5B 3510             (    forth6809.asm):08793                     PULS  X                 ; restore X before using it again
FC5D 3706             (    forth6809.asm):08794                     PULU  D
FC5F 10830000         (    forth6809.asm):08795                     CMPD  #0
FC63 2704             (    forth6809.asm):08796                     BEQ   ENVFOUND
FC65 3006             (    forth6809.asm):08797                     LEAX  6,X
FC67 20D7             (    forth6809.asm):08798                     BRA   ENVLOOP

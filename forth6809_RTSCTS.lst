DFE2 BDE1F8           (    forth6809.asm):03188                     JSR   FINDW
DFE5 3706             (    forth6809.asm):03189                     PULU  D
DFE7 10830000         (    forth6809.asm):03190                     CMPD  #0
DFEB 260A             (    forth6809.asm):03191                     BNE   ISFOUND
DFED 3706             (    forth6809.asm):03192                     PULU  D
DFEF CCFFF3           (    forth6809.asm):03193                     LDD   #-13
DFF2 3606             (    forth6809.asm):03194                     PSHU  D
DFF4 BDE542           (    forth6809.asm):03195                     JSR   THROWW
DFF7 3710             (    forth6809.asm):03196         ISFOUND:    PULU  X
DFF9 DC00             (    forth6809.asm):03197                     LDD   STATE
DFFB 270E             (    forth6809.asm):03198                     BEQ   ISIMMED
DFFD 3610             (    forth6809.asm):03199                     PSHU  X
DFFF BDE98A           (    forth6809.asm):03200                     JSR   LITERALW
E002 CCDFD0           (    forth6809.asm):03201                     LDD   #DEFERSTOREW
E005 3606             (    forth6809.asm):03202                     PSHU  D
E007 BDE97D           (    forth6809.asm):03203                     JSR   CCALL
E00A 39               (    forth6809.asm):03204                     RTS
E00B 3610             (    forth6809.asm):03205         ISIMMED:    PSHU  X
E00D BDDFD0           (    forth6809.asm):03206                     JSR   DEFERSTOREW
E010 39               (    forth6809.asm):03207                     RTS
                      (    forth6809.asm):03208         
                      (    forth6809.asm):03209         ; ------------------------------------------------------------
                      (    forth6809.asm):03210         ; ACTION-OF  ( "name" -- xt )  IMMEDIATE
                      (    forth6809.asm):03211         ; Return the xt currently stored in the named deferred word. When
                      (    forth6809.asm):03212         ; compiling, compile code to do so at run time. Error -13 if the name

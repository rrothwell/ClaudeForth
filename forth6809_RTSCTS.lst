                      (    forth6809.asm):08513         ; ------------------------------------------------------------
                      (    forth6809.asm):08514         ; Divide the unsigned double on the data stack (high cell at 0,U, low
                      (    forth6809.asm):08515         ; cell at 2,U) by BASE (restoring division, 32 iterations). Only the
                      (    forth6809.asm):08516         ; low byte of BASE is used.
                      (    forth6809.asm):08517         ; UDDIGIT
                      (    forth6809.asm):08518         ;    Inputs:
                      (    forth6809.asm):08519         ;        ud on the data stack
                      (    forth6809.asm):08520         ;    Outputs:
                      (    forth6809.asm):08521         ;        ud replaced by the quotient; RegA = remainder
                      (    forth6809.asm):08522         ;    Registers: RegA and RegB changed (RegB is the loop counter).
                      (    forth6809.asm):08523         ; ------------------------------------------------------------
EF29 4F               (    forth6809.asm):08524         UDDIGIT:    CLRA                    ; A = remainder

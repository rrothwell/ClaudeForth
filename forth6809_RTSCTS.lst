                      (    forth6809.asm):05106         
DD04 ECC4             (    forth6809.asm):05107                     LDD   ,U
DD06 10830007         (    forth6809.asm):05108                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: PLUSLOOPW.2
DD0A 260D             (    forth6809.asm):05109                     BNE   PLOOPDONE
DD0C 3706             (    forth6809.asm):05110                     PULU  D
DD0E 3710             (    forth6809.asm):05111                     PULU  X                 ; ?DO skip operand
DD10 DC08             (    forth6809.asm):05112                     LDD   CODEHERE
DD12 3606             (    forth6809.asm):05113                     PSHU  D
DD14 3610             (    forth6809.asm):05114                     PSHU  X

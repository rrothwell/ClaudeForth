EB1C ED42             (    forth6809.asm):05612                     STD   2,U
EB1E 3342             (    forth6809.asm):05613                     LEAU  2,U
EB20 39               (    forth6809.asm):05614                     RTS
                      (    forth6809.asm):05615         
                      (    forth6809.asm):05616         ; ------------------------------------------------------------
                      (    forth6809.asm):05617         ; TUCK  ( x1 x2 -- x2 x1 x2 )
                      (    forth6809.asm):05618         ; Copy the top cell beneath the second cell.
                      (    forth6809.asm):05619         ; ------------------------------------------------------------
EB21 ECC4             (    forth6809.asm):05620         TUCKW:      LDD   ,U                ; x2

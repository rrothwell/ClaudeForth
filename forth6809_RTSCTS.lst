DD98 CC0000           (    forth6809.asm):05212                     LDD   #0
DD9B 3406             (    forth6809.asm):05213                     PSHS  D
DD9D DC16             (    forth6809.asm):05214                     LDD   MSCR2
DD9F 3406             (    forth6809.asm):05215                     PSHS  D
DDA1 DC14             (    forth6809.asm):05216                     LDD   MSCR
DDA3 3406             (    forth6809.asm):05217                     PSHS  D
DDA5 3410             (    forth6809.asm):05218                     PSHS  X
DDA7 39               (    forth6809.asm):05219                     RTS

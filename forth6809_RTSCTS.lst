                      (    forth6809.asm):10885         ; ------------------------------------------------------------
                      (    forth6809.asm):10886         ; Warm start, entered from the NMI vector: mask interrupts, reset the
                      (    forth6809.asm):10887         ; stacks and direct page, re-initialise the ACIA, print the warm-start
                      (    forth6809.asm):10888         ; message, unmask interrupts and ABORT. GLOBALS is not cleared.
                      (    forth6809.asm):10889         ; WARM
                      (    forth6809.asm):10890         ;    Inputs:
                      (    forth6809.asm):10891         ;        NMI
                      (    forth6809.asm):10892         ;    Outputs:
                      (    forth6809.asm):10893         ;        does not return
                      (    forth6809.asm):10894         ;    Registers: all registers initialised.
                      (    forth6809.asm):10895         ; ------------------------------------------------------------

                      (    forth6809.asm):06993         ; ------------------------------------------------------------
F347 3710             (    forth6809.asm):06994         PLUSSTOREW: PULU  X                 ; a-addr
F349 3706             (    forth6809.asm):06995                     PULU  D                 ; n

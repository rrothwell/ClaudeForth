                      (    forth6809.asm):06949         ; ------------------------------------------------------------
                      (    forth6809.asm):06950         ; Run-time part of ."  The counted string follows the call: TYPE it
                      (    forth6809.asm):06951         ; and skip over it.
                      (    forth6809.asm):06952         ; DOTSTR
                      (    forth6809.asm):06953         ;    Inputs:
                      (    forth6809.asm):06954         ;        return address on S points at the count byte
                      (    forth6809.asm):06955         ;    Outputs:
                      (    forth6809.asm):06956         ;        string displayed; execution resumes after the string
                      (    forth6809.asm):06957         ;    Registers: RegB, RegD and RegX changed.
                      (    forth6809.asm):06958         ; ------------------------------------------------------------
F528 3510             (    forth6809.asm):06959         DOTSTR:     PULS  X
F52A E684             (    forth6809.asm):06960                     LDB   ,X
F52C 3001             (    forth6809.asm):06961                     LEAX  1,X
F52E 3610             (    forth6809.asm):06962                     PSHU  X
F530 4F               (    forth6809.asm):06963                     CLRA
F531 3606             (    forth6809.asm):06964                     PSHU  D
F533 3085             (    forth6809.asm):06965                     LEAX  B,X
F535 3410             (    forth6809.asm):06966                     PSHS  X
F537 7EF570           (    forth6809.asm):06967                     JMP   TYPEW
                      (    forth6809.asm):06968         
                      (    forth6809.asm):06969         ; ------------------------------------------------------------
                      (    forth6809.asm):06970         ; ."  ( "ccc<quote>" -- )
                      (    forth6809.asm):06971         ; Compile DOTSTR followed by the string up to the closing quote as a
                      (    forth6809.asm):06972         ; counted string.
                      (    forth6809.asm):06973         ; ------------------------------------------------------------

                      (    forth6809.asm):01955         ; Return the input ring buffer fill level (0 to INBUFSZ-1).
                      (    forth6809.asm):01956         ; INBUFSZ is a power of two and both indices stay in range, so a
                      (    forth6809.asm):01957         ; masked subtraction gives the true distance across the wrap.
                      (    forth6809.asm):01958         ; INFILL
                      (    forth6809.asm):01959         ;    Inputs:
                      (    forth6809.asm):01960         ;        none
                      (    forth6809.asm):01961         ;    Outputs:
                      (    forth6809.asm):01962         ;        RegA = (INHEAD - INTAIL) mod INBUFSZ
                      (    forth6809.asm):01963         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01964         ; ------------------------------------------------------------
D98B B60176           (    forth6809.asm):01965         INFILL:     LDA   INHEAD
D98E B00177           (    forth6809.asm):01966                     SUBA  INTAIL

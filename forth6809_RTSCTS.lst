                      (    forth6809.asm):04365         ; ------------------------------------------------------------
                      (    forth6809.asm):04366         ; Run-time end of +LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):04367         ; the back-branch operand. Add the step to the index. If the leave
                      (    forth6809.asm):04368         ; flag is set or the index crossed the limit, discard the loop frame
                      (    forth6809.asm):04369         ; and skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):04370         ; DOPLUSTEST   ( n -- )
                      (    forth6809.asm):04371         ;    Inputs:
                      (    forth6809.asm):04372         ;        step n on the data stack; S as for DOTEST
                      (    forth6809.asm):04373         ;    Outputs:
                      (    forth6809.asm):04374         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):04375         ;    Registers: RegD and RegX changed; MSCR, MSCR2 and MSCR3 used as
                      (    forth6809.asm):04376         ;        scratch.
                      (    forth6809.asm):04377         ; ------------------------------------------------------------
E7FB 3706             (    forth6809.asm):04378         DOPLUSTEST: PULU  D                 ; n = step. See bugfix: DOPLUSTEST.1
E7FD DD14             (    forth6809.asm):04379                     STD   MSCR              ; MSCR = step
E7FF EC66             (    forth6809.asm):04380                     LDD   6,S               ; leave flag. See bugfix: DOPLUSTEST.2
E801 262D             (    forth6809.asm):04381                     BNE   DPTEXIT           ; set: exit
E803 EC62             (    forth6809.asm):04382                     LDD   2,S               ; old index
E805 A364             (    forth6809.asm):04383                     SUBD  4,S               ; old_u = old_index - limit, mod 65536
E807 DD16             (    forth6809.asm):04384                     STD   MSCR2
E809 EC62             (    forth6809.asm):04385                     LDD   2,S
E80B D314             (    forth6809.asm):04386                     ADDD  MSCR              ; new_index = old_index + step
E80D ED62             (    forth6809.asm):04387                     STD   2,S
E80F A364             (    forth6809.asm):04388                     SUBD  4,S               ; new_u = new_index - limit, mod 65536
E811 DD18             (    forth6809.asm):04389                     STD   MSCR3
                      (    forth6809.asm):04390                     ; Crossing test on the unsigned distances old_u and new_u: with a
                      (    forth6809.asm):04391                     ; positive step the limit was crossed if new_u < old_u, with a
                      (    forth6809.asm):04392                     ; negative step if new_u > old_u. See bugfix: DOPLUSTEST.3
E813 DC14             (    forth6809.asm):04393                     LDD   MSCR              ; reload the step to test its sign
E815 2B09             (    forth6809.asm):04394                     BMI   DPNEG
E817 DC18             (    forth6809.asm):04395         DPPOS:      LDD   MSCR3             ; step > 0: crossed if new_u < old_u
E819 109316           (    forth6809.asm):04396                     CMPD  MSCR2
E81C 2512             (    forth6809.asm):04397                     BLO   DPTEXIT
E81E 2007             (    forth6809.asm):04398                     BRA   DPCONT
E820 DC18             (    forth6809.asm):04399         DPNEG:      LDD   MSCR3             ; step < 0: crossed if new_u > old_u
E822 109316           (    forth6809.asm):04400                     CMPD  MSCR2
E825 2209             (    forth6809.asm):04401                     BHI   DPTEXIT
E827 3510             (    forth6809.asm):04402         DPCONT:     PULS  X                 ; X = branch operand address
E829 EC84             (    forth6809.asm):04403                     LDD   ,X
E82B 308B             (    forth6809.asm):04404                     LEAX  D,X
E82D 3410             (    forth6809.asm):04405                     PSHS  X
E82F 39               (    forth6809.asm):04406                     RTS
E830 3510             (    forth6809.asm):04407         DPTEXIT:    PULS  X
E832 3002             (    forth6809.asm):04408                     LEAX  2,X               ; skip the branch operand
E834 3266             (    forth6809.asm):04409                     LEAS  6,S               ; discard the loop frame
E836 3410             (    forth6809.asm):04410                     PSHS  X
E838 39               (    forth6809.asm):04411                     RTS

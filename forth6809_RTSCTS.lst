DF14 EC03             (    forth6809.asm):03054                     LDD   3,X
DF16 1083DEDE         (    forth6809.asm):03055                     CMPD  #DO2VALUE
DF1A 271A             (    forth6809.asm):03056                     BEQ   TOTWO

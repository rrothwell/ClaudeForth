                      (    forth6809.asm):09514         ; ------------------------------------------------------------
F4F8 CC0002           (    forth6809.asm):09515         POSTWOW:    LDD   #2
F4FB 3606             (    forth6809.asm):09516                     PSHU  D
F4FD 39               (    forth6809.asm):09517                     RTS
                      (    forth6809.asm):09518         
                      (    forth6809.asm):09519         ; ------------------------------------------------------------
                      (    forth6809.asm):09520         ; -2  ( -- -2 )
                      (    forth6809.asm):09521         ; Push the constant -2.
                      (    forth6809.asm):09522         ; ------------------------------------------------------------
F4FE CCFFFE           (    forth6809.asm):09523         NEGTWOW:    LDD   #-2

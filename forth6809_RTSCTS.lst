CEB7 39               (    forth6809.asm):02108                     RTS
                      (    forth6809.asm):02109         ; ------------------------------------------------------------
                      (    forth6809.asm):02110         ; Assert RTS high (ask the sender to pause) if the input ring has
                      (    forth6809.asm):02111         ; reached INHIWATER and RTS is not already high. Called from the
                      (    forth6809.asm):02112         ; receive path with interrupts already masked.
                      (    forth6809.asm):02113         ; RTSCHECKHI
                      (    forth6809.asm):02114         ;    Inputs:
                      (    forth6809.asm):02115         ;        none
                      (    forth6809.asm):02116         ;    Outputs:
                      (    forth6809.asm):02117         ;        RTSSTATE = 1 and ACIACR = CR_RTSHI if the threshold was reached
                      (    forth6809.asm):02118         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02119         ; ------------------------------------------------------------
CEB8 BDCEAF           (    forth6809.asm):02120         RTSCHECKHI: JSR   INFILL
CEBB 8130             (    forth6809.asm):02121                     CMPA  #INHIWATER
CEBD 250F             (    forth6809.asm):02122                     BLO   RTSCHIDONE
CEBF 7D0178           (    forth6809.asm):02123                     TST   RTSSTATE
CEC2 260A             (    forth6809.asm):02124                     BNE   RTSCHIDONE        ; already high - nothing to do
CEC4 86D5             (    forth6809.asm):02125                     LDA   #CR_RTSHI
CEC6 B7C008           (    forth6809.asm):02126                     STA   ACIACR
CEC9 8601             (    forth6809.asm):02127                     LDA   #1
CECB B70178           (    forth6809.asm):02128                     STA   RTSSTATE
CECE 39               (    forth6809.asm):02129         RTSCHIDONE: RTS
                      (    forth6809.asm):02130         ; ------------------------------------------------------------
                      (    forth6809.asm):02131         ; Write the ACIA control byte for the current RTSSTATE and
                      (    forth6809.asm):02132         ; OUTACTIVITY: RTS high disables the Tx interrupt; RTS low
                      (    forth6809.asm):02133         ; enables it only while output is pending.
                      (    forth6809.asm):02134         ; UPDATE_RTS
                      (    forth6809.asm):02135         ;    Inputs:
                      (    forth6809.asm):02136         ;        RTSSTATE, OUTACTIVITY
                      (    forth6809.asm):02137         ;    Outputs:
                      (    forth6809.asm):02138         ;        ACIACR written (OUTACTIVITY cleared when RTS is high)
                      (    forth6809.asm):02139         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02140         ; ------------------------------------------------------------
CECF                  (    forth6809.asm):02141         UPDATE_RTS:
CECF 7D0178           (    forth6809.asm):02142                     TST   RTSSTATE
CED2 260D             (    forth6809.asm):02143                     BNE   SET_RTS_HI_TX_OFF
                      (    forth6809.asm):02144         
CED4 7D017B           (    forth6809.asm):02145                     TST   OUTACTIVITY       ; Is active?
CED7 2704             (    forth6809.asm):02146                     BEQ   SET_RTS_LO_TX_OFF ; No! Disable Transmit interrupt.
                      (    forth6809.asm):02147         
                      (    forth6809.asm):02148                                             ; $B5/%1011_0101
CED9 86B5             (    forth6809.asm):02149                     LDA   #CR_RXTX          ; Yes! Accept input & transmit output
CEDB 2009             (    forth6809.asm):02150                     BRA   WRITE_CR          ; RTS = Low, Tx Interrupt = Enabled
                      (    forth6809.asm):02151         
CEDD                  (    forth6809.asm):02152         SET_RTS_LO_TX_OFF:                  ; $95/%10010101
CEDD 8695             (    forth6809.asm):02153                     LDA   #CR_RXON          ; RTS = Low, Tx Interrupt = Disabled
CEDF 2005             (    forth6809.asm):02154                     BRA   WRITE_CR          ; Open question moved to shadow: UPDATE_RTS.1
                      (    forth6809.asm):02155         
CEE1                  (    forth6809.asm):02156         SET_RTS_HI_TX_OFF:                  ; $D5/%1101_0101
CEE1 86D5             (    forth6809.asm):02157                     LDA   #CR_RTSHI         ; RTS = High, Tx Interrupt = Disabled
CEE3 7F017B           (    forth6809.asm):02158                     CLR   OUTACTIVITY       ; Interrupts are hardware-disabled; clear state
CEE6                  (    forth6809.asm):02159         WRITE_CR:
CEE6 B7C008           (    forth6809.asm):02160                     STA   ACIACR
CEE9 39               (    forth6809.asm):02161                     RTS
                      (    forth6809.asm):02162         ; ------------------------------------------------------------
                      (    forth6809.asm):02163         ; If the input ring is near full and RTS is not already high,
                      (    forth6809.asm):02164         ; set RTSSTATE to INREJECT and update the ACIA to drop RTS.
                      (    forth6809.asm):02165         ; Called after a character is added to the ring.
                      (    forth6809.asm):02166         ; CHKHI
                      (    forth6809.asm):02167         ;    Inputs:
                      (    forth6809.asm):02168         ;        RegB = input ring fill level
                      (    forth6809.asm):02169         ;    Outputs:
                      (    forth6809.asm):02170         ;        RTSSTATE and ACIACR updated if the high-water mark was reached
                      (    forth6809.asm):02171         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02172         ; Original comment: shadow CHKHI.0.
                      (    forth6809.asm):02173         ; ------------------------------------------------------------
CEEA                  (    forth6809.asm):02174         CHKHI:
CEEA C130             (    forth6809.asm):02175                     CMPB  #INHIWATER        ; RegB = fill level. Near full?
CEEC 250D             (    forth6809.asm):02176                     BLO   CHKHIDONE         ; No! Do nothing.
CEEE 7D0178           (    forth6809.asm):02177                     TST   RTSSTATE
CEF1 2608             (    forth6809.asm):02178                     BNE   CHKHIDONE         ; already high - nothing to do
CEF3 86FF             (    forth6809.asm):02179                     LDA   #INREJECT         ; Yes! De-assert RTS.
CEF5 B70178           (    forth6809.asm):02180                     STA   RTSSTATE
CEF8 BDCECF           (    forth6809.asm):02181                     JSR   UPDATE_RTS
CEFB 39               (    forth6809.asm):02182         CHKHIDONE:  RTS
                      (    forth6809.asm):02183         
                      (    forth6809.asm):02184         ; ------------------------------------------------------------
                      (    forth6809.asm):02185         ; If the input ring is near empty and RTS is high, set
                      (    forth6809.asm):02186         ; RTSSTATE to INACCEPT and update the ACIA to raise RTS.
                      (    forth6809.asm):02187         ; Called after a character is removed from the ring.
                      (    forth6809.asm):02188         ; CHKLO
                      (    forth6809.asm):02189         ;    Inputs:
                      (    forth6809.asm):02190         ;        RegB = input ring fill level
                      (    forth6809.asm):02191         ;    Outputs:
                      (    forth6809.asm):02192         ;        RTSSTATE and ACIACR updated if the low-water mark was reached
                      (    forth6809.asm):02193         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02194         ; ------------------------------------------------------------
CEFC                  (    forth6809.asm):02195         CHKLO:
CEFC C110             (    forth6809.asm):02196                     CMPB  #INLOWATER        ; RegB = fill level. Near empty?
CEFE 240D             (    forth6809.asm):02197                     BHS   CHKLODONE         ; No! Do nothing.
CF00 7D0178           (    forth6809.asm):02198                     TST   RTSSTATE
CF03 2708             (    forth6809.asm):02199                     BEQ   CHKLODONE         ; already low - nothing to do
CF05 8600             (    forth6809.asm):02200                     LDA   #INACCEPT         ; Yes! Assert RTS.
CF07 B70178           (    forth6809.asm):02201                     STA   RTSSTATE
CF0A BDCECF           (    forth6809.asm):02202                     JSR   UPDATE_RTS
CF0D 39               (    forth6809.asm):02203         CHKLODONE:  RTS
                      (    forth6809.asm):02204         ; ------------------------------------------------------------
                      (    forth6809.asm):02205         ; Send at most one character from the output ring to the ACIA
                      (    forth6809.asm):02206         ; by polling, then return. Nothing is sent if the ring is empty,
                      (    forth6809.asm):02207         ; the remote receiver is blocking (CTS) or the transmitter is not
                      (    forth6809.asm):02208         ; ready; the caller simply tries again on its next call.
                      (    forth6809.asm):02209         ; FLUSHOUTBUFFER
                      (    forth6809.asm):02210         ;    Inputs:
                      (    forth6809.asm):02211         ;        none
                      (    forth6809.asm):02212         ;    Outputs:
                      (    forth6809.asm):02213         ;        one character sent and OUTTAIL advanced, or no change
                      (    forth6809.asm):02214         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):02215         ; See bugfix: FLUSHOUTBUFFER.1.
                      (    forth6809.asm):02216         ; ------------------------------------------------------------
CF0E                  (    forth6809.asm):02217         FLUSHOUTBUFFER:
CF0E F6017A           (    forth6809.asm):02218                     LDB   OUTTAIL
CF11 F10179           (    forth6809.asm):02219                     CMPB  OUTHEAD           ; Is transmit buffer empty?
CF14 2719             (    forth6809.asm):02220                     BEQ   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):02221         
CF16 B6C008           (    forth6809.asm):02222                     LDA   ACIASR            ; Is transmission blocked by remote receiver?
CF19 8508             (    forth6809.asm):02223                     BITA  #SR_CTS
CF1B 2612             (    forth6809.asm):02224                     BNE   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):02225         
CF1D 8502             (    forth6809.asm):02226                     BITA  #SR_TDRE          ; Is transmit register empty?
CF1F 270E             (    forth6809.asm):02227                     BEQ   FLUSHED           ; No! Exit - try again next call rather
                      (    forth6809.asm):02228                                             ; than spin-wait here.
                      (    forth6809.asm):02229         
CF21 8E01C0           (    forth6809.asm):02230                     LDX   #OUTBUF           ; The out buffer is occupied.
CF24 A685             (    forth6809.asm):02231                     LDA   B,X               ; Get the character from the out buffer.
CF26 B7C009           (    forth6809.asm):02232                     STA   ACIADR            ; Transmit character.
                      (    forth6809.asm):02233         
CF29 5C               (    forth6809.asm):02234                     INCB                    ; Update tail pointer to next character slot.
CF2A C43F             (    forth6809.asm):02235                     ANDB  #OUTBUFSZ-1
CF2C F7017A           (    forth6809.asm):02236                     STB   OUTTAIL
                      (    forth6809.asm):02237                                             ; One character sent - return rather than
                      (    forth6809.asm):02238                                             ; loop back for more (see header comment).
CF2F                  (    forth6809.asm):02239         FLUSHED:
CF2F 39               (    forth6809.asm):02240                     RTS
                      (    forth6809.asm):02241         ; ------------------------------------------------------------
                      (    forth6809.asm):02242         ; Queue a character for transmission. The character is discarded
                      (    forth6809.asm):02243         ; if the output ring is full. Runs as a critical section.
                      (    forth6809.asm):02244         ; PUTCHAR
                      (    forth6809.asm):02245         ;    Inputs:
                      (    forth6809.asm):02246         ;        RegA = character to insert into transmit buffer
                      (    forth6809.asm):02247         ;    Outputs:
                      (    forth6809.asm):02248         ;        none
                      (    forth6809.asm):02249         ;    Registers: RegA and RegB changed; RegX and CC preserved.
                      (    forth6809.asm):02250         ; ------------------------------------------------------------
CF30                  (    forth6809.asm):02251         PUTCHAR:

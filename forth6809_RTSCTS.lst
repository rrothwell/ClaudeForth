                      (    forth6809.asm):04349         ; ============================================================
                      (    forth6809.asm):04350         ; SECTION 10: QUERY / ACCEPT / EXPECT / KEY / KEY? / EMIT
                      (    forth6809.asm):04351         ; ============================================================
                      (    forth6809.asm):04352                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):04353         ; Unused alternative to KEY removed; see shadow X_KEY.1.
                      (    forth6809.asm):04354         
                      (    forth6809.asm):04355         ; ------------------------------------------------------------
                      (    forth6809.asm):04356         ; KEY  ( -- char )
                      (    forth6809.asm):04357         ; Wait for the next received character and return it. While waiting,
                      (    forth6809.asm):04358         ; drain the output ring by polling if RTS is high.
                      (    forth6809.asm):04359         ; ------------------------------------------------------------
D98C                  (    forth6809.asm):04360         KEYW:
                      (    forth6809.asm):04361         
D98C 7D0178           (    forth6809.asm):04362                     TST   RTSSTATE          ; Is throttling?
D98F 2703             (    forth6809.asm):04363                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):04364         
                      (    forth6809.asm):04365                     ; IRQ stays unmasked during the flush. See bugfix: KEYW.1
D991 BDCF0E           (    forth6809.asm):04366                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):04367                                             ; by transmitting all chars.
                      (    forth6809.asm):04368         
D994                  (    forth6809.asm):04369         TRY_READ:
D994 BDCF7B           (    forth6809.asm):04370                     JSR   GETCHAR           ; Is char available in input buffer.
D997 25F3             (    forth6809.asm):04371                     BCS   KEYW              ; No? Try again to receive a char,
                      (    forth6809.asm):04372                                             ; while still transmitting!
                      (    forth6809.asm):04373         
D999 1F89             (    forth6809.asm):04374                     TFR   A,B               ; Move char result to Reg B (LSB of D)
D99B 4F               (    forth6809.asm):04375                     CLRA                    ; Clear MSB.
D99C 3606             (    forth6809.asm):04376                     PSHU  D                 ; char
                      (    forth6809.asm):04377         
D99E 39               (    forth6809.asm):04378                     RTS
                      (    forth6809.asm):04379         
                      (    forth6809.asm):04380         ; ------------------------------------------------------------
                      (    forth6809.asm):04381         ; KEY?  ( -- flag )
                      (    forth6809.asm):04382         ; Return true if a received character is waiting in the input ring.
                      (    forth6809.asm):04383         ; ------------------------------------------------------------
D99F                  (    forth6809.asm):04384         KEYQW:
                      (    forth6809.asm):04385                     ; Commented-out code moved to shadow: KEYQW.1
                      (    forth6809.asm):04386         
D99F B60176           (    forth6809.asm):04387                     LDA   INHEAD            ; Characters received?
D9A2 B10177           (    forth6809.asm):04388                     CMPA  INTAIL
                      (    forth6809.asm):04389         
                      (    forth6809.asm):04390                     ; Commented-out code moved to shadow: KEYQW.2
                      (    forth6809.asm):04391         
D9A5 2606             (    forth6809.asm):04392                     BNE   KQTRUE            ; Yes!
                      (    forth6809.asm):04393         
D9A7 CC0000           (    forth6809.asm):04394                     LDD   #FALSEV           ; No! Return false result.
D9AA 3606             (    forth6809.asm):04395                     PSHU  D                 ; flag = false
                      (    forth6809.asm):04396         
D9AC 39               (    forth6809.asm):04397                     RTS
                      (    forth6809.asm):04398         
D9AD                  (    forth6809.asm):04399         KQTRUE:
D9AD CCFFFF           (    forth6809.asm):04400                     LDD   #TRUEV            ; Yes! Return true result.
D9B0 3606             (    forth6809.asm):04401                     PSHU  D                 ; flag = true
D9B2 39               (    forth6809.asm):04402                     RTS
                      (    forth6809.asm):04403         
                      (    forth6809.asm):04404         ; Unused alternative to EMIT removed; see shadow X_EMIT.1.
                      (    forth6809.asm):04405         
                      (    forth6809.asm):04406         ; ------------------------------------------------------------
                      (    forth6809.asm):04407         ; EMIT  ( char -- )
                      (    forth6809.asm):04408         ; Transmit char through PUTCHAR (the output ring). The character is
                      (    forth6809.asm):04409         ; discarded if the ring is full.
                      (    forth6809.asm):04410         ; ------------------------------------------------------------
D9B3                  (    forth6809.asm):04411         EMITW:
D9B3 3706             (    forth6809.asm):04412                     PULU  D                 ; char
D9B5 1F98             (    forth6809.asm):04413                     TFR   B,A
D9B7 BDCF30           (    forth6809.asm):04414                     JSR   PUTCHAR           ; Transmit char.
D9BA 39               (    forth6809.asm):04415                     RTS
                      (    forth6809.asm):04416         
                      (    forth6809.asm):04417                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):04418         ; ------------------------------------------------------------
                      (    forth6809.asm):04419         ; KEY  ( -- char )  [polling build, SERIALPOLL=1]
                      (    forth6809.asm):04420         ; Wait for RDRF and return the received character. There are no ring
                      (    forth6809.asm):04421         ; buffers, interrupts or hardware handshaking in this build; ACCEPT
                      (    forth6809.asm):04422         ; uses software XON/XOFF instead. Framing, overrun and parity errors
                      (    forth6809.asm):04423         ; are counted in FECOUNT, OVRNCOUNT and PECOUNT, and POLLREADYCNT
                      (    forth6809.asm):04424         ; counts characters already waiting when KEY was called.
                      (    forth6809.asm):04425         ; Original comment: shadow KEYW.2. KEY?, EMIT, PUTXON and PUTXOFF
                      (    forth6809.asm):04426         ; follow.
                      (    forth6809.asm):04427         ; ------------------------------------------------------------
D9BB                  (    forth6809.asm):04428         KEYW:
                      (    forth6809.asm):04429                     LDA   ACIASR
                      (    forth6809.asm):04430                     BITA  #SR_RDRF
                      (    forth6809.asm):04431                     BEQ   KWAIT
                      (    forth6809.asm):04432                     INC   POLLREADYCNT      ; character was already queued when we
                      (    forth6809.asm):04433                     BRA   KGOTSTAT          ; came back to poll - didn't need to wait
D9BB                  (    forth6809.asm):04434         KWAIT:
D9BB                  (    forth6809.asm):04435         KSPIN:      LDA   ACIASR
                      (    forth6809.asm):04436                     BITA  #SR_RDRF
                      (    forth6809.asm):04437                     BEQ   KSPIN
D9BB                  (    forth6809.asm):04438         KGOTSTAT:                           ; A holds the status byte exactly as it was
                      (    forth6809.asm):04439                                             ; when RDRF first went true - check the
                      (    forth6809.asm):04440                                             ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):04441                                             ; read, since reading ACIADR below clears
                      (    forth6809.asm):04442                                             ; RDRF and the latched error bits together
                      (    forth6809.asm):04443                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):04444                     BEQ   KGETCH
                      (    forth6809.asm):04445                     BITA  #SR_FE
                      (    forth6809.asm):04446                     BEQ   KXFE
                      (    forth6809.asm):04447                     INC   FECOUNT
D9BB                  (    forth6809.asm):04448         KXFE:       BITA  #SR_OVRN
                      (    forth6809.asm):04449                     BEQ   KXOVRN
                      (    forth6809.asm):04450                     INC   OVRNCOUNT
D9BB                  (    forth6809.asm):04451         KXOVRN:     BITA  #SR_PE
                      (    forth6809.asm):04452                     BEQ   KGETCH
                      (    forth6809.asm):04453                     INC   PECOUNT
D9BB                  (    forth6809.asm):04454         KGETCH:     LDA   ACIADR
                      (    forth6809.asm):04455                     TFR   A,B
                      (    forth6809.asm):04456                     CLRA
                      (    forth6809.asm):04457                     PSHU  D                 ; char
                      (    forth6809.asm):04458                     RTS
                      (    forth6809.asm):04459         
                      (    forth6809.asm):04460         ; ------------------------------------------------------------
                      (    forth6809.asm):04461         ; Send the software flow-control character XOFF (PUTXOFF) or XON
                      (    forth6809.asm):04462         ; (PUTXON) straight to the ACIA, waiting for TDRE. The data stack is
                      (    forth6809.asm):04463         ; not touched, so ACCEPT can call these at any point.
                      (    forth6809.asm):04464         ; PUTXON / PUTXOFF
                      (    forth6809.asm):04465         ;    Inputs:
                      (    forth6809.asm):04466         ;        none
                      (    forth6809.asm):04467         ;    Outputs:
                      (    forth6809.asm):04468         ;        XON or XOFF transmitted
                      (    forth6809.asm):04469         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):04470         ; Original comment: shadow PUTXON.0.
                      (    forth6809.asm):04471         ; ------------------------------------------------------------
D9BB                  (    forth6809.asm):04472         PUTXOFF:    LDA   #XOFFCH
                      (    forth6809.asm):04473                     BRA   PUTXCH
D9BB                  (    forth6809.asm):04474         PUTXON:     LDA   #XONCH
D9BB                  (    forth6809.asm):04475         PUTXCH:     PSHS  A
D9BB                  (    forth6809.asm):04476         PXWT:       LDB   ACIASR
                      (    forth6809.asm):04477                     BITB  #SR_TDRE
                      (    forth6809.asm):04478                     BEQ   PXWT
                      (    forth6809.asm):04479                     PULS  A
                      (    forth6809.asm):04480                     STA   ACIADR
                      (    forth6809.asm):04481                     RTS
                      (    forth6809.asm):04482         
                      (    forth6809.asm):04483         ; ------------------------------------------------------------
                      (    forth6809.asm):04484         ; KEY?  ( -- flag )  [polling build]
                      (    forth6809.asm):04485         ; Return true if the ACIA has a received character (RDRF set).
                      (    forth6809.asm):04486         ; ------------------------------------------------------------
D9BB                  (    forth6809.asm):04487         KEYQW:      LDA   ACIASR
                      (    forth6809.asm):04488                     BITA  #SR_RDRF
                      (    forth6809.asm):04489                     BEQ   KQFALSE
                      (    forth6809.asm):04490                     LDD   #TRUEV
                      (    forth6809.asm):04491                     PSHU  D                 ; flag = true
                      (    forth6809.asm):04492                     RTS
D9BB                  (    forth6809.asm):04493         KQFALSE:    LDD   #FALSEV
                      (    forth6809.asm):04494                     PSHU  D                 ; flag = false
                      (    forth6809.asm):04495                     RTS
                      (    forth6809.asm):04496         
                      (    forth6809.asm):04497         ; ------------------------------------------------------------
                      (    forth6809.asm):04498         ; EMIT  ( char -- )  [polling build]
                      (    forth6809.asm):04499         ; Wait for TDRE, then transmit char directly.
                      (    forth6809.asm):04500         ; ------------------------------------------------------------
D9BB                  (    forth6809.asm):04501         EMITW:      PULU  D                 ; char
                      (    forth6809.asm):04502                     STB   EMITCH
D9BB                  (    forth6809.asm):04503         EMITWT:     LDA   ACIASR
                      (    forth6809.asm):04504                     BITA  #SR_TDRE
                      (    forth6809.asm):04505                     BEQ   EMITWT
                      (    forth6809.asm):04506                     LDA   EMITCH
                      (    forth6809.asm):04507                     STA   ACIADR
                      (    forth6809.asm):04508                     RTS
                      (    forth6809.asm):04509         
                      (    forth6809.asm):04510                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):04511         
                      (    forth6809.asm):04512         ; ------------------------------------------------------------
                      (    forth6809.asm):04513         ; ACCEPT  ( c-addr +n1 -- +n2 )
                      (    forth6809.asm):04514         ; Read a line of up to +n1 characters into the buffer at c-addr,
                      (    forth6809.asm):04515         ; echoing as it goes. Backspace and DEL erase the last character; LF
                      (    forth6809.asm):04516         ; is ignored; CR ends the line. Returns the count +n2.
                      (    forth6809.asm):04517         ; ------------------------------------------------------------
D9BB 335E             (    forth6809.asm):04518         ACCEPTW:    LEAU  -2,U              ; local count at 0,U; then +n1 at 2,U and
D9BD CC0000           (    forth6809.asm):04519                     LDD   #0                ; c-addr at 4,U. See shadow ACCEPTW.5
D9C0 EDC4             (    forth6809.asm):04520                     STD   ,U
                      (    forth6809.asm):04521         
                      (    forth6809.asm):04522                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: real
                      (    forth6809.asm):04523                                             ; RTS/CTS hardware flow control already
                      (    forth6809.asm):04524                                             ; covers this, nothing extra needed
                      (    forth6809.asm):04525                     ELSE                    ; <<<<<>>>>>  polling build: tell the host it's safe to
                      (    forth6809.asm):04526                                             ; stream this line's characters
                      (    forth6809.asm):04527                     JSR   PUTXON
                      (    forth6809.asm):04528                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):04529         

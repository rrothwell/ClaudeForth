E789 2709             (    forth6809.asm):04906                     BEQ   DTEXIT
E78B 3510             (    forth6809.asm):04907                     PULS  X                 ; X = branch operand address
E78D EC84             (    forth6809.asm):04908                     LDD   ,X
E78F 308B             (    forth6809.asm):04909                     LEAX  D,X

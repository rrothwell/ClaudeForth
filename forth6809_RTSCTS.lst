E03F 3606             (    forth6809.asm):05875                     PSHU  D
E041 39               (    forth6809.asm):05876                     RTS
                      (    forth6809.asm):05877         
                      (    forth6809.asm):05878         ; ------------------------------------------------------------
                      (    forth6809.asm):05879         ; ROLL  ( xu xu-1 ... x0 u -- xu-1 ... x0 xu )
                      (    forth6809.asm):05880         ; Move the cell u deep (0 ROLL does nothing) to the top, shifting the
                      (    forth6809.asm):05881         ; cells above it down one place. RDST holds the byte offset and RVAL
                      (    forth6809.asm):05882         ; the cell being moved.
                      (    forth6809.asm):05883         ; ------------------------------------------------------------
E042 ECC1             (    forth6809.asm):05884         ROLLW:      LDD   ,U++              ; u (LDD sets CC; PULU would not). See
E044 2718             (    forth6809.asm):05885                     BEQ   ROLLDONE          ; bugfix: ROLLW.1
E046 1F02             (    forth6809.asm):05886                     TFR   D,Y               ; Y = cells to shift
E048 58               (    forth6809.asm):05887                     LSLB
E049 49               (    forth6809.asm):05888                     ROLA

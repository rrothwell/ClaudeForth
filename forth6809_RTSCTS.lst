DFCF 39               (    forth6809.asm):03166                     RTS
                      (    forth6809.asm):03167         
                      (    forth6809.asm):03168         ; ------------------------------------------------------------
                      (    forth6809.asm):03169         ; DEFER!  ( xt2 xt1 -- )
                      (    forth6809.asm):03170         ; Store xt2 as the action of the deferred word xt1.
                      (    forth6809.asm):03171         ; ------------------------------------------------------------
DFD0                  (    forth6809.asm):03172         DEFERSTOREW:
DFD0 BDEA3E           (    forth6809.asm):03173                     JSR   TOBODYW
DFD3 3710             (    forth6809.asm):03174                     PULU  X                 ; body address of xt1
DFD5 3706             (    forth6809.asm):03175                     PULU  D                 ; xt2
DFD7 ED84             (    forth6809.asm):03176                     STD   ,X
DFD9 39               (    forth6809.asm):03177                     RTS
                      (    forth6809.asm):03178         
                      (    forth6809.asm):03179         ; ------------------------------------------------------------
                      (    forth6809.asm):03180         ; IS  ( xt "name" -- )  IMMEDIATE
                      (    forth6809.asm):03181         ; Store xt as the action of the named deferred word. When compiling,
                      (    forth6809.asm):03182         ; compile code to do so at run time. Error -13 if the name is not
                      (    forth6809.asm):03183         ; found.
                      (    forth6809.asm):03184         ; ------------------------------------------------------------
DFDA CC0020           (    forth6809.asm):03185         ISW:        LDD   #32
DFDD 3606             (    forth6809.asm):03186                     PSHU  D

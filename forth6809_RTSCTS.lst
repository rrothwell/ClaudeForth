                      (    forth6809.asm):04648         ; ------------------------------------------------------------
                      (    forth6809.asm):04649         ; '  ( "name" -- xt )
                      (    forth6809.asm):04650         ; Parse the next blank-delimited name and return its xt. THROW -13 if
                      (    forth6809.asm):04651         ; the name is not found.
                      (    forth6809.asm):04652         ; ------------------------------------------------------------
E97B CC0020           (    forth6809.asm):04653         TICKW:      LDD   #32

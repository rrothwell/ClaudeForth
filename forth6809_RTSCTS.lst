E44D 39               (    forth6809.asm):03980                     RTS
                      (    forth6809.asm):03981         
                      (    forth6809.asm):03982         ; ============================================================
                      (    forth6809.asm):03983         ; SECTION 10: QUERY / ACCEPT / EXPECT / KEY / KEY? / EMIT
                      (    forth6809.asm):03984         ; ============================================================
                      (    forth6809.asm):03985                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):03986         ; Unused alternative to KEY removed; see shadow X_KEY.1.
                      (    forth6809.asm):03987         
                      (    forth6809.asm):03988         ; ------------------------------------------------------------
                      (    forth6809.asm):03989         ; KEY  ( -- char )
                      (    forth6809.asm):03990         ; Wait for the next received character and return it. While waiting,
                      (    forth6809.asm):03991         ; drain the output ring by polling if RTS is high.
                      (    forth6809.asm):03992         ; ------------------------------------------------------------
E44E                  (    forth6809.asm):03993         KEYW:
                      (    forth6809.asm):03994         
E44E 7D0178           (    forth6809.asm):03995                     TST   RTSSTATE          ; Is throttling?
E451 2703             (    forth6809.asm):03996                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):03997         
                      (    forth6809.asm):03998                     ; IRQ stays unmasked during the flush. See bugfix: KEYW.1
E453 BDDABE           (    forth6809.asm):03999                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):04000                                             ; by transmitting all chars.
                      (    forth6809.asm):04001         
E456                  (    forth6809.asm):04002         TRY_READ:
E456 BDDB2B           (    forth6809.asm):04003                     JSR   GETCHAR           ; Is char available in input buffer.
E459 25F3             (    forth6809.asm):04004                     BCS   KEYW              ; No? Try again to receive a char,
                      (    forth6809.asm):04005                                             ; while still transmitting!
                      (    forth6809.asm):04006         
E45B 1F89             (    forth6809.asm):04007                     TFR   A,B               ; Move char result to Reg B (LSB of D)
E45D 4F               (    forth6809.asm):04008                     CLRA                    ; Clear MSB.
E45E 3606             (    forth6809.asm):04009                     PSHU  D                 ; char
                      (    forth6809.asm):04010         
E460 39               (    forth6809.asm):04011                     RTS
                      (    forth6809.asm):04012         
                      (    forth6809.asm):04013         ; ------------------------------------------------------------
                      (    forth6809.asm):04014         ; KEY?  ( -- flag )
                      (    forth6809.asm):04015         ; Return true if a received character is waiting in the input ring.
                      (    forth6809.asm):04016         ; ------------------------------------------------------------
E461                  (    forth6809.asm):04017         KEYQW:
                      (    forth6809.asm):04018                     ; Commented-out code moved to shadow: KEYQW.1
                      (    forth6809.asm):04019         
E461 B60176           (    forth6809.asm):04020                     LDA   INHEAD            ; Characters received?
E464 B10177           (    forth6809.asm):04021                     CMPA  INTAIL
                      (    forth6809.asm):04022         
                      (    forth6809.asm):04023                     ; Commented-out code moved to shadow: KEYQW.2
                      (    forth6809.asm):04024         
E467 2606             (    forth6809.asm):04025                     BNE   KQTRUE            ; Yes!
                      (    forth6809.asm):04026         
E469 CC0000           (    forth6809.asm):04027                     LDD   #FALSEV           ; No! Return false result.
E46C 3606             (    forth6809.asm):04028                     PSHU  D                 ; flag = false
                      (    forth6809.asm):04029         
E46E 39               (    forth6809.asm):04030                     RTS
                      (    forth6809.asm):04031         
E46F                  (    forth6809.asm):04032         KQTRUE:
E46F CCFFFF           (    forth6809.asm):04033                     LDD   #TRUEV            ; Yes! Return true result.
E472 3606             (    forth6809.asm):04034                     PSHU  D                 ; flag = true
E474 39               (    forth6809.asm):04035                     RTS
                      (    forth6809.asm):04036         
                      (    forth6809.asm):04037         ; Unused alternative to EMIT removed; see shadow X_EMIT.1.
                      (    forth6809.asm):04038         
                      (    forth6809.asm):04039         ; ------------------------------------------------------------
                      (    forth6809.asm):04040         ; EMIT  ( char -- )
                      (    forth6809.asm):04041         ; Transmit char through PUTCHAR (the output ring). The character is
                      (    forth6809.asm):04042         ; discarded if the ring is full.
                      (    forth6809.asm):04043         ; ------------------------------------------------------------
E475                  (    forth6809.asm):04044         EMITW:
E475 3706             (    forth6809.asm):04045                     PULU  D                 ; char
E477 1F98             (    forth6809.asm):04046                     TFR   B,A
E479 BDDAE0           (    forth6809.asm):04047                     JSR   PUTCHAR           ; Transmit char.
E47C 39               (    forth6809.asm):04048                     RTS
                      (    forth6809.asm):04049         
                      (    forth6809.asm):04050                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):04051         ; ------------------------------------------------------------
                      (    forth6809.asm):04052         ; KEY  ( -- char )  [polling build, SERIALPOLL=1]
                      (    forth6809.asm):04053         ; Wait for RDRF and return the received character. There are no ring
                      (    forth6809.asm):04054         ; buffers, interrupts or hardware handshaking in this build; ACCEPT
                      (    forth6809.asm):04055         ; uses software XON/XOFF instead. Framing, overrun and parity errors
                      (    forth6809.asm):04056         ; are counted in FECOUNT, OVRNCOUNT and PECOUNT, and POLLREADYCNT
                      (    forth6809.asm):04057         ; counts characters already waiting when KEY was called.
                      (    forth6809.asm):04058         ; Original comment: shadow KEYW.2. KEY?, EMIT, PUTXON and PUTXOFF
                      (    forth6809.asm):04059         ; follow.
                      (    forth6809.asm):04060         ; ------------------------------------------------------------
E47D                  (    forth6809.asm):04061         KEYW:
                      (    forth6809.asm):04062                     LDA   ACIASR
                      (    forth6809.asm):04063                     BITA  #SR_RDRF
                      (    forth6809.asm):04064                     BEQ   KWAIT
                      (    forth6809.asm):04065                     INC   POLLREADYCNT      ; character was already queued when we
                      (    forth6809.asm):04066                     BRA   KGOTSTAT          ; came back to poll - didn't need to wait
E47D                  (    forth6809.asm):04067         KWAIT:
E47D                  (    forth6809.asm):04068         KSPIN:      LDA   ACIASR
                      (    forth6809.asm):04069                     BITA  #SR_RDRF
                      (    forth6809.asm):04070                     BEQ   KSPIN
E47D                  (    forth6809.asm):04071         KGOTSTAT:                           ; A holds the status byte exactly as it was
                      (    forth6809.asm):04072                                             ; when RDRF first went true - check the
                      (    forth6809.asm):04073                                             ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):04074                                             ; read, since reading ACIADR below clears
                      (    forth6809.asm):04075                                             ; RDRF and the latched error bits together
                      (    forth6809.asm):04076                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):04077                     BEQ   KGETCH
                      (    forth6809.asm):04078                     BITA  #SR_FE
                      (    forth6809.asm):04079                     BEQ   KXFE
                      (    forth6809.asm):04080                     INC   FECOUNT
E47D                  (    forth6809.asm):04081         KXFE:       BITA  #SR_OVRN
                      (    forth6809.asm):04082                     BEQ   KXOVRN
                      (    forth6809.asm):04083                     INC   OVRNCOUNT
E47D                  (    forth6809.asm):04084         KXOVRN:     BITA  #SR_PE
                      (    forth6809.asm):04085                     BEQ   KGETCH
                      (    forth6809.asm):04086                     INC   PECOUNT
E47D                  (    forth6809.asm):04087         KGETCH:     LDA   ACIADR
                      (    forth6809.asm):04088                     TFR   A,B
                      (    forth6809.asm):04089                     CLRA
                      (    forth6809.asm):04090                     PSHU  D                 ; char
                      (    forth6809.asm):04091                     RTS
                      (    forth6809.asm):04092         
                      (    forth6809.asm):04093         ; ------------------------------------------------------------
                      (    forth6809.asm):04094         ; Send the software flow-control character XOFF (PUTXOFF) or XON
                      (    forth6809.asm):04095         ; (PUTXON) straight to the ACIA, waiting for TDRE. The data stack is
                      (    forth6809.asm):04096         ; not touched, so ACCEPT can call these at any point.
                      (    forth6809.asm):04097         ; PUTXON / PUTXOFF
                      (    forth6809.asm):04098         ;    Inputs:
                      (    forth6809.asm):04099         ;        none
                      (    forth6809.asm):04100         ;    Outputs:
                      (    forth6809.asm):04101         ;        XON or XOFF transmitted
                      (    forth6809.asm):04102         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):04103         ; Original comment: shadow PUTXON.0.
                      (    forth6809.asm):04104         ; ------------------------------------------------------------
E47D                  (    forth6809.asm):04105         PUTXOFF:    LDA   #XOFFCH
                      (    forth6809.asm):04106                     BRA   PUTXCH
E47D                  (    forth6809.asm):04107         PUTXON:     LDA   #XONCH
E47D                  (    forth6809.asm):04108         PUTXCH:     PSHS  A
E47D                  (    forth6809.asm):04109         PXWT:       LDB   ACIASR
                      (    forth6809.asm):04110                     BITB  #SR_TDRE
                      (    forth6809.asm):04111                     BEQ   PXWT
                      (    forth6809.asm):04112                     PULS  A
                      (    forth6809.asm):04113                     STA   ACIADR
                      (    forth6809.asm):04114                     RTS
                      (    forth6809.asm):04115         
                      (    forth6809.asm):04116         ; ------------------------------------------------------------
                      (    forth6809.asm):04117         ; KEY?  ( -- flag )  [polling build]
                      (    forth6809.asm):04118         ; Return true if the ACIA has a received character (RDRF set).
                      (    forth6809.asm):04119         ; ------------------------------------------------------------
E47D                  (    forth6809.asm):04120         KEYQW:      LDA   ACIASR
                      (    forth6809.asm):04121                     BITA  #SR_RDRF
                      (    forth6809.asm):04122                     BEQ   KQFALSE
                      (    forth6809.asm):04123                     LDD   #TRUEV
                      (    forth6809.asm):04124                     PSHU  D                 ; flag = true
                      (    forth6809.asm):04125                     RTS
E47D                  (    forth6809.asm):04126         KQFALSE:    LDD   #FALSEV
                      (    forth6809.asm):04127                     PSHU  D                 ; flag = false
                      (    forth6809.asm):04128                     RTS
                      (    forth6809.asm):04129         
                      (    forth6809.asm):04130         ; ------------------------------------------------------------
                      (    forth6809.asm):04131         ; EMIT  ( char -- )  [polling build]
                      (    forth6809.asm):04132         ; Wait for TDRE, then transmit char directly.
                      (    forth6809.asm):04133         ; ------------------------------------------------------------
E47D                  (    forth6809.asm):04134         EMITW:      PULU  D                 ; char
                      (    forth6809.asm):04135                     STB   EMITCH
E47D                  (    forth6809.asm):04136         EMITWT:     LDA   ACIASR
                      (    forth6809.asm):04137                     BITA  #SR_TDRE
                      (    forth6809.asm):04138                     BEQ   EMITWT
                      (    forth6809.asm):04139                     LDA   EMITCH
                      (    forth6809.asm):04140                     STA   ACIADR
                      (    forth6809.asm):04141                     RTS
                      (    forth6809.asm):04142         
                      (    forth6809.asm):04143                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):04144         
                      (    forth6809.asm):04145         ; ------------------------------------------------------------
                      (    forth6809.asm):04146         ; ACCEPT  ( c-addr +n1 -- +n2 )
                      (    forth6809.asm):04147         ; Read a line of up to +n1 characters into the buffer at c-addr,
                      (    forth6809.asm):04148         ; echoing as it goes. Backspace and DEL erase the last character; LF
                      (    forth6809.asm):04149         ; is ignored; CR ends the line. Returns the count +n2.
                      (    forth6809.asm):04150         ; ------------------------------------------------------------
E47D 335E             (    forth6809.asm):04151         ACCEPTW:    LEAU  -2,U              ; local count at 0,U; then +n1 at 2,U and
E47F CC0000           (    forth6809.asm):04152                     LDD   #0                ; c-addr at 4,U. See shadow ACCEPTW.5
E482 EDC4             (    forth6809.asm):04153                     STD   ,U
                      (    forth6809.asm):04154         
                      (    forth6809.asm):04155                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: real
                      (    forth6809.asm):04156                                             ; RTS/CTS hardware flow control already
                      (    forth6809.asm):04157                                             ; covers this, nothing extra needed
                      (    forth6809.asm):04158                     ELSE                    ; <<<<<>>>>>  polling build: tell the host it's safe to
                      (    forth6809.asm):04159                                             ; stream this line's characters
                      (    forth6809.asm):04160                     JSR   PUTXON
                      (    forth6809.asm):04161                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):04162         
E484 BDE44E           (    forth6809.asm):04163         ALOOP:      JSR   KEYW
E487 3706             (    forth6809.asm):04164                     PULU  D
E489 1F02             (    forth6809.asm):04165                     TFR   D,Y               ; Y = the character
                      (    forth6809.asm):04166         
E48B C10D             (    forth6809.asm):04167                     CMPB  #13
E48D 274F             (    forth6809.asm):04168                     BEQ   ADONE
E48F C10A             (    forth6809.asm):04169                     CMPB  #10

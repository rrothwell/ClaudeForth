DFC4 3342             (    forth6809.asm):05749         DROPW:      LEAU  2,U               ; x
DFC6 39               (    forth6809.asm):05750                     RTS
                      (    forth6809.asm):05751         
                      (    forth6809.asm):05752         ; ------------------------------------------------------------
                      (    forth6809.asm):05753         ; SWAP  ( x1 x2 -- x2 x1 )

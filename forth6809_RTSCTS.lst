                      (    forth6809.asm):06607         ; ------------------------------------------------------------
F366 3710             (    forth6809.asm):06608         PLUSSTOREW: PULU  X                 ; a-addr
F368 3706             (    forth6809.asm):06609                     PULU  D                 ; n
F36A E384             (    forth6809.asm):06610                     ADDD  ,X
F36C ED84             (    forth6809.asm):06611                     STD   ,X
F36E 39               (    forth6809.asm):06612                     RTS
                      (    forth6809.asm):06613         
                      (    forth6809.asm):06614         ; ------------------------------------------------------------
                      (    forth6809.asm):06615         ; 2@  ( a-addr -- x1 x2 )

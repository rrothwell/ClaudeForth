                      (    forth6809.asm):09397         ; ------------------------------------------------------------
                      (    forth6809.asm):09398         ; [IF]  ( flag -- )     [ELSE]  ( -- )     [THEN]  ( -- )
                      (    forth6809.asm):09399         ; Programming-Tools conditional compilation. All three are
                      (    forth6809.asm):09400         ; immediate, so they work while interpreting and while compiling.
                      (    forth6809.asm):09401         ; [IF] with a true flag does nothing. With a false flag, and for
                      (    forth6809.asm):09402         ; [ELSE], the input is skipped word by word, counting nested
                      (    forth6809.asm):09403         ; [IF]s, up to the matching [ELSE] or [THEN]. The three names are
                      (    forth6809.asm):09404         ; matched exactly, as the dictionary matches every name. If the line
                      (    forth6809.asm):09405         ; runs out, the next line is read with REFILL; if no more input is
                      (    forth6809.asm):09406         ; available the skip ends.
                      (    forth6809.asm):09407         ; [THEN] is a marker and does nothing when it is executed.
                      (    forth6809.asm):09408         ; The nesting level is kept at 0,S.
                      (    forth6809.asm):09409         ; ------------------------------------------------------------
F450 3706             (    forth6809.asm):09410         BRIFW:      PULU  D
F452 10830000         (    forth6809.asm):09411                     CMPD  #0
F456 266D             (    forth6809.asm):09412                     BNE   BRTHENW           ; true: nothing to skip
F458 CC0001           (    forth6809.asm):09413         BRELSEW:    LDD   #1
F45B 3406             (    forth6809.asm):09414                     PSHS  D                 ; level
F45D BDEAF9           (    forth6809.asm):09415         BRNEXT:     JSR   PARSENAMEW
F460 3706             (    forth6809.asm):09416                     PULU  D                 ; length
F462 3710             (    forth6809.asm):09417                     PULU  X                 ; address
F464 10830000         (    forth6809.asm):09418                     CMPD  #0
F468 274E             (    forth6809.asm):09419                     BEQ   BRREFILL
F46A 10830004         (    forth6809.asm):09420                     CMPD  #4
F46E 2734             (    forth6809.asm):09421                     BEQ   BR4
F470 10830006         (    forth6809.asm):09422                     CMPD  #6
F474 26E7             (    forth6809.asm):09423                     BNE   BRNEXT
F476 C606             (    forth6809.asm):09424                     LDB   #6
F478 108EF4D4         (    forth6809.asm):09425                     LDY   #BRSELSE
F47C 3410             (    forth6809.asm):09426                     PSHS  X
F47E BDF4C6           (    forth6809.asm):09427                     JSR   BRCMP
F481 3510             (    forth6809.asm):09428                     PULS  X
F483 2609             (    forth6809.asm):09429                     BNE   BR6B
F485 ECE4             (    forth6809.asm):09430                     LDD   ,S                ; [ELSE]: ends the skip at level 1
F487 830001           (    forth6809.asm):09431                     SUBD  #1
F48A 2737             (    forth6809.asm):09432                     BEQ   BRDONE
F48C 20CF             (    forth6809.asm):09433                     BRA   BRNEXT
F48E C606             (    forth6809.asm):09434         BR6B:       LDB   #6
F490 108EF4DA         (    forth6809.asm):09435                     LDY   #BRSTHEN
F494 BDF4C6           (    forth6809.asm):09436                     JSR   BRCMP
F497 26C4             (    forth6809.asm):09437                     BNE   BRNEXT
F499 ECE4             (    forth6809.asm):09438                     LDD   ,S                ; [THEN]: one level less
F49B 830001           (    forth6809.asm):09439                     SUBD  #1
F49E EDE4             (    forth6809.asm):09440                     STD   ,S
F4A0 2721             (    forth6809.asm):09441                     BEQ   BRDONE
F4A2 20B9             (    forth6809.asm):09442                     BRA   BRNEXT
F4A4 C604             (    forth6809.asm):09443         BR4:        LDB   #4
F4A6 108EF4D0         (    forth6809.asm):09444                     LDY   #BRSIF
F4AA BDF4C6           (    forth6809.asm):09445                     JSR   BRCMP
F4AD 26AE             (    forth6809.asm):09446                     BNE   BRNEXT
F4AF ECE4             (    forth6809.asm):09447                     LDD   ,S                ; [IF]: one level more
F4B1 C30001           (    forth6809.asm):09448                     ADDD  #1
F4B4 EDE4             (    forth6809.asm):09449                     STD   ,S
F4B6 20A5             (    forth6809.asm):09450                     BRA   BRNEXT
F4B8 BDF10B           (    forth6809.asm):09451         BRREFILL:   JSR   REFILLW
F4BB 3706             (    forth6809.asm):09452                     PULU  D
F4BD 10830000         (    forth6809.asm):09453                     CMPD  #0
F4C1 269A             (    forth6809.asm):09454                     BNE   BRNEXT
F4C3 3262             (    forth6809.asm):09455         BRDONE:     LEAS  2,S
F4C5 39               (    forth6809.asm):09456         BRTHENW:    RTS
                      (    forth6809.asm):09457         
                      (    forth6809.asm):09458         ; Compare B characters at X with the pattern at Y. Case matters, as it
                      (    forth6809.asm):09459         ; does for every name in this system. Z is set if equal.
F4C6 A680             (    forth6809.asm):09460         BRCMP:      LDA   ,X+
F4C8 A1A0             (    forth6809.asm):09461                     CMPA  ,Y+
F4CA 2603             (    forth6809.asm):09462                     BNE   BRCX
F4CC 5A               (    forth6809.asm):09463                     DECB
F4CD 26F7             (    forth6809.asm):09464                     BNE   BRCMP
F4CF 39               (    forth6809.asm):09465         BRCX:       RTS
                      (    forth6809.asm):09466         
F4D0 5B49465D         (    forth6809.asm):09467         BRSIF:      FCC   "[IF]"
F4D4 5B454C53455D     (    forth6809.asm):09468         BRSELSE:    FCC   "[ELSE]"
F4DA 5B5448454E5D     (    forth6809.asm):09469         BRSTHEN:    FCC   "[THEN]"
                      (    forth6809.asm):09470         
                      (    forth6809.asm):09471         ; ============================================================
                      (    forth6809.asm):09472         ; SECTION 26: CONSTANT-VALUE WORDS (TRUE, FALSE, 1, -1, 2, -2)
                      (    forth6809.asm):09473         ; ============================================================
                      (    forth6809.asm):09474         ; ------------------------------------------------------------
                      (    forth6809.asm):09475         ; TRUE  ( -- flag )
                      (    forth6809.asm):09476         ; Push true ($FFFF), the value of TRUEV. A direct LDD/PSHU/RTS: no
                      (    forth6809.asm):09477         ; DODOES trampoline and no value cell.
                      (    forth6809.asm):09478         ; Original comment: shadow TRUEW.0.
                      (    forth6809.asm):09479         ; ------------------------------------------------------------
F4E0 CCFFFF           (    forth6809.asm):09480         TRUEW:      LDD   #$FFFF
F4E3 3606             (    forth6809.asm):09481                     PSHU  D
F4E5 39               (    forth6809.asm):09482                     RTS
                      (    forth6809.asm):09483         
                      (    forth6809.asm):09484         ; ------------------------------------------------------------
                      (    forth6809.asm):09485         ; FALSE  ( -- flag )
                      (    forth6809.asm):09486         ; Push false ($0000), the value of FALSEV.
                      (    forth6809.asm):09487         ; ------------------------------------------------------------
F4E6 CC0000           (    forth6809.asm):09488         FALSEW:     LDD   #$0000
F4E9 3606             (    forth6809.asm):09489                     PSHU  D
F4EB 39               (    forth6809.asm):09490                     RTS
                      (    forth6809.asm):09491         
                      (    forth6809.asm):09492         ; ------------------------------------------------------------
                      (    forth6809.asm):09493         ; 1  ( -- 1 )
                      (    forth6809.asm):09494         ; Push the constant 1. The words -1, 2 and -2 below work the same way.
                      (    forth6809.asm):09495         ; Their headers are H_POSONE, H_NEGONE, H_POSTWO and H_NEGTWO (Section
                      (    forth6809.asm):09496         ; 27), since "1" and "-1" are not valid assembler labels.
                      (    forth6809.asm):09497         ; Original comment: shadow POSONEW.0.
                      (    forth6809.asm):09498         ; ------------------------------------------------------------
F4EC CC0001           (    forth6809.asm):09499         POSONEW:    LDD   #1
F4EF 3606             (    forth6809.asm):09500                     PSHU  D
F4F1 39               (    forth6809.asm):09501                     RTS
                      (    forth6809.asm):09502         
                      (    forth6809.asm):09503         ; ------------------------------------------------------------
                      (    forth6809.asm):09504         ; -1  ( -- -1 )
                      (    forth6809.asm):09505         ; Push the constant -1.
                      (    forth6809.asm):09506         ; ------------------------------------------------------------
F4F2 CCFFFF           (    forth6809.asm):09507         NEGONEW:    LDD   #-1
F4F5 3606             (    forth6809.asm):09508                     PSHU  D
F4F7 39               (    forth6809.asm):09509                     RTS
                      (    forth6809.asm):09510         
                      (    forth6809.asm):09511         ; ------------------------------------------------------------
                      (    forth6809.asm):09512         ; 2  ( -- 2 )

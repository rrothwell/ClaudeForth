                      (    forth6809.asm):09099         ; WARM
                      (    forth6809.asm):09100         ;    Inputs:
                      (    forth6809.asm):09101         ;        NMI
                      (    forth6809.asm):09102         ;    Outputs:
                      (    forth6809.asm):09103         ;        does not return
                      (    forth6809.asm):09104         ;    Registers: all registers initialised.
                      (    forth6809.asm):09105         ; ------------------------------------------------------------

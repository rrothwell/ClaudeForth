FC78 EC84             (    forth6809.asm):08807         ENV2LOOP:   LDD   ,X
FC7A 10830000         (    forth6809.asm):08808                     CMPD  #0
FC7E 2731             (    forth6809.asm):08809                     BEQ   ENVNOTFOUND
FC80 3410             (    forth6809.asm):08810                     PSHS  X                 ; See bugfix: ENVQW.2
FC82 3606             (    forth6809.asm):08811                     PSHU  D
FC84 EC02             (    forth6809.asm):08812                     LDD   2,X
FC86 3606             (    forth6809.asm):08813                     PSHU  D
FC88 EC62             (    forth6809.asm):08814                     LDD   2,S               ; c-addr
FC8A 3606             (    forth6809.asm):08815                     PSHU  D
FC8C EC64             (    forth6809.asm):08816                     LDD   4,S               ; u
FC8E 3606             (    forth6809.asm):08817                     PSHU  D
FC90 BDF681           (    forth6809.asm):08818                     JSR   COMPAREW
FC93 3510             (    forth6809.asm):08819                     PULS  X
FC95 3706             (    forth6809.asm):08820                     PULU  D
FC97 10830000         (    forth6809.asm):08821                     CMPD  #0
FC9B 2704             (    forth6809.asm):08822                     BEQ   ENV2FOUND
FC9D 3008             (    forth6809.asm):08823                     LEAX  8,X               ; 8-byte entries
FC9F 20D7             (    forth6809.asm):08824                     BRA   ENV2LOOP
FCA1 3264             (    forth6809.asm):08825         ENV2FOUND:  LEAS  4,S               ; drop frame
FCA3 EC04             (    forth6809.asm):08826                     LDD   4,X               ; low cell, pushed first
FCA5 3606             (    forth6809.asm):08827                     PSHU  D

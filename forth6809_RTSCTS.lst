                      (    forth6809.asm):05814         
                      (    forth6809.asm):05815         ; ------------------------------------------------------------
                      (    forth6809.asm):05816         ; MAX  ( n1 n2 -- n3 )
                      (    forth6809.asm):05817         ; The greater of two signed numbers.

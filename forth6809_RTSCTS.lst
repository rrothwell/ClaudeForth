D65E AE02             (    forth6809.asm):03731                     LDX   2,X               ; CFA field
D660 39               (    forth6809.asm):03732                     RTS
                      (    forth6809.asm):03733         
                      (    forth6809.asm):03734         ; ------------------------------------------------------------
                      (    forth6809.asm):03735         ; FIND  ( c-addr -- c-addr 0 | xt 1 | xt -1 )
                      (    forth6809.asm):03736         ; Look up the counted string in the search order, then in ROOT, ignoring
                      (    forth6809.asm):03737         ; smudged entries. Returns the xt and 1 if the word is immediate, or
                      (    forth6809.asm):03738         ; -1 if not. If not found, returns c-addr and 0.
                      (    forth6809.asm):03739         ; Holds no scratch cells; see shadow FINDW.1 and SEARCHORDER.1.
                      (    forth6809.asm):03740         ; ------------------------------------------------------------
D661 10AEC4           (    forth6809.asm):03741         FINDW:      LDY   ,U                ; counted string
D664 E6A0             (    forth6809.asm):03742                     LDB   ,Y+
D666 8DBF             (    forth6809.asm):03743                     BSR   SRCHORD
D668 8C0000           (    forth6809.asm):03744                     CMPX  #0
D66B 2712             (    forth6809.asm):03745                     BEQ   NOTFOUND
D66D 8DE6             (    forth6809.asm):03746                     BSR   HDRXT
D66F AFC4             (    forth6809.asm):03747                     STX   ,U                ; xt replaces c-addr
D671 4D               (    forth6809.asm):03748                     TSTA
D672 2A05             (    forth6809.asm):03749                     BPL   FISNORM
D674 CC0001           (    forth6809.asm):03750                     LDD   #1
D677 2003             (    forth6809.asm):03751                     BRA   FPUSH
D679 CCFFFF           (    forth6809.asm):03752         FISNORM:    LDD   #-1
D67C 3606             (    forth6809.asm):03753         FPUSH:      PSHU  D                 ; 1 = immediate, -1 = normal
D67E 39               (    forth6809.asm):03754                     RTS
                      (    forth6809.asm):03755         
D67F CC0000           (    forth6809.asm):03756         NOTFOUND:   LDD   #0
D682 3606             (    forth6809.asm):03757                     PSHU  D                 ; 0 = not found, c-addr still beneath
D684 39               (    forth6809.asm):03758                     RTS
                      (    forth6809.asm):03759         
                      (    forth6809.asm):03760         ; ------------------------------------------------------------
                      (    forth6809.asm):03761         ; SEARCH-WORDLIST  ( c-addr u wid -- 0 | xt 1 | xt -1 )
                      (    forth6809.asm):03762         ; Search the one wordlist wid for the name c-addr u. Returns 0 if it is
                      (    forth6809.asm):03763         ; not found, else its xt and 1 if the word is immediate or -1 if not.
                      (    forth6809.asm):03764         ; Throws -11 for an invalid wid.
                      (    forth6809.asm):03765         ; ------------------------------------------------------------
D685 3710             (    forth6809.asm):03766         SEARCHWLW:  PULU  X                 ; wid
D687 8D2D             (    forth6809.asm):03767                     BSR   WIDCHK
D689 AE84             (    forth6809.asm):03768                     LDX   ,X                ; newest header of the wordlist
D68B 3706             (    forth6809.asm):03769                     PULU  D                 ; u
D68D 3720             (    forth6809.asm):03770                     PULU  Y                 ; c-addr
D68F 4D               (    forth6809.asm):03771                     TSTA
D690 261E             (    forth6809.asm):03772                     BNE   SWNOT             ; longer than any name
D692 C11F             (    forth6809.asm):03773                     CMPB  #31
D694 221A             (    forth6809.asm):03774                     BHI   SWNOT
D696 BDD5EA           (    forth6809.asm):03775                     JSR   FDSEARCH
D699 8C0000           (    forth6809.asm):03776                     CMPX  #0
D69C 2712             (    forth6809.asm):03777                     BEQ   SWNOT
D69E 8DB5             (    forth6809.asm):03778                     BSR   HDRXT
D6A0 3610             (    forth6809.asm):03779                     PSHU  X                 ; xt
D6A2 4D               (    forth6809.asm):03780                     TSTA
D6A3 2A05             (    forth6809.asm):03781                     BPL   SWNORM
D6A5 CC0001           (    forth6809.asm):03782                     LDD   #1
D6A8 2003             (    forth6809.asm):03783                     BRA   SWPUSH
D6AA CCFFFF           (    forth6809.asm):03784         SWNORM:     LDD   #-1
D6AD 3606             (    forth6809.asm):03785         SWPUSH:     PSHU  D
D6AF 39               (    forth6809.asm):03786                     RTS
D6B0 CC0000           (    forth6809.asm):03787         SWNOT:      LDD   #0
D6B3 3606             (    forth6809.asm):03788                     PSHU  D
D6B5 39               (    forth6809.asm):03789                     RTS
                      (    forth6809.asm):03790         
                      (    forth6809.asm):03791         ; ------------------------------------------------------------
                      (    forth6809.asm):03792         ; Throw -11 unless RegX is the address of a wordlist cell in use.
                      (    forth6809.asm):03793         ; WIDCHK
                      (    forth6809.asm):03794         ;    Inputs:
                      (    forth6809.asm):03795         ;        RegX = candidate WID
                      (    forth6809.asm):03796         ;    Outputs:
                      (    forth6809.asm):03797         ;        none if valid (RegX and RegY unchanged); THROW -11 if not
                      (    forth6809.asm):03798         ;    Registers: RegD and CC changed.
                      (    forth6809.asm):03799         ; ------------------------------------------------------------
D6B6 1F10             (    forth6809.asm):03800         WIDCHK:     TFR   X,D
D6B8 83005B           (    forth6809.asm):03801                     SUBD  #WLHEADS
D6BB 2509             (    forth6809.asm):03802                     BCS   WIDBAD
D6BD C501             (    forth6809.asm):03803                     BITB  #1
D6BF 2605             (    forth6809.asm):03804                     BNE   WIDBAD
D6C1 9C45             (    forth6809.asm):03805                     CMPX  WLEND
D6C3 2401             (    forth6809.asm):03806                     BHS   WIDBAD
D6C5 39               (    forth6809.asm):03807                     RTS
D6C6 CCFFF5           (    forth6809.asm):03808         WIDBAD:     LDD   #-11
D6C9 3606             (    forth6809.asm):03809                     PSHU  D
D6CB 7EDA80           (    forth6809.asm):03810                     JMP   THROWW
                      (    forth6809.asm):03811         
                      (    forth6809.asm):03812         ; ------------------------------------------------------------
                      (    forth6809.asm):03813         ; Set the Search-Order state to its initial value: two wordlists
                      (    forth6809.asm):03814         ; (FORTH, holding the ROM dictionary, and ROOT), the search order
                      (    forth6809.asm):03815         ; FORTH, and CURRENT = FORTH.
                      (    forth6809.asm):03816         ; WLINIT
                      (    forth6809.asm):03817         ;    Inputs:
                      (    forth6809.asm):03818         ;        none
                      (    forth6809.asm):03819         ;    Outputs:
                      (    forth6809.asm):03820         ;        WLHEADS, WLNAMES (FORTH, ROOT), WLEND, CURRENT, ORDER, ORDEND set
                      (    forth6809.asm):03821         ;    Registers: RegD and CC changed.
                      (    forth6809.asm):03822         ; ------------------------------------------------------------
D6CE CCCE7A           (    forth6809.asm):03823         WLINIT:     LDD   #BASELATEST
D6D1 DD5B             (    forth6809.asm):03824                     STD   WLHEADS
D6D3 CCC579           (    forth6809.asm):03825                     LDD   #BASEROOTLATEST
D6D6 DD5D             (    forth6809.asm):03826                     STD   WLHEADS+2
D6D8 CCC579           (    forth6809.asm):03827                     LDD   #H_FORTH
D6DB DD6F             (    forth6809.asm):03828                     STD   WLNAMES
D6DD CCC570           (    forth6809.asm):03829                     LDD   #H_ROOT
D6E0 DD71             (    forth6809.asm):03830                     STD   WLNAMES+2
D6E2 CC005F           (    forth6809.asm):03831                     LDD   #WLHEADS+4
D6E5 DD45             (    forth6809.asm):03832                     STD   WLEND
D6E7 CC005B           (    forth6809.asm):03833                     LDD   #WLHEADS
D6EA DD47             (    forth6809.asm):03834                     STD   CURRENT
D6EC 7ED7BC           (    forth6809.asm):03835                     JMP   ONLYW             ; the order is FORTH only
                      (    forth6809.asm):03836         
                      (    forth6809.asm):03837         ; ------------------------------------------------------------
                      (    forth6809.asm):03838         ; Remove from every wordlist the RAM headers that are at or above a
                      (    forth6809.asm):03839         ; mark. Headers are allocated upwards from DPHERE, so these are the
                      (    forth6809.asm):03840         ; newest ones of each chain. ROM headers are never touched.
                      (    forth6809.asm):03841         ; PRUNE
                      (    forth6809.asm):03842         ;    Inputs:
                      (    forth6809.asm):03843         ;        RegD = mark (a DPHERE value)
                      (    forth6809.asm):03844         ;    Outputs:
                      (    forth6809.asm):03845         ;        the head of every wordlist in use points below the mark or
                      (    forth6809.asm):03846         ;        into ROM
                      (    forth6809.asm):03847         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):03848         ; ------------------------------------------------------------
D6EF 3406             (    forth6809.asm):03849         PRUNE:      PSHS  D                 ; 0,S = mark
D6F1 8E005B           (    forth6809.asm):03850                     LDX   #WLHEADS
D6F4 9C45             (    forth6809.asm):03851         PRLOOP:     CMPX  WLEND
D6F6 2421             (    forth6809.asm):03852                     BHS   PRNDONE
D6F8 10AE84           (    forth6809.asm):03853                     LDY   ,X                ; newest header of this wordlist
D6FB 108CC000         (    forth6809.asm):03854         PRWALK:     CMPY  #ROMSTRT
D6FF 2413             (    forth6809.asm):03855                     BHS   PRSTORE           ; ROM header: keep
D701 10ACE4           (    forth6809.asm):03856                     CMPY  ,S
D704 250E             (    forth6809.asm):03857                     BLO   PRSTORE           ; below the mark (or empty): keep
D706 E6A4             (    forth6809.asm):03858                     LDB   ,Y
D708 C41F             (    forth6809.asm):03859                     ANDB  #$1F
D70A 4F               (    forth6809.asm):03860                     CLRA
D70B 3121             (    forth6809.asm):03861                     LEAY  1,Y
D70D 31AB             (    forth6809.asm):03862                     LEAY  D,Y
D70F 10AEA4           (    forth6809.asm):03863                     LDY   ,Y                ; follow the LINK
D712 20E7             (    forth6809.asm):03864                     BRA   PRWALK
D714 10AF81           (    forth6809.asm):03865         PRSTORE:    STY   ,X++
D717 20DB             (    forth6809.asm):03866                     BRA   PRLOOP
D719 3262             (    forth6809.asm):03867         PRNDONE:     LEAS  2,S
D71B 39               (    forth6809.asm):03868                     RTS
                      (    forth6809.asm):03869         
                      (    forth6809.asm):03870         ; ============================================================
                      (    forth6809.asm):03871         ; SECTION 9A: SEARCH-ORDER WORD SET
                      (    forth6809.asm):03872         ; ============================================================
                      (    forth6809.asm):03873         ; ------------------------------------------------------------
                      (    forth6809.asm):03874         ; WORDLIST  ( -- wid )
                      (    forth6809.asm):03875         ; Create a new, empty wordlist. Throws -8 when all WLCELLS are in use.
                      (    forth6809.asm):03876         ; ------------------------------------------------------------
D71C 9E45             (    forth6809.asm):03877         WORDLISTW:  LDX   WLEND
D71E 8C006F           (    forth6809.asm):03878                     CMPX  #WLHEADS+2*WLCELLS
D721 240F             (    forth6809.asm):03879                     BHS   WLFULL
D723 CC0000           (    forth6809.asm):03880                     LDD   #0
D726 ED84             (    forth6809.asm):03881                     STD   ,X
D728 ED8814           (    forth6809.asm):03882                     STD   WLNOFF,X
D72B 3610             (    forth6809.asm):03883                     PSHU  X
D72D 3002             (    forth6809.asm):03884                     LEAX  2,X
D72F 9F45             (    forth6809.asm):03885                     STX   WLEND
D731 39               (    forth6809.asm):03886                     RTS
D732 CCFFF8           (    forth6809.asm):03887         WLFULL:     LDD   #-8
D735 3606             (    forth6809.asm):03888                     PSHU  D
D737 7EDA80           (    forth6809.asm):03889                     JMP   THROWW
                      (    forth6809.asm):03890         
                      (    forth6809.asm):03891         ; ------------------------------------------------------------
                      (    forth6809.asm):03892         ; FORTH-WORDLIST  ( -- wid )
                      (    forth6809.asm):03893         ; Push the WID of the wordlist holding the standard words.
                      (    forth6809.asm):03894         ; ------------------------------------------------------------
D73A CC005B           (    forth6809.asm):03895         FORTHWLW:   LDD   #WLHEADS
D73D 3606             (    forth6809.asm):03896                     PSHU  D
D73F 39               (    forth6809.asm):03897                     RTS
                      (    forth6809.asm):03898         
                      (    forth6809.asm):03899         ; ------------------------------------------------------------
                      (    forth6809.asm):03900         ; GET-ORDER  ( -- widn ... wid1 n )
                      (    forth6809.asm):03901         ; Return the search order: wid1 is searched first. ROOT is not part of
                      (    forth6809.asm):03902         ; it, as it is always searched last.
                      (    forth6809.asm):03903         ; ------------------------------------------------------------
D740 9E49             (    forth6809.asm):03904         GETORDERW:  LDX   ORDEND
D742 8C004B           (    forth6809.asm):03905         GOLOOP:     CMPX  #ORDER
D745 2306             (    forth6809.asm):03906                     BLS   GODONE
D747 EC83             (    forth6809.asm):03907                     LDD   ,--X
D749 3606             (    forth6809.asm):03908                     PSHU  D
D74B 20F5             (    forth6809.asm):03909                     BRA   GOLOOP
D74D DC49             (    forth6809.asm):03910         GODONE:     LDD   ORDEND
D74F 83004B           (    forth6809.asm):03911                     SUBD  #ORDER
D752 44               (    forth6809.asm):03912                     LSRA
D753 56               (    forth6809.asm):03913                     RORB
D754 3606             (    forth6809.asm):03914                     PSHU  D                 ; n
D756 39               (    forth6809.asm):03915                     RTS
                      (    forth6809.asm):03916         
                      (    forth6809.asm):03917         ; ------------------------------------------------------------
                      (    forth6809.asm):03918         ; SET-ORDER  ( widn ... wid1 n -- )
                      (    forth6809.asm):03919         ; Set the search order. n = -1 selects the minimum order (FORTH only).
                      (    forth6809.asm):03920         ; n = 0 empties it (ROOT can still be searched). Throws -49 when n is
                      (    forth6809.asm):03921         ; more than 8, -50 when n is less than -1 and -11 for an invalid wid.
                      (    forth6809.asm):03922         ; ------------------------------------------------------------
D757 3706             (    forth6809.asm):03923         SETORDERW:  PULU  D                 ; n
D759 1083FFFF         (    forth6809.asm):03924                     CMPD  #-1
D75D 275D             (    forth6809.asm):03925                     BEQ   ONLYW             ; the minimum order
D75F 4D               (    forth6809.asm):03926         SO1:        TSTA
D760 2B31             (    forth6809.asm):03927                     BMI   SOUNDER
D762 262A             (    forth6809.asm):03928                     BNE   SOOVER
D764 C108             (    forth6809.asm):03929                     CMPB  #WLMAX
D766 2226             (    forth6809.asm):03930                     BHI   SOOVER

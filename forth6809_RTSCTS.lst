EA10 3706             (    forth6809.asm):04757                     PULU  D
EA12 CCFFF3           (    forth6809.asm):04758                     LDD   #-13              ; -13
EA15 3606             (    forth6809.asm):04759                     PSHU  D
EA17 BDE561           (    forth6809.asm):04760                     JSR   THROWW
EA1A 10830001         (    forth6809.asm):04761         PPFOUND:    CMPD  #1                ; 1 = immediate
EA1E 270C             (    forth6809.asm):04762                     BEQ   PPIMM
EA20 BDE9A9           (    forth6809.asm):04763                     JSR   LITERALW
EA23 CCE999           (    forth6809.asm):04764                     LDD   #COMPILECOMMAW
EA26 3606             (    forth6809.asm):04765                     PSHU  D
EA28 BDE99C           (    forth6809.asm):04766                     JSR   CCALL

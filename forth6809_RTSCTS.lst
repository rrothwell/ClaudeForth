                      (    forth6809.asm):05551         ; ------------------------------------------------------------
                      (    forth6809.asm):05552         ; >BODY  ( xt -- a-addr )
                      (    forth6809.asm):05553         ; Return the data-field address of a CREATEd word: the cell at xt+5 of
                      (    forth6809.asm):05554         ; its JSR DODOES trampoline.
                      (    forth6809.asm):05555         ; ------------------------------------------------------------
DF7C 3706             (    forth6809.asm):05556         TOBODYW:    PULU  D                 ; xt
DF7E C30005           (    forth6809.asm):05557                     ADDD  #5
DF81 1F01             (    forth6809.asm):05558                     TFR   D,X

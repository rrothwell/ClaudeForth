                      (    forth6809.asm):08539         ; ------------------------------------------------------------
                      (    forth6809.asm):08540         ; #S  ( ud -- 0 0 )
                      (    forth6809.asm):08541         ; Convert digits with # until the quotient is zero (at least one digit
                      (    forth6809.asm):08542         ; is produced).
                      (    forth6809.asm):08543         ; ------------------------------------------------------------

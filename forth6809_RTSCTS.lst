                      (    forth6809.asm):06575         ; ============================================================
                      (    forth6809.asm):06576         ; ------------------------------------------------------------
                      (    forth6809.asm):06577         ; !  ( x a-addr -- )
                      (    forth6809.asm):06578         ; Store x at a-addr.
                      (    forth6809.asm):06579         ; ------------------------------------------------------------
F350 3710             (    forth6809.asm):06580         STOREW:     PULU  X                 ; a-addr
F352 3706             (    forth6809.asm):06581                     PULU  D                 ; x
F354 ED84             (    forth6809.asm):06582                     STD   ,X
F356 39               (    forth6809.asm):06583                     RTS
                      (    forth6809.asm):06584         
                      (    forth6809.asm):06585         ; ------------------------------------------------------------
                      (    forth6809.asm):06586         ; C@  ( c-addr -- char )
                      (    forth6809.asm):06587         ; Fetch the byte at c-addr.
                      (    forth6809.asm):06588         ; ------------------------------------------------------------
F357 3710             (    forth6809.asm):06589         CFETCHW:    PULU  X                 ; c-addr
F359 E684             (    forth6809.asm):06590                     LDB   ,X
F35B 4F               (    forth6809.asm):06591                     CLRA
F35C 3606             (    forth6809.asm):06592                     PSHU  D
F35E 39               (    forth6809.asm):06593                     RTS
                      (    forth6809.asm):06594         
                      (    forth6809.asm):06595         ; ------------------------------------------------------------
                      (    forth6809.asm):06596         ; C!  ( char c-addr -- )
                      (    forth6809.asm):06597         ; Store the low byte of char at c-addr.
                      (    forth6809.asm):06598         ; ------------------------------------------------------------
F35F 3710             (    forth6809.asm):06599         CSTOREW:    PULU  X                 ; c-addr
F361 3706             (    forth6809.asm):06600                     PULU  D                 ; char
F363 E784             (    forth6809.asm):06601                     STB   ,X
F365 39               (    forth6809.asm):06602                     RTS
                      (    forth6809.asm):06603         
                      (    forth6809.asm):06604         ; ------------------------------------------------------------
                      (    forth6809.asm):06605         ; +!  ( n a-addr -- )

DEC1 3706             (    forth6809.asm):05438                     PULU  D                 ; xt
DEC3 ED81             (    forth6809.asm):05439                     STD   ,X++              ; See bugfix: CCALL.1
DEC5 9F08             (    forth6809.asm):05440                     STX   CODEHERE
DEC7 39               (    forth6809.asm):05441                     RTS

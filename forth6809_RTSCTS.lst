                      (    forth6809.asm):08983         ; ------------------------------------------------------------
                      (    forth6809.asm):08984         ; TRUE  ( -- flag )
                      (    forth6809.asm):08985         ; Push true ($FFFF), the value of TRUEV. A direct LDD/PSHU/RTS: no

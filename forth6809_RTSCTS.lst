DDA3 3B               (    forth6809.asm):02216         IRQDONE3    RTI
                      (    forth6809.asm):02217         
                      (    forth6809.asm):02218                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):02219         
DDA4                  (    forth6809.asm):02220         IRQH:       RTI                     ; polling mode (SERIALPOLL=1) - ACIA
                      (    forth6809.asm):02221                                             ; interrupts are never enabled (see
                      (    forth6809.asm):02222                                             ; COLDSTRT's CR_POLL init), so this should
                      (    forth6809.asm):02223                                             ; never fire; kept as a safe stub matching
                      (    forth6809.asm):02224                                             ; the other unused vectors below
                      (    forth6809.asm):02225                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):02226         
                      (    forth6809.asm):02227         ; ------------------------------------------------------------
                      (    forth6809.asm):02228         ; Unused interrupt handlers: return immediately. SWIH instead
                      (    forth6809.asm):02229         ; pushes the throw code -99 and jumps to THROW.
                      (    forth6809.asm):02230         ; ------------------------------------------------------------
DDA4 3B               (    forth6809.asm):02231         SWI3H:      RTI
DDA5 3B               (    forth6809.asm):02232         SWI2H:      RTI
DDA6 3B               (    forth6809.asm):02233         FIRQH:      RTI
DDA7 3B               (    forth6809.asm):02234         NMIH:       RTI                     ; unused now that NMI -> WARM
DDA8 CCFF9D           (    forth6809.asm):02235         SWIH:       LDD   #-99              ; placeholder hardware-trap code; push and
DDAB 3606             (    forth6809.asm):02236                     PSHU  D                 ; JMP THROW, per the CATCH/THROW turn
DDAD 7EE561           (    forth6809.asm):02237                     JMP   THROWW
                      (    forth6809.asm):02238         
                      (    forth6809.asm):02239         ; ============================================================
                      (    forth6809.asm):02240         ; SECTION 4: COLD / ABORT / QUIT  (with CATCH-wrapped INTERPRET)
                      (    forth6809.asm):02241         ; ============================================================
                      (    forth6809.asm):02242         ; ------------------------------------------------------------
                      (    forth6809.asm):02243         ; Cold start: set the dictionary, code and variable pointers to
                      (    forth6809.asm):02244         ; their application areas, BASE to 10 and the input source to the
                      (    forth6809.asm):02245         ; terminal buffer, print the sign-on banner, then enter ABORT.
                      (    forth6809.asm):02246         ; COLD
                      (    forth6809.asm):02247         ;    Inputs:
                      (    forth6809.asm):02248         ;        none (entered at reset)
                      (    forth6809.asm):02249         ;    Outputs:
                      (    forth6809.asm):02250         ;        none (does not return)
                      (    forth6809.asm):02251         ;    Registers: all changed.
                      (    forth6809.asm):02252         ; ------------------------------------------------------------
DDB0 CC0240           (    forth6809.asm):02253         COLD:       LDD   #APPVARS
DDB3 DD0A             (    forth6809.asm):02254                     STD   VARHERE
DDB5 CC7000           (    forth6809.asm):02255                     LDD   #APPCODE
DDB8 DD08             (    forth6809.asm):02256                     STD   CODEHERE
DDBA CC2000           (    forth6809.asm):02257                     LDD   #APPDICT
DDBD DD06             (    forth6809.asm):02258                     STD   DPHERE
DDBF CCDBEA           (    forth6809.asm):02259                     LDD   #BASELATEST
DDC2 DD04             (    forth6809.asm):02260                     STD   LATEST
                      (    forth6809.asm):02261         
DDC4 CC000A           (    forth6809.asm):02262                     LDD   #10
DDC7 DD02             (    forth6809.asm):02263                     STD   BASE
                      (    forth6809.asm):02264         
DDC9 CC0106           (    forth6809.asm):02265                     LDD   #TIBBUF
DDCC DD39             (    forth6809.asm):02266                     STD   SRCADDR
DDCE CC0000           (    forth6809.asm):02267                     LDD   #0
DDD1 DD3B             (    forth6809.asm):02268                     STD   SRCLEN
DDD3 DD3D             (    forth6809.asm):02269                     STD   SRCID
                      (    forth6809.asm):02270         
DDD5 8EDE78           (    forth6809.asm):02271                     LDX   #SIGNON
DDD8 3610             (    forth6809.asm):02272                     PSHU  X                 ; c-addr
DDDA CC000F           (    forth6809.asm):02273                     LDD   #SIGNONL
DDDD 3606             (    forth6809.asm):02274                     PSHU  D                 ; u
DDDF BDF570           (    forth6809.asm):02275                     JSR   TYPEW
DDE2 BDFB6C           (    forth6809.asm):02276                     JSR   CRW
DDE5 2008             (    forth6809.asm):02277                     BRA   ABORT             ; Go to ABORT, skipping the ABORTW word.
                      (    forth6809.asm):02278         
                      (    forth6809.asm):02279         ; ------------------------------------------------------------
                      (    forth6809.asm):02280         ; ABORT  ( i*x -- ) ( R: j*x -- )
                      (    forth6809.asm):02281         ; Throw -1. With no CATCH frame, THROW falls into the ABORT reset below.
                      (    forth6809.asm):02282         ; ------------------------------------------------------------
DDE7 CCFFFF           (    forth6809.asm):02283         ABORTW:     LDD   #-1
DDEA 3606             (    forth6809.asm):02284                     PSHU  D                 ; throw code (-1)
DDEC 7EE561           (    forth6809.asm):02285                     JMP   THROWW
                      (    forth6809.asm):02286         
                      (    forth6809.asm):02287         ; ------------------------------------------------------------
                      (    forth6809.asm):02288         ; Reset the data stack to its base, then fall through into QUITW.
                      (    forth6809.asm):02289         ; ABORT
                      (    forth6809.asm):02290         ;    Inputs:
                      (    forth6809.asm):02291         ;        none
                      (    forth6809.asm):02292         ;    Outputs:
                      (    forth6809.asm):02293         ;        none (does not return)
                      (    forth6809.asm):02294         ;    Registers: RegU changed.
                      (    forth6809.asm):02295         ; ------------------------------------------------------------
DDEF CEBD00           (    forth6809.asm):02296         ABORT:      LDU   #SP0
                      (    forth6809.asm):02297                     ; falls through into QUIT
                      (    forth6809.asm):02298         
                      (    forth6809.asm):02299         ; ------------------------------------------------------------
                      (    forth6809.asm):02300         ; QUIT  ( -- ) ( R: i*x -- )
                      (    forth6809.asm):02301         ; Empty the return stack, set interpretation state, then loop reading
                      (    forth6809.asm):02302         ; a line and interpreting it under CATCH. Errors are reported as
                      (    forth6809.asm):02303         ; "ERROR n"; -1 (ABORT) is silent. Never returns.
                      (    forth6809.asm):02304         ; ------------------------------------------------------------
DDF2 10CEC000         (    forth6809.asm):02305         QUITW:      LDS   #RP0
DDF6 CC0000           (    forth6809.asm):02306                     LDD   #0
DDF9 DD00             (    forth6809.asm):02307                     STD   STATE             ; See bugfix: QUITW.1
                      (    forth6809.asm):02308         
DDFB BDE50C           (    forth6809.asm):02309         QLOOP:      JSR   QUERYW
                      (    forth6809.asm):02310         
DDFE DC06             (    forth6809.asm):02311                     LDD   DPHERE            ; Checkpoint on the return stack. CATCH
DE00 3406             (    forth6809.asm):02312                     PSHS  D                 ; and THROW restore S, so the frame is
DE02 DC08             (    forth6809.asm):02313                     LDD   CODEHERE          ; intact whichever way INTERPRET ends.
DE04 3406             (    forth6809.asm):02314                     PSHS  D                 ; See shadow QLOOP.2
DE06 DC0A             (    forth6809.asm):02315                     LDD   VARHERE
DE08 3406             (    forth6809.asm):02316                     PSHS  D
DE0A DC04             (    forth6809.asm):02317                     LDD   LATEST
DE0C 3406             (    forth6809.asm):02318                     PSHS  D
                      (    forth6809.asm):02319         
DE0E CCE220           (    forth6809.asm):02320                     LDD   #INTERPRET
DE11 3606             (    forth6809.asm):02321                     PSHU  D                 ; xt
DE13 BDE535           (    forth6809.asm):02322                     JSR   CATCHW
DE16 3706             (    forth6809.asm):02323                     PULU  D                 ; throw code (0 = no error)
DE18 3406             (    forth6809.asm):02324                     PSHS  D                 ; frame: 0,S code  2,S LATEST  4,S VARHERE
DE1A 10830000         (    forth6809.asm):02325                     CMPD  #0                ;        6,S CODEHERE  8,S DPHERE
DE1E 2740             (    forth6809.asm):02326                     BEQ   QOK
                      (    forth6809.asm):02327         
DE20 EC68             (    forth6809.asm):02328                     LDD   8,S
DE22 DD06             (    forth6809.asm):02329                     STD   DPHERE
DE24 EC66             (    forth6809.asm):02330                     LDD   6,S
DE26 DD08             (    forth6809.asm):02331                     STD   CODEHERE
DE28 EC64             (    forth6809.asm):02332                     LDD   4,S
DE2A DD0A             (    forth6809.asm):02333                     STD   VARHERE
DE2C EC62             (    forth6809.asm):02334                     LDD   2,S
DE2E DD04             (    forth6809.asm):02335                     STD   LATEST
DE30 CEBD00           (    forth6809.asm):02336                     LDU   #SP0
                      (    forth6809.asm):02337         
                      (    forth6809.asm):02338                     ; Return to interpretation state after a caught error.
                      (    forth6809.asm):02339                     ; See bugfix: QLOOP.1
DE33 CC0000           (    forth6809.asm):02340                     LDD   #0
DE36 DD00             (    forth6809.asm):02341                     STD   STATE
                      (    forth6809.asm):02342         
DE38 ECE4             (    forth6809.asm):02343                     LDD   ,S                ; -1 is ABORT: reset silently, no "ERROR -1"
DE3A 1083FFFF         (    forth6809.asm):02344                     CMPD  #-1
DE3E 2605             (    forth6809.asm):02345                     BNE   QSHOWERR
DE40 326A             (    forth6809.asm):02346                     LEAS  10,S              ; drop the frame
DE42 16FFB6           (    forth6809.asm):02347                     LBRA  QLOOP
                      (    forth6809.asm):02348         
DE45 BDFB6C           (    forth6809.asm):02349         QSHOWERR:   JSR   CRW
DE48 8EDE8B           (    forth6809.asm):02350                     LDX   #ERRMSG
DE4B 3610             (    forth6809.asm):02351                     PSHU  X                 ; c-addr
DE4D CC0008           (    forth6809.asm):02352                     LDD   #ERRMSGL
DE50 3606             (    forth6809.asm):02353                     PSHU  D                 ; u
DE52 BDF570           (    forth6809.asm):02354                     JSR   TYPEW
DE55 ECE4             (    forth6809.asm):02355                     LDD   ,S
DE57 3606             (    forth6809.asm):02356                     PSHU  D                 ; n
DE59 BDFA3B           (    forth6809.asm):02357                     JSR   DOTW
DE5C 326A             (    forth6809.asm):02358                     LEAS  10,S              ; drop the frame
DE5E 209B             (    forth6809.asm):02359                     BRA   QLOOP
                      (    forth6809.asm):02360         
DE60 326A             (    forth6809.asm):02361         QOK:        LEAS  10,S              ; drop the frame
DE62 BDFB6C           (    forth6809.asm):02362                     JSR   CRW               ; See bugfix: QOK.1
DE65 DC00             (    forth6809.asm):02363                     LDD   STATE
DE67 2692             (    forth6809.asm):02364                     BNE   QLOOP
DE69 8EDE87           (    forth6809.asm):02365                     LDX   #OKMSG
DE6C 3610             (    forth6809.asm):02366                     PSHU  X                 ; c-addr
DE6E CC0004           (    forth6809.asm):02367                     LDD   #OKMSGL
DE71 3606             (    forth6809.asm):02368                     PSHU  D                 ; u
DE73 BDF570           (    forth6809.asm):02369                     JSR   TYPEW
DE76 2083             (    forth6809.asm):02370                     BRA   QLOOP
                      (    forth6809.asm):02371         
DE78 3638303920464F52 (    forth6809.asm):02372         SIGNON:     FCC   "6809 FORTH v1.0"
     54482076312E30
     000F             (    forth6809.asm):02373         SIGNONL     EQU   *-SIGNON
DE87 20206F6B         (    forth6809.asm):02374         OKMSG:      FCC   "  ok"
     0004             (    forth6809.asm):02375         OKMSGL      EQU   *-OKMSG
DE8B 20204552524F5220 (    forth6809.asm):02376         ERRMSG:     FCC   "  ERROR "
     0008             (    forth6809.asm):02377         ERRMSGL     EQU   *-ERRMSG
                      (    forth6809.asm):02378         
                      (    forth6809.asm):02379         ; ============================================================
                      (    forth6809.asm):02380         ; SECTION 5: INNER-INTERPRETER SUPPORT (LIT, ZBRANCH, BRANCH,
                      (    forth6809.asm):02381         ; DODOES, DODEFER, EXECUTE)
                      (    forth6809.asm):02382         ; ============================================================
                      (    forth6809.asm):02383         ; ------------------------------------------------------------
                      (    forth6809.asm):02384         ; Run-time for a literal: fetch the inline cell that follows the
                      (    forth6809.asm):02385         ; calling JSR, push it, and advance the return address past it.
                      (    forth6809.asm):02386         ; LIT   ( -- x )
                      (    forth6809.asm):02387         ;    Inputs:
                      (    forth6809.asm):02388         ;        return stack top = address of the inline 16-bit literal
                      (    forth6809.asm):02389         ;    Outputs:
                      (    forth6809.asm):02390         ;        x pushed on the data stack; return address advanced by 2
                      (    forth6809.asm):02391         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02392         ; ------------------------------------------------------------
DE93 3510             (    forth6809.asm):02393         LIT:        PULS  X
DE95 EC81             (    forth6809.asm):02394                     LDD   ,X++
DE97 3606             (    forth6809.asm):02395                     PSHU  D                 ; x
DE99 3410             (    forth6809.asm):02396                     PSHS  X
DE9B 39               (    forth6809.asm):02397                     RTS
                      (    forth6809.asm):02398         
                      (    forth6809.asm):02399         ; ------------------------------------------------------------
                      (    forth6809.asm):02400         ; Run-time for a conditional branch: take the inline offset if the
                      (    forth6809.asm):02401         ; flag is false, otherwise skip it. The offset is relative to its own
                      (    forth6809.asm):02402         ; address.
                      (    forth6809.asm):02403         ; ZBRANCH   ( flag -- )
                      (    forth6809.asm):02404         ;    Inputs:
                      (    forth6809.asm):02405         ;        flag on the data stack
                      (    forth6809.asm):02406         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02407         ;    Outputs:
                      (    forth6809.asm):02408         ;        flag removed; return address set to the branch target or past
                      (    forth6809.asm):02409         ;        the offset
                      (    forth6809.asm):02410         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02411         ; ------------------------------------------------------------
DE9C 3706             (    forth6809.asm):02412         ZBRANCH:    PULU  D                 ; flag
DE9E 3510             (    forth6809.asm):02413                     PULS  X
DEA0 10830000         (    forth6809.asm):02414                     CMPD  #0
DEA4 2607             (    forth6809.asm):02415                     BNE   ZSKIP
DEA6 EC84             (    forth6809.asm):02416                     LDD   ,X
DEA8 308B             (    forth6809.asm):02417                     LEAX  D,X
DEAA 3410             (    forth6809.asm):02418                     PSHS  X
DEAC 39               (    forth6809.asm):02419                     RTS
DEAD 3002             (    forth6809.asm):02420         ZSKIP:      LEAX  2,X
DEAF 3410             (    forth6809.asm):02421                     PSHS  X
DEB1 39               (    forth6809.asm):02422                     RTS
                      (    forth6809.asm):02423         
                      (    forth6809.asm):02424         ; ------------------------------------------------------------
                      (    forth6809.asm):02425         ; Run-time for an unconditional branch: add the inline offset
                      (    forth6809.asm):02426         ; (relative to its own address) to the return address.
                      (    forth6809.asm):02427         ; BRANCH
                      (    forth6809.asm):02428         ;    Inputs:
                      (    forth6809.asm):02429         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02430         ;    Outputs:
                      (    forth6809.asm):02431         ;        return address set to the branch target
                      (    forth6809.asm):02432         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02433         ; ------------------------------------------------------------
DEB2 3510             (    forth6809.asm):02434         BRANCH:     PULS  X
DEB4 EC84             (    forth6809.asm):02435                     LDD   ,X
DEB6 308B             (    forth6809.asm):02436                     LEAX  D,X
DEB8 3410             (    forth6809.asm):02437                     PSHS  X
DEBA 39               (    forth6809.asm):02438                     RTS
                      (    forth6809.asm):02439         
                      (    forth6809.asm):02440         ; ------------------------------------------------------------
                      (    forth6809.asm):02441         ; Run-time entry of a CREATEd or DOES>-defined word. Its code is a
                      (    forth6809.asm):02442         ; trampoline: JSR DODOES, a BEHAVIOR address, then the data-field
                      (    forth6809.asm):02443         ; address. Pushes the data-field address and jumps to BEHAVIOR.
                      (    forth6809.asm):02444         ; DODOES   ( -- pfa )
                      (    forth6809.asm):02445         ;    Inputs:
                      (    forth6809.asm):02446         ;        return stack top = address of the BEHAVIOR cell in the
                      (    forth6809.asm):02447         ;        trampoline
                      (    forth6809.asm):02448         ;    Outputs:
                      (    forth6809.asm):02449         ;        pfa pushed on the data stack; control passes to BEHAVIOR
                      (    forth6809.asm):02450         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02451         ; ------------------------------------------------------------
DEBB 3510             (    forth6809.asm):02452         DODOES:     PULS  X
DEBD 10AE81           (    forth6809.asm):02453                     LDY   ,X++
DEC0 EC84             (    forth6809.asm):02454                     LDD   ,X
DEC2 3606             (    forth6809.asm):02455                     PSHU  D                 ; pfa
DEC4 6EA4             (    forth6809.asm):02456                     JMP   ,Y
                      (    forth6809.asm):02457         
                      (    forth6809.asm):02458         ; ------------------------------------------------------------
                      (    forth6809.asm):02459         ; Default BEHAVIOR for a CREATEd word: do nothing, leaving the data-
                      (    forth6809.asm):02460         ; field address on the stack.
                      (    forth6809.asm):02461         ; DOESRT0
                      (    forth6809.asm):02462         ;    Inputs:
                      (    forth6809.asm):02463         ;        none
                      (    forth6809.asm):02464         ;    Outputs:
                      (    forth6809.asm):02465         ;        none
                      (    forth6809.asm):02466         ;    Registers: none.
                      (    forth6809.asm):02467         ; ------------------------------------------------------------
DEC6 39               (    forth6809.asm):02468         DOESRT0:    RTS
                      (    forth6809.asm):02469         
                      (    forth6809.asm):02470         ; ------------------------------------------------------------
                      (    forth6809.asm):02471         ; Run-time for DOES>: patch the BEHAVIOR cell of the most recent
                      (    forth6809.asm):02472         ; definition with the code that follows the calling JSR, then return
                      (    forth6809.asm):02473         ; two levels up, skipping the rest of the defining word.
                      (    forth6809.asm):02474         ; SETDOES
                      (    forth6809.asm):02475         ;    Inputs:
                      (    forth6809.asm):02476         ;        return stack top = address after "JSR SETDOES" (the new
                      (    forth6809.asm):02477         ;        BEHAVIOR)
                      (    forth6809.asm):02478         ;        next on the return stack = the defining word's own return
                      (    forth6809.asm):02479         ;        address
                      (    forth6809.asm):02480         ;    Outputs:
                      (    forth6809.asm):02481         ;        BEHAVIOR cell of LATEST patched; control returns to the
                      (    forth6809.asm):02482         ;        defining word's caller
                      (    forth6809.asm):02483         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02484         ; ------------------------------------------------------------
DEC7 3510             (    forth6809.asm):02485         SETDOES:    PULS  X                 ; X = addr right after "JSR SETDOES" - new BEHAVIOR
DEC9 1F12             (    forth6809.asm):02486                     TFR   X,Y               ; Y = new BEHAVIOR, kept across the walk
                      (    forth6809.asm):02487         
DECB 9E04             (    forth6809.asm):02488                     LDX   LATEST
DECD E684             (    forth6809.asm):02489                     LDB   ,X
DECF C41F             (    forth6809.asm):02490                     ANDB  #$1F
DED1 4F               (    forth6809.asm):02491                     CLRA
DED2 308B             (    forth6809.asm):02492                     LEAX  D,X               ; header + name length
DED4 EC03             (    forth6809.asm):02493                     LDD   3,X               ; D = CFA (trampoline address), past name and LINK
DED6 C30003           (    forth6809.asm):02494                     ADDD  #3                ; +3 -> BEHAVIOR field (past JSR DODOES)
DED9 1F01             (    forth6809.asm):02495                     TFR   D,X
                      (    forth6809.asm):02496         
DEDB 10AF84           (    forth6809.asm):02497                     STY   ,X                ; patch it
                      (    forth6809.asm):02498         
DEDE 3510             (    forth6809.asm):02499                     PULS  X                 ; X = the OUTER defining word's own return addr
DEE0 6E84             (    forth6809.asm):02500                     JMP   ,X                ; jump there directly - "double RTS"
                      (    forth6809.asm):02501         
                      (    forth6809.asm):02502         ; ------------------------------------------------------------
                      (    forth6809.asm):02503         ; BEHAVIOR of a DEFERred word: execute the xt stored in its data
                      (    forth6809.asm):02504         ; field. Tail-calls the xt, so it returns to the original caller.
                      (    forth6809.asm):02505         ; DODEFER   ( pfa -- )
                      (    forth6809.asm):02506         ;    Inputs:
                      (    forth6809.asm):02507         ;        pfa on the data stack
                      (    forth6809.asm):02508         ;    Outputs:
                      (    forth6809.asm):02509         ;        pfa removed; the stored xt is executed
                      (    forth6809.asm):02510         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02511         ; ------------------------------------------------------------
DEE2 3710             (    forth6809.asm):02512         DODEFER:    PULU  X                 ; pfa
DEE4 EC84             (    forth6809.asm):02513                     LDD   ,X
DEE6 1F01             (    forth6809.asm):02514                     TFR   D,X
DEE8 6E84             (    forth6809.asm):02515                     JMP   ,X
                      (    forth6809.asm):02516         
                      (    forth6809.asm):02517         ; ------------------------------------------------------------
                      (    forth6809.asm):02518         ; Initial xt of a DEFER: throws -21 until IS stores a real xt.
                      (    forth6809.asm):02519         ; DOABORTUNDEF
                      (    forth6809.asm):02520         ;    Inputs:
                      (    forth6809.asm):02521         ;        none
                      (    forth6809.asm):02522         ;    Outputs:
                      (    forth6809.asm):02523         ;        none (does not return)
                      (    forth6809.asm):02524         ;    Registers: RegD changed.
                      (    forth6809.asm):02525         ; ------------------------------------------------------------
DEEA                  (    forth6809.asm):02526         DOABORTUNDEF:
DEEA CCFFEB           (    forth6809.asm):02527                     LDD   #-21
DEED 3606             (    forth6809.asm):02528                     PSHU  D                 ; throw code (-21)
DEEF 7EE561           (    forth6809.asm):02529                     JMP   THROWW
                      (    forth6809.asm):02530         
                      (    forth6809.asm):02531         ; ------------------------------------------------------------
                      (    forth6809.asm):02532         ; BEHAVIOR of a MARKER word: restore the dictionary, code and variable
                      (    forth6809.asm):02533         ; pointers and LATEST from the four cells saved when it was defined.
                      (    forth6809.asm):02534         ; DOMARKER   ( pfa -- )
                      (    forth6809.asm):02535         ;    Inputs:
                      (    forth6809.asm):02536         ;        pfa on the data stack (the four saved cells)
                      (    forth6809.asm):02537         ;    Outputs:
                      (    forth6809.asm):02538         ;        pfa removed; DPHERE, CODEHERE, VARHERE and LATEST restored
                      (    forth6809.asm):02539         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02540         ; ------------------------------------------------------------
DEF2 3710             (    forth6809.asm):02541         DOMARKER:   PULU  X                 ; pfa
DEF4 EC84             (    forth6809.asm):02542                     LDD   ,X
DEF6 DD06             (    forth6809.asm):02543                     STD   DPHERE
DEF8 EC02             (    forth6809.asm):02544                     LDD   2,X
DEFA DD08             (    forth6809.asm):02545                     STD   CODEHERE
DEFC EC04             (    forth6809.asm):02546                     LDD   4,X
DEFE DD0A             (    forth6809.asm):02547                     STD   VARHERE
DF00 EC06             (    forth6809.asm):02548                     LDD   6,X
DF02 DD04             (    forth6809.asm):02549                     STD   LATEST
DF04 39               (    forth6809.asm):02550                     RTS
                      (    forth6809.asm):02551         
                      (    forth6809.asm):02552         ; ------------------------------------------------------------
                      (    forth6809.asm):02553         ; EXECUTE  ( i*x xt -- j*x )
                      (    forth6809.asm):02554         ; Execute the word whose execution token is xt.
                      (    forth6809.asm):02555         ; ------------------------------------------------------------
DF05 3710             (    forth6809.asm):02556         EXECUTEW:   PULU  X                 ; xt
DF07 AD84             (    forth6809.asm):02557                     JSR   ,X
DF09 39               (    forth6809.asm):02558                     RTS
                      (    forth6809.asm):02559         
                      (    forth6809.asm):02560         ; ============================================================
                      (    forth6809.asm):02561         ; SECTION 6: COMMA FAMILY (factored via APPENDCELL/APPENDBYTE)
                      (    forth6809.asm):02562         ; ============================================================
                      (    forth6809.asm):02563         ; ------------------------------------------------------------
                      (    forth6809.asm):02564         ; Append a 16-bit cell to the area whose "here" pointer is at RegX
                      (    forth6809.asm):02565         ; (CODEHERE or VARHERE), and advance that pointer by 2.
                      (    forth6809.asm):02566         ; APPENDCELL   ( x -- )
                      (    forth6809.asm):02567         ;    Inputs:
                      (    forth6809.asm):02568         ;        RegX = address of the here pointer
                      (    forth6809.asm):02569         ;        x on the data stack
                      (    forth6809.asm):02570         ;    Outputs:
                      (    forth6809.asm):02571         ;        x stored at the old here value; pointer advanced by 2
                      (    forth6809.asm):02572         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02573         ; ------------------------------------------------------------
DF0A 3706             (    forth6809.asm):02574         APPENDCELL: PULU  D                 ; x
DF0C 10AE84           (    forth6809.asm):02575                     LDY   ,X
DF0F EDA1             (    forth6809.asm):02576                     STD   ,Y++
DF11 10AF84           (    forth6809.asm):02577                     STY   ,X
DF14 39               (    forth6809.asm):02578                     RTS
                      (    forth6809.asm):02579         
                      (    forth6809.asm):02580         ; ------------------------------------------------------------
                      (    forth6809.asm):02581         ; Append the low byte of the top cell to the area whose "here" pointer
                      (    forth6809.asm):02582         ; is at RegX (CODEHERE or VARHERE), and advance that pointer by 1.
                      (    forth6809.asm):02583         ; APPENDBYTE   ( char -- )
                      (    forth6809.asm):02584         ;    Inputs:
                      (    forth6809.asm):02585         ;        RegX = address of the here pointer
                      (    forth6809.asm):02586         ;        char on the data stack
                      (    forth6809.asm):02587         ;    Outputs:
                      (    forth6809.asm):02588         ;        char stored at the old here value; pointer advanced by 1
                      (    forth6809.asm):02589         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02590         ; ------------------------------------------------------------
DF15 3706             (    forth6809.asm):02591         APPENDBYTE: PULU  D                 ; char
DF17 10AE84           (    forth6809.asm):02592                     LDY   ,X
DF1A E7A0             (    forth6809.asm):02593                     STB   ,Y+
DF1C 10AF84           (    forth6809.asm):02594                     STY   ,X
DF1F 39               (    forth6809.asm):02595                     RTS
                      (    forth6809.asm):02596         
                      (    forth6809.asm):02597         ; ------------------------------------------------------------
                      (    forth6809.asm):02598         ; ,  ( x -- )
                      (    forth6809.asm):02599         ; Append x to the code/data area (CODEHERE).
                      (    forth6809.asm):02600         ; ------------------------------------------------------------
DF20 8E0008           (    forth6809.asm):02601         COMMAW:     LDX   #CODEHERE
DF23 7EDF0A           (    forth6809.asm):02602                     JMP   APPENDCELL
                      (    forth6809.asm):02603         
                      (    forth6809.asm):02604         ; ------------------------------------------------------------
                      (    forth6809.asm):02605         ; CODECOMMA  ( x -- )
                      (    forth6809.asm):02606         ; Internal name for ",": append x at CODEHERE.
                      (    forth6809.asm):02607         ; ------------------------------------------------------------
DF26 8E0008           (    forth6809.asm):02608         CODECOMMA:  LDX   #CODEHERE
DF29 7EDF0A           (    forth6809.asm):02609                     JMP   APPENDCELL
                      (    forth6809.asm):02610         
                      (    forth6809.asm):02611         ; ------------------------------------------------------------
                      (    forth6809.asm):02612         ; C,  ( char -- )
                      (    forth6809.asm):02613         ; Append char to the code/data area (CODEHERE).
                      (    forth6809.asm):02614         ; ------------------------------------------------------------
DF2C 8E0008           (    forth6809.asm):02615         CCOMMAW:    LDX   #CODEHERE
DF2F 7EDF15           (    forth6809.asm):02616                     JMP   APPENDBYTE
                      (    forth6809.asm):02617         
                      (    forth6809.asm):02618         ; ------------------------------------------------------------
                      (    forth6809.asm):02619         ; CCOMMA1  ( char -- )
                      (    forth6809.asm):02620         ; Internal name for "C,": append char at CODEHERE.
                      (    forth6809.asm):02621         ; ------------------------------------------------------------
DF32 8E0008           (    forth6809.asm):02622         CCOMMA1:    LDX   #CODEHERE
DF35 7EDF15           (    forth6809.asm):02623                     JMP   APPENDBYTE
                      (    forth6809.asm):02624         
                      (    forth6809.asm):02625         ; ------------------------------------------------------------
                      (    forth6809.asm):02626         ; V,  ( x -- )
                      (    forth6809.asm):02627         ; Append x to the variable area (VARHERE).
                      (    forth6809.asm):02628         ; ------------------------------------------------------------
DF38 8E000A           (    forth6809.asm):02629         VCOMMAW:    LDX   #VARHERE
DF3B 7EDF0A           (    forth6809.asm):02630                     JMP   APPENDCELL
                      (    forth6809.asm):02631         
                      (    forth6809.asm):02632         ; ------------------------------------------------------------
                      (    forth6809.asm):02633         ; VC,  ( char -- )
                      (    forth6809.asm):02634         ; Append char to the variable area (VARHERE).
                      (    forth6809.asm):02635         ; ------------------------------------------------------------
DF3E 8E000A           (    forth6809.asm):02636         VCCOMMAW:   LDX   #VARHERE
DF41 7EDF15           (    forth6809.asm):02637                     JMP   APPENDBYTE
                      (    forth6809.asm):02638         
                      (    forth6809.asm):02639         ; ------------------------------------------------------------
                      (    forth6809.asm):02640         ; ALLOT  ( n -- )
                      (    forth6809.asm):02641         ; Reserve n bytes in the code/data area by advancing CODEHERE.
                      (    forth6809.asm):02642         ; ------------------------------------------------------------
DF44 3706             (    forth6809.asm):02643         ALLOTW:     PULU  D                 ; n
DF46 9E08             (    forth6809.asm):02644                     LDX   CODEHERE
DF48 308B             (    forth6809.asm):02645                     LEAX  D,X
DF4A 9F08             (    forth6809.asm):02646                     STX   CODEHERE
DF4C 39               (    forth6809.asm):02647                     RTS
                      (    forth6809.asm):02648         
                      (    forth6809.asm):02649         ; ------------------------------------------------------------
                      (    forth6809.asm):02650         ; VALLOT  ( n -- )
                      (    forth6809.asm):02651         ; Reserve n bytes in the variable area by advancing VARHERE.
                      (    forth6809.asm):02652         ; ------------------------------------------------------------
DF4D 3706             (    forth6809.asm):02653         VALLOTW:    PULU  D                 ; n
DF4F 9E0A             (    forth6809.asm):02654                     LDX   VARHERE
DF51 308B             (    forth6809.asm):02655                     LEAX  D,X
DF53 9F0A             (    forth6809.asm):02656                     STX   VARHERE
DF55 39               (    forth6809.asm):02657                     RTS
                      (    forth6809.asm):02658         
                      (    forth6809.asm):02659         ; ------------------------------------------------------------
                      (    forth6809.asm):02660         ; HERE  ( -- addr )
                      (    forth6809.asm):02661         ; Return the next free address in the code/data area (CODEHERE).
                      (    forth6809.asm):02662         ; ------------------------------------------------------------
DF56 DC08             (    forth6809.asm):02663         HEREW:      LDD   CODEHERE
DF58 3606             (    forth6809.asm):02664                     PSHU  D                 ; addr
DF5A 39               (    forth6809.asm):02665                     RTS
                      (    forth6809.asm):02666         
                      (    forth6809.asm):02667         ; ------------------------------------------------------------
                      (    forth6809.asm):02668         ; VHERE  ( -- addr )
                      (    forth6809.asm):02669         ; Return the next free address in the variable area (VARHERE).
                      (    forth6809.asm):02670         ; ------------------------------------------------------------
DF5B DC0A             (    forth6809.asm):02671         VHEREW:     LDD   VARHERE
DF5D 3606             (    forth6809.asm):02672                     PSHU  D                 ; addr
DF5F 39               (    forth6809.asm):02673                     RTS
                      (    forth6809.asm):02674         
                      (    forth6809.asm):02675         ; ------------------------------------------------------------
                      (    forth6809.asm):02676         ; PAD  ( -- c-addr )
                      (    forth6809.asm):02677         ; Return the scratch buffer address, PADOFFSET bytes above CODEHERE.
                      (    forth6809.asm):02678         ; ------------------------------------------------------------
DF60 DC08             (    forth6809.asm):02679         PADW:       LDD   CODEHERE
DF62 C30080           (    forth6809.asm):02680                     ADDD  #PADOFFSET
DF65 3606             (    forth6809.asm):02681                     PSHU  D                 ; c-addr
DF67 39               (    forth6809.asm):02682                     RTS
                      (    forth6809.asm):02683         
                      (    forth6809.asm):02684         ; ------------------------------------------------------------
                      (    forth6809.asm):02685         ; UNUSED  ( -- u )
                      (    forth6809.asm):02686         ; Return the number of free bytes remaining in the code/data area.
                      (    forth6809.asm):02687         ; ------------------------------------------------------------
DF68 CCB900           (    forth6809.asm):02688         UNUSEDW:    LDD   #CODETOP
DF6B 9308             (    forth6809.asm):02689                     SUBD  CODEHERE
DF6D 3606             (    forth6809.asm):02690                     PSHU  D                 ; u
DF6F 39               (    forth6809.asm):02691                     RTS
                      (    forth6809.asm):02692         
                      (    forth6809.asm):02693         ; ------------------------------------------------------------
                      (    forth6809.asm):02694         ; VUNUSED  ( -- u )
                      (    forth6809.asm):02695         ; Return the number of free bytes remaining in the variable area.
                      (    forth6809.asm):02696         ; ------------------------------------------------------------
DF70 CC1FFF           (    forth6809.asm):02697         VUNUSEDW:   LDD   #APPVARSEND       ; See bugfix: VUNUSEDW.1
DF73 930A             (    forth6809.asm):02698                     SUBD  VARHERE
DF75 3606             (    forth6809.asm):02699                     PSHU  D                 ; u
DF77 39               (    forth6809.asm):02700                     RTS
                      (    forth6809.asm):02701         
                      (    forth6809.asm):02702         ; ============================================================
                      (    forth6809.asm):02703         ; SECTION 7: HEADER (factored from :/CREATE/VARIABLE)
                      (    forth6809.asm):02704         ; ============================================================
                      (    forth6809.asm):02705         ; ------------------------------------------------------------
                      (    forth6809.asm):02706         ; Build a dictionary header for the next name in the input: parse the
                      (    forth6809.asm):02707         ; name, then lay down the length byte (with the smudge bit set if
                      (    forth6809.asm):02708         ; requested), the name, the link to the previous header and the code
                      (    forth6809.asm):02709         ; field address (CODEHERE). LATEST and DPHERE are updated.
                      (    forth6809.asm):02710         ; HEADER   ( smudge-flag "name" -- )
                      (    forth6809.asm):02711         ;    Inputs:
                      (    forth6809.asm):02712         ;        smudge-flag on the data stack (non-zero hides the new word)
                      (    forth6809.asm):02713         ;        name parsed from the input stream
                      (    forth6809.asm):02714         ;    Outputs:
                      (    forth6809.asm):02715         ;        header built at DPHERE; LATEST = address of the new header
                      (    forth6809.asm):02716         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02717         ; ------------------------------------------------------------
DF78 CC0020           (    forth6809.asm):02718         HEADER:     LDD   #32
DF7B 3606             (    forth6809.asm):02719                     PSHU  D
DF7D BDE2A0           (    forth6809.asm):02720                     JSR   WORDW
DF80 3710             (    forth6809.asm):02721                     PULU  X                 ; c-addr of the name
DF82 3706             (    forth6809.asm):02722                     PULU  D                 ; smudge flag in B
DF84 A680             (    forth6809.asm):02723                     LDA   ,X+               ; name length, X = name text
DF86 3402             (    forth6809.asm):02724                     PSHS  A                 ; 2,S = length (5k: S-frame, no scratch)
DF88 5D               (    forth6809.asm):02725                     TSTB
DF89 2702             (    forth6809.asm):02726                     BEQ   HDNOSM
DF8B 8A40             (    forth6809.asm):02727                     ORA   #$40
DF8D 109E06           (    forth6809.asm):02728         HDNOSM:     LDY   DPHERE
DF90 3420             (    forth6809.asm):02729                     PSHS  Y                 ; 0,S = address of the new header
DF92 A7A0             (    forth6809.asm):02730                     STA   ,Y+
DF94 E662             (    forth6809.asm):02731                     LDB   2,S
DF96 2707             (    forth6809.asm):02732                     BEQ   HDNONM
DF98 A680             (    forth6809.asm):02733         HDCPY:      LDA   ,X+
DF9A A7A0             (    forth6809.asm):02734                     STA   ,Y+
DF9C 5A               (    forth6809.asm):02735                     DECB
DF9D 26F9             (    forth6809.asm):02736                     BNE   HDCPY
DF9F DC04             (    forth6809.asm):02737         HDNONM:     LDD   LATEST
DFA1 EDA1             (    forth6809.asm):02738                     STD   ,Y++
DFA3 DC08             (    forth6809.asm):02739                     LDD   CODEHERE
DFA5 EDA1             (    forth6809.asm):02740                     STD   ,Y++
DFA7 109F06           (    forth6809.asm):02741                     STY   DPHERE
DFAA 3506             (    forth6809.asm):02742                     PULS  D
DFAC DD04             (    forth6809.asm):02743                     STD   LATEST
DFAE 3261             (    forth6809.asm):02744                     LEAS  1,S
DFB0 39               (    forth6809.asm):02745                     RTS
                      (    forth6809.asm):02746         
                      (    forth6809.asm):02747         ; ============================================================
                      (    forth6809.asm):02748         ; SECTION 8: DEFINING WORDS
                      (    forth6809.asm):02749         ; ============================================================
                      (    forth6809.asm):02750         ; ------------------------------------------------------------
                      (    forth6809.asm):02751         ; :  ( "name" -- )
                      (    forth6809.asm):02752         ; Start a colon definition: parse the name, build a smudged header,
                      (    forth6809.asm):02753         ; record the new xt in CURXT, note the control-flow stack position in
                      (    forth6809.asm):02754         ; CSP and enter compile state.
                      (    forth6809.asm):02755         ; ------------------------------------------------------------
DFB1 CCFFFF           (    forth6809.asm):02756         COLONW:     LDD   #TRUEV
DFB4 3606             (    forth6809.asm):02757                     PSHU  D
DFB6 BDDF78           (    forth6809.asm):02758                     JSR   HEADER
DFB9 DC08             (    forth6809.asm):02759                     LDD   CODEHERE          ; Record this word's xt for RECURSE.
DFBB DD1F             (    forth6809.asm):02760                     STD   CURXT             ; See bugfix: COLONW.1
DFBD 1F30             (    forth6809.asm):02761                     TFR   U,D
DFBF DD21             (    forth6809.asm):02762                     STD   CSP
DFC1 CCFFFF           (    forth6809.asm):02763                     LDD   #-1
DFC4 DD00             (    forth6809.asm):02764                     STD   STATE
DFC6 39               (    forth6809.asm):02765                     RTS
                      (    forth6809.asm):02766         
                      (    forth6809.asm):02767         ; ------------------------------------------------------------
                      (    forth6809.asm):02768         ; ;  ( -- )  IMMEDIATE
                      (    forth6809.asm):02769         ; End a colon definition: compile RTS, check that the control-flow
                      (    forth6809.asm):02770         ; stack is balanced (error -22 if not), clear the smudge bit of the
                      (    forth6809.asm):02771         ; new word and return to interpret state.
                      (    forth6809.asm):02772         ; ------------------------------------------------------------
DFC7 CC0039           (    forth6809.asm):02773         SEMIW:      LDD   #RTSOPC
DFCA 3606             (    forth6809.asm):02774                     PSHU  D
DFCC BDDF32           (    forth6809.asm):02775                     JSR   CCOMMA1
DFCF 1F30             (    forth6809.asm):02776                     TFR   U,D
DFD1 109321           (    forth6809.asm):02777                     CMPD  CSP
DFD4 2703             (    forth6809.asm):02778                     BEQ   SEMIOK
DFD6 BDE52C           (    forth6809.asm):02779                     JSR   CFERR
DFD9 9E04             (    forth6809.asm):02780         SEMIOK:     LDX   LATEST
DFDB A684             (    forth6809.asm):02781                     LDA   ,X
DFDD 84BF             (    forth6809.asm):02782                     ANDA  #$BF
DFDF A784             (    forth6809.asm):02783                     STA   ,X
DFE1 CC0000           (    forth6809.asm):02784                     LDD   #0
DFE4 DD00             (    forth6809.asm):02785                     STD   STATE
DFE6 39               (    forth6809.asm):02786                     RTS
                      (    forth6809.asm):02787         
                      (    forth6809.asm):02788         ; ------------------------------------------------------------
                      (    forth6809.asm):02789         ; :NONAME  ( -- xt )
                      (    forth6809.asm):02790         ; Start an anonymous definition: no header is built and LATEST is left
                      (    forth6809.asm):02791         ; alone, so the word can never be found. Leaves the xt (the current
                      (    forth6809.asm):02792         ; CODEHERE) on the stack, records it in CURXT, notes the control-flow
                      (    forth6809.asm):02793         ; stack position in CSP and enters compile state.
                      (    forth6809.asm):02794         ; Original comment: shadow NONAMEW.0.
                      (    forth6809.asm):02795         ; ------------------------------------------------------------
DFE7 DC08             (    forth6809.asm):02796         NONAMEW:    LDD   CODEHERE
DFE9 3606             (    forth6809.asm):02797                     PSHU  D                 ; xt
DFEB DD1F             (    forth6809.asm):02798                     STD   CURXT             ; See bugfix: NONAMEW.1
DFED 1F30             (    forth6809.asm):02799                     TFR   U,D
DFEF DD21             (    forth6809.asm):02800                     STD   CSP
DFF1 CCFFFF           (    forth6809.asm):02801                     LDD   #-1
DFF4 DD00             (    forth6809.asm):02802                     STD   STATE
DFF6 39               (    forth6809.asm):02803                     RTS
                      (    forth6809.asm):02804         
                      (    forth6809.asm):02805         ; ------------------------------------------------------------
                      (    forth6809.asm):02806         ; Common start of every DODOES-style defining word: build a header
                      (    forth6809.asm):02807         ; and compile the DODOES trampoline followed by the behaviour address.
                      (    forth6809.asm):02808         ; BLDDOES
                      (    forth6809.asm):02809         ;    Inputs:
                      (    forth6809.asm):02810         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):02811         ;    Outputs:
                      (    forth6809.asm):02812         ;        header built, trampoline and behaviour cell compiled
                      (    forth6809.asm):02813         ;    Registers: all changed.
                      (    forth6809.asm):02814         ; BLDSELF
                      (    forth6809.asm):02815         ;    Inputs:
                      (    forth6809.asm):02816         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):02817         ;    Outputs:
                      (    forth6809.asm):02818         ;        as BLDDOES, then the PFA cell compiled pointing at the
                      (    forth6809.asm):02819         ;        cell that follows it (the word's own data field)
                      (    forth6809.asm):02820         ;    Registers: all changed.
                      (    forth6809.asm):02821         ; Used by CREATE, CONSTANT, 2CONSTANT, DEFER and MARKER (BLDSELF)
                      (    forth6809.asm):02822         ; and by VALUE (BLDDOES, which supplies its own PFA).
                      (    forth6809.asm):02823         ; ------------------------------------------------------------
DFF7 3406             (    forth6809.asm):02824         BLDDOES:    PSHS  D                 ; behaviour address
DFF9 CC0000           (    forth6809.asm):02825                     LDD   #0
DFFC 3606             (    forth6809.asm):02826                     PSHU  D
DFFE BDDF78           (    forth6809.asm):02827                     JSR   HEADER
E001 CCDEBB           (    forth6809.asm):02828                     LDD   #DODOES
E004 3606             (    forth6809.asm):02829                     PSHU  D
E006 BDE99C           (    forth6809.asm):02830                     JSR   CCALL
E009 3506             (    forth6809.asm):02831                     PULS  D
E00B 3606             (    forth6809.asm):02832                     PSHU  D                 ; behaviour address
E00D BDDF26           (    forth6809.asm):02833                     JSR   CODECOMMA
E010 39               (    forth6809.asm):02834                     RTS
                      (    forth6809.asm):02835         
E011 BDDFF7           (    forth6809.asm):02836         BLDSELF:    JSR   BLDDOES
E014 DC08             (    forth6809.asm):02837                     LDD   CODEHERE          ; PFA = the cell after this one
E016 C30002           (    forth6809.asm):02838                     ADDD  #2                ; See bugfix: CONSTANTW.1
E019 3606             (    forth6809.asm):02839                     PSHU  D
E01B BDDF26           (    forth6809.asm):02840                     JSR   CODECOMMA
E01E 39               (    forth6809.asm):02841                     RTS
                      (    forth6809.asm):02842         
                      (    forth6809.asm):02843         ; ------------------------------------------------------------
                      (    forth6809.asm):02844         ; CREATE  ( "name" -- )
                      (    forth6809.asm):02845         ; Build a header whose code is a DODOES trampoline. The default
                      (    forth6809.asm):02846         ; behaviour (DOESRT0) leaves the data-field address, the next free
                      (    forth6809.asm):02847         ; address in the code area, on the stack.
                      (    forth6809.asm):02848         ; ------------------------------------------------------------
E01F CCDEC6           (    forth6809.asm):02849         CREATEW:    LDD   #DOESRT0
E022 BDE011           (    forth6809.asm):02850                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
E025 39               (    forth6809.asm):02851                     RTS
                      (    forth6809.asm):02852         
                      (    forth6809.asm):02853         ; ------------------------------------------------------------
                      (    forth6809.asm):02854         ; DOES>  ( -- )  IMMEDIATE, compile-only
                      (    forth6809.asm):02855         ; Compile a call to SETDOES, which at run time patches the behaviour
                      (    forth6809.asm):02856         ; of the word being defined.
                      (    forth6809.asm):02857         ; Original comment: shadow DOESGTW.0.
                      (    forth6809.asm):02858         ; ------------------------------------------------------------
E026 CCDEC7           (    forth6809.asm):02859         DOESGTW:    LDD   #SETDOES
E029 3606             (    forth6809.asm):02860                     PSHU  D
E02B BDE99C           (    forth6809.asm):02861                     JSR   CCALL
E02E 39               (    forth6809.asm):02862                     RTS
                      (    forth6809.asm):02863         
                      (    forth6809.asm):02864         ; ------------------------------------------------------------
                      (    forth6809.asm):02865         ; VARIABLE  ( "name" -- )
                      (    forth6809.asm):02866         ; Build a word that returns the address of a new cell in the variable
                      (    forth6809.asm):02867         ; area, initialised to zero.
                      (    forth6809.asm):02868         ; ------------------------------------------------------------
E02F CC0000           (    forth6809.asm):02869         VARIABLEW:  LDD   #0
E032 3606             (    forth6809.asm):02870                     PSHU  D
E034 BDDF78           (    forth6809.asm):02871                     JSR   HEADER
E037 CCDEBB           (    forth6809.asm):02872                     LDD   #DODOES
E03A 3606             (    forth6809.asm):02873                     PSHU  D
E03C BDE99C           (    forth6809.asm):02874                     JSR   CCALL
E03F CCDEC6           (    forth6809.asm):02875                     LDD   #DOESRT0
E042 3606             (    forth6809.asm):02876                     PSHU  D
E044 BDDF26           (    forth6809.asm):02877                     JSR   CODECOMMA
E047 DC0A             (    forth6809.asm):02878                     LDD   VARHERE
E049 3606             (    forth6809.asm):02879                     PSHU  D
E04B BDDF26           (    forth6809.asm):02880                     JSR   CODECOMMA
E04E CC0000           (    forth6809.asm):02881                     LDD   #0
E051 9E0A             (    forth6809.asm):02882                     LDX   VARHERE
E053 ED81             (    forth6809.asm):02883                     STD   ,X++
E055 9F0A             (    forth6809.asm):02884                     STX   VARHERE
E057 39               (    forth6809.asm):02885                     RTS
                      (    forth6809.asm):02886         
                      (    forth6809.asm):02887         ; ------------------------------------------------------------
                      (    forth6809.asm):02888         ; @  ( a-addr -- x )
                      (    forth6809.asm):02889         ; Fetch the cell at a-addr. Also the behaviour of CONSTANT words.
                      (    forth6809.asm):02890         ; ------------------------------------------------------------
E058 3710             (    forth6809.asm):02891         FETCHW:     PULU  X                 ; a-addr
E05A EC84             (    forth6809.asm):02892                     LDD   ,X
E05C 3606             (    forth6809.asm):02893                     PSHU  D                 ; x

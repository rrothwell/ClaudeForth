E803 109316           (    forth6809.asm):04786                     CMPD  MSCR2
E806 2209             (    forth6809.asm):04787                     BHI   DPTEXIT
E808 3510             (    forth6809.asm):04788         DPCONT:     PULS  X                 ; X = branch operand address
E80A EC84             (    forth6809.asm):04789                     LDD   ,X
E80C 308B             (    forth6809.asm):04790                     LEAX  D,X
E80E 3410             (    forth6809.asm):04791                     PSHS  X
E810 39               (    forth6809.asm):04792                     RTS
E811 3510             (    forth6809.asm):04793         DPTEXIT:    PULS  X
E813 3002             (    forth6809.asm):04794                     LEAX  2,X               ; skip the branch operand
E815 3266             (    forth6809.asm):04795                     LEAS  6,S               ; discard the loop frame
E817 3410             (    forth6809.asm):04796                     PSHS  X

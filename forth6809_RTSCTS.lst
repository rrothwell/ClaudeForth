                      (    forth6809.asm):10841         
                      (    forth6809.asm):10842         ; ------------------------------------------------------------
                      (    forth6809.asm):10843         ; Cold start, entered from the reset vector: mask interrupts, set up
                      (    forth6809.asm):10844         ; the stacks and the direct page, clear GLOBALS, initialise the ACIA,
                      (    forth6809.asm):10845         ; unmask interrupts, run the unit tests if they are built in, then
                      (    forth6809.asm):10846         ; enter COLD.
                      (    forth6809.asm):10847         ; COLDSTRT
                      (    forth6809.asm):10848         ;    Inputs:
                      (    forth6809.asm):10849         ;        hardware reset
                      (    forth6809.asm):10850         ;    Outputs:
                      (    forth6809.asm):10851         ;        does not return
                      (    forth6809.asm):10852         ;    Registers: all registers initialised.
                      (    forth6809.asm):10853         ; ------------------------------------------------------------
FFA4                  (    forth6809.asm):10854         COLDSTRT:
FFA4 1A50             (    forth6809.asm):10855                     ORCC  #$50              ; Disable IRQ & FIRQ
FFA6 10CEC000         (    forth6809.asm):10856                     LDS   #RSTACK+1
FFAA CEBD00           (    forth6809.asm):10857                     LDU   #DSTACK+1
FFAD 4F               (    forth6809.asm):10858                     CLRA
FFAE 1F8B             (    forth6809.asm):10859                     TFR   A,DP
                      (    forth6809.asm):10860         
FFB0 8E0000           (    forth6809.asm):10861                     LDX   #GLOBALS
FFB3 C600             (    forth6809.asm):10862                     LDB   #0
FFB5 6F80             (    forth6809.asm):10863         CLRGLOB:    CLR   ,X+
FFB7 5A               (    forth6809.asm):10864                     DECB
FFB8 26FB             (    forth6809.asm):10865                     BNE   CLRGLOB
                      (    forth6809.asm):10866         
FFBA BDD6CE           (    forth6809.asm):10867                     JSR   WLINIT            ; FIND must work for the unit tests too
                      (    forth6809.asm):10868         
FFBD BDCE9F           (    forth6809.asm):10869                     JSR   INITSERIAL
                      (    forth6809.asm):10870         
FFC0 1CAF             (    forth6809.asm):10871                     ANDCC #$AF              ; Enable IRQ & FIRQ
                      (    forth6809.asm):10872         
                      (    forth6809.asm):10873                     ; IRQ and FIRQ are unmasked above. See bugfix: COLDSTRT.1
                      (    forth6809.asm):10874         
                      (    forth6809.asm):10875                     IFNE  UNITTESTS         ; >>>>>>>>>>
                      (    forth6809.asm):10876                     JSR   TSTRUNNER
                      (    forth6809.asm):10877                     ELSE                    ; <<<<<>>>>>
FFC2 12               (    forth6809.asm):10878                     NOP                     ; same size as JSR TSTRUNNER
FFC3 12               (    forth6809.asm):10879                     NOP                     ; See bugfix: COLDSTRT.2

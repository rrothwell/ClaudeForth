                      (    forth6809.asm):05532         ; Rotate the third cell to the top.
                      (    forth6809.asm):05533         ; ------------------------------------------------------------
EAC8 ECC4             (    forth6809.asm):05534         ROTW:       LDD   ,U                ; x3
EACA AE42             (    forth6809.asm):05535                     LDX   2,U               ; x2
EACC 10AE44           (    forth6809.asm):05536                     LDY   4,U               ; x1

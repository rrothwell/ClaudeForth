D993 39               (    forth6809.asm):01968                     RTS
                      (    forth6809.asm):01969         ; ------------------------------------------------------------
                      (    forth6809.asm):01970         ; Assert RTS high (ask the sender to pause) if the input ring has
                      (    forth6809.asm):01971         ; reached INHIWATER and RTS is not already high. Called from the
                      (    forth6809.asm):01972         ; receive path with interrupts already masked.
                      (    forth6809.asm):01973         ; RTSCHECKHI
                      (    forth6809.asm):01974         ;    Inputs:
                      (    forth6809.asm):01975         ;        none
                      (    forth6809.asm):01976         ;    Outputs:
                      (    forth6809.asm):01977         ;        RTSSTATE = 1 and ACIACR = CR_RTSHI if the threshold was reached
                      (    forth6809.asm):01978         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01979         ; ------------------------------------------------------------
D994 BDD98B           (    forth6809.asm):01980         RTSCHECKHI: JSR   INFILL
D997 8130             (    forth6809.asm):01981                     CMPA  #INHIWATER
D999 250F             (    forth6809.asm):01982                     BLO   RTSCHIDONE
D99B 7D0178           (    forth6809.asm):01983                     TST   RTSSTATE
D99E 260A             (    forth6809.asm):01984                     BNE   RTSCHIDONE        ; already high - nothing to do
D9A0 86D5             (    forth6809.asm):01985                     LDA   #CR_RTSHI
D9A2 B7C008           (    forth6809.asm):01986                     STA   ACIACR
D9A5 8601             (    forth6809.asm):01987                     LDA   #1
D9A7 B70178           (    forth6809.asm):01988                     STA   RTSSTATE
D9AA 39               (    forth6809.asm):01989         RTSCHIDONE: RTS
                      (    forth6809.asm):01990         ; ------------------------------------------------------------
                      (    forth6809.asm):01991         ; Write the ACIA control byte for the current RTSSTATE and
                      (    forth6809.asm):01992         ; OUTACTIVITY: RTS high disables the Tx interrupt; RTS low
                      (    forth6809.asm):01993         ; enables it only while output is pending.
                      (    forth6809.asm):01994         ; UPDATE_RTS

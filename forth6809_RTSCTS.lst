                      (    forth6809.asm):08070         ; SECTION 20: NUMERIC OUTPUT (pictured + direct)
                      (    forth6809.asm):08071         ; ============================================================
                      (    forth6809.asm):08072         ; ------------------------------------------------------------
                      (    forth6809.asm):08073         ; <#  ( -- )
                      (    forth6809.asm):08074         ; Start a pictured numeric output string: HLD is set to the end of
                      (    forth6809.asm):08075         ; PAD. The string is built backwards from there.
                      (    forth6809.asm):08076         ; ------------------------------------------------------------
F9A9 BDDDB9           (    forth6809.asm):08077         LTNUMW:     JSR   PADW

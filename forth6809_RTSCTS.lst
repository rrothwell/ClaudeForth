                      (    forth6809.asm):05807         ; Remainder of n1 divided by n2. Division truncates toward zero; the
                      (    forth6809.asm):05808         ; remainder has the sign of the dividend. THROW -10 if the divisor is
                      (    forth6809.asm):05809         ; zero.
                      (    forth6809.asm):05810         ; ------------------------------------------------------------

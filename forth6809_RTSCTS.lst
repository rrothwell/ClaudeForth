                      (    forth6809.asm):06851         ; M*/  ( d1 n1 +n2 -- d2 )
                      (    forth6809.asm):06852         ; Multiply d1 by n1 into a 48-bit intermediate product and divide it
                      (    forth6809.asm):06853         ; by n2. The quotient is truncated toward zero (like */ and symmetric
                      (    forth6809.asm):06854         ; division in this system) and its low 32 bits are returned. THROW -10
                      (    forth6809.asm):06855         ; if n2 is zero. Method: take the magnitudes; form |d1.lo|*|n1| and
                      (    forth6809.asm):06856         ; |d1.hi|*|n1| with UMUL32 and add them into three words P2:P1:P0;
                      (    forth6809.asm):06857         ; then divide P2, then R:P1, then R:P0 by |n2| with UDIV32, each a
                      (    forth6809.asm):06858         ; 32/16 division whose quotient fits in 16 bits. The sign is applied
                      (    forth6809.asm):06859         ; to the 32-bit result at the end. See shadow M*/W.1.
                      (    forth6809.asm):06860         ; M*/W
                      (    forth6809.asm):06861         ;    Inputs:
                      (    forth6809.asm):06862         ;        d1 n1 n2 on the data stack (n2 on top)
                      (    forth6809.asm):06863         ;    Outputs:
                      (    forth6809.asm):06864         ;        d2 on the data stack
                      (    forth6809.asm):06865         ;    Registers: RegD, RegX changed; PRODHI/PRODLO, DIVDEN, DIVREM,
                      (    forth6809.asm):06866         ;        MAHI-MBLO used. S frame: 0,S sign, 1,S P0, 3,S P1, 5,S P2.
                      (    forth6809.asm):06867         ; ------------------------------------------------------------
F279                  (    forth6809.asm):06868         MSTARSLASHW:
F279 ECC4             (    forth6809.asm):06869                     LDD   ,U
F27B 2608             (    forth6809.asm):06870                     BNE   MSLOK
F27D CCFFF6           (    forth6809.asm):06871                     LDD   #-10              ; -10, division by zero
F280 3606             (    forth6809.asm):06872                     PSHU  D
F282 BDE542           (    forth6809.asm):06873                     JSR   THROWW
F285 3279             (    forth6809.asm):06874         MSLOK:      LEAS  -7,S
F287 6FE4             (    forth6809.asm):06875                     CLR   ,S                ; sign of the result
F289 ECC4             (    forth6809.asm):06876                     LDD   ,U                ; |n2|
F28B 2A09             (    forth6809.asm):06877                     BPL   MSLN1
F28D 63E4             (    forth6809.asm):06878                     COM   ,S

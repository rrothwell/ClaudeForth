EA47 3706             (    forth6809.asm):04788                     PULU  D
EA49 10830000         (    forth6809.asm):04789                     CMPD  #0
EA4D 260A             (    forth6809.asm):04790                     BNE   XCFOUND
EA4F 3706             (    forth6809.asm):04791                     PULU  D
EA51 CCFFF3           (    forth6809.asm):04792                     LDD   #-13
EA54 3606             (    forth6809.asm):04793                     PSHU  D
EA56 BDE561           (    forth6809.asm):04794                     JSR   THROWW
EA59 BDE999           (    forth6809.asm):04795         XCFOUND:    JSR   COMPILECOMMAW
EA5C 39               (    forth6809.asm):04796                     RTS

CF5B                  (    forth6809.asm):02283         CHK_INT_PATH:
CF5B 7D017B           (    forth6809.asm):02284                     TST   OUTACTIVITY       ; Is the interrupt handler transmitting?
CF5E 2619             (    forth6809.asm):02285                     BNE   PUT_EXIT          ; Yes! Exit, no action required.
                      (    forth6809.asm):02286         
                      (    forth6809.asm):02287                                             ; No! Restart.
CF60 8E01C0           (    forth6809.asm):02288                     LDX   #OUTBUF           ; Pull character from the out buffer.
CF63 F6017A           (    forth6809.asm):02289                     LDB   OUTTAIL
CF66 A685             (    forth6809.asm):02290                     LDA   B,X
CF68 B7C009           (    forth6809.asm):02291                     STA   ACIADR            ; Load the char for transmission.
                      (    forth6809.asm):02292         
CF6B 5C               (    forth6809.asm):02293                     INCB                    ; Update the tail pointer
CF6C C43F             (    forth6809.asm):02294                     ANDB  #OUTBUFSZ-1       ; to point to the next character.
CF6E F7017A           (    forth6809.asm):02295                     STB   OUTTAIL
                      (    forth6809.asm):02296         
CF71 86FF             (    forth6809.asm):02297                     LDA   #OUTBUSY          ; Flag restart of transmit interrupt handler.
CF73 B7017B           (    forth6809.asm):02298                     STA   OUTACTIVITY

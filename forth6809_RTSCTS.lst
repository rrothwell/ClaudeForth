E41A 4F               (    forth6809.asm):03539                     CLRA
E41B 3606             (    forth6809.asm):03540                     PSHU  D                 ; u
                      (    forth6809.asm):03541         
E41D BDE3B1           (    forth6809.asm):03542                     JSR   NUMLOOP
                      (    forth6809.asm):03543         
E420 ECC4             (    forth6809.asm):03544                     LDD   ,U
E422 263B             (    forth6809.asm):03545                     BNE   NQBADF            ; unconverted characters remain
E424 3344             (    forth6809.asm):03546                     LEAU  4,U               ; drop u and c-addr: ud remains
                      (    forth6809.asm):03547         
                      (    forth6809.asm):03548                     ; Negate the full 32-bit value. See bugfix: NUMBERQ.2
E426 6D62             (    forth6809.asm):03549                     TST   2,S
E428 2718             (    forth6809.asm):03550                     BEQ   NQPOS32
E42A ECC4             (    forth6809.asm):03551                     LDD   ,U
E42C 43               (    forth6809.asm):03552                     COMA
E42D 53               (    forth6809.asm):03553                     COMB
E42E EDC4             (    forth6809.asm):03554                     STD   ,U
E430 EC42             (    forth6809.asm):03555                     LDD   2,U
E432 43               (    forth6809.asm):03556                     COMA
E433 53               (    forth6809.asm):03557                     COMB
E434 C30001           (    forth6809.asm):03558                     ADDD  #1
E437 ED42             (    forth6809.asm):03559                     STD   2,U
E439 2407             (    forth6809.asm):03560                     BCC   NQPOS32
E43B ECC4             (    forth6809.asm):03561                     LDD   ,U
E43D C30001           (    forth6809.asm):03562                     ADDD  #1
E440 EDC4             (    forth6809.asm):03563                     STD   ,U
                      (    forth6809.asm):03564         
E442                  (    forth6809.asm):03565         NQPOS32:                            ; re-derive from the original c-addr whether the
                      (    forth6809.asm):03566                     ; last character was '.' - determines which return convention
E442 AEE4             (    forth6809.asm):03567                     LDX   ,S
E444 E684             (    forth6809.asm):03568                     LDB   ,X
E446 5A               (    forth6809.asm):03569                     DECB
E447 3001             (    forth6809.asm):03570                     LEAX  1,X
E449 A685             (    forth6809.asm):03571                     LDA   B,X
E44B 3263             (    forth6809.asm):03572                     LEAS  3,S
E44D 812E             (    forth6809.asm):03573                     CMPA  #'.'
E44F 2606             (    forth6809.asm):03574                     BNE   NQSINGLE
                      (    forth6809.asm):03575         
                      (    forth6809.asm):03576                     ; DOUBLE success: ud is already low below high; add a
                      (    forth6809.asm):03577                     ; distinct success code (1, not -1) so TRYNUM can tell
                      (    forth6809.asm):03578                     ; single and double apart
E451 CC0001           (    forth6809.asm):03579                     LDD   #1
E454 3606             (    forth6809.asm):03580                     PSHU  D
E456 39               (    forth6809.asm):03581                     RTS
                      (    forth6809.asm):03582         
E457 3342             (    forth6809.asm):03583         NQSINGLE:   LEAU  2,U               ; SINGLE success: drop the high cell
E459 CCFFFF           (    forth6809.asm):03584                     LDD   #-1
E45C 3606             (    forth6809.asm):03585                     PSHU  D
E45E 39               (    forth6809.asm):03586                     RTS
                      (    forth6809.asm):03587         
E45F 3348             (    forth6809.asm):03588         NQBADF:     LEAU  8,U               ; drop the frame
E461 AEE4             (    forth6809.asm):03589         NQBAD:      LDX   ,S
E463 3263             (    forth6809.asm):03590                     LEAS  3,S
E465 3610             (    forth6809.asm):03591                     PSHU  X
E467 CC0000           (    forth6809.asm):03592                     LDD   #0
E46A 3606             (    forth6809.asm):03593                     PSHU  D
E46C 39               (    forth6809.asm):03594                     RTS
                      (    forth6809.asm):03595         
                      (    forth6809.asm):03596         ; ============================================================
                      (    forth6809.asm):03597         ; SECTION 10: QUERY / ACCEPT / EXPECT / KEY / KEY? / EMIT
                      (    forth6809.asm):03598         ; ============================================================
                      (    forth6809.asm):03599                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):03600         ; Unused alternative to KEY removed; see shadow X_KEY.1.
                      (    forth6809.asm):03601         
                      (    forth6809.asm):03602         ; ------------------------------------------------------------
                      (    forth6809.asm):03603         ; KEY  ( -- char )
                      (    forth6809.asm):03604         ; Wait for the next received character and return it. While waiting,
                      (    forth6809.asm):03605         ; drain the output ring by polling if RTS is high.
                      (    forth6809.asm):03606         ; ------------------------------------------------------------
E46D                  (    forth6809.asm):03607         KEYW:
                      (    forth6809.asm):03608         
E46D 7D0178           (    forth6809.asm):03609                     TST   RTSSTATE          ; Is throttling?
E470 2703             (    forth6809.asm):03610                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):03611         
                      (    forth6809.asm):03612                     ; IRQ stays unmasked during the flush. See bugfix: KEYW.1
E472 BDDC7E           (    forth6809.asm):03613                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):03614                                             ; by transmitting all chars.
                      (    forth6809.asm):03615         
E475                  (    forth6809.asm):03616         TRY_READ:
E475 BDDCEB           (    forth6809.asm):03617                     JSR   GETCHAR           ; Is char available in input buffer.
E478 25F3             (    forth6809.asm):03618                     BCS   KEYW              ; No? Try again to receive a char,
                      (    forth6809.asm):03619                                             ; while still transmitting!
                      (    forth6809.asm):03620         
E47A 1F89             (    forth6809.asm):03621                     TFR   A,B               ; Move char result to Reg B (LSB of D)
E47C 4F               (    forth6809.asm):03622                     CLRA                    ; Clear MSB.
E47D 3606             (    forth6809.asm):03623                     PSHU  D                 ; char
                      (    forth6809.asm):03624         
E47F 39               (    forth6809.asm):03625                     RTS
                      (    forth6809.asm):03626         
                      (    forth6809.asm):03627         ; ------------------------------------------------------------
                      (    forth6809.asm):03628         ; KEY?  ( -- flag )
                      (    forth6809.asm):03629         ; Return true if a received character is waiting in the input ring.
                      (    forth6809.asm):03630         ; ------------------------------------------------------------
E480                  (    forth6809.asm):03631         KEYQW:
                      (    forth6809.asm):03632                     ; Commented-out code moved to shadow: KEYQW.1
                      (    forth6809.asm):03633         
E480 B60176           (    forth6809.asm):03634                     LDA   INHEAD            ; Characters received?
E483 B10177           (    forth6809.asm):03635                     CMPA  INTAIL
                      (    forth6809.asm):03636         
                      (    forth6809.asm):03637                     ; Commented-out code moved to shadow: KEYQW.2
                      (    forth6809.asm):03638         
E486 2606             (    forth6809.asm):03639                     BNE   KQTRUE            ; Yes!
                      (    forth6809.asm):03640         
E488 CC0000           (    forth6809.asm):03641                     LDD   #FALSEV           ; No! Return false result.
E48B 3606             (    forth6809.asm):03642                     PSHU  D                 ; flag = false
                      (    forth6809.asm):03643         
E48D 39               (    forth6809.asm):03644                     RTS
                      (    forth6809.asm):03645         
E48E                  (    forth6809.asm):03646         KQTRUE:
E48E CCFFFF           (    forth6809.asm):03647                     LDD   #TRUEV            ; Yes! Return true result.
E491 3606             (    forth6809.asm):03648                     PSHU  D                 ; flag = true
E493 39               (    forth6809.asm):03649                     RTS
                      (    forth6809.asm):03650         
                      (    forth6809.asm):03651         ; Unused alternative to EMIT removed; see shadow X_EMIT.1.
                      (    forth6809.asm):03652         
                      (    forth6809.asm):03653         ; ------------------------------------------------------------
                      (    forth6809.asm):03654         ; EMIT  ( char -- )
                      (    forth6809.asm):03655         ; Transmit char through PUTCHAR (the output ring). The character is
                      (    forth6809.asm):03656         ; discarded if the ring is full.
                      (    forth6809.asm):03657         ; ------------------------------------------------------------
E494                  (    forth6809.asm):03658         EMITW:
E494 3706             (    forth6809.asm):03659                     PULU  D                 ; char
E496 1F98             (    forth6809.asm):03660                     TFR   B,A
E498 BDDCA0           (    forth6809.asm):03661                     JSR   PUTCHAR           ; Transmit char.
E49B 39               (    forth6809.asm):03662                     RTS
                      (    forth6809.asm):03663         
                      (    forth6809.asm):03664                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):03665         ; ------------------------------------------------------------
                      (    forth6809.asm):03666         ; KEY  ( -- char )  [polling build, SERIALPOLL=1]
                      (    forth6809.asm):03667         ; Wait for RDRF and return the received character. There are no ring
                      (    forth6809.asm):03668         ; buffers, interrupts or hardware handshaking in this build; ACCEPT
                      (    forth6809.asm):03669         ; uses software XON/XOFF instead. Framing, overrun and parity errors
                      (    forth6809.asm):03670         ; are counted in FECOUNT, OVRNCOUNT and PECOUNT, and POLLREADYCNT
                      (    forth6809.asm):03671         ; counts characters already waiting when KEY was called.
                      (    forth6809.asm):03672         ; Original comment: shadow KEYW.2. KEY?, EMIT, PUTXON and PUTXOFF
                      (    forth6809.asm):03673         ; follow.
                      (    forth6809.asm):03674         ; ------------------------------------------------------------
E49C                  (    forth6809.asm):03675         KEYW:
                      (    forth6809.asm):03676                     LDA   ACIASR
                      (    forth6809.asm):03677                     BITA  #SR_RDRF
                      (    forth6809.asm):03678                     BEQ   KWAIT
                      (    forth6809.asm):03679                     INC   POLLREADYCNT      ; character was already queued when we
                      (    forth6809.asm):03680                     BRA   KGOTSTAT          ; came back to poll - didn't need to wait
E49C                  (    forth6809.asm):03681         KWAIT:
E49C                  (    forth6809.asm):03682         KSPIN:      LDA   ACIASR
                      (    forth6809.asm):03683                     BITA  #SR_RDRF
                      (    forth6809.asm):03684                     BEQ   KSPIN
E49C                  (    forth6809.asm):03685         KGOTSTAT:                           ; A holds the status byte exactly as it was
                      (    forth6809.asm):03686                                             ; when RDRF first went true - check the
                      (    forth6809.asm):03687                                             ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):03688                                             ; read, since reading ACIADR below clears
                      (    forth6809.asm):03689                                             ; RDRF and the latched error bits together
                      (    forth6809.asm):03690                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):03691                     BEQ   KGETCH
                      (    forth6809.asm):03692                     BITA  #SR_FE
                      (    forth6809.asm):03693                     BEQ   KXFE
                      (    forth6809.asm):03694                     INC   FECOUNT
E49C                  (    forth6809.asm):03695         KXFE:       BITA  #SR_OVRN
                      (    forth6809.asm):03696                     BEQ   KXOVRN
                      (    forth6809.asm):03697                     INC   OVRNCOUNT
E49C                  (    forth6809.asm):03698         KXOVRN:     BITA  #SR_PE
                      (    forth6809.asm):03699                     BEQ   KGETCH
                      (    forth6809.asm):03700                     INC   PECOUNT
E49C                  (    forth6809.asm):03701         KGETCH:     LDA   ACIADR
                      (    forth6809.asm):03702                     TFR   A,B
                      (    forth6809.asm):03703                     CLRA
                      (    forth6809.asm):03704                     PSHU  D                 ; char
                      (    forth6809.asm):03705                     RTS
                      (    forth6809.asm):03706         
                      (    forth6809.asm):03707         ; ------------------------------------------------------------
                      (    forth6809.asm):03708         ; Send the software flow-control character XOFF (PUTXOFF) or XON
                      (    forth6809.asm):03709         ; (PUTXON) straight to the ACIA, waiting for TDRE. The data stack is
                      (    forth6809.asm):03710         ; not touched, so ACCEPT can call these at any point.
                      (    forth6809.asm):03711         ; PUTXON / PUTXOFF
                      (    forth6809.asm):03712         ;    Inputs:
                      (    forth6809.asm):03713         ;        none
                      (    forth6809.asm):03714         ;    Outputs:
                      (    forth6809.asm):03715         ;        XON or XOFF transmitted
                      (    forth6809.asm):03716         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):03717         ; Original comment: shadow PUTXON.0.
                      (    forth6809.asm):03718         ; ------------------------------------------------------------
E49C                  (    forth6809.asm):03719         PUTXOFF:    LDA   #XOFFCH
                      (    forth6809.asm):03720                     BRA   PUTXCH
E49C                  (    forth6809.asm):03721         PUTXON:     LDA   #XONCH
E49C                  (    forth6809.asm):03722         PUTXCH:     PSHS  A
E49C                  (    forth6809.asm):03723         PXWT:       LDB   ACIASR
                      (    forth6809.asm):03724                     BITB  #SR_TDRE
                      (    forth6809.asm):03725                     BEQ   PXWT
                      (    forth6809.asm):03726                     PULS  A
                      (    forth6809.asm):03727                     STA   ACIADR
                      (    forth6809.asm):03728                     RTS
                      (    forth6809.asm):03729         
                      (    forth6809.asm):03730         ; ------------------------------------------------------------
                      (    forth6809.asm):03731         ; KEY?  ( -- flag )  [polling build]
                      (    forth6809.asm):03732         ; Return true if the ACIA has a received character (RDRF set).
                      (    forth6809.asm):03733         ; ------------------------------------------------------------
E49C                  (    forth6809.asm):03734         KEYQW:      LDA   ACIASR
                      (    forth6809.asm):03735                     BITA  #SR_RDRF
                      (    forth6809.asm):03736                     BEQ   KQFALSE
                      (    forth6809.asm):03737                     LDD   #TRUEV
                      (    forth6809.asm):03738                     PSHU  D                 ; flag = true
                      (    forth6809.asm):03739                     RTS
E49C                  (    forth6809.asm):03740         KQFALSE:    LDD   #FALSEV
                      (    forth6809.asm):03741                     PSHU  D                 ; flag = false
                      (    forth6809.asm):03742                     RTS
                      (    forth6809.asm):03743         
                      (    forth6809.asm):03744         ; ------------------------------------------------------------
                      (    forth6809.asm):03745         ; EMIT  ( char -- )  [polling build]
                      (    forth6809.asm):03746         ; Wait for TDRE, then transmit char directly.
                      (    forth6809.asm):03747         ; ------------------------------------------------------------
E49C                  (    forth6809.asm):03748         EMITW:      PULU  D                 ; char
                      (    forth6809.asm):03749                     STB   EMITCH
E49C                  (    forth6809.asm):03750         EMITWT:     LDA   ACIASR
                      (    forth6809.asm):03751                     BITA  #SR_TDRE
                      (    forth6809.asm):03752                     BEQ   EMITWT
                      (    forth6809.asm):03753                     LDA   EMITCH
                      (    forth6809.asm):03754                     STA   ACIADR
                      (    forth6809.asm):03755                     RTS
                      (    forth6809.asm):03756         
                      (    forth6809.asm):03757                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):03758         
                      (    forth6809.asm):03759         ; ------------------------------------------------------------
                      (    forth6809.asm):03760         ; ACCEPT  ( c-addr +n1 -- +n2 )
                      (    forth6809.asm):03761         ; Read a line of up to +n1 characters into the buffer at c-addr,
                      (    forth6809.asm):03762         ; echoing as it goes. Backspace and DEL erase the last character; LF
                      (    forth6809.asm):03763         ; is ignored; CR ends the line. Returns the count +n2.
                      (    forth6809.asm):03764         ; ------------------------------------------------------------
E49C 335E             (    forth6809.asm):03765         ACCEPTW:    LEAU  -2,U              ; local count at 0,U; then +n1 at 2,U and
E49E CC0000           (    forth6809.asm):03766                     LDD   #0                ; c-addr at 4,U. See shadow ACCEPTW.5
E4A1 EDC4             (    forth6809.asm):03767                     STD   ,U
                      (    forth6809.asm):03768         
                      (    forth6809.asm):03769                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: real
                      (    forth6809.asm):03770                                             ; RTS/CTS hardware flow control already
                      (    forth6809.asm):03771                                             ; covers this, nothing extra needed
                      (    forth6809.asm):03772                     ELSE                    ; <<<<<>>>>>  polling build: tell the host it's safe to
                      (    forth6809.asm):03773                                             ; stream this line's characters
                      (    forth6809.asm):03774                     JSR   PUTXON
                      (    forth6809.asm):03775                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):03776         
E4A3 BDE46D           (    forth6809.asm):03777         ALOOP:      JSR   KEYW
E4A6 3706             (    forth6809.asm):03778                     PULU  D
E4A8 1F02             (    forth6809.asm):03779                     TFR   D,Y               ; Y = the character
                      (    forth6809.asm):03780         
E4AA C10D             (    forth6809.asm):03781                     CMPB  #13
E4AC 274F             (    forth6809.asm):03782                     BEQ   ADONE
E4AE C10A             (    forth6809.asm):03783                     CMPB  #10
E4B0 27F1             (    forth6809.asm):03784                     BEQ   ALOOP
E4B2 C108             (    forth6809.asm):03785                     CMPB  #8
E4B4 2724             (    forth6809.asm):03786                     BEQ   ABKSP
E4B6 C17F             (    forth6809.asm):03787                     CMPB  #127
E4B8 2720             (    forth6809.asm):03788                     BEQ   ABKSP
                      (    forth6809.asm):03789         
E4BA ECC4             (    forth6809.asm):03790                     LDD   ,U
E4BC 10A342           (    forth6809.asm):03791                     CMPD  2,U
E4BF 27E2             (    forth6809.asm):03792                     BEQ   ALOOP
                      (    forth6809.asm):03793         
E4C1 AE44             (    forth6809.asm):03794                     LDX   4,U
E4C3 308B             (    forth6809.asm):03795                     LEAX  D,X
E4C5 1F20             (    forth6809.asm):03796                     TFR   Y,D
E4C7 E784             (    forth6809.asm):03797                     STB   ,X
E4C9 ECC4             (    forth6809.asm):03798                     LDD   ,U
E4CB C30001           (    forth6809.asm):03799                     ADDD  #1
E4CE EDC4             (    forth6809.asm):03800                     STD   ,U
                      (    forth6809.asm):03801         
E4D0 1F20             (    forth6809.asm):03802                     TFR   Y,D
E4D2 4F               (    forth6809.asm):03803                     CLRA
E4D3 3606             (    forth6809.asm):03804                     PSHU  D
E4D5 BDE494           (    forth6809.asm):03805                     JSR   EMITW
E4D8 20C9             (    forth6809.asm):03806                     BRA   ALOOP
                      (    forth6809.asm):03807         
E4DA ECC4             (    forth6809.asm):03808         ABKSP:      LDD   ,U
E4DC 27C5             (    forth6809.asm):03809                     BEQ   ALOOP
E4DE 830001           (    forth6809.asm):03810                     SUBD  #1
E4E1 EDC4             (    forth6809.asm):03811                     STD   ,U
E4E3 CC0008           (    forth6809.asm):03812                     LDD   #8
E4E6 3606             (    forth6809.asm):03813                     PSHU  D
E4E8 BDE494           (    forth6809.asm):03814                     JSR   EMITW
E4EB CC0020           (    forth6809.asm):03815                     LDD   #32
E4EE 3606             (    forth6809.asm):03816                     PSHU  D
E4F0 BDE494           (    forth6809.asm):03817                     JSR   EMITW
E4F3 CC0008           (    forth6809.asm):03818                     LDD   #8
E4F6 3606             (    forth6809.asm):03819                     PSHU  D
E4F8 BDE494           (    forth6809.asm):03820                     JSR   EMITW
E4FB 20A6             (    forth6809.asm):03821                     BRA   ALOOP
                      (    forth6809.asm):03822         
E4FD                  (    forth6809.asm):03823         ADONE:
                      (    forth6809.asm):03824                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: nothing
                      (    forth6809.asm):03825                                             ; extra needed, see ACCEPT's entry above
                      (    forth6809.asm):03826                     ELSE                    ; <<<<<>>>>>  polling build: the line is complete - tell
                      (    forth6809.asm):03827                                             ; the host to pause before INTERPRET runs
                      (    forth6809.asm):03828                                             ; with KEY never polled at all
                      (    forth6809.asm):03829                     JSR   PUTXOFF
                      (    forth6809.asm):03830                     ENDC                    ; <<<<<<<<<<
E4FD ECC4             (    forth6809.asm):03831                     LDD   ,U
E4FF ED44             (    forth6809.asm):03832                     STD   4,U               ; +n2
E501 3344             (    forth6809.asm):03833                     LEAU  4,U
E503 39               (    forth6809.asm):03834                     RTS
                      (    forth6809.asm):03835         
                      (    forth6809.asm):03836         ; ------------------------------------------------------------
                      (    forth6809.asm):03837         ; EXPECT  ( c-addr +n -- )
                      (    forth6809.asm):03838         ; Read a line as ACCEPT does and store the count in SPAN.
                      (    forth6809.asm):03839         ; ------------------------------------------------------------
E504 BDE49C           (    forth6809.asm):03840         EXPECTW:    JSR   ACCEPTW
E507 3706             (    forth6809.asm):03841                     PULU  D
E509 DD3F             (    forth6809.asm):03842                     STD   SPAN
E50B 39               (    forth6809.asm):03843                     RTS
                      (    forth6809.asm):03844         
                      (    forth6809.asm):03845         ; ------------------------------------------------------------
                      (    forth6809.asm):03846         ; QUERY  ( -- )
                      (    forth6809.asm):03847         ; Read a line into the terminal input buffer and make it the input
                      (    forth6809.asm):03848         ; source: set NTIB and SRCLEN to its length, SRCADDR to TIBBUF, SRCID
                      (    forth6809.asm):03849         ; to 0 and >IN to 0.
                      (    forth6809.asm):03850         ; ------------------------------------------------------------
E50C 8E0106           (    forth6809.asm):03851         QUERYW:     LDX   #TIBBUF
E50F 3610             (    forth6809.asm):03852                     PSHU  X
E511 CC0050           (    forth6809.asm):03853                     LDD   #TIBBUFL
E514 3606             (    forth6809.asm):03854                     PSHU  D
E516 BDE49C           (    forth6809.asm):03855                     JSR   ACCEPTW
E519 3706             (    forth6809.asm):03856                     PULU  D
E51B DD12             (    forth6809.asm):03857                     STD   NTIB
E51D DD3B             (    forth6809.asm):03858                     STD   SRCLEN
E51F CC0106           (    forth6809.asm):03859                     LDD   #TIBBUF
E522 DD39             (    forth6809.asm):03860                     STD   SRCADDR
E524 CC0000           (    forth6809.asm):03861                     LDD   #0
E527 DD3D             (    forth6809.asm):03862                     STD   SRCID
E529 DD10             (    forth6809.asm):03863                     STD   TOIN
E52B 39               (    forth6809.asm):03864                     RTS
                      (    forth6809.asm):03865         
                      (    forth6809.asm):03866         ; ============================================================
                      (    forth6809.asm):03867         ; SECTION 11: EXCEPTIONS (CFERR, CATCH, THROW)
                      (    forth6809.asm):03868         ; ============================================================
                      (    forth6809.asm):03869         ; ------------------------------------------------------------
                      (    forth6809.asm):03870         ; Report a control-structure mismatch: throw -22. Called by the
                      (    forth6809.asm):03871         ; control-flow words when the tag on the control-flow stack is not the
                      (    forth6809.asm):03872         ; one expected.
                      (    forth6809.asm):03873         ; CFERR
                      (    forth6809.asm):03874         ;    Inputs:
                      (    forth6809.asm):03875         ;        none
                      (    forth6809.asm):03876         ;    Outputs:
                      (    forth6809.asm):03877         ;        does not return (THROW -22)
                      (    forth6809.asm):03878         ;    Registers: RegD changed; THROW decides the rest.
                      (    forth6809.asm):03879         ; ------------------------------------------------------------
E52C CCFFEA           (    forth6809.asm):03880         CFERR:      LDD   #-22
E52F 3606             (    forth6809.asm):03881                     PSHU  D                 ; -22
E531 BDE561           (    forth6809.asm):03882                     JSR   THROWW
E534 39               (    forth6809.asm):03883                     RTS
                      (    forth6809.asm):03884         
                      (    forth6809.asm):03885         ; ------------------------------------------------------------
                      (    forth6809.asm):03886         ; CATCH  ( i*x xt -- j*x 0 | i*x n )
                      (    forth6809.asm):03887         ; Execute xt with an exception frame in place. On normal return push
                      (    forth6809.asm):03888         ; 0. If xt (or anything it calls) executes THROW with a non-zero n,
                      (    forth6809.asm):03889         ; THROW unwinds to this frame and CATCH returns n.
                      (    forth6809.asm):03890         ; Frame on S, top first: >IN, SRCID, SRCLEN, SRCADDR, saved U,
                      (    forth6809.asm):03891         ; previous HANDLER. HANDLER points at the >IN cell.
                      (    forth6809.asm):03892         ; ------------------------------------------------------------
E535 3710             (    forth6809.asm):03893         CATCHW:     PULU  X                 ; xt
E537 DC0C             (    forth6809.asm):03894                     LDD   HANDLER
E539 3406             (    forth6809.asm):03895                     PSHS  D
E53B 3440             (    forth6809.asm):03896                     PSHS  U
                      (    forth6809.asm):03897                     ; Save the input source specification.
                      (    forth6809.asm):03898                     ; See bugfix: CATCHW.1
E53D DC39             (    forth6809.asm):03899                     LDD   SRCADDR
E53F 3406             (    forth6809.asm):03900                     PSHS  D
E541 DC3B             (    forth6809.asm):03901                     LDD   SRCLEN
E543 3406             (    forth6809.asm):03902                     PSHS  D
E545 DC3D             (    forth6809.asm):03903                     LDD   SRCID
E547 3406             (    forth6809.asm):03904                     PSHS  D
E549 DC10             (    forth6809.asm):03905                     LDD   TOIN
E54B 3406             (    forth6809.asm):03906                     PSHS  D
E54D 1F40             (    forth6809.asm):03907                     TFR   S,D
E54F DD0C             (    forth6809.asm):03908                     STD   HANDLER
                      (    forth6809.asm):03909         
E551 AD84             (    forth6809.asm):03910                     JSR   ,X
                      (    forth6809.asm):03911         
E553 3268             (    forth6809.asm):03912                     LEAS  8,S               ; drop saved input source
E555 3262             (    forth6809.asm):03913                     LEAS  2,S               ; saved U
E557 3506             (    forth6809.asm):03914                     PULS  D
E559 DD0C             (    forth6809.asm):03915                     STD   HANDLER
E55B CC0000           (    forth6809.asm):03916                     LDD   #0
E55E 3606             (    forth6809.asm):03917                     PSHU  D                 ; 0 = no exception
E560 39               (    forth6809.asm):03918                     RTS
                      (    forth6809.asm):03919         
                      (    forth6809.asm):03920         ; ------------------------------------------------------------
                      (    forth6809.asm):03921         ; THROW  ( k*x n -- k*x | i*x n )
                      (    forth6809.asm):03922         ; If n is zero, do nothing. Otherwise restore the state saved by the
                      (    forth6809.asm):03923         ; most recent CATCH (S, U, input source, >IN, HANDLER) and make that
                      (    forth6809.asm):03924         ; CATCH return n. With no CATCH active, push n and ABORT.
                      (    forth6809.asm):03925         ; ------------------------------------------------------------
E561 3706             (    forth6809.asm):03926         THROWW:     PULU  D                 ; n
E563 10830000         (    forth6809.asm):03927                     CMPD  #0
E567 2725             (    forth6809.asm):03928                     BEQ   THDONE
                      (    forth6809.asm):03929         
E569 DD0E             (    forth6809.asm):03930                     STD   THROWN
E56B 9E0C             (    forth6809.asm):03931                     LDX   HANDLER
E56D 2720             (    forth6809.asm):03932                     BEQ   THUNCAU
                      (    forth6809.asm):03933         
E56F 1F14             (    forth6809.asm):03934                     TFR   X,S
E571 3506             (    forth6809.asm):03935                     PULS  D                 ; restore input source saved by CATCH
E573 DD10             (    forth6809.asm):03936                     STD   TOIN
E575 3506             (    forth6809.asm):03937                     PULS  D
E577 DD3D             (    forth6809.asm):03938                     STD   SRCID
E579 3506             (    forth6809.asm):03939                     PULS  D
E57B DD3B             (    forth6809.asm):03940                     STD   SRCLEN
E57D 3506             (    forth6809.asm):03941                     PULS  D
E57F DD39             (    forth6809.asm):03942                     STD   SRCADDR
E581 3506             (    forth6809.asm):03943                     PULS  D
E583 1F03             (    forth6809.asm):03944                     TFR   D,U
E585 3506             (    forth6809.asm):03945                     PULS  D
E587 DD0C             (    forth6809.asm):03946                     STD   HANDLER
                      (    forth6809.asm):03947         
E589 DC0E             (    forth6809.asm):03948                     LDD   THROWN
E58B 3606             (    forth6809.asm):03949                     PSHU  D
E58D 39               (    forth6809.asm):03950                     RTS
E58E 39               (    forth6809.asm):03951         THDONE:     RTS
                      (    forth6809.asm):03952         
                      (    forth6809.asm):03953                     ; No CATCH is active: leave n on the stack and ABORT.
E58F DC0E             (    forth6809.asm):03954         THUNCAU:    LDD   THROWN
E591 3606             (    forth6809.asm):03955                     PSHU  D
E593 7EDDEF           (    forth6809.asm):03956                     JMP   ABORT
                      (    forth6809.asm):03957         
                      (    forth6809.asm):03958         ; ============================================================
                      (    forth6809.asm):03959         ; SECTION 12: CONTROL FLOW (IF/THEN/ELSE, BEGIN family,
                      (    forth6809.asm):03960         ; DO/LOOP/+LOOP/I/J/LEAVE/UNLOOP/?DO, EXIT, CASE family)
                      (    forth6809.asm):03961         ; ============================================================
                      (    forth6809.asm):03962         ; ------------------------------------------------------------
                      (    forth6809.asm):03963         ; Store a branch displacement: the cell at location receives target -
                      (    forth6809.asm):03964         ; location.
                      (    forth6809.asm):03965         ; PATCH   ( target location -- )
                      (    forth6809.asm):03966         ;    Inputs:
                      (    forth6809.asm):03967         ;        target and location on the data stack (location on top)
                      (    forth6809.asm):03968         ;    Outputs:
                      (    forth6809.asm):03969         ;        the cell at location holds target - location
                      (    forth6809.asm):03970         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):03971         ; ------------------------------------------------------------
E596 3710             (    forth6809.asm):03972         PATCH:      PULU  X                 ; location
E598 3706             (    forth6809.asm):03973                     PULU  D                 ; target
E59A 3410             (    forth6809.asm):03974                     PSHS  X
E59C A3E1             (    forth6809.asm):03975                     SUBD  ,S++              ; target - location
E59E ED84             (    forth6809.asm):03976                     STD   ,X
E5A0 39               (    forth6809.asm):03977                     RTS
                      (    forth6809.asm):03978         
                      (    forth6809.asm):03979         ; ------------------------------------------------------------
                      (    forth6809.asm):03980         ; IF  ( C: -- orig )
                      (    forth6809.asm):03981         ; Compile ZBRANCH with a placeholder operand. Leave the operand
                      (    forth6809.asm):03982         ; address and TAGFWD on the control-flow stack for ELSE or THEN.
                      (    forth6809.asm):03983         ; ------------------------------------------------------------
E5A1 CCDE9C           (    forth6809.asm):03984         IFW:        LDD   #ZBRANCH
E5A4 3606             (    forth6809.asm):03985                     PSHU  D
E5A6 BDE99C           (    forth6809.asm):03986                     JSR   CCALL
E5A9 CC0000           (    forth6809.asm):03987                     LDD   #0
E5AC 3606             (    forth6809.asm):03988                     PSHU  D
E5AE BDDF26           (    forth6809.asm):03989                     JSR   CODECOMMA
E5B1 DC08             (    forth6809.asm):03990                     LDD   CODEHERE
E5B3 830002           (    forth6809.asm):03991                     SUBD  #2
E5B6 3606             (    forth6809.asm):03992                     PSHU  D                 ; orig
E5B8 CC0001           (    forth6809.asm):03993                     LDD   #TAGFWD
E5BB 3606             (    forth6809.asm):03994                     PSHU  D
E5BD 39               (    forth6809.asm):03995                     RTS
                      (    forth6809.asm):03996         
                      (    forth6809.asm):03997         ; ------------------------------------------------------------
                      (    forth6809.asm):03998         ; THEN  ( C: orig -- )
                      (    forth6809.asm):03999         ; Resolve the forward branch left by IF, ELSE or WHILE: patch its
                      (    forth6809.asm):04000         ; operand to jump to the current code address.
                      (    forth6809.asm):04001         ; ------------------------------------------------------------
E5BE 3706             (    forth6809.asm):04002         THENW:      PULU  D
E5C0 10830001         (    forth6809.asm):04003                     CMPD  #TAGFWD
E5C4 2703             (    forth6809.asm):04004                     BEQ   THOK
E5C6 BDE52C           (    forth6809.asm):04005                     JSR   CFERR
E5C9 3710             (    forth6809.asm):04006         THOK:       PULU  X                 ; orig
E5CB DC08             (    forth6809.asm):04007                     LDD   CODEHERE
E5CD 3606             (    forth6809.asm):04008                     PSHU  D
E5CF 3610             (    forth6809.asm):04009                     PSHU  X
E5D1 BDE596           (    forth6809.asm):04010                     JSR   PATCH
E5D4 39               (    forth6809.asm):04011                     RTS
                      (    forth6809.asm):04012         
                      (    forth6809.asm):04013         ; ------------------------------------------------------------
                      (    forth6809.asm):04014         ; ELSE  ( C: orig1 -- orig2 )
                      (    forth6809.asm):04015         ; Compile BRANCH with a placeholder operand, resolve orig1 to the
                      (    forth6809.asm):04016         ; address just after it, and leave the new operand address and TAGFWD.
                      (    forth6809.asm):04017         ; ------------------------------------------------------------
E5D5 3706             (    forth6809.asm):04018         ELSEW:      PULU  D
E5D7 10830001         (    forth6809.asm):04019                     CMPD  #TAGFWD
E5DB 2703             (    forth6809.asm):04020                     BEQ   ELOK
E5DD BDE52C           (    forth6809.asm):04021                     JSR   CFERR
E5E0 3706             (    forth6809.asm):04022         ELOK:       PULU  D                 ; orig1
E5E2 3406             (    forth6809.asm):04023                     PSHS  D                 ; See bugfix: ELSEW.1 (5k: kept on S)
E5E4 CCDEB2           (    forth6809.asm):04024                     LDD   #BRANCH
E5E7 3606             (    forth6809.asm):04025                     PSHU  D
E5E9 BDE99C           (    forth6809.asm):04026                     JSR   CCALL
E5EC CC0000           (    forth6809.asm):04027                     LDD   #0
E5EF 3606             (    forth6809.asm):04028                     PSHU  D
E5F1 BDDF26           (    forth6809.asm):04029                     JSR   CODECOMMA
E5F4 DC08             (    forth6809.asm):04030                     LDD   CODEHERE
E5F6 3606             (    forth6809.asm):04031                     PSHU  D
E5F8 3506             (    forth6809.asm):04032                     PULS  D                 ; orig1
E5FA 3606             (    forth6809.asm):04033                     PSHU  D
E5FC BDE596           (    forth6809.asm):04034                     JSR   PATCH
E5FF DC08             (    forth6809.asm):04035                     LDD   CODEHERE
E601 830002           (    forth6809.asm):04036                     SUBD  #2
E604 3606             (    forth6809.asm):04037                     PSHU  D                 ; orig2
E606 CC0001           (    forth6809.asm):04038                     LDD   #TAGFWD
E609 3606             (    forth6809.asm):04039                     PSHU  D
E60B 39               (    forth6809.asm):04040                     RTS
                      (    forth6809.asm):04041         
                      (    forth6809.asm):04042         ; ------------------------------------------------------------
                      (    forth6809.asm):04043         ; BEGIN  ( C: -- dest )
                      (    forth6809.asm):04044         ; Leave the current code address and TAGBACK on the control-flow
                      (    forth6809.asm):04045         ; stack.
                      (    forth6809.asm):04046         ; ------------------------------------------------------------
E60C DC08             (    forth6809.asm):04047         BEGINW:     LDD   CODEHERE
E60E 3606             (    forth6809.asm):04048                     PSHU  D                 ; dest
E610 CC0002           (    forth6809.asm):04049                     LDD   #TAGBACK
E613 3606             (    forth6809.asm):04050                     PSHU  D
E615 39               (    forth6809.asm):04051                     RTS
                      (    forth6809.asm):04052         
                      (    forth6809.asm):04053         ; ------------------------------------------------------------
                      (    forth6809.asm):04054         ; UNTIL  ( C: dest -- )
                      (    forth6809.asm):04055         ; Compile ZBRANCH with a displacement back to dest.
                      (    forth6809.asm):04056         ; ------------------------------------------------------------
E616 3706             (    forth6809.asm):04057         UNTILW:     PULU  D
E618 10830002         (    forth6809.asm):04058                     CMPD  #TAGBACK
E61C 2703             (    forth6809.asm):04059                     BEQ   UNOK
E61E BDE52C           (    forth6809.asm):04060                     JSR   CFERR
E621 3706             (    forth6809.asm):04061         UNOK:       PULU  D                 ; dest
E623 3606             (    forth6809.asm):04062                     PSHU  D                 ; park dest. See bugfix: UNTILW.1
E625 CCDE9C           (    forth6809.asm):04063                     LDD   #ZBRANCH
E628 3606             (    forth6809.asm):04064                     PSHU  D
E62A BDE99C           (    forth6809.asm):04065                     JSR   CCALL
E62D CC0000           (    forth6809.asm):04066                     LDD   #0
E630 3606             (    forth6809.asm):04067                     PSHU  D
E632 BDDF26           (    forth6809.asm):04068                     JSR   CODECOMMA

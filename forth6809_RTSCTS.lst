                      (    forth6809.asm):04611         ; LITERAL/[']/POSTPONE/>BODY, SLITERAL, ABORT")
                      (    forth6809.asm):04612         ; ============================================================
                      (    forth6809.asm):04613         ; ------------------------------------------------------------
                      (    forth6809.asm):04614         ; STATE  ( -- a-addr )

                      (    forth6809.asm):05448         ; ============================================================
                      (    forth6809.asm):05449         ; SECTION 13: COMPILING WORDS (IMMEDIATE/[/]/'/COMPILE,/
                      (    forth6809.asm):05450         ; LITERAL/[']/POSTPONE/>BODY, SLITERAL, ABORT")
                      (    forth6809.asm):05451         ; ============================================================
                      (    forth6809.asm):05452         ; ------------------------------------------------------------
                      (    forth6809.asm):05453         ; STATE  ( -- a-addr )
                      (    forth6809.asm):05454         ; Push the address of the STATE variable.
                      (    forth6809.asm):05455         ; ------------------------------------------------------------
DE60 CC0000           (    forth6809.asm):05456         STATEW:     LDD   #STATE
DE63 3606             (    forth6809.asm):05457                     PSHU  D                 ; a-addr
DE65 39               (    forth6809.asm):05458                     RTS
                      (    forth6809.asm):05459         
                      (    forth6809.asm):05460         ; ------------------------------------------------------------
                      (    forth6809.asm):05461         ; IMMEDIATE  ( -- )
                      (    forth6809.asm):05462         ; Set the immediate flag ($80) in the length byte of the most recent
                      (    forth6809.asm):05463         ; definition (LATEST).
                      (    forth6809.asm):05464         ; ------------------------------------------------------------
DE66 9E04             (    forth6809.asm):05465         IMMEDIATEW: LDX   LATEST
DE68 A684             (    forth6809.asm):05466                     LDA   ,X
DE6A 8A80             (    forth6809.asm):05467                     ORA   #$80
DE6C A784             (    forth6809.asm):05468                     STA   ,X
DE6E 39               (    forth6809.asm):05469                     RTS
                      (    forth6809.asm):05470         
                      (    forth6809.asm):05471         ; ------------------------------------------------------------
                      (    forth6809.asm):05472         ; [  ( -- )
                      (    forth6809.asm):05473         ; Enter interpretation state: STATE = 0.
                      (    forth6809.asm):05474         ; ------------------------------------------------------------
DE6F CC0000           (    forth6809.asm):05475         LBRACKETW:  LDD   #0
DE72 DD00             (    forth6809.asm):05476                     STD   STATE
DE74 39               (    forth6809.asm):05477                     RTS
                      (    forth6809.asm):05478         
                      (    forth6809.asm):05479         ; ------------------------------------------------------------
                      (    forth6809.asm):05480         ; ]  ( -- )
                      (    forth6809.asm):05481         ; Enter compilation state: STATE = -1.
                      (    forth6809.asm):05482         ; ------------------------------------------------------------
DE75 CCFFFF           (    forth6809.asm):05483         RBRACKETW:  LDD   #-1
DE78 DD00             (    forth6809.asm):05484                     STD   STATE
DE7A 39               (    forth6809.asm):05485                     RTS
                      (    forth6809.asm):05486         
                      (    forth6809.asm):05487         ; ------------------------------------------------------------
                      (    forth6809.asm):05488         ; '  ( "name" -- xt )
                      (    forth6809.asm):05489         ; Parse the next blank-delimited name and return its xt. THROW -13 if
                      (    forth6809.asm):05490         ; the name is not found.
                      (    forth6809.asm):05491         ; ------------------------------------------------------------
DE7B CC0020           (    forth6809.asm):05492         TICKW:      LDD   #32
DE7E 3606             (    forth6809.asm):05493                     PSHU  D                 ; BL delimiter
DE80 BDD503           (    forth6809.asm):05494                     JSR   WORDW
DE83 BDD5EC           (    forth6809.asm):05495                     JSR   FINDW
DE86 3706             (    forth6809.asm):05496                     PULU  D                 ; found flag
DE88 10830000         (    forth6809.asm):05497                     CMPD  #0
DE8C 260A             (    forth6809.asm):05498                     BNE   TICKOK
DE8E 3706             (    forth6809.asm):05499                     PULU  D                 ; drop the name
DE90 CCFFF3           (    forth6809.asm):05500                     LDD   #-13              ; -13
DE93 3606             (    forth6809.asm):05501                     PSHU  D
DE95 BDDA61           (    forth6809.asm):05502                     JSR   THROWW
DE98 39               (    forth6809.asm):05503         TICKOK:     RTS
                      (    forth6809.asm):05504         
                      (    forth6809.asm):05505         ; ------------------------------------------------------------
                      (    forth6809.asm):05506         ; COMPILE,  ( xt -- )
                      (    forth6809.asm):05507         ; Compile a call to xt (see CCALL).
                      (    forth6809.asm):05508         ; ------------------------------------------------------------
DE99                  (    forth6809.asm):05509         COMPILECOMMAW:
DE99 7EDE9C           (    forth6809.asm):05510                     JMP   CCALL
                      (    forth6809.asm):05511         
                      (    forth6809.asm):05512         ; ------------------------------------------------------------
                      (    forth6809.asm):05513         ; Append a JSR to xt at the code pointer CODEHERE.
                      (    forth6809.asm):05514         ; CCALL   ( xt -- )
                      (    forth6809.asm):05515         ;    Inputs:
                      (    forth6809.asm):05516         ;        xt on the data stack
                      (    forth6809.asm):05517         ;    Outputs:
                      (    forth6809.asm):05518         ;        JSR xt appended at CODEHERE; CODEHERE advanced by 3
                      (    forth6809.asm):05519         ;    Registers: RegA, RegB, RegD and RegX changed.
                      (    forth6809.asm):05520         ; ------------------------------------------------------------
DE9C 9E08             (    forth6809.asm):05521         CCALL:      LDX   CODEHERE          ; X = code pointer
DE9E 86BD             (    forth6809.asm):05522                     LDA   #OPJSR            ; JSR opcode
DEA0 A780             (    forth6809.asm):05523                     STA   ,X+
DEA2 3706             (    forth6809.asm):05524                     PULU  D                 ; xt
DEA4 ED81             (    forth6809.asm):05525                     STD   ,X++              ; See bugfix: CCALL.1
DEA6 9F08             (    forth6809.asm):05526                     STX   CODEHERE
DEA8 39               (    forth6809.asm):05527                     RTS
                      (    forth6809.asm):05528         
                      (    forth6809.asm):05529         ; ------------------------------------------------------------
                      (    forth6809.asm):05530         ; LITERAL  ( x -- )
                      (    forth6809.asm):05531         ; Compile LIT followed by x, so that x is pushed when the definition
                      (    forth6809.asm):05532         ; runs.
                      (    forth6809.asm):05533         ; ------------------------------------------------------------
DEA9 CCD0B4           (    forth6809.asm):05534         LITERALW:   LDD   #LIT
DEAC 3606             (    forth6809.asm):05535                     PSHU  D
DEAE BDDE9C           (    forth6809.asm):05536                     JSR   CCALL
DEB1 BDD15A           (    forth6809.asm):05537                     JSR   CODECOMMA         ; x
DEB4 39               (    forth6809.asm):05538                     RTS
                      (    forth6809.asm):05539         
                      (    forth6809.asm):05540         ; ------------------------------------------------------------
                      (    forth6809.asm):05541         ; 2LITERAL  ( x1 x2 -- )  IMMEDIATE
                      (    forth6809.asm):05542         ; Compile two LITs so that x1 x2 are pushed when the definition runs.
                      (    forth6809.asm):05543         ; ------------------------------------------------------------
DEB5                  (    forth6809.asm):05544         TWOLITERALW:
DEB5 3706             (    forth6809.asm):05545                     PULU  D                 ; x2
DEB7 3406             (    forth6809.asm):05546                     PSHS  D
DEB9 BDDEA9           (    forth6809.asm):05547                     JSR   LITERALW          ; x1 first, so it lands below x2
DEBC 3506             (    forth6809.asm):05548                     PULS  D
DEBE 3606             (    forth6809.asm):05549                     PSHU  D
DEC0 BDDEA9           (    forth6809.asm):05550                     JSR   LITERALW
DEC3 39               (    forth6809.asm):05551                     RTS
                      (    forth6809.asm):05552         
                      (    forth6809.asm):05553         ; ------------------------------------------------------------
                      (    forth6809.asm):05554         ; [']  ( "name" -- )
                      (    forth6809.asm):05555         ; Compile the xt of the next name as a literal. THROW -14 if not
                      (    forth6809.asm):05556         ; compiling, -13 if the name is not found.
                      (    forth6809.asm):05557         ; ------------------------------------------------------------
DEC4 DC00             (    forth6809.asm):05558         BRACKTICKW: LDD   STATE
DEC6 2608             (    forth6809.asm):05559                     BNE   BTSTOK
DEC8 CCFFF2           (    forth6809.asm):05560                     LDD   #-14              ; -14
DECB 3606             (    forth6809.asm):05561                     PSHU  D
DECD BDDA61           (    forth6809.asm):05562                     JSR   THROWW
DED0 CC0020           (    forth6809.asm):05563         BTSTOK:     LDD   #32

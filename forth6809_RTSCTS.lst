EA72 3606             (    forth6809.asm):05233                     PSHU  D
EA74 BDF551           (    forth6809.asm):05234                     JSR   TYPEW
EA77 CCFFFE           (    forth6809.asm):05235                     LDD   #-2               ; -2
EA7A 3606             (    forth6809.asm):05236                     PSHU  D
EA7C 7EE542           (    forth6809.asm):05237                     JMP   THROWW
                      (    forth6809.asm):05238         

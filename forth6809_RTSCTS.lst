                      (    forth6809.asm):05402         ; '  ( "name" -- xt )
                      (    forth6809.asm):05403         ; Parse the next blank-delimited name and return its xt. THROW -13 if
                      (    forth6809.asm):05404         ; the name is not found.
                      (    forth6809.asm):05405         ; ------------------------------------------------------------
DE9A CC0020           (    forth6809.asm):05406         TICKW:      LDD   #32

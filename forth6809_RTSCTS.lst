                      (    forth6809.asm):03551         ; Split a header into its xt and its immediate flag.
                      (    forth6809.asm):03552         ; HDRXT
                      (    forth6809.asm):03553         ;    Inputs:
                      (    forth6809.asm):03554         ;        RegX = header
                      (    forth6809.asm):03555         ;    Outputs:
                      (    forth6809.asm):03556         ;        RegX = xt (the CFA field), RegA = length|flags byte
                      (    forth6809.asm):03557         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):03558         ; ------------------------------------------------------------
E117 A684             (    forth6809.asm):03559         HDRXT:      LDA   ,X
E119 1F89             (    forth6809.asm):03560                     TFR   A,B
E11B C41F             (    forth6809.asm):03561                     ANDB  #$1F
E11D 3001             (    forth6809.asm):03562                     LEAX  1,X

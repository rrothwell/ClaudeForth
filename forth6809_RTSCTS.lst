                      (    forth6809.asm):06247         ; Remainder of n1 divided by n2. Division truncates toward zero; the
                      (    forth6809.asm):06248         ; remainder has the sign of the dividend. THROW -10 if the divisor is
                      (    forth6809.asm):06249         ; zero.
                      (    forth6809.asm):06250         ; ------------------------------------------------------------

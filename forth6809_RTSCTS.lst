                      (    forth6809.asm):03185         ; ------------------------------------------------------------
                      (    forth6809.asm):03186         ; DEFER  ( "name" -- )
                      (    forth6809.asm):03187         ; Build a deferred word. Until IS stores an xt in it, executing it
                      (    forth6809.asm):03188         ; throws -21.
                      (    forth6809.asm):03189         ; ------------------------------------------------------------
DEE3 CCDC54           (    forth6809.asm):03190         DEFERW:     LDD   #DODEFER
DEE6 BDDD9A           (    forth6809.asm):03191                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
DEE9 CCDC5C           (    forth6809.asm):03192                     LDD   #DOABORTUNDEF
DEEC 3606             (    forth6809.asm):03193                     PSHU  D
DEEE BDDCA5           (    forth6809.asm):03194                     JSR   COMMAW
DEF1 39               (    forth6809.asm):03195                     RTS
                      (    forth6809.asm):03196         
                      (    forth6809.asm):03197         ; ------------------------------------------------------------
                      (    forth6809.asm):03198         ; DEFER@  ( xt1 -- xt2 )
                      (    forth6809.asm):03199         ; Return the xt currently stored in the deferred word xt1.
                      (    forth6809.asm):03200         ; ------------------------------------------------------------
DEF2                  (    forth6809.asm):03201         DEFERFETCHW:
DEF2 BDEA3E           (    forth6809.asm):03202                     JSR   TOBODYW
DEF5 3710             (    forth6809.asm):03203                     PULU  X                 ; body address
DEF7 EC84             (    forth6809.asm):03204                     LDD   ,X
DEF9 3606             (    forth6809.asm):03205                     PSHU  D                 ; xt2
DEFB 39               (    forth6809.asm):03206                     RTS
                      (    forth6809.asm):03207         
                      (    forth6809.asm):03208         ; ------------------------------------------------------------
                      (    forth6809.asm):03209         ; DEFER!  ( xt2 xt1 -- )
                      (    forth6809.asm):03210         ; Store xt2 as the action of the deferred word xt1.
                      (    forth6809.asm):03211         ; ------------------------------------------------------------
DEFC                  (    forth6809.asm):03212         DEFERSTOREW:
DEFC BDEA3E           (    forth6809.asm):03213                     JSR   TOBODYW
DEFF 3710             (    forth6809.asm):03214                     PULU  X                 ; body address of xt1
DF01 3706             (    forth6809.asm):03215                     PULU  D                 ; xt2

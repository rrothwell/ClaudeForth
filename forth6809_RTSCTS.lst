E980 BDE2A0           (    forth6809.asm):04655                     JSR   WORDW
E983 BDE312           (    forth6809.asm):04656                     JSR   FINDW
E986 3706             (    forth6809.asm):04657                     PULU  D                 ; found flag
E988 10830000         (    forth6809.asm):04658                     CMPD  #0
E98C 260A             (    forth6809.asm):04659                     BNE   TICKOK
E98E 3706             (    forth6809.asm):04660                     PULU  D                 ; drop the name
E990 CCFFF3           (    forth6809.asm):04661                     LDD   #-13              ; -13
E993 3606             (    forth6809.asm):04662                     PSHU  D
E995 BDE561           (    forth6809.asm):04663                     JSR   THROWW
E998 39               (    forth6809.asm):04664         TICKOK:     RTS
                      (    forth6809.asm):04665         

                      (    forth6809.asm):05969         
                      (    forth6809.asm):05970         ; ------------------------------------------------------------
                      (    forth6809.asm):05971         ; 2R>  ( -- x1 x2 )  ( R: x1 x2 -- )
                      (    forth6809.asm):05972         ; Move a cell pair from the return stack. The
                      (    forth6809.asm):05973         ; return address of this call is on top of S, so it is lifted off and
                      (    forth6809.asm):05974         ; put back around the transfer.
                      (    forth6809.asm):05975         ; ------------------------------------------------------------

D92D B10177           (    forth6809.asm):04418                     CMPA  INTAIL
                      (    forth6809.asm):04419         
                      (    forth6809.asm):04420                     ; Commented-out code moved to shadow: KEYQW.2
                      (    forth6809.asm):04421         
D930 2606             (    forth6809.asm):04422                     BNE   KQTRUE            ; Yes!
                      (    forth6809.asm):04423         
D932 CC0000           (    forth6809.asm):04424                     LDD   #FALSEV           ; No! Return false result.
D935 3606             (    forth6809.asm):04425                     PSHU  D                 ; flag = false
                      (    forth6809.asm):04426         
D937 39               (    forth6809.asm):04427                     RTS
                      (    forth6809.asm):04428         
D938                  (    forth6809.asm):04429         KQTRUE:

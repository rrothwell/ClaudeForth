                      (    forth6809.asm):04619         ; ============================================================
                      (    forth6809.asm):04620         ; SECTION 11: EXCEPTIONS (CFERR, CATCH, THROW)
                      (    forth6809.asm):04621         ; ============================================================
                      (    forth6809.asm):04622         ; ------------------------------------------------------------
                      (    forth6809.asm):04623         ; Report a control-structure mismatch: throw -22. Called by the
                      (    forth6809.asm):04624         ; control-flow words when the tag on the control-flow stack is not the
                      (    forth6809.asm):04625         ; one expected.
                      (    forth6809.asm):04626         ; CFERR
                      (    forth6809.asm):04627         ;    Inputs:
                      (    forth6809.asm):04628         ;        none
                      (    forth6809.asm):04629         ;    Outputs:
                      (    forth6809.asm):04630         ;        does not return (THROW -22)
                      (    forth6809.asm):04631         ;    Registers: RegD changed; THROW decides the rest.
                      (    forth6809.asm):04632         ; ------------------------------------------------------------
DA4B CCFFEA           (    forth6809.asm):04633         CFERR:      LDD   #-22
DA4E 3606             (    forth6809.asm):04634                     PSHU  D                 ; -22
DA50 BDDA80           (    forth6809.asm):04635                     JSR   THROWW
DA53 39               (    forth6809.asm):04636                     RTS
                      (    forth6809.asm):04637         
                      (    forth6809.asm):04638         ; ------------------------------------------------------------
                      (    forth6809.asm):04639         ; CATCH  ( i*x xt -- j*x 0 | i*x n )
                      (    forth6809.asm):04640         ; Execute xt with an exception frame in place. On normal return push
                      (    forth6809.asm):04641         ; 0. If xt (or anything it calls) executes THROW with a non-zero n,
                      (    forth6809.asm):04642         ; THROW unwinds to this frame and CATCH returns n.
                      (    forth6809.asm):04643         ; Frame on S, top first: >IN, SRCID, SRCLEN, SRCADDR, saved U,
                      (    forth6809.asm):04644         ; previous HANDLER. HANDLER points at the >IN cell.
                      (    forth6809.asm):04645         ; ------------------------------------------------------------
DA54 3710             (    forth6809.asm):04646         CATCHW:     PULU  X                 ; xt
DA56 DC0C             (    forth6809.asm):04647                     LDD   HANDLER
DA58 3406             (    forth6809.asm):04648                     PSHS  D
DA5A 3440             (    forth6809.asm):04649                     PSHS  U
                      (    forth6809.asm):04650                     ; Save the input source specification.
                      (    forth6809.asm):04651                     ; See bugfix: CATCHW.1
DA5C DC39             (    forth6809.asm):04652                     LDD   SRCADDR
DA5E 3406             (    forth6809.asm):04653                     PSHS  D
DA60 DC3B             (    forth6809.asm):04654                     LDD   SRCLEN
DA62 3406             (    forth6809.asm):04655                     PSHS  D
DA64 DC3D             (    forth6809.asm):04656                     LDD   SRCID
DA66 3406             (    forth6809.asm):04657                     PSHS  D
DA68 DC10             (    forth6809.asm):04658                     LDD   TOIN
DA6A 3406             (    forth6809.asm):04659                     PSHS  D
DA6C 1F40             (    forth6809.asm):04660                     TFR   S,D
DA6E DD0C             (    forth6809.asm):04661                     STD   HANDLER
                      (    forth6809.asm):04662         
DA70 AD84             (    forth6809.asm):04663                     JSR   ,X
                      (    forth6809.asm):04664         
DA72 3268             (    forth6809.asm):04665                     LEAS  8,S               ; drop saved input source
DA74 3262             (    forth6809.asm):04666                     LEAS  2,S               ; saved U
DA76 3506             (    forth6809.asm):04667                     PULS  D
DA78 DD0C             (    forth6809.asm):04668                     STD   HANDLER
DA7A CC0000           (    forth6809.asm):04669                     LDD   #0
DA7D 3606             (    forth6809.asm):04670                     PSHU  D                 ; 0 = no exception
DA7F 39               (    forth6809.asm):04671                     RTS
                      (    forth6809.asm):04672         
                      (    forth6809.asm):04673         ; ------------------------------------------------------------
                      (    forth6809.asm):04674         ; THROW  ( k*x n -- k*x | i*x n )
                      (    forth6809.asm):04675         ; If n is zero, do nothing. Otherwise restore the state saved by the
                      (    forth6809.asm):04676         ; most recent CATCH (S, U, input source, >IN, HANDLER) and make that
                      (    forth6809.asm):04677         ; CATCH return n. With no CATCH active, push n and ABORT.
                      (    forth6809.asm):04678         ; ------------------------------------------------------------
DA80 3706             (    forth6809.asm):04679         THROWW:     PULU  D                 ; n
DA82 10830000         (    forth6809.asm):04680                     CMPD  #0
DA86 2725             (    forth6809.asm):04681                     BEQ   THDONE
                      (    forth6809.asm):04682         
DA88 DD0E             (    forth6809.asm):04683                     STD   THROWN
DA8A 9E0C             (    forth6809.asm):04684                     LDX   HANDLER
DA8C 2720             (    forth6809.asm):04685                     BEQ   THUNCAU
                      (    forth6809.asm):04686         
DA8E 1F14             (    forth6809.asm):04687                     TFR   X,S
DA90 3506             (    forth6809.asm):04688                     PULS  D                 ; restore input source saved by CATCH
DA92 DD10             (    forth6809.asm):04689                     STD   TOIN
DA94 3506             (    forth6809.asm):04690                     PULS  D
DA96 DD3D             (    forth6809.asm):04691                     STD   SRCID
DA98 3506             (    forth6809.asm):04692                     PULS  D
DA9A DD3B             (    forth6809.asm):04693                     STD   SRCLEN
DA9C 3506             (    forth6809.asm):04694                     PULS  D
DA9E DD39             (    forth6809.asm):04695                     STD   SRCADDR
DAA0 3506             (    forth6809.asm):04696                     PULS  D
DAA2 1F03             (    forth6809.asm):04697                     TFR   D,U
DAA4 3506             (    forth6809.asm):04698                     PULS  D
DAA6 DD0C             (    forth6809.asm):04699                     STD   HANDLER
                      (    forth6809.asm):04700         
DAA8 DC0E             (    forth6809.asm):04701                     LDD   THROWN
DAAA 3606             (    forth6809.asm):04702                     PSHU  D

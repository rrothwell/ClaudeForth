                      (    forth6809.asm):04712         ; SECTION 12: CONTROL FLOW (IF/THEN/ELSE, BEGIN family,
                      (    forth6809.asm):04713         ; DO/LOOP/+LOOP/I/J/LEAVE/UNLOOP/?DO, EXIT, CASE family)
                      (    forth6809.asm):04714         ; ============================================================
                      (    forth6809.asm):04715         ; ------------------------------------------------------------
                      (    forth6809.asm):04716         ; Store a branch displacement: the cell at location receives target -
                      (    forth6809.asm):04717         ; location.
                      (    forth6809.asm):04718         ; PATCH   ( target location -- )
                      (    forth6809.asm):04719         ;    Inputs:
                      (    forth6809.asm):04720         ;        target and location on the data stack (location on top)
                      (    forth6809.asm):04721         ;    Outputs:
                      (    forth6809.asm):04722         ;        the cell at location holds target - location
                      (    forth6809.asm):04723         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):04724         ; ------------------------------------------------------------
DAB5 3710             (    forth6809.asm):04725         PATCH:      PULU  X                 ; location
DAB7 3706             (    forth6809.asm):04726                     PULU  D                 ; target
DAB9 3410             (    forth6809.asm):04727                     PSHS  X
DABB A3E1             (    forth6809.asm):04728                     SUBD  ,S++              ; target - location
DABD ED84             (    forth6809.asm):04729                     STD   ,X
DABF 39               (    forth6809.asm):04730                     RTS
                      (    forth6809.asm):04731         
                      (    forth6809.asm):04732         ; ------------------------------------------------------------
                      (    forth6809.asm):04733         ; IF  ( C: -- orig )
                      (    forth6809.asm):04734         ; Compile ZBRANCH with a placeholder operand. Leave the operand
                      (    forth6809.asm):04735         ; address and TAGFWD on the control-flow stack for ELSE or THEN.
                      (    forth6809.asm):04736         ; ------------------------------------------------------------

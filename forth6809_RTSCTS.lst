DE9F BDD578           (    forth6809.asm):05408                     JSR   WORDW
DEA2 BDD661           (    forth6809.asm):05409                     JSR   FINDW
DEA5 3706             (    forth6809.asm):05410                     PULU  D                 ; found flag
DEA7 10830000         (    forth6809.asm):05411                     CMPD  #0
DEAB 260A             (    forth6809.asm):05412                     BNE   TICKOK
DEAD 3706             (    forth6809.asm):05413                     PULU  D                 ; drop the name
DEAF CCFFF3           (    forth6809.asm):05414                     LDD   #-13              ; -13
DEB2 3606             (    forth6809.asm):05415                     PSHU  D
DEB4 BDDA80           (    forth6809.asm):05416                     JSR   THROWW
DEB7 39               (    forth6809.asm):05417         TICKOK:     RTS
                      (    forth6809.asm):05418         

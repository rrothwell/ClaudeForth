                      (    forth6809.asm):05368         ; Push the address of the STATE variable.
                      (    forth6809.asm):05369         ; ------------------------------------------------------------
DE7F CC0000           (    forth6809.asm):05370         STATEW:     LDD   #STATE
DE82 3606             (    forth6809.asm):05371                     PSHU  D                 ; a-addr
DE84 39               (    forth6809.asm):05372                     RTS
                      (    forth6809.asm):05373         

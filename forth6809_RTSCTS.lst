                      (    forth6809.asm):04855         ; UNLOOP  ( -- )
                      (    forth6809.asm):04856         ; Discard the loop frame (index, limit, leave flag) beneath UNLOOP's
                      (    forth6809.asm):04857         ; return address, so that a following I or J sees the enclosing loop.
                      (    forth6809.asm):04858         ; ------------------------------------------------------------
E86A 3510             (    forth6809.asm):04859         UNLOOPW:    PULS  X

                      (    forth6809.asm):08467         ; ------------------------------------------------------------
                      (    forth6809.asm):08468         ; HOLD  ( char -- )
                      (    forth6809.asm):08469         ; Add char to the front of the pictured numeric output string.
                      (    forth6809.asm):08470         ; ------------------------------------------------------------

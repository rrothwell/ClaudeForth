                      (    forth6809.asm):07024         ; CMOVE  ( c-addr1 c-addr2 u -- )
                      (    forth6809.asm):07025         ; Copy u bytes from c-addr1 to c-addr2, starting at the low addresses.
                      (    forth6809.asm):07026         ; ------------------------------------------------------------
F366 ECC4             (    forth6809.asm):07027         CMOVEW:     LDD   ,U                ; u. Parameters stay on the data stack,
F368 2713             (    forth6809.asm):07028                     BEQ   CMDONE            ; addressed relative to U: u at 0, c-addr2
F36A AE44             (    forth6809.asm):07029                     LDX   4,U               ; at 2, c-addr1 at 4. See shadow CMOVEW.2
F36C 308B             (    forth6809.asm):07030                     LEAX  D,X               ; end address = c-addr1 + u
F36E AFC4             (    forth6809.asm):07031                     STX   ,U                ; keep it in u's old slot as the loop limit
F370 AE44             (    forth6809.asm):07032                     LDX   4,U               ; X = source
F372 10AE42           (    forth6809.asm):07033                     LDY   2,U               ; Y = destination
F375 A680             (    forth6809.asm):07034         CMVLOOP:    LDA   ,X+
F377 A7A0             (    forth6809.asm):07035                     STA   ,Y+
F379 ACC4             (    forth6809.asm):07036                     CMPX  ,U                ; reached the end address?
F37B 26F8             (    forth6809.asm):07037                     BNE   CMVLOOP
F37D 3346             (    forth6809.asm):07038         CMDONE:     LEAU  6,U               ; drop the three parameters
F37F 39               (    forth6809.asm):07039                     RTS

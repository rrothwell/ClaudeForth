                      (    forth6809.asm):02476         ; ------------------------------------------------------------
D034 3B               (    forth6809.asm):02477         SWI3H:      RTI
D035 3B               (    forth6809.asm):02478         SWI2H:      RTI
D036 3B               (    forth6809.asm):02479         FIRQH:      RTI
D037 3B               (    forth6809.asm):02480         NMIH:       RTI                     ; unused now that NMI -> WARM
D038 CCFF9D           (    forth6809.asm):02481         SWIH:       LDD   #-99              ; placeholder hardware-trap code; push and

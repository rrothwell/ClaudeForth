E091 ED44             (    forth6809.asm):05829                     STD   4,U
E093 10AFC4           (    forth6809.asm):05830                     STY   ,U
E096 AF42             (    forth6809.asm):05831                     STX   2,U
E098 39               (    forth6809.asm):05832                     RTS
                      (    forth6809.asm):05833         
                      (    forth6809.asm):05834         ; ------------------------------------------------------------
                      (    forth6809.asm):05835         ; >R  ( x -- )  ( R: -- x )
                      (    forth6809.asm):05836         ; Move x from the data stack to the return stack. The return address
                      (    forth6809.asm):05837         ; of this call is on top of S, so it is lifted off and put back around
                      (    forth6809.asm):05838         ; the transfer.
                      (    forth6809.asm):05839         ; ------------------------------------------------------------
E099 3706             (    forth6809.asm):05840         TORW:       PULU  D                 ; x
E09B 3510             (    forth6809.asm):05841                     PULS  X
E09D 3406             (    forth6809.asm):05842                     PSHS  D
E09F 3410             (    forth6809.asm):05843                     PSHS  X
E0A1 39               (    forth6809.asm):05844                     RTS
                      (    forth6809.asm):05845         
                      (    forth6809.asm):05846         ; ------------------------------------------------------------
                      (    forth6809.asm):05847         ; R>  ( -- x )  ( R: x -- )
                      (    forth6809.asm):05848         ; Move x from the return stack to the data stack. The return address
                      (    forth6809.asm):05849         ; of this call is on top of S, so it is lifted off and put back around
                      (    forth6809.asm):05850         ; the transfer.
                      (    forth6809.asm):05851         ; ------------------------------------------------------------
E0A2 3510             (    forth6809.asm):05852         FROMRW:     PULS  X
E0A4 3506             (    forth6809.asm):05853                     PULS  D                 ; x
E0A6 3410             (    forth6809.asm):05854                     PSHS  X
E0A8 3606             (    forth6809.asm):05855                     PSHU  D
E0AA 39               (    forth6809.asm):05856                     RTS
                      (    forth6809.asm):05857         
                      (    forth6809.asm):05858         ; ------------------------------------------------------------
                      (    forth6809.asm):05859         ; R@  ( -- x )  ( R: x -- x )
                      (    forth6809.asm):05860         ; Copy the top of the return stack to the data stack. The return
                      (    forth6809.asm):05861         ; address of this call is on top of S, so it is lifted off and put
                      (    forth6809.asm):05862         ; back around the transfer.
                      (    forth6809.asm):05863         ; ------------------------------------------------------------
E0AB 3510             (    forth6809.asm):05864         RFETCHW:    PULS  X
E0AD ECE4             (    forth6809.asm):05865                     LDD   ,S                ; x
E0AF 3410             (    forth6809.asm):05866                     PSHS  X
E0B1 3606             (    forth6809.asm):05867                     PSHU  D
E0B3 39               (    forth6809.asm):05868                     RTS
                      (    forth6809.asm):05869         
                      (    forth6809.asm):05870         ; ------------------------------------------------------------
                      (    forth6809.asm):05871         ; 2>R  ( x1 x2 -- )  ( R: -- x1 x2 )
                      (    forth6809.asm):05872         ; Move a cell pair to the return stack. R2A and R2B are scratch. The
                      (    forth6809.asm):05873         ; return address of this call is on top of S, so it is lifted off and
                      (    forth6809.asm):05874         ; put back around the transfer.
                      (    forth6809.asm):05875         ; ------------------------------------------------------------
E0B4 3510             (    forth6809.asm):05876         TWOTORW:    PULS  X                 ; return address
E0B6 3706             (    forth6809.asm):05877                     PULU  D                 ; x2
E0B8 3720             (    forth6809.asm):05878                     PULU  Y                 ; x1
E0BA 3420             (    forth6809.asm):05879                     PSHS  Y
E0BC 3406             (    forth6809.asm):05880                     PSHS  D
E0BE 3410             (    forth6809.asm):05881                     PSHS  X
E0C0 39               (    forth6809.asm):05882                     RTS
                      (    forth6809.asm):05883         
                      (    forth6809.asm):05884         ; ------------------------------------------------------------
                      (    forth6809.asm):05885         ; 2R>  ( -- x1 x2 )  ( R: x1 x2 -- )
                      (    forth6809.asm):05886         ; Move a cell pair from the return stack. The
                      (    forth6809.asm):05887         ; return address of this call is on top of S, so it is lifted off and
                      (    forth6809.asm):05888         ; put back around the transfer.
                      (    forth6809.asm):05889         ; ------------------------------------------------------------
E0C1 3510             (    forth6809.asm):05890         TWOFROMRW:  PULS  X                 ; return address
E0C3 3506             (    forth6809.asm):05891                     PULS  D                 ; x2
E0C5 3520             (    forth6809.asm):05892                     PULS  Y                 ; x1
E0C7 3410             (    forth6809.asm):05893                     PSHS  X
E0C9 3620             (    forth6809.asm):05894                     PSHU  Y
E0CB 3606             (    forth6809.asm):05895                     PSHU  D
E0CD 39               (    forth6809.asm):05896                     RTS
                      (    forth6809.asm):05897         
                      (    forth6809.asm):05898         ; ------------------------------------------------------------
                      (    forth6809.asm):05899         ; 2R@  ( -- x1 x2 )  ( R: x1 x2 -- x1 x2 )
                      (    forth6809.asm):05900         ; Copy the top cell pair of the return stack.
                      (    forth6809.asm):05901         ; The return address of this call is on top of S, so it is lifted off
                      (    forth6809.asm):05902         ; and put back around the transfer.
                      (    forth6809.asm):05903         ; ------------------------------------------------------------
E0CE 3510             (    forth6809.asm):05904         TWORFETCHW: PULS  X                 ; return address
E0D0 ECE4             (    forth6809.asm):05905                     LDD   ,S                ; x2
E0D2 10AE62           (    forth6809.asm):05906                     LDY   2,S               ; x1
E0D5 3410             (    forth6809.asm):05907                     PSHS  X
E0D7 3620             (    forth6809.asm):05908                     PSHU  Y
E0D9 3606             (    forth6809.asm):05909                     PSHU  D
E0DB 39               (    forth6809.asm):05910                     RTS
                      (    forth6809.asm):05911         
                      (    forth6809.asm):05912         ; ============================================================
                      (    forth6809.asm):05913         ; SECTION 15: ARITHMETIC (single + double + mixed precision)
                      (    forth6809.asm):05914         ; ============================================================
                      (    forth6809.asm):05915         ; ------------------------------------------------------------
                      (    forth6809.asm):05916         ; +  ( n1 n2 -- n3 )
                      (    forth6809.asm):05917         ; Add n2 to n1.
                      (    forth6809.asm):05918         ; ------------------------------------------------------------
E0DC 3706             (    forth6809.asm):05919         PLUSW:      PULU  D                 ; n2
E0DE E3C4             (    forth6809.asm):05920                     ADDD  ,U
E0E0 EDC4             (    forth6809.asm):05921                     STD   ,U
E0E2 39               (    forth6809.asm):05922                     RTS
                      (    forth6809.asm):05923         
                      (    forth6809.asm):05924         ; ------------------------------------------------------------
                      (    forth6809.asm):05925         ; -  ( n1 n2 -- n3 )
                      (    forth6809.asm):05926         ; Subtract n2 from n1.
                      (    forth6809.asm):05927         ; ------------------------------------------------------------
E0E3 3706             (    forth6809.asm):05928         MINUSW:     PULU  D                 ; n2
E0E5 DD14             (    forth6809.asm):05929                     STD   MSCR
E0E7 ECC4             (    forth6809.asm):05930                     LDD   ,U
E0E9 9314             (    forth6809.asm):05931                     SUBD  MSCR
E0EB EDC4             (    forth6809.asm):05932                     STD   ,U
E0ED 39               (    forth6809.asm):05933                     RTS
                      (    forth6809.asm):05934         
                      (    forth6809.asm):05935         ; ------------------------------------------------------------
                      (    forth6809.asm):05936         ; NEGATE  ( n1 -- n2 )
                      (    forth6809.asm):05937         ; Two's complement negate.
                      (    forth6809.asm):05938         ; ------------------------------------------------------------
E0EE ECC4             (    forth6809.asm):05939         NEGATEW:    LDD   ,U                ; n1
E0F0 43               (    forth6809.asm):05940                     COMA
E0F1 53               (    forth6809.asm):05941                     COMB
E0F2 C30001           (    forth6809.asm):05942                     ADDD  #1
E0F5 EDC4             (    forth6809.asm):05943                     STD   ,U

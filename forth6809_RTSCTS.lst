                      (    forth6809.asm):03789         ; ------------------------------------------------------------
                      (    forth6809.asm):03790         ; GET-CURRENT  ( -- wid )
                      (    forth6809.asm):03791         ; Return the WID of the wordlist that receives new definitions.
                      (    forth6809.asm):03792         ; ------------------------------------------------------------
E25D DC47             (    forth6809.asm):03793         GETCURW:    LDD   CURRENT
E25F 3606             (    forth6809.asm):03794                     PSHU  D
E261 39               (    forth6809.asm):03795                     RTS
                      (    forth6809.asm):03796         
                      (    forth6809.asm):03797         ; ------------------------------------------------------------
                      (    forth6809.asm):03798         ; SET-CURRENT  ( wid -- )
                      (    forth6809.asm):03799         ; Make wid the wordlist that receives new definitions. Throws -11 for
                      (    forth6809.asm):03800         ; an invalid wid.
                      (    forth6809.asm):03801         ; ------------------------------------------------------------
E262 3710             (    forth6809.asm):03802         SETCURW:    PULU  X
E264 BDE178           (    forth6809.asm):03803                     JSR   WIDCHK
E267 9F47             (    forth6809.asm):03804                     STX   CURRENT
E269 39               (    forth6809.asm):03805                     RTS
                      (    forth6809.asm):03806         
                      (    forth6809.asm):03807         ; ------------------------------------------------------------
                      (    forth6809.asm):03808         ; DEFINITIONS  ( -- )
                      (    forth6809.asm):03809         ; Make the first wordlist of the search order the one that receives new
                      (    forth6809.asm):03810         ; definitions. Throws -50 when the search order is empty.
                      (    forth6809.asm):03811         ; ------------------------------------------------------------
E26A                  (    forth6809.asm):03812         DEFINITIONSW:
E26A 8E004B           (    forth6809.asm):03813                     LDX   #ORDER
E26D 9C49             (    forth6809.asm):03814                     CMPX  ORDEND
E26F 2405             (    forth6809.asm):03815                     BHS   DFUNDER
E271 EC84             (    forth6809.asm):03816                     LDD   ,X
E273 DD47             (    forth6809.asm):03817                     STD   CURRENT
E275 39               (    forth6809.asm):03818                     RTS
E276 CCFFCE           (    forth6809.asm):03819         DFUNDER:    LDD   #-50
E279 3606             (    forth6809.asm):03820                     PSHU  D
E27B 7EE542           (    forth6809.asm):03821                     JMP   THROWW
                      (    forth6809.asm):03822         
                      (    forth6809.asm):03823         ; ------------------------------------------------------------
                      (    forth6809.asm):03824         ; ONLY  ( -- )
                      (    forth6809.asm):03825         ; Set the minimum search order: FORTH only (ROOT is still searched).
                      (    forth6809.asm):03826         ; ------------------------------------------------------------
E27E CC005B           (    forth6809.asm):03827         ONLYW:      LDD   #WLHEADS
E281 DD4B             (    forth6809.asm):03828                     STD   ORDER
E283 CC004D           (    forth6809.asm):03829                     LDD   #ORDER+2
E286 DD49             (    forth6809.asm):03830                     STD   ORDEND
E288 39               (    forth6809.asm):03831                     RTS
                      (    forth6809.asm):03832         
                      (    forth6809.asm):03833         ; ------------------------------------------------------------
                      (    forth6809.asm):03834         ; Replace the first wordlist of the search order with the WID in RegX,
                      (    forth6809.asm):03835         ; or make it the only one if the order is empty.
                      (    forth6809.asm):03836         ; SETTOP
                      (    forth6809.asm):03837         ;    Inputs:
                      (    forth6809.asm):03838         ;        RegX = WID
                      (    forth6809.asm):03839         ;    Outputs:
                      (    forth6809.asm):03840         ;        ORDER(0) = WID; ORDEND at least ORDER+2
                      (    forth6809.asm):03841         ;    Registers: RegD and CC changed.
                      (    forth6809.asm):03842         ; ------------------------------------------------------------
E289 9F4B             (    forth6809.asm):03843         SETTOP:     STX   ORDER
E28B DC49             (    forth6809.asm):03844                     LDD   ORDEND
E28D 1083004D         (    forth6809.asm):03845                     CMPD  #ORDER+2
E291 2405             (    forth6809.asm):03846                     BHS   STDONE

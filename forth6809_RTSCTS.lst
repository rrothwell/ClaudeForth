E871 108E0000         (    forth6809.asm):04870         EXITW:      LDY   #0                ; Y = count of DO frames (5k: no scratch)
E875 1F31             (    forth6809.asm):04871                     TFR   U,X               ; X = scan pointer
E877 9C21             (    forth6809.asm):04872         EXSCAN:     CMPX  CSP
E879 270E             (    forth6809.asm):04873                     BEQ   EXSCANDONE
E87B EC84             (    forth6809.asm):04874                     LDD   ,X

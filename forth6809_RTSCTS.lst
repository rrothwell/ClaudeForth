                      (    forth6809.asm):05169         ; orig (the skip operand address) and TAGQDO, then dest and TAGDO.
                      (    forth6809.asm):05170         ; ------------------------------------------------------------
DD58 CCDD7E           (    forth6809.asm):05171         QDOW:       LDD   #QDOSETUP
DD5B 3606             (    forth6809.asm):05172                     PSHU  D

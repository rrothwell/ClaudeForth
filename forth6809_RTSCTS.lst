                      (    forth6809.asm):07523         ; SUBSTITUTE  ( c-addr1 u1 c-addr2 u2 -- c-addr2 u3 n )
                      (    forth6809.asm):07524         ; Copy the template c-addr1 u1 to the buffer c-addr2 u2, replacing
                      (    forth6809.asm):07525         ; each %name% that matches the name registered by REPLACES with its
                      (    forth6809.asm):07526         ; text. "%%" becomes a single "%"; a %name% that does not match, and
                      (    forth6809.asm):07527         ; an unpaired "%", are copied unchanged. u3 is the output length and n
                      (    forth6809.asm):07528         ; the number of substitutions. THROW -1 if the output does not fit.
                      (    forth6809.asm):07529         ; Scratch: MSCR = read position, MSCR2 = substitution count, MSCR3 and
                      (    forth6809.asm):07530         ; MSCR4 = temporaries for each %-pair. Original comment: shadow

DA63 10830000         (    forth6809.asm):04766                     CMPD  #0
DA67 2725             (    forth6809.asm):04767                     BEQ   THDONE
                      (    forth6809.asm):04768         
DA69 DD0E             (    forth6809.asm):04769                     STD   THROWN
DA6B 9E0C             (    forth6809.asm):04770                     LDX   HANDLER
DA6D 2720             (    forth6809.asm):04771                     BEQ   THUNCAU
                      (    forth6809.asm):04772         

DFBA CCDF88           (    forth6809.asm):05605                     LDD   #DOABORTQUOTE
DFBD 7EE911           (    forth6809.asm):05606                     JMP   CSTRCOMP
                      (    forth6809.asm):05607         
                      (    forth6809.asm):05608         ; ------------------------------------------------------------
                      (    forth6809.asm):05609         ; BL  ( -- char )

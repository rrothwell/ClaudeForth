EBB4 EDC4             (    forth6809.asm):05767                     STD   ,U
EBB6 39               (    forth6809.asm):05768                     RTS
                      (    forth6809.asm):05769         
                      (    forth6809.asm):05770         ; ------------------------------------------------------------
                      (    forth6809.asm):05771         ; -  ( n1 n2 -- n3 )

DD65 BDD1CF           (    forth6809.asm):05176                     JSR   CODECOMMA
DD68 DC08             (    forth6809.asm):05177                     LDD   CODEHERE
DD6A 830002           (    forth6809.asm):05178                     SUBD  #2
DD6D 3606             (    forth6809.asm):05179                     PSHU  D                 ; orig
DD6F CC0007           (    forth6809.asm):05180                     LDD   #TAGQDO           ; See bugfix: QDOW.1
DD72 3606             (    forth6809.asm):05181                     PSHU  D
DD74 DC08             (    forth6809.asm):05182                     LDD   CODEHERE
DD76 3606             (    forth6809.asm):05183                     PSHU  D                 ; dest
DD78 CC0003           (    forth6809.asm):05184                     LDD   #TAGDO
DD7B 3606             (    forth6809.asm):05185                     PSHU  D
DD7D 39               (    forth6809.asm):05186                     RTS

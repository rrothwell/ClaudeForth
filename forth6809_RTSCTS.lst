                      (    forth6809.asm):03528         ; FIND  ( c-addr -- c-addr 0 | xt 1 | xt -1 )
                      (    forth6809.asm):03529         ; Look up the counted string in the search order, then in ROOT, ignoring
                      (    forth6809.asm):03530         ; smudged entries. Returns the xt and 1 if the word is immediate, or
                      (    forth6809.asm):03531         ; -1 if not. If not found, returns c-addr and 0.
                      (    forth6809.asm):03532         ; Holds no scratch cells; see shadow FINDW.1 and SEARCHORDER.1.
                      (    forth6809.asm):03533         ; ------------------------------------------------------------
E1F8 10AEC4           (    forth6809.asm):03534         FINDW:      LDY   ,U                ; counted string
E1FB E6A0             (    forth6809.asm):03535                     LDB   ,Y+
E1FD 8DBE             (    forth6809.asm):03536                     BSR   SRCHORD
E1FF 8C0000           (    forth6809.asm):03537                     CMPX  #0
E202 2712             (    forth6809.asm):03538                     BEQ   NOTFOUND
E204 8DE6             (    forth6809.asm):03539                     BSR   HDRXT
E206 AFC4             (    forth6809.asm):03540                     STX   ,U                ; xt replaces c-addr
E208 4D               (    forth6809.asm):03541                     TSTA
E209 2A05             (    forth6809.asm):03542                     BPL   FISNORM
E20B CC0001           (    forth6809.asm):03543                     LDD   #1
E20E 2003             (    forth6809.asm):03544                     BRA   FPUSH
E210 CCFFFF           (    forth6809.asm):03545         FISNORM:    LDD   #-1
E213 3606             (    forth6809.asm):03546         FPUSH:      PSHU  D                 ; 1 = immediate, -1 = normal
E215 39               (    forth6809.asm):03547                     RTS
                      (    forth6809.asm):03548         
E216 CC0000           (    forth6809.asm):03549         NOTFOUND:   LDD   #0
E219 3606             (    forth6809.asm):03550                     PSHU  D                 ; 0 = not found, c-addr still beneath
E21B 39               (    forth6809.asm):03551                     RTS
                      (    forth6809.asm):03552         
                      (    forth6809.asm):03553         ; ------------------------------------------------------------
                      (    forth6809.asm):03554         ; SEARCH-WORDLIST  ( c-addr u wid -- 0 | xt 1 | xt -1 )
                      (    forth6809.asm):03555         ; Search the one wordlist wid for the name c-addr u. Returns 0 if it is
                      (    forth6809.asm):03556         ; not found, else its xt and 1 if the word is immediate or -1 if not.
                      (    forth6809.asm):03557         ; Throws -11 for an invalid wid.
                      (    forth6809.asm):03558         ; ------------------------------------------------------------
E21C 3710             (    forth6809.asm):03559         SEARCHWLW:  PULU  X                 ; wid
E21E 8D2D             (    forth6809.asm):03560                     BSR   WIDCHK
E220 AE84             (    forth6809.asm):03561                     LDX   ,X                ; newest header of the wordlist
E222 3706             (    forth6809.asm):03562                     PULU  D                 ; u
E224 3720             (    forth6809.asm):03563                     PULU  Y                 ; c-addr
E226 4D               (    forth6809.asm):03564                     TSTA
E227 261E             (    forth6809.asm):03565                     BNE   SWNOT             ; longer than any name
E229 C11F             (    forth6809.asm):03566                     CMPB  #31
E22B 221A             (    forth6809.asm):03567                     BHI   SWNOT
E22D BDE180           (    forth6809.asm):03568                     JSR   FDSEARCH

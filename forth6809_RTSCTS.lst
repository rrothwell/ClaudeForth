                      (    forth6809.asm):05902         ; 2ROT  ( x1 x2 x3 x4 x5 x6 -- x3 x4 x5 x6 x1 x2 )
                      (    forth6809.asm):05903         ; Rotate the third cell pair to the top. X and Y hold the pair
                      (    forth6809.asm):05904         ; while the others move.

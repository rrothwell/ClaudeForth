D9ED F10179           (    forth6809.asm):02079                     CMPB  OUTHEAD           ; Is transmit buffer empty?
D9F0 2719             (    forth6809.asm):02080                     BEQ   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):02081         
D9F2 B6C008           (    forth6809.asm):02082                     LDA   ACIASR            ; Is transmission blocked by remote receiver?
D9F5 8508             (    forth6809.asm):02083                     BITA  #SR_CTS
D9F7 2612             (    forth6809.asm):02084                     BNE   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):02085         
D9F9 8502             (    forth6809.asm):02086                     BITA  #SR_TDRE          ; Is transmit register empty?
D9FB 270E             (    forth6809.asm):02087                     BEQ   FLUSHED           ; No! Exit - try again next call rather

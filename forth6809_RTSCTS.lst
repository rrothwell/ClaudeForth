DA90 F6017A           (    forth6809.asm):02228                     LDB   OUTTAIL           ; Check if chars are available.
DA93 F10179           (    forth6809.asm):02229                     CMPB  OUTHEAD
DA96 2707             (    forth6809.asm):02230                     BEQ   RTSCLONOTX        ; No! Just configure the ACIA to accept chars.
                      (    forth6809.asm):02231         
DA98 86B5             (    forth6809.asm):02232                     LDA   #CR_RXTX          ; Yes! Configure the ACIA to accept chars.
DA9A B7C008           (    forth6809.asm):02233                     STA   ACIACR            ; & to generate transmit slot available interrupts.
DA9D 2005             (    forth6809.asm):02234                     BRA   RTSCLOUNMASK
                      (    forth6809.asm):02235         
DA9F 8695             (    forth6809.asm):02236         RTSCLONOTX: LDA   #CR_RXON          ; Configure the ACIA to accept chars.
DAA1 B7C008           (    forth6809.asm):02237                     STA   ACIACR
                      (    forth6809.asm):02238         
DAA4                  (    forth6809.asm):02239         RTSCLOUNMASK:
DAA4 1CEF             (    forth6809.asm):02240                     ANDCC #$EF
                      (    forth6809.asm):02241         
DAA6 39               (    forth6809.asm):02242         RTSCLODONE: RTS
                      (    forth6809.asm):02243         
                      (    forth6809.asm):02244         ; ------------------------------------------------------------
                      (    forth6809.asm):02245         ; ACIA (6850) interrupt handler (SERIALPOLL=0). Services received
                      (    forth6809.asm):02246         ; characters (into the input ring, counting framing, overrun and
                      (    forth6809.asm):02247         ; parity errors) and transmit-ready (from the output ring), with a
                      (    forth6809.asm):02248         ; single exit point. IRQ is hardware-masked while it runs.
                      (    forth6809.asm):02249         ; IRQH
                      (    forth6809.asm):02250         ;    Inputs:
                      (    forth6809.asm):02251         ;        none (hardware interrupt entry)
                      (    forth6809.asm):02252         ;    Outputs:
                      (    forth6809.asm):02253         ;        none (returns with RTI)
                      (    forth6809.asm):02254         ;    Registers: all registers are saved and restored by the interrupt.
                      (    forth6809.asm):02255         ; Original comment: shadow IRQH.0.
                      (    forth6809.asm):02256         ; ------------------------------------------------------------
DAA7 B6C008           (    forth6809.asm):02257         IRQH:       LDA   ACIASR            ; Get the status.
                      (    forth6809.asm):02258         
DAAA 8580             (    forth6809.asm):02259                     BITA  #SR_IRQ           ; Is the ACIA the interrupt source?
DAAC 2708             (    forth6809.asm):02260                     BEQ   IRQDONE0          ; No! Just exit.
DAAE 8501             (    forth6809.asm):02261                     BITA  #SR_RDRF          ; Is an incoming character available?
DAB0 2605             (    forth6809.asm):02262                     BNE   INCHAR
DAB2 8502             (    forth6809.asm):02263                     BITA  #SR_TDRE          ; Is the slot for an outgoing character available?
DAB4 263C             (    forth6809.asm):02264                     BNE   OUTCHAR
                      (    forth6809.asm):02265                                             ; Ignore all other interrupts such as DCD change.
DAB6 3B               (    forth6809.asm):02266         IRQDONE0:   RTI                     ; Single point of exit - re-enables interrupts
                      (    forth6809.asm):02267                                             ; & restores state.
                      (    forth6809.asm):02268         
DAB7                  (    forth6809.asm):02269         INCHAR:
DAB7 F6C009           (    forth6809.asm):02270                     LDB   ACIADR            ; Get the char & clear RDRF & error flags.
DABA 8570             (    forth6809.asm):02271                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):02272                                             ; Any receiver error flagged?
DABC 2716             (    forth6809.asm):02273                     BEQ   INOK              ; No! - character is good, keep it.
                      (    forth6809.asm):02274         
DABE 8510             (    forth6809.asm):02275                     BITA  #SR_FE            ; Yes! char is corrupted, discard it.
DAC0 2703             (    forth6809.asm):02276                     BEQ   INXFE             ; Tally each flagged error independently -
DAC2 7C017C           (    forth6809.asm):02277                     INC   FECOUNT           ; more than one bit can be set at once.
DAC5 8520             (    forth6809.asm):02278         INXFE:      BITA  #SR_OVRN
DAC7 2703             (    forth6809.asm):02279                     BEQ   INXOVRN
DAC9 7C017D           (    forth6809.asm):02280                     INC   OVRNCOUNT
DACC 8540             (    forth6809.asm):02281         INXOVRN:    BITA  #SR_PE
DACE 2703             (    forth6809.asm):02282                     BEQ   INXPE
DAD0 7C017E           (    forth6809.asm):02283                     INC   PECOUNT
DAD3 3B               (    forth6809.asm):02284         INXPE:      RTI
                      (    forth6809.asm):02285         
DAD4 1F98             (    forth6809.asm):02286         INOK:       TFR   B,A               ; Transfer good character from the receiver.
DAD6 8E0180           (    forth6809.asm):02287                     LDX   #INBUF            ; Store it in the empty in buffer slot.
DAD9 F60176           (    forth6809.asm):02288                     LDB   INHEAD
DADC A785             (    forth6809.asm):02289                     STA   B,X
DADE 5C               (    forth6809.asm):02290                     INCB                    ; Figure out the new head,
DADF C43F             (    forth6809.asm):02291                     ANDB  #INBUFSZ-1        ; pointing to the next the empty in buffer slot.
DAE1 F10177           (    forth6809.asm):02292                     CMPB  INTAIL            ; Would the new head slot meet the tail?
DAE4 270B             (    forth6809.asm):02293                     BEQ   IRQDONE1          ; Don't allow it - buffer full, drop the character.
DAE6 F70176           (    forth6809.asm):02294                     STB   INHEAD            ; New head pointer is OK so store it.
                      (    forth6809.asm):02295                     ; Commented-out code moved to shadow: INCHAR.2
                      (    forth6809.asm):02296                     ; Reuse RegB (the new head) for the fill level.
                      (    forth6809.asm):02297                     ; See shadow: INCHAR.1
DAE9 F00177           (    forth6809.asm):02298                     SUBB  INTAIL            ; RegB: new head - tail = current fill level.
DAEC C43F             (    forth6809.asm):02299                     ANDB  #INBUFSZ-1
DAEE BDD9C6           (    forth6809.asm):02300                     JSR   CHKHI             ; Protect the in buffer from overflow.
DAF1 3B               (    forth6809.asm):02301         IRQDONE1:   RTI
                      (    forth6809.asm):02302         
                      (    forth6809.asm):02303                     ; Commented-out code moved to shadow: OUTCHAR.1
                      (    forth6809.asm):02304         
DAF2 F6017A           (    forth6809.asm):02305         OUTCHAR:    LDB   OUTTAIL           ; Is the out buffer empty?
DAF5 F10179           (    forth6809.asm):02306                     CMPB  OUTHEAD
DAF8 270F             (    forth6809.asm):02307                     BEQ   TXOFF             ; Yes! Stop transmitting.
                      (    forth6809.asm):02308         
DAFA 8E01C0           (    forth6809.asm):02309                     LDX   #OUTBUF           ; No! The out buffer is occupied.
DAFD A685             (    forth6809.asm):02310                     LDA   B,X               ; Get the character from the out buffer.
DAFF B7C009           (    forth6809.asm):02311                     STA   ACIADR            ; Transmit the char.
                      (    forth6809.asm):02312         
DB02 5C               (    forth6809.asm):02313                     INCB                    ; Update the tail pointer pointing to the next char.
DB03 C43F             (    forth6809.asm):02314                     ANDB  #OUTBUFSZ-1
DB05 F7017A           (    forth6809.asm):02315                     STB   OUTTAIL
DB08 3B               (    forth6809.asm):02316         IRQDONE2    RTI
                      (    forth6809.asm):02317         
DB09                  (    forth6809.asm):02318         TXOFF:                              ; The output ring is empty.
                      (    forth6809.asm):02319                     ; Commented-out code moved to shadow: TXOFF.1
DB09 7F017B           (    forth6809.asm):02320                     CLR   OUTACTIVITY
DB0C BDD9AB           (    forth6809.asm):02321                     JSR   UPDATE_RTS
DB0F 3B               (    forth6809.asm):02322         IRQDONE3    RTI
                      (    forth6809.asm):02323         
                      (    forth6809.asm):02324                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):02325         
DB10                  (    forth6809.asm):02326         IRQH:       RTI                     ; polling mode (SERIALPOLL=1) - ACIA
                      (    forth6809.asm):02327                                             ; interrupts are never enabled (see
                      (    forth6809.asm):02328                                             ; COLDSTRT's CR_POLL init), so this should
                      (    forth6809.asm):02329                                             ; never fire; kept as a safe stub matching
                      (    forth6809.asm):02330                                             ; the other unused vectors below
                      (    forth6809.asm):02331                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):02332         
                      (    forth6809.asm):02333         ; ------------------------------------------------------------
                      (    forth6809.asm):02334         ; Unused interrupt handlers: return immediately. SWIH instead
                      (    forth6809.asm):02335         ; pushes the throw code -99 and jumps to THROW.
                      (    forth6809.asm):02336         ; ------------------------------------------------------------
DB10 3B               (    forth6809.asm):02337         SWI3H:      RTI
DB11 3B               (    forth6809.asm):02338         SWI2H:      RTI
DB12 3B               (    forth6809.asm):02339         FIRQH:      RTI
DB13 3B               (    forth6809.asm):02340         NMIH:       RTI                     ; unused now that NMI -> WARM
DB14 CCFF9D           (    forth6809.asm):02341         SWIH:       LDD   #-99              ; placeholder hardware-trap code; push and
DB17 3606             (    forth6809.asm):02342                     PSHU  D                 ; JMP THROW, per the CATCH/THROW turn
DB19 7EE542           (    forth6809.asm):02343                     JMP   THROWW
                      (    forth6809.asm):02344         
                      (    forth6809.asm):02345         ; ============================================================
                      (    forth6809.asm):02346         ; SECTION 4: COLD / ABORT / QUIT  (with CATCH-wrapped INTERPRET)
                      (    forth6809.asm):02347         ; ============================================================
                      (    forth6809.asm):02348         ; ------------------------------------------------------------
                      (    forth6809.asm):02349         ; Cold start: set the dictionary, code and variable pointers to
                      (    forth6809.asm):02350         ; their application areas, BASE to 10 and the input source to the
                      (    forth6809.asm):02351         ; terminal buffer, print the sign-on banner, then enter ABORT.
                      (    forth6809.asm):02352         ; COLD
                      (    forth6809.asm):02353         ;    Inputs:
                      (    forth6809.asm):02354         ;        none (entered at reset)
                      (    forth6809.asm):02355         ;    Outputs:
                      (    forth6809.asm):02356         ;        none (does not return)
                      (    forth6809.asm):02357         ;    Registers: all changed.
                      (    forth6809.asm):02358         ; ------------------------------------------------------------
DB1C CC0240           (    forth6809.asm):02359         COLD:       LDD   #APPVARS
DB1F DD0A             (    forth6809.asm):02360                     STD   VARHERE
DB21 CC7000           (    forth6809.asm):02361                     LDD   #APPCODE
DB24 DD08             (    forth6809.asm):02362                     STD   CODEHERE
DB26 CC2000           (    forth6809.asm):02363                     LDD   #APPDICT
DB29 DD06             (    forth6809.asm):02364                     STD   DPHERE
DB2B CCD956           (    forth6809.asm):02365                     LDD   #BASELATEST
DB2E DD04             (    forth6809.asm):02366                     STD   LATEST
DB30 BDE190           (    forth6809.asm):02367                     JSR   WLINIT            ; FORTH wordlist, search order and CURRENT
                      (    forth6809.asm):02368         
DB33 CC000A           (    forth6809.asm):02369                     LDD   #10
DB36 DD02             (    forth6809.asm):02370                     STD   BASE
                      (    forth6809.asm):02371         
DB38 CC0106           (    forth6809.asm):02372                     LDD   #TIBBUF
DB3B DD39             (    forth6809.asm):02373                     STD   SRCADDR
DB3D CC0000           (    forth6809.asm):02374                     LDD   #0
DB40 DD3B             (    forth6809.asm):02375                     STD   SRCLEN
DB42 DD3D             (    forth6809.asm):02376                     STD   SRCID
                      (    forth6809.asm):02377         
DB44 8EDBEA           (    forth6809.asm):02378                     LDX   #SIGNON
DB47 3610             (    forth6809.asm):02379                     PSHU  X                 ; c-addr
DB49 CC000F           (    forth6809.asm):02380                     LDD   #SIGNONL
DB4C 3606             (    forth6809.asm):02381                     PSHU  D                 ; u
DB4E BDF551           (    forth6809.asm):02382                     JSR   TYPEW
DB51 BDFB60           (    forth6809.asm):02383                     JSR   CRW
DB54 2008             (    forth6809.asm):02384                     BRA   ABORT             ; Go to ABORT, skipping the ABORTW word.
                      (    forth6809.asm):02385         
                      (    forth6809.asm):02386         ; ------------------------------------------------------------
                      (    forth6809.asm):02387         ; ABORT  ( i*x -- ) ( R: j*x -- )
                      (    forth6809.asm):02388         ; Throw -1. With no CATCH frame, THROW falls into the ABORT reset below.
                      (    forth6809.asm):02389         ; ------------------------------------------------------------
DB56 CCFFFF           (    forth6809.asm):02390         ABORTW:     LDD   #-1
DB59 3606             (    forth6809.asm):02391                     PSHU  D                 ; throw code (-1)
DB5B 7EE542           (    forth6809.asm):02392                     JMP   THROWW
                      (    forth6809.asm):02393         
                      (    forth6809.asm):02394         ; ------------------------------------------------------------
                      (    forth6809.asm):02395         ; Reset the data stack to its base, then fall through into QUITW.
                      (    forth6809.asm):02396         ; ABORT
                      (    forth6809.asm):02397         ;    Inputs:
                      (    forth6809.asm):02398         ;        none
                      (    forth6809.asm):02399         ;    Outputs:
                      (    forth6809.asm):02400         ;        none (does not return)
                      (    forth6809.asm):02401         ;    Registers: RegU changed.
                      (    forth6809.asm):02402         ; ------------------------------------------------------------
DB5E CEBD00           (    forth6809.asm):02403         ABORT:      LDU   #SP0
                      (    forth6809.asm):02404                     ; falls through into QUIT
                      (    forth6809.asm):02405         
                      (    forth6809.asm):02406         ; ------------------------------------------------------------
                      (    forth6809.asm):02407         ; QUIT  ( -- ) ( R: i*x -- )
                      (    forth6809.asm):02408         ; Empty the return stack, set interpretation state, then loop reading
                      (    forth6809.asm):02409         ; a line and interpreting it under CATCH. Errors are reported as
                      (    forth6809.asm):02410         ; "ERROR n"; -1 (ABORT) is silent. Never returns.
                      (    forth6809.asm):02411         ; ------------------------------------------------------------
DB61 10CEC000         (    forth6809.asm):02412         QUITW:      LDS   #RP0
DB65 CC0000           (    forth6809.asm):02413                     LDD   #0
DB68 DD00             (    forth6809.asm):02414                     STD   STATE             ; See bugfix: QUITW.1
                      (    forth6809.asm):02415         
DB6A BDE4ED           (    forth6809.asm):02416         QLOOP:      JSR   QUERYW
                      (    forth6809.asm):02417         
DB6D DC06             (    forth6809.asm):02418                     LDD   DPHERE            ; Checkpoint on the return stack. CATCH
DB6F 3406             (    forth6809.asm):02419                     PSHS  D                 ; and THROW restore S, so the frame is
DB71 DC08             (    forth6809.asm):02420                     LDD   CODEHERE          ; intact whichever way INTERPRET ends.
DB73 3406             (    forth6809.asm):02421                     PSHS  D                 ; See shadow QLOOP.2
DB75 DC0A             (    forth6809.asm):02422                     LDD   VARHERE
DB77 3406             (    forth6809.asm):02423                     PSHS  D
DB79 DC04             (    forth6809.asm):02424                     LDD   LATEST
DB7B 3406             (    forth6809.asm):02425                     PSHS  D
                      (    forth6809.asm):02426         
DB7D CCDFBA           (    forth6809.asm):02427                     LDD   #INTERPRET
DB80 3606             (    forth6809.asm):02428                     PSHU  D                 ; xt
DB82 BDE516           (    forth6809.asm):02429                     JSR   CATCHW
DB85 3706             (    forth6809.asm):02430                     PULU  D                 ; throw code (0 = no error)
DB87 3406             (    forth6809.asm):02431                     PSHS  D                 ; frame: 0,S code  2,S LATEST  4,S VARHERE
DB89 10830000         (    forth6809.asm):02432                     CMPD  #0                ;        6,S CODEHERE  8,S DPHERE
DB8D 2743             (    forth6809.asm):02433                     BEQ   QOK
                      (    forth6809.asm):02434         
DB8F EC68             (    forth6809.asm):02435                     LDD   8,S
DB91 DD06             (    forth6809.asm):02436                     STD   DPHERE
DB93 BDE1B1           (    forth6809.asm):02437                     JSR   PRUNE             ; unlink headers newer than DPHERE
DB96 EC66             (    forth6809.asm):02438                     LDD   6,S
DB98 DD08             (    forth6809.asm):02439                     STD   CODEHERE
DB9A EC64             (    forth6809.asm):02440                     LDD   4,S
DB9C DD0A             (    forth6809.asm):02441                     STD   VARHERE
DB9E EC62             (    forth6809.asm):02442                     LDD   2,S
DBA0 DD04             (    forth6809.asm):02443                     STD   LATEST
DBA2 CEBD00           (    forth6809.asm):02444                     LDU   #SP0
                      (    forth6809.asm):02445         
                      (    forth6809.asm):02446                     ; Return to interpretation state after a caught error.
                      (    forth6809.asm):02447                     ; See bugfix: QLOOP.1
DBA5 CC0000           (    forth6809.asm):02448                     LDD   #0
DBA8 DD00             (    forth6809.asm):02449                     STD   STATE
                      (    forth6809.asm):02450         
DBAA ECE4             (    forth6809.asm):02451                     LDD   ,S                ; -1 is ABORT: reset silently, no "ERROR -1"
DBAC 1083FFFF         (    forth6809.asm):02452                     CMPD  #-1
DBB0 2605             (    forth6809.asm):02453                     BNE   QSHOWERR
DBB2 326A             (    forth6809.asm):02454                     LEAS  10,S              ; drop the frame
DBB4 16FFB3           (    forth6809.asm):02455                     LBRA  QLOOP
                      (    forth6809.asm):02456         
DBB7 BDFB60           (    forth6809.asm):02457         QSHOWERR:   JSR   CRW
DBBA 8EDBFD           (    forth6809.asm):02458                     LDX   #ERRMSG
DBBD 3610             (    forth6809.asm):02459                     PSHU  X                 ; c-addr
DBBF CC0008           (    forth6809.asm):02460                     LDD   #ERRMSGL
DBC2 3606             (    forth6809.asm):02461                     PSHU  D                 ; u
DBC4 BDF551           (    forth6809.asm):02462                     JSR   TYPEW
DBC7 ECE4             (    forth6809.asm):02463                     LDD   ,S
DBC9 3606             (    forth6809.asm):02464                     PSHU  D                 ; n
DBCB BDFA2F           (    forth6809.asm):02465                     JSR   DOTW
DBCE 326A             (    forth6809.asm):02466                     LEAS  10,S              ; drop the frame
DBD0 2098             (    forth6809.asm):02467                     BRA   QLOOP
                      (    forth6809.asm):02468         
DBD2 326A             (    forth6809.asm):02469         QOK:        LEAS  10,S              ; drop the frame
DBD4 BDFB60           (    forth6809.asm):02470                     JSR   CRW               ; See bugfix: QOK.1
DBD7 DC00             (    forth6809.asm):02471                     LDD   STATE
DBD9 268F             (    forth6809.asm):02472                     BNE   QLOOP
DBDB 8EDBF9           (    forth6809.asm):02473                     LDX   #OKMSG
DBDE 3610             (    forth6809.asm):02474                     PSHU  X                 ; c-addr
DBE0 CC0004           (    forth6809.asm):02475                     LDD   #OKMSGL
DBE3 3606             (    forth6809.asm):02476                     PSHU  D                 ; u
DBE5 BDF551           (    forth6809.asm):02477                     JSR   TYPEW
DBE8 2080             (    forth6809.asm):02478                     BRA   QLOOP
                      (    forth6809.asm):02479         
DBEA 3638303920464F52 (    forth6809.asm):02480         SIGNON:     FCC   "6809 FORTH v1.0"
     54482076312E30
     000F             (    forth6809.asm):02481         SIGNONL     EQU   *-SIGNON
DBF9 20206F6B         (    forth6809.asm):02482         OKMSG:      FCC   "  ok"
     0004             (    forth6809.asm):02483         OKMSGL      EQU   *-OKMSG
DBFD 20204552524F5220 (    forth6809.asm):02484         ERRMSG:     FCC   "  ERROR "
     0008             (    forth6809.asm):02485         ERRMSGL     EQU   *-ERRMSG
                      (    forth6809.asm):02486         
                      (    forth6809.asm):02487         ; ============================================================
                      (    forth6809.asm):02488         ; SECTION 5: INNER-INTERPRETER SUPPORT (LIT, ZBRANCH, BRANCH,
                      (    forth6809.asm):02489         ; DODOES, DODEFER, EXECUTE)
                      (    forth6809.asm):02490         ; ============================================================
                      (    forth6809.asm):02491         ; ------------------------------------------------------------
                      (    forth6809.asm):02492         ; Run-time for a literal: fetch the inline cell that follows the
                      (    forth6809.asm):02493         ; calling JSR, push it, and advance the return address past it.
                      (    forth6809.asm):02494         ; LIT   ( -- x )
                      (    forth6809.asm):02495         ;    Inputs:
                      (    forth6809.asm):02496         ;        return stack top = address of the inline 16-bit literal
                      (    forth6809.asm):02497         ;    Outputs:
                      (    forth6809.asm):02498         ;        x pushed on the data stack; return address advanced by 2
                      (    forth6809.asm):02499         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02500         ; ------------------------------------------------------------
DC05 3510             (    forth6809.asm):02501         LIT:        PULS  X
DC07 EC81             (    forth6809.asm):02502                     LDD   ,X++
DC09 3606             (    forth6809.asm):02503                     PSHU  D                 ; x
DC0B 3410             (    forth6809.asm):02504                     PSHS  X
DC0D 39               (    forth6809.asm):02505                     RTS
                      (    forth6809.asm):02506         
                      (    forth6809.asm):02507         ; ------------------------------------------------------------
                      (    forth6809.asm):02508         ; Run-time for a conditional branch: take the inline offset if the
                      (    forth6809.asm):02509         ; flag is false, otherwise skip it. The offset is relative to its own
                      (    forth6809.asm):02510         ; address.
                      (    forth6809.asm):02511         ; ZBRANCH   ( flag -- )
                      (    forth6809.asm):02512         ;    Inputs:
                      (    forth6809.asm):02513         ;        flag on the data stack
                      (    forth6809.asm):02514         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02515         ;    Outputs:
                      (    forth6809.asm):02516         ;        flag removed; return address set to the branch target or past
                      (    forth6809.asm):02517         ;        the offset
                      (    forth6809.asm):02518         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02519         ; ------------------------------------------------------------
DC0E 3706             (    forth6809.asm):02520         ZBRANCH:    PULU  D                 ; flag
DC10 3510             (    forth6809.asm):02521                     PULS  X
DC12 10830000         (    forth6809.asm):02522                     CMPD  #0
DC16 2607             (    forth6809.asm):02523                     BNE   ZSKIP
DC18 EC84             (    forth6809.asm):02524                     LDD   ,X
DC1A 308B             (    forth6809.asm):02525                     LEAX  D,X
DC1C 3410             (    forth6809.asm):02526                     PSHS  X
DC1E 39               (    forth6809.asm):02527                     RTS
DC1F 3002             (    forth6809.asm):02528         ZSKIP:      LEAX  2,X
DC21 3410             (    forth6809.asm):02529                     PSHS  X
DC23 39               (    forth6809.asm):02530                     RTS
                      (    forth6809.asm):02531         
                      (    forth6809.asm):02532         ; ------------------------------------------------------------
                      (    forth6809.asm):02533         ; Run-time for an unconditional branch: add the inline offset
                      (    forth6809.asm):02534         ; (relative to its own address) to the return address.
                      (    forth6809.asm):02535         ; BRANCH
                      (    forth6809.asm):02536         ;    Inputs:
                      (    forth6809.asm):02537         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02538         ;    Outputs:
                      (    forth6809.asm):02539         ;        return address set to the branch target
                      (    forth6809.asm):02540         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02541         ; ------------------------------------------------------------
DC24 3510             (    forth6809.asm):02542         BRANCH:     PULS  X
DC26 EC84             (    forth6809.asm):02543                     LDD   ,X
DC28 308B             (    forth6809.asm):02544                     LEAX  D,X
DC2A 3410             (    forth6809.asm):02545                     PSHS  X
DC2C 39               (    forth6809.asm):02546                     RTS
                      (    forth6809.asm):02547         
                      (    forth6809.asm):02548         ; ------------------------------------------------------------
                      (    forth6809.asm):02549         ; Run-time entry of a CREATEd or DOES>-defined word. Its code is a
                      (    forth6809.asm):02550         ; trampoline: JSR DODOES, a BEHAVIOR address, then the data-field
                      (    forth6809.asm):02551         ; address. Pushes the data-field address and jumps to BEHAVIOR.
                      (    forth6809.asm):02552         ; DODOES   ( -- pfa )
                      (    forth6809.asm):02553         ;    Inputs:
                      (    forth6809.asm):02554         ;        return stack top = address of the BEHAVIOR cell in the
                      (    forth6809.asm):02555         ;        trampoline
                      (    forth6809.asm):02556         ;    Outputs:
                      (    forth6809.asm):02557         ;        pfa pushed on the data stack; control passes to BEHAVIOR
                      (    forth6809.asm):02558         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02559         ; ------------------------------------------------------------
DC2D 3510             (    forth6809.asm):02560         DODOES:     PULS  X
DC2F 10AE81           (    forth6809.asm):02561                     LDY   ,X++
DC32 EC84             (    forth6809.asm):02562                     LDD   ,X
DC34 3606             (    forth6809.asm):02563                     PSHU  D                 ; pfa
DC36 6EA4             (    forth6809.asm):02564                     JMP   ,Y
                      (    forth6809.asm):02565         
                      (    forth6809.asm):02566         ; ------------------------------------------------------------
                      (    forth6809.asm):02567         ; Default BEHAVIOR for a CREATEd word: do nothing, leaving the data-
                      (    forth6809.asm):02568         ; field address on the stack.
                      (    forth6809.asm):02569         ; DOESRT0
                      (    forth6809.asm):02570         ;    Inputs:
                      (    forth6809.asm):02571         ;        none
                      (    forth6809.asm):02572         ;    Outputs:
                      (    forth6809.asm):02573         ;        none
                      (    forth6809.asm):02574         ;    Registers: none.
                      (    forth6809.asm):02575         ; ------------------------------------------------------------
DC38 39               (    forth6809.asm):02576         DOESRT0:    RTS
                      (    forth6809.asm):02577         
                      (    forth6809.asm):02578         ; ------------------------------------------------------------
                      (    forth6809.asm):02579         ; Run-time for DOES>: patch the BEHAVIOR cell of the most recent
                      (    forth6809.asm):02580         ; definition with the code that follows the calling JSR, then return
                      (    forth6809.asm):02581         ; two levels up, skipping the rest of the defining word.
                      (    forth6809.asm):02582         ; SETDOES
                      (    forth6809.asm):02583         ;    Inputs:
                      (    forth6809.asm):02584         ;        return stack top = address after "JSR SETDOES" (the new
                      (    forth6809.asm):02585         ;        BEHAVIOR)
                      (    forth6809.asm):02586         ;        next on the return stack = the defining word's own return
                      (    forth6809.asm):02587         ;        address
                      (    forth6809.asm):02588         ;    Outputs:
                      (    forth6809.asm):02589         ;        BEHAVIOR cell of LATEST patched; control returns to the
                      (    forth6809.asm):02590         ;        defining word's caller
                      (    forth6809.asm):02591         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02592         ; ------------------------------------------------------------
DC39 3510             (    forth6809.asm):02593         SETDOES:    PULS  X                 ; X = addr right after "JSR SETDOES" - new BEHAVIOR
DC3B 1F12             (    forth6809.asm):02594                     TFR   X,Y               ; Y = new BEHAVIOR, kept across the walk
                      (    forth6809.asm):02595         
DC3D 9E04             (    forth6809.asm):02596                     LDX   LATEST
DC3F E684             (    forth6809.asm):02597                     LDB   ,X
DC41 C41F             (    forth6809.asm):02598                     ANDB  #$1F
DC43 4F               (    forth6809.asm):02599                     CLRA
DC44 308B             (    forth6809.asm):02600                     LEAX  D,X               ; header + name length
DC46 EC03             (    forth6809.asm):02601                     LDD   3,X               ; D = CFA (trampoline address), past name and LINK
DC48 C30003           (    forth6809.asm):02602                     ADDD  #3                ; +3 -> BEHAVIOR field (past JSR DODOES)
DC4B 1F01             (    forth6809.asm):02603                     TFR   D,X
                      (    forth6809.asm):02604         
DC4D 10AF84           (    forth6809.asm):02605                     STY   ,X                ; patch it
                      (    forth6809.asm):02606         
DC50 3510             (    forth6809.asm):02607                     PULS  X                 ; X = the OUTER defining word's own return addr
DC52 6E84             (    forth6809.asm):02608                     JMP   ,X                ; jump there directly - "double RTS"
                      (    forth6809.asm):02609         
                      (    forth6809.asm):02610         ; ------------------------------------------------------------
                      (    forth6809.asm):02611         ; BEHAVIOR of a DEFERred word: execute the xt stored in its data
                      (    forth6809.asm):02612         ; field. Tail-calls the xt, so it returns to the original caller.
                      (    forth6809.asm):02613         ; DODEFER   ( pfa -- )
                      (    forth6809.asm):02614         ;    Inputs:
                      (    forth6809.asm):02615         ;        pfa on the data stack
                      (    forth6809.asm):02616         ;    Outputs:
                      (    forth6809.asm):02617         ;        pfa removed; the stored xt is executed
                      (    forth6809.asm):02618         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02619         ; ------------------------------------------------------------
DC54 3710             (    forth6809.asm):02620         DODEFER:    PULU  X                 ; pfa
DC56 EC84             (    forth6809.asm):02621                     LDD   ,X
DC58 1F01             (    forth6809.asm):02622                     TFR   D,X
DC5A 6E84             (    forth6809.asm):02623                     JMP   ,X
                      (    forth6809.asm):02624         
                      (    forth6809.asm):02625         ; ------------------------------------------------------------
                      (    forth6809.asm):02626         ; Initial xt of a DEFER: throws -21 until IS stores a real xt.
                      (    forth6809.asm):02627         ; DOABORTUNDEF
                      (    forth6809.asm):02628         ;    Inputs:
                      (    forth6809.asm):02629         ;        none
                      (    forth6809.asm):02630         ;    Outputs:
                      (    forth6809.asm):02631         ;        none (does not return)
                      (    forth6809.asm):02632         ;    Registers: RegD changed.
                      (    forth6809.asm):02633         ; ------------------------------------------------------------
DC5C                  (    forth6809.asm):02634         DOABORTUNDEF:
DC5C CCFFEB           (    forth6809.asm):02635                     LDD   #-21
DC5F 3606             (    forth6809.asm):02636                     PSHU  D                 ; throw code (-21)
DC61 7EE542           (    forth6809.asm):02637                     JMP   THROWW
                      (    forth6809.asm):02638         
                      (    forth6809.asm):02639         ; ------------------------------------------------------------
                      (    forth6809.asm):02640         ; BEHAVIOR of a MARKER word: restore the dictionary, code and variable
                      (    forth6809.asm):02641         ; pointers and LATEST from the four cells saved when it was defined,
                      (    forth6809.asm):02642         ; then the search order state (SRCHSAVESZ bytes after them), then
                      (    forth6809.asm):02643         ; unlink every RAM header newer than DPHERE from every wordlist.
                      (    forth6809.asm):02644         ; DOMARKER   ( pfa -- )
                      (    forth6809.asm):02645         ;    Inputs:
                      (    forth6809.asm):02646         ;        pfa on the data stack (the saved cells)
                      (    forth6809.asm):02647         ;    Outputs:
                      (    forth6809.asm):02648         ;        pfa removed; DPHERE, CODEHERE, VARHERE, LATEST, WLEND, CURRENT
                      (    forth6809.asm):02649         ;        and the search order restored; wordlists pruned
                      (    forth6809.asm):02650         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02651         ; ------------------------------------------------------------
DC64 3710             (    forth6809.asm):02652         DOMARKER:   PULU  X                 ; pfa
DC66 EC84             (    forth6809.asm):02653                     LDD   ,X
DC68 DD06             (    forth6809.asm):02654                     STD   DPHERE
DC6A EC02             (    forth6809.asm):02655                     LDD   2,X
DC6C DD08             (    forth6809.asm):02656                     STD   CODEHERE
DC6E EC04             (    forth6809.asm):02657                     LDD   4,X
DC70 DD0A             (    forth6809.asm):02658                     STD   VARHERE
DC72 EC06             (    forth6809.asm):02659                     LDD   6,X
DC74 DD04             (    forth6809.asm):02660                     STD   LATEST
DC76 3008             (    forth6809.asm):02661                     LEAX  8,X               ; the saved search-order state follows
DC78 108E0045         (    forth6809.asm):02662                     LDY   #SRCHSAVE
DC7C C616             (    forth6809.asm):02663                     LDB   #SRCHSAVESZ
DC7E A680             (    forth6809.asm):02664         DMCOPY:     LDA   ,X+
DC80 A7A0             (    forth6809.asm):02665                     STA   ,Y+
DC82 5A               (    forth6809.asm):02666                     DECB
DC83 26F9             (    forth6809.asm):02667                     BNE   DMCOPY
DC85 DC06             (    forth6809.asm):02668                     LDD   DPHERE
DC87 7EE1B1           (    forth6809.asm):02669                     JMP   PRUNE             ; unlink headers newer than DPHERE
                      (    forth6809.asm):02670         
                      (    forth6809.asm):02671         ; ------------------------------------------------------------
                      (    forth6809.asm):02672         ; EXECUTE  ( i*x xt -- j*x )
                      (    forth6809.asm):02673         ; Execute the word whose execution token is xt.
                      (    forth6809.asm):02674         ; ------------------------------------------------------------
DC8A 3710             (    forth6809.asm):02675         EXECUTEW:   PULU  X                 ; xt
DC8C AD84             (    forth6809.asm):02676                     JSR   ,X
DC8E 39               (    forth6809.asm):02677                     RTS
                      (    forth6809.asm):02678         
                      (    forth6809.asm):02679         ; ============================================================
                      (    forth6809.asm):02680         ; SECTION 6: COMMA FAMILY (factored via APPENDCELL/APPENDBYTE)
                      (    forth6809.asm):02681         ; ============================================================
                      (    forth6809.asm):02682         ; ------------------------------------------------------------
                      (    forth6809.asm):02683         ; Append a 16-bit cell to the area whose "here" pointer is at RegX
                      (    forth6809.asm):02684         ; (CODEHERE or VARHERE), and advance that pointer by 2.
                      (    forth6809.asm):02685         ; APPENDCELL   ( x -- )
                      (    forth6809.asm):02686         ;    Inputs:
                      (    forth6809.asm):02687         ;        RegX = address of the here pointer
                      (    forth6809.asm):02688         ;        x on the data stack
                      (    forth6809.asm):02689         ;    Outputs:
                      (    forth6809.asm):02690         ;        x stored at the old here value; pointer advanced by 2
                      (    forth6809.asm):02691         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02692         ; ------------------------------------------------------------
DC8F 3706             (    forth6809.asm):02693         APPENDCELL: PULU  D                 ; x
DC91 10AE84           (    forth6809.asm):02694                     LDY   ,X
DC94 EDA1             (    forth6809.asm):02695                     STD   ,Y++
DC96 10AF84           (    forth6809.asm):02696                     STY   ,X
DC99 39               (    forth6809.asm):02697                     RTS
                      (    forth6809.asm):02698         
                      (    forth6809.asm):02699         ; ------------------------------------------------------------
                      (    forth6809.asm):02700         ; Append the low byte of the top cell to the area whose "here" pointer
                      (    forth6809.asm):02701         ; is at RegX (CODEHERE or VARHERE), and advance that pointer by 1.
                      (    forth6809.asm):02702         ; APPENDBYTE   ( char -- )
                      (    forth6809.asm):02703         ;    Inputs:
                      (    forth6809.asm):02704         ;        RegX = address of the here pointer
                      (    forth6809.asm):02705         ;        char on the data stack
                      (    forth6809.asm):02706         ;    Outputs:
                      (    forth6809.asm):02707         ;        char stored at the old here value; pointer advanced by 1
                      (    forth6809.asm):02708         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02709         ; ------------------------------------------------------------
DC9A 3706             (    forth6809.asm):02710         APPENDBYTE: PULU  D                 ; char
DC9C 10AE84           (    forth6809.asm):02711                     LDY   ,X
DC9F E7A0             (    forth6809.asm):02712                     STB   ,Y+
DCA1 10AF84           (    forth6809.asm):02713                     STY   ,X
DCA4 39               (    forth6809.asm):02714                     RTS
                      (    forth6809.asm):02715         
                      (    forth6809.asm):02716         ; ------------------------------------------------------------
                      (    forth6809.asm):02717         ; ,  ( x -- )
                      (    forth6809.asm):02718         ; Append x to the code/data area (CODEHERE).
                      (    forth6809.asm):02719         ; ------------------------------------------------------------
DCA5 8E0008           (    forth6809.asm):02720         COMMAW:     LDX   #CODEHERE
DCA8 7EDC8F           (    forth6809.asm):02721                     JMP   APPENDCELL
                      (    forth6809.asm):02722         
                      (    forth6809.asm):02723         ; ------------------------------------------------------------
                      (    forth6809.asm):02724         ; CODECOMMA  ( x -- )
                      (    forth6809.asm):02725         ; Internal name for ",": append x at CODEHERE.
                      (    forth6809.asm):02726         ; ------------------------------------------------------------
DCAB 8E0008           (    forth6809.asm):02727         CODECOMMA:  LDX   #CODEHERE
DCAE 7EDC8F           (    forth6809.asm):02728                     JMP   APPENDCELL
                      (    forth6809.asm):02729         
                      (    forth6809.asm):02730         ; ------------------------------------------------------------
                      (    forth6809.asm):02731         ; C,  ( char -- )
                      (    forth6809.asm):02732         ; Append char to the code/data area (CODEHERE).
                      (    forth6809.asm):02733         ; ------------------------------------------------------------
DCB1 8E0008           (    forth6809.asm):02734         CCOMMAW:    LDX   #CODEHERE
DCB4 7EDC9A           (    forth6809.asm):02735                     JMP   APPENDBYTE
                      (    forth6809.asm):02736         
                      (    forth6809.asm):02737         ; ------------------------------------------------------------
                      (    forth6809.asm):02738         ; CCOMMA1  ( char -- )
                      (    forth6809.asm):02739         ; Internal name for "C,": append char at CODEHERE.
                      (    forth6809.asm):02740         ; ------------------------------------------------------------
DCB7 8E0008           (    forth6809.asm):02741         CCOMMA1:    LDX   #CODEHERE
DCBA 7EDC9A           (    forth6809.asm):02742                     JMP   APPENDBYTE
                      (    forth6809.asm):02743         
                      (    forth6809.asm):02744         ; ------------------------------------------------------------
                      (    forth6809.asm):02745         ; V,  ( x -- )
                      (    forth6809.asm):02746         ; Append x to the variable area (VARHERE).
                      (    forth6809.asm):02747         ; ------------------------------------------------------------
DCBD 8E000A           (    forth6809.asm):02748         VCOMMAW:    LDX   #VARHERE
DCC0 7EDC8F           (    forth6809.asm):02749                     JMP   APPENDCELL
                      (    forth6809.asm):02750         
                      (    forth6809.asm):02751         ; ------------------------------------------------------------
                      (    forth6809.asm):02752         ; VC,  ( char -- )
                      (    forth6809.asm):02753         ; Append char to the variable area (VARHERE).
                      (    forth6809.asm):02754         ; ------------------------------------------------------------
DCC3 8E000A           (    forth6809.asm):02755         VCCOMMAW:   LDX   #VARHERE
DCC6 7EDC9A           (    forth6809.asm):02756                     JMP   APPENDBYTE
                      (    forth6809.asm):02757         
                      (    forth6809.asm):02758         ; ------------------------------------------------------------
                      (    forth6809.asm):02759         ; ALLOT  ( n -- )
                      (    forth6809.asm):02760         ; Reserve n bytes in the code/data area by advancing CODEHERE.
                      (    forth6809.asm):02761         ; ------------------------------------------------------------
DCC9 3706             (    forth6809.asm):02762         ALLOTW:     PULU  D                 ; n
DCCB 9E08             (    forth6809.asm):02763                     LDX   CODEHERE
DCCD 308B             (    forth6809.asm):02764                     LEAX  D,X
DCCF 9F08             (    forth6809.asm):02765                     STX   CODEHERE
DCD1 39               (    forth6809.asm):02766                     RTS
                      (    forth6809.asm):02767         
                      (    forth6809.asm):02768         ; ------------------------------------------------------------
                      (    forth6809.asm):02769         ; VALLOT  ( n -- )
                      (    forth6809.asm):02770         ; Reserve n bytes in the variable area by advancing VARHERE.
                      (    forth6809.asm):02771         ; ------------------------------------------------------------
DCD2 3706             (    forth6809.asm):02772         VALLOTW:    PULU  D                 ; n
DCD4 9E0A             (    forth6809.asm):02773                     LDX   VARHERE
DCD6 308B             (    forth6809.asm):02774                     LEAX  D,X
DCD8 9F0A             (    forth6809.asm):02775                     STX   VARHERE
DCDA 39               (    forth6809.asm):02776                     RTS
                      (    forth6809.asm):02777         
                      (    forth6809.asm):02778         ; ------------------------------------------------------------
                      (    forth6809.asm):02779         ; HERE  ( -- addr )
                      (    forth6809.asm):02780         ; Return the next free address in the code/data area (CODEHERE).
                      (    forth6809.asm):02781         ; ------------------------------------------------------------
DCDB DC08             (    forth6809.asm):02782         HEREW:      LDD   CODEHERE
DCDD 3606             (    forth6809.asm):02783                     PSHU  D                 ; addr
DCDF 39               (    forth6809.asm):02784                     RTS
                      (    forth6809.asm):02785         
                      (    forth6809.asm):02786         ; ------------------------------------------------------------
                      (    forth6809.asm):02787         ; VHERE  ( -- addr )
                      (    forth6809.asm):02788         ; Return the next free address in the variable area (VARHERE).
                      (    forth6809.asm):02789         ; ------------------------------------------------------------
DCE0 DC0A             (    forth6809.asm):02790         VHEREW:     LDD   VARHERE
DCE2 3606             (    forth6809.asm):02791                     PSHU  D                 ; addr
DCE4 39               (    forth6809.asm):02792                     RTS
                      (    forth6809.asm):02793         
                      (    forth6809.asm):02794         ; ------------------------------------------------------------
                      (    forth6809.asm):02795         ; PAD  ( -- c-addr )
                      (    forth6809.asm):02796         ; Return the scratch buffer address, PADOFFSET bytes above CODEHERE.
                      (    forth6809.asm):02797         ; ------------------------------------------------------------
DCE5 DC08             (    forth6809.asm):02798         PADW:       LDD   CODEHERE
DCE7 C30080           (    forth6809.asm):02799                     ADDD  #PADOFFSET
DCEA 3606             (    forth6809.asm):02800                     PSHU  D                 ; c-addr
DCEC 39               (    forth6809.asm):02801                     RTS
                      (    forth6809.asm):02802         
                      (    forth6809.asm):02803         ; ------------------------------------------------------------
                      (    forth6809.asm):02804         ; UNUSED  ( -- u )
                      (    forth6809.asm):02805         ; Return the number of free bytes remaining in the code/data area.
                      (    forth6809.asm):02806         ; ------------------------------------------------------------
DCED CCB900           (    forth6809.asm):02807         UNUSEDW:    LDD   #CODETOP
DCF0 9308             (    forth6809.asm):02808                     SUBD  CODEHERE
DCF2 3606             (    forth6809.asm):02809                     PSHU  D                 ; u
DCF4 39               (    forth6809.asm):02810                     RTS
                      (    forth6809.asm):02811         
                      (    forth6809.asm):02812         ; ------------------------------------------------------------
                      (    forth6809.asm):02813         ; VUNUSED  ( -- u )
                      (    forth6809.asm):02814         ; Return the number of free bytes remaining in the variable area.
                      (    forth6809.asm):02815         ; ------------------------------------------------------------
DCF5 CC1FFF           (    forth6809.asm):02816         VUNUSEDW:   LDD   #APPVARSEND       ; See bugfix: VUNUSEDW.1
DCF8 930A             (    forth6809.asm):02817                     SUBD  VARHERE
DCFA 3606             (    forth6809.asm):02818                     PSHU  D                 ; u
DCFC 39               (    forth6809.asm):02819                     RTS
                      (    forth6809.asm):02820         
                      (    forth6809.asm):02821         ; ============================================================
                      (    forth6809.asm):02822         ; SECTION 7: HEADER (factored from :/CREATE/VARIABLE)
                      (    forth6809.asm):02823         ; ============================================================
                      (    forth6809.asm):02824         ; ------------------------------------------------------------
                      (    forth6809.asm):02825         ; Build a dictionary header for the next name in the input: parse the
                      (    forth6809.asm):02826         ; name, then lay down the length byte (with the smudge bit set if
                      (    forth6809.asm):02827         ; requested), the name, the link to the previous header and the code
                      (    forth6809.asm):02828         ; field address (CODEHERE). LATEST, DPHERE and the head of the CURRENT
                      (    forth6809.asm):02829         ; wordlist are updated.
                      (    forth6809.asm):02830         ; HEADER   ( smudge-flag "name" -- )
                      (    forth6809.asm):02831         ;    Inputs:
                      (    forth6809.asm):02832         ;        smudge-flag on the data stack (non-zero hides the new word)
                      (    forth6809.asm):02833         ;        name parsed from the input stream
                      (    forth6809.asm):02834         ;    Outputs:
                      (    forth6809.asm):02835         ;        header built at DPHERE, linked into the CURRENT wordlist;
                      (    forth6809.asm):02836         ;        LATEST = address of the new header
                      (    forth6809.asm):02837         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02838         ; ------------------------------------------------------------
DCFD CC0020           (    forth6809.asm):02839         HEADER:     LDD   #32
DD00 3606             (    forth6809.asm):02840                     PSHU  D
DD02 BDE03A           (    forth6809.asm):02841                     JSR   WORDW
DD05 3710             (    forth6809.asm):02842                     PULU  X                 ; c-addr of the name
DD07 3706             (    forth6809.asm):02843                     PULU  D                 ; smudge flag in B
DD09 A680             (    forth6809.asm):02844                     LDA   ,X+               ; name length, X = name text
DD0B 3402             (    forth6809.asm):02845                     PSHS  A                 ; 2,S = length (5k: S-frame, no scratch)
DD0D 5D               (    forth6809.asm):02846                     TSTB
DD0E 2702             (    forth6809.asm):02847                     BEQ   HDNOSM
DD10 8A40             (    forth6809.asm):02848                     ORA   #$40
DD12 109E06           (    forth6809.asm):02849         HDNOSM:     LDY   DPHERE
DD15 3420             (    forth6809.asm):02850                     PSHS  Y                 ; 0,S = address of the new header
DD17 A7A0             (    forth6809.asm):02851                     STA   ,Y+
DD19 E662             (    forth6809.asm):02852                     LDB   2,S
DD1B 2707             (    forth6809.asm):02853                     BEQ   HDNONM
DD1D A680             (    forth6809.asm):02854         HDCPY:      LDA   ,X+
DD1F A7A0             (    forth6809.asm):02855                     STA   ,Y+
DD21 5A               (    forth6809.asm):02856                     DECB
DD22 26F9             (    forth6809.asm):02857                     BNE   HDCPY
DD24 9E47             (    forth6809.asm):02858         HDNONM:     LDX   CURRENT           ; X = WID of the wordlist receiving the word
DD26 EC84             (    forth6809.asm):02859                     LDD   ,X
DD28 EDA1             (    forth6809.asm):02860                     STD   ,Y++              ; LINK = old head of that wordlist
DD2A DC08             (    forth6809.asm):02861                     LDD   CODEHERE
DD2C EDA1             (    forth6809.asm):02862                     STD   ,Y++
DD2E 109F06           (    forth6809.asm):02863                     STY   DPHERE
DD31 3506             (    forth6809.asm):02864                     PULS  D
DD33 DD04             (    forth6809.asm):02865                     STD   LATEST            ; LATEST = newest header of any wordlist
DD35 ED84             (    forth6809.asm):02866                     STD   ,X                ; and the new head of the CURRENT wordlist
DD37 3261             (    forth6809.asm):02867                     LEAS  1,S
DD39 39               (    forth6809.asm):02868                     RTS
                      (    forth6809.asm):02869         
                      (    forth6809.asm):02870         ; ============================================================
                      (    forth6809.asm):02871         ; SECTION 8: DEFINING WORDS
                      (    forth6809.asm):02872         ; ============================================================
                      (    forth6809.asm):02873         ; ------------------------------------------------------------
                      (    forth6809.asm):02874         ; :  ( "name" -- )
                      (    forth6809.asm):02875         ; Start a colon definition: parse the name, build a smudged header,
                      (    forth6809.asm):02876         ; record the new xt in CURXT, note the control-flow stack position in
                      (    forth6809.asm):02877         ; CSP and enter compile state.
                      (    forth6809.asm):02878         ; ------------------------------------------------------------
DD3A CCFFFF           (    forth6809.asm):02879         COLONW:     LDD   #TRUEV
DD3D 3606             (    forth6809.asm):02880                     PSHU  D
DD3F BDDCFD           (    forth6809.asm):02881                     JSR   HEADER
DD42 DC08             (    forth6809.asm):02882                     LDD   CODEHERE          ; Record this word's xt for RECURSE.
DD44 DD1F             (    forth6809.asm):02883                     STD   CURXT             ; See bugfix: COLONW.1
DD46 1F30             (    forth6809.asm):02884                     TFR   U,D
DD48 DD21             (    forth6809.asm):02885                     STD   CSP
DD4A CCFFFF           (    forth6809.asm):02886                     LDD   #-1
DD4D DD00             (    forth6809.asm):02887                     STD   STATE
DD4F 39               (    forth6809.asm):02888                     RTS
                      (    forth6809.asm):02889         
                      (    forth6809.asm):02890         ; ------------------------------------------------------------
                      (    forth6809.asm):02891         ; ;  ( -- )  IMMEDIATE
                      (    forth6809.asm):02892         ; End a colon definition: compile RTS, check that the control-flow
                      (    forth6809.asm):02893         ; stack is balanced (error -22 if not), clear the smudge bit of the
                      (    forth6809.asm):02894         ; new word and return to interpret state.
                      (    forth6809.asm):02895         ; ------------------------------------------------------------
DD50 CC0039           (    forth6809.asm):02896         SEMIW:      LDD   #RTSOPC
DD53 3606             (    forth6809.asm):02897                     PSHU  D
DD55 BDDCB7           (    forth6809.asm):02898                     JSR   CCOMMA1
DD58 1F30             (    forth6809.asm):02899                     TFR   U,D
DD5A 109321           (    forth6809.asm):02900                     CMPD  CSP
DD5D 2703             (    forth6809.asm):02901                     BEQ   SEMIOK
DD5F BDE50D           (    forth6809.asm):02902                     JSR   CFERR
DD62 9E04             (    forth6809.asm):02903         SEMIOK:     LDX   LATEST
DD64 A684             (    forth6809.asm):02904                     LDA   ,X
DD66 84BF             (    forth6809.asm):02905                     ANDA  #$BF
DD68 A784             (    forth6809.asm):02906                     STA   ,X
DD6A CC0000           (    forth6809.asm):02907                     LDD   #0
DD6D DD00             (    forth6809.asm):02908                     STD   STATE
DD6F 39               (    forth6809.asm):02909                     RTS
                      (    forth6809.asm):02910         
                      (    forth6809.asm):02911         ; ------------------------------------------------------------
                      (    forth6809.asm):02912         ; :NONAME  ( -- xt )
                      (    forth6809.asm):02913         ; Start an anonymous definition: no header is built and LATEST is left
                      (    forth6809.asm):02914         ; alone, so the word can never be found. Leaves the xt (the current
                      (    forth6809.asm):02915         ; CODEHERE) on the stack, records it in CURXT, notes the control-flow
                      (    forth6809.asm):02916         ; stack position in CSP and enters compile state.
                      (    forth6809.asm):02917         ; Original comment: shadow NONAMEW.0.
                      (    forth6809.asm):02918         ; ------------------------------------------------------------
DD70 DC08             (    forth6809.asm):02919         NONAMEW:    LDD   CODEHERE
DD72 3606             (    forth6809.asm):02920                     PSHU  D                 ; xt
DD74 DD1F             (    forth6809.asm):02921                     STD   CURXT             ; See bugfix: NONAMEW.1
DD76 1F30             (    forth6809.asm):02922                     TFR   U,D
DD78 DD21             (    forth6809.asm):02923                     STD   CSP
DD7A CCFFFF           (    forth6809.asm):02924                     LDD   #-1
DD7D DD00             (    forth6809.asm):02925                     STD   STATE
DD7F 39               (    forth6809.asm):02926                     RTS
                      (    forth6809.asm):02927         
                      (    forth6809.asm):02928         ; ------------------------------------------------------------
                      (    forth6809.asm):02929         ; Common start of every DODOES-style defining word: build a header
                      (    forth6809.asm):02930         ; and compile the DODOES trampoline followed by the behaviour address.
                      (    forth6809.asm):02931         ; BLDDOES
                      (    forth6809.asm):02932         ;    Inputs:
                      (    forth6809.asm):02933         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):02934         ;    Outputs:
                      (    forth6809.asm):02935         ;        header built, trampoline and behaviour cell compiled
                      (    forth6809.asm):02936         ;    Registers: all changed.
                      (    forth6809.asm):02937         ; BLDSELF
                      (    forth6809.asm):02938         ;    Inputs:
                      (    forth6809.asm):02939         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):02940         ;    Outputs:
                      (    forth6809.asm):02941         ;        as BLDDOES, then the PFA cell compiled pointing at the
                      (    forth6809.asm):02942         ;        cell that follows it (the word's own data field)
                      (    forth6809.asm):02943         ;    Registers: all changed.
                      (    forth6809.asm):02944         ; Used by CREATE, CONSTANT, 2CONSTANT, DEFER and MARKER (BLDSELF)
                      (    forth6809.asm):02945         ; and by VALUE (BLDDOES, which supplies its own PFA).
                      (    forth6809.asm):02946         ; ------------------------------------------------------------
DD80 3406             (    forth6809.asm):02947         BLDDOES:    PSHS  D                 ; behaviour address
DD82 CC0000           (    forth6809.asm):02948                     LDD   #0
DD85 3606             (    forth6809.asm):02949                     PSHU  D
DD87 BDDCFD           (    forth6809.asm):02950                     JSR   HEADER
DD8A CCDC2D           (    forth6809.asm):02951                     LDD   #DODOES
DD8D 3606             (    forth6809.asm):02952                     PSHU  D
DD8F BDE97D           (    forth6809.asm):02953                     JSR   CCALL
DD92 3506             (    forth6809.asm):02954                     PULS  D
DD94 3606             (    forth6809.asm):02955                     PSHU  D                 ; behaviour address
DD96 BDDCAB           (    forth6809.asm):02956                     JSR   CODECOMMA
DD99 39               (    forth6809.asm):02957                     RTS
                      (    forth6809.asm):02958         
DD9A BDDD80           (    forth6809.asm):02959         BLDSELF:    JSR   BLDDOES
DD9D DC08             (    forth6809.asm):02960                     LDD   CODEHERE          ; PFA = the cell after this one
DD9F C30002           (    forth6809.asm):02961                     ADDD  #2                ; See bugfix: CONSTANTW.1
DDA2 3606             (    forth6809.asm):02962                     PSHU  D
DDA4 BDDCAB           (    forth6809.asm):02963                     JSR   CODECOMMA
DDA7 39               (    forth6809.asm):02964                     RTS
                      (    forth6809.asm):02965         
                      (    forth6809.asm):02966         ; ------------------------------------------------------------
                      (    forth6809.asm):02967         ; CREATE  ( "name" -- )
                      (    forth6809.asm):02968         ; Build a header whose code is a DODOES trampoline. The default
                      (    forth6809.asm):02969         ; behaviour (DOESRT0) leaves the data-field address, the next free
                      (    forth6809.asm):02970         ; address in the code area, on the stack.
                      (    forth6809.asm):02971         ; ------------------------------------------------------------
DDA8 CCDC38           (    forth6809.asm):02972         CREATEW:    LDD   #DOESRT0
DDAB BDDD9A           (    forth6809.asm):02973                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
DDAE 39               (    forth6809.asm):02974                     RTS
                      (    forth6809.asm):02975         
                      (    forth6809.asm):02976         ; ------------------------------------------------------------
                      (    forth6809.asm):02977         ; DOES>  ( -- )  IMMEDIATE, compile-only
                      (    forth6809.asm):02978         ; Compile a call to SETDOES, which at run time patches the behaviour
                      (    forth6809.asm):02979         ; of the word being defined.
                      (    forth6809.asm):02980         ; Original comment: shadow DOESGTW.0.
                      (    forth6809.asm):02981         ; ------------------------------------------------------------
DDAF CCDC39           (    forth6809.asm):02982         DOESGTW:    LDD   #SETDOES
DDB2 3606             (    forth6809.asm):02983                     PSHU  D
DDB4 BDE97D           (    forth6809.asm):02984                     JSR   CCALL
DDB7 39               (    forth6809.asm):02985                     RTS
                      (    forth6809.asm):02986         
                      (    forth6809.asm):02987         ; ------------------------------------------------------------
                      (    forth6809.asm):02988         ; VARIABLE  ( "name" -- )
                      (    forth6809.asm):02989         ; Build a word that returns the address of a new cell in the variable
                      (    forth6809.asm):02990         ; area, initialised to zero.
                      (    forth6809.asm):02991         ; ------------------------------------------------------------
DDB8 CC0000           (    forth6809.asm):02992         VARIABLEW:  LDD   #0
DDBB 3606             (    forth6809.asm):02993                     PSHU  D
DDBD BDDCFD           (    forth6809.asm):02994                     JSR   HEADER
DDC0 CCDC2D           (    forth6809.asm):02995                     LDD   #DODOES
DDC3 3606             (    forth6809.asm):02996                     PSHU  D
DDC5 BDE97D           (    forth6809.asm):02997                     JSR   CCALL
DDC8 CCDC38           (    forth6809.asm):02998                     LDD   #DOESRT0
DDCB 3606             (    forth6809.asm):02999                     PSHU  D
DDCD BDDCAB           (    forth6809.asm):03000                     JSR   CODECOMMA
DDD0 DC0A             (    forth6809.asm):03001                     LDD   VARHERE
DDD2 3606             (    forth6809.asm):03002                     PSHU  D
DDD4 BDDCAB           (    forth6809.asm):03003                     JSR   CODECOMMA
DDD7 CC0000           (    forth6809.asm):03004                     LDD   #0
DDDA 9E0A             (    forth6809.asm):03005                     LDX   VARHERE
DDDC ED81             (    forth6809.asm):03006                     STD   ,X++
DDDE 9F0A             (    forth6809.asm):03007                     STX   VARHERE
DDE0 39               (    forth6809.asm):03008                     RTS
                      (    forth6809.asm):03009         
                      (    forth6809.asm):03010         ; ------------------------------------------------------------
                      (    forth6809.asm):03011         ; @  ( a-addr -- x )
                      (    forth6809.asm):03012         ; Fetch the cell at a-addr. Also the behaviour of CONSTANT words.
                      (    forth6809.asm):03013         ; ------------------------------------------------------------
DDE1 3710             (    forth6809.asm):03014         FETCHW:     PULU  X                 ; a-addr
DDE3 EC84             (    forth6809.asm):03015                     LDD   ,X
DDE5 3606             (    forth6809.asm):03016                     PSHU  D                 ; x
DDE7 39               (    forth6809.asm):03017                     RTS
                      (    forth6809.asm):03018         
                      (    forth6809.asm):03019         ; ------------------------------------------------------------
                      (    forth6809.asm):03020         ; CONSTANT  ( x "name" -- )
                      (    forth6809.asm):03021         ; Build a word that returns x. The value is stored in the code area
                      (    forth6809.asm):03022         ; after the trampoline and fetched with @.
                      (    forth6809.asm):03023         ; ------------------------------------------------------------
DDE8 CCDDE1           (    forth6809.asm):03024         CONSTANTW:  LDD   #FETCHW
DDEB BDDD9A           (    forth6809.asm):03025                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
DDEE BDDCA5           (    forth6809.asm):03026                     JSR   COMMAW
DDF1 39               (    forth6809.asm):03027                     RTS
                      (    forth6809.asm):03028         
                      (    forth6809.asm):03029         ; ------------------------------------------------------------
                      (    forth6809.asm):03030         ; Behaviour of a VALUE word: fetch the value cell.
                      (    forth6809.asm):03031         ; DOVALUE   ( pfa -- x )
                      (    forth6809.asm):03032         ;    Inputs:
                      (    forth6809.asm):03033         ;        pfa on the data stack (address of the value cell)
                      (    forth6809.asm):03034         ;    Outputs:
                      (    forth6809.asm):03035         ;        pfa replaced by the value
                      (    forth6809.asm):03036         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):03037         ; ------------------------------------------------------------
DDF2 3710             (    forth6809.asm):03038         DOVALUE:    PULU  X                 ; pfa
DDF4 EC84             (    forth6809.asm):03039                     LDD   ,X
DDF6 3606             (    forth6809.asm):03040                     PSHU  D                 ; x
DDF8 39               (    forth6809.asm):03041                     RTS
                      (    forth6809.asm):03042         
                      (    forth6809.asm):03043         ; ------------------------------------------------------------
                      (    forth6809.asm):03044         ; VALUE  ( x "name" -- )
                      (    forth6809.asm):03045         ; Build a word that returns x, which can be changed with TO. The value
                      (    forth6809.asm):03046         ; cell is kept in the variable area so that it is writable.
                      (    forth6809.asm):03047         ; ------------------------------------------------------------
DDF9 CCDDF2           (    forth6809.asm):03048         VALUEW:     LDD   #DOVALUE
DDFC BDDD80           (    forth6809.asm):03049                     JSR   BLDDOES
DDFF DC0A             (    forth6809.asm):03050                     LDD   VARHERE           ; PFA = VARHERE (writable space)
DE01 3606             (    forth6809.asm):03051                     PSHU  D                 ; See bugfix: VALUEW.1
DE03 BDDCAB           (    forth6809.asm):03052                     JSR   CODECOMMA
DE06 BDDCBD           (    forth6809.asm):03053                     JSR   VCOMMAW           ; store x in the variable area
DE09 39               (    forth6809.asm):03054                     RTS
                      (    forth6809.asm):03055         
                      (    forth6809.asm):03056         ; ------------------------------------------------------------
                      (    forth6809.asm):03057         ; Behaviour of a 2VALUE word: fetch the two-cell value, x2 at the
                      (    forth6809.asm):03058         ; lower address as 2@ expects.
                      (    forth6809.asm):03059         ; DO2VALUE   ( pfa -- x1 x2 )
                      (    forth6809.asm):03060         ; ------------------------------------------------------------
DE0A 7EF350           (    forth6809.asm):03061         DO2VALUE:   JMP   TWOFETCHW
                      (    forth6809.asm):03062         
                      (    forth6809.asm):03063         ; ------------------------------------------------------------
                      (    forth6809.asm):03064         ; 2VALUE  ( x1 x2 "name" -- )
                      (    forth6809.asm):03065         ; Build a word that returns x1 x2, which can be changed with TO. The
                      (    forth6809.asm):03066         ; two cells are kept in the variable area so that they are writable.
                      (    forth6809.asm):03067         ; ------------------------------------------------------------
DE0D CCDE0A           (    forth6809.asm):03068         TWOVALUEW:  LDD   #DO2VALUE
DE10 BDDD80           (    forth6809.asm):03069                     JSR   BLDDOES
DE13 DC0A             (    forth6809.asm):03070                     LDD   VARHERE           ; PFA = VARHERE (writable space)
DE15 3606             (    forth6809.asm):03071                     PSHU  D
DE17 BDDCAB           (    forth6809.asm):03072                     JSR   CODECOMMA
DE1A BDDCBD           (    forth6809.asm):03073                     JSR   VCOMMAW           ; x2 at the lower address
DE1D BDDCBD           (    forth6809.asm):03074                     JSR   VCOMMAW           ; then x1
DE20 39               (    forth6809.asm):03075                     RTS
                      (    forth6809.asm):03076         
                      (    forth6809.asm):03077         ; ------------------------------------------------------------
                      (    forth6809.asm):03078         ; TO  ( x "name" -- )  IMMEDIATE
                      (    forth6809.asm):03079         ; Store x in the named VALUE. When compiling, instead compile code to
                      (    forth6809.asm):03080         ; store a run-time x in it. Error -13 if the name is not found.
                      (    forth6809.asm):03081         ; ------------------------------------------------------------
DE21 CC0020           (    forth6809.asm):03082         TOW:        LDD   #32
DE24 3606             (    forth6809.asm):03083                     PSHU  D
DE26 BDE03A           (    forth6809.asm):03084                     JSR   WORDW
DE29 BDE123           (    forth6809.asm):03085                     JSR   FINDW
DE2C 3706             (    forth6809.asm):03086                     PULU  D
DE2E 10830000         (    forth6809.asm):03087                     CMPD  #0
DE32 260A             (    forth6809.asm):03088                     BNE   TOFOUND
DE34 3706             (    forth6809.asm):03089                     PULU  D
DE36 CCFFF3           (    forth6809.asm):03090                     LDD   #-13
DE39 3606             (    forth6809.asm):03091                     PSHU  D
DE3B BDE542           (    forth6809.asm):03092                     JSR   THROWW
DE3E AEC4             (    forth6809.asm):03093         TOFOUND:    LDX   ,U                ; xt: is it a 2VALUE? (behaviour cell at xt+3)
DE40 EC03             (    forth6809.asm):03094                     LDD   3,X
DE42 1083DE0A         (    forth6809.asm):03095                     CMPD  #DO2VALUE
DE46 271A             (    forth6809.asm):03096                     BEQ   TOTWO
DE48 BDEA3E           (    forth6809.asm):03097                     JSR   TOBODYW
DE4B DC00             (    forth6809.asm):03098                     LDD   STATE
DE4D 270C             (    forth6809.asm):03099                     BEQ   TOIMMED
DE4F BDE98A           (    forth6809.asm):03100                     JSR   LITERALW
DE52 CCF331           (    forth6809.asm):03101                     LDD   #STOREW
DE55 3606             (    forth6809.asm):03102                     PSHU  D
DE57 BDE97D           (    forth6809.asm):03103                     JSR   CCALL
DE5A 39               (    forth6809.asm):03104                     RTS
DE5B 3710             (    forth6809.asm):03105         TOIMMED:    PULU  X                 ; a-addr of the value cell
DE5D 3706             (    forth6809.asm):03106                     PULU  D                 ; x
DE5F ED84             (    forth6809.asm):03107                     STD   ,X
DE61 39               (    forth6809.asm):03108                     RTS
DE62 BDEA3E           (    forth6809.asm):03109         TOTWO:      JSR   TOBODYW           ; 2VALUE: store x1 x2 with 2!
DE65 DC00             (    forth6809.asm):03110                     LDD   STATE
DE67 270C             (    forth6809.asm):03111                     BEQ   TOTWOIMM
DE69 BDE98A           (    forth6809.asm):03112                     JSR   LITERALW
DE6C CCF35B           (    forth6809.asm):03113                     LDD   #TWOSTOREW
DE6F 3606             (    forth6809.asm):03114                     PSHU  D
DE71 BDE97D           (    forth6809.asm):03115                     JSR   CCALL
DE74 39               (    forth6809.asm):03116                     RTS
DE75 7EF35B           (    forth6809.asm):03117         TOTWOIMM:   JMP   TWOSTOREW
                      (    forth6809.asm):03118         
                      (    forth6809.asm):03119         ; ------------------------------------------------------------
                      (    forth6809.asm):03120         ; 2VARIABLE  ( "name" -- )
                      (    forth6809.asm):03121         ; Build a word that returns the address of a new two-cell variable in

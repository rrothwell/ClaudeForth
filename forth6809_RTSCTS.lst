E207 2306             (    forth6809.asm):03739                     BLS   GODONE
E209 EC83             (    forth6809.asm):03740                     LDD   ,--X
E20B 3606             (    forth6809.asm):03741                     PSHU  D
E20D 20F5             (    forth6809.asm):03742                     BRA   GOLOOP
E20F DC49             (    forth6809.asm):03743         GODONE:     LDD   ORDEND
E211 83004B           (    forth6809.asm):03744                     SUBD  #ORDER
E214 44               (    forth6809.asm):03745                     LSRA
E215 56               (    forth6809.asm):03746                     RORB
E216 3606             (    forth6809.asm):03747                     PSHU  D                 ; n
E218 39               (    forth6809.asm):03748                     RTS
                      (    forth6809.asm):03749         
                      (    forth6809.asm):03750         ; ------------------------------------------------------------
                      (    forth6809.asm):03751         ; SET-ORDER  ( widn ... wid1 n -- )
                      (    forth6809.asm):03752         ; Set the search order. n = -1 selects the minimum order (FORTH only).
                      (    forth6809.asm):03753         ; n = 0 empties it (ROOT can still be searched). Throws -49 when n is
                      (    forth6809.asm):03754         ; more than 8, -50 when n is less than -1 and -11 for an invalid wid.
                      (    forth6809.asm):03755         ; ------------------------------------------------------------
E219 3706             (    forth6809.asm):03756         SETORDERW:  PULU  D                 ; n
E21B 1083FFFF         (    forth6809.asm):03757                     CMPD  #-1
E21F 275D             (    forth6809.asm):03758                     BEQ   ONLYW             ; the minimum order
E221 4D               (    forth6809.asm):03759         SO1:        TSTA
E222 2B31             (    forth6809.asm):03760                     BMI   SOUNDER
E224 262A             (    forth6809.asm):03761                     BNE   SOOVER
E226 C108             (    forth6809.asm):03762                     CMPB  #WLMAX
E228 2226             (    forth6809.asm):03763                     BHI   SOOVER
E22A 3404             (    forth6809.asm):03764                     PSHS  B                 ; 1,S = n
E22C 3404             (    forth6809.asm):03765                     PSHS  B                 ; 0,S = count down
E22E 1F32             (    forth6809.asm):03766                     TFR   U,Y
E230 6DE4             (    forth6809.asm):03767         SOCHK:      TST   ,S
E232 2709             (    forth6809.asm):03768                     BEQ   SOCOPY
E234 AEA1             (    forth6809.asm):03769                     LDX   ,Y++

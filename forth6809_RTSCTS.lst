                      (    forth6809.asm):05619         ; ------------------------------------------------------------
DFC6 CC0010           (    forth6809.asm):05620         TOINW:      LDD   #TOIN
DFC9 3606             (    forth6809.asm):05621                     PSHU  D
DFCB 39               (    forth6809.asm):05622                     RTS
                      (    forth6809.asm):05623         
                      (    forth6809.asm):05624         ; ------------------------------------------------------------
                      (    forth6809.asm):05625         ; SPAN  ( -- a-addr )
                      (    forth6809.asm):05626         ; Push the address of the SPAN variable.
                      (    forth6809.asm):05627         ; ------------------------------------------------------------
DFCC CC003F           (    forth6809.asm):05628         SPANW:      LDD   #SPAN
DFCF 3606             (    forth6809.asm):05629                     PSHU  D
DFD1 39               (    forth6809.asm):05630                     RTS
                      (    forth6809.asm):05631         
                      (    forth6809.asm):05632         ; ------------------------------------------------------------
                      (    forth6809.asm):05633         ; TIB  ( -- c-addr )
                      (    forth6809.asm):05634         ; Push the address of the terminal input buffer.
                      (    forth6809.asm):05635         ; ------------------------------------------------------------
DFD2 CC0106           (    forth6809.asm):05636         TIBW:       LDD   #TIBBUF
DFD5 3606             (    forth6809.asm):05637                     PSHU  D
DFD7 39               (    forth6809.asm):05638                     RTS
                      (    forth6809.asm):05639         
                      (    forth6809.asm):05640         ; ------------------------------------------------------------
                      (    forth6809.asm):05641         ; #TIB  ( -- a-addr )

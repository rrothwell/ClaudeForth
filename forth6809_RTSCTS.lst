                      (    forth6809.asm):02526         ; ------------------------------------------------------------
                      (    forth6809.asm):02527         ; ABORT  ( i*x -- ) ( R: j*x -- )
                      (    forth6809.asm):02528         ; Throw -1. With no CATCH frame, THROW falls into the ABORT reset below.
                      (    forth6809.asm):02529         ; ------------------------------------------------------------
D07A CCFFFF           (    forth6809.asm):02530         ABORTW:     LDD   #-1
D07D 3606             (    forth6809.asm):02531                     PSHU  D                 ; throw code (-1)
D07F 7EDA80           (    forth6809.asm):02532                     JMP   THROWW
                      (    forth6809.asm):02533         
                      (    forth6809.asm):02534         ; ------------------------------------------------------------
                      (    forth6809.asm):02535         ; Reset the data stack to its base, then fall through into QUITW.
                      (    forth6809.asm):02536         ; ABORT
                      (    forth6809.asm):02537         ;    Inputs:
                      (    forth6809.asm):02538         ;        none
                      (    forth6809.asm):02539         ;    Outputs:
                      (    forth6809.asm):02540         ;        none (does not return)

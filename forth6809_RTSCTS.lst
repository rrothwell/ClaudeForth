                      (    forth6809.asm):05419         ; ------------------------------------------------------------
EB21 ECC4             (    forth6809.asm):05420         TUCKW:      LDD   ,U                ; x2
EB23 AE42             (    forth6809.asm):05421                     LDX   2,U               ; x1
EB25 3606             (    forth6809.asm):05422                     PSHU  D
EB27 AF42             (    forth6809.asm):05423                     STX   2,U
EB29 ED44             (    forth6809.asm):05424                     STD   4,U
EB2B 39               (    forth6809.asm):05425                     RTS
                      (    forth6809.asm):05426         
                      (    forth6809.asm):05427         ; ------------------------------------------------------------
                      (    forth6809.asm):05428         ; PICK  ( xu ... x0 u -- xu ... x0 xu )
                      (    forth6809.asm):05429         ; Copy the cell u deep (0 PICK is DUP) to the top.
                      (    forth6809.asm):05430         ; ------------------------------------------------------------
EB2C 3706             (    forth6809.asm):05431         PICKW:      PULU  D                 ; u
EB2E 58               (    forth6809.asm):05432                     LSLB
EB2F 49               (    forth6809.asm):05433                     ROLA
EB30 ECCB             (    forth6809.asm):05434                     LDD   D,U
EB32 3606             (    forth6809.asm):05435                     PSHU  D
EB34 39               (    forth6809.asm):05436                     RTS
                      (    forth6809.asm):05437         
                      (    forth6809.asm):05438         ; ------------------------------------------------------------
                      (    forth6809.asm):05439         ; ROLL  ( xu xu-1 ... x0 u -- xu-1 ... x0 xu )
                      (    forth6809.asm):05440         ; Move the cell u deep (0 ROLL does nothing) to the top, shifting the
                      (    forth6809.asm):05441         ; cells above it down one place. RDST holds the byte offset and RVAL
                      (    forth6809.asm):05442         ; the cell being moved.
                      (    forth6809.asm):05443         ; ------------------------------------------------------------
EB35 ECC1             (    forth6809.asm):05444         ROLLW:      LDD   ,U++              ; u (LDD sets CC; PULU would not). See
EB37 2718             (    forth6809.asm):05445                     BEQ   ROLLDONE          ; bugfix: ROLLW.1
EB39 1F02             (    forth6809.asm):05446                     TFR   D,Y               ; Y = cells to shift
EB3B 58               (    forth6809.asm):05447                     LSLB
EB3C 49               (    forth6809.asm):05448                     ROLA
EB3D 30CB             (    forth6809.asm):05449                     LEAX  D,U               ; X = xu
EB3F EC84             (    forth6809.asm):05450                     LDD   ,X
EB41 3406             (    forth6809.asm):05451                     PSHS  D                 ; xu waits on the return stack
EB43 EC1E             (    forth6809.asm):05452         RLOOP:      LDD   -2,X
EB45 ED84             (    forth6809.asm):05453                     STD   ,X
EB47 301E             (    forth6809.asm):05454                     LEAX  -2,X

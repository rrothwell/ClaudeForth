                      (    forth6809.asm):08876         
                      (    forth6809.asm):08877         ; ------------------------------------------------------------
                      (    forth6809.asm):08878         ; RESTORE-INPUT  ( x1 x2 x3 3 -- flag )
                      (    forth6809.asm):08879         ; Restore >IN if the input source is the same one that was saved.
                      (    forth6809.asm):08880         ; Return false on success, true if the saved state is unusable (wrong
                      (    forth6809.asm):08881         ; cell count, or a different source address or length).
                      (    forth6809.asm):08882         ; ------------------------------------------------------------
F100                  (    forth6809.asm):08883         RESTOREINPUTW:
F100 3706             (    forth6809.asm):08884                     PULU  D                 ; n
F102 10830003         (    forth6809.asm):08885                     CMPD  #3
F106 2618             (    forth6809.asm):08886                     BNE   RIBAD
F108 3720             (    forth6809.asm):08887                     PULU  Y                 ; saved >IN
F10A 3706             (    forth6809.asm):08888                     PULU  D                 ; saved source length
F10C 3710             (    forth6809.asm):08889                     PULU  X                 ; saved source address
F10E 10933B           (    forth6809.asm):08890                     CMPD  SRCLEN
F111 2611             (    forth6809.asm):08891                     BNE   RIFAIL
F113 9C39             (    forth6809.asm):08892                     CMPX  SRCADDR
F115 260D             (    forth6809.asm):08893                     BNE   RIFAIL
F117 109F10           (    forth6809.asm):08894                     STY   TOIN
F11A CC0000           (    forth6809.asm):08895                     LDD   #FALSEV
F11D 3606             (    forth6809.asm):08896                     PSHU  D
F11F 39               (    forth6809.asm):08897                     RTS
F120 58               (    forth6809.asm):08898         RIBAD:      ASLB                    ; drop n cells
F121 49               (    forth6809.asm):08899                     ROLA
F122 33CB             (    forth6809.asm):08900                     LEAU  D,U
F124 CCFFFF           (    forth6809.asm):08901         RIFAIL:     LDD   #TRUEV
F127 3606             (    forth6809.asm):08902                     PSHU  D
F129 39               (    forth6809.asm):08903                     RTS
                      (    forth6809.asm):08904         
                      (    forth6809.asm):08905         ; ------------------------------------------------------------
                      (    forth6809.asm):08906         ; REFILL  ( -- flag )
                      (    forth6809.asm):08907         ; From the terminal, read a new line with QUERY and return true. From
                      (    forth6809.asm):08908         ; an EVALUATEd string, return false.
                      (    forth6809.asm):08909         ; ------------------------------------------------------------
F12A DC3D             (    forth6809.asm):08910         REFILLW:    LDD   SRCID
F12C 2706             (    forth6809.asm):08911                     BEQ   RFTERM
F12E CC0000           (    forth6809.asm):08912                     LDD   #FALSEV
F131 3606             (    forth6809.asm):08913                     PSHU  D

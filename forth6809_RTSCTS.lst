                      (    forth6809.asm):10359         ; DECOMP: SEE ( "name" -- )  Show a definition as Forth source.
                      (    forth6809.asm):10360         ;
                      (    forth6809.asm):10361         ; Every word in a colon definition is compiled as JSR xt. A few
                      (    forth6809.asm):10362         ; run-time words are followed by an inline cell (LIT, BRANCH, ZBRANCH,
                      (    forth6809.asm):10363         ; DOTEST, DOPLUSTEST, QDOSETUP, EXITUNLOOP) or counted string (DOSTR,
                      (    forth6809.asm):10364         ; DOTSTR, DOCSTR, DOABORTQUOTE); DKT lists them. IF ELSE THEN BEGIN
                      (    forth6809.asm):10365         ; UNTIL AGAIN WHILE REPEAT are rebuilt from branch targets by scanning
                      (    forth6809.asm):10366         ; the definition (DQ), so the shape is right but ENDOF and ENDCASE
                      (    forth6809.asm):10367         ; show as ELSE and THEN. A word whose first byte is neither JSR nor RTS
                      (    forth6809.asm):10368         ; is machine code: SEE lists it with DASM, up to its first RTS.
                      (    forth6809.asm):10369         ; ------------------------------------------------------------

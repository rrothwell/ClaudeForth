D4B6 DC08             (    forth6809.asm):03454                     LDD   CODEHERE
D4B8 3406             (    forth6809.asm):03455                     PSHS  D                 ; 4,S
D4BA DC0A             (    forth6809.asm):03456                     LDD   VARHERE
D4BC 3406             (    forth6809.asm):03457                     PSHS  D                 ; 2,S
D4BE DC04             (    forth6809.asm):03458                     LDD   LATEST
D4C0 3406             (    forth6809.asm):03459                     PSHS  D                 ; 0,S
D4C2 CCD188           (    forth6809.asm):03460                     LDD   #DOMARKER

DEDB 3706             (    forth6809.asm):05567                     PULU  D
DEDD 10830000         (    forth6809.asm):05568                     CMPD  #0
DEE1 260A             (    forth6809.asm):05569                     BNE   BTOK
DEE3 3706             (    forth6809.asm):05570                     PULU  D
DEE5 CCFFF3           (    forth6809.asm):05571                     LDD   #-13              ; -13
DEE8 3606             (    forth6809.asm):05572                     PSHU  D
DEEA BDDA61           (    forth6809.asm):05573                     JSR   THROWW
DEED BDDEA9           (    forth6809.asm):05574         BTOK:       JSR   LITERALW
DEF0 39               (    forth6809.asm):05575                     RTS
                      (    forth6809.asm):05576         
                      (    forth6809.asm):05577         ; ------------------------------------------------------------
                      (    forth6809.asm):05578         ; POSTPONE  ( "name" -- )
                      (    forth6809.asm):05579         ; If the name is immediate, compile a call to it now. Otherwise
                      (    forth6809.asm):05580         ; compile its xt as a literal followed by a call to COMPILE, so that
                      (    forth6809.asm):05581         ; it is compiled when the enclosing definition runs. THROW -14 if not
                      (    forth6809.asm):05582         ; compiling, -13 if the name is not found.
                      (    forth6809.asm):05583         ; ------------------------------------------------------------
DEF1 DC00             (    forth6809.asm):05584         POSTPONEW:  LDD   STATE
DEF3 2608             (    forth6809.asm):05585                     BNE   PPSTOK
DEF5 CCFFF2           (    forth6809.asm):05586                     LDD   #-14              ; -14
DEF8 3606             (    forth6809.asm):05587                     PSHU  D
DEFA BDDA61           (    forth6809.asm):05588                     JSR   THROWW
DEFD CC0020           (    forth6809.asm):05589         PPSTOK:     LDD   #32

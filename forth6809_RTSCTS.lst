DF26 CCF331           (    forth6809.asm):03061                     LDD   #STOREW
DF29 3606             (    forth6809.asm):03062                     PSHU  D
DF2B BDE97D           (    forth6809.asm):03063                     JSR   CCALL
DF2E 39               (    forth6809.asm):03064                     RTS
DF2F 3710             (    forth6809.asm):03065         TOIMMED:    PULU  X                 ; a-addr of the value cell
DF31 3706             (    forth6809.asm):03066                     PULU  D                 ; x
DF33 ED84             (    forth6809.asm):03067                     STD   ,X
DF35 39               (    forth6809.asm):03068                     RTS
DF36 BDEA3E           (    forth6809.asm):03069         TOTWO:      JSR   TOBODYW           ; 2VALUE: store x1 x2 with 2!
DF39 DC00             (    forth6809.asm):03070                     LDD   STATE
DF3B 270C             (    forth6809.asm):03071                     BEQ   TOTWOIMM
DF3D BDE98A           (    forth6809.asm):03072                     JSR   LITERALW
DF40 CCF35B           (    forth6809.asm):03073                     LDD   #TWOSTOREW
DF43 3606             (    forth6809.asm):03074                     PSHU  D
DF45 BDE97D           (    forth6809.asm):03075                     JSR   CCALL
DF48 39               (    forth6809.asm):03076                     RTS
DF49 7EF35B           (    forth6809.asm):03077         TOTWOIMM:   JMP   TWOSTOREW
                      (    forth6809.asm):03078         
                      (    forth6809.asm):03079         ; ------------------------------------------------------------
                      (    forth6809.asm):03080         ; 2VARIABLE  ( "name" -- )
                      (    forth6809.asm):03081         ; Build a word that returns the address of a new two-cell variable in
                      (    forth6809.asm):03082         ; the variable area, initialised to zero.
                      (    forth6809.asm):03083         ; ------------------------------------------------------------
DF4C                  (    forth6809.asm):03084         TWOVARIABLEW:
DF4C CC0000           (    forth6809.asm):03085                     LDD   #0

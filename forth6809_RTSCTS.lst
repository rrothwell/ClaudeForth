                      (    forth6809.asm):02065         ; Send at most one character from the output ring to the ACIA
                      (    forth6809.asm):02066         ; by polling, then return. Nothing is sent if the ring is empty,
                      (    forth6809.asm):02067         ; the remote receiver is blocking (CTS) or the transmitter is not
                      (    forth6809.asm):02068         ; ready; the caller simply tries again on its next call.
                      (    forth6809.asm):02069         ; FLUSHOUTBUFFER
                      (    forth6809.asm):02070         ;    Inputs:
                      (    forth6809.asm):02071         ;        none
                      (    forth6809.asm):02072         ;    Outputs:
                      (    forth6809.asm):02073         ;        one character sent and OUTTAIL advanced, or no change
                      (    forth6809.asm):02074         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):02075         ; See bugfix: FLUSHOUTBUFFER.1.
                      (    forth6809.asm):02076         ; ------------------------------------------------------------

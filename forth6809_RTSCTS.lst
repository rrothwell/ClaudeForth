                      (    forth6809.asm):04891         ; Run-time part of EXIT: drop the address of the inline count, then
                      (    forth6809.asm):04892         ; return from the definition. Loop frames are not discarded.
                      (    forth6809.asm):04893         ; EXITUNLOOP
                      (    forth6809.asm):04894         ;    Inputs:
                      (    forth6809.asm):04895         ;        S holds the address of the inline count, then the return
                      (    forth6809.asm):04896         ;        address
                      (    forth6809.asm):04897         ;    Outputs:
                      (    forth6809.asm):04898         ;        returns to the caller of the definition
                      (    forth6809.asm):04899         ;    Registers: RegX and RegY changed.
                      (    forth6809.asm):04900         ; ------------------------------------------------------------

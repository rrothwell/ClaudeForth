                      (    forth6809.asm):04037         ; >NUMBER  ( ud1 c-addr1 u1 -- ud2 c-addr2 u2 )
                      (    forth6809.asm):04038         ; Convert the string into ud1, in BASE, stopping at the first
                      (    forth6809.asm):04039         ; unconvertible character. Returns the accumulated ud2 and the
                      (    forth6809.asm):04040         ; remaining string. The conversion works in place on the three
                      (    forth6809.asm):04041         ; parameters (NUMLOOP), which are also the frame NUMBERQ builds.
                      (    forth6809.asm):04042         ; NUMLOOP
                      (    forth6809.asm):04043         ;    Inputs:
                      (    forth6809.asm):04044         ;        ( ud c-addr u ) on the data stack
                      (    forth6809.asm):04045         ;    Outputs:
                      (    forth6809.asm):04046         ;        ud accumulated; c-addr u = first unconverted character and
                      (    forth6809.asm):04047         ;        the count remaining
                      (    forth6809.asm):04048         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):04049         ; ------------------------------------------------------------

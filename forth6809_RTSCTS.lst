                      (    forth6809.asm):02204         ; ------------------------------------------------------------
                      (    forth6809.asm):02205         ; ACIA (6850) interrupt handler (SERIALPOLL=0). Services received
                      (    forth6809.asm):02206         ; characters (into the input ring, counting framing, overrun and
                      (    forth6809.asm):02207         ; parity errors) and transmit-ready (from the output ring), with a
                      (    forth6809.asm):02208         ; single exit point. IRQ is hardware-masked while it runs.
                      (    forth6809.asm):02209         ; IRQH
                      (    forth6809.asm):02210         ;    Inputs:
                      (    forth6809.asm):02211         ;        none (hardware interrupt entry)
                      (    forth6809.asm):02212         ;    Outputs:
                      (    forth6809.asm):02213         ;        none (returns with RTI)
                      (    forth6809.asm):02214         ;    Registers: all registers are saved and restored by the interrupt.
                      (    forth6809.asm):02215         ; Original comment: shadow IRQH.0.
                      (    forth6809.asm):02216         ; ------------------------------------------------------------
DB7B B6C008           (    forth6809.asm):02217         IRQH:       LDA   ACIASR            ; Get the status.
                      (    forth6809.asm):02218         
DB7E 8580             (    forth6809.asm):02219                     BITA  #SR_IRQ           ; Is the ACIA the interrupt source?
DB80 2708             (    forth6809.asm):02220                     BEQ   IRQDONE0          ; No! Just exit.
DB82 8501             (    forth6809.asm):02221                     BITA  #SR_RDRF          ; Is an incoming character available?
DB84 2605             (    forth6809.asm):02222                     BNE   INCHAR
DB86 8502             (    forth6809.asm):02223                     BITA  #SR_TDRE          ; Is the slot for an outgoing character available?
DB88 263C             (    forth6809.asm):02224                     BNE   OUTCHAR
                      (    forth6809.asm):02225                                             ; Ignore all other interrupts such as DCD change.
DB8A 3B               (    forth6809.asm):02226         IRQDONE0:   RTI                     ; Single point of exit - re-enables interrupts
                      (    forth6809.asm):02227                                             ; & restores state.
                      (    forth6809.asm):02228         
DB8B                  (    forth6809.asm):02229         INCHAR:
DB8B F6C009           (    forth6809.asm):02230                     LDB   ACIADR            ; Get the char & clear RDRF & error flags.
DB8E 8570             (    forth6809.asm):02231                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):02232                                             ; Any receiver error flagged?
DB90 2716             (    forth6809.asm):02233                     BEQ   INOK              ; No! - character is good, keep it.
                      (    forth6809.asm):02234         
DB92 8510             (    forth6809.asm):02235                     BITA  #SR_FE            ; Yes! char is corrupted, discard it.
DB94 2703             (    forth6809.asm):02236                     BEQ   INXFE             ; Tally each flagged error independently -
DB96 7C017C           (    forth6809.asm):02237                     INC   FECOUNT           ; more than one bit can be set at once.
DB99 8520             (    forth6809.asm):02238         INXFE:      BITA  #SR_OVRN
DB9B 2703             (    forth6809.asm):02239                     BEQ   INXOVRN
DB9D 7C017D           (    forth6809.asm):02240                     INC   OVRNCOUNT
DBA0 8540             (    forth6809.asm):02241         INXOVRN:    BITA  #SR_PE
DBA2 2703             (    forth6809.asm):02242                     BEQ   INXPE
DBA4 7C017E           (    forth6809.asm):02243                     INC   PECOUNT
DBA7 3B               (    forth6809.asm):02244         INXPE:      RTI
                      (    forth6809.asm):02245         
DBA8 1F98             (    forth6809.asm):02246         INOK:       TFR   B,A               ; Transfer good character from the receiver.
DBAA 8E0180           (    forth6809.asm):02247                     LDX   #INBUF            ; Store it in the empty in buffer slot.
DBAD F60176           (    forth6809.asm):02248                     LDB   INHEAD
DBB0 A785             (    forth6809.asm):02249                     STA   B,X
DBB2 5C               (    forth6809.asm):02250                     INCB                    ; Figure out the new head,
DBB3 C43F             (    forth6809.asm):02251                     ANDB  #INBUFSZ-1        ; pointing to the next the empty in buffer slot.
DBB5 F10177           (    forth6809.asm):02252                     CMPB  INTAIL            ; Would the new head slot meet the tail?
DBB8 270B             (    forth6809.asm):02253                     BEQ   IRQDONE1          ; Don't allow it - buffer full, drop the character.
DBBA F70176           (    forth6809.asm):02254                     STB   INHEAD            ; New head pointer is OK so store it.
                      (    forth6809.asm):02255                     ; Commented-out code moved to shadow: INCHAR.2
                      (    forth6809.asm):02256                     ; Reuse RegB (the new head) for the fill level.
                      (    forth6809.asm):02257                     ; See shadow: INCHAR.1
DBBD F00177           (    forth6809.asm):02258                     SUBB  INTAIL            ; RegB: new head - tail = current fill level.
DBC0 C43F             (    forth6809.asm):02259                     ANDB  #INBUFSZ-1
DBC2 BDDA9A           (    forth6809.asm):02260                     JSR   CHKHI             ; Protect the in buffer from overflow.
DBC5 3B               (    forth6809.asm):02261         IRQDONE1:   RTI
                      (    forth6809.asm):02262         
                      (    forth6809.asm):02263                     ; Commented-out code moved to shadow: OUTCHAR.1
                      (    forth6809.asm):02264         
DBC6 F6017A           (    forth6809.asm):02265         OUTCHAR:    LDB   OUTTAIL           ; Is the out buffer empty?
DBC9 F10179           (    forth6809.asm):02266                     CMPB  OUTHEAD
DBCC 270F             (    forth6809.asm):02267                     BEQ   TXOFF             ; Yes! Stop transmitting.
                      (    forth6809.asm):02268         
DBCE 8E01C0           (    forth6809.asm):02269                     LDX   #OUTBUF           ; No! The out buffer is occupied.
DBD1 A685             (    forth6809.asm):02270                     LDA   B,X               ; Get the character from the out buffer.
DBD3 B7C009           (    forth6809.asm):02271                     STA   ACIADR            ; Transmit the char.
                      (    forth6809.asm):02272         
DBD6 5C               (    forth6809.asm):02273                     INCB                    ; Update the tail pointer pointing to the next char.
DBD7 C43F             (    forth6809.asm):02274                     ANDB  #OUTBUFSZ-1
DBD9 F7017A           (    forth6809.asm):02275                     STB   OUTTAIL
DBDC 3B               (    forth6809.asm):02276         IRQDONE2    RTI
                      (    forth6809.asm):02277         
DBDD                  (    forth6809.asm):02278         TXOFF:                              ; The output ring is empty.
                      (    forth6809.asm):02279                     ; Commented-out code moved to shadow: TXOFF.1
DBDD 7F017B           (    forth6809.asm):02280                     CLR   OUTACTIVITY
DBE0 BDDA7F           (    forth6809.asm):02281                     JSR   UPDATE_RTS
DBE3 3B               (    forth6809.asm):02282         IRQDONE3    RTI
                      (    forth6809.asm):02283         
                      (    forth6809.asm):02284                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):02285         
DBE4                  (    forth6809.asm):02286         IRQH:       RTI                     ; polling mode (SERIALPOLL=1) - ACIA
                      (    forth6809.asm):02287                                             ; interrupts are never enabled (see
                      (    forth6809.asm):02288                                             ; COLDSTRT's CR_POLL init), so this should
                      (    forth6809.asm):02289                                             ; never fire; kept as a safe stub matching
                      (    forth6809.asm):02290                                             ; the other unused vectors below
                      (    forth6809.asm):02291                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):02292         
                      (    forth6809.asm):02293         ; ------------------------------------------------------------
                      (    forth6809.asm):02294         ; Unused interrupt handlers: return immediately. SWIH instead
                      (    forth6809.asm):02295         ; pushes the throw code -99 and jumps to THROW.
                      (    forth6809.asm):02296         ; ------------------------------------------------------------
DBE4 3B               (    forth6809.asm):02297         SWI3H:      RTI
DBE5 3B               (    forth6809.asm):02298         SWI2H:      RTI
DBE6 3B               (    forth6809.asm):02299         FIRQH:      RTI
DBE7 3B               (    forth6809.asm):02300         NMIH:       RTI                     ; unused now that NMI -> WARM
DBE8 CCFF9D           (    forth6809.asm):02301         SWIH:       LDD   #-99              ; placeholder hardware-trap code; push and
DBEB 3606             (    forth6809.asm):02302                     PSHU  D                 ; JMP THROW, per the CATCH/THROW turn
DBED 7EE542           (    forth6809.asm):02303                     JMP   THROWW
                      (    forth6809.asm):02304         
                      (    forth6809.asm):02305         ; ============================================================
                      (    forth6809.asm):02306         ; SECTION 4: COLD / ABORT / QUIT  (with CATCH-wrapped INTERPRET)
                      (    forth6809.asm):02307         ; ============================================================
                      (    forth6809.asm):02308         ; ------------------------------------------------------------
                      (    forth6809.asm):02309         ; Cold start: set the dictionary, code and variable pointers to
                      (    forth6809.asm):02310         ; their application areas, BASE to 10 and the input source to the
                      (    forth6809.asm):02311         ; terminal buffer, print the sign-on banner, then enter ABORT.
                      (    forth6809.asm):02312         ; COLD
                      (    forth6809.asm):02313         ;    Inputs:
                      (    forth6809.asm):02314         ;        none (entered at reset)
                      (    forth6809.asm):02315         ;    Outputs:
                      (    forth6809.asm):02316         ;        none (does not return)
                      (    forth6809.asm):02317         ;    Registers: all changed.
                      (    forth6809.asm):02318         ; ------------------------------------------------------------
DBF0 CC0240           (    forth6809.asm):02319         COLD:       LDD   #APPVARS
DBF3 DD0A             (    forth6809.asm):02320                     STD   VARHERE
DBF5 CC7000           (    forth6809.asm):02321                     LDD   #APPCODE
DBF8 DD08             (    forth6809.asm):02322                     STD   CODEHERE
DBFA CC2000           (    forth6809.asm):02323                     LDD   #APPDICT
DBFD DD06             (    forth6809.asm):02324                     STD   DPHERE
DBFF CCDA2A           (    forth6809.asm):02325                     LDD   #BASELATEST
DC02 DD04             (    forth6809.asm):02326                     STD   LATEST
DC04 BDE265           (    forth6809.asm):02327                     JSR   WLINIT            ; FORTH wordlist, search order and CURRENT
                      (    forth6809.asm):02328         
DC07 CC000A           (    forth6809.asm):02329                     LDD   #10
DC0A DD02             (    forth6809.asm):02330                     STD   BASE
                      (    forth6809.asm):02331         
DC0C CC0106           (    forth6809.asm):02332                     LDD   #TIBBUF
DC0F DD39             (    forth6809.asm):02333                     STD   SRCADDR
DC11 CC0000           (    forth6809.asm):02334                     LDD   #0
DC14 DD3B             (    forth6809.asm):02335                     STD   SRCLEN
DC16 DD3D             (    forth6809.asm):02336                     STD   SRCID
                      (    forth6809.asm):02337         
DC18 8EDCBE           (    forth6809.asm):02338                     LDX   #SIGNON
DC1B 3610             (    forth6809.asm):02339                     PSHU  X                 ; c-addr
DC1D CC000F           (    forth6809.asm):02340                     LDD   #SIGNONL
DC20 3606             (    forth6809.asm):02341                     PSHU  D                 ; u
DC22 BDF551           (    forth6809.asm):02342                     JSR   TYPEW
DC25 BDFB60           (    forth6809.asm):02343                     JSR   CRW
DC28 2008             (    forth6809.asm):02344                     BRA   ABORT             ; Go to ABORT, skipping the ABORTW word.
                      (    forth6809.asm):02345         
                      (    forth6809.asm):02346         ; ------------------------------------------------------------
                      (    forth6809.asm):02347         ; ABORT  ( i*x -- ) ( R: j*x -- )
                      (    forth6809.asm):02348         ; Throw -1. With no CATCH frame, THROW falls into the ABORT reset below.
                      (    forth6809.asm):02349         ; ------------------------------------------------------------
DC2A CCFFFF           (    forth6809.asm):02350         ABORTW:     LDD   #-1
DC2D 3606             (    forth6809.asm):02351                     PSHU  D                 ; throw code (-1)
DC2F 7EE542           (    forth6809.asm):02352                     JMP   THROWW
                      (    forth6809.asm):02353         
                      (    forth6809.asm):02354         ; ------------------------------------------------------------
                      (    forth6809.asm):02355         ; Reset the data stack to its base, then fall through into QUITW.
                      (    forth6809.asm):02356         ; ABORT
                      (    forth6809.asm):02357         ;    Inputs:
                      (    forth6809.asm):02358         ;        none
                      (    forth6809.asm):02359         ;    Outputs:
                      (    forth6809.asm):02360         ;        none (does not return)
                      (    forth6809.asm):02361         ;    Registers: RegU changed.
                      (    forth6809.asm):02362         ; ------------------------------------------------------------
DC32 CEBD00           (    forth6809.asm):02363         ABORT:      LDU   #SP0
                      (    forth6809.asm):02364                     ; falls through into QUIT
                      (    forth6809.asm):02365         
                      (    forth6809.asm):02366         ; ------------------------------------------------------------
                      (    forth6809.asm):02367         ; QUIT  ( -- ) ( R: i*x -- )
                      (    forth6809.asm):02368         ; Empty the return stack, set interpretation state, then loop reading
                      (    forth6809.asm):02369         ; a line and interpreting it under CATCH. Errors are reported as
                      (    forth6809.asm):02370         ; "ERROR n"; -1 (ABORT) is silent. Never returns.
                      (    forth6809.asm):02371         ; ------------------------------------------------------------
DC35 10CEC000         (    forth6809.asm):02372         QUITW:      LDS   #RP0
DC39 CC0000           (    forth6809.asm):02373                     LDD   #0
DC3C DD00             (    forth6809.asm):02374                     STD   STATE             ; See bugfix: QUITW.1
                      (    forth6809.asm):02375         
DC3E BDE4ED           (    forth6809.asm):02376         QLOOP:      JSR   QUERYW
                      (    forth6809.asm):02377         
DC41 DC06             (    forth6809.asm):02378                     LDD   DPHERE            ; Checkpoint on the return stack. CATCH
DC43 3406             (    forth6809.asm):02379                     PSHS  D                 ; and THROW restore S, so the frame is
DC45 DC08             (    forth6809.asm):02380                     LDD   CODEHERE          ; intact whichever way INTERPRET ends.
DC47 3406             (    forth6809.asm):02381                     PSHS  D                 ; See shadow QLOOP.2
DC49 DC0A             (    forth6809.asm):02382                     LDD   VARHERE
DC4B 3406             (    forth6809.asm):02383                     PSHS  D
DC4D DC04             (    forth6809.asm):02384                     LDD   LATEST
DC4F 3406             (    forth6809.asm):02385                     PSHS  D
                      (    forth6809.asm):02386         
DC51 CCE08E           (    forth6809.asm):02387                     LDD   #INTERPRET
DC54 3606             (    forth6809.asm):02388                     PSHU  D                 ; xt
DC56 BDE516           (    forth6809.asm):02389                     JSR   CATCHW
DC59 3706             (    forth6809.asm):02390                     PULU  D                 ; throw code (0 = no error)
DC5B 3406             (    forth6809.asm):02391                     PSHS  D                 ; frame: 0,S code  2,S LATEST  4,S VARHERE
DC5D 10830000         (    forth6809.asm):02392                     CMPD  #0                ;        6,S CODEHERE  8,S DPHERE
DC61 2743             (    forth6809.asm):02393                     BEQ   QOK
                      (    forth6809.asm):02394         
DC63 EC68             (    forth6809.asm):02395                     LDD   8,S
DC65 DD06             (    forth6809.asm):02396                     STD   DPHERE
DC67 BDE27C           (    forth6809.asm):02397                     JSR   PRUNE             ; unlink headers newer than DPHERE
DC6A EC66             (    forth6809.asm):02398                     LDD   6,S
DC6C DD08             (    forth6809.asm):02399                     STD   CODEHERE
DC6E EC64             (    forth6809.asm):02400                     LDD   4,S
DC70 DD0A             (    forth6809.asm):02401                     STD   VARHERE
DC72 EC62             (    forth6809.asm):02402                     LDD   2,S
DC74 DD04             (    forth6809.asm):02403                     STD   LATEST
DC76 CEBD00           (    forth6809.asm):02404                     LDU   #SP0
                      (    forth6809.asm):02405         
                      (    forth6809.asm):02406                     ; Return to interpretation state after a caught error.
                      (    forth6809.asm):02407                     ; See bugfix: QLOOP.1
DC79 CC0000           (    forth6809.asm):02408                     LDD   #0
DC7C DD00             (    forth6809.asm):02409                     STD   STATE
                      (    forth6809.asm):02410         
DC7E ECE4             (    forth6809.asm):02411                     LDD   ,S                ; -1 is ABORT: reset silently, no "ERROR -1"
DC80 1083FFFF         (    forth6809.asm):02412                     CMPD  #-1
DC84 2605             (    forth6809.asm):02413                     BNE   QSHOWERR
DC86 326A             (    forth6809.asm):02414                     LEAS  10,S              ; drop the frame
DC88 16FFB3           (    forth6809.asm):02415                     LBRA  QLOOP
                      (    forth6809.asm):02416         
DC8B BDFB60           (    forth6809.asm):02417         QSHOWERR:   JSR   CRW
DC8E 8EDCD1           (    forth6809.asm):02418                     LDX   #ERRMSG
DC91 3610             (    forth6809.asm):02419                     PSHU  X                 ; c-addr
DC93 CC0008           (    forth6809.asm):02420                     LDD   #ERRMSGL
DC96 3606             (    forth6809.asm):02421                     PSHU  D                 ; u
DC98 BDF551           (    forth6809.asm):02422                     JSR   TYPEW
DC9B ECE4             (    forth6809.asm):02423                     LDD   ,S
DC9D 3606             (    forth6809.asm):02424                     PSHU  D                 ; n
DC9F BDFA2F           (    forth6809.asm):02425                     JSR   DOTW
DCA2 326A             (    forth6809.asm):02426                     LEAS  10,S              ; drop the frame
DCA4 2098             (    forth6809.asm):02427                     BRA   QLOOP
                      (    forth6809.asm):02428         
DCA6 326A             (    forth6809.asm):02429         QOK:        LEAS  10,S              ; drop the frame
DCA8 BDFB60           (    forth6809.asm):02430                     JSR   CRW               ; See bugfix: QOK.1
DCAB DC00             (    forth6809.asm):02431                     LDD   STATE
DCAD 268F             (    forth6809.asm):02432                     BNE   QLOOP
DCAF 8EDCCD           (    forth6809.asm):02433                     LDX   #OKMSG
DCB2 3610             (    forth6809.asm):02434                     PSHU  X                 ; c-addr
DCB4 CC0004           (    forth6809.asm):02435                     LDD   #OKMSGL
DCB7 3606             (    forth6809.asm):02436                     PSHU  D                 ; u
DCB9 BDF551           (    forth6809.asm):02437                     JSR   TYPEW
DCBC 2080             (    forth6809.asm):02438                     BRA   QLOOP
                      (    forth6809.asm):02439         
DCBE 3638303920464F52 (    forth6809.asm):02440         SIGNON:     FCC   "6809 FORTH v1.0"
     54482076312E30
     000F             (    forth6809.asm):02441         SIGNONL     EQU   *-SIGNON
DCCD 20206F6B         (    forth6809.asm):02442         OKMSG:      FCC   "  ok"
     0004             (    forth6809.asm):02443         OKMSGL      EQU   *-OKMSG
DCD1 20204552524F5220 (    forth6809.asm):02444         ERRMSG:     FCC   "  ERROR "
     0008             (    forth6809.asm):02445         ERRMSGL     EQU   *-ERRMSG
                      (    forth6809.asm):02446         
                      (    forth6809.asm):02447         ; ============================================================
                      (    forth6809.asm):02448         ; SECTION 5: INNER-INTERPRETER SUPPORT (LIT, ZBRANCH, BRANCH,
                      (    forth6809.asm):02449         ; DODOES, DODEFER, EXECUTE)
                      (    forth6809.asm):02450         ; ============================================================
                      (    forth6809.asm):02451         ; ------------------------------------------------------------
                      (    forth6809.asm):02452         ; Run-time for a literal: fetch the inline cell that follows the
                      (    forth6809.asm):02453         ; calling JSR, push it, and advance the return address past it.
                      (    forth6809.asm):02454         ; LIT   ( -- x )
                      (    forth6809.asm):02455         ;    Inputs:
                      (    forth6809.asm):02456         ;        return stack top = address of the inline 16-bit literal
                      (    forth6809.asm):02457         ;    Outputs:
                      (    forth6809.asm):02458         ;        x pushed on the data stack; return address advanced by 2
                      (    forth6809.asm):02459         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02460         ; ------------------------------------------------------------
DCD9 3510             (    forth6809.asm):02461         LIT:        PULS  X
DCDB EC81             (    forth6809.asm):02462                     LDD   ,X++
DCDD 3606             (    forth6809.asm):02463                     PSHU  D                 ; x
DCDF 3410             (    forth6809.asm):02464                     PSHS  X
DCE1 39               (    forth6809.asm):02465                     RTS
                      (    forth6809.asm):02466         
                      (    forth6809.asm):02467         ; ------------------------------------------------------------
                      (    forth6809.asm):02468         ; Run-time for a conditional branch: take the inline offset if the
                      (    forth6809.asm):02469         ; flag is false, otherwise skip it. The offset is relative to its own
                      (    forth6809.asm):02470         ; address.
                      (    forth6809.asm):02471         ; ZBRANCH   ( flag -- )
                      (    forth6809.asm):02472         ;    Inputs:
                      (    forth6809.asm):02473         ;        flag on the data stack
                      (    forth6809.asm):02474         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02475         ;    Outputs:
                      (    forth6809.asm):02476         ;        flag removed; return address set to the branch target or past
                      (    forth6809.asm):02477         ;        the offset
                      (    forth6809.asm):02478         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02479         ; ------------------------------------------------------------
DCE2 3706             (    forth6809.asm):02480         ZBRANCH:    PULU  D                 ; flag
DCE4 3510             (    forth6809.asm):02481                     PULS  X
DCE6 10830000         (    forth6809.asm):02482                     CMPD  #0
DCEA 2607             (    forth6809.asm):02483                     BNE   ZSKIP
DCEC EC84             (    forth6809.asm):02484                     LDD   ,X
DCEE 308B             (    forth6809.asm):02485                     LEAX  D,X
DCF0 3410             (    forth6809.asm):02486                     PSHS  X
DCF2 39               (    forth6809.asm):02487                     RTS
DCF3 3002             (    forth6809.asm):02488         ZSKIP:      LEAX  2,X
DCF5 3410             (    forth6809.asm):02489                     PSHS  X
DCF7 39               (    forth6809.asm):02490                     RTS
                      (    forth6809.asm):02491         
                      (    forth6809.asm):02492         ; ------------------------------------------------------------
                      (    forth6809.asm):02493         ; Run-time for an unconditional branch: add the inline offset
                      (    forth6809.asm):02494         ; (relative to its own address) to the return address.
                      (    forth6809.asm):02495         ; BRANCH
                      (    forth6809.asm):02496         ;    Inputs:
                      (    forth6809.asm):02497         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02498         ;    Outputs:
                      (    forth6809.asm):02499         ;        return address set to the branch target
                      (    forth6809.asm):02500         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02501         ; ------------------------------------------------------------
DCF8 3510             (    forth6809.asm):02502         BRANCH:     PULS  X
DCFA EC84             (    forth6809.asm):02503                     LDD   ,X
DCFC 308B             (    forth6809.asm):02504                     LEAX  D,X
DCFE 3410             (    forth6809.asm):02505                     PSHS  X
DD00 39               (    forth6809.asm):02506                     RTS
                      (    forth6809.asm):02507         
                      (    forth6809.asm):02508         ; ------------------------------------------------------------
                      (    forth6809.asm):02509         ; Run-time entry of a CREATEd or DOES>-defined word. Its code is a
                      (    forth6809.asm):02510         ; trampoline: JSR DODOES, a BEHAVIOR address, then the data-field
                      (    forth6809.asm):02511         ; address. Pushes the data-field address and jumps to BEHAVIOR.
                      (    forth6809.asm):02512         ; DODOES   ( -- pfa )
                      (    forth6809.asm):02513         ;    Inputs:
                      (    forth6809.asm):02514         ;        return stack top = address of the BEHAVIOR cell in the
                      (    forth6809.asm):02515         ;        trampoline
                      (    forth6809.asm):02516         ;    Outputs:
                      (    forth6809.asm):02517         ;        pfa pushed on the data stack; control passes to BEHAVIOR
                      (    forth6809.asm):02518         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02519         ; ------------------------------------------------------------
DD01 3510             (    forth6809.asm):02520         DODOES:     PULS  X
DD03 10AE81           (    forth6809.asm):02521                     LDY   ,X++
DD06 EC84             (    forth6809.asm):02522                     LDD   ,X
DD08 3606             (    forth6809.asm):02523                     PSHU  D                 ; pfa
DD0A 6EA4             (    forth6809.asm):02524                     JMP   ,Y
                      (    forth6809.asm):02525         
                      (    forth6809.asm):02526         ; ------------------------------------------------------------
                      (    forth6809.asm):02527         ; Default BEHAVIOR for a CREATEd word: do nothing, leaving the data-
                      (    forth6809.asm):02528         ; field address on the stack.
                      (    forth6809.asm):02529         ; DOESRT0
                      (    forth6809.asm):02530         ;    Inputs:
                      (    forth6809.asm):02531         ;        none
                      (    forth6809.asm):02532         ;    Outputs:
                      (    forth6809.asm):02533         ;        none
                      (    forth6809.asm):02534         ;    Registers: none.
                      (    forth6809.asm):02535         ; ------------------------------------------------------------
DD0C 39               (    forth6809.asm):02536         DOESRT0:    RTS
                      (    forth6809.asm):02537         
                      (    forth6809.asm):02538         ; ------------------------------------------------------------
                      (    forth6809.asm):02539         ; Run-time for DOES>: patch the BEHAVIOR cell of the most recent
                      (    forth6809.asm):02540         ; definition with the code that follows the calling JSR, then return
                      (    forth6809.asm):02541         ; two levels up, skipping the rest of the defining word.
                      (    forth6809.asm):02542         ; SETDOES
                      (    forth6809.asm):02543         ;    Inputs:
                      (    forth6809.asm):02544         ;        return stack top = address after "JSR SETDOES" (the new
                      (    forth6809.asm):02545         ;        BEHAVIOR)
                      (    forth6809.asm):02546         ;        next on the return stack = the defining word's own return
                      (    forth6809.asm):02547         ;        address
                      (    forth6809.asm):02548         ;    Outputs:
                      (    forth6809.asm):02549         ;        BEHAVIOR cell of LATEST patched; control returns to the
                      (    forth6809.asm):02550         ;        defining word's caller
                      (    forth6809.asm):02551         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02552         ; ------------------------------------------------------------
DD0D 3510             (    forth6809.asm):02553         SETDOES:    PULS  X                 ; X = addr right after "JSR SETDOES" - new BEHAVIOR
DD0F 1F12             (    forth6809.asm):02554                     TFR   X,Y               ; Y = new BEHAVIOR, kept across the walk
                      (    forth6809.asm):02555         
DD11 9E04             (    forth6809.asm):02556                     LDX   LATEST
DD13 E684             (    forth6809.asm):02557                     LDB   ,X
DD15 C41F             (    forth6809.asm):02558                     ANDB  #$1F
DD17 4F               (    forth6809.asm):02559                     CLRA
DD18 308B             (    forth6809.asm):02560                     LEAX  D,X               ; header + name length
DD1A EC03             (    forth6809.asm):02561                     LDD   3,X               ; D = CFA (trampoline address), past name and LINK
DD1C C30003           (    forth6809.asm):02562                     ADDD  #3                ; +3 -> BEHAVIOR field (past JSR DODOES)
DD1F 1F01             (    forth6809.asm):02563                     TFR   D,X
                      (    forth6809.asm):02564         
DD21 10AF84           (    forth6809.asm):02565                     STY   ,X                ; patch it
                      (    forth6809.asm):02566         
DD24 3510             (    forth6809.asm):02567                     PULS  X                 ; X = the OUTER defining word's own return addr
DD26 6E84             (    forth6809.asm):02568                     JMP   ,X                ; jump there directly - "double RTS"
                      (    forth6809.asm):02569         
                      (    forth6809.asm):02570         ; ------------------------------------------------------------
                      (    forth6809.asm):02571         ; BEHAVIOR of a DEFERred word: execute the xt stored in its data
                      (    forth6809.asm):02572         ; field. Tail-calls the xt, so it returns to the original caller.
                      (    forth6809.asm):02573         ; DODEFER   ( pfa -- )
                      (    forth6809.asm):02574         ;    Inputs:
                      (    forth6809.asm):02575         ;        pfa on the data stack
                      (    forth6809.asm):02576         ;    Outputs:
                      (    forth6809.asm):02577         ;        pfa removed; the stored xt is executed
                      (    forth6809.asm):02578         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02579         ; ------------------------------------------------------------
DD28 3710             (    forth6809.asm):02580         DODEFER:    PULU  X                 ; pfa
DD2A EC84             (    forth6809.asm):02581                     LDD   ,X
DD2C 1F01             (    forth6809.asm):02582                     TFR   D,X
DD2E 6E84             (    forth6809.asm):02583                     JMP   ,X
                      (    forth6809.asm):02584         
                      (    forth6809.asm):02585         ; ------------------------------------------------------------
                      (    forth6809.asm):02586         ; Initial xt of a DEFER: throws -21 until IS stores a real xt.
                      (    forth6809.asm):02587         ; DOABORTUNDEF
                      (    forth6809.asm):02588         ;    Inputs:
                      (    forth6809.asm):02589         ;        none
                      (    forth6809.asm):02590         ;    Outputs:
                      (    forth6809.asm):02591         ;        none (does not return)
                      (    forth6809.asm):02592         ;    Registers: RegD changed.
                      (    forth6809.asm):02593         ; ------------------------------------------------------------
DD30                  (    forth6809.asm):02594         DOABORTUNDEF:
DD30 CCFFEB           (    forth6809.asm):02595                     LDD   #-21
DD33 3606             (    forth6809.asm):02596                     PSHU  D                 ; throw code (-21)
DD35 7EE542           (    forth6809.asm):02597                     JMP   THROWW
                      (    forth6809.asm):02598         
                      (    forth6809.asm):02599         ; ------------------------------------------------------------
                      (    forth6809.asm):02600         ; BEHAVIOR of a MARKER word: restore the dictionary, code and variable
                      (    forth6809.asm):02601         ; pointers and LATEST from the four cells saved when it was defined,
                      (    forth6809.asm):02602         ; then the search order state (SRCHSAVESZ bytes after them), then
                      (    forth6809.asm):02603         ; unlink every RAM header newer than DPHERE from every wordlist.
                      (    forth6809.asm):02604         ; DOMARKER   ( pfa -- )
                      (    forth6809.asm):02605         ;    Inputs:
                      (    forth6809.asm):02606         ;        pfa on the data stack (the saved cells)
                      (    forth6809.asm):02607         ;    Outputs:
                      (    forth6809.asm):02608         ;        pfa removed; DPHERE, CODEHERE, VARHERE, LATEST, WLEND, CURRENT
                      (    forth6809.asm):02609         ;        and the search order restored; wordlists pruned
                      (    forth6809.asm):02610         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02611         ; ------------------------------------------------------------
DD38 3710             (    forth6809.asm):02612         DOMARKER:   PULU  X                 ; pfa
DD3A EC84             (    forth6809.asm):02613                     LDD   ,X
DD3C DD06             (    forth6809.asm):02614                     STD   DPHERE
DD3E EC02             (    forth6809.asm):02615                     LDD   2,X
DD40 DD08             (    forth6809.asm):02616                     STD   CODEHERE
DD42 EC04             (    forth6809.asm):02617                     LDD   4,X
DD44 DD0A             (    forth6809.asm):02618                     STD   VARHERE
DD46 EC06             (    forth6809.asm):02619                     LDD   6,X
DD48 DD04             (    forth6809.asm):02620                     STD   LATEST
DD4A 3008             (    forth6809.asm):02621                     LEAX  8,X               ; the saved search-order state follows
DD4C 108E0045         (    forth6809.asm):02622                     LDY   #SRCHSAVE
DD50 C616             (    forth6809.asm):02623                     LDB   #SRCHSAVESZ
DD52 A680             (    forth6809.asm):02624         DMCOPY:     LDA   ,X+
DD54 A7A0             (    forth6809.asm):02625                     STA   ,Y+
DD56 5A               (    forth6809.asm):02626                     DECB
DD57 26F9             (    forth6809.asm):02627                     BNE   DMCOPY
DD59 DC06             (    forth6809.asm):02628                     LDD   DPHERE
DD5B 7EE27C           (    forth6809.asm):02629                     JMP   PRUNE             ; unlink headers newer than DPHERE
                      (    forth6809.asm):02630         
                      (    forth6809.asm):02631         ; ------------------------------------------------------------
                      (    forth6809.asm):02632         ; EXECUTE  ( i*x xt -- j*x )
                      (    forth6809.asm):02633         ; Execute the word whose execution token is xt.
                      (    forth6809.asm):02634         ; ------------------------------------------------------------
DD5E 3710             (    forth6809.asm):02635         EXECUTEW:   PULU  X                 ; xt
DD60 AD84             (    forth6809.asm):02636                     JSR   ,X
DD62 39               (    forth6809.asm):02637                     RTS
                      (    forth6809.asm):02638         
                      (    forth6809.asm):02639         ; ============================================================
                      (    forth6809.asm):02640         ; SECTION 6: COMMA FAMILY (factored via APPENDCELL/APPENDBYTE)
                      (    forth6809.asm):02641         ; ============================================================
                      (    forth6809.asm):02642         ; ------------------------------------------------------------
                      (    forth6809.asm):02643         ; Append a 16-bit cell to the area whose "here" pointer is at RegX
                      (    forth6809.asm):02644         ; (CODEHERE or VARHERE), and advance that pointer by 2.
                      (    forth6809.asm):02645         ; APPENDCELL   ( x -- )
                      (    forth6809.asm):02646         ;    Inputs:
                      (    forth6809.asm):02647         ;        RegX = address of the here pointer
                      (    forth6809.asm):02648         ;        x on the data stack
                      (    forth6809.asm):02649         ;    Outputs:
                      (    forth6809.asm):02650         ;        x stored at the old here value; pointer advanced by 2
                      (    forth6809.asm):02651         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02652         ; ------------------------------------------------------------
DD63 3706             (    forth6809.asm):02653         APPENDCELL: PULU  D                 ; x
DD65 10AE84           (    forth6809.asm):02654                     LDY   ,X
DD68 EDA1             (    forth6809.asm):02655                     STD   ,Y++
DD6A 10AF84           (    forth6809.asm):02656                     STY   ,X
DD6D 39               (    forth6809.asm):02657                     RTS
                      (    forth6809.asm):02658         
                      (    forth6809.asm):02659         ; ------------------------------------------------------------
                      (    forth6809.asm):02660         ; Append the low byte of the top cell to the area whose "here" pointer
                      (    forth6809.asm):02661         ; is at RegX (CODEHERE or VARHERE), and advance that pointer by 1.
                      (    forth6809.asm):02662         ; APPENDBYTE   ( char -- )
                      (    forth6809.asm):02663         ;    Inputs:
                      (    forth6809.asm):02664         ;        RegX = address of the here pointer
                      (    forth6809.asm):02665         ;        char on the data stack
                      (    forth6809.asm):02666         ;    Outputs:
                      (    forth6809.asm):02667         ;        char stored at the old here value; pointer advanced by 1
                      (    forth6809.asm):02668         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02669         ; ------------------------------------------------------------
DD6E 3706             (    forth6809.asm):02670         APPENDBYTE: PULU  D                 ; char
DD70 10AE84           (    forth6809.asm):02671                     LDY   ,X
DD73 E7A0             (    forth6809.asm):02672                     STB   ,Y+
DD75 10AF84           (    forth6809.asm):02673                     STY   ,X
DD78 39               (    forth6809.asm):02674                     RTS
                      (    forth6809.asm):02675         
                      (    forth6809.asm):02676         ; ------------------------------------------------------------
                      (    forth6809.asm):02677         ; ,  ( x -- )
                      (    forth6809.asm):02678         ; Append x to the code/data area (CODEHERE).
                      (    forth6809.asm):02679         ; ------------------------------------------------------------
DD79 8E0008           (    forth6809.asm):02680         COMMAW:     LDX   #CODEHERE
DD7C 7EDD63           (    forth6809.asm):02681                     JMP   APPENDCELL
                      (    forth6809.asm):02682         
                      (    forth6809.asm):02683         ; ------------------------------------------------------------
                      (    forth6809.asm):02684         ; CODECOMMA  ( x -- )
                      (    forth6809.asm):02685         ; Internal name for ",": append x at CODEHERE.
                      (    forth6809.asm):02686         ; ------------------------------------------------------------
DD7F 8E0008           (    forth6809.asm):02687         CODECOMMA:  LDX   #CODEHERE
DD82 7EDD63           (    forth6809.asm):02688                     JMP   APPENDCELL
                      (    forth6809.asm):02689         
                      (    forth6809.asm):02690         ; ------------------------------------------------------------
                      (    forth6809.asm):02691         ; C,  ( char -- )
                      (    forth6809.asm):02692         ; Append char to the code/data area (CODEHERE).
                      (    forth6809.asm):02693         ; ------------------------------------------------------------
DD85 8E0008           (    forth6809.asm):02694         CCOMMAW:    LDX   #CODEHERE
DD88 7EDD6E           (    forth6809.asm):02695                     JMP   APPENDBYTE
                      (    forth6809.asm):02696         
                      (    forth6809.asm):02697         ; ------------------------------------------------------------
                      (    forth6809.asm):02698         ; CCOMMA1  ( char -- )
                      (    forth6809.asm):02699         ; Internal name for "C,": append char at CODEHERE.
                      (    forth6809.asm):02700         ; ------------------------------------------------------------
DD8B 8E0008           (    forth6809.asm):02701         CCOMMA1:    LDX   #CODEHERE
DD8E 7EDD6E           (    forth6809.asm):02702                     JMP   APPENDBYTE
                      (    forth6809.asm):02703         
                      (    forth6809.asm):02704         ; ------------------------------------------------------------
                      (    forth6809.asm):02705         ; V,  ( x -- )
                      (    forth6809.asm):02706         ; Append x to the variable area (VARHERE).
                      (    forth6809.asm):02707         ; ------------------------------------------------------------
DD91 8E000A           (    forth6809.asm):02708         VCOMMAW:    LDX   #VARHERE
DD94 7EDD63           (    forth6809.asm):02709                     JMP   APPENDCELL
                      (    forth6809.asm):02710         
                      (    forth6809.asm):02711         ; ------------------------------------------------------------
                      (    forth6809.asm):02712         ; VC,  ( char -- )
                      (    forth6809.asm):02713         ; Append char to the variable area (VARHERE).
                      (    forth6809.asm):02714         ; ------------------------------------------------------------
DD97 8E000A           (    forth6809.asm):02715         VCCOMMAW:   LDX   #VARHERE
DD9A 7EDD6E           (    forth6809.asm):02716                     JMP   APPENDBYTE
                      (    forth6809.asm):02717         
                      (    forth6809.asm):02718         ; ------------------------------------------------------------
                      (    forth6809.asm):02719         ; ALLOT  ( n -- )
                      (    forth6809.asm):02720         ; Reserve n bytes in the code/data area by advancing CODEHERE.
                      (    forth6809.asm):02721         ; ------------------------------------------------------------
DD9D 3706             (    forth6809.asm):02722         ALLOTW:     PULU  D                 ; n
DD9F 9E08             (    forth6809.asm):02723                     LDX   CODEHERE
DDA1 308B             (    forth6809.asm):02724                     LEAX  D,X
DDA3 9F08             (    forth6809.asm):02725                     STX   CODEHERE
DDA5 39               (    forth6809.asm):02726                     RTS
                      (    forth6809.asm):02727         
                      (    forth6809.asm):02728         ; ------------------------------------------------------------
                      (    forth6809.asm):02729         ; VALLOT  ( n -- )
                      (    forth6809.asm):02730         ; Reserve n bytes in the variable area by advancing VARHERE.
                      (    forth6809.asm):02731         ; ------------------------------------------------------------
DDA6 3706             (    forth6809.asm):02732         VALLOTW:    PULU  D                 ; n
DDA8 9E0A             (    forth6809.asm):02733                     LDX   VARHERE
DDAA 308B             (    forth6809.asm):02734                     LEAX  D,X
DDAC 9F0A             (    forth6809.asm):02735                     STX   VARHERE
DDAE 39               (    forth6809.asm):02736                     RTS
                      (    forth6809.asm):02737         
                      (    forth6809.asm):02738         ; ------------------------------------------------------------
                      (    forth6809.asm):02739         ; HERE  ( -- addr )
                      (    forth6809.asm):02740         ; Return the next free address in the code/data area (CODEHERE).
                      (    forth6809.asm):02741         ; ------------------------------------------------------------
DDAF DC08             (    forth6809.asm):02742         HEREW:      LDD   CODEHERE
DDB1 3606             (    forth6809.asm):02743                     PSHU  D                 ; addr
DDB3 39               (    forth6809.asm):02744                     RTS
                      (    forth6809.asm):02745         
                      (    forth6809.asm):02746         ; ------------------------------------------------------------
                      (    forth6809.asm):02747         ; VHERE  ( -- addr )
                      (    forth6809.asm):02748         ; Return the next free address in the variable area (VARHERE).
                      (    forth6809.asm):02749         ; ------------------------------------------------------------
DDB4 DC0A             (    forth6809.asm):02750         VHEREW:     LDD   VARHERE
DDB6 3606             (    forth6809.asm):02751                     PSHU  D                 ; addr
DDB8 39               (    forth6809.asm):02752                     RTS
                      (    forth6809.asm):02753         
                      (    forth6809.asm):02754         ; ------------------------------------------------------------
                      (    forth6809.asm):02755         ; PAD  ( -- c-addr )
                      (    forth6809.asm):02756         ; Return the scratch buffer address, PADOFFSET bytes above CODEHERE.
                      (    forth6809.asm):02757         ; ------------------------------------------------------------
DDB9 DC08             (    forth6809.asm):02758         PADW:       LDD   CODEHERE
DDBB C30080           (    forth6809.asm):02759                     ADDD  #PADOFFSET
DDBE 3606             (    forth6809.asm):02760                     PSHU  D                 ; c-addr
DDC0 39               (    forth6809.asm):02761                     RTS
                      (    forth6809.asm):02762         
                      (    forth6809.asm):02763         ; ------------------------------------------------------------
                      (    forth6809.asm):02764         ; UNUSED  ( -- u )
                      (    forth6809.asm):02765         ; Return the number of free bytes remaining in the code/data area.
                      (    forth6809.asm):02766         ; ------------------------------------------------------------
DDC1 CCB900           (    forth6809.asm):02767         UNUSEDW:    LDD   #CODETOP
DDC4 9308             (    forth6809.asm):02768                     SUBD  CODEHERE
DDC6 3606             (    forth6809.asm):02769                     PSHU  D                 ; u
DDC8 39               (    forth6809.asm):02770                     RTS
                      (    forth6809.asm):02771         
                      (    forth6809.asm):02772         ; ------------------------------------------------------------
                      (    forth6809.asm):02773         ; VUNUSED  ( -- u )
                      (    forth6809.asm):02774         ; Return the number of free bytes remaining in the variable area.
                      (    forth6809.asm):02775         ; ------------------------------------------------------------
DDC9 CC1FFF           (    forth6809.asm):02776         VUNUSEDW:   LDD   #APPVARSEND       ; See bugfix: VUNUSEDW.1
DDCC 930A             (    forth6809.asm):02777                     SUBD  VARHERE
DDCE 3606             (    forth6809.asm):02778                     PSHU  D                 ; u
DDD0 39               (    forth6809.asm):02779                     RTS
                      (    forth6809.asm):02780         
                      (    forth6809.asm):02781         ; ============================================================
                      (    forth6809.asm):02782         ; SECTION 7: HEADER (factored from :/CREATE/VARIABLE)
                      (    forth6809.asm):02783         ; ============================================================
                      (    forth6809.asm):02784         ; ------------------------------------------------------------
                      (    forth6809.asm):02785         ; Build a dictionary header for the next name in the input: parse the
                      (    forth6809.asm):02786         ; name, then lay down the length byte (with the smudge bit set if
                      (    forth6809.asm):02787         ; requested), the name, the link to the previous header and the code
                      (    forth6809.asm):02788         ; field address (CODEHERE). LATEST, DPHERE and the head of the CURRENT
                      (    forth6809.asm):02789         ; wordlist are updated.
                      (    forth6809.asm):02790         ; HEADER   ( smudge-flag "name" -- )
                      (    forth6809.asm):02791         ;    Inputs:
                      (    forth6809.asm):02792         ;        smudge-flag on the data stack (non-zero hides the new word)
                      (    forth6809.asm):02793         ;        name parsed from the input stream
                      (    forth6809.asm):02794         ;    Outputs:
                      (    forth6809.asm):02795         ;        header built at DPHERE, linked into the CURRENT wordlist;
                      (    forth6809.asm):02796         ;        LATEST = address of the new header
                      (    forth6809.asm):02797         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02798         ; ------------------------------------------------------------
DDD1 CC0020           (    forth6809.asm):02799         HEADER:     LDD   #32
DDD4 3606             (    forth6809.asm):02800                     PSHU  D
DDD6 BDE10E           (    forth6809.asm):02801                     JSR   WORDW
DDD9 3710             (    forth6809.asm):02802                     PULU  X                 ; c-addr of the name
DDDB 3706             (    forth6809.asm):02803                     PULU  D                 ; smudge flag in B
DDDD A680             (    forth6809.asm):02804                     LDA   ,X+               ; name length, X = name text
DDDF 3402             (    forth6809.asm):02805                     PSHS  A                 ; 2,S = length (5k: S-frame, no scratch)
DDE1 5D               (    forth6809.asm):02806                     TSTB
DDE2 2702             (    forth6809.asm):02807                     BEQ   HDNOSM
DDE4 8A40             (    forth6809.asm):02808                     ORA   #$40
DDE6 109E06           (    forth6809.asm):02809         HDNOSM:     LDY   DPHERE
DDE9 3420             (    forth6809.asm):02810                     PSHS  Y                 ; 0,S = address of the new header
DDEB A7A0             (    forth6809.asm):02811                     STA   ,Y+
DDED E662             (    forth6809.asm):02812                     LDB   2,S
DDEF 2707             (    forth6809.asm):02813                     BEQ   HDNONM
DDF1 A680             (    forth6809.asm):02814         HDCPY:      LDA   ,X+
DDF3 A7A0             (    forth6809.asm):02815                     STA   ,Y+
DDF5 5A               (    forth6809.asm):02816                     DECB
DDF6 26F9             (    forth6809.asm):02817                     BNE   HDCPY
DDF8 9E47             (    forth6809.asm):02818         HDNONM:     LDX   CURRENT           ; X = WID of the wordlist receiving the word
DDFA EC84             (    forth6809.asm):02819                     LDD   ,X
DDFC EDA1             (    forth6809.asm):02820                     STD   ,Y++              ; LINK = old head of that wordlist
DDFE DC08             (    forth6809.asm):02821                     LDD   CODEHERE
DE00 EDA1             (    forth6809.asm):02822                     STD   ,Y++
DE02 109F06           (    forth6809.asm):02823                     STY   DPHERE
DE05 3506             (    forth6809.asm):02824                     PULS  D
DE07 DD04             (    forth6809.asm):02825                     STD   LATEST            ; LATEST = newest header of any wordlist
DE09 ED84             (    forth6809.asm):02826                     STD   ,X                ; and the new head of the CURRENT wordlist
DE0B 3261             (    forth6809.asm):02827                     LEAS  1,S
DE0D 39               (    forth6809.asm):02828                     RTS
                      (    forth6809.asm):02829         
                      (    forth6809.asm):02830         ; ============================================================
                      (    forth6809.asm):02831         ; SECTION 8: DEFINING WORDS
                      (    forth6809.asm):02832         ; ============================================================
                      (    forth6809.asm):02833         ; ------------------------------------------------------------
                      (    forth6809.asm):02834         ; :  ( "name" -- )
                      (    forth6809.asm):02835         ; Start a colon definition: parse the name, build a smudged header,
                      (    forth6809.asm):02836         ; record the new xt in CURXT, note the control-flow stack position in
                      (    forth6809.asm):02837         ; CSP and enter compile state.
                      (    forth6809.asm):02838         ; ------------------------------------------------------------
DE0E CCFFFF           (    forth6809.asm):02839         COLONW:     LDD   #TRUEV
DE11 3606             (    forth6809.asm):02840                     PSHU  D
DE13 BDDDD1           (    forth6809.asm):02841                     JSR   HEADER
DE16 DC08             (    forth6809.asm):02842                     LDD   CODEHERE          ; Record this word's xt for RECURSE.
DE18 DD1F             (    forth6809.asm):02843                     STD   CURXT             ; See bugfix: COLONW.1
DE1A 1F30             (    forth6809.asm):02844                     TFR   U,D
DE1C DD21             (    forth6809.asm):02845                     STD   CSP
DE1E CCFFFF           (    forth6809.asm):02846                     LDD   #-1
DE21 DD00             (    forth6809.asm):02847                     STD   STATE
DE23 39               (    forth6809.asm):02848                     RTS
                      (    forth6809.asm):02849         
                      (    forth6809.asm):02850         ; ------------------------------------------------------------
                      (    forth6809.asm):02851         ; ;  ( -- )  IMMEDIATE
                      (    forth6809.asm):02852         ; End a colon definition: compile RTS, check that the control-flow
                      (    forth6809.asm):02853         ; stack is balanced (error -22 if not), clear the smudge bit of the
                      (    forth6809.asm):02854         ; new word and return to interpret state.
                      (    forth6809.asm):02855         ; ------------------------------------------------------------
DE24 CC0039           (    forth6809.asm):02856         SEMIW:      LDD   #RTSOPC
DE27 3606             (    forth6809.asm):02857                     PSHU  D
DE29 BDDD8B           (    forth6809.asm):02858                     JSR   CCOMMA1
DE2C 1F30             (    forth6809.asm):02859                     TFR   U,D
DE2E 109321           (    forth6809.asm):02860                     CMPD  CSP
DE31 2703             (    forth6809.asm):02861                     BEQ   SEMIOK
DE33 BDE50D           (    forth6809.asm):02862                     JSR   CFERR
DE36 9E04             (    forth6809.asm):02863         SEMIOK:     LDX   LATEST
DE38 A684             (    forth6809.asm):02864                     LDA   ,X
DE3A 84BF             (    forth6809.asm):02865                     ANDA  #$BF
DE3C A784             (    forth6809.asm):02866                     STA   ,X
DE3E CC0000           (    forth6809.asm):02867                     LDD   #0
DE41 DD00             (    forth6809.asm):02868                     STD   STATE
DE43 39               (    forth6809.asm):02869                     RTS
                      (    forth6809.asm):02870         
                      (    forth6809.asm):02871         ; ------------------------------------------------------------
                      (    forth6809.asm):02872         ; :NONAME  ( -- xt )
                      (    forth6809.asm):02873         ; Start an anonymous definition: no header is built and LATEST is left
                      (    forth6809.asm):02874         ; alone, so the word can never be found. Leaves the xt (the current
                      (    forth6809.asm):02875         ; CODEHERE) on the stack, records it in CURXT, notes the control-flow
                      (    forth6809.asm):02876         ; stack position in CSP and enters compile state.
                      (    forth6809.asm):02877         ; Original comment: shadow NONAMEW.0.
                      (    forth6809.asm):02878         ; ------------------------------------------------------------
DE44 DC08             (    forth6809.asm):02879         NONAMEW:    LDD   CODEHERE
DE46 3606             (    forth6809.asm):02880                     PSHU  D                 ; xt
DE48 DD1F             (    forth6809.asm):02881                     STD   CURXT             ; See bugfix: NONAMEW.1
DE4A 1F30             (    forth6809.asm):02882                     TFR   U,D
DE4C DD21             (    forth6809.asm):02883                     STD   CSP
DE4E CCFFFF           (    forth6809.asm):02884                     LDD   #-1
DE51 DD00             (    forth6809.asm):02885                     STD   STATE
DE53 39               (    forth6809.asm):02886                     RTS
                      (    forth6809.asm):02887         
                      (    forth6809.asm):02888         ; ------------------------------------------------------------
                      (    forth6809.asm):02889         ; Common start of every DODOES-style defining word: build a header
                      (    forth6809.asm):02890         ; and compile the DODOES trampoline followed by the behaviour address.
                      (    forth6809.asm):02891         ; BLDDOES
                      (    forth6809.asm):02892         ;    Inputs:
                      (    forth6809.asm):02893         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):02894         ;    Outputs:
                      (    forth6809.asm):02895         ;        header built, trampoline and behaviour cell compiled
                      (    forth6809.asm):02896         ;    Registers: all changed.
                      (    forth6809.asm):02897         ; BLDSELF
                      (    forth6809.asm):02898         ;    Inputs:
                      (    forth6809.asm):02899         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):02900         ;    Outputs:
                      (    forth6809.asm):02901         ;        as BLDDOES, then the PFA cell compiled pointing at the
                      (    forth6809.asm):02902         ;        cell that follows it (the word's own data field)
                      (    forth6809.asm):02903         ;    Registers: all changed.
                      (    forth6809.asm):02904         ; Used by CREATE, CONSTANT, 2CONSTANT, DEFER and MARKER (BLDSELF)
                      (    forth6809.asm):02905         ; and by VALUE (BLDDOES, which supplies its own PFA).
                      (    forth6809.asm):02906         ; ------------------------------------------------------------
DE54 3406             (    forth6809.asm):02907         BLDDOES:    PSHS  D                 ; behaviour address
DE56 CC0000           (    forth6809.asm):02908                     LDD   #0
DE59 3606             (    forth6809.asm):02909                     PSHU  D
DE5B BDDDD1           (    forth6809.asm):02910                     JSR   HEADER
DE5E CCDD01           (    forth6809.asm):02911                     LDD   #DODOES
DE61 3606             (    forth6809.asm):02912                     PSHU  D
DE63 BDE97D           (    forth6809.asm):02913                     JSR   CCALL
DE66 3506             (    forth6809.asm):02914                     PULS  D
DE68 3606             (    forth6809.asm):02915                     PSHU  D                 ; behaviour address
DE6A BDDD7F           (    forth6809.asm):02916                     JSR   CODECOMMA
DE6D 39               (    forth6809.asm):02917                     RTS
                      (    forth6809.asm):02918         
DE6E BDDE54           (    forth6809.asm):02919         BLDSELF:    JSR   BLDDOES
DE71 DC08             (    forth6809.asm):02920                     LDD   CODEHERE          ; PFA = the cell after this one
DE73 C30002           (    forth6809.asm):02921                     ADDD  #2                ; See bugfix: CONSTANTW.1
DE76 3606             (    forth6809.asm):02922                     PSHU  D
DE78 BDDD7F           (    forth6809.asm):02923                     JSR   CODECOMMA
DE7B 39               (    forth6809.asm):02924                     RTS
                      (    forth6809.asm):02925         
                      (    forth6809.asm):02926         ; ------------------------------------------------------------
                      (    forth6809.asm):02927         ; CREATE  ( "name" -- )
                      (    forth6809.asm):02928         ; Build a header whose code is a DODOES trampoline. The default
                      (    forth6809.asm):02929         ; behaviour (DOESRT0) leaves the data-field address, the next free
                      (    forth6809.asm):02930         ; address in the code area, on the stack.
                      (    forth6809.asm):02931         ; ------------------------------------------------------------
DE7C CCDD0C           (    forth6809.asm):02932         CREATEW:    LDD   #DOESRT0
DE7F BDDE6E           (    forth6809.asm):02933                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
DE82 39               (    forth6809.asm):02934                     RTS
                      (    forth6809.asm):02935         
                      (    forth6809.asm):02936         ; ------------------------------------------------------------
                      (    forth6809.asm):02937         ; DOES>  ( -- )  IMMEDIATE, compile-only
                      (    forth6809.asm):02938         ; Compile a call to SETDOES, which at run time patches the behaviour
                      (    forth6809.asm):02939         ; of the word being defined.
                      (    forth6809.asm):02940         ; Original comment: shadow DOESGTW.0.
                      (    forth6809.asm):02941         ; ------------------------------------------------------------
DE83 CCDD0D           (    forth6809.asm):02942         DOESGTW:    LDD   #SETDOES
DE86 3606             (    forth6809.asm):02943                     PSHU  D
DE88 BDE97D           (    forth6809.asm):02944                     JSR   CCALL
DE8B 39               (    forth6809.asm):02945                     RTS
                      (    forth6809.asm):02946         
                      (    forth6809.asm):02947         ; ------------------------------------------------------------
                      (    forth6809.asm):02948         ; VARIABLE  ( "name" -- )
                      (    forth6809.asm):02949         ; Build a word that returns the address of a new cell in the variable
                      (    forth6809.asm):02950         ; area, initialised to zero.
                      (    forth6809.asm):02951         ; ------------------------------------------------------------
DE8C CC0000           (    forth6809.asm):02952         VARIABLEW:  LDD   #0
DE8F 3606             (    forth6809.asm):02953                     PSHU  D
DE91 BDDDD1           (    forth6809.asm):02954                     JSR   HEADER
DE94 CCDD01           (    forth6809.asm):02955                     LDD   #DODOES
DE97 3606             (    forth6809.asm):02956                     PSHU  D
DE99 BDE97D           (    forth6809.asm):02957                     JSR   CCALL
DE9C CCDD0C           (    forth6809.asm):02958                     LDD   #DOESRT0
DE9F 3606             (    forth6809.asm):02959                     PSHU  D
DEA1 BDDD7F           (    forth6809.asm):02960                     JSR   CODECOMMA
DEA4 DC0A             (    forth6809.asm):02961                     LDD   VARHERE
DEA6 3606             (    forth6809.asm):02962                     PSHU  D
DEA8 BDDD7F           (    forth6809.asm):02963                     JSR   CODECOMMA
DEAB CC0000           (    forth6809.asm):02964                     LDD   #0
DEAE 9E0A             (    forth6809.asm):02965                     LDX   VARHERE
DEB0 ED81             (    forth6809.asm):02966                     STD   ,X++
DEB2 9F0A             (    forth6809.asm):02967                     STX   VARHERE
DEB4 39               (    forth6809.asm):02968                     RTS
                      (    forth6809.asm):02969         
                      (    forth6809.asm):02970         ; ------------------------------------------------------------
                      (    forth6809.asm):02971         ; @  ( a-addr -- x )
                      (    forth6809.asm):02972         ; Fetch the cell at a-addr. Also the behaviour of CONSTANT words.
                      (    forth6809.asm):02973         ; ------------------------------------------------------------
DEB5 3710             (    forth6809.asm):02974         FETCHW:     PULU  X                 ; a-addr
DEB7 EC84             (    forth6809.asm):02975                     LDD   ,X
DEB9 3606             (    forth6809.asm):02976                     PSHU  D                 ; x
DEBB 39               (    forth6809.asm):02977                     RTS
                      (    forth6809.asm):02978         
                      (    forth6809.asm):02979         ; ------------------------------------------------------------
                      (    forth6809.asm):02980         ; CONSTANT  ( x "name" -- )
                      (    forth6809.asm):02981         ; Build a word that returns x. The value is stored in the code area
                      (    forth6809.asm):02982         ; after the trampoline and fetched with @.
                      (    forth6809.asm):02983         ; ------------------------------------------------------------
DEBC CCDEB5           (    forth6809.asm):02984         CONSTANTW:  LDD   #FETCHW
DEBF BDDE6E           (    forth6809.asm):02985                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
DEC2 BDDD79           (    forth6809.asm):02986                     JSR   COMMAW
DEC5 39               (    forth6809.asm):02987                     RTS
                      (    forth6809.asm):02988         
                      (    forth6809.asm):02989         ; ------------------------------------------------------------
                      (    forth6809.asm):02990         ; Behaviour of a VALUE word: fetch the value cell.
                      (    forth6809.asm):02991         ; DOVALUE   ( pfa -- x )
                      (    forth6809.asm):02992         ;    Inputs:
                      (    forth6809.asm):02993         ;        pfa on the data stack (address of the value cell)
                      (    forth6809.asm):02994         ;    Outputs:
                      (    forth6809.asm):02995         ;        pfa replaced by the value
                      (    forth6809.asm):02996         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02997         ; ------------------------------------------------------------
DEC6 3710             (    forth6809.asm):02998         DOVALUE:    PULU  X                 ; pfa
DEC8 EC84             (    forth6809.asm):02999                     LDD   ,X
DECA 3606             (    forth6809.asm):03000                     PSHU  D                 ; x
DECC 39               (    forth6809.asm):03001                     RTS
                      (    forth6809.asm):03002         
                      (    forth6809.asm):03003         ; ------------------------------------------------------------
                      (    forth6809.asm):03004         ; VALUE  ( x "name" -- )
                      (    forth6809.asm):03005         ; Build a word that returns x, which can be changed with TO. The value
                      (    forth6809.asm):03006         ; cell is kept in the variable area so that it is writable.
                      (    forth6809.asm):03007         ; ------------------------------------------------------------
DECD CCDEC6           (    forth6809.asm):03008         VALUEW:     LDD   #DOVALUE
DED0 BDDE54           (    forth6809.asm):03009                     JSR   BLDDOES
DED3 DC0A             (    forth6809.asm):03010                     LDD   VARHERE           ; PFA = VARHERE (writable space)
DED5 3606             (    forth6809.asm):03011                     PSHU  D                 ; See bugfix: VALUEW.1
DED7 BDDD7F           (    forth6809.asm):03012                     JSR   CODECOMMA
DEDA BDDD91           (    forth6809.asm):03013                     JSR   VCOMMAW           ; store x in the variable area
DEDD 39               (    forth6809.asm):03014                     RTS
                      (    forth6809.asm):03015         
                      (    forth6809.asm):03016         ; ------------------------------------------------------------
                      (    forth6809.asm):03017         ; Behaviour of a 2VALUE word: fetch the two-cell value, x2 at the
                      (    forth6809.asm):03018         ; lower address as 2@ expects.
                      (    forth6809.asm):03019         ; DO2VALUE   ( pfa -- x1 x2 )
                      (    forth6809.asm):03020         ; ------------------------------------------------------------
DEDE 7EF350           (    forth6809.asm):03021         DO2VALUE:   JMP   TWOFETCHW
                      (    forth6809.asm):03022         
                      (    forth6809.asm):03023         ; ------------------------------------------------------------
                      (    forth6809.asm):03024         ; 2VALUE  ( x1 x2 "name" -- )
                      (    forth6809.asm):03025         ; Build a word that returns x1 x2, which can be changed with TO. The
                      (    forth6809.asm):03026         ; two cells are kept in the variable area so that they are writable.
                      (    forth6809.asm):03027         ; ------------------------------------------------------------
DEE1 CCDEDE           (    forth6809.asm):03028         TWOVALUEW:  LDD   #DO2VALUE
DEE4 BDDE54           (    forth6809.asm):03029                     JSR   BLDDOES
DEE7 DC0A             (    forth6809.asm):03030                     LDD   VARHERE           ; PFA = VARHERE (writable space)
DEE9 3606             (    forth6809.asm):03031                     PSHU  D
DEEB BDDD7F           (    forth6809.asm):03032                     JSR   CODECOMMA
DEEE BDDD91           (    forth6809.asm):03033                     JSR   VCOMMAW           ; x2 at the lower address
DEF1 BDDD91           (    forth6809.asm):03034                     JSR   VCOMMAW           ; then x1
DEF4 39               (    forth6809.asm):03035                     RTS
                      (    forth6809.asm):03036         
                      (    forth6809.asm):03037         ; ------------------------------------------------------------
                      (    forth6809.asm):03038         ; TO  ( x "name" -- )  IMMEDIATE
                      (    forth6809.asm):03039         ; Store x in the named VALUE. When compiling, instead compile code to
                      (    forth6809.asm):03040         ; store a run-time x in it. Error -13 if the name is not found.
                      (    forth6809.asm):03041         ; ------------------------------------------------------------
DEF5 CC0020           (    forth6809.asm):03042         TOW:        LDD   #32
DEF8 3606             (    forth6809.asm):03043                     PSHU  D
DEFA BDE10E           (    forth6809.asm):03044                     JSR   WORDW
DEFD BDE1F8           (    forth6809.asm):03045                     JSR   FINDW

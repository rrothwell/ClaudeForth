DE1F DC08             (    forth6809.asm):05413                     LDD   CODEHERE
DE21 3606             (    forth6809.asm):05414                     PSHU  D
DE23 3506             (    forth6809.asm):05415                     PULS  D                 ; orig1
DE25 3606             (    forth6809.asm):05416                     PSHU  D
DE27 BDDA96           (    forth6809.asm):05417                     JSR   PATCH
DE2A DC08             (    forth6809.asm):05418                     LDD   CODEHERE

                      (    forth6809.asm):08498         ; #  ( ud1 -- ud2 )
                      (    forth6809.asm):08499         ; Divide ud1 by BASE, add the remainder as a digit to the pictured
                      (    forth6809.asm):08500         ; numeric output string, and leave the quotient ud2.
                      (    forth6809.asm):08501         ; ------------------------------------------------------------

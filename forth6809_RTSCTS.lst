                      (    forth6809.asm):07096         ; ------------------------------------------------------------
F3C0 CC0020           (    forth6809.asm):07097         BLANKW:     LDD   #32
F3C3 3606             (    forth6809.asm):07098                     PSHU  D
F3C5 7EF3A2           (    forth6809.asm):07099                     JMP   FILLW
                      (    forth6809.asm):07100         
                      (    forth6809.asm):07101         ; ============================================================
                      (    forth6809.asm):07102         ; SECTION 19: STRING WORDS
                      (    forth6809.asm):07103         ; ============================================================
                      (    forth6809.asm):07104         ; ------------------------------------------------------------
                      (    forth6809.asm):07105         ; Run-time part of S". The counted string follows the call: push its
                      (    forth6809.asm):07106         ; address and length and skip over it.
                      (    forth6809.asm):07107         ; DOSTR   ( -- c-addr u )
                      (    forth6809.asm):07108         ;    Inputs:
                      (    forth6809.asm):07109         ;        return address on S points at the count byte
                      (    forth6809.asm):07110         ;    Outputs:
                      (    forth6809.asm):07111         ;        c-addr and u on the data stack; execution resumes after the
                      (    forth6809.asm):07112         ;        string
                      (    forth6809.asm):07113         ;    Registers: RegB, RegD and RegX changed.
                      (    forth6809.asm):07114         ; ------------------------------------------------------------
F3C8 3510             (    forth6809.asm):07115         DOSTR:      PULS  X
F3CA E684             (    forth6809.asm):07116                     LDB   ,X
F3CC 3001             (    forth6809.asm):07117                     LEAX  1,X
F3CE 3610             (    forth6809.asm):07118                     PSHU  X
F3D0 4F               (    forth6809.asm):07119                     CLRA
F3D1 3606             (    forth6809.asm):07120                     PSHU  D
F3D3 3085             (    forth6809.asm):07121                     LEAX  B,X
F3D5 3410             (    forth6809.asm):07122                     PSHS  X
F3D7 39               (    forth6809.asm):07123                     RTS
                      (    forth6809.asm):07124         
                      (    forth6809.asm):07125         ; ------------------------------------------------------------
                      (    forth6809.asm):07126         ; Parse the text up to the next double quote for S", ." and ABORT".
                      (    forth6809.asm):07127         ; WORD cannot be used: it skips leading delimiters, so an empty string
                      (    forth6809.asm):07128         ; (S" ") ran on to the next quote in the source. PARSE does not skip.
                      (    forth6809.asm):07129         ; PARSEQUOTE
                      (    forth6809.asm):07130         ;    Inputs:
                      (    forth6809.asm):07131         ;        none (parses from >IN)
                      (    forth6809.asm):07132         ;    Outputs:
                      (    forth6809.asm):07133         ;        c-addr u on the data stack: the text in the input buffer.
                      (    forth6809.asm):07134         ;        THROW -18 if the text is longer than 255 characters.
                      (    forth6809.asm):07135         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):07136         ; ------------------------------------------------------------
F3D8 CC0022           (    forth6809.asm):07137         PARSEQUOTE: LDD   #34
F3DB 3606             (    forth6809.asm):07138                     PSHU  D
F3DD BDF5AE           (    forth6809.asm):07139                     JSR   PARSEW
F3E0 6DC4             (    forth6809.asm):07140                     TST   ,U                ; high byte of the length
F3E2 2601             (    forth6809.asm):07141                     BNE   PQLONG
F3E4 39               (    forth6809.asm):07142                     RTS
F3E5 CCFFEE           (    forth6809.asm):07143         PQLONG:     LDD   #-18
F3E8 3606             (    forth6809.asm):07144                     PSHU  D
F3EA 7EE542           (    forth6809.asm):07145                     JMP   THROWW
                      (    forth6809.asm):07146         
                      (    forth6809.asm):07147         ; ------------------------------------------------------------
                      (    forth6809.asm):07148         ; Compile a call to a run-time word followed by a counted string.
                      (    forth6809.asm):07149         ; CSTRCOMP   ( c-addr u -- )
                      (    forth6809.asm):07150         ;    Inputs:
                      (    forth6809.asm):07151         ;        RegD = xt of the run-time word (DOSTR, DOTSTR, DOABORTQUOTE)
                      (    forth6809.asm):07152         ;        c-addr u on the data stack
                      (    forth6809.asm):07153         ;    Outputs:
                      (    forth6809.asm):07154         ;        JSR xt, the count byte and the text compiled at CODEHERE
                      (    forth6809.asm):07155         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):07156         ; ------------------------------------------------------------
F3ED 3606             (    forth6809.asm):07157         CSTRCOMP:   PSHU  D
F3EF BDE97D           (    forth6809.asm):07158                     JSR   CCALL
F3F2 3706             (    forth6809.asm):07159                     PULU  D                 ; u
F3F4 3720             (    forth6809.asm):07160                     PULU  Y                 ; c-addr
F3F6 9E08             (    forth6809.asm):07161                     LDX   CODEHERE
F3F8 E780             (    forth6809.asm):07162                     STB   ,X+
F3FA 5D               (    forth6809.asm):07163                     TSTB
F3FB 2707             (    forth6809.asm):07164                     BEQ   CSEND
F3FD A6A0             (    forth6809.asm):07165         CSCPY:      LDA   ,Y+
F3FF A780             (    forth6809.asm):07166                     STA   ,X+
F401 5A               (    forth6809.asm):07167                     DECB
F402 26F9             (    forth6809.asm):07168                     BNE   CSCPY
F404 9F08             (    forth6809.asm):07169         CSEND:      STX   CODEHERE
F406 39               (    forth6809.asm):07170                     RTS
                      (    forth6809.asm):07171         
                      (    forth6809.asm):07172         ; ------------------------------------------------------------
                      (    forth6809.asm):07173         ; S"  ( "ccc<quote>" -- c-addr u )
                      (    forth6809.asm):07174         ; Parse up to the closing quote (PARSEQUOTE). When compiling, compile
                      (    forth6809.asm):07175         ; DOSTR followed by the counted string. When interpreting, copy the
                      (    forth6809.asm):07176         ; string to PAD and return its address and length. An empty string is
                      (    forth6809.asm):07177         ; valid. See shadow SQUOTEW.3.
                      (    forth6809.asm):07178         ; ------------------------------------------------------------
F407 BDF3D8           (    forth6809.asm):07179         SQUOTEW:    JSR   PARSEQUOTE        ; See bugfix: SQUOTEW.3
F40A DC00             (    forth6809.asm):07180         SQSTATE:    LDD   STATE
F40C 2706             (    forth6809.asm):07181                     BEQ   SQINTERP
F40E CCF3C8           (    forth6809.asm):07182                     LDD   #DOSTR
F411 7EF3ED           (    forth6809.asm):07183                     JMP   CSTRCOMP
                      (    forth6809.asm):07184         
                      (    forth6809.asm):07185                     ; Interpreting: copy the string to PAD. Original comment: shadow
                      (    forth6809.asm):07186                     ; SQUOTEW.2.
F414                  (    forth6809.asm):07187         SQINTERP:
F414 BDDDB9           (    forth6809.asm):07188                     JSR   PADW
F417 3710             (    forth6809.asm):07189                     PULU  X                 ; PAD
F419 3706             (    forth6809.asm):07190                     PULU  D                 ; u
F41B 3720             (    forth6809.asm):07191                     PULU  Y                 ; c-addr
F41D 3610             (    forth6809.asm):07192                     PSHU  X                 ; result c-addr
F41F 3606             (    forth6809.asm):07193                     PSHU  D                 ; result u
F421 5D               (    forth6809.asm):07194                     TSTB
F422 2707             (    forth6809.asm):07195                     BEQ   SQIEND
F424 A6A0             (    forth6809.asm):07196         SQICPY:     LDA   ,Y+
F426 A780             (    forth6809.asm):07197                     STA   ,X+
F428 5A               (    forth6809.asm):07198                     DECB
F429 26F9             (    forth6809.asm):07199                     BNE   SQICPY
F42B 39               (    forth6809.asm):07200         SQIEND:     RTS
                      (    forth6809.asm):07201         
                      (    forth6809.asm):07202         ; ------------------------------------------------------------
                      (    forth6809.asm):07203         ; S\"  ( "ccc<quote>" -- c-addr u )
                      (    forth6809.asm):07204         ; As S", but the text may contain escape sequences introduced by a
                      (    forth6809.asm):07205         ; backslash, and a backslash-quote does not end the string. The
                      (    forth6809.asm):07206         ; translated text is built at PAD and then handled exactly like S" text
                      (    forth6809.asm):07207         ; (SQSTATE). The escapes are: \a 7, \b 8, \e 27, \f 12, \l 10, \m the
                      (    forth6809.asm):07208         ; pair 13 10, \n 10, \q 34, \r 13, \t 9, \v 11, \z 0, \" 34, \\ 92 and
                      (    forth6809.asm):07209         ; \xhh (one or two hex digits). Any other character after a backslash
                      (    forth6809.asm):07210         ; stands for itself. An unterminated string ends at the end of the line.
                      (    forth6809.asm):07211         ; A result over 255 characters throws -18.
                      (    forth6809.asm):07212         ; Frame on S: 0,S input end, 2,S output start, 4,S output pointer.
                      (    forth6809.asm):07213         ; ------------------------------------------------------------
F42C BDDDB9           (    forth6809.asm):07214         SQUOTEESCW: JSR   PADW              ; leaves PAD on the data stack
F42F ECC4             (    forth6809.asm):07215                     LDD   ,U
F431 3406             (    forth6809.asm):07216                     PSHS  D                 ; output pointer

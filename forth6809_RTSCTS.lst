                      (    forth6809.asm):00356         ; Provide padding, to ensure the correct ROM & .bin file size (and
                      (    forth6809.asm):00357         ; opcode offsets) for the MAME emulation and flash memory burn.
                      (    forth6809.asm):00358         ; ------------------------------------------------------------

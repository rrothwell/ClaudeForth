EA62 4F               (    forth6809.asm):05225                     CLRA
EA63 3720             (    forth6809.asm):05226                     PULU  Y                 ; flag
EA65 108C0000         (    forth6809.asm):05227                     CMPY  #0
EA69 2605             (    forth6809.asm):05228                     BNE   AQTHROW
EA6B 3085             (    forth6809.asm):05229                     LEAX  B,X
EA6D 3410             (    forth6809.asm):05230                     PSHS  X

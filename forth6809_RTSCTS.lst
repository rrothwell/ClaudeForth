                      (    forth6809.asm):05791         
                      (    forth6809.asm):05792         ; ------------------------------------------------------------
                      (    forth6809.asm):05793         ; ABS  ( n -- u )
                      (    forth6809.asm):05794         ; Absolute value.
                      (    forth6809.asm):05795         ; ------------------------------------------------------------
EBCC ECC4             (    forth6809.asm):05796         ABSW:       LDD   ,U                ; n

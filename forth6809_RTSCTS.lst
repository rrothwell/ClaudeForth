DE83 3606             (    forth6809.asm):03129                     PSHU  D
DE85 BDE97D           (    forth6809.asm):03130                     JSR   CCALL
DE88 CCDC38           (    forth6809.asm):03131                     LDD   #DOESRT0
DE8B 3606             (    forth6809.asm):03132                     PSHU  D
DE8D BDDCAB           (    forth6809.asm):03133                     JSR   CODECOMMA
DE90 DC0A             (    forth6809.asm):03134                     LDD   VARHERE
DE92 3606             (    forth6809.asm):03135                     PSHU  D
DE94 BDDCAB           (    forth6809.asm):03136                     JSR   CODECOMMA
DE97 CC0000           (    forth6809.asm):03137                     LDD   #0
DE9A 9E0A             (    forth6809.asm):03138                     LDX   VARHERE

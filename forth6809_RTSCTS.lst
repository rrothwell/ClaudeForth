                      (    forth6809.asm):02114         
DA10 F60179           (    forth6809.asm):02115                     LDB   OUTHEAD           ; Is buffer full?
DA13 5C               (    forth6809.asm):02116                     INCB
DA14 C43F             (    forth6809.asm):02117                     ANDB  #OUTBUFSZ-1
DA16 F1017A           (    forth6809.asm):02118                     CMPB  OUTTAIL
DA19 273A             (    forth6809.asm):02119                     BEQ   PUT_EXIT          ; Yes! Exit discarding character.

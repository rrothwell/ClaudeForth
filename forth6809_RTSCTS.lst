                      (    forth6809.asm):10911         
FFE9 20207761726D     (    forth6809.asm):10912         WARMMSG:    FCC   "  warm"
     0006             (    forth6809.asm):10913         WARMMSGL    EQU   *-WARMMSG
                      (    forth6809.asm):10914         
                      (    forth6809.asm):10915                     ; Verify no collision with vectors: INITEND should equal VECTORS.
     FFEF             (    forth6809.asm):10916         INITEND     EQU   *

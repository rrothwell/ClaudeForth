D09B 3406             (    forth6809.asm):02563                     PSHS  D
D09D DC04             (    forth6809.asm):02564                     LDD   LATEST
D09F 3406             (    forth6809.asm):02565                     PSHS  D
                      (    forth6809.asm):02566         
D0A1 CCD4F8           (    forth6809.asm):02567                     LDD   #INTERPRET

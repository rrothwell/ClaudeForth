DF63 BDD661           (    forth6809.asm):05540                     JSR   FINDW
DF66 3706             (    forth6809.asm):05541                     PULU  D
DF68 10830000         (    forth6809.asm):05542                     CMPD  #0
DF6C 260A             (    forth6809.asm):05543                     BNE   XCFOUND
DF6E 3706             (    forth6809.asm):05544                     PULU  D
DF70 CCFFF3           (    forth6809.asm):05545                     LDD   #-13
DF73 3606             (    forth6809.asm):05546                     PSHU  D
DF75 BDDA80           (    forth6809.asm):05547                     JSR   THROWW
DF78 BDDEB8           (    forth6809.asm):05548         XCFOUND:    JSR   COMPILECOMMAW

                      (    forth6809.asm):05492         ; POSTPONE  ( "name" -- )
                      (    forth6809.asm):05493         ; If the name is immediate, compile a call to it now. Otherwise
                      (    forth6809.asm):05494         ; compile its xt as a literal followed by a call to COMPILE, so that
                      (    forth6809.asm):05495         ; it is compiled when the enclosing definition runs. THROW -14 if not
                      (    forth6809.asm):05496         ; compiling, -13 if the name is not found.
                      (    forth6809.asm):05497         ; ------------------------------------------------------------
DF10 DC00             (    forth6809.asm):05498         POSTPONEW:  LDD   STATE
DF12 2608             (    forth6809.asm):05499                     BNE   PPSTOK
DF14 CCFFF2           (    forth6809.asm):05500                     LDD   #-14              ; -14
DF17 3606             (    forth6809.asm):05501                     PSHU  D
DF19 BDDA80           (    forth6809.asm):05502                     JSR   THROWW

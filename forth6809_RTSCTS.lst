                      (    forth6809.asm):05709         ; ------------------------------------------------------------
E00E CCBD00           (    forth6809.asm):05710         DEPTHW:     LDD   #SP0
E011 3440             (    forth6809.asm):05711                     PSHS  U
E013 A3E1             (    forth6809.asm):05712                     SUBD  ,S++
E015 44               (    forth6809.asm):05713                     LSRA
E016 56               (    forth6809.asm):05714                     RORB
E017 3606             (    forth6809.asm):05715                     PSHU  D                 ; +n
E019 39               (    forth6809.asm):05716                     RTS
                      (    forth6809.asm):05717         
                      (    forth6809.asm):05718         ; ------------------------------------------------------------
                      (    forth6809.asm):05719         ; 2DUP  ( x1 x2 -- x1 x2 x1 x2 )

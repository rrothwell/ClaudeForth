E0E0 308B             (    forth6809.asm):03511                     LEAX  D,X
E0E2 AE84             (    forth6809.asm):03512                     LDX   ,X                ; LINK field
E0E4 20C8             (    forth6809.asm):03513                     BRA   FDLOOP
E0E6 3263             (    forth6809.asm):03514         FDRET:      LEAS  3,S
E0E8 39               (    forth6809.asm):03515                     RTS
                      (    forth6809.asm):03516         
                      (    forth6809.asm):03517         ; ------------------------------------------------------------
                      (    forth6809.asm):03518         ; Search every wordlist of the search order, first to last, and then
                      (    forth6809.asm):03519         ; ROOT, for a name.
                      (    forth6809.asm):03520         ; SRCHORD
                      (    forth6809.asm):03521         ;    Inputs:
                      (    forth6809.asm):03522         ;        RegY = address of the name text
                      (    forth6809.asm):03523         ;        RegB = name length
                      (    forth6809.asm):03524         ;    Outputs:
                      (    forth6809.asm):03525         ;        RegX = the matching header, or 0 if there is none
                      (    forth6809.asm):03526         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):03527         ; ------------------------------------------------------------
E0E9 3424             (    forth6809.asm):03528         SRCHORD:    PSHS  Y,B               ; 0,S = length, 1,S = name text
E0EB 8E004B           (    forth6809.asm):03529                     LDX   #ORDER
E0EE 3410             (    forth6809.asm):03530                     PSHS  X                 ; 0,S = next ORDER cell (length is now 2,S)
E0F0 AEE4             (    forth6809.asm):03531         SOLOOP:     LDX   ,S
E0F2 9C49             (    forth6809.asm):03532                     CMPX  ORDEND
E0F4 2415             (    forth6809.asm):03533                     BHS   SOROOT
E0F6 10AE81           (    forth6809.asm):03534                     LDY   ,X++              ; WID
E0F9 AFE4             (    forth6809.asm):03535                     STX   ,S
E0FB AEA4             (    forth6809.asm):03536                     LDX   ,Y                ; newest header of that wordlist
E0FD 10AE63           (    forth6809.asm):03537                     LDY   3,S

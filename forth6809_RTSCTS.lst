                      (    forth6809.asm):07451         ; Run-time part of S". The counted string follows the call: push its
                      (    forth6809.asm):07452         ; address and length and skip over it.
                      (    forth6809.asm):07453         ; DOSTR   ( -- c-addr u )
                      (    forth6809.asm):07454         ;    Inputs:
                      (    forth6809.asm):07455         ;        return address on S points at the count byte
                      (    forth6809.asm):07456         ;    Outputs:
                      (    forth6809.asm):07457         ;        c-addr and u on the data stack; execution resumes after the
                      (    forth6809.asm):07458         ;        string

DE0C 830002           (    forth6809.asm):05301                     SUBD  #2
DE0F 3606             (    forth6809.asm):05302                     PSHU  D                 ; orig
DE11 CCDFE3           (    forth6809.asm):05303                     LDD   #DROPW
DE14 3606             (    forth6809.asm):05304                     PSHU  D
DE16 BDDEBB           (    forth6809.asm):05305                     JSR   CCALL
DE19 CC0005           (    forth6809.asm):05306                     LDD   #TAGOF
DE1C 3606             (    forth6809.asm):05307                     PSHU  D
DE1E 39               (    forth6809.asm):05308                     RTS
                      (    forth6809.asm):05309         
                      (    forth6809.asm):05310         ; ------------------------------------------------------------
                      (    forth6809.asm):05311         ; ENDOF  ( C: orig1 -- orig2 )
                      (    forth6809.asm):05312         ; Compile BRANCH with a placeholder operand, resolve orig1 to just

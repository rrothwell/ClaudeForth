D99B 39               (    forth6809.asm):04596                     RTS
                      (    forth6809.asm):04597         
                      (    forth6809.asm):04598         ; ------------------------------------------------------------
                      (    forth6809.asm):04599         ; ACCEPT  ( c-addr +n1 -- +n2 )
                      (    forth6809.asm):04600         ; Read a line of up to +n1 characters into the buffer at c-addr,

                      (    forth6809.asm):04544         ; ============================================================
                      (    forth6809.asm):04545         ; SECTION 12: CONTROL FLOW (IF/THEN/ELSE, BEGIN family,
                      (    forth6809.asm):04546         ; DO/LOOP/+LOOP/I/J/LEAVE/UNLOOP/?DO, EXIT, CASE family)
                      (    forth6809.asm):04547         ; ============================================================
                      (    forth6809.asm):04548         ; ------------------------------------------------------------
                      (    forth6809.asm):04549         ; Store a branch displacement: the cell at location receives target -
                      (    forth6809.asm):04550         ; location.
                      (    forth6809.asm):04551         ; PATCH   ( target location -- )
                      (    forth6809.asm):04552         ;    Inputs:
                      (    forth6809.asm):04553         ;        target and location on the data stack (location on top)
                      (    forth6809.asm):04554         ;    Outputs:
                      (    forth6809.asm):04555         ;        the cell at location holds target - location
                      (    forth6809.asm):04556         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):04557         ; ------------------------------------------------------------
E577 3710             (    forth6809.asm):04558         PATCH:      PULU  X                 ; location
E579 3706             (    forth6809.asm):04559                     PULU  D                 ; target
E57B 3410             (    forth6809.asm):04560                     PSHS  X
E57D A3E1             (    forth6809.asm):04561                     SUBD  ,S++              ; target - location
E57F ED84             (    forth6809.asm):04562                     STD   ,X
E581 39               (    forth6809.asm):04563                     RTS
                      (    forth6809.asm):04564         
                      (    forth6809.asm):04565         ; ------------------------------------------------------------
                      (    forth6809.asm):04566         ; IF  ( C: -- orig )
                      (    forth6809.asm):04567         ; Compile ZBRANCH with a placeholder operand. Leave the operand
                      (    forth6809.asm):04568         ; address and TAGFWD on the control-flow stack for ELSE or THEN.
                      (    forth6809.asm):04569         ; ------------------------------------------------------------
E582 CCDC0E           (    forth6809.asm):04570         IFW:        LDD   #ZBRANCH
E585 3606             (    forth6809.asm):04571                     PSHU  D
E587 BDE97D           (    forth6809.asm):04572                     JSR   CCALL
E58A CC0000           (    forth6809.asm):04573                     LDD   #0
E58D 3606             (    forth6809.asm):04574                     PSHU  D
E58F BDDCAB           (    forth6809.asm):04575                     JSR   CODECOMMA
E592 DC08             (    forth6809.asm):04576                     LDD   CODEHERE
E594 830002           (    forth6809.asm):04577                     SUBD  #2
E597 3606             (    forth6809.asm):04578                     PSHU  D                 ; orig
E599 CC0001           (    forth6809.asm):04579                     LDD   #TAGFWD
E59C 3606             (    forth6809.asm):04580                     PSHU  D
E59E 39               (    forth6809.asm):04581                     RTS
                      (    forth6809.asm):04582         
                      (    forth6809.asm):04583         ; ------------------------------------------------------------
                      (    forth6809.asm):04584         ; THEN  ( C: orig -- )
                      (    forth6809.asm):04585         ; Resolve the forward branch left by IF, ELSE or WHILE: patch its
                      (    forth6809.asm):04586         ; operand to jump to the current code address.
                      (    forth6809.asm):04587         ; ------------------------------------------------------------
E59F 3706             (    forth6809.asm):04588         THENW:      PULU  D
E5A1 10830001         (    forth6809.asm):04589                     CMPD  #TAGFWD
E5A5 2703             (    forth6809.asm):04590                     BEQ   THOK
E5A7 BDE50D           (    forth6809.asm):04591                     JSR   CFERR
E5AA 3710             (    forth6809.asm):04592         THOK:       PULU  X                 ; orig
E5AC DC08             (    forth6809.asm):04593                     LDD   CODEHERE
E5AE 3606             (    forth6809.asm):04594                     PSHU  D
E5B0 3610             (    forth6809.asm):04595                     PSHU  X
E5B2 BDE577           (    forth6809.asm):04596                     JSR   PATCH
E5B5 39               (    forth6809.asm):04597                     RTS
                      (    forth6809.asm):04598         
                      (    forth6809.asm):04599         ; ------------------------------------------------------------
                      (    forth6809.asm):04600         ; ELSE  ( C: orig1 -- orig2 )
                      (    forth6809.asm):04601         ; Compile BRANCH with a placeholder operand, resolve orig1 to the
                      (    forth6809.asm):04602         ; address just after it, and leave the new operand address and TAGFWD.
                      (    forth6809.asm):04603         ; ------------------------------------------------------------
E5B6 3706             (    forth6809.asm):04604         ELSEW:      PULU  D
E5B8 10830001         (    forth6809.asm):04605                     CMPD  #TAGFWD
E5BC 2703             (    forth6809.asm):04606                     BEQ   ELOK
E5BE BDE50D           (    forth6809.asm):04607                     JSR   CFERR
E5C1 3706             (    forth6809.asm):04608         ELOK:       PULU  D                 ; orig1
E5C3 3406             (    forth6809.asm):04609                     PSHS  D                 ; See bugfix: ELSEW.1 (5k: kept on S)
E5C5 CCDC24           (    forth6809.asm):04610                     LDD   #BRANCH
E5C8 3606             (    forth6809.asm):04611                     PSHU  D
E5CA BDE97D           (    forth6809.asm):04612                     JSR   CCALL
E5CD CC0000           (    forth6809.asm):04613                     LDD   #0
E5D0 3606             (    forth6809.asm):04614                     PSHU  D
E5D2 BDDCAB           (    forth6809.asm):04615                     JSR   CODECOMMA
E5D5 DC08             (    forth6809.asm):04616                     LDD   CODEHERE
E5D7 3606             (    forth6809.asm):04617                     PSHU  D
E5D9 3506             (    forth6809.asm):04618                     PULS  D                 ; orig1
E5DB 3606             (    forth6809.asm):04619                     PSHU  D
E5DD BDE577           (    forth6809.asm):04620                     JSR   PATCH
E5E0 DC08             (    forth6809.asm):04621                     LDD   CODEHERE
E5E2 830002           (    forth6809.asm):04622                     SUBD  #2
E5E5 3606             (    forth6809.asm):04623                     PSHU  D                 ; orig2
E5E7 CC0001           (    forth6809.asm):04624                     LDD   #TAGFWD
E5EA 3606             (    forth6809.asm):04625                     PSHU  D
E5EC 39               (    forth6809.asm):04626                     RTS
                      (    forth6809.asm):04627         
                      (    forth6809.asm):04628         ; ------------------------------------------------------------
                      (    forth6809.asm):04629         ; BEGIN  ( C: -- dest )
                      (    forth6809.asm):04630         ; Leave the current code address and TAGBACK on the control-flow
                      (    forth6809.asm):04631         ; stack.
                      (    forth6809.asm):04632         ; ------------------------------------------------------------
E5ED DC08             (    forth6809.asm):04633         BEGINW:     LDD   CODEHERE
E5EF 3606             (    forth6809.asm):04634                     PSHU  D                 ; dest
E5F1 CC0002           (    forth6809.asm):04635                     LDD   #TAGBACK
E5F4 3606             (    forth6809.asm):04636                     PSHU  D
E5F6 39               (    forth6809.asm):04637                     RTS
                      (    forth6809.asm):04638         
                      (    forth6809.asm):04639         ; ------------------------------------------------------------
                      (    forth6809.asm):04640         ; UNTIL  ( C: dest -- )
                      (    forth6809.asm):04641         ; Compile ZBRANCH with a displacement back to dest.
                      (    forth6809.asm):04642         ; ------------------------------------------------------------
E5F7 3706             (    forth6809.asm):04643         UNTILW:     PULU  D
E5F9 10830002         (    forth6809.asm):04644                     CMPD  #TAGBACK
E5FD 2703             (    forth6809.asm):04645                     BEQ   UNOK
E5FF BDE50D           (    forth6809.asm):04646                     JSR   CFERR
E602 3706             (    forth6809.asm):04647         UNOK:       PULU  D                 ; dest
E604 3606             (    forth6809.asm):04648                     PSHU  D                 ; park dest. See bugfix: UNTILW.1
E606 CCDC0E           (    forth6809.asm):04649                     LDD   #ZBRANCH
E609 3606             (    forth6809.asm):04650                     PSHU  D
E60B BDE97D           (    forth6809.asm):04651                     JSR   CCALL
E60E CC0000           (    forth6809.asm):04652                     LDD   #0
E611 3606             (    forth6809.asm):04653                     PSHU  D
E613 BDDCAB           (    forth6809.asm):04654                     JSR   CODECOMMA
E616 DC08             (    forth6809.asm):04655                     LDD   CODEHERE
E618 830002           (    forth6809.asm):04656                     SUBD  #2
E61B 3606             (    forth6809.asm):04657                     PSHU  D                 ; location; the parked dest is beneath
E61D BDE577           (    forth6809.asm):04658                     JSR   PATCH
E620 39               (    forth6809.asm):04659                     RTS
                      (    forth6809.asm):04660         
                      (    forth6809.asm):04661         ; ------------------------------------------------------------
                      (    forth6809.asm):04662         ; AGAIN  ( C: dest -- )
                      (    forth6809.asm):04663         ; Compile BRANCH with a displacement back to dest.
                      (    forth6809.asm):04664         ; ------------------------------------------------------------
E621 3706             (    forth6809.asm):04665         AGAINW:     PULU  D
E623 10830002         (    forth6809.asm):04666                     CMPD  #TAGBACK
E627 2703             (    forth6809.asm):04667                     BEQ   AGOK
E629 BDE50D           (    forth6809.asm):04668                     JSR   CFERR
E62C 3706             (    forth6809.asm):04669         AGOK:       PULU  D                 ; dest
E62E 3606             (    forth6809.asm):04670                     PSHU  D                 ; park dest. See bugfix: AGAINW.1
E630 CCDC24           (    forth6809.asm):04671                     LDD   #BRANCH
E633 3606             (    forth6809.asm):04672                     PSHU  D
E635 BDE97D           (    forth6809.asm):04673                     JSR   CCALL
E638 CC0000           (    forth6809.asm):04674                     LDD   #0
E63B 3606             (    forth6809.asm):04675                     PSHU  D
E63D BDDCAB           (    forth6809.asm):04676                     JSR   CODECOMMA
E640 DC08             (    forth6809.asm):04677                     LDD   CODEHERE
E642 830002           (    forth6809.asm):04678                     SUBD  #2
E645 3606             (    forth6809.asm):04679                     PSHU  D                 ; location; the parked dest is beneath
E647 BDE577           (    forth6809.asm):04680                     JSR   PATCH
E64A 39               (    forth6809.asm):04681                     RTS
                      (    forth6809.asm):04682         
                      (    forth6809.asm):04683         ; ------------------------------------------------------------
                      (    forth6809.asm):04684         ; WHILE  ( C: dest -- orig dest )
                      (    forth6809.asm):04685         ; Compile ZBRANCH with a placeholder operand. Leave orig (its operand
                      (    forth6809.asm):04686         ; address) and TAGFWD on top of the BEGIN frame.
                      (    forth6809.asm):04687         ; ------------------------------------------------------------
E64B CCDC0E           (    forth6809.asm):04688         WHILEW:     LDD   #ZBRANCH
E64E 3606             (    forth6809.asm):04689                     PSHU  D
E650 BDE97D           (    forth6809.asm):04690                     JSR   CCALL
E653 CC0000           (    forth6809.asm):04691                     LDD   #0
E656 3606             (    forth6809.asm):04692                     PSHU  D
E658 BDDCAB           (    forth6809.asm):04693                     JSR   CODECOMMA
E65B DC08             (    forth6809.asm):04694                     LDD   CODEHERE
E65D 830002           (    forth6809.asm):04695                     SUBD  #2
E660 3606             (    forth6809.asm):04696                     PSHU  D                 ; orig
E662 CC0001           (    forth6809.asm):04697                     LDD   #TAGFWD
E665 3606             (    forth6809.asm):04698                     PSHU  D
E667 39               (    forth6809.asm):04699                     RTS
                      (    forth6809.asm):04700         
                      (    forth6809.asm):04701         ; ------------------------------------------------------------
                      (    forth6809.asm):04702         ; REPEAT  ( C: orig dest -- )
                      (    forth6809.asm):04703         ; Compile BRANCH back to the BEGIN address and resolve the WHILE
                      (    forth6809.asm):04704         ; branch to just after it. A BEGIN frame beneath further open WHILE
                      (    forth6809.asm):04705         ; frames is found by scanning, and removed from beneath them.
                      (    forth6809.asm):04706         ; ------------------------------------------------------------
E668 3706             (    forth6809.asm):04707         REPEATW:    PULU  D
E66A 10830001         (    forth6809.asm):04708                     CMPD  #TAGFWD
E66E 2703             (    forth6809.asm):04709                     BEQ   RPOK1
E670 BDE50D           (    forth6809.asm):04710                     JSR   CFERR
E673 3710             (    forth6809.asm):04711         RPOK1:      PULU  X                 ; orig
E675 3410             (    forth6809.asm):04712                     PSHS  X                 ; 2,S = orig (5k: S-frame)
                      (    forth6809.asm):04713         
                      (    forth6809.asm):04714                     ; Find the BEGIN frame, scanning past any open TAGFWD frames.
                      (    forth6809.asm):04715                     ; See bugfix: REPEATW.1
E677 3040             (    forth6809.asm):04716                     LEAX  0,U               ; scan from top of control stack
E679 9F16             (    forth6809.asm):04717                     STX   MSCR2             ; MSCR2 = base of scan region
E67B 9F1A             (    forth6809.asm):04718                     STX   MSCR4             ; MSCR4 = scan pointer
E67D DC1A             (    forth6809.asm):04719         RPSCAN:     LDD   MSCR4
E67F 109321           (    forth6809.asm):04720                     CMPD  CSP
E682 2603             (    forth6809.asm):04721                     BNE   RPSCANOK
E684 BDE50D           (    forth6809.asm):04722                     JSR   CFERR             ; no matching BEGIN
E687 9E1A             (    forth6809.asm):04723         RPSCANOK:   LDX   MSCR4
E689 EC84             (    forth6809.asm):04724                     LDD   ,X
E68B 10830002         (    forth6809.asm):04725                     CMPD  #TAGBACK
E68F 2712             (    forth6809.asm):04726                     BEQ   RPFOUND
E691 10830001         (    forth6809.asm):04727                     CMPD  #TAGFWD
E695 2703             (    forth6809.asm):04728                     BEQ   RPSKIP
E697 BDE50D           (    forth6809.asm):04729                     JSR   CFERR             ; anything else is a genuine mismatch
E69A DC1A             (    forth6809.asm):04730         RPSKIP:     LDD   MSCR4
E69C C30004           (    forth6809.asm):04731                     ADDD  #4
E69F DD1A             (    forth6809.asm):04732                     STD   MSCR4
E6A1 20DA             (    forth6809.asm):04733                     BRA   RPSCAN
E6A3 9E1A             (    forth6809.asm):04734         RPFOUND:    LDX   MSCR4             ; X = found BEGIN frame
E6A5 EC02             (    forth6809.asm):04735                     LDD   2,X               ; dest = BEGIN's address
E6A7 3406             (    forth6809.asm):04736                     PSHS  D                 ; 0,S = dest
                      (    forth6809.asm):04737         
                      (    forth6809.asm):04738                     ; Close the gap: move the frames above the BEGIN frame down 4
                      (    forth6809.asm):04739                     ; bytes, highest word first.
E6A9 DC1A             (    forth6809.asm):04740                     LDD   MSCR4
E6AB 9316             (    forth6809.asm):04741                     SUBD  MSCR2
E6AD DD18             (    forth6809.asm):04742                     STD   MSCR3             ; MSCR3 = bytes to shift
E6AF 2715             (    forth6809.asm):04743                     BEQ   RPSHIFTDONE
E6B1 DC18             (    forth6809.asm):04744         RPSHIFT:    LDD   MSCR3
E6B3 830002           (    forth6809.asm):04745                     SUBD  #2
E6B6 DD18             (    forth6809.asm):04746                     STD   MSCR3
E6B8 9E16             (    forth6809.asm):04747                     LDX   MSCR2
E6BA 308B             (    forth6809.asm):04748                     LEAX  D,X               ; X = MSCR2 + this pass's offset
E6BC EC84             (    forth6809.asm):04749                     LDD   ,X
E6BE 3004             (    forth6809.asm):04750                     LEAX  4,X
E6C0 ED84             (    forth6809.asm):04751                     STD   ,X                ; copy one word 4 bytes higher
E6C2 DC18             (    forth6809.asm):04752                     LDD   MSCR3
E6C4 26EB             (    forth6809.asm):04753                     BNE   RPSHIFT
E6C6                  (    forth6809.asm):04754         RPSHIFTDONE:
E6C6 9E16             (    forth6809.asm):04755                     LDX   MSCR2
E6C8 3004             (    forth6809.asm):04756                     LEAX  4,X
E6CA 1F13             (    forth6809.asm):04757                     TFR   X,U               ; U now excludes BEGIN frame
                      (    forth6809.asm):04758         
E6CC CCDC24           (    forth6809.asm):04759                     LDD   #BRANCH
E6CF 3606             (    forth6809.asm):04760                     PSHU  D
E6D1 BDE97D           (    forth6809.asm):04761                     JSR   CCALL
E6D4 CC0000           (    forth6809.asm):04762                     LDD   #0
E6D7 3606             (    forth6809.asm):04763                     PSHU  D
E6D9 BDDCAB           (    forth6809.asm):04764                     JSR   CODECOMMA
E6DC EC60             (    forth6809.asm):04765                     LDD   0,S               ; target = BEGIN's address
E6DE 3606             (    forth6809.asm):04766                     PSHU  D
E6E0 DC08             (    forth6809.asm):04767                     LDD   CODEHERE
E6E2 830002           (    forth6809.asm):04768                     SUBD  #2                ; location = the operand just compiled
E6E5 3606             (    forth6809.asm):04769                     PSHU  D
E6E7 BDE577           (    forth6809.asm):04770                     JSR   PATCH
E6EA DC08             (    forth6809.asm):04771                     LDD   CODEHERE
E6EC 3606             (    forth6809.asm):04772                     PSHU  D
E6EE EC62             (    forth6809.asm):04773                     LDD   2,S               ; orig
E6F0 3606             (    forth6809.asm):04774                     PSHU  D
E6F2 BDE577           (    forth6809.asm):04775                     JSR   PATCH
E6F5 3264             (    forth6809.asm):04776                     LEAS  4,S               ; drop the frame
E6F7 39               (    forth6809.asm):04777                     RTS
                      (    forth6809.asm):04778         
                      (    forth6809.asm):04779         ; ------------------------------------------------------------
                      (    forth6809.asm):04780         ; RECURSE  ( -- )
                      (    forth6809.asm):04781         ; Compile a call to the word being defined (named or :NONAME), using
                      (    forth6809.asm):04782         ; the xt held in CURXT.
                      (    forth6809.asm):04783         ; ------------------------------------------------------------
E6F8 DC1F             (    forth6809.asm):04784         RECURSEW:   LDD   CURXT             ; xt of word being compiled
E6FA 3606             (    forth6809.asm):04785                     PSHU  D                 ; See bugfix: RECURSEW.1
E6FC BDE97D           (    forth6809.asm):04786                     JSR   CCALL
E6FF 39               (    forth6809.asm):04787                     RTS
                      (    forth6809.asm):04788         
                      (    forth6809.asm):04789         ; ------------------------------------------------------------
                      (    forth6809.asm):04790         ; DO  ( C: -- dest )
                      (    forth6809.asm):04791         ; Compile a call to DOSETUP and leave the loop start address and TAGDO
                      (    forth6809.asm):04792         ; on the control-flow stack for LOOP or +LOOP.
                      (    forth6809.asm):04793         ; ------------------------------------------------------------
E700 CCE712           (    forth6809.asm):04794         DOW:        LDD   #DOSETUP
E703 3606             (    forth6809.asm):04795                     PSHU  D
E705 BDE97D           (    forth6809.asm):04796                     JSR   CCALL
E708 DC08             (    forth6809.asm):04797                     LDD   CODEHERE
E70A 3606             (    forth6809.asm):04798                     PSHU  D                 ; dest
E70C CC0003           (    forth6809.asm):04799                     LDD   #TAGDO
E70F 3606             (    forth6809.asm):04800                     PSHU  D
E711 39               (    forth6809.asm):04801                     RTS
                      (    forth6809.asm):04802         
                      (    forth6809.asm):04803         ; ------------------------------------------------------------
                      (    forth6809.asm):04804         ; Run-time start of DO and ?DO: build the loop frame on S, beneath the
                      (    forth6809.asm):04805         ; return address.
                      (    forth6809.asm):04806         ; DOSETUP   ( limit index -- )
                      (    forth6809.asm):04807         ;    Inputs:
                      (    forth6809.asm):04808         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):04809         ;    Outputs:
                      (    forth6809.asm):04810         ;        S holds index, limit and a zero leave flag (top first)
                      (    forth6809.asm):04811         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):04812         ; ------------------------------------------------------------
E712 3706             (    forth6809.asm):04813         DOSETUP:    PULU  D                 ; index
E714 DD14             (    forth6809.asm):04814                     STD   MSCR
E716 3706             (    forth6809.asm):04815                     PULU  D                 ; limit
E718 DD16             (    forth6809.asm):04816                     STD   MSCR2
E71A 3510             (    forth6809.asm):04817                     PULS  X
E71C CC0000           (    forth6809.asm):04818                     LDD   #0
E71F 3406             (    forth6809.asm):04819                     PSHS  D
E721 DC16             (    forth6809.asm):04820                     LDD   MSCR2
E723 3406             (    forth6809.asm):04821                     PSHS  D
E725 DC14             (    forth6809.asm):04822                     LDD   MSCR
E727 3406             (    forth6809.asm):04823                     PSHS  D
E729 3410             (    forth6809.asm):04824                     PSHS  X
E72B 39               (    forth6809.asm):04825                     RTS
                      (    forth6809.asm):04826         
                      (    forth6809.asm):04827         ; ------------------------------------------------------------
                      (    forth6809.asm):04828         ; I  ( -- n )
                      (    forth6809.asm):04829         ; Push the index of the innermost loop (2,S, beyond the return
                      (    forth6809.asm):04830         ; address).
                      (    forth6809.asm):04831         ; ------------------------------------------------------------
E72C EC62             (    forth6809.asm):04832         IW:         LDD   2,S               ; n. See bugfix: IW.1
E72E 3606             (    forth6809.asm):04833                     PSHU  D
E730 39               (    forth6809.asm):04834                     RTS
                      (    forth6809.asm):04835         
                      (    forth6809.asm):04836         ; ------------------------------------------------------------
                      (    forth6809.asm):04837         ; J  ( -- n )
                      (    forth6809.asm):04838         ; Push the index of the next outer loop (8,S, beyond the return
                      (    forth6809.asm):04839         ; address and the inner loop frame).
                      (    forth6809.asm):04840         ; ------------------------------------------------------------
E731 EC68             (    forth6809.asm):04841         JW:         LDD   8,S               ; n. See bugfix: JW.1
E733 3606             (    forth6809.asm):04842                     PSHU  D
E735 39               (    forth6809.asm):04843                     RTS
                      (    forth6809.asm):04844         
                      (    forth6809.asm):04845         ; ------------------------------------------------------------
                      (    forth6809.asm):04846         ; LEAVE  ( -- )
                      (    forth6809.asm):04847         ; Set the leave flag in the innermost loop frame. The loop exits at
                      (    forth6809.asm):04848         ; its next LOOP or +LOOP test.
                      (    forth6809.asm):04849         ; ------------------------------------------------------------
E736 CCFFFF           (    forth6809.asm):04850         LEAVEW:     LDD   #TRUEV            ; true
E739 ED66             (    forth6809.asm):04851                     STD   6,S               ; See bugfix: LEAVEW.1
E73B 39               (    forth6809.asm):04852                     RTS
                      (    forth6809.asm):04853         
                      (    forth6809.asm):04854         ; ------------------------------------------------------------
                      (    forth6809.asm):04855         ; LOOP  ( C: dest -- )
                      (    forth6809.asm):04856         ; Compile a call to DOTEST followed by a displacement back to dest.
                      (    forth6809.asm):04857         ; For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):04858         ; ------------------------------------------------------------
E73C 3706             (    forth6809.asm):04859         LOOPW:      PULU  D
E73E 10830003         (    forth6809.asm):04860                     CMPD  #TAGDO
E742 2703             (    forth6809.asm):04861                     BEQ   LOOPOK
E744 BDE50D           (    forth6809.asm):04862                     JSR   CFERR
E747 3706             (    forth6809.asm):04863         LOOPOK:     PULU  D                 ; dest
E749 3606             (    forth6809.asm):04864                     PSHU  D                 ; park dest. See bugfix: LOOPW.1
E74B CCE77B           (    forth6809.asm):04865                     LDD   #DOTEST
E74E 3606             (    forth6809.asm):04866                     PSHU  D
E750 BDE97D           (    forth6809.asm):04867                     JSR   CCALL
E753 CC0000           (    forth6809.asm):04868                     LDD   #0
E756 3606             (    forth6809.asm):04869                     PSHU  D
E758 BDDCAB           (    forth6809.asm):04870                     JSR   CODECOMMA
E75B DC08             (    forth6809.asm):04871                     LDD   CODEHERE
E75D 830002           (    forth6809.asm):04872                     SUBD  #2

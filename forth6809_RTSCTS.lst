CF32 1A50             (    forth6809.asm):02253                     ORCC  #$50              ; Enter Critical Section. Disable IRQ & FIRQ
                      (    forth6809.asm):02254         
CF34 F60179           (    forth6809.asm):02255                     LDB   OUTHEAD           ; Is buffer full?
CF37 5C               (    forth6809.asm):02256                     INCB
CF38 C43F             (    forth6809.asm):02257                     ANDB  #OUTBUFSZ-1
CF3A F1017A           (    forth6809.asm):02258                     CMPB  OUTTAIL
CF3D 273A             (    forth6809.asm):02259                     BEQ   PUT_EXIT          ; Yes! Exit discarding character.
                      (    forth6809.asm):02260         
CF3F 8E01C0           (    forth6809.asm):02261                     LDX   #OUTBUF           ; Put character into character slot.
CF42 F60179           (    forth6809.asm):02262                     LDB   OUTHEAD
CF45 A785             (    forth6809.asm):02263                     STA   B,X               ; Input: RegA = character
                      (    forth6809.asm):02264         
CF47 5C               (    forth6809.asm):02265                     INCB                    ; Update tail pointer to next character slot.
CF48 C43F             (    forth6809.asm):02266                     ANDB  #OUTBUFSZ-1
CF4A F70179           (    forth6809.asm):02267                     STB   OUTHEAD
                      (    forth6809.asm):02268         
CF4D 7D0178           (    forth6809.asm):02269                     TST   RTSSTATE          ; Is RTS currently low (chars still being accepted)?
CF50 2709             (    forth6809.asm):02270                     BEQ   CHK_INT_PATH      ; Yes! Interrupt-driven TX is still available.
                      (    forth6809.asm):02271         
                      (    forth6809.asm):02272                     ; RTS is high so the Tx interrupt is off: drain by polling,
                      (    forth6809.asm):02273                     ; with IRQ and FIRQ unmasked meanwhile. See bugfix: PUTCHAR.1
CF52 1CAF             (    forth6809.asm):02274                     ANDCC #$AF              ; unmask IRQ+FIRQ for the flush only
CF54 BDCF0E           (    forth6809.asm):02275                     JSR   FLUSHOUTBUFFER    ; Fallback to transmit by polling.

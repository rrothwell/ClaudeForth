                      (    forth6809.asm):02452         
D026 5C               (    forth6809.asm):02453                     INCB                    ; Update the tail pointer pointing to the next char.
D027 C43F             (    forth6809.asm):02454                     ANDB  #OUTBUFSZ-1
D029 F7017A           (    forth6809.asm):02455                     STB   OUTTAIL
D02C 3B               (    forth6809.asm):02456         IRQDONE2    RTI
                      (    forth6809.asm):02457         
D02D                  (    forth6809.asm):02458         TXOFF:                              ; The output ring is empty.
                      (    forth6809.asm):02459                     ; Commented-out code moved to shadow: TXOFF.1
D02D 7F017B           (    forth6809.asm):02460                     CLR   OUTACTIVITY
D030 BDCECF           (    forth6809.asm):02461                     JSR   UPDATE_RTS
D033 3B               (    forth6809.asm):02462         IRQDONE3    RTI

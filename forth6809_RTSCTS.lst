                      (    forth6809.asm):05455         ; 2LITERAL  ( x1 x2 -- )  IMMEDIATE
                      (    forth6809.asm):05456         ; Compile two LITs so that x1 x2 are pushed when the definition runs.
                      (    forth6809.asm):05457         ; ------------------------------------------------------------
DED4                  (    forth6809.asm):05458         TWOLITERALW:
DED4 3706             (    forth6809.asm):05459                     PULU  D                 ; x2
DED6 3406             (    forth6809.asm):05460                     PSHS  D
DED8 BDDEC8           (    forth6809.asm):05461                     JSR   LITERALW          ; x1 first, so it lands below x2
DEDB 3506             (    forth6809.asm):05462                     PULS  D

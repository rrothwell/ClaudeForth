                      (    forth6809.asm):08584         ; #  ( ud1 -- ud2 )
                      (    forth6809.asm):08585         ; Divide ud1 by BASE, add the remainder as a digit to the pictured
                      (    forth6809.asm):08586         ; numeric output string, and leave the quotient ud2.
                      (    forth6809.asm):08587         ; ------------------------------------------------------------
EEF5 BDEF0A           (    forth6809.asm):08588         NUMW:       JSR   UDDIGIT           ; ud1 is divided in place on the data stack
EEF8 810A             (    forth6809.asm):08589                     CMPA  #10
EEFA 2504             (    forth6809.asm):08590                     BLO   NDIGIT
EEFC 8B37             (    forth6809.asm):08591                     ADDA  #'A'-10
EEFE 2002             (    forth6809.asm):08592                     BRA   NHOLD
EF00 8B30             (    forth6809.asm):08593         NDIGIT:     ADDA  #'0'
EF02 1F89             (    forth6809.asm):08594         NHOLD:      TFR   A,B

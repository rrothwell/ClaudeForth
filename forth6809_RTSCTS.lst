DF8C                  (    forth6809.asm):03125         BUFFERCOLONW:
DF8C 3706             (    forth6809.asm):03126                     PULU  D                 ; u
DF8E DD16             (    forth6809.asm):03127                     STD   MSCR2
DF90 CC0000           (    forth6809.asm):03128                     LDD   #0
DF93 3606             (    forth6809.asm):03129                     PSHU  D
DF95 BDDDD1           (    forth6809.asm):03130                     JSR   HEADER
DF98 CCDD01           (    forth6809.asm):03131                     LDD   #DODOES
DF9B 3606             (    forth6809.asm):03132                     PSHU  D
DF9D BDE97D           (    forth6809.asm):03133                     JSR   CCALL
DFA0 CCDD0C           (    forth6809.asm):03134                     LDD   #DOESRT0
DFA3 3606             (    forth6809.asm):03135                     PSHU  D
DFA5 BDDD7F           (    forth6809.asm):03136                     JSR   CODECOMMA
DFA8 DC0A             (    forth6809.asm):03137                     LDD   VARHERE
DFAA 3606             (    forth6809.asm):03138                     PSHU  D
DFAC BDDD7F           (    forth6809.asm):03139                     JSR   CODECOMMA
DFAF DC16             (    forth6809.asm):03140                     LDD   MSCR2
DFB1 3606             (    forth6809.asm):03141                     PSHU  D
DFB3 BDDDA6           (    forth6809.asm):03142                     JSR   VALLOTW
DFB6 39               (    forth6809.asm):03143                     RTS
                      (    forth6809.asm):03144         
                      (    forth6809.asm):03145         ; ------------------------------------------------------------
                      (    forth6809.asm):03146         ; DEFER  ( "name" -- )
                      (    forth6809.asm):03147         ; Build a deferred word. Until IS stores an xt in it, executing it
                      (    forth6809.asm):03148         ; throws -21.
                      (    forth6809.asm):03149         ; ------------------------------------------------------------
DFB7 CCDD28           (    forth6809.asm):03150         DEFERW:     LDD   #DODEFER
DFBA BDDE6E           (    forth6809.asm):03151                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
DFBD CCDD30           (    forth6809.asm):03152                     LDD   #DOABORTUNDEF
DFC0 3606             (    forth6809.asm):03153                     PSHU  D
DFC2 BDDD79           (    forth6809.asm):03154                     JSR   COMMAW
DFC5 39               (    forth6809.asm):03155                     RTS
                      (    forth6809.asm):03156         
                      (    forth6809.asm):03157         ; ------------------------------------------------------------
                      (    forth6809.asm):03158         ; DEFER@  ( xt1 -- xt2 )
                      (    forth6809.asm):03159         ; Return the xt currently stored in the deferred word xt1.
                      (    forth6809.asm):03160         ; ------------------------------------------------------------
DFC6                  (    forth6809.asm):03161         DEFERFETCHW:

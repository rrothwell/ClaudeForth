                      (    forth6809.asm):05563         ; ------------------------------------------------------------
                      (    forth6809.asm):05564         ; Run-time part of ABORT". The counted string follows the call. If
                      (    forth6809.asm):05565         ; flag is non-zero, TYPE the string and THROW -2; otherwise skip over
                      (    forth6809.asm):05566         ; the string.
                      (    forth6809.asm):05567         ; DOABORTQUOTE   ( flag -- )
                      (    forth6809.asm):05568         ;    Inputs:
                      (    forth6809.asm):05569         ;        flag on the data stack; return address on S points at the
                      (    forth6809.asm):05570         ;        count byte
                      (    forth6809.asm):05571         ;    Outputs:
                      (    forth6809.asm):05572         ;        execution continues after the string, or THROW -2
                      (    forth6809.asm):05573         ;    Registers: RegA, RegB, RegD, RegX, RegY changed.
                      (    forth6809.asm):05574         ; ------------------------------------------------------------
DF88                  (    forth6809.asm):05575         DOABORTQUOTE:
DF88 3510             (    forth6809.asm):05576                     PULS  X
DF8A E684             (    forth6809.asm):05577                     LDB   ,X
DF8C 3001             (    forth6809.asm):05578                     LEAX  1,X               ; X = text, B = length
DF8E 4F               (    forth6809.asm):05579                     CLRA
DF8F 3720             (    forth6809.asm):05580                     PULU  Y                 ; flag
DF91 108C0000         (    forth6809.asm):05581                     CMPY  #0
DF95 2605             (    forth6809.asm):05582                     BNE   AQTHROW
DF97 3085             (    forth6809.asm):05583                     LEAX  B,X
DF99 3410             (    forth6809.asm):05584                     PSHS  X
DF9B 39               (    forth6809.asm):05585                     RTS
DF9C 3610             (    forth6809.asm):05586         AQTHROW:    PSHU  X
DF9E 3606             (    forth6809.asm):05587                     PSHU  D
DFA0 BDEA75           (    forth6809.asm):05588                     JSR   TYPEW
DFA3 CCFFFE           (    forth6809.asm):05589                     LDD   #-2               ; -2
DFA6 3606             (    forth6809.asm):05590                     PSHU  D
DFA8 7EDA80           (    forth6809.asm):05591                     JMP   THROWW
                      (    forth6809.asm):05592         
                      (    forth6809.asm):05593         ; ------------------------------------------------------------
                      (    forth6809.asm):05594         ; ABORT"  ( "ccc<quote>" -- )
                      (    forth6809.asm):05595         ; Compile DOABORTQUOTE followed by the string up to the closing quote
                      (    forth6809.asm):05596         ; as a counted string. THROW -14 if not compiling.
                      (    forth6809.asm):05597         ; ------------------------------------------------------------
DFAB                  (    forth6809.asm):05598         ABORTQUOTEW:

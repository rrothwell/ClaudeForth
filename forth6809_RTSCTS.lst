                      (    forth6809.asm):05189         ; Run-time start of ?DO. If index equals limit, branch over the whole
                      (    forth6809.asm):05190         ; loop; otherwise build the loop frame as DOSETUP does and skip the
                      (    forth6809.asm):05191         ; branch operand.
                      (    forth6809.asm):05192         ; QDOSETUP   ( limit index -- )
                      (    forth6809.asm):05193         ;    Inputs:
                      (    forth6809.asm):05194         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):05195         ;    Outputs:
                      (    forth6809.asm):05196         ;        loop skipped, or loop frame on S and operand skipped
                      (    forth6809.asm):05197         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):05198         ; ------------------------------------------------------------
DD7E 3706             (    forth6809.asm):05199         QDOSETUP:   PULU  D                 ; index
DD80 DD14             (    forth6809.asm):05200                     STD   MSCR
DD82 3706             (    forth6809.asm):05201                     PULU  D                 ; limit

                      (    forth6809.asm):05807         ; ------------------------------------------------------------
EBD8 3706             (    forth6809.asm):05808         MINW:       PULU  D                 ; n2
EBDA 10A3C4           (    forth6809.asm):05809                     CMPD  ,U

                      (    forth6809.asm):03447         ; MARKER  ( "name" -- )
                      (    forth6809.asm):03448         ; Save DPHERE, CODEHERE, VARHERE, LATEST and the search order state in
                      (    forth6809.asm):03449         ; a new word, which when executed restores them (forgetting everything

                      (    forth6809.asm):04463                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):04464         ; ------------------------------------------------------------
                      (    forth6809.asm):04465         ; KEY  ( -- char )  [polling build, SERIALPOLL=1]
                      (    forth6809.asm):04466         ; Wait for RDRF and return the received character. There are no ring
                      (    forth6809.asm):04467         ; buffers, interrupts or hardware handshaking in this build; ACCEPT
                      (    forth6809.asm):04468         ; uses software XON/XOFF instead. Framing, overrun and parity errors
                      (    forth6809.asm):04469         ; are counted in FECOUNT, OVRNCOUNT and PECOUNT, and POLLREADYCNT
                      (    forth6809.asm):04470         ; counts characters already waiting when KEY was called.
                      (    forth6809.asm):04471         ; Original comment: shadow KEYW.2. KEY?, EMIT, PUTXON and PUTXOFF
                      (    forth6809.asm):04472         ; follow.
                      (    forth6809.asm):04473         ; ------------------------------------------------------------
D963                  (    forth6809.asm):04474         KEYACIA:
                      (    forth6809.asm):04475                     LDA   ACIASR
                      (    forth6809.asm):04476                     BITA  #SR_RDRF
                      (    forth6809.asm):04477                     BEQ   KWAIT
                      (    forth6809.asm):04478                     INC   POLLREADYCNT      ; character was already queued when we
                      (    forth6809.asm):04479                     BRA   KGOTSTAT          ; came back to poll - didn't need to wait
D963                  (    forth6809.asm):04480         KWAIT:
D963                  (    forth6809.asm):04481         KSPIN:      LDA   ACIASR
                      (    forth6809.asm):04482                     BITA  #SR_RDRF
                      (    forth6809.asm):04483                     BEQ   KSPIN
D963                  (    forth6809.asm):04484         KGOTSTAT:                           ; A holds the status byte exactly as it was
                      (    forth6809.asm):04485                                             ; when RDRF first went true - check the
                      (    forth6809.asm):04486                                             ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):04487                                             ; read, since reading ACIADR below clears
                      (    forth6809.asm):04488                                             ; RDRF and the latched error bits together
                      (    forth6809.asm):04489                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):04490                     BEQ   KGETCH
                      (    forth6809.asm):04491                     BITA  #SR_FE
                      (    forth6809.asm):04492                     BEQ   KXFE
                      (    forth6809.asm):04493                     INC   FECOUNT
D963                  (    forth6809.asm):04494         KXFE:       BITA  #SR_OVRN
                      (    forth6809.asm):04495                     BEQ   KXOVRN
                      (    forth6809.asm):04496                     INC   OVRNCOUNT
D963                  (    forth6809.asm):04497         KXOVRN:     BITA  #SR_PE
                      (    forth6809.asm):04498                     BEQ   KGETCH
                      (    forth6809.asm):04499                     INC   PECOUNT
D963                  (    forth6809.asm):04500         KGETCH:     LDA   ACIADR
                      (    forth6809.asm):04501                     TFR   A,B
                      (    forth6809.asm):04502                     CLRA
                      (    forth6809.asm):04503                     PSHU  D                 ; char
                      (    forth6809.asm):04504                     RTS
                      (    forth6809.asm):04505         
                      (    forth6809.asm):04506         ; ------------------------------------------------------------
                      (    forth6809.asm):04507         ; Send the software flow-control character XOFF (PUTXOFF) or XON
                      (    forth6809.asm):04508         ; (PUTXON) straight to the ACIA, waiting for TDRE. The data stack is
                      (    forth6809.asm):04509         ; not touched, so ACCEPT can call these at any point.
                      (    forth6809.asm):04510         ; PUTXON / PUTXOFF
                      (    forth6809.asm):04511         ;    Inputs:
                      (    forth6809.asm):04512         ;        none
                      (    forth6809.asm):04513         ;    Outputs:
                      (    forth6809.asm):04514         ;        XON or XOFF transmitted
                      (    forth6809.asm):04515         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):04516         ; Original comment: shadow PUTXON.0.
                      (    forth6809.asm):04517         ; ------------------------------------------------------------
D963                  (    forth6809.asm):04518         PUTXOFF:    LDA   #XOFFCH
                      (    forth6809.asm):04519                     BRA   PUTXCH
D963                  (    forth6809.asm):04520         PUTXON:     LDA   #XONCH
D963                  (    forth6809.asm):04521         PUTXCH:     PSHS  A
D963                  (    forth6809.asm):04522         PXWT:       LDB   ACIASR
                      (    forth6809.asm):04523                     BITB  #SR_TDRE
                      (    forth6809.asm):04524                     BEQ   PXWT
                      (    forth6809.asm):04525                     PULS  A
                      (    forth6809.asm):04526                     STA   ACIADR
                      (    forth6809.asm):04527                     RTS
                      (    forth6809.asm):04528         
                      (    forth6809.asm):04529         ; ------------------------------------------------------------
                      (    forth6809.asm):04530         ; KEY?  ( -- flag )  [polling build]
                      (    forth6809.asm):04531         ; Return true if the ACIA has a received character (RDRF set).
                      (    forth6809.asm):04532         ; ------------------------------------------------------------
D963                  (    forth6809.asm):04533         KEYQACIA:    LDA   ACIASR
                      (    forth6809.asm):04534                     BITA  #SR_RDRF
                      (    forth6809.asm):04535                     BEQ   KQFALSE
                      (    forth6809.asm):04536                     LDD   #TRUEV
                      (    forth6809.asm):04537                     PSHU  D                 ; flag = true
                      (    forth6809.asm):04538                     RTS
D963                  (    forth6809.asm):04539         KQFALSE:    LDD   #FALSEV
                      (    forth6809.asm):04540                     PSHU  D                 ; flag = false
                      (    forth6809.asm):04541                     RTS
                      (    forth6809.asm):04542         
                      (    forth6809.asm):04543         ; ------------------------------------------------------------
                      (    forth6809.asm):04544         ; EMIT  ( char -- )  [polling build]

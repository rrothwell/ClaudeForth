D4AA 20D7             (    forth6809.asm):03547                     BRA   ILOOP
                      (    forth6809.asm):03548         
D4AC BDD894           (    forth6809.asm):03549         TRYNUM:     JSR   NUMBERQ
D4AF 3706             (    forth6809.asm):03550                     PULU  D
D4B1 10830000         (    forth6809.asm):03551                     CMPD  #0                ; flag (PULU does not set CC)
D4B5 273B             (    forth6809.asm):03552                     BEQ   BADWORD
                      (    forth6809.asm):03553         
D4B7 10830001         (    forth6809.asm):03554                     CMPD  #1                ; 1 = double-number result
D4BB 2711             (    forth6809.asm):03555                     BEQ   TNDOUBLE          ; See shadow: INTERPRET.3
                      (    forth6809.asm):03556         
D4BD DC00             (    forth6809.asm):03557                     LDD   STATE
D4BF 27C2             (    forth6809.asm):03558                     BEQ   ILOOP
D4C1 CCD0B4           (    forth6809.asm):03559                     LDD   #LIT
D4C4 3606             (    forth6809.asm):03560                     PSHU  D
D4C6 BDDE9C           (    forth6809.asm):03561                     JSR   CCALL
D4C9 BDD15A           (    forth6809.asm):03562                     JSR   CODECOMMA
D4CC 20B5             (    forth6809.asm):03563                     BRA   ILOOP
                      (    forth6809.asm):03564         
D4CE                  (    forth6809.asm):03565         TNDOUBLE:                           ; U currently holds [UDLO(bottom), UDHI(top)], matching
                      (    forth6809.asm):03566                                             ; ANS's (ud1) stack order directly.
D4CE DC00             (    forth6809.asm):03567                     LDD   STATE
D4D0 27B1             (    forth6809.asm):03568                     BEQ   ILOOP             ; interpreting: already correctly placed,
                      (    forth6809.asm):03569                                             ; nothing more to do
                      (    forth6809.asm):03570                     ; compiling: need two literals compiled in the order they
                      (    forth6809.asm):03571                     ; must execute at runtime - low first (lands deep), high
                      (    forth6809.asm):03572                     ; second (lands on top). UDHI is currently on top of U, so
                      (    forth6809.asm):03573                     ; pop it aside first, freeing UDLO to be compiled first.
D4D2 3706             (    forth6809.asm):03574                     PULU  D
D4D4 DD1A             (    forth6809.asm):03575                     STD   MSCR4             ; stash UDHI - confirmed safe scratch,
                      (    forth6809.asm):03576                                             ; untouched by CCALL/CODECOMMA
D4D6 CCD0B4           (    forth6809.asm):03577                     LDD   #LIT
D4D9 3606             (    forth6809.asm):03578                     PSHU  D
D4DB BDDE9C           (    forth6809.asm):03579                     JSR   CCALL
D4DE BDD15A           (    forth6809.asm):03580                     JSR   CODECOMMA         ; compiles UDLO (still on U underneath)
D4E1 CCD0B4           (    forth6809.asm):03581                     LDD   #LIT
D4E4 3606             (    forth6809.asm):03582                     PSHU  D
D4E6 BDDE9C           (    forth6809.asm):03583                     JSR   CCALL
D4E9 DC1A             (    forth6809.asm):03584                     LDD   MSCR4

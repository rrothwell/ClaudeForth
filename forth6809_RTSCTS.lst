                      (    forth6809.asm):03929         
E401 ECC4             (    forth6809.asm):03930                     LDD   ,U
E403 263B             (    forth6809.asm):03931                     BNE   NQBADF            ; unconverted characters remain
E405 3344             (    forth6809.asm):03932                     LEAU  4,U               ; drop u and c-addr: ud remains
                      (    forth6809.asm):03933         
                      (    forth6809.asm):03934                     ; Negate the full 32-bit value. See bugfix: NUMBERQ.2
E407 6D62             (    forth6809.asm):03935                     TST   2,S
E409 2718             (    forth6809.asm):03936                     BEQ   NQPOS32
E40B ECC4             (    forth6809.asm):03937                     LDD   ,U
E40D 43               (    forth6809.asm):03938                     COMA
E40E 53               (    forth6809.asm):03939                     COMB
E40F EDC4             (    forth6809.asm):03940                     STD   ,U
E411 EC42             (    forth6809.asm):03941                     LDD   2,U
E413 43               (    forth6809.asm):03942                     COMA
E414 53               (    forth6809.asm):03943                     COMB
E415 C30001           (    forth6809.asm):03944                     ADDD  #1
E418 ED42             (    forth6809.asm):03945                     STD   2,U
E41A 2407             (    forth6809.asm):03946                     BCC   NQPOS32
E41C ECC4             (    forth6809.asm):03947                     LDD   ,U
E41E C30001           (    forth6809.asm):03948                     ADDD  #1
E421 EDC4             (    forth6809.asm):03949                     STD   ,U
                      (    forth6809.asm):03950         
E423                  (    forth6809.asm):03951         NQPOS32:                            ; re-derive from the original c-addr whether the
                      (    forth6809.asm):03952                     ; last character was '.' - determines which return convention
E423 AEE4             (    forth6809.asm):03953                     LDX   ,S
E425 E684             (    forth6809.asm):03954                     LDB   ,X
E427 5A               (    forth6809.asm):03955                     DECB
E428 3001             (    forth6809.asm):03956                     LEAX  1,X
E42A A685             (    forth6809.asm):03957                     LDA   B,X
E42C 3263             (    forth6809.asm):03958                     LEAS  3,S
E42E 812E             (    forth6809.asm):03959                     CMPA  #'.'
E430 2606             (    forth6809.asm):03960                     BNE   NQSINGLE
                      (    forth6809.asm):03961         
                      (    forth6809.asm):03962                     ; DOUBLE success: ud is already low below high; add a
                      (    forth6809.asm):03963                     ; distinct success code (1, not -1) so TRYNUM can tell
                      (    forth6809.asm):03964                     ; single and double apart
E432 CC0001           (    forth6809.asm):03965                     LDD   #1
E435 3606             (    forth6809.asm):03966                     PSHU  D
E437 39               (    forth6809.asm):03967                     RTS
                      (    forth6809.asm):03968         
E438 3342             (    forth6809.asm):03969         NQSINGLE:   LEAU  2,U               ; SINGLE success: drop the high cell
E43A CCFFFF           (    forth6809.asm):03970                     LDD   #-1
E43D 3606             (    forth6809.asm):03971                     PSHU  D
E43F 39               (    forth6809.asm):03972                     RTS
                      (    forth6809.asm):03973         
E440 3348             (    forth6809.asm):03974         NQBADF:     LEAU  8,U               ; drop the frame
E442 AEE4             (    forth6809.asm):03975         NQBAD:      LDX   ,S
E444 3263             (    forth6809.asm):03976                     LEAS  3,S
E446 3610             (    forth6809.asm):03977                     PSHU  X
E448 CC0000           (    forth6809.asm):03978                     LDD   #0

DF51 BDDDD1           (    forth6809.asm):03087                     JSR   HEADER
DF54 CCDD01           (    forth6809.asm):03088                     LDD   #DODOES
DF57 3606             (    forth6809.asm):03089                     PSHU  D
DF59 BDE97D           (    forth6809.asm):03090                     JSR   CCALL
DF5C CCDD0C           (    forth6809.asm):03091                     LDD   #DOESRT0
DF5F 3606             (    forth6809.asm):03092                     PSHU  D
DF61 BDDD7F           (    forth6809.asm):03093                     JSR   CODECOMMA
DF64 DC0A             (    forth6809.asm):03094                     LDD   VARHERE
DF66 3606             (    forth6809.asm):03095                     PSHU  D
DF68 BDDD7F           (    forth6809.asm):03096                     JSR   CODECOMMA
DF6B CC0000           (    forth6809.asm):03097                     LDD   #0
DF6E 9E0A             (    forth6809.asm):03098                     LDX   VARHERE
DF70 ED81             (    forth6809.asm):03099                     STD   ,X++
DF72 ED81             (    forth6809.asm):03100                     STD   ,X++
DF74 9F0A             (    forth6809.asm):03101                     STX   VARHERE
DF76 39               (    forth6809.asm):03102                     RTS
                      (    forth6809.asm):03103         
                      (    forth6809.asm):03104         ; ------------------------------------------------------------
                      (    forth6809.asm):03105         ; 2CONSTANT  ( x1 x2 "name" -- )
                      (    forth6809.asm):03106         ; Build a word that returns x1 x2. The pair is stored in the code area
                      (    forth6809.asm):03107         ; with x2 at the lower address, as 2@ and 2! expect.
                      (    forth6809.asm):03108         ; ------------------------------------------------------------
DF77                  (    forth6809.asm):03109         TWOCONSTANTW:
DF77 CCF350           (    forth6809.asm):03110                     LDD   #TWOFETCHW
DF7A BDDE6E           (    forth6809.asm):03111                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
DF7D 3706             (    forth6809.asm):03112                     PULU  D                 ; x2
DF7F DD14             (    forth6809.asm):03113                     STD   MSCR
DF81 DC14             (    forth6809.asm):03114                     LDD   MSCR
DF83 3606             (    forth6809.asm):03115                     PSHU  D
DF85 BDDD79           (    forth6809.asm):03116                     JSR   COMMAW            ; x2 -> lower address

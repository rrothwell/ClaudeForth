                      (    forth6809.asm):05471         ; ------------------------------------------------------------
DEE3 DC00             (    forth6809.asm):05472         BRACKTICKW: LDD   STATE
DEE5 2608             (    forth6809.asm):05473                     BNE   BTSTOK

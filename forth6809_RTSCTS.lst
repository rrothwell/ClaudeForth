                      (    forth6809.asm):04080         ; ------------------------------------------------------------
                      (    forth6809.asm):04081         ; Convert a counted string to a number in BASE. A leading "-" negates
                      (    forth6809.asm):04082         ; it; a trailing "." makes it a double-cell number.
                      (    forth6809.asm):04083         ; NUMBERQ   ( c-addr -- n -1 | ud 1 | c-addr 0 )
                      (    forth6809.asm):04084         ;    Inputs:
                      (    forth6809.asm):04085         ;        c-addr of the counted string on the data stack
                      (    forth6809.asm):04086         ;    Outputs:
                      (    forth6809.asm):04087         ;        single number: n and -1
                      (    forth6809.asm):04088         ;        double number: ud (low cell below high cell) and 1
                      (    forth6809.asm):04089         ;        not a number: c-addr and 0
                      (    forth6809.asm):04090         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):04091         ; The original c-addr and the negate flag live in an S frame (0,S and
                      (    forth6809.asm):04092         ; 2,S); the count is kept in RegB. See shadow NUMBERQ.1 and
                      (    forth6809.asm):04093         ; NUMBERQ.6.
                      (    forth6809.asm):04094         ; ------------------------------------------------------------
E3CB 3710             (    forth6809.asm):04095         NUMBERQ:    PULU  X                 ; c-addr
E3CD 327D             (    forth6809.asm):04096                     LEAS  -3,S
E3CF AFE4             (    forth6809.asm):04097                     STX   ,S
E3D1 E684             (    forth6809.asm):04098                     LDB   ,X
E3D3 276D             (    forth6809.asm):04099                     BEQ   NQBAD
E3D5 3001             (    forth6809.asm):04100                     LEAX  1,X
                      (    forth6809.asm):04101         

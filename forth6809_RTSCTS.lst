                      (    forth6809.asm):04667         ; COMPILE,  ( xt -- )
                      (    forth6809.asm):04668         ; Compile a call to xt (see CCALL).
                      (    forth6809.asm):04669         ; ------------------------------------------------------------
E999                  (    forth6809.asm):04670         COMPILECOMMAW:
E999 7EE99C           (    forth6809.asm):04671                     JMP   CCALL
                      (    forth6809.asm):04672         
                      (    forth6809.asm):04673         ; ------------------------------------------------------------
                      (    forth6809.asm):04674         ; Append a JSR to xt at the code pointer CODEHERE.
                      (    forth6809.asm):04675         ; CCALL   ( xt -- )
                      (    forth6809.asm):04676         ;    Inputs:
                      (    forth6809.asm):04677         ;        xt on the data stack
                      (    forth6809.asm):04678         ;    Outputs:
                      (    forth6809.asm):04679         ;        JSR xt appended at CODEHERE; CODEHERE advanced by 3
                      (    forth6809.asm):04680         ;    Registers: RegA, RegB, RegD and RegX changed.
                      (    forth6809.asm):04681         ; ------------------------------------------------------------
E99C 9E08             (    forth6809.asm):04682         CCALL:      LDX   CODEHERE          ; X = code pointer
E99E 86BD             (    forth6809.asm):04683                     LDA   #OPJSR            ; JSR opcode

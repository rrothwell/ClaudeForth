D9D1 C108             (    forth6809.asm):04538                     CMPB  #8
D9D3 2724             (    forth6809.asm):04539                     BEQ   ABKSP
D9D5 C17F             (    forth6809.asm):04540                     CMPB  #127
D9D7 2720             (    forth6809.asm):04541                     BEQ   ABKSP
                      (    forth6809.asm):04542         
D9D9 ECC4             (    forth6809.asm):04543                     LDD   ,U
D9DB 10A342           (    forth6809.asm):04544                     CMPD  2,U
D9DE 27E2             (    forth6809.asm):04545                     BEQ   ALOOP
                      (    forth6809.asm):04546         
D9E0 AE44             (    forth6809.asm):04547                     LDX   4,U
D9E2 308B             (    forth6809.asm):04548                     LEAX  D,X
D9E4 1F20             (    forth6809.asm):04549                     TFR   Y,D
D9E6 E784             (    forth6809.asm):04550                     STB   ,X
D9E8 ECC4             (    forth6809.asm):04551                     LDD   ,U
D9EA C30001           (    forth6809.asm):04552                     ADDD  #1
D9ED EDC4             (    forth6809.asm):04553                     STD   ,U
                      (    forth6809.asm):04554         
D9EF 1F20             (    forth6809.asm):04555                     TFR   Y,D
D9F1 4F               (    forth6809.asm):04556                     CLRA
D9F2 3606             (    forth6809.asm):04557                     PSHU  D
D9F4 BDD9B3           (    forth6809.asm):04558                     JSR   EMITW

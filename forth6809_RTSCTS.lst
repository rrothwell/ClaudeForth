DEA0 9F0A             (    forth6809.asm):03141                     STX   VARHERE
DEA2 39               (    forth6809.asm):03142                     RTS
                      (    forth6809.asm):03143         
                      (    forth6809.asm):03144         ; ------------------------------------------------------------
                      (    forth6809.asm):03145         ; 2CONSTANT  ( x1 x2 "name" -- )
                      (    forth6809.asm):03146         ; Build a word that returns x1 x2. The pair is stored in the code area
                      (    forth6809.asm):03147         ; with x2 at the lower address, as 2@ and 2! expect.
                      (    forth6809.asm):03148         ; ------------------------------------------------------------
DEA3                  (    forth6809.asm):03149         TWOCONSTANTW:
DEA3 CCF350           (    forth6809.asm):03150                     LDD   #TWOFETCHW
DEA6 BDDD9A           (    forth6809.asm):03151                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
DEA9 3706             (    forth6809.asm):03152                     PULU  D                 ; x2
DEAB DD14             (    forth6809.asm):03153                     STD   MSCR
DEAD DC14             (    forth6809.asm):03154                     LDD   MSCR
DEAF 3606             (    forth6809.asm):03155                     PSHU  D
DEB1 BDDCA5           (    forth6809.asm):03156                     JSR   COMMAW            ; x2 -> lower address

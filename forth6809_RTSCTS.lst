                      (    forth6809.asm):04798         ; ------------------------------------------------------------
                      (    forth6809.asm):04799         ; >BODY  ( xt -- a-addr )
                      (    forth6809.asm):04800         ; Return the data-field address of a CREATEd word: the cell at xt+5 of
                      (    forth6809.asm):04801         ; its JSR DODOES trampoline.
                      (    forth6809.asm):04802         ; ------------------------------------------------------------
EA5D 3706             (    forth6809.asm):04803         TOBODYW:    PULU  D                 ; xt

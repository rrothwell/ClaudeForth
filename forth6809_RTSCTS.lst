DA2A 39               (    forth6809.asm):04596                     RTS
                      (    forth6809.asm):04597         
                      (    forth6809.asm):04598         ; ------------------------------------------------------------
                      (    forth6809.asm):04599         ; QUERY  ( -- )
                      (    forth6809.asm):04600         ; Read a line into the terminal input buffer and make it the input
                      (    forth6809.asm):04601         ; source: set NTIB and SRCLEN to its length, SRCADDR to TIBBUF, SRCID
                      (    forth6809.asm):04602         ; to 0 and >IN to 0.
                      (    forth6809.asm):04603         ; ------------------------------------------------------------

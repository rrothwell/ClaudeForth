                      (    forth6809.asm):08503         ; ------------------------------------------------------------
                      (    forth6809.asm):08504         ; [IF]  ( flag -- )     [ELSE]  ( -- )     [THEN]  ( -- )
                      (    forth6809.asm):08505         ; Programming-Tools conditional compilation. All three are
                      (    forth6809.asm):08506         ; immediate, so they work while interpreting and while compiling.
                      (    forth6809.asm):08507         ; [IF] with a true flag does nothing. With a false flag, and for
                      (    forth6809.asm):08508         ; [ELSE], the input is skipped word by word, counting nested
                      (    forth6809.asm):08509         ; [IF]s, up to the matching [ELSE] or [THEN]. The three names are
                      (    forth6809.asm):08510         ; matched exactly, as the dictionary matches every name. If the line
                      (    forth6809.asm):08511         ; runs out, the next line is read with REFILL; if no more input is
                      (    forth6809.asm):08512         ; available the skip ends.
                      (    forth6809.asm):08513         ; [THEN] is a marker and does nothing when it is executed.
                      (    forth6809.asm):08514         ; The nesting level is kept at 0,S.
                      (    forth6809.asm):08515         ; ------------------------------------------------------------
FEDE 3706             (    forth6809.asm):08516         BRIFW:      PULU  D
FEE0 10830000         (    forth6809.asm):08517                     CMPD  #0
FEE4 266D             (    forth6809.asm):08518                     BNE   BRTHENW           ; true: nothing to skip
FEE6 CC0001           (    forth6809.asm):08519         BRELSEW:    LDD   #1
FEE9 3406             (    forth6809.asm):08520                     PSHS  D                 ; level
FEEB BDF613           (    forth6809.asm):08521         BRNEXT:     JSR   PARSENAMEW
FEEE 3706             (    forth6809.asm):08522                     PULU  D                 ; length
FEF0 3710             (    forth6809.asm):08523                     PULU  X                 ; address
FEF2 10830000         (    forth6809.asm):08524                     CMPD  #0
FEF6 274E             (    forth6809.asm):08525                     BEQ   BRREFILL
FEF8 10830004         (    forth6809.asm):08526                     CMPD  #4
FEFC 2734             (    forth6809.asm):08527                     BEQ   BR4
FEFE 10830006         (    forth6809.asm):08528                     CMPD  #6
FF02 26E7             (    forth6809.asm):08529                     BNE   BRNEXT
FF04 C606             (    forth6809.asm):08530                     LDB   #6
FF06 108EFF62         (    forth6809.asm):08531                     LDY   #BRSELSE
FF0A 3410             (    forth6809.asm):08532                     PSHS  X
FF0C BDFF54           (    forth6809.asm):08533                     JSR   BRCMP
FF0F 3510             (    forth6809.asm):08534                     PULS  X
FF11 2609             (    forth6809.asm):08535                     BNE   BR6B
FF13 ECE4             (    forth6809.asm):08536                     LDD   ,S                ; [ELSE]: ends the skip at level 1
FF15 830001           (    forth6809.asm):08537                     SUBD  #1
FF18 2737             (    forth6809.asm):08538                     BEQ   BRDONE
FF1A 20CF             (    forth6809.asm):08539                     BRA   BRNEXT
FF1C C606             (    forth6809.asm):08540         BR6B:       LDB   #6
FF1E 108EFF68         (    forth6809.asm):08541                     LDY   #BRSTHEN
FF22 BDFF54           (    forth6809.asm):08542                     JSR   BRCMP
FF25 26C4             (    forth6809.asm):08543                     BNE   BRNEXT
FF27 ECE4             (    forth6809.asm):08544                     LDD   ,S                ; [THEN]: one level less
FF29 830001           (    forth6809.asm):08545                     SUBD  #1
FF2C EDE4             (    forth6809.asm):08546                     STD   ,S
FF2E 2721             (    forth6809.asm):08547                     BEQ   BRDONE
FF30 20B9             (    forth6809.asm):08548                     BRA   BRNEXT
FF32 C604             (    forth6809.asm):08549         BR4:        LDB   #4
FF34 108EFF5E         (    forth6809.asm):08550                     LDY   #BRSIF
FF38 BDFF54           (    forth6809.asm):08551                     JSR   BRCMP
FF3B 26AE             (    forth6809.asm):08552                     BNE   BRNEXT
FF3D ECE4             (    forth6809.asm):08553                     LDD   ,S                ; [IF]: one level more
FF3F C30001           (    forth6809.asm):08554                     ADDD  #1
FF42 EDE4             (    forth6809.asm):08555                     STD   ,S
FF44 20A5             (    forth6809.asm):08556                     BRA   BRNEXT
FF46 BDFBF8           (    forth6809.asm):08557         BRREFILL:   JSR   REFILLW
FF49 3706             (    forth6809.asm):08558                     PULU  D
FF4B 10830000         (    forth6809.asm):08559                     CMPD  #0
FF4F 269A             (    forth6809.asm):08560                     BNE   BRNEXT
FF51 3262             (    forth6809.asm):08561         BRDONE:     LEAS  2,S
FF53 39               (    forth6809.asm):08562         BRTHENW:    RTS
                      (    forth6809.asm):08563         
                      (    forth6809.asm):08564         ; Compare B characters at X with the pattern at Y. Case matters, as it
                      (    forth6809.asm):08565         ; does for every name in this system. Z is set if equal.
FF54 A680             (    forth6809.asm):08566         BRCMP:      LDA   ,X+
FF56 A1A0             (    forth6809.asm):08567                     CMPA  ,Y+
FF58 2603             (    forth6809.asm):08568                     BNE   BRCX
FF5A 5A               (    forth6809.asm):08569                     DECB
FF5B 26F7             (    forth6809.asm):08570                     BNE   BRCMP
FF5D 39               (    forth6809.asm):08571         BRCX:       RTS
                      (    forth6809.asm):08572         
FF5E 5B49465D         (    forth6809.asm):08573         BRSIF:      FCC   "[IF]"
FF62 5B454C53455D     (    forth6809.asm):08574         BRSELSE:    FCC   "[ELSE]"
FF68 5B5448454E5D     (    forth6809.asm):08575         BRSTHEN:    FCC   "[THEN]"
                      (    forth6809.asm):08576         
                      (    forth6809.asm):08577         ; ============================================================
                      (    forth6809.asm):08578         ; SECTION 26: CONSTANT-VALUE WORDS (TRUE, FALSE, 1, -1, 2, -2)
                      (    forth6809.asm):08579         ; ============================================================
                      (    forth6809.asm):08580         ; ------------------------------------------------------------
                      (    forth6809.asm):08581         ; TRUE  ( -- flag )
                      (    forth6809.asm):08582         ; Push true ($FFFF), the value of TRUEV. A direct LDD/PSHU/RTS: no
                      (    forth6809.asm):08583         ; DODOES trampoline and no value cell.
                      (    forth6809.asm):08584         ; Original comment: shadow TRUEW.0.
                      (    forth6809.asm):08585         ; ------------------------------------------------------------
FF6E CCFFFF           (    forth6809.asm):08586         TRUEW:      LDD   #$FFFF
FF71 3606             (    forth6809.asm):08587                     PSHU  D
FF73 39               (    forth6809.asm):08588                     RTS
                      (    forth6809.asm):08589         
                      (    forth6809.asm):08590         ; ------------------------------------------------------------
                      (    forth6809.asm):08591         ; FALSE  ( -- flag )
                      (    forth6809.asm):08592         ; Push false ($0000), the value of FALSEV.
                      (    forth6809.asm):08593         ; ------------------------------------------------------------
FF74 CC0000           (    forth6809.asm):08594         FALSEW:     LDD   #$0000
FF77 3606             (    forth6809.asm):08595                     PSHU  D
FF79 39               (    forth6809.asm):08596                     RTS
                      (    forth6809.asm):08597         
                      (    forth6809.asm):08598         ; ------------------------------------------------------------
                      (    forth6809.asm):08599         ; 1  ( -- 1 )
                      (    forth6809.asm):08600         ; Push the constant 1. The words -1, 2 and -2 below work the same way.
                      (    forth6809.asm):08601         ; Their headers are H_POSONE, H_NEGONE, H_POSTWO and H_NEGTWO (Section
                      (    forth6809.asm):08602         ; 27), since "1" and "-1" are not valid assembler labels.
                      (    forth6809.asm):08603         ; Original comment: shadow POSONEW.0.
                      (    forth6809.asm):08604         ; ------------------------------------------------------------
FF7A CC0001           (    forth6809.asm):08605         POSONEW:    LDD   #1
FF7D 3606             (    forth6809.asm):08606                     PSHU  D
FF7F 39               (    forth6809.asm):08607                     RTS
                      (    forth6809.asm):08608         
                      (    forth6809.asm):08609         ; ------------------------------------------------------------
                      (    forth6809.asm):08610         ; -1  ( -- -1 )
                      (    forth6809.asm):08611         ; Push the constant -1.
                      (    forth6809.asm):08612         ; ------------------------------------------------------------
FF80 CCFFFF           (    forth6809.asm):08613         NEGONEW:    LDD   #-1
FF83 3606             (    forth6809.asm):08614                     PSHU  D
FF85 39               (    forth6809.asm):08615                     RTS
                      (    forth6809.asm):08616         
                      (    forth6809.asm):08617         ; ------------------------------------------------------------
                      (    forth6809.asm):08618         ; 2  ( -- 2 )
                      (    forth6809.asm):08619         ; Push the constant 2.
                      (    forth6809.asm):08620         ; ------------------------------------------------------------
FF86 CC0002           (    forth6809.asm):08621         POSTWOW:    LDD   #2
FF89 3606             (    forth6809.asm):08622                     PSHU  D
FF8B 39               (    forth6809.asm):08623                     RTS
                      (    forth6809.asm):08624         
                      (    forth6809.asm):08625         ; ------------------------------------------------------------
                      (    forth6809.asm):08626         ; -2  ( -- -2 )
                      (    forth6809.asm):08627         ; Push the constant -2.
                      (    forth6809.asm):08628         ; ------------------------------------------------------------
FF8C CCFFFE           (    forth6809.asm):08629         NEGTWOW:    LDD   #-2
FF8F 3606             (    forth6809.asm):08630                     PSHU  D
FF91 39               (    forth6809.asm):08631                     RTS
                      (    forth6809.asm):08632         
                      (    forth6809.asm):08633         ; Verify no collision with init code,
                      (    forth6809.asm):08634         ; value should match ORG INITCODE.
     FF92             (    forth6809.asm):08635         BASECODEEND EQU   *
     23A2             (    forth6809.asm):08636         BASECODESIZE EQU   BASECODEEND-BASECODE
                      (    forth6809.asm):08637         
                      (    forth6809.asm):08638         ; Prevent the assembler from extinguishing the gap between the
                      (    forth6809.asm):08639         ; BASECODE block and the INITCODE block when it generates the
                      (    forth6809.asm):08640         ; .bin file.
FF92                  (    forth6809.asm):08641         BASEND:
FF92 FFFFFFFFFFFFFFFF (    forth6809.asm):08642                     FILL  $FF,INITCODE-BASEND
     FFFFFFFFFFFFFFFF
     FFFF
                      (    forth6809.asm):08643         
                      (    forth6809.asm):08644         ; ============================================================
                      (    forth6809.asm):08645         ; SECTION 2: INIT CODE (COLDSTRT / WARM)
                      (    forth6809.asm):08646         ; ============================================================
                      (    forth6809.asm):08647                     ORG   INITCODE          ; init code block
                      (    forth6809.asm):08648         
                      (    forth6809.asm):08649         ; ------------------------------------------------------------
                      (    forth6809.asm):08650         ; Cold start, entered from the reset vector: mask interrupts, set up
                      (    forth6809.asm):08651         ; the stacks and the direct page, clear GLOBALS, initialise the ACIA,
                      (    forth6809.asm):08652         ; unmask interrupts, run the unit tests if they are built in, then
                      (    forth6809.asm):08653         ; enter COLD.
                      (    forth6809.asm):08654         ; COLDSTRT
                      (    forth6809.asm):08655         ;    Inputs:
                      (    forth6809.asm):08656         ;        hardware reset
                      (    forth6809.asm):08657         ;    Outputs:
                      (    forth6809.asm):08658         ;        does not return
                      (    forth6809.asm):08659         ;    Registers: all registers initialised.
                      (    forth6809.asm):08660         ; ------------------------------------------------------------
FFA4                  (    forth6809.asm):08661         COLDSTRT:
FFA4 1A50             (    forth6809.asm):08662                     ORCC  #$50              ; Disable IRQ & FIRQ
FFA6 10CEC000         (    forth6809.asm):08663                     LDS   #RSTACK+1
FFAA CEBD00           (    forth6809.asm):08664                     LDU   #DSTACK+1
FFAD 4F               (    forth6809.asm):08665                     CLRA
FFAE 1F8B             (    forth6809.asm):08666                     TFR   A,DP
                      (    forth6809.asm):08667         
FFB0 8E0000           (    forth6809.asm):08668                     LDX   #GLOBALS
FFB3 C600             (    forth6809.asm):08669                     LDB   #0
FFB5 6F80             (    forth6809.asm):08670         CLRGLOB:    CLR   ,X+
FFB7 5A               (    forth6809.asm):08671                     DECB
FFB8 26FB             (    forth6809.asm):08672                     BNE   CLRGLOB
                      (    forth6809.asm):08673         
FFBA BDDC0F           (    forth6809.asm):08674                     JSR   INITSERIAL
                      (    forth6809.asm):08675         
FFBD 1CAF             (    forth6809.asm):08676                     ANDCC #$AF              ; Enable IRQ & FIRQ
                      (    forth6809.asm):08677         
                      (    forth6809.asm):08678                     ; IRQ and FIRQ are unmasked above. See bugfix: COLDSTRT.1
                      (    forth6809.asm):08679         
                      (    forth6809.asm):08680                     IFNE  UNITTESTS         ; >>>>>>>>>>
                      (    forth6809.asm):08681                     JSR   TSTRUNNER
                      (    forth6809.asm):08682                     ELSE                    ; <<<<<>>>>>
FFBF 12               (    forth6809.asm):08683                     NOP                     ; same size as JSR TSTRUNNER
FFC0 12               (    forth6809.asm):08684                     NOP                     ; See bugfix: COLDSTRT.2
FFC1 12               (    forth6809.asm):08685                     NOP
                      (    forth6809.asm):08686                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):08687         
FFC2 7EDDB0           (    forth6809.asm):08688                     JMP   COLD
                      (    forth6809.asm):08689         
                      (    forth6809.asm):08690         ; ------------------------------------------------------------
                      (    forth6809.asm):08691         ; Warm start, entered from the NMI vector: mask interrupts, reset the
                      (    forth6809.asm):08692         ; stacks and direct page, re-initialise the ACIA, print the warm-start
                      (    forth6809.asm):08693         ; message, unmask interrupts and ABORT. GLOBALS is not cleared.
                      (    forth6809.asm):08694         ; WARM
                      (    forth6809.asm):08695         ;    Inputs:
                      (    forth6809.asm):08696         ;        NMI
                      (    forth6809.asm):08697         ;    Outputs:
                      (    forth6809.asm):08698         ;        does not return
                      (    forth6809.asm):08699         ;    Registers: all registers initialised.
                      (    forth6809.asm):08700         ; ------------------------------------------------------------
FFC5 1A50             (    forth6809.asm):08701         WARM:       ORCC  #$50              ; Disable IRQ & FIRQ
FFC7 4F               (    forth6809.asm):08702                     CLRA
FFC8 1F8B             (    forth6809.asm):08703                     TFR   A,DP
FFCA CEBD00           (    forth6809.asm):08704                     LDU   #SP0
FFCD 10CEC000         (    forth6809.asm):08705                     LDS   #RP0
                      (    forth6809.asm):08706         
FFD1 BDDC0F           (    forth6809.asm):08707                     JSR   INITSERIAL        ; See bugfix: WARM.1
                      (    forth6809.asm):08708         
FFD4 8EFFE6           (    forth6809.asm):08709                     LDX   #WARMMSG
FFD7 3610             (    forth6809.asm):08710                     PSHU  X
FFD9 CC0006           (    forth6809.asm):08711                     LDD   #WARMMSGL
FFDC 3606             (    forth6809.asm):08712                     PSHU  D
FFDE BDF570           (    forth6809.asm):08713                     JSR   TYPEW
FFE1 1CAF             (    forth6809.asm):08714                     ANDCC #$AF              ; Enable IRQ & FIRQ
FFE3 7EDDEF           (    forth6809.asm):08715                     JMP   ABORT             ; restart the interpreter
                      (    forth6809.asm):08716         
FFE6 20207761726D     (    forth6809.asm):08717         WARMMSG:    FCC   "  warm"
     0006             (    forth6809.asm):08718         WARMMSGL    EQU   *-WARMMSG
                      (    forth6809.asm):08719         
                      (    forth6809.asm):08720                     ; Verify no collision with vectors: INITEND should equal VECTORS.
     FFEC             (    forth6809.asm):08721         INITEND     EQU   *
     0048             (    forth6809.asm):08722         INITSIZE    EQU   INITEND-INITCODE
                      (    forth6809.asm):08723         
                      (    forth6809.asm):08724         ; Prevent the assembler from extinguishing the gap between the

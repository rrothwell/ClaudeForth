D9D7 39               (    forth6809.asm):02042         CHKHIDONE:  RTS
                      (    forth6809.asm):02043         
                      (    forth6809.asm):02044         ; ------------------------------------------------------------
                      (    forth6809.asm):02045         ; If the input ring is near empty and RTS is high, set
                      (    forth6809.asm):02046         ; RTSSTATE to INACCEPT and update the ACIA to raise RTS.
                      (    forth6809.asm):02047         ; Called after a character is removed from the ring.
                      (    forth6809.asm):02048         ; CHKLO
                      (    forth6809.asm):02049         ;    Inputs:
                      (    forth6809.asm):02050         ;        RegB = input ring fill level
                      (    forth6809.asm):02051         ;    Outputs:
                      (    forth6809.asm):02052         ;        RTSSTATE and ACIACR updated if the low-water mark was reached
                      (    forth6809.asm):02053         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02054         ; ------------------------------------------------------------

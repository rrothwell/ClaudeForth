                      (    forth6809.asm):03584         ; ------------------------------------------------------------
                      (    forth6809.asm):03585         ; Throw -11 unless RegX is the address of a wordlist cell in use.
                      (    forth6809.asm):03586         ; WIDCHK
                      (    forth6809.asm):03587         ;    Inputs:
                      (    forth6809.asm):03588         ;        RegX = candidate WID
                      (    forth6809.asm):03589         ;    Outputs:
                      (    forth6809.asm):03590         ;        none if valid (RegX and RegY unchanged); THROW -11 if not
                      (    forth6809.asm):03591         ;    Registers: RegD and CC changed.
                      (    forth6809.asm):03592         ; ------------------------------------------------------------
E24D 1F10             (    forth6809.asm):03593         WIDCHK:     TFR   X,D

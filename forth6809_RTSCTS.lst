E07B EDC4             (    forth6809.asm):05812                     STD   ,U
E07D 39               (    forth6809.asm):05813         ROLLDONE:   RTS
                      (    forth6809.asm):05814         
                      (    forth6809.asm):05815         ; ------------------------------------------------------------
                      (    forth6809.asm):05816         ; 2ROT  ( x1 x2 x3 x4 x5 x6 -- x3 x4 x5 x6 x1 x2 )
                      (    forth6809.asm):05817         ; Rotate the third cell pair to the top. X and Y hold the pair
                      (    forth6809.asm):05818         ; while the others move.
                      (    forth6809.asm):05819         ; ------------------------------------------------------------
E07E AE4A             (    forth6809.asm):05820         DROTW:      LDX   10,U              ; x1
E080 10AE48           (    forth6809.asm):05821                     LDY   8,U               ; x2
E083 EC46             (    forth6809.asm):05822                     LDD   6,U
E085 ED4A             (    forth6809.asm):05823                     STD   10,U
E087 EC44             (    forth6809.asm):05824                     LDD   4,U
E089 ED48             (    forth6809.asm):05825                     STD   8,U
E08B EC42             (    forth6809.asm):05826                     LDD   2,U
E08D ED46             (    forth6809.asm):05827                     STD   6,U

                      (    forth6809.asm):00361         ; ------------------------------------------------------------
                      (    forth6809.asm):00362         ; Optional word sets, to recover ROM when the board does not need
                      (    forth6809.asm):00363         ; them. Each switch removes both the dictionary headers and the code
                      (    forth6809.asm):00364         ; of its words; the headers and code are two contiguous blocks.
                      (    forth6809.asm):00365         ; STRINGSET: String word set: /STRING -TRAILING SEARCH BLANK SLITERAL
                      (    forth6809.asm):00366         ;            and the headers of CMOVE CMOVE> COMPARE (their code is
                      (    forth6809.asm):00367         ;            always kept because MOVE and ENVIRONMENT? use it).
                      (    forth6809.asm):00368         ; STRINGEXT: String extension: UNESCAPE REPLACES CLR-REPLACES
                      (    forth6809.asm):00369         ;            SUBSTITUTE. Set with lwasm -DSTRINGSET=0 -DSTRINGEXT=0.
                      (    forth6809.asm):00370         ; SNAME (xt to name, all wordlists) is not a string word; it is
                      (    forth6809.asm):00371         ; always kept for the disassembler/decompiler.
                      (    forth6809.asm):00372         ; DISASM:    Disassembler words DASM and DIS (about 1.8 KB of ROM). The
                      (    forth6809.asm):00373         ;            constants BASECODE and BASEDICT above depend on it. Set
                      (    forth6809.asm):00374         ;            with lwasm -DDISASM=0. The larger unit test groups do
                      (    forth6809.asm):00375         ;            not fit below the dictionary when DISASM is 1.
                      (    forth6809.asm):00376         ; DECOMP:    Decompiler word SEE (about 0.9 KB more; needs DISASM=1).
                      (    forth6809.asm):00377         ;            Set with lwasm -DDECOMP=0. See SECTION 28.
                      (    forth6809.asm):00378         ; The unit tests need both set to 1.
                      (    forth6809.asm):00379         ; ------------------------------------------------------------
                      (    forth6809.asm):00380                     IFNDEF STRINGSET
     0001             (    forth6809.asm):00381         STRINGSET   SET   1                 ; default if -D not passed
                      (    forth6809.asm):00382                     ENDC
                      (    forth6809.asm):00383                     IFNDEF STRINGEXT
     0001             (    forth6809.asm):00384         STRINGEXT   SET   1                 ; default if -D not passed
                      (    forth6809.asm):00385                     ENDC
                      (    forth6809.asm):00386         
                      (    forth6809.asm):00387                     IFNDEF UNITTESTS
C100                  (    forth6809.asm):00388         UNITTESTS   SET   0                 ; default if -D not passed
                      (    forth6809.asm):00389                     ; Default 0: unit tests excluded; -DUNITTESTS=1 includes them.
                      (    forth6809.asm):00390                     ; Original comment: shadow UNITTESTS.1.
                      (    forth6809.asm):00391                     ENDC
                      (    forth6809.asm):00392         
                      (    forth6809.asm):00393                     IFNDEF TSTSELECTOR
C100                  (    forth6809.asm):00394         TSTSELECTOR SET   2                 ; default if -D not passed
                      (    forth6809.asm):00395                     ENDC
                      (    forth6809.asm):00396         
                      (    forth6809.asm):00397                     IFNE  UNITTESTS         ; >>>>>>>>>>
                      (    forth6809.asm):00398         
                      (    forth6809.asm):00399         ; ------------------------------------------------------------
                      (    forth6809.asm):00400         ; The unit test framework itself (explanatory comment plus all
                      (    forth6809.asm):00401         ; test code) lives in unit_tests.asm, a separate file included
                      (    forth6809.asm):00402         ; here only when UNITTESTS is nonzero - see unit_tests.asm for
                      (    forth6809.asm):00403         ; the full framework description, or OPEN_ITEMS_CHECKLIST_
                      (    forth6809.asm):00404         ; part1.md/part2.md for its own development history.
                      (    forth6809.asm):00405         ; ------------------------------------------------------------
                      (    forth6809.asm):00406                     IFEQ  STRINGSET*STRINGEXT
                      (    forth6809.asm):00407                     ERROR "UNITTESTS=1 needs STRINGSET=1 and STRINGEXT=1"
                      (    forth6809.asm):00408                     ENDC
                      (    forth6809.asm):00409                     INCLUDE unit_tests.asm
                      (    forth6809.asm):00410         
                      (    forth6809.asm):00411                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):00412         
     C100             (    forth6809.asm):00413         TSTEND     EQU *                   ; Mark where tests end to size spare space.
                      (    forth6809.asm):00414         

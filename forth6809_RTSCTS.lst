                      (    forth6809.asm):04250                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):04251         ; ------------------------------------------------------------
                      (    forth6809.asm):04252         ; KEY  ( -- char )  [polling build, SERIALPOLL=1]
                      (    forth6809.asm):04253         ; Wait for RDRF and return the received character. There are no ring
                      (    forth6809.asm):04254         ; buffers, interrupts or hardware handshaking in this build; ACCEPT
                      (    forth6809.asm):04255         ; uses software XON/XOFF instead. Framing, overrun and parity errors
                      (    forth6809.asm):04256         ; are counted in FECOUNT, OVRNCOUNT and PECOUNT, and POLLREADYCNT
                      (    forth6809.asm):04257         ; counts characters already waiting when KEY was called.
                      (    forth6809.asm):04258         ; Original comment: shadow KEYW.2. KEY?, EMIT, PUTXON and PUTXOFF
                      (    forth6809.asm):04259         ; follow.
                      (    forth6809.asm):04260         ; ------------------------------------------------------------
E47D                  (    forth6809.asm):04261         KEYW:
                      (    forth6809.asm):04262                     LDA   ACIASR
                      (    forth6809.asm):04263                     BITA  #SR_RDRF
                      (    forth6809.asm):04264                     BEQ   KWAIT
                      (    forth6809.asm):04265                     INC   POLLREADYCNT      ; character was already queued when we
                      (    forth6809.asm):04266                     BRA   KGOTSTAT          ; came back to poll - didn't need to wait
E47D                  (    forth6809.asm):04267         KWAIT:
E47D                  (    forth6809.asm):04268         KSPIN:      LDA   ACIASR
                      (    forth6809.asm):04269                     BITA  #SR_RDRF
                      (    forth6809.asm):04270                     BEQ   KSPIN
E47D                  (    forth6809.asm):04271         KGOTSTAT:                           ; A holds the status byte exactly as it was
                      (    forth6809.asm):04272                                             ; when RDRF first went true - check the
                      (    forth6809.asm):04273                                             ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):04274                                             ; read, since reading ACIADR below clears
                      (    forth6809.asm):04275                                             ; RDRF and the latched error bits together
                      (    forth6809.asm):04276                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):04277                     BEQ   KGETCH
                      (    forth6809.asm):04278                     BITA  #SR_FE
                      (    forth6809.asm):04279                     BEQ   KXFE
                      (    forth6809.asm):04280                     INC   FECOUNT
E47D                  (    forth6809.asm):04281         KXFE:       BITA  #SR_OVRN
                      (    forth6809.asm):04282                     BEQ   KXOVRN
                      (    forth6809.asm):04283                     INC   OVRNCOUNT
E47D                  (    forth6809.asm):04284         KXOVRN:     BITA  #SR_PE
                      (    forth6809.asm):04285                     BEQ   KGETCH
                      (    forth6809.asm):04286                     INC   PECOUNT
E47D                  (    forth6809.asm):04287         KGETCH:     LDA   ACIADR
                      (    forth6809.asm):04288                     TFR   A,B
                      (    forth6809.asm):04289                     CLRA
                      (    forth6809.asm):04290                     PSHU  D                 ; char
                      (    forth6809.asm):04291                     RTS
                      (    forth6809.asm):04292         
                      (    forth6809.asm):04293         ; ------------------------------------------------------------
                      (    forth6809.asm):04294         ; Send the software flow-control character XOFF (PUTXOFF) or XON
                      (    forth6809.asm):04295         ; (PUTXON) straight to the ACIA, waiting for TDRE. The data stack is
                      (    forth6809.asm):04296         ; not touched, so ACCEPT can call these at any point.
                      (    forth6809.asm):04297         ; PUTXON / PUTXOFF
                      (    forth6809.asm):04298         ;    Inputs:
                      (    forth6809.asm):04299         ;        none
                      (    forth6809.asm):04300         ;    Outputs:
                      (    forth6809.asm):04301         ;        XON or XOFF transmitted
                      (    forth6809.asm):04302         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):04303         ; Original comment: shadow PUTXON.0.
                      (    forth6809.asm):04304         ; ------------------------------------------------------------
E47D                  (    forth6809.asm):04305         PUTXOFF:    LDA   #XOFFCH
                      (    forth6809.asm):04306                     BRA   PUTXCH
E47D                  (    forth6809.asm):04307         PUTXON:     LDA   #XONCH
E47D                  (    forth6809.asm):04308         PUTXCH:     PSHS  A
E47D                  (    forth6809.asm):04309         PXWT:       LDB   ACIASR
                      (    forth6809.asm):04310                     BITB  #SR_TDRE
                      (    forth6809.asm):04311                     BEQ   PXWT
                      (    forth6809.asm):04312                     PULS  A
                      (    forth6809.asm):04313                     STA   ACIADR
                      (    forth6809.asm):04314                     RTS

F54F 39               (    forth6809.asm):06993                     RTS
                      (    forth6809.asm):06994         
                      (    forth6809.asm):06995         ; ------------------------------------------------------------
                      (    forth6809.asm):06996         ; C"  ( "ccc<quote>" -- )  compile: ( -- c-addr ) run-time
                      (    forth6809.asm):06997         ; Compile DOCSTR followed by the string up to the closing quote as a
                      (    forth6809.asm):06998         ; counted string. THROW -14 if not compiling.
                      (    forth6809.asm):06999         ; ------------------------------------------------------------

DD59 CC0003           (    forth6809.asm):05270                     LDD   #TAGDO
DD5C 3606             (    forth6809.asm):05271                     PSHU  D
DD5E 39               (    forth6809.asm):05272                     RTS
                      (    forth6809.asm):05273         
                      (    forth6809.asm):05274         ; ------------------------------------------------------------
                      (    forth6809.asm):05275         ; Run-time start of ?DO. If index equals limit, branch over the whole
                      (    forth6809.asm):05276         ; loop; otherwise build the loop frame as DOSETUP does and skip the
                      (    forth6809.asm):05277         ; branch operand.
                      (    forth6809.asm):05278         ; QDOSETUP   ( limit index -- )
                      (    forth6809.asm):05279         ;    Inputs:
                      (    forth6809.asm):05280         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):05281         ;    Outputs:
                      (    forth6809.asm):05282         ;        loop skipped, or loop frame on S and operand skipped
                      (    forth6809.asm):05283         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):05284         ; ------------------------------------------------------------
DD5F 3706             (    forth6809.asm):05285         QDOSETUP:   PULU  D                 ; index
DD61 DD14             (    forth6809.asm):05286                     STD   MSCR
DD63 3706             (    forth6809.asm):05287                     PULU  D                 ; limit
DD65 DD16             (    forth6809.asm):05288                     STD   MSCR2
DD67 3510             (    forth6809.asm):05289                     PULS  X
DD69 DC16             (    forth6809.asm):05290                     LDD   MSCR2
DD6B 109314           (    forth6809.asm):05291                     CMPD  MSCR
DD6E 2607             (    forth6809.asm):05292                     BNE   QDBUILD
DD70 EC84             (    forth6809.asm):05293                     LDD   ,X
DD72 308B             (    forth6809.asm):05294                     LEAX  D,X
DD74 3410             (    forth6809.asm):05295                     PSHS  X
DD76 39               (    forth6809.asm):05296                     RTS
DD77 3002             (    forth6809.asm):05297         QDBUILD:    LEAX  2,X
DD79 CC0000           (    forth6809.asm):05298                     LDD   #0
DD7C 3406             (    forth6809.asm):05299                     PSHS  D
DD7E DC16             (    forth6809.asm):05300                     LDD   MSCR2
DD80 3406             (    forth6809.asm):05301                     PSHS  D
DD82 DC14             (    forth6809.asm):05302                     LDD   MSCR
DD84 3406             (    forth6809.asm):05303                     PSHS  D
DD86 3410             (    forth6809.asm):05304                     PSHS  X
DD88 39               (    forth6809.asm):05305                     RTS
                      (    forth6809.asm):05306         
                      (    forth6809.asm):05307         ; ------------------------------------------------------------
                      (    forth6809.asm):05308         ; UNLOOP  ( -- )
                      (    forth6809.asm):05309         ; Discard the loop frame (index, limit, leave flag) beneath UNLOOP's
                      (    forth6809.asm):05310         ; return address, so that a following I or J sees the enclosing loop.
                      (    forth6809.asm):05311         ; ------------------------------------------------------------
DD89 3510             (    forth6809.asm):05312         UNLOOPW:    PULS  X
DD8B 3266             (    forth6809.asm):05313                     LEAS  6,S
DD8D 3410             (    forth6809.asm):05314                     PSHS  X
DD8F 39               (    forth6809.asm):05315                     RTS
                      (    forth6809.asm):05316         
                      (    forth6809.asm):05317         ; ------------------------------------------------------------
                      (    forth6809.asm):05318         ; EXIT  ( -- )
                      (    forth6809.asm):05319         ; Compile a call to EXITUNLOOP followed by a count of the DO frames
                      (    forth6809.asm):05320         ; found on the control-flow stack. The count is not used at run time.
                      (    forth6809.asm):05321         ; A loop must be left with UNLOOP before EXIT.
                      (    forth6809.asm):05322         ; ------------------------------------------------------------
DD90 108E0000         (    forth6809.asm):05323         EXITW:      LDY   #0                ; Y = count of DO frames (5k: no scratch)
DD94 1F31             (    forth6809.asm):05324                     TFR   U,X               ; X = scan pointer
DD96 9C21             (    forth6809.asm):05325         EXSCAN:     CMPX  CSP
DD98 270E             (    forth6809.asm):05326                     BEQ   EXSCANDONE
DD9A EC84             (    forth6809.asm):05327                     LDD   ,X
DD9C 10830003         (    forth6809.asm):05328                     CMPD  #TAGDO
DDA0 2602             (    forth6809.asm):05329                     BNE   EXNOTDO
DDA2 3121             (    forth6809.asm):05330                     LEAY  1,Y
DDA4 3004             (    forth6809.asm):05331         EXNOTDO:    LEAX  4,X
DDA6 20EE             (    forth6809.asm):05332                     BRA   EXSCAN
DDA8                  (    forth6809.asm):05333         EXSCANDONE:
DDA8 3420             (    forth6809.asm):05334                     PSHS  Y                 ; the count survives CCALL on S
DDAA CCDDBA           (    forth6809.asm):05335                     LDD   #EXITUNLOOP
DDAD 3606             (    forth6809.asm):05336                     PSHU  D
DDAF BDDE9C           (    forth6809.asm):05337                     JSR   CCALL
DDB2 3506             (    forth6809.asm):05338                     PULS  D
DDB4 3606             (    forth6809.asm):05339                     PSHU  D
DDB6 BDD15A           (    forth6809.asm):05340                     JSR   CODECOMMA
DDB9 39               (    forth6809.asm):05341                     RTS
                      (    forth6809.asm):05342         
                      (    forth6809.asm):05343         ; ------------------------------------------------------------
                      (    forth6809.asm):05344         ; Run-time part of EXIT: drop the address of the inline count, then
                      (    forth6809.asm):05345         ; return from the definition. Loop frames are not discarded.
                      (    forth6809.asm):05346         ; EXITUNLOOP
                      (    forth6809.asm):05347         ;    Inputs:
                      (    forth6809.asm):05348         ;        S holds the address of the inline count, then the return
                      (    forth6809.asm):05349         ;        address
                      (    forth6809.asm):05350         ;    Outputs:
                      (    forth6809.asm):05351         ;        returns to the caller of the definition
                      (    forth6809.asm):05352         ;    Registers: RegX and RegY changed.
                      (    forth6809.asm):05353         ; ------------------------------------------------------------
DDBA 3510             (    forth6809.asm):05354         EXITUNLOOP: PULS  X                 ; See bugfix: EXITUNLOOP.1
DDBC 3520             (    forth6809.asm):05355                     PULS  Y                 ; Y = return address
DDBE 6EA4             (    forth6809.asm):05356                     JMP   ,Y
                      (    forth6809.asm):05357         
                      (    forth6809.asm):05358         ; ------------------------------------------------------------
                      (    forth6809.asm):05359         ; CASE  ( C: -- case-sys )
                      (    forth6809.asm):05360         ; Start a CASE structure. Leave a filler cell and TAGCASE, a 4-byte
                      (    forth6809.asm):05361         ; frame like those of DO and OF, which the EXIT scan relies on.
                      (    forth6809.asm):05362         ; ------------------------------------------------------------
DDC0 CC0000           (    forth6809.asm):05363         CASEW:      LDD   #0                ; filler. See bugfix: CASEW.1
DDC3 3606             (    forth6809.asm):05364                     PSHU  D
DDC5 CC0004           (    forth6809.asm):05365                     LDD   #TAGCASE
DDC8 3606             (    forth6809.asm):05366                     PSHU  D
DDCA 39               (    forth6809.asm):05367                     RTS
                      (    forth6809.asm):05368         
                      (    forth6809.asm):05369         ; ------------------------------------------------------------
                      (    forth6809.asm):05370         ; OF  ( C: -- orig )

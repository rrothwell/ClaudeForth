                      (    forth6809.asm):05412         ; the string.
                      (    forth6809.asm):05413         ; DOABORTQUOTE   ( flag -- )
                      (    forth6809.asm):05414         ;    Inputs:
                      (    forth6809.asm):05415         ;        flag on the data stack; return address on S points at the
                      (    forth6809.asm):05416         ;        count byte

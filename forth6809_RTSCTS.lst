                      (    forth6809.asm):05721         ; ------------------------------------------------------------
E01A EC42             (    forth6809.asm):05722         DDUPW:      LDD   2,U               ; x1
E01C AEC4             (    forth6809.asm):05723                     LDX   ,U                ; x2
E01E 3606             (    forth6809.asm):05724                     PSHU  D
E020 3610             (    forth6809.asm):05725                     PSHU  X
E022 39               (    forth6809.asm):05726                     RTS
                      (    forth6809.asm):05727         
                      (    forth6809.asm):05728         ; ------------------------------------------------------------
                      (    forth6809.asm):05729         ; 2DROP  ( x1 x2 -- )

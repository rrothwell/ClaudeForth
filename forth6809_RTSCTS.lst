DD19 39               (    forth6809.asm):05116         PLOOPDONE:  RTS
                      (    forth6809.asm):05117         
                      (    forth6809.asm):05118         ; ------------------------------------------------------------
                      (    forth6809.asm):05119         ; Run-time end of +LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):05120         ; the back-branch operand. Add the step to the index. If the leave
                      (    forth6809.asm):05121         ; flag is set or the index crossed the limit, discard the loop frame
                      (    forth6809.asm):05122         ; and skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):05123         ; DOPLUSTEST   ( n -- )
                      (    forth6809.asm):05124         ;    Inputs:
                      (    forth6809.asm):05125         ;        step n on the data stack; S as for DOTEST
                      (    forth6809.asm):05126         ;    Outputs:
                      (    forth6809.asm):05127         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):05128         ;    Registers: RegD and RegX changed; MSCR, MSCR2 and MSCR3 used as
                      (    forth6809.asm):05129         ;        scratch.
                      (    forth6809.asm):05130         ; ------------------------------------------------------------
DD1A 3706             (    forth6809.asm):05131         DOPLUSTEST: PULU  D                 ; n = step. See bugfix: DOPLUSTEST.1
DD1C DD14             (    forth6809.asm):05132                     STD   MSCR              ; MSCR = step
DD1E EC66             (    forth6809.asm):05133                     LDD   6,S               ; leave flag. See bugfix: DOPLUSTEST.2
DD20 262D             (    forth6809.asm):05134                     BNE   DPTEXIT           ; set: exit
DD22 EC62             (    forth6809.asm):05135                     LDD   2,S               ; old index
DD24 A364             (    forth6809.asm):05136                     SUBD  4,S               ; old_u = old_index - limit, mod 65536
DD26 DD16             (    forth6809.asm):05137                     STD   MSCR2
DD28 EC62             (    forth6809.asm):05138                     LDD   2,S
DD2A D314             (    forth6809.asm):05139                     ADDD  MSCR              ; new_index = old_index + step
DD2C ED62             (    forth6809.asm):05140                     STD   2,S
DD2E A364             (    forth6809.asm):05141                     SUBD  4,S               ; new_u = new_index - limit, mod 65536
DD30 DD18             (    forth6809.asm):05142                     STD   MSCR3
                      (    forth6809.asm):05143                     ; Crossing test on the unsigned distances old_u and new_u: with a
                      (    forth6809.asm):05144                     ; positive step the limit was crossed if new_u < old_u, with a
                      (    forth6809.asm):05145                     ; negative step if new_u > old_u. See bugfix: DOPLUSTEST.3
DD32 DC14             (    forth6809.asm):05146                     LDD   MSCR              ; reload the step to test its sign
DD34 2B09             (    forth6809.asm):05147                     BMI   DPNEG
DD36 DC18             (    forth6809.asm):05148         DPPOS:      LDD   MSCR3             ; step > 0: crossed if new_u < old_u
DD38 109316           (    forth6809.asm):05149                     CMPD  MSCR2
DD3B 2512             (    forth6809.asm):05150                     BLO   DPTEXIT
DD3D 2007             (    forth6809.asm):05151                     BRA   DPCONT
DD3F DC18             (    forth6809.asm):05152         DPNEG:      LDD   MSCR3             ; step < 0: crossed if new_u > old_u
DD41 109316           (    forth6809.asm):05153                     CMPD  MSCR2
DD44 2209             (    forth6809.asm):05154                     BHI   DPTEXIT
DD46 3510             (    forth6809.asm):05155         DPCONT:     PULS  X                 ; X = branch operand address
DD48 EC84             (    forth6809.asm):05156                     LDD   ,X
DD4A 308B             (    forth6809.asm):05157                     LEAX  D,X
DD4C 3410             (    forth6809.asm):05158                     PSHS  X
DD4E 39               (    forth6809.asm):05159                     RTS
DD4F 3510             (    forth6809.asm):05160         DPTEXIT:    PULS  X
DD51 3002             (    forth6809.asm):05161                     LEAX  2,X               ; skip the branch operand
DD53 3266             (    forth6809.asm):05162                     LEAS  6,S               ; discard the loop frame
DD55 3410             (    forth6809.asm):05163                     PSHS  X
DD57 39               (    forth6809.asm):05164                     RTS
                      (    forth6809.asm):05165         

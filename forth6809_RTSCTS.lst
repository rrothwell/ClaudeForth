                      (    forth6809.asm):07519         ; S"  ( "ccc<quote>" -- c-addr u )
                      (    forth6809.asm):07520         ; Parse up to the closing quote (PARSEQUOTE). When compiling, compile
                      (    forth6809.asm):07521         ; DOSTR followed by the counted string. When interpreting, copy the
                      (    forth6809.asm):07522         ; string to PAD and return its address and length. An empty string is
                      (    forth6809.asm):07523         ; valid. See shadow SQUOTEW.3.
                      (    forth6809.asm):07524         ; ------------------------------------------------------------

E709 DC08             (    forth6809.asm):04185                     LDD   CODEHERE
E70B 3606             (    forth6809.asm):04186                     PSHU  D
E70D EC62             (    forth6809.asm):04187                     LDD   2,S               ; orig
E70F 3606             (    forth6809.asm):04188                     PSHU  D
E711 BDE596           (    forth6809.asm):04189                     JSR   PATCH

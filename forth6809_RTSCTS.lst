E883 3121             (    forth6809.asm):04877                     LEAY  1,Y
E885 3004             (    forth6809.asm):04878         EXNOTDO:    LEAX  4,X
E887 20EE             (    forth6809.asm):04879                     BRA   EXSCAN
E889                  (    forth6809.asm):04880         EXSCANDONE:
E889 3420             (    forth6809.asm):04881                     PSHS  Y                 ; the count survives CCALL on S
E88B CCE89B           (    forth6809.asm):04882                     LDD   #EXITUNLOOP

                      (    forth6809.asm):09053         ; Cold start, entered from the reset vector: mask interrupts, set up
                      (    forth6809.asm):09054         ; the stacks and the direct page, clear GLOBALS, initialise the ACIA,
                      (    forth6809.asm):09055         ; unmask interrupts, run the unit tests if they are built in, then

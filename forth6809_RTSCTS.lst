                      (    forth6809.asm):02545         
                      (    forth6809.asm):02546         ; ------------------------------------------------------------
                      (    forth6809.asm):02547         ; QUIT  ( -- ) ( R: i*x -- )
                      (    forth6809.asm):02548         ; Empty the return stack, set interpretation state, then loop reading
                      (    forth6809.asm):02549         ; a line and interpreting it under CATCH. Errors are reported as
                      (    forth6809.asm):02550         ; "ERROR n"; -1 (ABORT) is silent. Never returns.
                      (    forth6809.asm):02551         ; ------------------------------------------------------------

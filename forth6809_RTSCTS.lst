DE00 3706             (    forth6809.asm):05401         ENDOFW:     PULU  D
DE02 10830005         (    forth6809.asm):05402                     CMPD  #TAGOF
DE06 2703             (    forth6809.asm):05403                     BEQ   EOFOK
DE08 BDDA2C           (    forth6809.asm):05404                     JSR   CFERR
DE0B 3706             (    forth6809.asm):05405         EOFOK:      PULU  D                 ; orig1
DE0D 3406             (    forth6809.asm):05406                     PSHS  D                 ; See bugfix: ENDOFW.1 (5k: kept on S)
DE0F CCD0D3           (    forth6809.asm):05407                     LDD   #BRANCH
DE12 3606             (    forth6809.asm):05408                     PSHU  D
DE14 BDDE9C           (    forth6809.asm):05409                     JSR   CCALL
DE17 CC0000           (    forth6809.asm):05410                     LDD   #0
DE1A 3606             (    forth6809.asm):05411                     PSHU  D

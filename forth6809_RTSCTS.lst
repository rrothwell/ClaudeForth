D8A1 E747             (    forth6809.asm):04175         UM0:        STB   7,U
D8A3 A7E4             (    forth6809.asm):04176                     STA   ,S
D8A5 A646             (    forth6809.asm):04177                     LDA   6,U
D8A7 E661             (    forth6809.asm):04178                     LDB   1,S
D8A9 3D               (    forth6809.asm):04179                     MUL
D8AA EBE4             (    forth6809.asm):04180                     ADDB  ,S
D8AC 2401             (    forth6809.asm):04181                     BCC   UM1
D8AE 4C               (    forth6809.asm):04182                     INCA
D8AF E746             (    forth6809.asm):04183         UM1:        STB   6,U

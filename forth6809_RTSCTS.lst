                      (    forth6809.asm):03606         ; Set the Search-Order state to its initial value: one wordlist
                      (    forth6809.asm):03607         ; (FORTH, holding the ROM dictionary), the search order FORTH, and
                      (    forth6809.asm):03608         ; CURRENT = FORTH.
                      (    forth6809.asm):03609         ; WLINIT
                      (    forth6809.asm):03610         ;    Inputs:
                      (    forth6809.asm):03611         ;        none
                      (    forth6809.asm):03612         ;    Outputs:
                      (    forth6809.asm):03613         ;        WLHEADS(0), WLEND, CURRENT, ORDER, ORDEND set
                      (    forth6809.asm):03614         ;    Registers: RegD and CC changed.
                      (    forth6809.asm):03615         ; ------------------------------------------------------------
E265 CCDA2A           (    forth6809.asm):03616         WLINIT:     LDD   #BASELATEST
E268 DD5B             (    forth6809.asm):03617                     STD   WLHEADS
E26A CC005D           (    forth6809.asm):03618                     LDD   #WLHEADS+2
E26D DD45             (    forth6809.asm):03619                     STD   WLEND

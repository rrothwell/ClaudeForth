                      (    forth6809.asm):07324         
                      (    forth6809.asm):07325         ; ------------------------------------------------------------
                      (    forth6809.asm):07326         ; Parse the text up to the next double quote for S", ." and ABORT".
                      (    forth6809.asm):07327         ; WORD cannot be used: it skips leading delimiters, so an empty string
                      (    forth6809.asm):07328         ; (S" ") ran on to the next quote in the source. PARSE does not skip.
                      (    forth6809.asm):07329         ; PARSEQUOTE
                      (    forth6809.asm):07330         ;    Inputs:
                      (    forth6809.asm):07331         ;        none (parses from >IN)
                      (    forth6809.asm):07332         ;    Outputs:
                      (    forth6809.asm):07333         ;        c-addr u on the data stack: the text in the input buffer.
                      (    forth6809.asm):07334         ;        THROW -18 if the text is longer than 255 characters.
                      (    forth6809.asm):07335         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):07336         ; ------------------------------------------------------------
F3D8 CC0022           (    forth6809.asm):07337         PARSEQUOTE: LDD   #34
F3DB 3606             (    forth6809.asm):07338                     PSHU  D
F3DD BDF5AE           (    forth6809.asm):07339                     JSR   PARSEW

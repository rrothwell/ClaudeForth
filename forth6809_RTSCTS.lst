                      (    forth6809.asm):07403         ; S\"  ( "ccc<quote>" -- c-addr u )
                      (    forth6809.asm):07404         ; As S", but the text may contain escape sequences introduced by a
                      (    forth6809.asm):07405         ; backslash, and a backslash-quote does not end the string. The
                      (    forth6809.asm):07406         ; translated text is built at PAD and then handled exactly like S" text
                      (    forth6809.asm):07407         ; (SQSTATE). The escapes are: \a 7, \b 8, \e 27, \f 12, \l 10, \m the
                      (    forth6809.asm):07408         ; pair 13 10, \n 10, \q 34, \r 13, \t 9, \v 11, \z 0, \" 34, \\ 92 and
                      (    forth6809.asm):07409         ; \xhh (one or two hex digits). Any other character after a backslash
                      (    forth6809.asm):07410         ; stands for itself. An unterminated string ends at the end of the line.
                      (    forth6809.asm):07411         ; A result over 255 characters throws -18.
                      (    forth6809.asm):07412         ; Frame on S: 0,S input end, 2,S output start, 4,S output pointer.
                      (    forth6809.asm):07413         ; ------------------------------------------------------------

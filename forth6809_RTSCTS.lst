E3D8 A685             (    forth6809.asm):04105                     LDA   B,X
E3DA 5C               (    forth6809.asm):04106                     INCB
E3DB 812E             (    forth6809.asm):04107                     CMPA  #'.'
E3DD 2603             (    forth6809.asm):04108                     BNE   NQNOSIGN
E3DF 5A               (    forth6809.asm):04109                     DECB
E3E0 2760             (    forth6809.asm):04110                     BEQ   NQBAD             ; lone "." with nothing before it

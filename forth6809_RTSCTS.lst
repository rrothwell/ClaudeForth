                      (    forth6809.asm):04076         ; AGAIN  ( C: dest -- )
                      (    forth6809.asm):04077         ; Compile BRANCH with a displacement back to dest.
                      (    forth6809.asm):04078         ; ------------------------------------------------------------
E640 3706             (    forth6809.asm):04079         AGAINW:     PULU  D
E642 10830002         (    forth6809.asm):04080                     CMPD  #TAGBACK
E646 2703             (    forth6809.asm):04081                     BEQ   AGOK
E648 BDE52C           (    forth6809.asm):04082                     JSR   CFERR
E64B 3706             (    forth6809.asm):04083         AGOK:       PULU  D                 ; dest
E64D 3606             (    forth6809.asm):04084                     PSHU  D                 ; park dest. See bugfix: AGAINW.1
E64F CCDEB2           (    forth6809.asm):04085                     LDD   #BRANCH
E652 3606             (    forth6809.asm):04086                     PSHU  D
E654 BDE99C           (    forth6809.asm):04087                     JSR   CCALL
E657 CC0000           (    forth6809.asm):04088                     LDD   #0
E65A 3606             (    forth6809.asm):04089                     PSHU  D
E65C BDDF26           (    forth6809.asm):04090                     JSR   CODECOMMA
E65F DC08             (    forth6809.asm):04091                     LDD   CODEHERE
E661 830002           (    forth6809.asm):04092                     SUBD  #2
E664 3606             (    forth6809.asm):04093                     PSHU  D                 ; location; the parked dest is beneath
E666 BDE596           (    forth6809.asm):04094                     JSR   PATCH
E669 39               (    forth6809.asm):04095                     RTS
                      (    forth6809.asm):04096         
                      (    forth6809.asm):04097         ; ------------------------------------------------------------
                      (    forth6809.asm):04098         ; WHILE  ( C: dest -- orig dest )
                      (    forth6809.asm):04099         ; Compile ZBRANCH with a placeholder operand. Leave orig (its operand
                      (    forth6809.asm):04100         ; address) and TAGFWD on top of the BEGIN frame.
                      (    forth6809.asm):04101         ; ------------------------------------------------------------
E66A CCDE9C           (    forth6809.asm):04102         WHILEW:     LDD   #ZBRANCH
E66D 3606             (    forth6809.asm):04103                     PSHU  D
E66F BDE99C           (    forth6809.asm):04104                     JSR   CCALL
E672 CC0000           (    forth6809.asm):04105                     LDD   #0
E675 3606             (    forth6809.asm):04106                     PSHU  D
E677 BDDF26           (    forth6809.asm):04107                     JSR   CODECOMMA
E67A DC08             (    forth6809.asm):04108                     LDD   CODEHERE
E67C 830002           (    forth6809.asm):04109                     SUBD  #2
E67F 3606             (    forth6809.asm):04110                     PSHU  D                 ; orig
E681 CC0001           (    forth6809.asm):04111                     LDD   #TAGFWD
E684 3606             (    forth6809.asm):04112                     PSHU  D
E686 39               (    forth6809.asm):04113                     RTS
                      (    forth6809.asm):04114         
                      (    forth6809.asm):04115         ; ------------------------------------------------------------
                      (    forth6809.asm):04116         ; REPEAT  ( C: orig dest -- )
                      (    forth6809.asm):04117         ; Compile BRANCH back to the BEGIN address and resolve the WHILE
                      (    forth6809.asm):04118         ; branch to just after it. A BEGIN frame beneath further open WHILE
                      (    forth6809.asm):04119         ; frames is found by scanning, and removed from beneath them.
                      (    forth6809.asm):04120         ; ------------------------------------------------------------
E687 3706             (    forth6809.asm):04121         REPEATW:    PULU  D
E689 10830001         (    forth6809.asm):04122                     CMPD  #TAGFWD
E68D 2703             (    forth6809.asm):04123                     BEQ   RPOK1
E68F BDE52C           (    forth6809.asm):04124                     JSR   CFERR
E692 3710             (    forth6809.asm):04125         RPOK1:      PULU  X                 ; orig
E694 3410             (    forth6809.asm):04126                     PSHS  X                 ; 2,S = orig (5k: S-frame)
                      (    forth6809.asm):04127         
                      (    forth6809.asm):04128                     ; Find the BEGIN frame, scanning past any open TAGFWD frames.
                      (    forth6809.asm):04129                     ; See bugfix: REPEATW.1
E696 3040             (    forth6809.asm):04130                     LEAX  0,U               ; scan from top of control stack
E698 9F16             (    forth6809.asm):04131                     STX   MSCR2             ; MSCR2 = base of scan region
E69A 9F1A             (    forth6809.asm):04132                     STX   MSCR4             ; MSCR4 = scan pointer
E69C DC1A             (    forth6809.asm):04133         RPSCAN:     LDD   MSCR4
E69E 109321           (    forth6809.asm):04134                     CMPD  CSP
E6A1 2603             (    forth6809.asm):04135                     BNE   RPSCANOK
E6A3 BDE52C           (    forth6809.asm):04136                     JSR   CFERR             ; no matching BEGIN
E6A6 9E1A             (    forth6809.asm):04137         RPSCANOK:   LDX   MSCR4
E6A8 EC84             (    forth6809.asm):04138                     LDD   ,X
E6AA 10830002         (    forth6809.asm):04139                     CMPD  #TAGBACK
E6AE 2712             (    forth6809.asm):04140                     BEQ   RPFOUND
E6B0 10830001         (    forth6809.asm):04141                     CMPD  #TAGFWD
E6B4 2703             (    forth6809.asm):04142                     BEQ   RPSKIP
E6B6 BDE52C           (    forth6809.asm):04143                     JSR   CFERR             ; anything else is a genuine mismatch
E6B9 DC1A             (    forth6809.asm):04144         RPSKIP:     LDD   MSCR4
E6BB C30004           (    forth6809.asm):04145                     ADDD  #4
E6BE DD1A             (    forth6809.asm):04146                     STD   MSCR4
E6C0 20DA             (    forth6809.asm):04147                     BRA   RPSCAN
E6C2 9E1A             (    forth6809.asm):04148         RPFOUND:    LDX   MSCR4             ; X = found BEGIN frame
E6C4 EC02             (    forth6809.asm):04149                     LDD   2,X               ; dest = BEGIN's address
E6C6 3406             (    forth6809.asm):04150                     PSHS  D                 ; 0,S = dest
                      (    forth6809.asm):04151         
                      (    forth6809.asm):04152                     ; Close the gap: move the frames above the BEGIN frame down 4
                      (    forth6809.asm):04153                     ; bytes, highest word first.
E6C8 DC1A             (    forth6809.asm):04154                     LDD   MSCR4
E6CA 9316             (    forth6809.asm):04155                     SUBD  MSCR2
E6CC DD18             (    forth6809.asm):04156                     STD   MSCR3             ; MSCR3 = bytes to shift
E6CE 2715             (    forth6809.asm):04157                     BEQ   RPSHIFTDONE
E6D0 DC18             (    forth6809.asm):04158         RPSHIFT:    LDD   MSCR3
E6D2 830002           (    forth6809.asm):04159                     SUBD  #2
E6D5 DD18             (    forth6809.asm):04160                     STD   MSCR3
E6D7 9E16             (    forth6809.asm):04161                     LDX   MSCR2
E6D9 308B             (    forth6809.asm):04162                     LEAX  D,X               ; X = MSCR2 + this pass's offset
E6DB EC84             (    forth6809.asm):04163                     LDD   ,X
E6DD 3004             (    forth6809.asm):04164                     LEAX  4,X
E6DF ED84             (    forth6809.asm):04165                     STD   ,X                ; copy one word 4 bytes higher
E6E1 DC18             (    forth6809.asm):04166                     LDD   MSCR3
E6E3 26EB             (    forth6809.asm):04167                     BNE   RPSHIFT
E6E5                  (    forth6809.asm):04168         RPSHIFTDONE:
E6E5 9E16             (    forth6809.asm):04169                     LDX   MSCR2
E6E7 3004             (    forth6809.asm):04170                     LEAX  4,X
E6E9 1F13             (    forth6809.asm):04171                     TFR   X,U               ; U now excludes BEGIN frame
                      (    forth6809.asm):04172         
E6EB CCDEB2           (    forth6809.asm):04173                     LDD   #BRANCH
E6EE 3606             (    forth6809.asm):04174                     PSHU  D
E6F0 BDE99C           (    forth6809.asm):04175                     JSR   CCALL
E6F3 CC0000           (    forth6809.asm):04176                     LDD   #0
E6F6 3606             (    forth6809.asm):04177                     PSHU  D
E6F8 BDDF26           (    forth6809.asm):04178                     JSR   CODECOMMA
E6FB EC60             (    forth6809.asm):04179                     LDD   0,S               ; target = BEGIN's address
E6FD 3606             (    forth6809.asm):04180                     PSHU  D
E6FF DC08             (    forth6809.asm):04181                     LDD   CODEHERE
E701 830002           (    forth6809.asm):04182                     SUBD  #2                ; location = the operand just compiled
E704 3606             (    forth6809.asm):04183                     PSHU  D

                      (    forth6809.asm):03854         ; ------------------------------------------------------------
E299 8E005B           (    forth6809.asm):03855         FORTHW:     LDX   #WLHEADS
E29C 20EB             (    forth6809.asm):03856                     BRA   SETTOP
                      (    forth6809.asm):03857         
                      (    forth6809.asm):03858         ; ------------------------------------------------------------
                      (    forth6809.asm):03859         ; ROOT  ( -- )
                      (    forth6809.asm):03860         ; Replace the first wordlist of the search order with ROOT.
                      (    forth6809.asm):03861         ; ------------------------------------------------------------
E29E 8E005D           (    forth6809.asm):03862         ROOTW:      LDX   #WLHEADS+2
E2A1 20E6             (    forth6809.asm):03863                     BRA   SETTOP
                      (    forth6809.asm):03864         
                      (    forth6809.asm):03865         ; ------------------------------------------------------------
                      (    forth6809.asm):03866         ; PREVIOUS  ( -- )
                      (    forth6809.asm):03867         ; Remove the first wordlist from the search order. Throws -50 if the
                      (    forth6809.asm):03868         ; order is empty.
                      (    forth6809.asm):03869         ; ------------------------------------------------------------

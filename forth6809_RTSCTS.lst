D9C6 C130             (    forth6809.asm):02035                     CMPB  #INHIWATER        ; RegB = fill level. Near full?
D9C8 250D             (    forth6809.asm):02036                     BLO   CHKHIDONE         ; No! Do nothing.
D9CA 7D0178           (    forth6809.asm):02037                     TST   RTSSTATE
D9CD 2608             (    forth6809.asm):02038                     BNE   CHKHIDONE         ; already high - nothing to do
D9CF 86FF             (    forth6809.asm):02039                     LDA   #INREJECT         ; Yes! De-assert RTS.
D9D1 B70178           (    forth6809.asm):02040                     STA   RTSSTATE

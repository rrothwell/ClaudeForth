E05F AE4A             (    forth6809.asm):05906         DROTW:      LDX   10,U              ; x1
E061 10AE48           (    forth6809.asm):05907                     LDY   8,U               ; x2
E064 EC46             (    forth6809.asm):05908                     LDD   6,U
E066 ED4A             (    forth6809.asm):05909                     STD   10,U
E068 EC44             (    forth6809.asm):05910                     LDD   4,U

                      (    forth6809.asm):07011         
                      (    forth6809.asm):07012         ; ------------------------------------------------------------
                      (    forth6809.asm):07013         ; 2!  ( x1 x2 a-addr -- )
                      (    forth6809.asm):07014         ; Store the cell pair: x2 at a-addr and x1 at a-addr+2.
                      (    forth6809.asm):07015         ; ------------------------------------------------------------
F35B 3710             (    forth6809.asm):07016         TWOSTOREW:  PULU  X                 ; a-addr
F35D 3706             (    forth6809.asm):07017                     PULU  D                 ; x2

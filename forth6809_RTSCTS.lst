                      (    forth6809.asm):04865         ; EXIT  ( -- )
                      (    forth6809.asm):04866         ; Compile a call to EXITUNLOOP followed by a count of the DO frames
                      (    forth6809.asm):04867         ; found on the control-flow stack. The count is not used at run time.

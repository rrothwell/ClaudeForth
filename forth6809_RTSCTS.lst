                      (    forth6809.asm):02300         
CF79                  (    forth6809.asm):02301         PUT_EXIT:
CF79 3591             (    forth6809.asm):02302                     PULS  CC,X,PC           ; Leaving the critical section,
                      (    forth6809.asm):02303                                             ; by restoring the CC.
                      (    forth6809.asm):02304         ; ------------------------------------------------------------
                      (    forth6809.asm):02305         ; Fetch the next character from the input ring, if any, and let
                      (    forth6809.asm):02306         ; the flow-control check re-assert RTS when the ring has drained.
                      (    forth6809.asm):02307         ; GETCHAR
                      (    forth6809.asm):02308         ;    Inputs:
                      (    forth6809.asm):02309         ;        none
                      (    forth6809.asm):02310         ;    Outputs:
                      (    forth6809.asm):02311         ;        RegA = next character from the receive buffer
                      (    forth6809.asm):02312         ;        Carry clear = character returned, set = ring empty
                      (    forth6809.asm):02313         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):02314         ; ------------------------------------------------------------
CF7B                  (    forth6809.asm):02315         GETCHAR:
CF7B F60177           (    forth6809.asm):02316                     LDB   INTAIL            ; Is the out buffer populated?
CF7E F10176           (    forth6809.asm):02317                     CMPB  INHEAD
CF81 271D             (    forth6809.asm):02318                     BEQ   GET_NO_CHAR       ; No! Exit.
                      (    forth6809.asm):02319         
CF83 8E0180           (    forth6809.asm):02320                     LDX   #INBUF            ; Pull character from the out buffer.
CF86 A685             (    forth6809.asm):02321                     LDA   B,X               ; Output: RegA = character
                      (    forth6809.asm):02322         
CF88 5C               (    forth6809.asm):02323                     INCB                    ; Update the tail pointer
CF89 C43F             (    forth6809.asm):02324                     ANDB  #INBUFSZ-1        ; to point to the next character.
CF8B F70177           (    forth6809.asm):02325                     STB   INTAIL
                      (    forth6809.asm):02326         
                      (    forth6809.asm):02327                     ; Mask IRQ so the flow-control check cannot race the
                      (    forth6809.asm):02328                     ; receive interrupt. See bugfix: GETCHAR.1
CF8E 1A10             (    forth6809.asm):02329                     ORCC  #$10
CF90 F60176           (    forth6809.asm):02330                     LDB   INHEAD            ; Calculate current fill level fresh -
CF93 F00177           (    forth6809.asm):02331                     SUBB  INTAIL            ; both pointers may have moved since
CF96 C43F             (    forth6809.asm):02332                     ANDB  #INBUFSZ-1        ; the ISR last ran, so (unlike INCHAR)
                      (    forth6809.asm):02333                                             ; there's no already-loaded value here
                      (    forth6809.asm):02334                                             ; worth reusing.
CF98 BDCEFC           (    forth6809.asm):02335                     JSR   CHKLO
CF9B 1CEF             (    forth6809.asm):02336                     ANDCC #$EF
                      (    forth6809.asm):02337         
CF9D 1CFE             (    forth6809.asm):02338                     ANDCC #$FE              ; Carry flag %0 = valid character
CF9F 39               (    forth6809.asm):02339                     RTS
                      (    forth6809.asm):02340         
CFA0                  (    forth6809.asm):02341         GET_NO_CHAR:
CFA0 1A01             (    forth6809.asm):02342                     ORCC  #$01              ; Carry flag %1 = no valid character.
CFA2 39               (    forth6809.asm):02343                     RTS
                      (    forth6809.asm):02344         ; ------------------------------------------------------------
                      (    forth6809.asm):02345         ; Raise RTS (accept input again) once the input ring has drained
                      (    forth6809.asm):02346         ; to INLOWATER or below, re-enabling the Tx interrupt if output is
                      (    forth6809.asm):02347         ; pending. Called from mainline code, so IRQ is masked while it runs.
                      (    forth6809.asm):02348         ; RTSCHECKLO
                      (    forth6809.asm):02349         ;    Inputs:
                      (    forth6809.asm):02350         ;        none
                      (    forth6809.asm):02351         ;    Outputs:
                      (    forth6809.asm):02352         ;        RTSSTATE = 0 and ACIACR rewritten if RTS was high and the ring is low
                      (    forth6809.asm):02353         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):02354         ; Original comment: shadow RTSCHECKLO.0.
                      (    forth6809.asm):02355         ; ------------------------------------------------------------
CFA3                  (    forth6809.asm):02356         RTSCHECKLO:
CFA3 1A10             (    forth6809.asm):02357                     ORCC  #$10              ; mask IRQ for the critical section
                      (    forth6809.asm):02358         
CFA5 BDCEAF           (    forth6809.asm):02359                     JSR   INFILL
CFA8 8110             (    forth6809.asm):02360                     CMPA  #INLOWATER
CFAA 221E             (    forth6809.asm):02361                     BHI   RTSCLODONE
CFAC 7D0178           (    forth6809.asm):02362                     TST   RTSSTATE
CFAF 2719             (    forth6809.asm):02363                     BEQ   RTSCLODONE        ; already low - nothing to do
                      (    forth6809.asm):02364         
                      (    forth6809.asm):02365         
CFB1 7F0178           (    forth6809.asm):02366                     CLR   RTSSTATE          ; Set flag asserting acceptance of chars
                      (    forth6809.asm):02367         
CFB4 F6017A           (    forth6809.asm):02368                     LDB   OUTTAIL           ; Check if chars are available.
CFB7 F10179           (    forth6809.asm):02369                     CMPB  OUTHEAD
CFBA 2707             (    forth6809.asm):02370                     BEQ   RTSCLONOTX        ; No! Just configure the ACIA to accept chars.
                      (    forth6809.asm):02371         
CFBC 86B5             (    forth6809.asm):02372                     LDA   #CR_RXTX          ; Yes! Configure the ACIA to accept chars.
CFBE B7C008           (    forth6809.asm):02373                     STA   ACIACR            ; & to generate transmit slot available interrupts.
CFC1 2005             (    forth6809.asm):02374                     BRA   RTSCLOUNMASK
                      (    forth6809.asm):02375         
CFC3 8695             (    forth6809.asm):02376         RTSCLONOTX: LDA   #CR_RXON          ; Configure the ACIA to accept chars.
CFC5 B7C008           (    forth6809.asm):02377                     STA   ACIACR
                      (    forth6809.asm):02378         
CFC8                  (    forth6809.asm):02379         RTSCLOUNMASK:
CFC8 1CEF             (    forth6809.asm):02380                     ANDCC #$EF
                      (    forth6809.asm):02381         
CFCA 39               (    forth6809.asm):02382         RTSCLODONE: RTS
                      (    forth6809.asm):02383         
                      (    forth6809.asm):02384         ; ------------------------------------------------------------
                      (    forth6809.asm):02385         ; ACIA (6850) interrupt handler (SERIALPOLL=0). Services received
                      (    forth6809.asm):02386         ; characters (into the input ring, counting framing, overrun and
                      (    forth6809.asm):02387         ; parity errors) and transmit-ready (from the output ring), with a
                      (    forth6809.asm):02388         ; single exit point. IRQ is hardware-masked while it runs.
                      (    forth6809.asm):02389         ; IRQH
                      (    forth6809.asm):02390         ;    Inputs:
                      (    forth6809.asm):02391         ;        none (hardware interrupt entry)
                      (    forth6809.asm):02392         ;    Outputs:
                      (    forth6809.asm):02393         ;        none (returns with RTI)
                      (    forth6809.asm):02394         ;    Registers: all registers are saved and restored by the interrupt.
                      (    forth6809.asm):02395         ; Original comment: shadow IRQH.0.
                      (    forth6809.asm):02396         ; ------------------------------------------------------------
CFCB B6C008           (    forth6809.asm):02397         IRQH:       LDA   ACIASR            ; Get the status.
                      (    forth6809.asm):02398         
CFCE 8580             (    forth6809.asm):02399                     BITA  #SR_IRQ           ; Is the ACIA the interrupt source?
CFD0 2708             (    forth6809.asm):02400                     BEQ   IRQDONE0          ; No! Just exit.
CFD2 8501             (    forth6809.asm):02401                     BITA  #SR_RDRF          ; Is an incoming character available?
CFD4 2605             (    forth6809.asm):02402                     BNE   INCHAR
CFD6 8502             (    forth6809.asm):02403                     BITA  #SR_TDRE          ; Is the slot for an outgoing character available?
CFD8 263C             (    forth6809.asm):02404                     BNE   OUTCHAR
                      (    forth6809.asm):02405                                             ; Ignore all other interrupts such as DCD change.
CFDA 3B               (    forth6809.asm):02406         IRQDONE0:   RTI                     ; Single point of exit - re-enables interrupts
                      (    forth6809.asm):02407                                             ; & restores state.
                      (    forth6809.asm):02408         
CFDB                  (    forth6809.asm):02409         INCHAR:
CFDB F6C009           (    forth6809.asm):02410                     LDB   ACIADR            ; Get the char & clear RDRF & error flags.
CFDE 8570             (    forth6809.asm):02411                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):02412                                             ; Any receiver error flagged?
CFE0 2716             (    forth6809.asm):02413                     BEQ   INOK              ; No! - character is good, keep it.
                      (    forth6809.asm):02414         
CFE2 8510             (    forth6809.asm):02415                     BITA  #SR_FE            ; Yes! char is corrupted, discard it.
CFE4 2703             (    forth6809.asm):02416                     BEQ   INXFE             ; Tally each flagged error independently -
CFE6 7C017C           (    forth6809.asm):02417                     INC   FECOUNT           ; more than one bit can be set at once.
CFE9 8520             (    forth6809.asm):02418         INXFE:      BITA  #SR_OVRN
CFEB 2703             (    forth6809.asm):02419                     BEQ   INXOVRN
CFED 7C017D           (    forth6809.asm):02420                     INC   OVRNCOUNT
CFF0 8540             (    forth6809.asm):02421         INXOVRN:    BITA  #SR_PE
CFF2 2703             (    forth6809.asm):02422                     BEQ   INXPE
CFF4 7C017E           (    forth6809.asm):02423                     INC   PECOUNT
CFF7 3B               (    forth6809.asm):02424         INXPE:      RTI
                      (    forth6809.asm):02425         
CFF8 1F98             (    forth6809.asm):02426         INOK:       TFR   B,A               ; Transfer good character from the receiver.
CFFA 8E0180           (    forth6809.asm):02427                     LDX   #INBUF            ; Store it in the empty in buffer slot.
CFFD F60176           (    forth6809.asm):02428                     LDB   INHEAD
D000 A785             (    forth6809.asm):02429                     STA   B,X
D002 5C               (    forth6809.asm):02430                     INCB                    ; Figure out the new head,
D003 C43F             (    forth6809.asm):02431                     ANDB  #INBUFSZ-1        ; pointing to the next the empty in buffer slot.
D005 F10177           (    forth6809.asm):02432                     CMPB  INTAIL            ; Would the new head slot meet the tail?
D008 270B             (    forth6809.asm):02433                     BEQ   IRQDONE1          ; Don't allow it - buffer full, drop the character.
D00A F70176           (    forth6809.asm):02434                     STB   INHEAD            ; New head pointer is OK so store it.
                      (    forth6809.asm):02435                     ; Commented-out code moved to shadow: INCHAR.2
                      (    forth6809.asm):02436                     ; Reuse RegB (the new head) for the fill level.
                      (    forth6809.asm):02437                     ; See shadow: INCHAR.1
D00D F00177           (    forth6809.asm):02438                     SUBB  INTAIL            ; RegB: new head - tail = current fill level.
D010 C43F             (    forth6809.asm):02439                     ANDB  #INBUFSZ-1
D012 BDCEEA           (    forth6809.asm):02440                     JSR   CHKHI             ; Protect the in buffer from overflow.
D015 3B               (    forth6809.asm):02441         IRQDONE1:   RTI
                      (    forth6809.asm):02442         
                      (    forth6809.asm):02443                     ; Commented-out code moved to shadow: OUTCHAR.1
                      (    forth6809.asm):02444         
D016 F6017A           (    forth6809.asm):02445         OUTCHAR:    LDB   OUTTAIL           ; Is the out buffer empty?
D019 F10179           (    forth6809.asm):02446                     CMPB  OUTHEAD
D01C 270F             (    forth6809.asm):02447                     BEQ   TXOFF             ; Yes! Stop transmitting.
                      (    forth6809.asm):02448         
D01E 8E01C0           (    forth6809.asm):02449                     LDX   #OUTBUF           ; No! The out buffer is occupied.
D021 A685             (    forth6809.asm):02450                     LDA   B,X               ; Get the character from the out buffer.

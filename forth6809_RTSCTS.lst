D8E2 200C             (    forth6809.asm):04227                     BRA   NLGOT
D8E4 84DF             (    forth6809.asm):04228         NLALPHA:    ANDA  #$DF
D8E6 8141             (    forth6809.asm):04229                     CMPA  #'A'
D8E8 251E             (    forth6809.asm):04230                     BLO   NLDONE
D8EA 815A             (    forth6809.asm):04231                     CMPA  #'Z'
D8EC 221A             (    forth6809.asm):04232                     BHI   NLDONE
D8EE 8037             (    forth6809.asm):04233                     SUBA  #'A'-10
D8F0 9103             (    forth6809.asm):04234         NLGOT:      CMPA  BASE+1
D8F2 2414             (    forth6809.asm):04235                     BHS   NLDONE
D8F4 1F89             (    forth6809.asm):04236                     TFR   A,B
D8F6 BDD88F           (    forth6809.asm):04237                     JSR   UDMULADD
D8F9 AE42             (    forth6809.asm):04238                     LDX   2,U
D8FB 3001             (    forth6809.asm):04239                     LEAX  1,X
D8FD AF42             (    forth6809.asm):04240                     STX   2,U
D8FF ECC4             (    forth6809.asm):04241                     LDD   ,U
D901 830001           (    forth6809.asm):04242                     SUBD  #1
D904 EDC4             (    forth6809.asm):04243                     STD   ,U
D906 20C8             (    forth6809.asm):04244                     BRA   NUMLOOP
D908 39               (    forth6809.asm):04245         NLDONE:     RTS
                      (    forth6809.asm):04246         
                      (    forth6809.asm):04247         ; ------------------------------------------------------------
                      (    forth6809.asm):04248         ; Convert a counted string to a number in BASE. A leading "-" negates
                      (    forth6809.asm):04249         ; it; a trailing "." makes it a double-cell number.
                      (    forth6809.asm):04250         ; NUMBERQ   ( c-addr -- n -1 | ud 1 | c-addr 0 )
                      (    forth6809.asm):04251         ;    Inputs:
                      (    forth6809.asm):04252         ;        c-addr of the counted string on the data stack
                      (    forth6809.asm):04253         ;    Outputs:
                      (    forth6809.asm):04254         ;        single number: n and -1
                      (    forth6809.asm):04255         ;        double number: ud (low cell below high cell) and 1
                      (    forth6809.asm):04256         ;        not a number: c-addr and 0
                      (    forth6809.asm):04257         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):04258         ; The original c-addr and the negate flag live in an S frame (0,S and
                      (    forth6809.asm):04259         ; 2,S); the count is kept in RegB. See shadow NUMBERQ.1 and
                      (    forth6809.asm):04260         ; NUMBERQ.6.
                      (    forth6809.asm):04261         ; ------------------------------------------------------------
D909 3710             (    forth6809.asm):04262         NUMBERQ:    PULU  X                 ; c-addr

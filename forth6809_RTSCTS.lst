                      (    forth6809.asm):03639         ; ------------------------------------------------------------
                      (    forth6809.asm):03640         ; Search one chain of headers for a name, ignoring smudged entries.
                      (    forth6809.asm):03641         ; Case matters. A zero-length name matches a zero-length header.
                      (    forth6809.asm):03642         ; The Search-Order design is in shadow SEARCHORDER.1.
                      (    forth6809.asm):03643         ; FDSEARCH
                      (    forth6809.asm):03644         ;    Inputs:
                      (    forth6809.asm):03645         ;        RegX = first header of the chain (0 = empty chain)
                      (    forth6809.asm):03646         ;        RegY = address of the name text
                      (    forth6809.asm):03647         ;        RegB = name length
                      (    forth6809.asm):03648         ;    Outputs:
                      (    forth6809.asm):03649         ;        RegX = the matching header, or 0 if there is none
                      (    forth6809.asm):03650         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):03651         ; ------------------------------------------------------------
D5EA 3424             (    forth6809.asm):03652         FDSEARCH:   PSHS  Y,B               ; 0,S = length, 1,S = name text
D5EC 8C0000           (    forth6809.asm):03653         FDLOOP:     CMPX  #0
D5EF 2733             (    forth6809.asm):03654                     BEQ   FDRET
D5F1 A684             (    forth6809.asm):03655                     LDA   ,X
D5F3 8540             (    forth6809.asm):03656                     BITA  #$40
D5F5 2620             (    forth6809.asm):03657                     BNE   FDNEXT            ; smudged
D5F7 841F             (    forth6809.asm):03658                     ANDA  #$1F
D5F9 A1E4             (    forth6809.asm):03659                     CMPA  ,S
D5FB 261A             (    forth6809.asm):03660                     BNE   FDNEXT
D5FD 3410             (    forth6809.asm):03661                     PSHS  X                 ; header, kept across the compare
D5FF 3001             (    forth6809.asm):03662                     LEAX  1,X
D601 10AE63           (    forth6809.asm):03663                     LDY   3,S               ; name text
D604 E662             (    forth6809.asm):03664                     LDB   2,S               ; length
D606 2709             (    forth6809.asm):03665                     BEQ   FDHIT
D608 A680             (    forth6809.asm):03666         FDCMP:      LDA   ,X+
D60A A1A0             (    forth6809.asm):03667                     CMPA  ,Y+
D60C 2607             (    forth6809.asm):03668                     BNE   FDMISS
D60E 5A               (    forth6809.asm):03669                     DECB
D60F 26F7             (    forth6809.asm):03670                     BNE   FDCMP
D611 3510             (    forth6809.asm):03671         FDHIT:      PULS  X                 ; header
D613 200F             (    forth6809.asm):03672                     BRA   FDRET
D615 3510             (    forth6809.asm):03673         FDMISS:     PULS  X
D617 E684             (    forth6809.asm):03674         FDNEXT:     LDB   ,X
D619 C41F             (    forth6809.asm):03675                     ANDB  #$1F
D61B 4F               (    forth6809.asm):03676                     CLRA
D61C 3001             (    forth6809.asm):03677                     LEAX  1,X
D61E 308B             (    forth6809.asm):03678                     LEAX  D,X
D620 AE84             (    forth6809.asm):03679                     LDX   ,X                ; LINK field
D622 20C8             (    forth6809.asm):03680                     BRA   FDLOOP
D624 3263             (    forth6809.asm):03681         FDRET:      LEAS  3,S
D626 39               (    forth6809.asm):03682                     RTS
                      (    forth6809.asm):03683         
                      (    forth6809.asm):03684         ; ------------------------------------------------------------
                      (    forth6809.asm):03685         ; Search every wordlist of the search order, first to last, and then
                      (    forth6809.asm):03686         ; ROOT, for a name.
                      (    forth6809.asm):03687         ; SRCHORD
                      (    forth6809.asm):03688         ;    Inputs:
                      (    forth6809.asm):03689         ;        RegY = address of the name text
                      (    forth6809.asm):03690         ;        RegB = name length
                      (    forth6809.asm):03691         ;    Outputs:
                      (    forth6809.asm):03692         ;        RegX = the matching header, or 0 if there is none
                      (    forth6809.asm):03693         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):03694         ; ------------------------------------------------------------
D627 3424             (    forth6809.asm):03695         SRCHORD:    PSHS  Y,B               ; 0,S = length, 1,S = name text
D629 8E004B           (    forth6809.asm):03696                     LDX   #ORDER
D62C 3410             (    forth6809.asm):03697                     PSHS  X                 ; 0,S = next ORDER cell (length is now 2,S)
D62E AEE4             (    forth6809.asm):03698         SOLOOP:     LDX   ,S
D630 9C49             (    forth6809.asm):03699                     CMPX  ORDEND
D632 2415             (    forth6809.asm):03700                     BHS   SOROOT
D634 10AE81           (    forth6809.asm):03701                     LDY   ,X++              ; WID
D637 AFE4             (    forth6809.asm):03702                     STX   ,S
D639 AEA4             (    forth6809.asm):03703                     LDX   ,Y                ; newest header of that wordlist
D63B 10AE63           (    forth6809.asm):03704                     LDY   3,S
D63E E662             (    forth6809.asm):03705                     LDB   2,S
D640 8DA8             (    forth6809.asm):03706                     BSR   FDSEARCH
D642 8C0000           (    forth6809.asm):03707                     CMPX  #0
D645 27E7             (    forth6809.asm):03708                     BEQ   SOLOOP
D647 2009             (    forth6809.asm):03709                     BRA   SORDONE
D649 9E5D             (    forth6809.asm):03710         SOROOT:     LDX   WLHEADS+2         ; ROOT
D64B 10AE63           (    forth6809.asm):03711                     LDY   3,S
D64E E662             (    forth6809.asm):03712                     LDB   2,S
D650 8D98             (    forth6809.asm):03713                     BSR   FDSEARCH
D652 3265             (    forth6809.asm):03714         SORDONE:    LEAS  5,S
D654 39               (    forth6809.asm):03715                     RTS
                      (    forth6809.asm):03716         
                      (    forth6809.asm):03717         ; ------------------------------------------------------------
                      (    forth6809.asm):03718         ; Split a header into its xt and its immediate flag.
                      (    forth6809.asm):03719         ; HDRXT
                      (    forth6809.asm):03720         ;    Inputs:
                      (    forth6809.asm):03721         ;        RegX = header
                      (    forth6809.asm):03722         ;    Outputs:
                      (    forth6809.asm):03723         ;        RegX = xt (the CFA field), RegA = length|flags byte
                      (    forth6809.asm):03724         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):03725         ; ------------------------------------------------------------
D655 A684             (    forth6809.asm):03726         HDRXT:      LDA   ,X
D657 1F89             (    forth6809.asm):03727                     TFR   A,B
D659 C41F             (    forth6809.asm):03728                     ANDB  #$1F
D65B 3001             (    forth6809.asm):03729                     LEAX  1,X

E93F 3720             (    forth6809.asm):07537                     PULU  Y                 ; c-addr
E941 3610             (    forth6809.asm):07538                     PSHU  X                 ; result c-addr
E943 3606             (    forth6809.asm):07539                     PSHU  D                 ; result u
E945 5D               (    forth6809.asm):07540                     TSTB

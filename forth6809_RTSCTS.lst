                      (    forth6809.asm):08568         ; ENVIRONMENT?  ( c-addr u -- false | i*x true )
                      (    forth6809.asm):08569         ; Look up the attribute name c-addr u first in ENVTABLE (single-cell
                      (    forth6809.asm):08570         ; values), then in ENVTABLE2 (double-cell values). If found, return
                      (    forth6809.asm):08571         ; the value and true; otherwise return false. WORDLISTS is 8, the
                      (    forth6809.asm):08572         ; number of wordlists that can exist. FLOORED is false because /, MOD and /MOD use symmetric
                      (    forth6809.asm):08573         ; division.
                      (    forth6809.asm):08574         ; Original comment: shadow ENVQW.0.
                      (    forth6809.asm):08575         ; ------------------------------------------------------------

                      (    forth6809.asm):03704         ; SECTION 9A: SEARCH-ORDER WORD SET
                      (    forth6809.asm):03705         ; ============================================================
                      (    forth6809.asm):03706         ; ------------------------------------------------------------
                      (    forth6809.asm):03707         ; WORDLIST  ( -- wid )
                      (    forth6809.asm):03708         ; Create a new, empty wordlist. Throws -8 when all WLCELLS are in use.
                      (    forth6809.asm):03709         ; ------------------------------------------------------------
E1DE 9E45             (    forth6809.asm):03710         WORDLISTW:  LDX   WLEND
E1E0 8C006F           (    forth6809.asm):03711                     CMPX  #WLHEADS+2*WLCELLS
E1E3 240F             (    forth6809.asm):03712                     BHS   WLFULL
E1E5 CC0000           (    forth6809.asm):03713                     LDD   #0
E1E8 ED84             (    forth6809.asm):03714                     STD   ,X
E1EA ED8814           (    forth6809.asm):03715                     STD   WLNOFF,X
E1ED 3610             (    forth6809.asm):03716                     PSHU  X
E1EF 3002             (    forth6809.asm):03717                     LEAX  2,X
E1F1 9F45             (    forth6809.asm):03718                     STX   WLEND
E1F3 39               (    forth6809.asm):03719                     RTS
E1F4 CCFFF8           (    forth6809.asm):03720         WLFULL:     LDD   #-8
E1F7 3606             (    forth6809.asm):03721                     PSHU  D
E1F9 7EE542           (    forth6809.asm):03722                     JMP   THROWW
                      (    forth6809.asm):03723         
                      (    forth6809.asm):03724         ; ------------------------------------------------------------
                      (    forth6809.asm):03725         ; FORTH-WORDLIST  ( -- wid )
                      (    forth6809.asm):03726         ; Push the WID of the wordlist holding the standard words.
                      (    forth6809.asm):03727         ; ------------------------------------------------------------
E1FC CC005B           (    forth6809.asm):03728         FORTHWLW:   LDD   #WLHEADS
E1FF 3606             (    forth6809.asm):03729                     PSHU  D
E201 39               (    forth6809.asm):03730                     RTS
                      (    forth6809.asm):03731         
                      (    forth6809.asm):03732         ; ------------------------------------------------------------
                      (    forth6809.asm):03733         ; GET-ORDER  ( -- widn ... wid1 n )
                      (    forth6809.asm):03734         ; Return the search order: wid1 is searched first. ROOT is not part of
                      (    forth6809.asm):03735         ; it, as it is always searched last.
                      (    forth6809.asm):03736         ; ------------------------------------------------------------
E202 9E49             (    forth6809.asm):03737         GETORDERW:  LDX   ORDEND

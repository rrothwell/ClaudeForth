                      (    forth6809.asm):03689         ; GET-ORDER  ( -- widn ... wid1 n )
                      (    forth6809.asm):03690         ; Return the search order: wid1 is searched first. ROOT is not part of
                      (    forth6809.asm):03691         ; it, as it is always searched last.

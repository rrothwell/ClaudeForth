D0A6 BDDA54           (    forth6809.asm):02569                     JSR   CATCHW
D0A9 3706             (    forth6809.asm):02570                     PULU  D                 ; throw code (0 = no error)
D0AB 3406             (    forth6809.asm):02571                     PSHS  D                 ; frame: 0,S code  2,S LATEST  4,S VARHERE
D0AD 10830000         (    forth6809.asm):02572                     CMPD  #0                ;        6,S CODEHERE  8,S DPHERE
D0B1 2743             (    forth6809.asm):02573                     BEQ   QOK
                      (    forth6809.asm):02574         
D0B3 EC68             (    forth6809.asm):02575                     LDD   8,S
D0B5 DD06             (    forth6809.asm):02576                     STD   DPHERE

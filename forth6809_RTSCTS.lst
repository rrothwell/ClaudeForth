                      (    forth6809.asm):05555         ; ------------------------------------------------------------
EAE2 CCBD00           (    forth6809.asm):05556         DEPTHW:     LDD   #SP0
EAE5 3440             (    forth6809.asm):05557                     PSHS  U
EAE7 A3E1             (    forth6809.asm):05558                     SUBD  ,S++
EAE9 44               (    forth6809.asm):05559                     LSRA
EAEA 56               (    forth6809.asm):05560                     RORB
EAEB 3606             (    forth6809.asm):05561                     PSHU  D                 ; +n
EAED 39               (    forth6809.asm):05562                     RTS
                      (    forth6809.asm):05563         
                      (    forth6809.asm):05564         ; ------------------------------------------------------------
                      (    forth6809.asm):05565         ; 2DUP  ( x1 x2 -- x1 x2 x1 x2 )
                      (    forth6809.asm):05566         ; Duplicate the top cell pair.
                      (    forth6809.asm):05567         ; ------------------------------------------------------------
EAEE EC42             (    forth6809.asm):05568         DDUPW:      LDD   2,U               ; x1
EAF0 AEC4             (    forth6809.asm):05569                     LDX   ,U                ; x2
EAF2 3606             (    forth6809.asm):05570                     PSHU  D
EAF4 3610             (    forth6809.asm):05571                     PSHU  X
EAF6 39               (    forth6809.asm):05572                     RTS
                      (    forth6809.asm):05573         
                      (    forth6809.asm):05574         ; ------------------------------------------------------------
                      (    forth6809.asm):05575         ; 2DROP  ( x1 x2 -- )
                      (    forth6809.asm):05576         ; Discard the top cell pair.
                      (    forth6809.asm):05577         ; ------------------------------------------------------------
EAF7 3344             (    forth6809.asm):05578         DDROPW:     LEAU  4,U
EAF9 39               (    forth6809.asm):05579                     RTS
                      (    forth6809.asm):05580         
                      (    forth6809.asm):05581         ; ------------------------------------------------------------
                      (    forth6809.asm):05582         ; 2SWAP  ( x1 x2 x3 x4 -- x3 x4 x1 x2 )
                      (    forth6809.asm):05583         ; Exchange the top two cell pairs.
                      (    forth6809.asm):05584         ; ------------------------------------------------------------
EAFA ECC4             (    forth6809.asm):05585         DSWAPW:     LDD   ,U                ; x4
EAFC DD14             (    forth6809.asm):05586                     STD   MSCR
EAFE EC42             (    forth6809.asm):05587                     LDD   2,U               ; x3
EB00 AE44             (    forth6809.asm):05588                     LDX   4,U               ; x2
EB02 10AE46           (    forth6809.asm):05589                     LDY   6,U               ; x1
EB05 ED46             (    forth6809.asm):05590                     STD   6,U
EB07 AFC4             (    forth6809.asm):05591                     STX   ,U
EB09 10AF42           (    forth6809.asm):05592                     STY   2,U
EB0C DC14             (    forth6809.asm):05593                     LDD   MSCR
EB0E ED44             (    forth6809.asm):05594                     STD   4,U
EB10 39               (    forth6809.asm):05595                     RTS
                      (    forth6809.asm):05596         
                      (    forth6809.asm):05597         ; ------------------------------------------------------------
                      (    forth6809.asm):05598         ; 2OVER  ( x1 x2 x3 x4 -- x1 x2 x3 x4 x1 x2 )
                      (    forth6809.asm):05599         ; Copy the second cell pair to the top.
                      (    forth6809.asm):05600         ; ------------------------------------------------------------
EB11 EC46             (    forth6809.asm):05601         DOVERW:     LDD   6,U               ; x1
EB13 AE44             (    forth6809.asm):05602                     LDX   4,U               ; x2
EB15 3606             (    forth6809.asm):05603                     PSHU  D
EB17 3610             (    forth6809.asm):05604                     PSHU  X
EB19 39               (    forth6809.asm):05605                     RTS
                      (    forth6809.asm):05606         
                      (    forth6809.asm):05607         ; ------------------------------------------------------------
                      (    forth6809.asm):05608         ; NIP  ( x1 x2 -- x2 )
                      (    forth6809.asm):05609         ; Discard the second cell.

E983 8EEA04           (    forth6809.asm):07584                     LDX   #SQETAB
E986 6D84             (    forth6809.asm):07585         SQEFND:     TST   ,X
E988 2706             (    forth6809.asm):07586                     BEQ   SQEPUT            ; not in the table: stands for itself
E98A A181             (    forth6809.asm):07587                     CMPA  ,X++
E98C 26F8             (    forth6809.asm):07588                     BNE   SQEFND
E98E A61F             (    forth6809.asm):07589                     LDA   -1,X
E990 AE64             (    forth6809.asm):07590         SQEPUT:     LDX   4,S
E992 A780             (    forth6809.asm):07591                     STA   ,X+
E994 AF64             (    forth6809.asm):07592                     STX   4,S
E996 20CD             (    forth6809.asm):07593                     BRA   SQEL
E998 AE64             (    forth6809.asm):07594         SQEM:       LDX   4,S
E99A 860D             (    forth6809.asm):07595                     LDA   #13
E99C A780             (    forth6809.asm):07596                     STA   ,X+
E99E 860A             (    forth6809.asm):07597                     LDA   #10
E9A0 A780             (    forth6809.asm):07598                     STA   ,X+
E9A2 AF64             (    forth6809.asm):07599                     STX   4,S
E9A4 20BF             (    forth6809.asm):07600                     BRA   SQEL
E9A6 8D1A             (    forth6809.asm):07601         SQEHEX:     BSR   SQEHD             ; first digit
E9A8 25BB             (    forth6809.asm):07602                     BCS   SQEL              ; none: nothing is added
E9AA 3121             (    forth6809.asm):07603                     LEAY  1,Y
E9AC 1F89             (    forth6809.asm):07604                     TFR   A,B
E9AE 8D12             (    forth6809.asm):07605                     BSR   SQEHD             ; second digit
E9B0 2404             (    forth6809.asm):07606                     BCC   SQEH2

                      (    forth6809.asm):05866         
                      (    forth6809.asm):05867         ; ------------------------------------------------------------
                      (    forth6809.asm):05868         ; PICK  ( xu ... x0 u -- xu ... x0 xu )
                      (    forth6809.asm):05869         ; Copy the cell u deep (0 PICK is DUP) to the top.
                      (    forth6809.asm):05870         ; ------------------------------------------------------------
E039 3706             (    forth6809.asm):05871         PICKW:      PULU  D                 ; u
E03B 58               (    forth6809.asm):05872                     LSLB
E03C 49               (    forth6809.asm):05873                     ROLA

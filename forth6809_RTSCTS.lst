E122 39               (    forth6809.asm):03565                     RTS
                      (    forth6809.asm):03566         
                      (    forth6809.asm):03567         ; ------------------------------------------------------------
                      (    forth6809.asm):03568         ; FIND  ( c-addr -- c-addr 0 | xt 1 | xt -1 )
                      (    forth6809.asm):03569         ; Look up the counted string in the search order, then in ROOT, ignoring
                      (    forth6809.asm):03570         ; smudged entries. Returns the xt and 1 if the word is immediate, or
                      (    forth6809.asm):03571         ; -1 if not. If not found, returns c-addr and 0.
                      (    forth6809.asm):03572         ; Holds no scratch cells; see shadow FINDW.1 and SEARCHORDER.1.
                      (    forth6809.asm):03573         ; ------------------------------------------------------------
E123 10AEC4           (    forth6809.asm):03574         FINDW:      LDY   ,U                ; counted string
E126 E6A0             (    forth6809.asm):03575                     LDB   ,Y+
E128 8DBF             (    forth6809.asm):03576                     BSR   SRCHORD
E12A 8C0000           (    forth6809.asm):03577                     CMPX  #0
E12D 2712             (    forth6809.asm):03578                     BEQ   NOTFOUND
E12F 8DE6             (    forth6809.asm):03579                     BSR   HDRXT
E131 AFC4             (    forth6809.asm):03580                     STX   ,U                ; xt replaces c-addr
E133 4D               (    forth6809.asm):03581                     TSTA
E134 2A05             (    forth6809.asm):03582                     BPL   FISNORM
E136 CC0001           (    forth6809.asm):03583                     LDD   #1
E139 2003             (    forth6809.asm):03584                     BRA   FPUSH
E13B CCFFFF           (    forth6809.asm):03585         FISNORM:    LDD   #-1
E13E 3606             (    forth6809.asm):03586         FPUSH:      PSHU  D                 ; 1 = immediate, -1 = normal
E140 39               (    forth6809.asm):03587                     RTS
                      (    forth6809.asm):03588         
E141 CC0000           (    forth6809.asm):03589         NOTFOUND:   LDD   #0
E144 3606             (    forth6809.asm):03590                     PSHU  D                 ; 0 = not found, c-addr still beneath
E146 39               (    forth6809.asm):03591                     RTS
                      (    forth6809.asm):03592         
                      (    forth6809.asm):03593         ; ------------------------------------------------------------
                      (    forth6809.asm):03594         ; SEARCH-WORDLIST  ( c-addr u wid -- 0 | xt 1 | xt -1 )
                      (    forth6809.asm):03595         ; Search the one wordlist wid for the name c-addr u. Returns 0 if it is
                      (    forth6809.asm):03596         ; not found, else its xt and 1 if the word is immediate or -1 if not.
                      (    forth6809.asm):03597         ; Throws -11 for an invalid wid.
                      (    forth6809.asm):03598         ; ------------------------------------------------------------
E147 3710             (    forth6809.asm):03599         SEARCHWLW:  PULU  X                 ; wid
E149 8D2D             (    forth6809.asm):03600                     BSR   WIDCHK
E14B AE84             (    forth6809.asm):03601                     LDX   ,X                ; newest header of the wordlist
E14D 3706             (    forth6809.asm):03602                     PULU  D                 ; u
E14F 3720             (    forth6809.asm):03603                     PULU  Y                 ; c-addr
E151 4D               (    forth6809.asm):03604                     TSTA
E152 261E             (    forth6809.asm):03605                     BNE   SWNOT             ; longer than any name
E154 C11F             (    forth6809.asm):03606                     CMPB  #31
E156 221A             (    forth6809.asm):03607                     BHI   SWNOT
E158 BDE0AC           (    forth6809.asm):03608                     JSR   FDSEARCH
E15B 8C0000           (    forth6809.asm):03609                     CMPX  #0
E15E 2712             (    forth6809.asm):03610                     BEQ   SWNOT
E160 8DB5             (    forth6809.asm):03611                     BSR   HDRXT
E162 3610             (    forth6809.asm):03612                     PSHU  X                 ; xt
E164 4D               (    forth6809.asm):03613                     TSTA
E165 2A05             (    forth6809.asm):03614                     BPL   SWNORM
E167 CC0001           (    forth6809.asm):03615                     LDD   #1
E16A 2003             (    forth6809.asm):03616                     BRA   SWPUSH
E16C CCFFFF           (    forth6809.asm):03617         SWNORM:     LDD   #-1
E16F 3606             (    forth6809.asm):03618         SWPUSH:     PSHU  D
E171 39               (    forth6809.asm):03619                     RTS
E172 CC0000           (    forth6809.asm):03620         SWNOT:      LDD   #0
E175 3606             (    forth6809.asm):03621                     PSHU  D
E177 39               (    forth6809.asm):03622                     RTS
                      (    forth6809.asm):03623         
                      (    forth6809.asm):03624         ; ------------------------------------------------------------
                      (    forth6809.asm):03625         ; Throw -11 unless RegX is the address of a wordlist cell in use.
                      (    forth6809.asm):03626         ; WIDCHK
                      (    forth6809.asm):03627         ;    Inputs:
                      (    forth6809.asm):03628         ;        RegX = candidate WID
                      (    forth6809.asm):03629         ;    Outputs:
                      (    forth6809.asm):03630         ;        none if valid (RegX and RegY unchanged); THROW -11 if not
                      (    forth6809.asm):03631         ;    Registers: RegD and CC changed.
                      (    forth6809.asm):03632         ; ------------------------------------------------------------
E178 1F10             (    forth6809.asm):03633         WIDCHK:     TFR   X,D
E17A 83005B           (    forth6809.asm):03634                     SUBD  #WLHEADS
E17D 2509             (    forth6809.asm):03635                     BCS   WIDBAD
E17F C501             (    forth6809.asm):03636                     BITB  #1
E181 2605             (    forth6809.asm):03637                     BNE   WIDBAD
E183 9C45             (    forth6809.asm):03638                     CMPX  WLEND
E185 2401             (    forth6809.asm):03639                     BHS   WIDBAD
E187 39               (    forth6809.asm):03640                     RTS
E188 CCFFF5           (    forth6809.asm):03641         WIDBAD:     LDD   #-11
E18B 3606             (    forth6809.asm):03642                     PSHU  D
E18D 7EE542           (    forth6809.asm):03643                     JMP   THROWW
                      (    forth6809.asm):03644         
                      (    forth6809.asm):03645         ; ------------------------------------------------------------
                      (    forth6809.asm):03646         ; Set the Search-Order state to its initial value: two wordlists
                      (    forth6809.asm):03647         ; (FORTH, holding the ROM dictionary, and ROOT), the search order
                      (    forth6809.asm):03648         ; FORTH, and CURRENT = FORTH.
                      (    forth6809.asm):03649         ; WLINIT
                      (    forth6809.asm):03650         ;    Inputs:
                      (    forth6809.asm):03651         ;        none
                      (    forth6809.asm):03652         ;    Outputs:
                      (    forth6809.asm):03653         ;        WLHEADS, WLNAMES (FORTH, ROOT), WLEND, CURRENT, ORDER, ORDEND set
                      (    forth6809.asm):03654         ;    Registers: RegD and CC changed.
                      (    forth6809.asm):03655         ; ------------------------------------------------------------
E190 CCD956           (    forth6809.asm):03656         WLINIT:     LDD   #BASELATEST
E193 DD5B             (    forth6809.asm):03657                     STD   WLHEADS
E195 CCD084           (    forth6809.asm):03658                     LDD   #BASEROOTLATEST
E198 DD5D             (    forth6809.asm):03659                     STD   WLHEADS+2
E19A CCD084           (    forth6809.asm):03660                     LDD   #H_FORTH
E19D DD6F             (    forth6809.asm):03661                     STD   WLNAMES
E19F CCD07B           (    forth6809.asm):03662                     LDD   #H_ROOT
E1A2 DD71             (    forth6809.asm):03663                     STD   WLNAMES+2
E1A4 CC005F           (    forth6809.asm):03664                     LDD   #WLHEADS+4
E1A7 DD45             (    forth6809.asm):03665                     STD   WLEND
E1A9 CC005B           (    forth6809.asm):03666                     LDD   #WLHEADS
E1AC DD47             (    forth6809.asm):03667                     STD   CURRENT
E1AE 7EE27E           (    forth6809.asm):03668                     JMP   ONLYW             ; the order is FORTH only
                      (    forth6809.asm):03669         
                      (    forth6809.asm):03670         ; ------------------------------------------------------------
                      (    forth6809.asm):03671         ; Remove from every wordlist the RAM headers that are at or above a
                      (    forth6809.asm):03672         ; mark. Headers are allocated upwards from DPHERE, so these are the
                      (    forth6809.asm):03673         ; newest ones of each chain. ROM headers are never touched.
                      (    forth6809.asm):03674         ; PRUNE
                      (    forth6809.asm):03675         ;    Inputs:
                      (    forth6809.asm):03676         ;        RegD = mark (a DPHERE value)
                      (    forth6809.asm):03677         ;    Outputs:
                      (    forth6809.asm):03678         ;        the head of every wordlist in use points below the mark or
                      (    forth6809.asm):03679         ;        into ROM
                      (    forth6809.asm):03680         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):03681         ; ------------------------------------------------------------
E1B1 3406             (    forth6809.asm):03682         PRUNE:      PSHS  D                 ; 0,S = mark
E1B3 8E005B           (    forth6809.asm):03683                     LDX   #WLHEADS
E1B6 9C45             (    forth6809.asm):03684         PRLOOP:     CMPX  WLEND
E1B8 2421             (    forth6809.asm):03685                     BHS   PRNDONE
E1BA 10AE84           (    forth6809.asm):03686                     LDY   ,X                ; newest header of this wordlist
E1BD 108CC000         (    forth6809.asm):03687         PRWALK:     CMPY  #ROMSTRT
E1C1 2413             (    forth6809.asm):03688                     BHS   PRSTORE           ; ROM header: keep
E1C3 10ACE4           (    forth6809.asm):03689                     CMPY  ,S
E1C6 250E             (    forth6809.asm):03690                     BLO   PRSTORE           ; below the mark (or empty): keep
E1C8 E6A4             (    forth6809.asm):03691                     LDB   ,Y
E1CA C41F             (    forth6809.asm):03692                     ANDB  #$1F
E1CC 4F               (    forth6809.asm):03693                     CLRA
E1CD 3121             (    forth6809.asm):03694                     LEAY  1,Y
E1CF 31AB             (    forth6809.asm):03695                     LEAY  D,Y
E1D1 10AEA4           (    forth6809.asm):03696                     LDY   ,Y                ; follow the LINK
E1D4 20E7             (    forth6809.asm):03697                     BRA   PRWALK
E1D6 10AF81           (    forth6809.asm):03698         PRSTORE:    STY   ,X++
E1D9 20DB             (    forth6809.asm):03699                     BRA   PRLOOP
E1DB 3262             (    forth6809.asm):03700         PRNDONE:     LEAS  2,S
E1DD 39               (    forth6809.asm):03701                     RTS

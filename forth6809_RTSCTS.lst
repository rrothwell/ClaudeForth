                      (    forth6809.asm):09106         ; ------------------------------------------------------------
                      (    forth6809.asm):09107         ; [IF]  ( flag -- )     [ELSE]  ( -- )     [THEN]  ( -- )
                      (    forth6809.asm):09108         ; Programming-Tools conditional compilation. All three are
                      (    forth6809.asm):09109         ; immediate, so they work while interpreting and while compiling.
                      (    forth6809.asm):09110         ; [IF] with a true flag does nothing. With a false flag, and for
                      (    forth6809.asm):09111         ; [ELSE], the input is skipped word by word, counting nested
                      (    forth6809.asm):09112         ; [IF]s, up to the matching [ELSE] or [THEN]. The three names are
                      (    forth6809.asm):09113         ; matched exactly, as the dictionary matches every name. If the line
                      (    forth6809.asm):09114         ; runs out, the next line is read with REFILL; if no more input is
                      (    forth6809.asm):09115         ; available the skip ends.
                      (    forth6809.asm):09116         ; [THEN] is a marker and does nothing when it is executed.
                      (    forth6809.asm):09117         ; The nesting level is kept at 0,S.
                      (    forth6809.asm):09118         ; ------------------------------------------------------------
FEED 3706             (    forth6809.asm):09119         BRIFW:      PULU  D
FEEF 10830000         (    forth6809.asm):09120                     CMPD  #0
FEF3 266D             (    forth6809.asm):09121                     BNE   BRTHENW           ; true: nothing to skip
FEF5 CC0001           (    forth6809.asm):09122         BRELSEW:    LDD   #1
FEF8 3406             (    forth6809.asm):09123                     PSHS  D                 ; level
FEFA BDF5F4           (    forth6809.asm):09124         BRNEXT:     JSR   PARSENAMEW
FEFD 3706             (    forth6809.asm):09125                     PULU  D                 ; length
FEFF 3710             (    forth6809.asm):09126                     PULU  X                 ; address
FF01 10830000         (    forth6809.asm):09127                     CMPD  #0
FF05 274E             (    forth6809.asm):09128                     BEQ   BRREFILL
FF07 10830004         (    forth6809.asm):09129                     CMPD  #4
FF0B 2734             (    forth6809.asm):09130                     BEQ   BR4
FF0D 10830006         (    forth6809.asm):09131                     CMPD  #6
FF11 26E7             (    forth6809.asm):09132                     BNE   BRNEXT
FF13 C606             (    forth6809.asm):09133                     LDB   #6
FF15 108EFF71         (    forth6809.asm):09134                     LDY   #BRSELSE
FF19 3410             (    forth6809.asm):09135                     PSHS  X
FF1B BDFF63           (    forth6809.asm):09136                     JSR   BRCMP
FF1E 3510             (    forth6809.asm):09137                     PULS  X
FF20 2609             (    forth6809.asm):09138                     BNE   BR6B
FF22 ECE4             (    forth6809.asm):09139                     LDD   ,S                ; [ELSE]: ends the skip at level 1
FF24 830001           (    forth6809.asm):09140                     SUBD  #1
FF27 2737             (    forth6809.asm):09141                     BEQ   BRDONE
FF29 20CF             (    forth6809.asm):09142                     BRA   BRNEXT
FF2B C606             (    forth6809.asm):09143         BR6B:       LDB   #6
FF2D 108EFF77         (    forth6809.asm):09144                     LDY   #BRSTHEN
FF31 BDFF63           (    forth6809.asm):09145                     JSR   BRCMP
FF34 26C4             (    forth6809.asm):09146                     BNE   BRNEXT
FF36 ECE4             (    forth6809.asm):09147                     LDD   ,S                ; [THEN]: one level less
FF38 830001           (    forth6809.asm):09148                     SUBD  #1
FF3B EDE4             (    forth6809.asm):09149                     STD   ,S
FF3D 2721             (    forth6809.asm):09150                     BEQ   BRDONE
FF3F 20B9             (    forth6809.asm):09151                     BRA   BRNEXT
FF41 C604             (    forth6809.asm):09152         BR4:        LDB   #4
FF43 108EFF6D         (    forth6809.asm):09153                     LDY   #BRSIF
FF47 BDFF63           (    forth6809.asm):09154                     JSR   BRCMP
FF4A 26AE             (    forth6809.asm):09155                     BNE   BRNEXT
FF4C ECE4             (    forth6809.asm):09156                     LDD   ,S                ; [IF]: one level more

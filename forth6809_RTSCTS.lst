                      (    forth6809.asm):05541         
                      (    forth6809.asm):05542         ; ------------------------------------------------------------
                      (    forth6809.asm):05543         ; ?DUP  ( x -- 0 | x x )
                      (    forth6809.asm):05544         ; Duplicate the top cell if it is non-zero.
                      (    forth6809.asm):05545         ; ------------------------------------------------------------
EAD7 ECC4             (    forth6809.asm):05546         QDUPW:      LDD   ,U                ; x
EAD9 10830000         (    forth6809.asm):05547                     CMPD  #0
EADD 2702             (    forth6809.asm):05548                     BEQ   QDUPDONE
EADF 3606             (    forth6809.asm):05549                     PSHU  D
EAE1 39               (    forth6809.asm):05550         QDUPDONE:   RTS
                      (    forth6809.asm):05551         
                      (    forth6809.asm):05552         ; ------------------------------------------------------------
                      (    forth6809.asm):05553         ; DEPTH  ( -- +n )

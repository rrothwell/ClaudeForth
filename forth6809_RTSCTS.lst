E239 6AE4             (    forth6809.asm):03771                     DEC   ,S
E23B 20F3             (    forth6809.asm):03772                     BRA   SOCHK
E23D 3506             (    forth6809.asm):03773         SOCOPY:     PULS  A,B               ; B = n
E23F 8E004B           (    forth6809.asm):03774                     LDX   #ORDER
E242 5D               (    forth6809.asm):03775         SOCP2:      TSTB
E243 2708             (    forth6809.asm):03776                     BEQ   SOCPEND
E245 3720             (    forth6809.asm):03777                     PULU  Y
E247 10AF81           (    forth6809.asm):03778                     STY   ,X++
E24A 5A               (    forth6809.asm):03779                     DECB
E24B 20F5             (    forth6809.asm):03780                     BRA   SOCP2
E24D 9F49             (    forth6809.asm):03781         SOCPEND:    STX   ORDEND
E24F 39               (    forth6809.asm):03782                     RTS

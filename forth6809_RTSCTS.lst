                      (    forth6809.asm):08457         ; ------------------------------------------------------------
                      (    forth6809.asm):08458         ; <#  ( -- )
                      (    forth6809.asm):08459         ; Start a pictured numeric output string: HLD is set to the end of
                      (    forth6809.asm):08460         ; PAD. The string is built backwards from there.
                      (    forth6809.asm):08461         ; ------------------------------------------------------------

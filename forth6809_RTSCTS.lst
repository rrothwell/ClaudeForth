                      (    forth6809.asm):03627         ; ------------------------------------------------------------
                      (    forth6809.asm):03628         ; Remove from every wordlist the RAM headers that are at or above a
                      (    forth6809.asm):03629         ; mark. Headers are allocated upwards from DPHERE, so these are the
                      (    forth6809.asm):03630         ; newest ones of each chain. ROM headers are never touched.
                      (    forth6809.asm):03631         ; PRUNE
                      (    forth6809.asm):03632         ;    Inputs:
                      (    forth6809.asm):03633         ;        RegD = mark (a DPHERE value)
                      (    forth6809.asm):03634         ;    Outputs:
                      (    forth6809.asm):03635         ;        the head of every wordlist in use points below the mark or
                      (    forth6809.asm):03636         ;        into ROM
                      (    forth6809.asm):03637         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):03638         ; ------------------------------------------------------------
E27C 3406             (    forth6809.asm):03639         PRUNE:      PSHS  D                 ; 0,S = mark
E27E 8E005B           (    forth6809.asm):03640                     LDX   #WLHEADS
E281 9C45             (    forth6809.asm):03641         PRLOOP:     CMPX  WLEND
E283 2421             (    forth6809.asm):03642                     BHS   PRNDONE
E285 10AE84           (    forth6809.asm):03643                     LDY   ,X                ; newest header of this wordlist
E288 108CC000         (    forth6809.asm):03644         PRWALK:     CMPY  #ROMSTRT
E28C 2413             (    forth6809.asm):03645                     BHS   PRSTORE           ; ROM header: keep
E28E 10ACE4           (    forth6809.asm):03646                     CMPY  ,S
E291 250E             (    forth6809.asm):03647                     BLO   PRSTORE           ; below the mark (or empty): keep
E293 E6A4             (    forth6809.asm):03648                     LDB   ,Y
E295 C41F             (    forth6809.asm):03649                     ANDB  #$1F
E297 4F               (    forth6809.asm):03650                     CLRA
E298 3121             (    forth6809.asm):03651                     LEAY  1,Y
E29A 31AB             (    forth6809.asm):03652                     LEAY  D,Y
E29C 10AEA4           (    forth6809.asm):03653                     LDY   ,Y                ; follow the LINK
E29F 20E7             (    forth6809.asm):03654                     BRA   PRWALK
E2A1 10AF81           (    forth6809.asm):03655         PRSTORE:    STY   ,X++
E2A4 20DB             (    forth6809.asm):03656                     BRA   PRLOOP

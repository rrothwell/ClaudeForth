                      (    forth6809.asm):03985         ; Multiply the unsigned double ud on the data stack by BASE and add a
                      (    forth6809.asm):03986         ; digit. (5m: the accumulator lives on the data stack, in the frame of
                      (    forth6809.asm):03987         ; >NUMBER, so no page-zero cells are needed.)
                      (    forth6809.asm):03988         ; UDMULADD
                      (    forth6809.asm):03989         ;    Inputs:
                      (    forth6809.asm):03990         ;        ud at 4,U (high cell) and 6,U (low cell), as in the >NUMBER
                      (    forth6809.asm):03991         ;        frame ( ud c-addr u )
                      (    forth6809.asm):03992         ;        RegB = digit value to add
                      (    forth6809.asm):03993         ;        BASE
                      (    forth6809.asm):03994         ;    Outputs:
                      (    forth6809.asm):03995         ;        ud = ud * BASE + digit
                      (    forth6809.asm):03996         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):03997         ; ------------------------------------------------------------

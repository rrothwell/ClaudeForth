                      (    forth6809.asm):04452         ; ============================================================
                      (    forth6809.asm):04453         ; SECTION 11: EXCEPTIONS (CFERR, CATCH, THROW)
                      (    forth6809.asm):04454         ; ============================================================
                      (    forth6809.asm):04455         ; ------------------------------------------------------------
                      (    forth6809.asm):04456         ; Report a control-structure mismatch: throw -22. Called by the
                      (    forth6809.asm):04457         ; control-flow words when the tag on the control-flow stack is not the
                      (    forth6809.asm):04458         ; one expected.
                      (    forth6809.asm):04459         ; CFERR
                      (    forth6809.asm):04460         ;    Inputs:
                      (    forth6809.asm):04461         ;        none
                      (    forth6809.asm):04462         ;    Outputs:
                      (    forth6809.asm):04463         ;        does not return (THROW -22)
                      (    forth6809.asm):04464         ;    Registers: RegD changed; THROW decides the rest.
                      (    forth6809.asm):04465         ; ------------------------------------------------------------
E50D CCFFEA           (    forth6809.asm):04466         CFERR:      LDD   #-22
E510 3606             (    forth6809.asm):04467                     PSHU  D                 ; -22
E512 BDE542           (    forth6809.asm):04468                     JSR   THROWW
E515 39               (    forth6809.asm):04469                     RTS
                      (    forth6809.asm):04470         
                      (    forth6809.asm):04471         ; ------------------------------------------------------------
                      (    forth6809.asm):04472         ; CATCH  ( i*x xt -- j*x 0 | i*x n )
                      (    forth6809.asm):04473         ; Execute xt with an exception frame in place. On normal return push
                      (    forth6809.asm):04474         ; 0. If xt (or anything it calls) executes THROW with a non-zero n,
                      (    forth6809.asm):04475         ; THROW unwinds to this frame and CATCH returns n.
                      (    forth6809.asm):04476         ; Frame on S, top first: >IN, SRCID, SRCLEN, SRCADDR, saved U,
                      (    forth6809.asm):04477         ; previous HANDLER. HANDLER points at the >IN cell.
                      (    forth6809.asm):04478         ; ------------------------------------------------------------
E516 3710             (    forth6809.asm):04479         CATCHW:     PULU  X                 ; xt
E518 DC0C             (    forth6809.asm):04480                     LDD   HANDLER
E51A 3406             (    forth6809.asm):04481                     PSHS  D
E51C 3440             (    forth6809.asm):04482                     PSHS  U
                      (    forth6809.asm):04483                     ; Save the input source specification.
                      (    forth6809.asm):04484                     ; See bugfix: CATCHW.1
E51E DC39             (    forth6809.asm):04485                     LDD   SRCADDR
E520 3406             (    forth6809.asm):04486                     PSHS  D
E522 DC3B             (    forth6809.asm):04487                     LDD   SRCLEN
E524 3406             (    forth6809.asm):04488                     PSHS  D
E526 DC3D             (    forth6809.asm):04489                     LDD   SRCID
E528 3406             (    forth6809.asm):04490                     PSHS  D
E52A DC10             (    forth6809.asm):04491                     LDD   TOIN
E52C 3406             (    forth6809.asm):04492                     PSHS  D
E52E 1F40             (    forth6809.asm):04493                     TFR   S,D
E530 DD0C             (    forth6809.asm):04494                     STD   HANDLER
                      (    forth6809.asm):04495         
E532 AD84             (    forth6809.asm):04496                     JSR   ,X
                      (    forth6809.asm):04497         
E534 3268             (    forth6809.asm):04498                     LEAS  8,S               ; drop saved input source
E536 3262             (    forth6809.asm):04499                     LEAS  2,S               ; saved U
E538 3506             (    forth6809.asm):04500                     PULS  D
E53A DD0C             (    forth6809.asm):04501                     STD   HANDLER
E53C CC0000           (    forth6809.asm):04502                     LDD   #0
E53F 3606             (    forth6809.asm):04503                     PSHU  D                 ; 0 = no exception
E541 39               (    forth6809.asm):04504                     RTS
                      (    forth6809.asm):04505         
                      (    forth6809.asm):04506         ; ------------------------------------------------------------
                      (    forth6809.asm):04507         ; THROW  ( k*x n -- k*x | i*x n )
                      (    forth6809.asm):04508         ; If n is zero, do nothing. Otherwise restore the state saved by the
                      (    forth6809.asm):04509         ; most recent CATCH (S, U, input source, >IN, HANDLER) and make that
                      (    forth6809.asm):04510         ; CATCH return n. With no CATCH active, push n and ABORT.
                      (    forth6809.asm):04511         ; ------------------------------------------------------------
E542 3706             (    forth6809.asm):04512         THROWW:     PULU  D                 ; n
E544 10830000         (    forth6809.asm):04513                     CMPD  #0
E548 2725             (    forth6809.asm):04514                     BEQ   THDONE
                      (    forth6809.asm):04515         
E54A DD0E             (    forth6809.asm):04516                     STD   THROWN

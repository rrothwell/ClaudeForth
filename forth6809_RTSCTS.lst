                      (    forth6809.asm):05375         ; IMMEDIATE  ( -- )
                      (    forth6809.asm):05376         ; Set the immediate flag ($80) in the length byte of the most recent
                      (    forth6809.asm):05377         ; definition (LATEST).
                      (    forth6809.asm):05378         ; ------------------------------------------------------------
DE85 9E04             (    forth6809.asm):05379         IMMEDIATEW: LDX   LATEST

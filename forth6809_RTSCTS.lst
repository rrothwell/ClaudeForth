EF05 3606             (    forth6809.asm):08596                     PSHU  D
EF07 7EEED0           (    forth6809.asm):08597                     JMP   HOLDW
                      (    forth6809.asm):08598         
                      (    forth6809.asm):08599         ; ------------------------------------------------------------
                      (    forth6809.asm):08600         ; Divide the unsigned double on the data stack (high cell at 0,U, low
                      (    forth6809.asm):08601         ; cell at 2,U) by BASE (restoring division, 32 iterations). Only the
                      (    forth6809.asm):08602         ; low byte of BASE is used.
                      (    forth6809.asm):08603         ; UDDIGIT
                      (    forth6809.asm):08604         ;    Inputs:
                      (    forth6809.asm):08605         ;        ud on the data stack
                      (    forth6809.asm):08606         ;    Outputs:
                      (    forth6809.asm):08607         ;        ud replaced by the quotient; RegA = remainder
                      (    forth6809.asm):08608         ;    Registers: RegA and RegB changed (RegB is the loop counter).
                      (    forth6809.asm):08609         ; ------------------------------------------------------------
EF0A 4F               (    forth6809.asm):08610         UDDIGIT:    CLRA                    ; A = remainder
EF0B C620             (    forth6809.asm):08611                     LDB   #32
EF0D 6843             (    forth6809.asm):08612         UDDLOOP:    ASL   3,U
EF0F 6942             (    forth6809.asm):08613                     ROL   2,U
EF11 6941             (    forth6809.asm):08614                     ROL   1,U
EF13 69C4             (    forth6809.asm):08615                     ROL   ,U
EF15 49               (    forth6809.asm):08616                     ROLA
EF16 9103             (    forth6809.asm):08617                     CMPA  BASE+1
EF18 2504             (    forth6809.asm):08618                     BLO   UDNEXT
EF1A 9003             (    forth6809.asm):08619                     SUBA  BASE+1
EF1C 6C43             (    forth6809.asm):08620                     INC   3,U
EF1E 5A               (    forth6809.asm):08621         UDNEXT:     DECB
EF1F 26EC             (    forth6809.asm):08622                     BNE   UDDLOOP
EF21 39               (    forth6809.asm):08623                     RTS
                      (    forth6809.asm):08624         
                      (    forth6809.asm):08625         ; ------------------------------------------------------------
                      (    forth6809.asm):08626         ; #S  ( ud -- 0 0 )
                      (    forth6809.asm):08627         ; Convert digits with # until the quotient is zero (at least one digit
                      (    forth6809.asm):08628         ; is produced).
                      (    forth6809.asm):08629         ; ------------------------------------------------------------

DDD3 CCE5EA           (    forth6809.asm):05377                     LDD   #EQUALW
DDD6 3606             (    forth6809.asm):05378                     PSHU  D
DDD8 BDDE9C           (    forth6809.asm):05379                     JSR   CCALL
DDDB CCD0BD           (    forth6809.asm):05380                     LDD   #ZBRANCH
DDDE 3606             (    forth6809.asm):05381                     PSHU  D
DDE0 BDDE9C           (    forth6809.asm):05382                     JSR   CCALL
DDE3 CC0000           (    forth6809.asm):05383                     LDD   #0
DDE6 3606             (    forth6809.asm):05384                     PSHU  D
DDE8 BDD15A           (    forth6809.asm):05385                     JSR   CODECOMMA
DDEB DC08             (    forth6809.asm):05386                     LDD   CODEHERE
DDED 830002           (    forth6809.asm):05387                     SUBD  #2
DDF0 3606             (    forth6809.asm):05388                     PSHU  D                 ; orig
DDF2 CCDFC4           (    forth6809.asm):05389                     LDD   #DROPW
DDF5 3606             (    forth6809.asm):05390                     PSHU  D
DDF7 BDDE9C           (    forth6809.asm):05391                     JSR   CCALL
DDFA CC0005           (    forth6809.asm):05392                     LDD   #TAGOF
DDFD 3606             (    forth6809.asm):05393                     PSHU  D
DDFF 39               (    forth6809.asm):05394                     RTS
                      (    forth6809.asm):05395         
                      (    forth6809.asm):05396         ; ------------------------------------------------------------
                      (    forth6809.asm):05397         ; ENDOF  ( C: orig1 -- orig2 )
                      (    forth6809.asm):05398         ; Compile BRANCH with a placeholder operand, resolve orig1 to just
                      (    forth6809.asm):05399         ; after it, and leave the new operand address and TAGENDOF.

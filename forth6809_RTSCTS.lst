D93B 3606             (    forth6809.asm):04431                     PSHU  D                 ; flag = true
D93D 39               (    forth6809.asm):04432                     RTS
                      (    forth6809.asm):04433         
                      (    forth6809.asm):04434         ; Unused alternative to EMIT removed; see shadow X_EMIT.1.
                      (    forth6809.asm):04435         
                      (    forth6809.asm):04436         ; ------------------------------------------------------------
                      (    forth6809.asm):04437         ; EMIT  ( char -- )
                      (    forth6809.asm):04438         ; Transmit char through PUTCHAR (the output ring). When the ring is
                      (    forth6809.asm):04439         ; full EMIT waits for room, so no character is lost however fast the
                      (    forth6809.asm):04440         ; caller produces output. The wait needs the transmit interrupt to be
                      (    forth6809.asm):04441         ; able to run, so EMIT must not be called with interrupts masked, nor
                      (    forth6809.asm):04442         ; from an interrupt handler. See shadow EMITACIA.1.
                      (    forth6809.asm):04443         ; ------------------------------------------------------------
D93E                  (    forth6809.asm):04444         EMITACIA:
D93E 3706             (    forth6809.asm):04445                     PULU  D                 ; char
D940 3404             (    forth6809.asm):04446                     PSHS  B                 ; keep it while waiting
D942 F60179           (    forth6809.asm):04447         EMWAIT:     LDB   OUTHEAD           ; Is there room for one more?
D945 5C               (    forth6809.asm):04448                     INCB
D946 C43F             (    forth6809.asm):04449                     ANDB  #OUTBUFSZ-1
D948 F1017A           (    forth6809.asm):04450                     CMPB  OUTTAIL
D94B 2610             (    forth6809.asm):04451                     BNE   EMROOM            ; Yes!
D94D 7D0178           (    forth6809.asm):04452                     TST   RTSSTATE          ; No! Is the transmit interrupt running?
D950 27F0             (    forth6809.asm):04453                     BEQ   EMWAIT            ; Yes! It will make room.
D952 3401             (    forth6809.asm):04454                     PSHS  CC                ; RTS is high so the transmit interrupt
D954 1A50             (    forth6809.asm):04455                     ORCC  #$50              ; is off: send one character by polling,
D956 BDCE8E           (    forth6809.asm):04456                     JSR   FLUSHOUTBUFFER    ; as PUTCHAR does.
D959 3501             (    forth6809.asm):04457                     PULS  CC
D95B 20E5             (    forth6809.asm):04458                     BRA   EMWAIT
D95D 3502             (    forth6809.asm):04459         EMROOM:     PULS  A                 ; char
D95F BDCEB0           (    forth6809.asm):04460                     JSR   PUTCHAR           ; Transmit char.
D962 39               (    forth6809.asm):04461                     RTS

                      (    forth6809.asm):03784         ; ------------------------------------------------------------
                      (    forth6809.asm):03785         ; Multiply the unsigned double ud on the data stack by BASE and add a
                      (    forth6809.asm):03786         ; digit. (5m: the accumulator lives on the data stack, in the frame of
                      (    forth6809.asm):03787         ; >NUMBER, so no page-zero cells are needed.)
                      (    forth6809.asm):03788         ; UDMULADD
                      (    forth6809.asm):03789         ;    Inputs:
                      (    forth6809.asm):03790         ;        ud at 4,U (high cell) and 6,U (low cell), as in the >NUMBER
                      (    forth6809.asm):03791         ;        frame ( ud c-addr u )
                      (    forth6809.asm):03792         ;        RegB = digit value to add
                      (    forth6809.asm):03793         ;        BASE
                      (    forth6809.asm):03794         ;    Outputs:
                      (    forth6809.asm):03795         ;        ud = ud * BASE + digit
                      (    forth6809.asm):03796         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):03797         ; ------------------------------------------------------------
E351 327E             (    forth6809.asm):03798         UDMULADD:   LEAS  -2,S              ; 0,S = carry, 1,S = BASE multiplier
E353 E7E4             (    forth6809.asm):03799                     STB   ,S
E355 9603             (    forth6809.asm):03800                     LDA   BASE+1
E357 A761             (    forth6809.asm):03801                     STA   1,S
E359 A647             (    forth6809.asm):03802                     LDA   7,U
E35B E661             (    forth6809.asm):03803                     LDB   1,S
E35D 3D               (    forth6809.asm):03804                     MUL
E35E EBE4             (    forth6809.asm):03805                     ADDB  ,S
E360 2401             (    forth6809.asm):03806                     BCC   UM0
E362 4C               (    forth6809.asm):03807                     INCA
E363 E747             (    forth6809.asm):03808         UM0:        STB   7,U
E365 A7E4             (    forth6809.asm):03809                     STA   ,S
E367 A646             (    forth6809.asm):03810                     LDA   6,U
E369 E661             (    forth6809.asm):03811                     LDB   1,S
E36B 3D               (    forth6809.asm):03812                     MUL
E36C EBE4             (    forth6809.asm):03813                     ADDB  ,S
E36E 2401             (    forth6809.asm):03814                     BCC   UM1
E370 4C               (    forth6809.asm):03815                     INCA
E371 E746             (    forth6809.asm):03816         UM1:        STB   6,U
E373 A7E4             (    forth6809.asm):03817                     STA   ,S
E375 A645             (    forth6809.asm):03818                     LDA   5,U
E377 E661             (    forth6809.asm):03819                     LDB   1,S
E379 3D               (    forth6809.asm):03820                     MUL
E37A EBE4             (    forth6809.asm):03821                     ADDB  ,S
E37C 2401             (    forth6809.asm):03822                     BCC   UM2
E37E 4C               (    forth6809.asm):03823                     INCA
E37F E745             (    forth6809.asm):03824         UM2:        STB   5,U
E381 A7E4             (    forth6809.asm):03825                     STA   ,S
E383 A644             (    forth6809.asm):03826                     LDA   4,U
E385 E661             (    forth6809.asm):03827                     LDB   1,S
E387 3D               (    forth6809.asm):03828                     MUL
E388 EBE4             (    forth6809.asm):03829                     ADDB  ,S
E38A 2401             (    forth6809.asm):03830                     BCC   UM3
E38C 4C               (    forth6809.asm):03831                     INCA
E38D E744             (    forth6809.asm):03832         UM3:        STB   4,U
E38F 3262             (    forth6809.asm):03833                     LEAS  2,S
E391 39               (    forth6809.asm):03834                     RTS
                      (    forth6809.asm):03835         
                      (    forth6809.asm):03836         ; ------------------------------------------------------------
                      (    forth6809.asm):03837         ; >NUMBER  ( ud1 c-addr1 u1 -- ud2 c-addr2 u2 )
                      (    forth6809.asm):03838         ; Convert the string into ud1, in BASE, stopping at the first
                      (    forth6809.asm):03839         ; unconvertible character. Returns the accumulated ud2 and the
                      (    forth6809.asm):03840         ; remaining string. The conversion works in place on the three
                      (    forth6809.asm):03841         ; parameters (NUMLOOP), which are also the frame NUMBERQ builds.
                      (    forth6809.asm):03842         ; NUMLOOP
                      (    forth6809.asm):03843         ;    Inputs:
                      (    forth6809.asm):03844         ;        ( ud c-addr u ) on the data stack
                      (    forth6809.asm):03845         ;    Outputs:
                      (    forth6809.asm):03846         ;        ud accumulated; c-addr u = first unconverted character and
                      (    forth6809.asm):03847         ;        the count remaining
                      (    forth6809.asm):03848         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):03849         ; ------------------------------------------------------------
E392                  (    forth6809.asm):03850         TONUMBERW:
E392 ECC4             (    forth6809.asm):03851         NUMLOOP:    LDD   ,U
E394 2734             (    forth6809.asm):03852                     BEQ   NLDONE
E396 AE42             (    forth6809.asm):03853                     LDX   2,U
E398 A684             (    forth6809.asm):03854                     LDA   ,X
E39A 8130             (    forth6809.asm):03855                     CMPA  #'0'
E39C 252C             (    forth6809.asm):03856                     BLO   NLDONE
E39E 8139             (    forth6809.asm):03857                     CMPA  #'9'
E3A0 2204             (    forth6809.asm):03858                     BHI   NLALPHA

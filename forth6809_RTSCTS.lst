                      (    forth6809.asm):07558         ; Parse the text up to the next double quote for S", ." and ABORT".
                      (    forth6809.asm):07559         ; WORD cannot be used: it skips leading delimiters, so an empty string
                      (    forth6809.asm):07560         ; (S" ") ran on to the next quote in the source. PARSE does not skip.
                      (    forth6809.asm):07561         ; PARSEQUOTE
                      (    forth6809.asm):07562         ;    Inputs:
                      (    forth6809.asm):07563         ;        none (parses from >IN)
                      (    forth6809.asm):07564         ;    Outputs:
                      (    forth6809.asm):07565         ;        c-addr u on the data stack: the text in the input buffer.
                      (    forth6809.asm):07566         ;        THROW -18 if the text is longer than 255 characters.
                      (    forth6809.asm):07567         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):07568         ; ------------------------------------------------------------
E8DD CC0022           (    forth6809.asm):07569         PARSEQUOTE: LDD   #34
E8E0 3606             (    forth6809.asm):07570                     PSHU  D
E8E2 BDEAB3           (    forth6809.asm):07571                     JSR   PARSEW

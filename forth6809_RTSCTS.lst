                      (    forth6809.asm):00418         ; ============================================================
                      (    forth6809.asm):00419         ; SECTION 27: FORTH DICTIONARY (ROM base dictionary headers)
                      (    forth6809.asm):00420         ;
                      (    forth6809.asm):00421         ; One header per word, chained by LINK, placed at BASEDICT. Each
                      (    forth6809.asm):00422         ; header is: length|flags, name, LINK, CFA. Every CFA is the word's
                      (    forth6809.asm):00423         ; own code label (raw code entries, no trampoline), including TRUE
                      (    forth6809.asm):00424         ; and FALSE. DOES> is next to CREATE; its code label is DOESGTW
                      (    forth6809.asm):00425         ; because ">" is not valid in a label. ABORT and QUIT are
                      (    forth6809.asm):00426         ; hand-built. Headers are in search order (shadow SECTION27.1).
                      (    forth6809.asm):00427         ;
                      (    forth6809.asm):00428         ; Names containing a double-quote (S", ." and ABORT") have it split
                      (    forth6809.asm):00429         ; out of the FCC into a separate FCB $22.
                      (    forth6809.asm):00430         ; The original header comment is shadow SECTION27.0.
                      (    forth6809.asm):00431         ; ============================================================
                      (    forth6809.asm):00432         
                      (    forth6809.asm):00433                     ORG   BASEDICT
                      (    forth6809.asm):00434         ; ROOT wordlist: the Search-Order words. It is always searched, last,
                      (    forth6809.asm):00435         ; and FORTH continues into it (the link of the first FORTH header names
                      (    forth6809.asm):00436         ; BASEROOTLATEST), so FORTH-WORDLIST also contains these words.
                      (    forth6809.asm):00437         ; See shadow BASEROOTLATEST.1

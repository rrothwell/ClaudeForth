                      (    forth6809.asm):03880         ; ------------------------------------------------------------
                      (    forth6809.asm):03881         ; Convert a counted string to a number in BASE. A leading "-" negates
                      (    forth6809.asm):03882         ; it; a trailing "." makes it a double-cell number.
                      (    forth6809.asm):03883         ; NUMBERQ   ( c-addr -- n -1 | ud 1 | c-addr 0 )
                      (    forth6809.asm):03884         ;    Inputs:
                      (    forth6809.asm):03885         ;        c-addr of the counted string on the data stack
                      (    forth6809.asm):03886         ;    Outputs:
                      (    forth6809.asm):03887         ;        single number: n and -1
                      (    forth6809.asm):03888         ;        double number: ud (low cell below high cell) and 1
                      (    forth6809.asm):03889         ;        not a number: c-addr and 0
                      (    forth6809.asm):03890         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):03891         ; The original c-addr and the negate flag live in an S frame (0,S and
                      (    forth6809.asm):03892         ; 2,S); the count is kept in RegB. See shadow NUMBERQ.1 and
                      (    forth6809.asm):03893         ; NUMBERQ.6.
                      (    forth6809.asm):03894         ; ------------------------------------------------------------
E3CB 3710             (    forth6809.asm):03895         NUMBERQ:    PULU  X                 ; c-addr
E3CD 327D             (    forth6809.asm):03896                     LEAS  -3,S
E3CF AFE4             (    forth6809.asm):03897                     STX   ,S
E3D1 E684             (    forth6809.asm):03898                     LDB   ,X
E3D3 276D             (    forth6809.asm):03899                     BEQ   NQBAD
E3D5 3001             (    forth6809.asm):03900                     LEAX  1,X
                      (    forth6809.asm):03901         
                      (    forth6809.asm):03902                     ; A trailing "." means a double number: leave it out of the
                      (    forth6809.asm):03903                     ; digit count. See shadow: NUMBERQ.1
E3D7 5A               (    forth6809.asm):03904                     DECB
E3D8 A685             (    forth6809.asm):03905                     LDA   B,X
E3DA 5C               (    forth6809.asm):03906                     INCB
E3DB 812E             (    forth6809.asm):03907                     CMPA  #'.'
E3DD 2603             (    forth6809.asm):03908                     BNE   NQNOSIGN
E3DF 5A               (    forth6809.asm):03909                     DECB
E3E0 2760             (    forth6809.asm):03910                     BEQ   NQBAD             ; lone "." with nothing before it
                      (    forth6809.asm):03911         
E3E2 6F62             (    forth6809.asm):03912         NQNOSIGN:   CLR   2,S
E3E4 A684             (    forth6809.asm):03913                     LDA   ,X
E3E6 812D             (    forth6809.asm):03914                     CMPA  #'-'
E3E8 2607             (    forth6809.asm):03915                     BNE   NQNOSIGN2
E3EA 6362             (    forth6809.asm):03916                     COM   2,S
E3EC 3001             (    forth6809.asm):03917                     LEAX  1,X
E3EE 5A               (    forth6809.asm):03918                     DECB
E3EF 2751             (    forth6809.asm):03919                     BEQ   NQBAD
                      (    forth6809.asm):03920         
E3F1 108E0000         (    forth6809.asm):03921         NQNOSIGN2:  LDY   #0
E3F5 3620             (    forth6809.asm):03922                     PSHU  Y                 ; ud low
E3F7 3620             (    forth6809.asm):03923                     PSHU  Y                 ; ud high
E3F9 3610             (    forth6809.asm):03924                     PSHU  X                 ; c-addr
E3FB 4F               (    forth6809.asm):03925                     CLRA
E3FC 3606             (    forth6809.asm):03926                     PSHU  D                 ; u
                      (    forth6809.asm):03927         

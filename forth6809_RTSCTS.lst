                      (    forth6809.asm):05055         ; UNLOOP  ( -- )
                      (    forth6809.asm):05056         ; Discard the loop frame (index, limit, leave flag) beneath UNLOOP's
                      (    forth6809.asm):05057         ; return address, so that a following I or J sees the enclosing loop.
                      (    forth6809.asm):05058         ; ------------------------------------------------------------

                      (    forth6809.asm):07041         ; ------------------------------------------------------------
                      (    forth6809.asm):07042         ; CMOVE>  ( c-addr1 c-addr2 u -- )
                      (    forth6809.asm):07043         ; Copy u bytes from c-addr1 to c-addr2, starting at the high
                      (    forth6809.asm):07044         ; addresses.
                      (    forth6809.asm):07045         ; ------------------------------------------------------------
F380 ECC4             (    forth6809.asm):07046         CMOVEGTW:   LDD   ,U                ; u. Parameters stay on the data stack:
F382 2711             (    forth6809.asm):07047                     BEQ   CGDONE            ; u at 0, c-addr2 at 2, c-addr1 at 4
F384 AE44             (    forth6809.asm):07048                     LDX   4,U
F386 308B             (    forth6809.asm):07049                     LEAX  D,X               ; X = one past the end of the source
F388 10AE42           (    forth6809.asm):07050                     LDY   2,U
F38B 31AB             (    forth6809.asm):07051                     LEAY  D,Y               ; Y = one past the end of the destination
F38D A682             (    forth6809.asm):07052         CGLOOP:     LDA   ,-X
F38F A7A2             (    forth6809.asm):07053                     STA   ,-Y
F391 AC44             (    forth6809.asm):07054                     CMPX  4,U               ; back at the start of the source?
F393 26F8             (    forth6809.asm):07055                     BNE   CGLOOP
F395 3346             (    forth6809.asm):07056         CGDONE:     LEAU  6,U               ; drop the three parameters
F397 39               (    forth6809.asm):07057                     RTS
                      (    forth6809.asm):07058         
                      (    forth6809.asm):07059         ; ------------------------------------------------------------
                      (    forth6809.asm):07060         ; MOVE  ( addr1 addr2 u -- )
                      (    forth6809.asm):07061         ; Copy u bytes from addr1 to addr2, choosing CMOVE or CMOVE> so that
                      (    forth6809.asm):07062         ; overlapping regions are handled correctly.
                      (    forth6809.asm):07063         ; ------------------------------------------------------------
F398 EC42             (    forth6809.asm):07064         MOVEW:      LDD   2,U               ; addr2
F39A 10A344           (    forth6809.asm):07065                     CMPD  4,U               ; addr1
F39D 22E1             (    forth6809.asm):07066                     BHI   CMOVEGTW          ; addr2 above addr1: copy from the top
F39F 7EF366           (    forth6809.asm):07067                     JMP   CMOVEW
                      (    forth6809.asm):07068         
                      (    forth6809.asm):07069         ; ------------------------------------------------------------
                      (    forth6809.asm):07070         ; FILL  ( c-addr u char -- )

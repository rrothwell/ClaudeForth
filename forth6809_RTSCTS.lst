                      (    forth6809.asm):02626         
                      (    forth6809.asm):02627         ; ============================================================
                      (    forth6809.asm):02628         ; SECTION 5: INNER-INTERPRETER SUPPORT (LIT, ZBRANCH, BRANCH,
                      (    forth6809.asm):02629         ; DODOES, DODEFER, EXECUTE)
                      (    forth6809.asm):02630         ; ============================================================
                      (    forth6809.asm):02631         ; ------------------------------------------------------------
                      (    forth6809.asm):02632         ; Run-time for a literal: fetch the inline cell that follows the
                      (    forth6809.asm):02633         ; calling JSR, push it, and advance the return address past it.
                      (    forth6809.asm):02634         ; LIT   ( -- x )
                      (    forth6809.asm):02635         ;    Inputs:
                      (    forth6809.asm):02636         ;        return stack top = address of the inline 16-bit literal
                      (    forth6809.asm):02637         ;    Outputs:
                      (    forth6809.asm):02638         ;        x pushed on the data stack; return address advanced by 2
                      (    forth6809.asm):02639         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02640         ; ------------------------------------------------------------
D129 3510             (    forth6809.asm):02641         LIT:        PULS  X
D12B EC81             (    forth6809.asm):02642                     LDD   ,X++
D12D 3606             (    forth6809.asm):02643                     PSHU  D                 ; x
D12F 3410             (    forth6809.asm):02644                     PSHS  X
D131 39               (    forth6809.asm):02645                     RTS
                      (    forth6809.asm):02646         
                      (    forth6809.asm):02647         ; ------------------------------------------------------------
                      (    forth6809.asm):02648         ; Run-time for a conditional branch: take the inline offset if the
                      (    forth6809.asm):02649         ; flag is false, otherwise skip it. The offset is relative to its own
                      (    forth6809.asm):02650         ; address.
                      (    forth6809.asm):02651         ; ZBRANCH   ( flag -- )
                      (    forth6809.asm):02652         ;    Inputs:
                      (    forth6809.asm):02653         ;        flag on the data stack
                      (    forth6809.asm):02654         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02655         ;    Outputs:
                      (    forth6809.asm):02656         ;        flag removed; return address set to the branch target or past
                      (    forth6809.asm):02657         ;        the offset
                      (    forth6809.asm):02658         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02659         ; ------------------------------------------------------------
D132 3706             (    forth6809.asm):02660         ZBRANCH:    PULU  D                 ; flag
D134 3510             (    forth6809.asm):02661                     PULS  X
D136 10830000         (    forth6809.asm):02662                     CMPD  #0
D13A 2607             (    forth6809.asm):02663                     BNE   ZSKIP
D13C EC84             (    forth6809.asm):02664                     LDD   ,X
D13E 308B             (    forth6809.asm):02665                     LEAX  D,X
D140 3410             (    forth6809.asm):02666                     PSHS  X
D142 39               (    forth6809.asm):02667                     RTS
D143 3002             (    forth6809.asm):02668         ZSKIP:      LEAX  2,X
D145 3410             (    forth6809.asm):02669                     PSHS  X
D147 39               (    forth6809.asm):02670                     RTS
                      (    forth6809.asm):02671         
                      (    forth6809.asm):02672         ; ------------------------------------------------------------
                      (    forth6809.asm):02673         ; Run-time for an unconditional branch: add the inline offset
                      (    forth6809.asm):02674         ; (relative to its own address) to the return address.
                      (    forth6809.asm):02675         ; BRANCH
                      (    forth6809.asm):02676         ;    Inputs:
                      (    forth6809.asm):02677         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02678         ;    Outputs:
                      (    forth6809.asm):02679         ;        return address set to the branch target
                      (    forth6809.asm):02680         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02681         ; ------------------------------------------------------------
D148 3510             (    forth6809.asm):02682         BRANCH:     PULS  X
D14A EC84             (    forth6809.asm):02683                     LDD   ,X
D14C 308B             (    forth6809.asm):02684                     LEAX  D,X
D14E 3410             (    forth6809.asm):02685                     PSHS  X
D150 39               (    forth6809.asm):02686                     RTS
                      (    forth6809.asm):02687         
                      (    forth6809.asm):02688         ; ------------------------------------------------------------
                      (    forth6809.asm):02689         ; Run-time entry of a CREATEd or DOES>-defined word. Its code is a
                      (    forth6809.asm):02690         ; trampoline: JSR DODOES, a BEHAVIOR address, then the data-field
                      (    forth6809.asm):02691         ; address. Pushes the data-field address and jumps to BEHAVIOR.
                      (    forth6809.asm):02692         ; DODOES   ( -- pfa )
                      (    forth6809.asm):02693         ;    Inputs:
                      (    forth6809.asm):02694         ;        return stack top = address of the BEHAVIOR cell in the
                      (    forth6809.asm):02695         ;        trampoline
                      (    forth6809.asm):02696         ;    Outputs:
                      (    forth6809.asm):02697         ;        pfa pushed on the data stack; control passes to BEHAVIOR
                      (    forth6809.asm):02698         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02699         ; ------------------------------------------------------------
D151 3510             (    forth6809.asm):02700         DODOES:     PULS  X
D153 10AE81           (    forth6809.asm):02701                     LDY   ,X++
D156 EC84             (    forth6809.asm):02702                     LDD   ,X
D158 3606             (    forth6809.asm):02703                     PSHU  D                 ; pfa
D15A 6EA4             (    forth6809.asm):02704                     JMP   ,Y
                      (    forth6809.asm):02705         
                      (    forth6809.asm):02706         ; ------------------------------------------------------------
                      (    forth6809.asm):02707         ; Default BEHAVIOR for a CREATEd word: do nothing, leaving the data-
                      (    forth6809.asm):02708         ; field address on the stack.
                      (    forth6809.asm):02709         ; DOESRT0
                      (    forth6809.asm):02710         ;    Inputs:
                      (    forth6809.asm):02711         ;        none
                      (    forth6809.asm):02712         ;    Outputs:
                      (    forth6809.asm):02713         ;        none
                      (    forth6809.asm):02714         ;    Registers: none.
                      (    forth6809.asm):02715         ; ------------------------------------------------------------
D15C 39               (    forth6809.asm):02716         DOESRT0:    RTS
                      (    forth6809.asm):02717         
                      (    forth6809.asm):02718         ; ------------------------------------------------------------
                      (    forth6809.asm):02719         ; Run-time for DOES>: patch the BEHAVIOR cell of the most recent
                      (    forth6809.asm):02720         ; definition with the code that follows the calling JSR, then return
                      (    forth6809.asm):02721         ; two levels up, skipping the rest of the defining word.
                      (    forth6809.asm):02722         ; SETDOES
                      (    forth6809.asm):02723         ;    Inputs:
                      (    forth6809.asm):02724         ;        return stack top = address after "JSR SETDOES" (the new
                      (    forth6809.asm):02725         ;        BEHAVIOR)
                      (    forth6809.asm):02726         ;        next on the return stack = the defining word's own return
                      (    forth6809.asm):02727         ;        address
                      (    forth6809.asm):02728         ;    Outputs:
                      (    forth6809.asm):02729         ;        BEHAVIOR cell of LATEST patched; control returns to the
                      (    forth6809.asm):02730         ;        defining word's caller
                      (    forth6809.asm):02731         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02732         ; ------------------------------------------------------------
D15D 3510             (    forth6809.asm):02733         SETDOES:    PULS  X                 ; X = addr right after "JSR SETDOES" - new BEHAVIOR
D15F 1F12             (    forth6809.asm):02734                     TFR   X,Y               ; Y = new BEHAVIOR, kept across the walk
                      (    forth6809.asm):02735         
D161 9E04             (    forth6809.asm):02736                     LDX   LATEST
D163 E684             (    forth6809.asm):02737                     LDB   ,X
D165 C41F             (    forth6809.asm):02738                     ANDB  #$1F
D167 4F               (    forth6809.asm):02739                     CLRA
D168 308B             (    forth6809.asm):02740                     LEAX  D,X               ; header + name length
D16A EC03             (    forth6809.asm):02741                     LDD   3,X               ; D = CFA (trampoline address), past name and LINK
D16C C30003           (    forth6809.asm):02742                     ADDD  #3                ; +3 -> BEHAVIOR field (past JSR DODOES)
D16F 1F01             (    forth6809.asm):02743                     TFR   D,X
                      (    forth6809.asm):02744         
D171 10AF84           (    forth6809.asm):02745                     STY   ,X                ; patch it
                      (    forth6809.asm):02746         
D174 3510             (    forth6809.asm):02747                     PULS  X                 ; X = the OUTER defining word's own return addr
D176 6E84             (    forth6809.asm):02748                     JMP   ,X                ; jump there directly - "double RTS"
                      (    forth6809.asm):02749         
                      (    forth6809.asm):02750         ; ------------------------------------------------------------
                      (    forth6809.asm):02751         ; BEHAVIOR of a DEFERred word: execute the xt stored in its data
                      (    forth6809.asm):02752         ; field. Tail-calls the xt, so it returns to the original caller.
                      (    forth6809.asm):02753         ; DODEFER   ( pfa -- )
                      (    forth6809.asm):02754         ;    Inputs:
                      (    forth6809.asm):02755         ;        pfa on the data stack
                      (    forth6809.asm):02756         ;    Outputs:
                      (    forth6809.asm):02757         ;        pfa removed; the stored xt is executed
                      (    forth6809.asm):02758         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02759         ; ------------------------------------------------------------
D178 3710             (    forth6809.asm):02760         DODEFER:    PULU  X                 ; pfa
D17A EC84             (    forth6809.asm):02761                     LDD   ,X
D17C 1F01             (    forth6809.asm):02762                     TFR   D,X
D17E 6E84             (    forth6809.asm):02763                     JMP   ,X
                      (    forth6809.asm):02764         
                      (    forth6809.asm):02765         ; ------------------------------------------------------------
                      (    forth6809.asm):02766         ; Initial xt of a DEFER: throws -21 until IS stores a real xt.
                      (    forth6809.asm):02767         ; DOABORTUNDEF
                      (    forth6809.asm):02768         ;    Inputs:
                      (    forth6809.asm):02769         ;        none
                      (    forth6809.asm):02770         ;    Outputs:
                      (    forth6809.asm):02771         ;        none (does not return)
                      (    forth6809.asm):02772         ;    Registers: RegD changed.
                      (    forth6809.asm):02773         ; ------------------------------------------------------------
D180                  (    forth6809.asm):02774         DOABORTUNDEF:
D180 CCFFEB           (    forth6809.asm):02775                     LDD   #-21
D183 3606             (    forth6809.asm):02776                     PSHU  D                 ; throw code (-21)
D185 7EDA80           (    forth6809.asm):02777                     JMP   THROWW
                      (    forth6809.asm):02778         
                      (    forth6809.asm):02779         ; ------------------------------------------------------------
                      (    forth6809.asm):02780         ; BEHAVIOR of a MARKER word: restore the dictionary, code and variable
                      (    forth6809.asm):02781         ; pointers and LATEST from the four cells saved when it was defined,
                      (    forth6809.asm):02782         ; then the search order state (SRCHSAVESZ bytes after them), then
                      (    forth6809.asm):02783         ; unlink every RAM header newer than DPHERE from every wordlist.
                      (    forth6809.asm):02784         ; DOMARKER   ( pfa -- )
                      (    forth6809.asm):02785         ;    Inputs:
                      (    forth6809.asm):02786         ;        pfa on the data stack (the saved cells)
                      (    forth6809.asm):02787         ;    Outputs:
                      (    forth6809.asm):02788         ;        pfa removed; DPHERE, CODEHERE, VARHERE, LATEST, WLEND, CURRENT
                      (    forth6809.asm):02789         ;        and the search order restored; wordlists pruned
                      (    forth6809.asm):02790         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02791         ; ------------------------------------------------------------
D188 3710             (    forth6809.asm):02792         DOMARKER:   PULU  X                 ; pfa
D18A EC84             (    forth6809.asm):02793                     LDD   ,X
D18C DD06             (    forth6809.asm):02794                     STD   DPHERE
D18E EC02             (    forth6809.asm):02795                     LDD   2,X
D190 DD08             (    forth6809.asm):02796                     STD   CODEHERE
D192 EC04             (    forth6809.asm):02797                     LDD   4,X
D194 DD0A             (    forth6809.asm):02798                     STD   VARHERE
D196 EC06             (    forth6809.asm):02799                     LDD   6,X
D198 DD04             (    forth6809.asm):02800                     STD   LATEST
D19A 3008             (    forth6809.asm):02801                     LEAX  8,X               ; the saved search-order state follows
D19C 108E0045         (    forth6809.asm):02802                     LDY   #SRCHSAVE
D1A0 C616             (    forth6809.asm):02803                     LDB   #SRCHSAVESZ
D1A2 A680             (    forth6809.asm):02804         DMCOPY:     LDA   ,X+
D1A4 A7A0             (    forth6809.asm):02805                     STA   ,Y+
D1A6 5A               (    forth6809.asm):02806                     DECB
D1A7 26F9             (    forth6809.asm):02807                     BNE   DMCOPY
D1A9 DC06             (    forth6809.asm):02808                     LDD   DPHERE
D1AB 7ED6EF           (    forth6809.asm):02809                     JMP   PRUNE             ; unlink headers newer than DPHERE
                      (    forth6809.asm):02810         
                      (    forth6809.asm):02811         ; ------------------------------------------------------------
                      (    forth6809.asm):02812         ; EXECUTE  ( i*x xt -- j*x )
                      (    forth6809.asm):02813         ; Execute the word whose execution token is xt.
                      (    forth6809.asm):02814         ; ------------------------------------------------------------
D1AE 3710             (    forth6809.asm):02815         EXECUTEW:   PULU  X                 ; xt
D1B0 AD84             (    forth6809.asm):02816                     JSR   ,X
D1B2 39               (    forth6809.asm):02817                     RTS
                      (    forth6809.asm):02818         
                      (    forth6809.asm):02819         ; ============================================================
                      (    forth6809.asm):02820         ; SECTION 6: COMMA FAMILY (factored via APPENDCELL/APPENDBYTE)
                      (    forth6809.asm):02821         ; ============================================================
                      (    forth6809.asm):02822         ; ------------------------------------------------------------
                      (    forth6809.asm):02823         ; Append a 16-bit cell to the area whose "here" pointer is at RegX
                      (    forth6809.asm):02824         ; (CODEHERE or VARHERE), and advance that pointer by 2.
                      (    forth6809.asm):02825         ; APPENDCELL   ( x -- )
                      (    forth6809.asm):02826         ;    Inputs:
                      (    forth6809.asm):02827         ;        RegX = address of the here pointer
                      (    forth6809.asm):02828         ;        x on the data stack
                      (    forth6809.asm):02829         ;    Outputs:
                      (    forth6809.asm):02830         ;        x stored at the old here value; pointer advanced by 2
                      (    forth6809.asm):02831         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02832         ; ------------------------------------------------------------
D1B3 3706             (    forth6809.asm):02833         APPENDCELL: PULU  D                 ; x
D1B5 10AE84           (    forth6809.asm):02834                     LDY   ,X
D1B8 EDA1             (    forth6809.asm):02835                     STD   ,Y++
D1BA 10AF84           (    forth6809.asm):02836                     STY   ,X
D1BD 39               (    forth6809.asm):02837                     RTS
                      (    forth6809.asm):02838         
                      (    forth6809.asm):02839         ; ------------------------------------------------------------
                      (    forth6809.asm):02840         ; Append the low byte of the top cell to the area whose "here" pointer
                      (    forth6809.asm):02841         ; is at RegX (CODEHERE or VARHERE), and advance that pointer by 1.
                      (    forth6809.asm):02842         ; APPENDBYTE   ( char -- )
                      (    forth6809.asm):02843         ;    Inputs:
                      (    forth6809.asm):02844         ;        RegX = address of the here pointer
                      (    forth6809.asm):02845         ;        char on the data stack
                      (    forth6809.asm):02846         ;    Outputs:
                      (    forth6809.asm):02847         ;        char stored at the old here value; pointer advanced by 1
                      (    forth6809.asm):02848         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02849         ; ------------------------------------------------------------
D1BE 3706             (    forth6809.asm):02850         APPENDBYTE: PULU  D                 ; char
D1C0 10AE84           (    forth6809.asm):02851                     LDY   ,X
D1C3 E7A0             (    forth6809.asm):02852                     STB   ,Y+
D1C5 10AF84           (    forth6809.asm):02853                     STY   ,X
D1C8 39               (    forth6809.asm):02854                     RTS
                      (    forth6809.asm):02855         
                      (    forth6809.asm):02856         ; ------------------------------------------------------------
                      (    forth6809.asm):02857         ; ,  ( x -- )
                      (    forth6809.asm):02858         ; Append x to the code/data area (CODEHERE).
                      (    forth6809.asm):02859         ; ------------------------------------------------------------
D1C9 8E0008           (    forth6809.asm):02860         COMMAW:     LDX   #CODEHERE
D1CC 7ED1B3           (    forth6809.asm):02861                     JMP   APPENDCELL
                      (    forth6809.asm):02862         
                      (    forth6809.asm):02863         ; ------------------------------------------------------------
                      (    forth6809.asm):02864         ; CODECOMMA  ( x -- )
                      (    forth6809.asm):02865         ; Internal name for ",": append x at CODEHERE.
                      (    forth6809.asm):02866         ; ------------------------------------------------------------
D1CF 8E0008           (    forth6809.asm):02867         CODECOMMA:  LDX   #CODEHERE
D1D2 7ED1B3           (    forth6809.asm):02868                     JMP   APPENDCELL
                      (    forth6809.asm):02869         
                      (    forth6809.asm):02870         ; ------------------------------------------------------------
                      (    forth6809.asm):02871         ; C,  ( char -- )
                      (    forth6809.asm):02872         ; Append char to the code/data area (CODEHERE).
                      (    forth6809.asm):02873         ; ------------------------------------------------------------
D1D5 8E0008           (    forth6809.asm):02874         CCOMMAW:    LDX   #CODEHERE
D1D8 7ED1BE           (    forth6809.asm):02875                     JMP   APPENDBYTE
                      (    forth6809.asm):02876         
                      (    forth6809.asm):02877         ; ------------------------------------------------------------
                      (    forth6809.asm):02878         ; CCOMMA1  ( char -- )
                      (    forth6809.asm):02879         ; Internal name for "C,": append char at CODEHERE.
                      (    forth6809.asm):02880         ; ------------------------------------------------------------
D1DB 8E0008           (    forth6809.asm):02881         CCOMMA1:    LDX   #CODEHERE
D1DE 7ED1BE           (    forth6809.asm):02882                     JMP   APPENDBYTE
                      (    forth6809.asm):02883         
                      (    forth6809.asm):02884         ; ------------------------------------------------------------
                      (    forth6809.asm):02885         ; V,  ( x -- )
                      (    forth6809.asm):02886         ; Append x to the variable area (VARHERE).
                      (    forth6809.asm):02887         ; ------------------------------------------------------------
D1E1 8E000A           (    forth6809.asm):02888         VCOMMAW:    LDX   #VARHERE
D1E4 7ED1B3           (    forth6809.asm):02889                     JMP   APPENDCELL
                      (    forth6809.asm):02890         
                      (    forth6809.asm):02891         ; ------------------------------------------------------------
                      (    forth6809.asm):02892         ; VC,  ( char -- )
                      (    forth6809.asm):02893         ; Append char to the variable area (VARHERE).
                      (    forth6809.asm):02894         ; ------------------------------------------------------------
D1E7 8E000A           (    forth6809.asm):02895         VCCOMMAW:   LDX   #VARHERE
D1EA 7ED1BE           (    forth6809.asm):02896                     JMP   APPENDBYTE
                      (    forth6809.asm):02897         
                      (    forth6809.asm):02898         ; ------------------------------------------------------------
                      (    forth6809.asm):02899         ; ALLOT  ( n -- )
                      (    forth6809.asm):02900         ; Reserve n bytes in the code/data area by advancing CODEHERE.
                      (    forth6809.asm):02901         ; ------------------------------------------------------------
D1ED 3706             (    forth6809.asm):02902         ALLOTW:     PULU  D                 ; n
D1EF 9E08             (    forth6809.asm):02903                     LDX   CODEHERE
D1F1 308B             (    forth6809.asm):02904                     LEAX  D,X
D1F3 9F08             (    forth6809.asm):02905                     STX   CODEHERE
D1F5 39               (    forth6809.asm):02906                     RTS
                      (    forth6809.asm):02907         
                      (    forth6809.asm):02908         ; ------------------------------------------------------------
                      (    forth6809.asm):02909         ; VALLOT  ( n -- )
                      (    forth6809.asm):02910         ; Reserve n bytes in the variable area by advancing VARHERE.
                      (    forth6809.asm):02911         ; ------------------------------------------------------------
D1F6 3706             (    forth6809.asm):02912         VALLOTW:    PULU  D                 ; n
D1F8 9E0A             (    forth6809.asm):02913                     LDX   VARHERE
D1FA 308B             (    forth6809.asm):02914                     LEAX  D,X
D1FC 9F0A             (    forth6809.asm):02915                     STX   VARHERE
D1FE 39               (    forth6809.asm):02916                     RTS
                      (    forth6809.asm):02917         
                      (    forth6809.asm):02918         ; ------------------------------------------------------------
                      (    forth6809.asm):02919         ; HERE  ( -- addr )
                      (    forth6809.asm):02920         ; Return the next free address in the code/data area (CODEHERE).
                      (    forth6809.asm):02921         ; ------------------------------------------------------------
D1FF DC08             (    forth6809.asm):02922         HEREW:      LDD   CODEHERE
D201 3606             (    forth6809.asm):02923                     PSHU  D                 ; addr
D203 39               (    forth6809.asm):02924                     RTS
                      (    forth6809.asm):02925         
                      (    forth6809.asm):02926         ; ------------------------------------------------------------
                      (    forth6809.asm):02927         ; VHERE  ( -- addr )
                      (    forth6809.asm):02928         ; Return the next free address in the variable area (VARHERE).
                      (    forth6809.asm):02929         ; ------------------------------------------------------------
D204 DC0A             (    forth6809.asm):02930         VHEREW:     LDD   VARHERE
D206 3606             (    forth6809.asm):02931                     PSHU  D                 ; addr
D208 39               (    forth6809.asm):02932                     RTS
                      (    forth6809.asm):02933         
                      (    forth6809.asm):02934         ; ------------------------------------------------------------
                      (    forth6809.asm):02935         ; PAD  ( -- c-addr )
                      (    forth6809.asm):02936         ; Return the scratch buffer address, PADOFFSET bytes above CODEHERE.
                      (    forth6809.asm):02937         ; ------------------------------------------------------------
D209 DC08             (    forth6809.asm):02938         PADW:       LDD   CODEHERE
D20B C30080           (    forth6809.asm):02939                     ADDD  #PADOFFSET
D20E 3606             (    forth6809.asm):02940                     PSHU  D                 ; c-addr
D210 39               (    forth6809.asm):02941                     RTS
                      (    forth6809.asm):02942         
                      (    forth6809.asm):02943         ; ------------------------------------------------------------
                      (    forth6809.asm):02944         ; UNUSED  ( -- u )
                      (    forth6809.asm):02945         ; Return the number of free bytes remaining in the code/data area.
                      (    forth6809.asm):02946         ; ------------------------------------------------------------
D211 CCB900           (    forth6809.asm):02947         UNUSEDW:    LDD   #CODETOP
D214 9308             (    forth6809.asm):02948                     SUBD  CODEHERE
D216 3606             (    forth6809.asm):02949                     PSHU  D                 ; u
D218 39               (    forth6809.asm):02950                     RTS
                      (    forth6809.asm):02951         
                      (    forth6809.asm):02952         ; ------------------------------------------------------------
                      (    forth6809.asm):02953         ; VUNUSED  ( -- u )
                      (    forth6809.asm):02954         ; Return the number of free bytes remaining in the variable area.
                      (    forth6809.asm):02955         ; ------------------------------------------------------------
D219 CC1FFF           (    forth6809.asm):02956         VUNUSEDW:   LDD   #APPVARSEND       ; See bugfix: VUNUSEDW.1
D21C 930A             (    forth6809.asm):02957                     SUBD  VARHERE
D21E 3606             (    forth6809.asm):02958                     PSHU  D                 ; u
D220 39               (    forth6809.asm):02959                     RTS
                      (    forth6809.asm):02960         
                      (    forth6809.asm):02961         ; ============================================================
                      (    forth6809.asm):02962         ; SECTION 7: HEADER (factored from :/CREATE/VARIABLE)
                      (    forth6809.asm):02963         ; ============================================================
                      (    forth6809.asm):02964         ; ------------------------------------------------------------
                      (    forth6809.asm):02965         ; Build a dictionary header for the next name in the input: parse the
                      (    forth6809.asm):02966         ; name, then lay down the length byte (with the smudge bit set if
                      (    forth6809.asm):02967         ; requested), the name, the link to the previous header and the code
                      (    forth6809.asm):02968         ; field address (CODEHERE). LATEST, DPHERE and the head of the CURRENT
                      (    forth6809.asm):02969         ; wordlist are updated.
                      (    forth6809.asm):02970         ; HEADER   ( smudge-flag "name" -- )   Throws -16 for an empty name and
                      (    forth6809.asm):02971         ;    -19 for a name of more than 31 characters (the length byte holds the
                      (    forth6809.asm):02972         ;    length in bits 0-4 and the flags in bits 5-7).
                      (    forth6809.asm):02973         ;    Inputs:
                      (    forth6809.asm):02974         ;        smudge-flag on the data stack (non-zero hides the new word)
                      (    forth6809.asm):02975         ;        name parsed from the input stream
                      (    forth6809.asm):02976         ;    Outputs:
                      (    forth6809.asm):02977         ;        header built at DPHERE, linked into the CURRENT wordlist;
                      (    forth6809.asm):02978         ;        LATEST = address of the new header
                      (    forth6809.asm):02979         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02980         ; ------------------------------------------------------------
D221 CC0020           (    forth6809.asm):02981         HEADER:     LDD   #32
D224 3606             (    forth6809.asm):02982                     PSHU  D
D226 BDD578           (    forth6809.asm):02983                     JSR   WORDW
D229 3710             (    forth6809.asm):02984                     PULU  X                 ; c-addr of the name
D22B 3706             (    forth6809.asm):02985                     PULU  D                 ; smudge flag in B
D22D A680             (    forth6809.asm):02986                     LDA   ,X+               ; name length, X = name text
D22F 2731             (    forth6809.asm):02987                     BEQ   HDZERO            ; no name: throw -16
D231 811F             (    forth6809.asm):02988                     CMPA  #31
D233 2232             (    forth6809.asm):02989                     BHI   HDLONG            ; over 31 characters: throw -19
D235 3402             (    forth6809.asm):02990                     PSHS  A                 ; 2,S = length (5k: S-frame, no scratch)
D237 5D               (    forth6809.asm):02991                     TSTB
D238 2702             (    forth6809.asm):02992                     BEQ   HDNOSM
D23A 8A40             (    forth6809.asm):02993                     ORA   #$40
D23C 109E06           (    forth6809.asm):02994         HDNOSM:     LDY   DPHERE
D23F 3420             (    forth6809.asm):02995                     PSHS  Y                 ; 0,S = address of the new header
D241 A7A0             (    forth6809.asm):02996                     STA   ,Y+
D243 E662             (    forth6809.asm):02997                     LDB   2,S               ; length is 1 to 31 here
D245 A680             (    forth6809.asm):02998         HDCPY:      LDA   ,X+
D247 A7A0             (    forth6809.asm):02999                     STA   ,Y+
D249 5A               (    forth6809.asm):03000                     DECB
D24A 26F9             (    forth6809.asm):03001                     BNE   HDCPY
D24C 9E47             (    forth6809.asm):03002                     LDX   CURRENT           ; X = WID of the wordlist receiving the word
D24E EC84             (    forth6809.asm):03003                     LDD   ,X
D250 EDA1             (    forth6809.asm):03004                     STD   ,Y++              ; LINK = old head of that wordlist
D252 DC08             (    forth6809.asm):03005                     LDD   CODEHERE
D254 EDA1             (    forth6809.asm):03006                     STD   ,Y++
D256 109F06           (    forth6809.asm):03007                     STY   DPHERE
D259 3506             (    forth6809.asm):03008                     PULS  D
D25B DD04             (    forth6809.asm):03009                     STD   LATEST            ; LATEST = newest header of any wordlist
D25D ED84             (    forth6809.asm):03010                     STD   ,X                ; and the new head of the CURRENT wordlist
D25F 3261             (    forth6809.asm):03011                     LEAS  1,S
D261 39               (    forth6809.asm):03012                     RTS
D262 CCFFF0           (    forth6809.asm):03013         HDZERO:     LDD   #-16              ; attempt to use zero-length string as a name
D265 2003             (    forth6809.asm):03014                     BRA   HDTHROW
D267 CCFFED           (    forth6809.asm):03015         HDLONG:     LDD   #-19              ; definition name too long (flags need bits 5-7)
D26A 3606             (    forth6809.asm):03016         HDTHROW:    PSHU  D
D26C 7EDA80           (    forth6809.asm):03017                     JMP   THROWW
                      (    forth6809.asm):03018         
                      (    forth6809.asm):03019         ; ------------------------------------------------------------
                      (    forth6809.asm):03020         ; Toggle the smudge bit (bit 6 of the length|flags byte) of the newest
                      (    forth6809.asm):03021         ; header, the one LATEST names. A smudged word is hidden from FIND, so
                      (    forth6809.asm):03022         ; HEADER with a true flag, then SMUDGE once the word is complete,
                      (    forth6809.asm):03023         ; brackets the definition of a word such as CODE ... END-CODE.
                      (    forth6809.asm):03024         ; SMUDGE   ( -- )
                      (    forth6809.asm):03025         ;    Inputs:
                      (    forth6809.asm):03026         ;        none
                      (    forth6809.asm):03027         ;    Outputs:
                      (    forth6809.asm):03028         ;        bit 6 of the length|flags byte at LATEST inverted
                      (    forth6809.asm):03029         ;    Registers: RegA, RegX and CC changed.
                      (    forth6809.asm):03030         ; ------------------------------------------------------------
D26F 9E04             (    forth6809.asm):03031         SMUDGEW:    LDX   LATEST
D271 A684             (    forth6809.asm):03032                     LDA   ,X
D273 8840             (    forth6809.asm):03033                     EORA  #$40
D275 A784             (    forth6809.asm):03034                     STA   ,X
D277 39               (    forth6809.asm):03035                     RTS
                      (    forth6809.asm):03036         
                      (    forth6809.asm):03037         ; ============================================================
                      (    forth6809.asm):03038         ; SECTION 8: DEFINING WORDS
                      (    forth6809.asm):03039         ; ============================================================
                      (    forth6809.asm):03040         ; ------------------------------------------------------------
                      (    forth6809.asm):03041         ; :  ( "name" -- )
                      (    forth6809.asm):03042         ; Start a colon definition: parse the name, build a smudged header,
                      (    forth6809.asm):03043         ; record the new xt in CURXT, note the control-flow stack position in
                      (    forth6809.asm):03044         ; CSP and enter compile state.
                      (    forth6809.asm):03045         ; ------------------------------------------------------------
D278 CCFFFF           (    forth6809.asm):03046         COLONW:     LDD   #TRUEV
D27B 3606             (    forth6809.asm):03047                     PSHU  D
D27D BDD221           (    forth6809.asm):03048                     JSR   HEADER
D280 DC08             (    forth6809.asm):03049                     LDD   CODEHERE          ; Record this word's xt for RECURSE.
D282 DD1F             (    forth6809.asm):03050                     STD   CURXT             ; See bugfix: COLONW.1
D284 1F30             (    forth6809.asm):03051                     TFR   U,D
D286 DD21             (    forth6809.asm):03052                     STD   CSP
D288 CCFFFF           (    forth6809.asm):03053                     LDD   #-1
D28B DD00             (    forth6809.asm):03054                     STD   STATE
D28D 39               (    forth6809.asm):03055                     RTS
                      (    forth6809.asm):03056         
                      (    forth6809.asm):03057         ; ------------------------------------------------------------
                      (    forth6809.asm):03058         ; ;  ( -- )  IMMEDIATE
                      (    forth6809.asm):03059         ; End a colon definition: compile RTS, check that the control-flow
                      (    forth6809.asm):03060         ; stack is balanced (error -22 if not), clear the smudge bit of the
                      (    forth6809.asm):03061         ; new word and return to interpret state.
                      (    forth6809.asm):03062         ; ------------------------------------------------------------
D28E CC0039           (    forth6809.asm):03063         SEMIW:      LDD   #RTSOPC
D291 3606             (    forth6809.asm):03064                     PSHU  D
D293 BDD1DB           (    forth6809.asm):03065                     JSR   CCOMMA1
D296 1F30             (    forth6809.asm):03066                     TFR   U,D
D298 109321           (    forth6809.asm):03067                     CMPD  CSP
D29B 2703             (    forth6809.asm):03068                     BEQ   SEMIOK
D29D BDDA4B           (    forth6809.asm):03069                     JSR   CFERR
D2A0 9E04             (    forth6809.asm):03070         SEMIOK:     LDX   LATEST
D2A2 A684             (    forth6809.asm):03071                     LDA   ,X
D2A4 84BF             (    forth6809.asm):03072                     ANDA  #$BF
D2A6 A784             (    forth6809.asm):03073                     STA   ,X
D2A8 CC0000           (    forth6809.asm):03074                     LDD   #0
D2AB DD00             (    forth6809.asm):03075                     STD   STATE
D2AD 39               (    forth6809.asm):03076                     RTS
                      (    forth6809.asm):03077         
                      (    forth6809.asm):03078         ; ------------------------------------------------------------
                      (    forth6809.asm):03079         ; :NONAME  ( -- xt )
                      (    forth6809.asm):03080         ; Start an anonymous definition: no header is built and LATEST is left
                      (    forth6809.asm):03081         ; alone, so the word can never be found. Leaves the xt (the current
                      (    forth6809.asm):03082         ; CODEHERE) on the stack, records it in CURXT, notes the control-flow
                      (    forth6809.asm):03083         ; stack position in CSP and enters compile state.
                      (    forth6809.asm):03084         ; Original comment: shadow NONAMEW.0.
                      (    forth6809.asm):03085         ; ------------------------------------------------------------
D2AE DC08             (    forth6809.asm):03086         NONAMEW:    LDD   CODEHERE
D2B0 3606             (    forth6809.asm):03087                     PSHU  D                 ; xt
D2B2 DD1F             (    forth6809.asm):03088                     STD   CURXT             ; See bugfix: NONAMEW.1
D2B4 1F30             (    forth6809.asm):03089                     TFR   U,D
D2B6 DD21             (    forth6809.asm):03090                     STD   CSP
D2B8 CCFFFF           (    forth6809.asm):03091                     LDD   #-1
D2BB DD00             (    forth6809.asm):03092                     STD   STATE
D2BD 39               (    forth6809.asm):03093                     RTS
                      (    forth6809.asm):03094         
                      (    forth6809.asm):03095         ; ------------------------------------------------------------
                      (    forth6809.asm):03096         ; Common start of every DODOES-style defining word: build a header
                      (    forth6809.asm):03097         ; and compile the DODOES trampoline followed by the behaviour address.
                      (    forth6809.asm):03098         ; BLDDOES
                      (    forth6809.asm):03099         ;    Inputs:
                      (    forth6809.asm):03100         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):03101         ;    Outputs:
                      (    forth6809.asm):03102         ;        header built, trampoline and behaviour cell compiled
                      (    forth6809.asm):03103         ;    Registers: all changed.
                      (    forth6809.asm):03104         ; BLDSELF
                      (    forth6809.asm):03105         ;    Inputs:
                      (    forth6809.asm):03106         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):03107         ;    Outputs:
                      (    forth6809.asm):03108         ;        as BLDDOES, then the PFA cell compiled pointing at the
                      (    forth6809.asm):03109         ;        cell that follows it (the word's own data field)
                      (    forth6809.asm):03110         ;    Registers: all changed.
                      (    forth6809.asm):03111         ; Used by CREATE, CONSTANT, 2CONSTANT, DEFER and MARKER (BLDSELF)
                      (    forth6809.asm):03112         ; and by VALUE (BLDDOES, which supplies its own PFA).
                      (    forth6809.asm):03113         ; ------------------------------------------------------------
D2BE 3406             (    forth6809.asm):03114         BLDDOES:    PSHS  D                 ; behaviour address
D2C0 CC0000           (    forth6809.asm):03115                     LDD   #0
D2C3 3606             (    forth6809.asm):03116                     PSHU  D
D2C5 BDD221           (    forth6809.asm):03117                     JSR   HEADER
D2C8 CCD151           (    forth6809.asm):03118                     LDD   #DODOES
D2CB 3606             (    forth6809.asm):03119                     PSHU  D
D2CD BDDEBB           (    forth6809.asm):03120                     JSR   CCALL
D2D0 3506             (    forth6809.asm):03121                     PULS  D
D2D2 3606             (    forth6809.asm):03122                     PSHU  D                 ; behaviour address
D2D4 BDD1CF           (    forth6809.asm):03123                     JSR   CODECOMMA
D2D7 39               (    forth6809.asm):03124                     RTS
                      (    forth6809.asm):03125         
D2D8 BDD2BE           (    forth6809.asm):03126         BLDSELF:    JSR   BLDDOES
D2DB DC08             (    forth6809.asm):03127                     LDD   CODEHERE          ; PFA = the cell after this one
D2DD C30002           (    forth6809.asm):03128                     ADDD  #2                ; See bugfix: CONSTANTW.1
D2E0 3606             (    forth6809.asm):03129                     PSHU  D
D2E2 BDD1CF           (    forth6809.asm):03130                     JSR   CODECOMMA
D2E5 39               (    forth6809.asm):03131                     RTS
                      (    forth6809.asm):03132         
                      (    forth6809.asm):03133         ; ------------------------------------------------------------
                      (    forth6809.asm):03134         ; CREATE  ( "name" -- )
                      (    forth6809.asm):03135         ; Build a header whose code is a DODOES trampoline. The default
                      (    forth6809.asm):03136         ; behaviour (DOESRT0) leaves the data-field address, the next free
                      (    forth6809.asm):03137         ; address in the code area, on the stack.
                      (    forth6809.asm):03138         ; ------------------------------------------------------------
D2E6 CCD15C           (    forth6809.asm):03139         CREATEW:    LDD   #DOESRT0
D2E9 BDD2D8           (    forth6809.asm):03140                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
D2EC 39               (    forth6809.asm):03141                     RTS
                      (    forth6809.asm):03142         
                      (    forth6809.asm):03143         ; ------------------------------------------------------------
                      (    forth6809.asm):03144         ; DOES>  ( -- )  IMMEDIATE, compile-only
                      (    forth6809.asm):03145         ; Compile a call to SETDOES, which at run time patches the behaviour
                      (    forth6809.asm):03146         ; of the word being defined.
                      (    forth6809.asm):03147         ; Original comment: shadow DOESGTW.0.
                      (    forth6809.asm):03148         ; ------------------------------------------------------------
D2ED CCD15D           (    forth6809.asm):03149         DOESGTW:    LDD   #SETDOES
D2F0 3606             (    forth6809.asm):03150                     PSHU  D
D2F2 BDDEBB           (    forth6809.asm):03151                     JSR   CCALL
D2F5 39               (    forth6809.asm):03152                     RTS
                      (    forth6809.asm):03153         
                      (    forth6809.asm):03154         ; ------------------------------------------------------------
                      (    forth6809.asm):03155         ; VARIABLE  ( "name" -- )
                      (    forth6809.asm):03156         ; Build a word that returns the address of a new cell in the variable
                      (    forth6809.asm):03157         ; area, initialised to zero.
                      (    forth6809.asm):03158         ; ------------------------------------------------------------
D2F6 CC0000           (    forth6809.asm):03159         VARIABLEW:  LDD   #0
D2F9 3606             (    forth6809.asm):03160                     PSHU  D
D2FB BDD221           (    forth6809.asm):03161                     JSR   HEADER
D2FE CCD151           (    forth6809.asm):03162                     LDD   #DODOES
D301 3606             (    forth6809.asm):03163                     PSHU  D
D303 BDDEBB           (    forth6809.asm):03164                     JSR   CCALL
D306 CCD15C           (    forth6809.asm):03165                     LDD   #DOESRT0
D309 3606             (    forth6809.asm):03166                     PSHU  D
D30B BDD1CF           (    forth6809.asm):03167                     JSR   CODECOMMA
D30E DC0A             (    forth6809.asm):03168                     LDD   VARHERE
D310 3606             (    forth6809.asm):03169                     PSHU  D
D312 BDD1CF           (    forth6809.asm):03170                     JSR   CODECOMMA
D315 CC0000           (    forth6809.asm):03171                     LDD   #0
D318 9E0A             (    forth6809.asm):03172                     LDX   VARHERE
D31A ED81             (    forth6809.asm):03173                     STD   ,X++
D31C 9F0A             (    forth6809.asm):03174                     STX   VARHERE
D31E 39               (    forth6809.asm):03175                     RTS
                      (    forth6809.asm):03176         
                      (    forth6809.asm):03177         ; ------------------------------------------------------------
                      (    forth6809.asm):03178         ; @  ( a-addr -- x )
                      (    forth6809.asm):03179         ; Fetch the cell at a-addr. Also the behaviour of CONSTANT words.
                      (    forth6809.asm):03180         ; ------------------------------------------------------------
D31F 3710             (    forth6809.asm):03181         FETCHW:     PULU  X                 ; a-addr
D321 EC84             (    forth6809.asm):03182                     LDD   ,X
D323 3606             (    forth6809.asm):03183                     PSHU  D                 ; x
D325 39               (    forth6809.asm):03184                     RTS
                      (    forth6809.asm):03185         
                      (    forth6809.asm):03186         ; ------------------------------------------------------------
                      (    forth6809.asm):03187         ; CONSTANT  ( x "name" -- )
                      (    forth6809.asm):03188         ; Build a word that returns x. The value is stored in the code area
                      (    forth6809.asm):03189         ; after the trampoline and fetched with @.
                      (    forth6809.asm):03190         ; ------------------------------------------------------------
D326 CCD31F           (    forth6809.asm):03191         CONSTANTW:  LDD   #FETCHW
D329 BDD2D8           (    forth6809.asm):03192                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
D32C BDD1C9           (    forth6809.asm):03193                     JSR   COMMAW
D32F 39               (    forth6809.asm):03194                     RTS
                      (    forth6809.asm):03195         
                      (    forth6809.asm):03196         ; ------------------------------------------------------------
                      (    forth6809.asm):03197         ; Behaviour of a VALUE word: fetch the value cell.
                      (    forth6809.asm):03198         ; DOVALUE   ( pfa -- x )
                      (    forth6809.asm):03199         ;    Inputs:
                      (    forth6809.asm):03200         ;        pfa on the data stack (address of the value cell)
                      (    forth6809.asm):03201         ;    Outputs:
                      (    forth6809.asm):03202         ;        pfa replaced by the value
                      (    forth6809.asm):03203         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):03204         ; ------------------------------------------------------------
D330 3710             (    forth6809.asm):03205         DOVALUE:    PULU  X                 ; pfa
D332 EC84             (    forth6809.asm):03206                     LDD   ,X
D334 3606             (    forth6809.asm):03207                     PSHU  D                 ; x
D336 39               (    forth6809.asm):03208                     RTS
                      (    forth6809.asm):03209         
                      (    forth6809.asm):03210         ; ------------------------------------------------------------
                      (    forth6809.asm):03211         ; VALUE  ( x "name" -- )
                      (    forth6809.asm):03212         ; Build a word that returns x, which can be changed with TO. The value
                      (    forth6809.asm):03213         ; cell is kept in the variable area so that it is writable.
                      (    forth6809.asm):03214         ; ------------------------------------------------------------
D337 CCD330           (    forth6809.asm):03215         VALUEW:     LDD   #DOVALUE
D33A BDD2BE           (    forth6809.asm):03216                     JSR   BLDDOES
D33D DC0A             (    forth6809.asm):03217                     LDD   VARHERE           ; PFA = VARHERE (writable space)
D33F 3606             (    forth6809.asm):03218                     PSHU  D                 ; See bugfix: VALUEW.1
D341 BDD1CF           (    forth6809.asm):03219                     JSR   CODECOMMA
D344 BDD1E1           (    forth6809.asm):03220                     JSR   VCOMMAW           ; store x in the variable area
D347 39               (    forth6809.asm):03221                     RTS
                      (    forth6809.asm):03222         
                      (    forth6809.asm):03223         ; ------------------------------------------------------------
                      (    forth6809.asm):03224         ; Behaviour of a 2VALUE word: fetch the two-cell value, x2 at the
                      (    forth6809.asm):03225         ; lower address as 2@ expects.
                      (    forth6809.asm):03226         ; DO2VALUE   ( pfa -- x1 x2 )
                      (    forth6809.asm):03227         ; ------------------------------------------------------------
D348 7EE87C           (    forth6809.asm):03228         DO2VALUE:   JMP   TWOFETCHW
                      (    forth6809.asm):03229         
                      (    forth6809.asm):03230         ; ------------------------------------------------------------
                      (    forth6809.asm):03231         ; 2VALUE  ( x1 x2 "name" -- )
                      (    forth6809.asm):03232         ; Build a word that returns x1 x2, which can be changed with TO. The
                      (    forth6809.asm):03233         ; two cells are kept in the variable area so that they are writable.
                      (    forth6809.asm):03234         ; ------------------------------------------------------------
D34B CCD348           (    forth6809.asm):03235         TWOVALUEW:  LDD   #DO2VALUE
D34E BDD2BE           (    forth6809.asm):03236                     JSR   BLDDOES
D351 DC0A             (    forth6809.asm):03237                     LDD   VARHERE           ; PFA = VARHERE (writable space)
D353 3606             (    forth6809.asm):03238                     PSHU  D
D355 BDD1CF           (    forth6809.asm):03239                     JSR   CODECOMMA
D358 BDD1E1           (    forth6809.asm):03240                     JSR   VCOMMAW           ; x2 at the lower address
D35B BDD1E1           (    forth6809.asm):03241                     JSR   VCOMMAW           ; then x1
D35E 39               (    forth6809.asm):03242                     RTS
                      (    forth6809.asm):03243         
                      (    forth6809.asm):03244         ; ------------------------------------------------------------
                      (    forth6809.asm):03245         ; TO  ( x "name" -- )  IMMEDIATE
                      (    forth6809.asm):03246         ; Store x in the named VALUE. When compiling, instead compile code to
                      (    forth6809.asm):03247         ; store a run-time x in it. Error -13 if the name is not found.
                      (    forth6809.asm):03248         ; ------------------------------------------------------------
D35F CC0020           (    forth6809.asm):03249         TOW:        LDD   #32
D362 3606             (    forth6809.asm):03250                     PSHU  D
D364 BDD578           (    forth6809.asm):03251                     JSR   WORDW
D367 BDD661           (    forth6809.asm):03252                     JSR   FINDW
D36A 3706             (    forth6809.asm):03253                     PULU  D
D36C 10830000         (    forth6809.asm):03254                     CMPD  #0
D370 260A             (    forth6809.asm):03255                     BNE   TOFOUND
D372 3706             (    forth6809.asm):03256                     PULU  D
D374 CCFFF3           (    forth6809.asm):03257                     LDD   #-13
D377 3606             (    forth6809.asm):03258                     PSHU  D
D379 BDDA80           (    forth6809.asm):03259                     JSR   THROWW
D37C AEC4             (    forth6809.asm):03260         TOFOUND:    LDX   ,U                ; xt: is it a 2VALUE? (behaviour cell at xt+3)
D37E EC03             (    forth6809.asm):03261                     LDD   3,X
D380 1083D348         (    forth6809.asm):03262                     CMPD  #DO2VALUE
D384 271A             (    forth6809.asm):03263                     BEQ   TOTWO
D386 BDDF7C           (    forth6809.asm):03264                     JSR   TOBODYW
D389 DC00             (    forth6809.asm):03265                     LDD   STATE
D38B 270C             (    forth6809.asm):03266                     BEQ   TOIMMED
D38D BDDEC8           (    forth6809.asm):03267                     JSR   LITERALW
D390 CCE85D           (    forth6809.asm):03268                     LDD   #STOREW
D393 3606             (    forth6809.asm):03269                     PSHU  D
D395 BDDEBB           (    forth6809.asm):03270                     JSR   CCALL
D398 39               (    forth6809.asm):03271                     RTS
D399 3710             (    forth6809.asm):03272         TOIMMED:    PULU  X                 ; a-addr of the value cell
D39B 3706             (    forth6809.asm):03273                     PULU  D                 ; x
D39D ED84             (    forth6809.asm):03274                     STD   ,X
D39F 39               (    forth6809.asm):03275                     RTS
D3A0 BDDF7C           (    forth6809.asm):03276         TOTWO:      JSR   TOBODYW           ; 2VALUE: store x1 x2 with 2!
D3A3 DC00             (    forth6809.asm):03277                     LDD   STATE
D3A5 270C             (    forth6809.asm):03278                     BEQ   TOTWOIMM
D3A7 BDDEC8           (    forth6809.asm):03279                     JSR   LITERALW
D3AA CCE887           (    forth6809.asm):03280                     LDD   #TWOSTOREW
D3AD 3606             (    forth6809.asm):03281                     PSHU  D
D3AF BDDEBB           (    forth6809.asm):03282                     JSR   CCALL
D3B2 39               (    forth6809.asm):03283                     RTS
D3B3 7EE887           (    forth6809.asm):03284         TOTWOIMM:   JMP   TWOSTOREW
                      (    forth6809.asm):03285         
                      (    forth6809.asm):03286         ; ------------------------------------------------------------
                      (    forth6809.asm):03287         ; 2VARIABLE  ( "name" -- )
                      (    forth6809.asm):03288         ; Build a word that returns the address of a new two-cell variable in

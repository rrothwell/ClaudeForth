E233 2712             (    forth6809.asm):03570                     BEQ   SWNOT
E235 8DB5             (    forth6809.asm):03571                     BSR   HDRXT
E237 3610             (    forth6809.asm):03572                     PSHU  X                 ; xt
E239 4D               (    forth6809.asm):03573                     TSTA
E23A 2A05             (    forth6809.asm):03574                     BPL   SWNORM
E23C CC0001           (    forth6809.asm):03575                     LDD   #1
E23F 2003             (    forth6809.asm):03576                     BRA   SWPUSH

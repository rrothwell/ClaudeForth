                      (    forth6809.asm):04976         ;    Outputs:
                      (    forth6809.asm):04977         ;        S holds index, limit and a zero leave flag (top first)
                      (    forth6809.asm):04978         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):04979         ; ------------------------------------------------------------
DC50 3706             (    forth6809.asm):04980         DOSETUP:    PULU  D                 ; index
DC52 DD14             (    forth6809.asm):04981                     STD   MSCR
DC54 3706             (    forth6809.asm):04982                     PULU  D                 ; limit
DC56 DD16             (    forth6809.asm):04983                     STD   MSCR2
DC58 3510             (    forth6809.asm):04984                     PULS  X

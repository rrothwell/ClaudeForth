E497 C17F             (    forth6809.asm):04173                     CMPB  #127
E499 2720             (    forth6809.asm):04174                     BEQ   ABKSP
                      (    forth6809.asm):04175         
E49B ECC4             (    forth6809.asm):04176                     LDD   ,U
E49D 10A342           (    forth6809.asm):04177                     CMPD  2,U
E4A0 27E2             (    forth6809.asm):04178                     BEQ   ALOOP
                      (    forth6809.asm):04179         
E4A2 AE44             (    forth6809.asm):04180                     LDX   4,U
E4A4 308B             (    forth6809.asm):04181                     LEAX  D,X
E4A6 1F20             (    forth6809.asm):04182                     TFR   Y,D

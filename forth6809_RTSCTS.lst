                      (    forth6809.asm):05752         ; 2OVER  ( x1 x2 x3 x4 -- x1 x2 x3 x4 x1 x2 )
                      (    forth6809.asm):05753         ; Copy the second cell pair to the top.
                      (    forth6809.asm):05754         ; ------------------------------------------------------------
E03D EC46             (    forth6809.asm):05755         DOVERW:     LDD   6,U               ; x1
E03F AE44             (    forth6809.asm):05756                     LDX   4,U               ; x2
E041 3606             (    forth6809.asm):05757                     PSHU  D
E043 3610             (    forth6809.asm):05758                     PSHU  X
E045 39               (    forth6809.asm):05759                     RTS
                      (    forth6809.asm):05760         
                      (    forth6809.asm):05761         ; ------------------------------------------------------------
                      (    forth6809.asm):05762         ; NIP  ( x1 x2 -- x2 )
                      (    forth6809.asm):05763         ; Discard the second cell.
                      (    forth6809.asm):05764         ; ------------------------------------------------------------
E046 ECC4             (    forth6809.asm):05765         NIPW:       LDD   ,U                ; x2
E048 ED42             (    forth6809.asm):05766                     STD   2,U
E04A 3342             (    forth6809.asm):05767                     LEAU  2,U
E04C 39               (    forth6809.asm):05768                     RTS
                      (    forth6809.asm):05769         
                      (    forth6809.asm):05770         ; ------------------------------------------------------------
                      (    forth6809.asm):05771         ; TUCK  ( x1 x2 -- x2 x1 x2 )
                      (    forth6809.asm):05772         ; Copy the top cell beneath the second cell.
                      (    forth6809.asm):05773         ; ------------------------------------------------------------
E04D ECC4             (    forth6809.asm):05774         TUCKW:      LDD   ,U                ; x2
E04F AE42             (    forth6809.asm):05775                     LDX   2,U               ; x1
E051 3606             (    forth6809.asm):05776                     PSHU  D
E053 AF42             (    forth6809.asm):05777                     STX   2,U
E055 ED44             (    forth6809.asm):05778                     STD   4,U
E057 39               (    forth6809.asm):05779                     RTS
                      (    forth6809.asm):05780         
                      (    forth6809.asm):05781         ; ------------------------------------------------------------
                      (    forth6809.asm):05782         ; PICK  ( xu ... x0 u -- xu ... x0 xu )
                      (    forth6809.asm):05783         ; Copy the cell u deep (0 PICK is DUP) to the top.
                      (    forth6809.asm):05784         ; ------------------------------------------------------------
E058 3706             (    forth6809.asm):05785         PICKW:      PULU  D                 ; u
E05A 58               (    forth6809.asm):05786                     LSLB
E05B 49               (    forth6809.asm):05787                     ROLA
E05C ECCB             (    forth6809.asm):05788                     LDD   D,U
E05E 3606             (    forth6809.asm):05789                     PSHU  D
E060 39               (    forth6809.asm):05790                     RTS
                      (    forth6809.asm):05791         
                      (    forth6809.asm):05792         ; ------------------------------------------------------------
                      (    forth6809.asm):05793         ; ROLL  ( xu xu-1 ... x0 u -- xu-1 ... x0 xu )
                      (    forth6809.asm):05794         ; Move the cell u deep (0 ROLL does nothing) to the top, shifting the
                      (    forth6809.asm):05795         ; cells above it down one place. RDST holds the byte offset and RVAL
                      (    forth6809.asm):05796         ; the cell being moved.
                      (    forth6809.asm):05797         ; ------------------------------------------------------------
E061 ECC1             (    forth6809.asm):05798         ROLLW:      LDD   ,U++              ; u (LDD sets CC; PULU would not). See
E063 2718             (    forth6809.asm):05799                     BEQ   ROLLDONE          ; bugfix: ROLLW.1
E065 1F02             (    forth6809.asm):05800                     TFR   D,Y               ; Y = cells to shift
E067 58               (    forth6809.asm):05801                     LSLB
E068 49               (    forth6809.asm):05802                     ROLA
E069 30CB             (    forth6809.asm):05803                     LEAX  D,U               ; X = xu
E06B EC84             (    forth6809.asm):05804                     LDD   ,X
E06D 3406             (    forth6809.asm):05805                     PSHS  D                 ; xu waits on the return stack
E06F EC1E             (    forth6809.asm):05806         RLOOP:      LDD   -2,X
E071 ED84             (    forth6809.asm):05807                     STD   ,X
E073 301E             (    forth6809.asm):05808                     LEAX  -2,X
E075 313F             (    forth6809.asm):05809                     LEAY  -1,Y
E077 26F6             (    forth6809.asm):05810                     BNE   RLOOP

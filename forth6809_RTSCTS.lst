E8E9 39               (    forth6809.asm):07574                     RTS
E8EA CCFFEE           (    forth6809.asm):07575         PQLONG:     LDD   #-18
E8ED 3606             (    forth6809.asm):07576                     PSHU  D
E8EF 7EDA61           (    forth6809.asm):07577                     JMP   THROWW
                      (    forth6809.asm):07578         
                      (    forth6809.asm):07579         ; ------------------------------------------------------------
                      (    forth6809.asm):07580         ; Compile a call to a run-time word followed by a counted string.
                      (    forth6809.asm):07581         ; CSTRCOMP   ( c-addr u -- )
                      (    forth6809.asm):07582         ;    Inputs:
                      (    forth6809.asm):07583         ;        RegD = xt of the run-time word (DOSTR, DOTSTR, DOABORTQUOTE)
                      (    forth6809.asm):07584         ;        c-addr u on the data stack
                      (    forth6809.asm):07585         ;    Outputs:
                      (    forth6809.asm):07586         ;        JSR xt, the count byte and the text compiled at CODEHERE
                      (    forth6809.asm):07587         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):07588         ; ------------------------------------------------------------

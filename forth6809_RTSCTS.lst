                      (    forth6809.asm):04325                     RTS
E47D                  (    forth6809.asm):04326         KQFALSE:    LDD   #FALSEV
                      (    forth6809.asm):04327                     PSHU  D                 ; flag = false
                      (    forth6809.asm):04328                     RTS

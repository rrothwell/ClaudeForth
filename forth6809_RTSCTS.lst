DCC7 2709             (    forth6809.asm):05073                     BEQ   DTEXIT
DCC9 3510             (    forth6809.asm):05074                     PULS  X                 ; X = branch operand address
DCCB EC84             (    forth6809.asm):05075                     LDD   ,X
DCCD 308B             (    forth6809.asm):05076                     LEAX  D,X
DCCF 3410             (    forth6809.asm):05077                     PSHS  X                 ; return to loop start
DCD1 39               (    forth6809.asm):05078                     RTS
DCD2 3510             (    forth6809.asm):05079         DTEXIT:     PULS  X
DCD4 3002             (    forth6809.asm):05080                     LEAX  2,X               ; skip the branch operand
DCD6 3266             (    forth6809.asm):05081                     LEAS  6,S               ; discard the loop frame
DCD8 3410             (    forth6809.asm):05082                     PSHS  X
DCDA 39               (    forth6809.asm):05083                     RTS

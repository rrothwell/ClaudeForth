                      (    forth6809.asm):06702         ; ------------------------------------------------------------
F3D7 CC0000           (    forth6809.asm):06703         ERASEW:     LDD   #0
F3DA 3606             (    forth6809.asm):06704                     PSHU  D
F3DC 7EF3C1           (    forth6809.asm):06705                     JMP   FILLW
                      (    forth6809.asm):06706         
                      (    forth6809.asm):06707         ; ------------------------------------------------------------
                      (    forth6809.asm):06708         ; BLANK  ( c-addr u -- )
                      (    forth6809.asm):06709         ; Store a space in each of u bytes starting at c-addr.
                      (    forth6809.asm):06710         ; ------------------------------------------------------------
F3DF CC0020           (    forth6809.asm):06711         BLANKW:     LDD   #32
F3E2 3606             (    forth6809.asm):06712                     PSHU  D
F3E4 7EF3C1           (    forth6809.asm):06713                     JMP   FILLW
                      (    forth6809.asm):06714         
                      (    forth6809.asm):06715         ; ============================================================
                      (    forth6809.asm):06716         ; SECTION 19: STRING WORDS
                      (    forth6809.asm):06717         ; ============================================================
                      (    forth6809.asm):06718         ; ------------------------------------------------------------
                      (    forth6809.asm):06719         ; Run-time part of S". The counted string follows the call: push its
                      (    forth6809.asm):06720         ; address and length and skip over it.
                      (    forth6809.asm):06721         ; DOSTR   ( -- c-addr u )
                      (    forth6809.asm):06722         ;    Inputs:
                      (    forth6809.asm):06723         ;        return address on S points at the count byte
                      (    forth6809.asm):06724         ;    Outputs:
                      (    forth6809.asm):06725         ;        c-addr and u on the data stack; execution resumes after the
                      (    forth6809.asm):06726         ;        string
                      (    forth6809.asm):06727         ;    Registers: RegB, RegD and RegX changed.
                      (    forth6809.asm):06728         ; ------------------------------------------------------------
F3E7 3510             (    forth6809.asm):06729         DOSTR:      PULS  X
F3E9 E684             (    forth6809.asm):06730                     LDB   ,X
F3EB 3001             (    forth6809.asm):06731                     LEAX  1,X
F3ED 3610             (    forth6809.asm):06732                     PSHU  X
F3EF 4F               (    forth6809.asm):06733                     CLRA
F3F0 3606             (    forth6809.asm):06734                     PSHU  D
F3F2 3085             (    forth6809.asm):06735                     LEAX  B,X
F3F4 3410             (    forth6809.asm):06736                     PSHS  X
F3F6 39               (    forth6809.asm):06737                     RTS
                      (    forth6809.asm):06738         
                      (    forth6809.asm):06739         ; ------------------------------------------------------------
                      (    forth6809.asm):06740         ; Parse the text up to the next double quote for S", ." and ABORT".
                      (    forth6809.asm):06741         ; WORD cannot be used: it skips leading delimiters, so an empty string
                      (    forth6809.asm):06742         ; (S" ") ran on to the next quote in the source. PARSE does not skip.
                      (    forth6809.asm):06743         ; PARSEQUOTE
                      (    forth6809.asm):06744         ;    Inputs:
                      (    forth6809.asm):06745         ;        none (parses from >IN)
                      (    forth6809.asm):06746         ;    Outputs:
                      (    forth6809.asm):06747         ;        c-addr u on the data stack: the text in the input buffer.
                      (    forth6809.asm):06748         ;        THROW -18 if the text is longer than 255 characters.
                      (    forth6809.asm):06749         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):06750         ; ------------------------------------------------------------
F3F7 CC0022           (    forth6809.asm):06751         PARSEQUOTE: LDD   #34
F3FA 3606             (    forth6809.asm):06752                     PSHU  D
F3FC BDF5CD           (    forth6809.asm):06753                     JSR   PARSEW
F3FF 6DC4             (    forth6809.asm):06754                     TST   ,U                ; high byte of the length
F401 2601             (    forth6809.asm):06755                     BNE   PQLONG
F403 39               (    forth6809.asm):06756                     RTS
F404 CCFFEE           (    forth6809.asm):06757         PQLONG:     LDD   #-18
F407 3606             (    forth6809.asm):06758                     PSHU  D
F409 7EE561           (    forth6809.asm):06759                     JMP   THROWW
                      (    forth6809.asm):06760         
                      (    forth6809.asm):06761         ; ------------------------------------------------------------
                      (    forth6809.asm):06762         ; Compile a call to a run-time word followed by a counted string.
                      (    forth6809.asm):06763         ; CSTRCOMP   ( c-addr u -- )
                      (    forth6809.asm):06764         ;    Inputs:
                      (    forth6809.asm):06765         ;        RegD = xt of the run-time word (DOSTR, DOTSTR, DOABORTQUOTE)
                      (    forth6809.asm):06766         ;        c-addr u on the data stack
                      (    forth6809.asm):06767         ;    Outputs:
                      (    forth6809.asm):06768         ;        JSR xt, the count byte and the text compiled at CODEHERE
                      (    forth6809.asm):06769         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):06770         ; ------------------------------------------------------------
F40C 3606             (    forth6809.asm):06771         CSTRCOMP:   PSHU  D
F40E BDE99C           (    forth6809.asm):06772                     JSR   CCALL
F411 3706             (    forth6809.asm):06773                     PULU  D                 ; u
F413 3720             (    forth6809.asm):06774                     PULU  Y                 ; c-addr
F415 9E08             (    forth6809.asm):06775                     LDX   CODEHERE
F417 E780             (    forth6809.asm):06776                     STB   ,X+
F419 5D               (    forth6809.asm):06777                     TSTB
F41A 2707             (    forth6809.asm):06778                     BEQ   CSEND
F41C A6A0             (    forth6809.asm):06779         CSCPY:      LDA   ,Y+
F41E A780             (    forth6809.asm):06780                     STA   ,X+
F420 5A               (    forth6809.asm):06781                     DECB
F421 26F9             (    forth6809.asm):06782                     BNE   CSCPY
F423 9F08             (    forth6809.asm):06783         CSEND:      STX   CODEHERE
F425 39               (    forth6809.asm):06784                     RTS
                      (    forth6809.asm):06785         
                      (    forth6809.asm):06786         ; ------------------------------------------------------------
                      (    forth6809.asm):06787         ; S"  ( "ccc<quote>" -- c-addr u )
                      (    forth6809.asm):06788         ; Parse up to the closing quote (PARSEQUOTE). When compiling, compile
                      (    forth6809.asm):06789         ; DOSTR followed by the counted string. When interpreting, copy the
                      (    forth6809.asm):06790         ; string to PAD and return its address and length. An empty string is
                      (    forth6809.asm):06791         ; valid. See shadow SQUOTEW.3.
                      (    forth6809.asm):06792         ; ------------------------------------------------------------
F426 BDF3F7           (    forth6809.asm):06793         SQUOTEW:    JSR   PARSEQUOTE        ; See bugfix: SQUOTEW.3
F429 DC00             (    forth6809.asm):06794         SQSTATE:    LDD   STATE
F42B 2706             (    forth6809.asm):06795                     BEQ   SQINTERP
F42D CCF3E7           (    forth6809.asm):06796                     LDD   #DOSTR
F430 7EF40C           (    forth6809.asm):06797                     JMP   CSTRCOMP
                      (    forth6809.asm):06798         
                      (    forth6809.asm):06799                     ; Interpreting: copy the string to PAD. Original comment: shadow
                      (    forth6809.asm):06800                     ; SQUOTEW.2.
F433                  (    forth6809.asm):06801         SQINTERP:
F433 BDDF60           (    forth6809.asm):06802                     JSR   PADW
F436 3710             (    forth6809.asm):06803                     PULU  X                 ; PAD
F438 3706             (    forth6809.asm):06804                     PULU  D                 ; u
F43A 3720             (    forth6809.asm):06805                     PULU  Y                 ; c-addr
F43C 3610             (    forth6809.asm):06806                     PSHU  X                 ; result c-addr
F43E 3606             (    forth6809.asm):06807                     PSHU  D                 ; result u
F440 5D               (    forth6809.asm):06808                     TSTB
F441 2707             (    forth6809.asm):06809                     BEQ   SQIEND
F443 A6A0             (    forth6809.asm):06810         SQICPY:     LDA   ,Y+
F445 A780             (    forth6809.asm):06811                     STA   ,X+
F447 5A               (    forth6809.asm):06812                     DECB
F448 26F9             (    forth6809.asm):06813                     BNE   SQICPY
F44A 39               (    forth6809.asm):06814         SQIEND:     RTS
                      (    forth6809.asm):06815         
                      (    forth6809.asm):06816         ; ------------------------------------------------------------
                      (    forth6809.asm):06817         ; S\"  ( "ccc<quote>" -- c-addr u )
                      (    forth6809.asm):06818         ; As S", but the text may contain escape sequences introduced by a
                      (    forth6809.asm):06819         ; backslash, and a backslash-quote does not end the string. The
                      (    forth6809.asm):06820         ; translated text is built at PAD and then handled exactly like S" text
                      (    forth6809.asm):06821         ; (SQSTATE). The escapes are: \a 7, \b 8, \e 27, \f 12, \l 10, \m the
                      (    forth6809.asm):06822         ; pair 13 10, \n 10, \q 34, \r 13, \t 9, \v 11, \z 0, \" 34, \\ 92 and
                      (    forth6809.asm):06823         ; \xhh (one or two hex digits). Any other character after a backslash
                      (    forth6809.asm):06824         ; stands for itself. An unterminated string ends at the end of the line.
                      (    forth6809.asm):06825         ; A result over 255 characters throws -18.
                      (    forth6809.asm):06826         ; Frame on S: 0,S input end, 2,S output start, 4,S output pointer.
                      (    forth6809.asm):06827         ; ------------------------------------------------------------
F44B BDDF60           (    forth6809.asm):06828         SQUOTEESCW: JSR   PADW              ; leaves PAD on the data stack
F44E ECC4             (    forth6809.asm):06829                     LDD   ,U
F450 3406             (    forth6809.asm):06830                     PSHS  D                 ; output pointer
F452 3406             (    forth6809.asm):06831                     PSHS  D                 ; output start
F454 DC39             (    forth6809.asm):06832                     LDD   SRCADDR
F456 D33B             (    forth6809.asm):06833                     ADDD  SRCLEN
F458 3406             (    forth6809.asm):06834                     PSHS  D                 ; input end
F45A DC39             (    forth6809.asm):06835                     LDD   SRCADDR
F45C D310             (    forth6809.asm):06836                     ADDD  TOIN
F45E 1F02             (    forth6809.asm):06837                     TFR   D,Y               ; input pointer
F460 10AC60           (    forth6809.asm):06838         SQEL:       CMPY  0,S
F463 247E             (    forth6809.asm):06839                     BHS   SQEND
F465 A6A0             (    forth6809.asm):06840                     LDA   ,Y+
F467 8122             (    forth6809.asm):06841                     CMPA  #34
F469 2778             (    forth6809.asm):06842                     BEQ   SQEND
F46B 815C             (    forth6809.asm):06843                     CMPA  #92
F46D 261C             (    forth6809.asm):06844                     BNE   SQEPUT
F46F 10AC60           (    forth6809.asm):06845                     CMPY  0,S
F472 246F             (    forth6809.asm):06846                     BHS   SQEND
F474 A6A0             (    forth6809.asm):06847                     LDA   ,Y+               ; the escaped character
F476 8178             (    forth6809.asm):06848                     CMPA  #'x'
F478 2727             (    forth6809.asm):06849                     BEQ   SQEHEX
F47A 816D             (    forth6809.asm):06850                     CMPA  #'m'
F47C 2715             (    forth6809.asm):06851                     BEQ   SQEM
F47E 8EF4FF           (    forth6809.asm):06852                     LDX   #SQETAB
F481 6D84             (    forth6809.asm):06853         SQEFND:     TST   ,X
F483 2706             (    forth6809.asm):06854                     BEQ   SQEPUT            ; not in the table: stands for itself
F485 A181             (    forth6809.asm):06855                     CMPA  ,X++
F487 26F8             (    forth6809.asm):06856                     BNE   SQEFND
F489 A61F             (    forth6809.asm):06857                     LDA   -1,X
F48B AE64             (    forth6809.asm):06858         SQEPUT:     LDX   4,S
F48D A780             (    forth6809.asm):06859                     STA   ,X+
F48F AF64             (    forth6809.asm):06860                     STX   4,S
F491 20CD             (    forth6809.asm):06861                     BRA   SQEL
F493 AE64             (    forth6809.asm):06862         SQEM:       LDX   4,S
F495 860D             (    forth6809.asm):06863                     LDA   #13
F497 A780             (    forth6809.asm):06864                     STA   ,X+
F499 860A             (    forth6809.asm):06865                     LDA   #10
F49B A780             (    forth6809.asm):06866                     STA   ,X+
F49D AF64             (    forth6809.asm):06867                     STX   4,S
F49F 20BF             (    forth6809.asm):06868                     BRA   SQEL
F4A1 8D1A             (    forth6809.asm):06869         SQEHEX:     BSR   SQEHD             ; first digit
F4A3 25BB             (    forth6809.asm):06870                     BCS   SQEL              ; none: nothing is added
F4A5 3121             (    forth6809.asm):06871                     LEAY  1,Y
F4A7 1F89             (    forth6809.asm):06872                     TFR   A,B
F4A9 8D12             (    forth6809.asm):06873                     BSR   SQEHD             ; second digit
F4AB 2404             (    forth6809.asm):06874                     BCC   SQEH2
F4AD 1F98             (    forth6809.asm):06875                     TFR   B,A               ; one digit only
F4AF 20DA             (    forth6809.asm):06876                     BRA   SQEPUT
F4B1 3121             (    forth6809.asm):06877         SQEH2:      LEAY  1,Y
F4B3 58               (    forth6809.asm):06878                     ASLB
F4B4 58               (    forth6809.asm):06879                     ASLB
F4B5 58               (    forth6809.asm):06880                     ASLB
F4B6 58               (    forth6809.asm):06881                     ASLB
F4B7 3404             (    forth6809.asm):06882                     PSHS  B
F4B9 ABE0             (    forth6809.asm):06883                     ADDA  ,S+
F4BB 20CE             (    forth6809.asm):06884                     BRA   SQEPUT
                      (    forth6809.asm):06885         ; Hex digit at ,Y: value in A, carry clear; carry set if not a digit
                      (    forth6809.asm):06886         ; or the input is exhausted. Y is not advanced. RegB is preserved.
F4BD 10AC62           (    forth6809.asm):06887         SQEHD:      CMPY  2,S               ; input end (one return address down)
F4C0 241E             (    forth6809.asm):06888                     BHS   SQEHNO
F4C2 A6A4             (    forth6809.asm):06889                     LDA   ,Y
F4C4 8130             (    forth6809.asm):06890                     CMPA  #'0'

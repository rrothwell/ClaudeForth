                      (    forth6809.asm):09181         ; SECTION 26: CONSTANT-VALUE WORDS (TRUE, FALSE, 1, -1, 2, -2)
                      (    forth6809.asm):09182         ; ============================================================
                      (    forth6809.asm):09183         ; ------------------------------------------------------------
                      (    forth6809.asm):09184         ; TRUE  ( -- flag )
                      (    forth6809.asm):09185         ; Push true ($FFFF), the value of TRUEV. A direct LDD/PSHU/RTS: no
                      (    forth6809.asm):09186         ; DODOES trampoline and no value cell.
                      (    forth6809.asm):09187         ; Original comment: shadow TRUEW.0.
                      (    forth6809.asm):09188         ; ------------------------------------------------------------
FF7D CCFFFF           (    forth6809.asm):09189         TRUEW:      LDD   #$FFFF
FF80 3606             (    forth6809.asm):09190                     PSHU  D
FF82 39               (    forth6809.asm):09191                     RTS
                      (    forth6809.asm):09192         
                      (    forth6809.asm):09193         ; ------------------------------------------------------------
                      (    forth6809.asm):09194         ; FALSE  ( -- flag )
                      (    forth6809.asm):09195         ; Push false ($0000), the value of FALSEV.
                      (    forth6809.asm):09196         ; ------------------------------------------------------------
FF83 CC0000           (    forth6809.asm):09197         FALSEW:     LDD   #$0000
FF86 3606             (    forth6809.asm):09198                     PSHU  D
FF88 39               (    forth6809.asm):09199                     RTS
                      (    forth6809.asm):09200         
                      (    forth6809.asm):09201         ; ------------------------------------------------------------
                      (    forth6809.asm):09202         ; 1  ( -- 1 )
                      (    forth6809.asm):09203         ; Push the constant 1. The words -1, 2 and -2 below work the same way.
                      (    forth6809.asm):09204         ; Their headers are H_POSONE, H_NEGONE, H_POSTWO and H_NEGTWO (Section
                      (    forth6809.asm):09205         ; 27), since "1" and "-1" are not valid assembler labels.
                      (    forth6809.asm):09206         ; Original comment: shadow POSONEW.0.
                      (    forth6809.asm):09207         ; ------------------------------------------------------------
FF89 CC0001           (    forth6809.asm):09208         POSONEW:    LDD   #1
FF8C 3606             (    forth6809.asm):09209                     PSHU  D
FF8E 39               (    forth6809.asm):09210                     RTS
                      (    forth6809.asm):09211         
                      (    forth6809.asm):09212         ; ------------------------------------------------------------
                      (    forth6809.asm):09213         ; -1  ( -- -1 )
                      (    forth6809.asm):09214         ; Push the constant -1.
                      (    forth6809.asm):09215         ; ------------------------------------------------------------
FF8F CCFFFF           (    forth6809.asm):09216         NEGONEW:    LDD   #-1
FF92 3606             (    forth6809.asm):09217                     PSHU  D
FF94 39               (    forth6809.asm):09218                     RTS
                      (    forth6809.asm):09219         
                      (    forth6809.asm):09220         ; ------------------------------------------------------------
                      (    forth6809.asm):09221         ; 2  ( -- 2 )
                      (    forth6809.asm):09222         ; Push the constant 2.
                      (    forth6809.asm):09223         ; ------------------------------------------------------------
FF95 CC0002           (    forth6809.asm):09224         POSTWOW:    LDD   #2
FF98 3606             (    forth6809.asm):09225                     PSHU  D
FF9A 39               (    forth6809.asm):09226                     RTS
                      (    forth6809.asm):09227         
                      (    forth6809.asm):09228         ; ------------------------------------------------------------
                      (    forth6809.asm):09229         ; -2  ( -- -2 )
                      (    forth6809.asm):09230         ; Push the constant -2.
                      (    forth6809.asm):09231         ; ------------------------------------------------------------
FF9B CCFFFE           (    forth6809.asm):09232         NEGTWOW:    LDD   #-2
FF9E 3606             (    forth6809.asm):09233                     PSHU  D
FFA0 39               (    forth6809.asm):09234                     RTS
                      (    forth6809.asm):09235         
                      (    forth6809.asm):09236         ; Verify no collision with init code,
                      (    forth6809.asm):09237         ; value should match ORG INITCODE.
     FFA1             (    forth6809.asm):09238         BASECODEEND EQU   *
     2645             (    forth6809.asm):09239         BASECODESIZE EQU   BASECODEEND-BASECODE
                      (    forth6809.asm):09240         
                      (    forth6809.asm):09241         ; Prevent the assembler from extinguishing the gap between the
                      (    forth6809.asm):09242         ; BASECODE block and the INITCODE block when it generates the
                      (    forth6809.asm):09243         ; .bin file.
FFA1                  (    forth6809.asm):09244         BASEND:
FFA1 FFFFFF           (    forth6809.asm):09245                     FILL  $FF,INITCODE-BASEND
                      (    forth6809.asm):09246         
                      (    forth6809.asm):09247         ; ============================================================
                      (    forth6809.asm):09248         ; SECTION 2: INIT CODE (COLDSTRT / WARM)
                      (    forth6809.asm):09249         ; ============================================================
                      (    forth6809.asm):09250                     ORG   INITCODE          ; init code block
                      (    forth6809.asm):09251         
                      (    forth6809.asm):09252         ; ------------------------------------------------------------
                      (    forth6809.asm):09253         ; Cold start, entered from the reset vector: mask interrupts, set up
                      (    forth6809.asm):09254         ; the stacks and the direct page, clear GLOBALS, initialise the ACIA,
                      (    forth6809.asm):09255         ; unmask interrupts, run the unit tests if they are built in, then
                      (    forth6809.asm):09256         ; enter COLD.
                      (    forth6809.asm):09257         ; COLDSTRT
                      (    forth6809.asm):09258         ;    Inputs:
                      (    forth6809.asm):09259         ;        hardware reset
                      (    forth6809.asm):09260         ;    Outputs:
                      (    forth6809.asm):09261         ;        does not return
                      (    forth6809.asm):09262         ;    Registers: all registers initialised.
                      (    forth6809.asm):09263         ; ------------------------------------------------------------
FFA4                  (    forth6809.asm):09264         COLDSTRT:
FFA4 1A50             (    forth6809.asm):09265                     ORCC  #$50              ; Disable IRQ & FIRQ
FFA6 10CEC000         (    forth6809.asm):09266                     LDS   #RSTACK+1
FFAA CEBD00           (    forth6809.asm):09267                     LDU   #DSTACK+1
FFAD 4F               (    forth6809.asm):09268                     CLRA
FFAE 1F8B             (    forth6809.asm):09269                     TFR   A,DP
                      (    forth6809.asm):09270         
FFB0 8E0000           (    forth6809.asm):09271                     LDX   #GLOBALS
FFB3 C600             (    forth6809.asm):09272                     LDB   #0
FFB5 6F80             (    forth6809.asm):09273         CLRGLOB:    CLR   ,X+
FFB7 5A               (    forth6809.asm):09274                     DECB
FFB8 26FB             (    forth6809.asm):09275                     BNE   CLRGLOB
                      (    forth6809.asm):09276         
FFBA BDE190           (    forth6809.asm):09277                     JSR   WLINIT            ; FIND must work for the unit tests too
                      (    forth6809.asm):09278         
FFBD BDD97B           (    forth6809.asm):09279                     JSR   INITSERIAL
                      (    forth6809.asm):09280         
FFC0 1CAF             (    forth6809.asm):09281                     ANDCC #$AF              ; Enable IRQ & FIRQ
                      (    forth6809.asm):09282         
                      (    forth6809.asm):09283                     ; IRQ and FIRQ are unmasked above. See bugfix: COLDSTRT.1
                      (    forth6809.asm):09284         
                      (    forth6809.asm):09285                     IFNE  UNITTESTS         ; >>>>>>>>>>
                      (    forth6809.asm):09286                     JSR   TSTRUNNER
                      (    forth6809.asm):09287                     ELSE                    ; <<<<<>>>>>
FFC2 12               (    forth6809.asm):09288                     NOP                     ; same size as JSR TSTRUNNER
FFC3 12               (    forth6809.asm):09289                     NOP                     ; See bugfix: COLDSTRT.2
FFC4 12               (    forth6809.asm):09290                     NOP
                      (    forth6809.asm):09291                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):09292         
FFC5 7EDB1C           (    forth6809.asm):09293                     JMP   COLD
                      (    forth6809.asm):09294         
                      (    forth6809.asm):09295         ; ------------------------------------------------------------
                      (    forth6809.asm):09296         ; Warm start, entered from the NMI vector: mask interrupts, reset the
                      (    forth6809.asm):09297         ; stacks and direct page, re-initialise the ACIA, print the warm-start
                      (    forth6809.asm):09298         ; message, unmask interrupts and ABORT. GLOBALS is not cleared.
                      (    forth6809.asm):09299         ; WARM
                      (    forth6809.asm):09300         ;    Inputs:
                      (    forth6809.asm):09301         ;        NMI
                      (    forth6809.asm):09302         ;    Outputs:
                      (    forth6809.asm):09303         ;        does not return
                      (    forth6809.asm):09304         ;    Registers: all registers initialised.
                      (    forth6809.asm):09305         ; ------------------------------------------------------------
FFC8 1A50             (    forth6809.asm):09306         WARM:       ORCC  #$50              ; Disable IRQ & FIRQ
FFCA 4F               (    forth6809.asm):09307                     CLRA
FFCB 1F8B             (    forth6809.asm):09308                     TFR   A,DP
FFCD CEBD00           (    forth6809.asm):09309                     LDU   #SP0
FFD0 10CEC000         (    forth6809.asm):09310                     LDS   #RP0
                      (    forth6809.asm):09311         
FFD4 BDD97B           (    forth6809.asm):09312                     JSR   INITSERIAL        ; See bugfix: WARM.1
                      (    forth6809.asm):09313         
FFD7 8EFFE9           (    forth6809.asm):09314                     LDX   #WARMMSG
FFDA 3610             (    forth6809.asm):09315                     PSHU  X
FFDC CC0006           (    forth6809.asm):09316                     LDD   #WARMMSGL
FFDF 3606             (    forth6809.asm):09317                     PSHU  D
FFE1 BDF551           (    forth6809.asm):09318                     JSR   TYPEW
FFE4 1CAF             (    forth6809.asm):09319                     ANDCC #$AF              ; Enable IRQ & FIRQ
FFE6 7EDB5E           (    forth6809.asm):09320                     JMP   ABORT             ; restart the interpreter
                      (    forth6809.asm):09321         
FFE9 20207761726D     (    forth6809.asm):09322         WARMMSG:    FCC   "  warm"
     0006             (    forth6809.asm):09323         WARMMSGL    EQU   *-WARMMSG
                      (    forth6809.asm):09324         
                      (    forth6809.asm):09325                     ; Verify no collision with vectors: INITEND should equal VECTORS.
     FFEF             (    forth6809.asm):09326         INITEND     EQU   *
     004B             (    forth6809.asm):09327         INITSIZE    EQU   INITEND-INITCODE
                      (    forth6809.asm):09328         
                      (    forth6809.asm):09329         ; Prevent the assembler from extinguishing the gap between the

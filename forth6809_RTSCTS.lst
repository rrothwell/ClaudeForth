                      (    forth6809.asm):02007         
                      (    forth6809.asm):02008                                             ; $B5/%1011_0101
D9B5 86B5             (    forth6809.asm):02009                     LDA   #CR_RXTX          ; Yes! Accept input & transmit output
D9B7 2009             (    forth6809.asm):02010                     BRA   WRITE_CR          ; RTS = Low, Tx Interrupt = Enabled
                      (    forth6809.asm):02011         
D9B9                  (    forth6809.asm):02012         SET_RTS_LO_TX_OFF:                  ; $95/%10010101
D9B9 8695             (    forth6809.asm):02013                     LDA   #CR_RXON          ; RTS = Low, Tx Interrupt = Disabled
D9BB 2005             (    forth6809.asm):02014                     BRA   WRITE_CR          ; Open question moved to shadow: UPDATE_RTS.1
                      (    forth6809.asm):02015         
D9BD                  (    forth6809.asm):02016         SET_RTS_HI_TX_OFF:                  ; $D5/%1101_0101
D9BD 86D5             (    forth6809.asm):02017                     LDA   #CR_RTSHI         ; RTS = High, Tx Interrupt = Disabled

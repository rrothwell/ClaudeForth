                      (    forth6809.asm):03433         ; Search one chain of headers for a name, ignoring smudged entries.
                      (    forth6809.asm):03434         ; Case matters. A zero-length name matches a zero-length header.
                      (    forth6809.asm):03435         ; The Search-Order design is in shadow SEARCHORDER.1.
                      (    forth6809.asm):03436         ; FDSEARCH
                      (    forth6809.asm):03437         ;    Inputs:
                      (    forth6809.asm):03438         ;        RegX = first header of the chain (0 = empty chain)
                      (    forth6809.asm):03439         ;        RegY = address of the name text
                      (    forth6809.asm):03440         ;        RegB = name length
                      (    forth6809.asm):03441         ;    Outputs:
                      (    forth6809.asm):03442         ;        RegX = the matching header, or 0 if there is none
                      (    forth6809.asm):03443         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):03444         ; ------------------------------------------------------------
E180 3424             (    forth6809.asm):03445         FDSEARCH:   PSHS  Y,B               ; 0,S = length, 1,S = name text
E182 8C0000           (    forth6809.asm):03446         FDLOOP:     CMPX  #0

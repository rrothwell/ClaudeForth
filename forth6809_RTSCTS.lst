                      (    forth6809.asm):07739         ;        ud on the data stack
                      (    forth6809.asm):07740         ;    Outputs:
                      (    forth6809.asm):07741         ;        ud replaced by the quotient; RegA = remainder
                      (    forth6809.asm):07742         ;    Registers: RegA and RegB changed (RegB is the loop counter).
                      (    forth6809.asm):07743         ; ------------------------------------------------------------

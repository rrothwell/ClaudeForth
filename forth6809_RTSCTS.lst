                      (    forth6809.asm):05983         
                      (    forth6809.asm):05984         ; ------------------------------------------------------------
                      (    forth6809.asm):05985         ; 2R@  ( -- x1 x2 )  ( R: x1 x2 -- x1 x2 )
                      (    forth6809.asm):05986         ; Copy the top cell pair of the return stack.
                      (    forth6809.asm):05987         ; The return address of this call is on top of S, so it is lifted off

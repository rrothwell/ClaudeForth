                      (    forth6809.asm):04739         ; POSTPONE  ( "name" -- )
                      (    forth6809.asm):04740         ; If the name is immediate, compile a call to it now. Otherwise
                      (    forth6809.asm):04741         ; compile its xt as a literal followed by a call to COMPILE, so that

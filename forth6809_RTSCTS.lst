                      (    forth6809.asm):04894         ;        S holds return address, index, limit and leave flag (top
                      (    forth6809.asm):04895         ;        first)
                      (    forth6809.asm):04896         ;    Outputs:
                      (    forth6809.asm):04897         ;        branch taken, or loop frame removed and operand skipped

                      (    forth6809.asm):04252         ; ============================================================
                      (    forth6809.asm):04253         ; SECTION 11: EXCEPTIONS (CFERR, CATCH, THROW)
                      (    forth6809.asm):04254         ; ============================================================
                      (    forth6809.asm):04255         ; ------------------------------------------------------------
                      (    forth6809.asm):04256         ; Report a control-structure mismatch: throw -22. Called by the
                      (    forth6809.asm):04257         ; control-flow words when the tag on the control-flow stack is not the
                      (    forth6809.asm):04258         ; one expected.
                      (    forth6809.asm):04259         ; CFERR
                      (    forth6809.asm):04260         ;    Inputs:
                      (    forth6809.asm):04261         ;        none
                      (    forth6809.asm):04262         ;    Outputs:
                      (    forth6809.asm):04263         ;        does not return (THROW -22)
                      (    forth6809.asm):04264         ;    Registers: RegD changed; THROW decides the rest.
                      (    forth6809.asm):04265         ; ------------------------------------------------------------
E50D CCFFEA           (    forth6809.asm):04266         CFERR:      LDD   #-22
E510 3606             (    forth6809.asm):04267                     PSHU  D                 ; -22
E512 BDE542           (    forth6809.asm):04268                     JSR   THROWW
E515 39               (    forth6809.asm):04269                     RTS
                      (    forth6809.asm):04270         
                      (    forth6809.asm):04271         ; ------------------------------------------------------------
                      (    forth6809.asm):04272         ; CATCH  ( i*x xt -- j*x 0 | i*x n )
                      (    forth6809.asm):04273         ; Execute xt with an exception frame in place. On normal return push
                      (    forth6809.asm):04274         ; 0. If xt (or anything it calls) executes THROW with a non-zero n,
                      (    forth6809.asm):04275         ; THROW unwinds to this frame and CATCH returns n.
                      (    forth6809.asm):04276         ; Frame on S, top first: >IN, SRCID, SRCLEN, SRCADDR, saved U,
                      (    forth6809.asm):04277         ; previous HANDLER. HANDLER points at the >IN cell.
                      (    forth6809.asm):04278         ; ------------------------------------------------------------
E516 3710             (    forth6809.asm):04279         CATCHW:     PULU  X                 ; xt
E518 DC0C             (    forth6809.asm):04280                     LDD   HANDLER
E51A 3406             (    forth6809.asm):04281                     PSHS  D
E51C 3440             (    forth6809.asm):04282                     PSHS  U
                      (    forth6809.asm):04283                     ; Save the input source specification.
                      (    forth6809.asm):04284                     ; See bugfix: CATCHW.1
E51E DC39             (    forth6809.asm):04285                     LDD   SRCADDR
E520 3406             (    forth6809.asm):04286                     PSHS  D
E522 DC3B             (    forth6809.asm):04287                     LDD   SRCLEN
E524 3406             (    forth6809.asm):04288                     PSHS  D
E526 DC3D             (    forth6809.asm):04289                     LDD   SRCID
E528 3406             (    forth6809.asm):04290                     PSHS  D

                      (    forth6809.asm):04812         ; Compile DOSTR followed by a count byte and a copy of the string.
                      (    forth6809.asm):04813         ; THROW -14 if not compiling.
                      (    forth6809.asm):04814         ; ------------------------------------------------------------
EA69 DC00             (    forth6809.asm):04815         SLITERALW:  LDD   STATE
EA6B 2608             (    forth6809.asm):04816                     BNE   SLSTOK
EA6D CCFFF2           (    forth6809.asm):04817                     LDD   #-14
EA70 3606             (    forth6809.asm):04818                     PSHU  D

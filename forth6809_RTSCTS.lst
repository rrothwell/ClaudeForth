                      (    forth6809.asm):05091         ; Run-time part of EXIT: drop the address of the inline count, then
                      (    forth6809.asm):05092         ; return from the definition. Loop frames are not discarded.
                      (    forth6809.asm):05093         ; EXITUNLOOP

F134 BDDA2B           (    forth6809.asm):08915         RFTERM:     JSR   QUERYW
F137 CCFFFF           (    forth6809.asm):08916                     LDD   #TRUEV
F13A 3606             (    forth6809.asm):08917                     PSHU  D
F13C 39               (    forth6809.asm):08918                     RTS
                      (    forth6809.asm):08919         
                      (    forth6809.asm):08920         ; ------------------------------------------------------------
                      (    forth6809.asm):08921         ; EVALUATE  ( c-addr u -- )
                      (    forth6809.asm):08922         ; Interpret the string c-addr u as the input source, then restore the
                      (    forth6809.asm):08923         ; previous input source (kept on the return stack).

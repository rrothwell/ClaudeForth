                      (    forth6809.asm):04951         ; ------------------------------------------------------------
                      (    forth6809.asm):04952         ; Run-time end of +LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):04953         ; the back-branch operand. Add the step to the index. If the leave
                      (    forth6809.asm):04954         ; flag is set or the index crossed the limit, discard the loop frame
                      (    forth6809.asm):04955         ; and skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):04956         ; DOPLUSTEST   ( n -- )
                      (    forth6809.asm):04957         ;    Inputs:
                      (    forth6809.asm):04958         ;        step n on the data stack; S as for DOTEST
                      (    forth6809.asm):04959         ;    Outputs:
                      (    forth6809.asm):04960         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):04961         ;    Registers: RegD and RegX changed; MSCR, MSCR2 and MSCR3 used as
                      (    forth6809.asm):04962         ;        scratch.
                      (    forth6809.asm):04963         ; ------------------------------------------------------------
E7DC 3706             (    forth6809.asm):04964         DOPLUSTEST: PULU  D                 ; n = step. See bugfix: DOPLUSTEST.1
E7DE DD14             (    forth6809.asm):04965                     STD   MSCR              ; MSCR = step
E7E0 EC66             (    forth6809.asm):04966                     LDD   6,S               ; leave flag. See bugfix: DOPLUSTEST.2
E7E2 262D             (    forth6809.asm):04967                     BNE   DPTEXIT           ; set: exit
E7E4 EC62             (    forth6809.asm):04968                     LDD   2,S               ; old index
E7E6 A364             (    forth6809.asm):04969                     SUBD  4,S               ; old_u = old_index - limit, mod 65536
E7E8 DD16             (    forth6809.asm):04970                     STD   MSCR2
E7EA EC62             (    forth6809.asm):04971                     LDD   2,S
E7EC D314             (    forth6809.asm):04972                     ADDD  MSCR              ; new_index = old_index + step
E7EE ED62             (    forth6809.asm):04973                     STD   2,S
E7F0 A364             (    forth6809.asm):04974                     SUBD  4,S               ; new_u = new_index - limit, mod 65536
E7F2 DD18             (    forth6809.asm):04975                     STD   MSCR3
                      (    forth6809.asm):04976                     ; Crossing test on the unsigned distances old_u and new_u: with a
                      (    forth6809.asm):04977                     ; positive step the limit was crossed if new_u < old_u, with a
                      (    forth6809.asm):04978                     ; negative step if new_u > old_u. See bugfix: DOPLUSTEST.3
E7F4 DC14             (    forth6809.asm):04979                     LDD   MSCR              ; reload the step to test its sign
E7F6 2B09             (    forth6809.asm):04980                     BMI   DPNEG
E7F8 DC18             (    forth6809.asm):04981         DPPOS:      LDD   MSCR3             ; step > 0: crossed if new_u < old_u
E7FA 109316           (    forth6809.asm):04982                     CMPD  MSCR2
E7FD 2512             (    forth6809.asm):04983                     BLO   DPTEXIT
E7FF 2007             (    forth6809.asm):04984                     BRA   DPCONT
E801 DC18             (    forth6809.asm):04985         DPNEG:      LDD   MSCR3             ; step < 0: crossed if new_u > old_u
E803 109316           (    forth6809.asm):04986                     CMPD  MSCR2
E806 2209             (    forth6809.asm):04987                     BHI   DPTEXIT
E808 3510             (    forth6809.asm):04988         DPCONT:     PULS  X                 ; X = branch operand address
E80A EC84             (    forth6809.asm):04989                     LDD   ,X
E80C 308B             (    forth6809.asm):04990                     LEAX  D,X
E80E 3410             (    forth6809.asm):04991                     PSHS  X
E810 39               (    forth6809.asm):04992                     RTS
E811 3510             (    forth6809.asm):04993         DPTEXIT:    PULS  X
E813 3002             (    forth6809.asm):04994                     LEAX  2,X               ; skip the branch operand
E815 3266             (    forth6809.asm):04995                     LEAS  6,S               ; discard the loop frame
E817 3410             (    forth6809.asm):04996                     PSHS  X
E819 39               (    forth6809.asm):04997                     RTS
                      (    forth6809.asm):04998         

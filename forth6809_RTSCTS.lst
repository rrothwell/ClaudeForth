                      (    forth6809.asm):08732                     ORG   VECTORS           ; hardware vector table
FFF0 0000             (    forth6809.asm):08733         VRESV       FDB   $0000
FFF2 DDA4             (    forth6809.asm):08734         VSWI3       FDB   SWI3H             ; SWI3
FFF4 DDA5             (    forth6809.asm):08735         VSWI2       FDB   SWI2H             ; SWI2
FFF6 DDA6             (    forth6809.asm):08736         VFIRQ       FDB   FIRQH             ; FIRQ
FFF8 DD3B             (    forth6809.asm):08737         VIRQ        FDB   IRQH              ; IRQ
FFFA DDA8             (    forth6809.asm):08738         VSWI        FDB   SWIH              ; SWI
FFFC FFC5             (    forth6809.asm):08739         VNMI        FDB   WARM              ; NMI -> warm restart

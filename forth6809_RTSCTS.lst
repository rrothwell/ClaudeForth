DF1F 3606             (    forth6809.asm):05504                     PSHU  D
DF21 BDD578           (    forth6809.asm):05505                     JSR   WORDW
DF24 BDD661           (    forth6809.asm):05506                     JSR   FINDW
DF27 3706             (    forth6809.asm):05507                     PULU  D
DF29 10830000         (    forth6809.asm):05508                     CMPD  #0
DF2D 260A             (    forth6809.asm):05509                     BNE   PPFOUND
DF2F 3706             (    forth6809.asm):05510                     PULU  D
DF31 CCFFF3           (    forth6809.asm):05511                     LDD   #-13              ; -13
DF34 3606             (    forth6809.asm):05512                     PSHU  D
DF36 BDDA80           (    forth6809.asm):05513                     JSR   THROWW
DF39 10830001         (    forth6809.asm):05514         PPFOUND:    CMPD  #1                ; 1 = immediate
DF3D 270C             (    forth6809.asm):05515                     BEQ   PPIMM
DF3F BDDEC8           (    forth6809.asm):05516                     JSR   LITERALW
DF42 CCDEB8           (    forth6809.asm):05517                     LDD   #COMPILECOMMAW
DF45 3606             (    forth6809.asm):05518                     PSHU  D
DF47 BDDEBB           (    forth6809.asm):05519                     JSR   CCALL
DF4A 39               (    forth6809.asm):05520                     RTS
DF4B BDDEB8           (    forth6809.asm):05521         PPIMM:      JSR   COMPILECOMMAW
DF4E 39               (    forth6809.asm):05522                     RTS
                      (    forth6809.asm):05523         
                      (    forth6809.asm):05524         ; ------------------------------------------------------------
                      (    forth6809.asm):05525         ; [COMPILE]  ( "name" -- )
                      (    forth6809.asm):05526         ; Compile a call to the next name, whether or not it is immediate.
                      (    forth6809.asm):05527         ; Obsolescent: POSTPONE is the general replacement. THROW -14 if not
                      (    forth6809.asm):05528         ; compiling, -13 if the name is not found.
                      (    forth6809.asm):05529         ; Original comment: shadow BRACKCOMPILEW.0.
                      (    forth6809.asm):05530         ; ------------------------------------------------------------
DF4F                  (    forth6809.asm):05531         BRACKCOMPILEW:
DF4F DC00             (    forth6809.asm):05532                     LDD   STATE
DF51 2608             (    forth6809.asm):05533                     BNE   XCSTOK
DF53 CCFFF2           (    forth6809.asm):05534                     LDD   #-14
DF56 3606             (    forth6809.asm):05535                     PSHU  D
DF58 BDDA80           (    forth6809.asm):05536                     JSR   THROWW
DF5B CC0020           (    forth6809.asm):05537         XCSTOK:     LDD   #32
DF5E 3606             (    forth6809.asm):05538                     PSHU  D

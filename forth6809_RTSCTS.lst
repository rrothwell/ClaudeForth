                      (    forth6809.asm):05231         ; ------------------------------------------------------------
                      (    forth6809.asm):05232         ; EXIT  ( -- )
                      (    forth6809.asm):05233         ; Compile a call to EXITUNLOOP followed by a count of the DO frames
                      (    forth6809.asm):05234         ; found on the control-flow stack. The count is not used at run time.
                      (    forth6809.asm):05235         ; A loop must be left with UNLOOP before EXIT.
                      (    forth6809.asm):05236         ; ------------------------------------------------------------
DDAF 108E0000         (    forth6809.asm):05237         EXITW:      LDY   #0                ; Y = count of DO frames (5k: no scratch)
DDB3 1F31             (    forth6809.asm):05238                     TFR   U,X               ; X = scan pointer
DDB5 9C21             (    forth6809.asm):05239         EXSCAN:     CMPX  CSP
DDB7 270E             (    forth6809.asm):05240                     BEQ   EXSCANDONE
DDB9 EC84             (    forth6809.asm):05241                     LDD   ,X
DDBB 10830003         (    forth6809.asm):05242                     CMPD  #TAGDO
DDBF 2602             (    forth6809.asm):05243                     BNE   EXNOTDO
DDC1 3121             (    forth6809.asm):05244                     LEAY  1,Y
DDC3 3004             (    forth6809.asm):05245         EXNOTDO:    LEAX  4,X
DDC5 20EE             (    forth6809.asm):05246                     BRA   EXSCAN
DDC7                  (    forth6809.asm):05247         EXSCANDONE:
DDC7 3420             (    forth6809.asm):05248                     PSHS  Y                 ; the count survives CCALL on S
DDC9 CCDDD9           (    forth6809.asm):05249                     LDD   #EXITUNLOOP
DDCC 3606             (    forth6809.asm):05250                     PSHU  D
DDCE BDDEBB           (    forth6809.asm):05251                     JSR   CCALL
DDD1 3506             (    forth6809.asm):05252                     PULS  D
DDD3 3606             (    forth6809.asm):05253                     PSHU  D
DDD5 BDD1CF           (    forth6809.asm):05254                     JSR   CODECOMMA
DDD8 39               (    forth6809.asm):05255                     RTS
                      (    forth6809.asm):05256         
                      (    forth6809.asm):05257         ; ------------------------------------------------------------
                      (    forth6809.asm):05258         ; Run-time part of EXIT: drop the address of the inline count, then
                      (    forth6809.asm):05259         ; return from the definition. Loop frames are not discarded.
                      (    forth6809.asm):05260         ; EXITUNLOOP
                      (    forth6809.asm):05261         ;    Inputs:
                      (    forth6809.asm):05262         ;        S holds the address of the inline count, then the return
                      (    forth6809.asm):05263         ;        address
                      (    forth6809.asm):05264         ;    Outputs:
                      (    forth6809.asm):05265         ;        returns to the caller of the definition
                      (    forth6809.asm):05266         ;    Registers: RegX and RegY changed.
                      (    forth6809.asm):05267         ; ------------------------------------------------------------
DDD9 3510             (    forth6809.asm):05268         EXITUNLOOP: PULS  X                 ; See bugfix: EXITUNLOOP.1
DDDB 3520             (    forth6809.asm):05269                     PULS  Y                 ; Y = return address
DDDD 6EA4             (    forth6809.asm):05270                     JMP   ,Y
                      (    forth6809.asm):05271         
                      (    forth6809.asm):05272         ; ------------------------------------------------------------
                      (    forth6809.asm):05273         ; CASE  ( C: -- case-sys )
                      (    forth6809.asm):05274         ; Start a CASE structure. Leave a filler cell and TAGCASE, a 4-byte
                      (    forth6809.asm):05275         ; frame like those of DO and OF, which the EXIT scan relies on.
                      (    forth6809.asm):05276         ; ------------------------------------------------------------
DDDF CC0000           (    forth6809.asm):05277         CASEW:      LDD   #0                ; filler. See bugfix: CASEW.1
DDE2 3606             (    forth6809.asm):05278                     PSHU  D
DDE4 CC0004           (    forth6809.asm):05279                     LDD   #TAGCASE
DDE7 3606             (    forth6809.asm):05280                     PSHU  D
DDE9 39               (    forth6809.asm):05281                     RTS
                      (    forth6809.asm):05282         
                      (    forth6809.asm):05283         ; ------------------------------------------------------------

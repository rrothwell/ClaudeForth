                      (    forth6809.asm):05773         ; ------------------------------------------------------------
EBB7 3706             (    forth6809.asm):05774         MINUSW:     PULU  D                 ; n2
EBB9 DD14             (    forth6809.asm):05775                     STD   MSCR

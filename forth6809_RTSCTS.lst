                      (    forth6809.asm):05385         ; ------------------------------------------------------------
                      (    forth6809.asm):05386         ; [  ( -- )
                      (    forth6809.asm):05387         ; Enter interpretation state: STATE = 0.
                      (    forth6809.asm):05388         ; ------------------------------------------------------------
DE8E CC0000           (    forth6809.asm):05389         LBRACKETW:  LDD   #0
DE91 DD00             (    forth6809.asm):05390                     STD   STATE
DE93 39               (    forth6809.asm):05391                     RTS
                      (    forth6809.asm):05392         
                      (    forth6809.asm):05393         ; ------------------------------------------------------------
                      (    forth6809.asm):05394         ; ]  ( -- )

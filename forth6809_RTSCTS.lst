                      (    forth6809.asm):05398         ; 2OVER  ( x1 x2 x3 x4 -- x1 x2 x3 x4 x1 x2 )
                      (    forth6809.asm):05399         ; Copy the second cell pair to the top.
                      (    forth6809.asm):05400         ; ------------------------------------------------------------
EB11 EC46             (    forth6809.asm):05401         DOVERW:     LDD   6,U               ; x1
EB13 AE44             (    forth6809.asm):05402                     LDX   4,U               ; x2
EB15 3606             (    forth6809.asm):05403                     PSHU  D
EB17 3610             (    forth6809.asm):05404                     PSHU  X
EB19 39               (    forth6809.asm):05405                     RTS

                      (    forth6809.asm):04184         ; ============================================================
                      (    forth6809.asm):04185                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):04186         ; Unused alternative to KEY removed; see shadow X_KEY.1.

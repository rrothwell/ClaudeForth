                      (    forth6809.asm):02097         ; masked subtraction gives the true distance across the wrap.
                      (    forth6809.asm):02098         ; INFILL
                      (    forth6809.asm):02099         ;    Inputs:
                      (    forth6809.asm):02100         ;        none
                      (    forth6809.asm):02101         ;    Outputs:
                      (    forth6809.asm):02102         ;        RegA = (INHEAD - INTAIL) mod INBUFSZ
                      (    forth6809.asm):02103         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02104         ; ------------------------------------------------------------
CEAF B60176           (    forth6809.asm):02105         INFILL:     LDA   INHEAD

                      (    forth6809.asm):04759         ; ------------------------------------------------------------
                      (    forth6809.asm):04760         ; THROW  ( k*x n -- k*x | i*x n )
                      (    forth6809.asm):04761         ; If n is zero, do nothing. Otherwise restore the state saved by the
                      (    forth6809.asm):04762         ; most recent CATCH (S, U, input source, >IN, HANDLER) and make that
                      (    forth6809.asm):04763         ; CATCH return n. With no CATCH active, push n and ABORT.

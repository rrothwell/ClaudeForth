                      (    forth6809.asm):09059         ;        hardware reset
                      (    forth6809.asm):09060         ;    Outputs:
                      (    forth6809.asm):09061         ;        does not return
                      (    forth6809.asm):09062         ;    Registers: all registers initialised.
                      (    forth6809.asm):09063         ; ------------------------------------------------------------

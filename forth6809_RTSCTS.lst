                      (    forth6809.asm):05208         
                      (    forth6809.asm):05209         ; ------------------------------------------------------------
                      (    forth6809.asm):05210         ; Run-time part of ABORT". The counted string follows the call. If
                      (    forth6809.asm):05211         ; flag is non-zero, TYPE the string and THROW -2; otherwise skip over
                      (    forth6809.asm):05212         ; the string.
                      (    forth6809.asm):05213         ; DOABORTQUOTE   ( flag -- )
                      (    forth6809.asm):05214         ;    Inputs:
                      (    forth6809.asm):05215         ;        flag on the data stack; return address on S points at the
                      (    forth6809.asm):05216         ;        count byte
                      (    forth6809.asm):05217         ;    Outputs:
                      (    forth6809.asm):05218         ;        execution continues after the string, or THROW -2
                      (    forth6809.asm):05219         ;    Registers: RegA, RegB, RegD, RegX, RegY changed.
                      (    forth6809.asm):05220         ; ------------------------------------------------------------
EA5C                  (    forth6809.asm):05221         DOABORTQUOTE:
EA5C 3510             (    forth6809.asm):05222                     PULS  X
EA5E E684             (    forth6809.asm):05223                     LDB   ,X

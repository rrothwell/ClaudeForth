EB3F EC84             (    forth6809.asm):05650                     LDD   ,X
EB41 3406             (    forth6809.asm):05651                     PSHS  D                 ; xu waits on the return stack
EB43 EC1E             (    forth6809.asm):05652         RLOOP:      LDD   -2,X

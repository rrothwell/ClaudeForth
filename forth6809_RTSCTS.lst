EA2F 39               (    forth6809.asm):04769                     RTS
                      (    forth6809.asm):04770         
                      (    forth6809.asm):04771         ; ------------------------------------------------------------
                      (    forth6809.asm):04772         ; [COMPILE]  ( "name" -- )
                      (    forth6809.asm):04773         ; Compile a call to the next name, whether or not it is immediate.
                      (    forth6809.asm):04774         ; Obsolescent: POSTPONE is the general replacement. THROW -14 if not

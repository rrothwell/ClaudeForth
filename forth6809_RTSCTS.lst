F29E C30001           (    forth6809.asm):06888                     ADDD  #1
F2A1 ED42             (    forth6809.asm):06889                     STD   2,U
F2A3 EC44             (    forth6809.asm):06890         MSLD1:      LDD   4,U               ; |d1|
F2A5 2A15             (    forth6809.asm):06891                     BPL   MSLMUL
F2A7 63E4             (    forth6809.asm):06892                     COM   ,S
F2A9 EC46             (    forth6809.asm):06893                     LDD   6,U

                      (    forth6809.asm):03683         ; ------------------------------------------------------------
E2C4 CC005B           (    forth6809.asm):03684         FORTHWLW:   LDD   #WLHEADS
E2C7 3606             (    forth6809.asm):03685                     PSHU  D

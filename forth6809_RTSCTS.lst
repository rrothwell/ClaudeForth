                      (    forth6809.asm):08866         ; ------------------------------------------------------------
F0EE DC39             (    forth6809.asm):08867         SAVEINPUTW: LDD   SRCADDR
F0F0 3606             (    forth6809.asm):08868                     PSHU  D
F0F2 DC3B             (    forth6809.asm):08869                     LDD   SRCLEN
F0F4 3606             (    forth6809.asm):08870                     PSHU  D

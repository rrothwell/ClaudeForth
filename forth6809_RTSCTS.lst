                      (    forth6809.asm):07072         ; ------------------------------------------------------------
F3A2 EC42             (    forth6809.asm):07073         FILLW:      LDD   2,U               ; u. char is at 0, c-addr at 4
F3A4 270F             (    forth6809.asm):07074                     BEQ   FDONE
F3A6 AE44             (    forth6809.asm):07075                     LDX   4,U
F3A8 318B             (    forth6809.asm):07076                     LEAY  D,X               ; end address
F3AA 10AF42           (    forth6809.asm):07077                     STY   2,U               ; keep it in u's slot as the loop limit
F3AD A641             (    forth6809.asm):07078                     LDA   1,U               ; fill byte. See bugfix: FILLW.1
F3AF A780             (    forth6809.asm):07079         FILLOOP:    STA   ,X+
F3B1 AC42             (    forth6809.asm):07080                     CMPX  2,U
F3B3 26FA             (    forth6809.asm):07081                     BNE   FILLOOP
F3B5 3346             (    forth6809.asm):07082         FDONE:      LEAU  6,U               ; drop the three parameters
F3B7 39               (    forth6809.asm):07083                     RTS
                      (    forth6809.asm):07084         
                      (    forth6809.asm):07085         ; ------------------------------------------------------------
                      (    forth6809.asm):07086         ; ERASE  ( c-addr u -- )
                      (    forth6809.asm):07087         ; Fill u bytes starting at c-addr with zero.
                      (    forth6809.asm):07088         ; ------------------------------------------------------------
F3B8 CC0000           (    forth6809.asm):07089         ERASEW:     LDD   #0
F3BB 3606             (    forth6809.asm):07090                     PSHU  D
F3BD 7EF3A2           (    forth6809.asm):07091                     JMP   FILLW
                      (    forth6809.asm):07092         
                      (    forth6809.asm):07093         ; ------------------------------------------------------------
                      (    forth6809.asm):07094         ; BLANK  ( c-addr u -- )

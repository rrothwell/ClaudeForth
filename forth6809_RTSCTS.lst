                      (    forth6809.asm):08906         ; ------------------------------------------------------------
                      (    forth6809.asm):08907         ; [IF]  ( flag -- )     [ELSE]  ( -- )     [THEN]  ( -- )
                      (    forth6809.asm):08908         ; Programming-Tools conditional compilation. All three are
                      (    forth6809.asm):08909         ; immediate, so they work while interpreting and while compiling.
                      (    forth6809.asm):08910         ; [IF] with a true flag does nothing. With a false flag, and for
                      (    forth6809.asm):08911         ; [ELSE], the input is skipped word by word, counting nested
                      (    forth6809.asm):08912         ; [IF]s, up to the matching [ELSE] or [THEN]. The three names are
                      (    forth6809.asm):08913         ; matched exactly, as the dictionary matches every name. If the line
                      (    forth6809.asm):08914         ; runs out, the next line is read with REFILL; if no more input is
                      (    forth6809.asm):08915         ; available the skip ends.
                      (    forth6809.asm):08916         ; [THEN] is a marker and does nothing when it is executed.
                      (    forth6809.asm):08917         ; The nesting level is kept at 0,S.
                      (    forth6809.asm):08918         ; ------------------------------------------------------------
FEED 3706             (    forth6809.asm):08919         BRIFW:      PULU  D
FEEF 10830000         (    forth6809.asm):08920                     CMPD  #0
FEF3 266D             (    forth6809.asm):08921                     BNE   BRTHENW           ; true: nothing to skip
FEF5 CC0001           (    forth6809.asm):08922         BRELSEW:    LDD   #1
FEF8 3406             (    forth6809.asm):08923                     PSHS  D                 ; level
FEFA BDF5F4           (    forth6809.asm):08924         BRNEXT:     JSR   PARSENAMEW
FEFD 3706             (    forth6809.asm):08925                     PULU  D                 ; length
FEFF 3710             (    forth6809.asm):08926                     PULU  X                 ; address
FF01 10830000         (    forth6809.asm):08927                     CMPD  #0
FF05 274E             (    forth6809.asm):08928                     BEQ   BRREFILL
FF07 10830004         (    forth6809.asm):08929                     CMPD  #4
FF0B 2734             (    forth6809.asm):08930                     BEQ   BR4
FF0D 10830006         (    forth6809.asm):08931                     CMPD  #6
FF11 26E7             (    forth6809.asm):08932                     BNE   BRNEXT
FF13 C606             (    forth6809.asm):08933                     LDB   #6
FF15 108EFF71         (    forth6809.asm):08934                     LDY   #BRSELSE
FF19 3410             (    forth6809.asm):08935                     PSHS  X
FF1B BDFF63           (    forth6809.asm):08936                     JSR   BRCMP
FF1E 3510             (    forth6809.asm):08937                     PULS  X
FF20 2609             (    forth6809.asm):08938                     BNE   BR6B
FF22 ECE4             (    forth6809.asm):08939                     LDD   ,S                ; [ELSE]: ends the skip at level 1
FF24 830001           (    forth6809.asm):08940                     SUBD  #1

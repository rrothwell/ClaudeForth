                      (    forth6809.asm):05462         ; 2ROT  ( x1 x2 x3 x4 x5 x6 -- x3 x4 x5 x6 x1 x2 )
                      (    forth6809.asm):05463         ; Rotate the third cell pair to the top. X and Y hold the pair
                      (    forth6809.asm):05464         ; while the others move.
                      (    forth6809.asm):05465         ; ------------------------------------------------------------
EB52 AE4A             (    forth6809.asm):05466         DROTW:      LDX   10,U              ; x1
EB54 10AE48           (    forth6809.asm):05467                     LDY   8,U               ; x2
EB57 EC46             (    forth6809.asm):05468                     LDD   6,U
EB59 ED4A             (    forth6809.asm):05469                     STD   10,U
EB5B EC44             (    forth6809.asm):05470                     LDD   4,U
EB5D ED48             (    forth6809.asm):05471                     STD   8,U
EB5F EC42             (    forth6809.asm):05472                     LDD   2,U
EB61 ED46             (    forth6809.asm):05473                     STD   6,U
EB63 EC40             (    forth6809.asm):05474                     LDD   0,U
EB65 ED44             (    forth6809.asm):05475                     STD   4,U
EB67 10AFC4           (    forth6809.asm):05476                     STY   ,U
EB6A AF42             (    forth6809.asm):05477                     STX   2,U
EB6C 39               (    forth6809.asm):05478                     RTS
                      (    forth6809.asm):05479         
                      (    forth6809.asm):05480         ; ------------------------------------------------------------
                      (    forth6809.asm):05481         ; >R  ( x -- )  ( R: -- x )
                      (    forth6809.asm):05482         ; Move x from the data stack to the return stack. The return address
                      (    forth6809.asm):05483         ; of this call is on top of S, so it is lifted off and put back around
                      (    forth6809.asm):05484         ; the transfer.
                      (    forth6809.asm):05485         ; ------------------------------------------------------------
EB6D 3706             (    forth6809.asm):05486         TORW:       PULU  D                 ; x
EB6F 3510             (    forth6809.asm):05487                     PULS  X
EB71 3406             (    forth6809.asm):05488                     PSHS  D
EB73 3410             (    forth6809.asm):05489                     PSHS  X
EB75 39               (    forth6809.asm):05490                     RTS
                      (    forth6809.asm):05491         
                      (    forth6809.asm):05492         ; ------------------------------------------------------------
                      (    forth6809.asm):05493         ; R>  ( -- x )  ( R: x -- )
                      (    forth6809.asm):05494         ; Move x from the return stack to the data stack. The return address
                      (    forth6809.asm):05495         ; of this call is on top of S, so it is lifted off and put back around
                      (    forth6809.asm):05496         ; the transfer.
                      (    forth6809.asm):05497         ; ------------------------------------------------------------
EB76 3510             (    forth6809.asm):05498         FROMRW:     PULS  X
EB78 3506             (    forth6809.asm):05499                     PULS  D                 ; x
EB7A 3410             (    forth6809.asm):05500                     PSHS  X
EB7C 3606             (    forth6809.asm):05501                     PSHU  D
EB7E 39               (    forth6809.asm):05502                     RTS
                      (    forth6809.asm):05503         
                      (    forth6809.asm):05504         ; ------------------------------------------------------------
                      (    forth6809.asm):05505         ; R@  ( -- x )  ( R: x -- x )
                      (    forth6809.asm):05506         ; Copy the top of the return stack to the data stack. The return
                      (    forth6809.asm):05507         ; address of this call is on top of S, so it is lifted off and put
                      (    forth6809.asm):05508         ; back around the transfer.
                      (    forth6809.asm):05509         ; ------------------------------------------------------------
EB7F 3510             (    forth6809.asm):05510         RFETCHW:    PULS  X
EB81 ECE4             (    forth6809.asm):05511                     LDD   ,S                ; x
EB83 3410             (    forth6809.asm):05512                     PSHS  X
EB85 3606             (    forth6809.asm):05513                     PSHU  D
EB87 39               (    forth6809.asm):05514                     RTS
                      (    forth6809.asm):05515         
                      (    forth6809.asm):05516         ; ------------------------------------------------------------
                      (    forth6809.asm):05517         ; 2>R  ( x1 x2 -- )  ( R: -- x1 x2 )
                      (    forth6809.asm):05518         ; Move a cell pair to the return stack. R2A and R2B are scratch. The
                      (    forth6809.asm):05519         ; return address of this call is on top of S, so it is lifted off and
                      (    forth6809.asm):05520         ; put back around the transfer.
                      (    forth6809.asm):05521         ; ------------------------------------------------------------
EB88 3510             (    forth6809.asm):05522         TWOTORW:    PULS  X                 ; return address
EB8A 3706             (    forth6809.asm):05523                     PULU  D                 ; x2
EB8C 3720             (    forth6809.asm):05524                     PULU  Y                 ; x1
EB8E 3420             (    forth6809.asm):05525                     PSHS  Y
EB90 3406             (    forth6809.asm):05526                     PSHS  D

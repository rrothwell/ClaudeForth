E026 ECC4             (    forth6809.asm):05739         DSWAPW:     LDD   ,U                ; x4
E028 DD14             (    forth6809.asm):05740                     STD   MSCR
E02A EC42             (    forth6809.asm):05741                     LDD   2,U               ; x3
E02C AE44             (    forth6809.asm):05742                     LDX   4,U               ; x2
E02E 10AE46           (    forth6809.asm):05743                     LDY   6,U               ; x1
E031 ED46             (    forth6809.asm):05744                     STD   6,U
E033 AFC4             (    forth6809.asm):05745                     STX   ,U
E035 10AF42           (    forth6809.asm):05746                     STY   2,U
E038 DC14             (    forth6809.asm):05747                     LDD   MSCR
E03A ED44             (    forth6809.asm):05748                     STD   4,U
E03C 39               (    forth6809.asm):05749                     RTS
                      (    forth6809.asm):05750         

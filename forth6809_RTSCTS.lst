DF02 10830000         (    forth6809.asm):03047                     CMPD  #0
DF06 260A             (    forth6809.asm):03048                     BNE   TOFOUND
DF08 3706             (    forth6809.asm):03049                     PULU  D
DF0A CCFFF3           (    forth6809.asm):03050                     LDD   #-13
DF0D 3606             (    forth6809.asm):03051                     PSHU  D
DF0F BDE542           (    forth6809.asm):03052                     JSR   THROWW

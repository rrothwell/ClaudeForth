                      (    forth6809.asm):09078         
FFBD BDDA4F           (    forth6809.asm):09079                     JSR   INITSERIAL
                      (    forth6809.asm):09080         
FFC0 1CAF             (    forth6809.asm):09081                     ANDCC #$AF              ; Enable IRQ & FIRQ
                      (    forth6809.asm):09082         
                      (    forth6809.asm):09083                     ; IRQ and FIRQ are unmasked above. See bugfix: COLDSTRT.1
                      (    forth6809.asm):09084         

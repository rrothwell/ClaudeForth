E2AE 240C             (    forth6809.asm):03669                     BHS   WLFULL
E2B0 CC0000           (    forth6809.asm):03670                     LDD   #0
E2B3 ED84             (    forth6809.asm):03671                     STD   ,X
E2B5 3610             (    forth6809.asm):03672                     PSHU  X
E2B7 3002             (    forth6809.asm):03673                     LEAX  2,X

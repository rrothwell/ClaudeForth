                      (    forth6809.asm):06618         ; ------------------------------------------------------------
F36F 3710             (    forth6809.asm):06619         TWOFETCHW:  PULU  X                 ; a-addr. See bugfix: TWOFETCHW.1
F371 EC02             (    forth6809.asm):06620                     LDD   2,X
F373 3606             (    forth6809.asm):06621                     PSHU  D
F375 EC84             (    forth6809.asm):06622                     LDD   ,X
F377 3606             (    forth6809.asm):06623                     PSHU  D
F379 39               (    forth6809.asm):06624                     RTS
                      (    forth6809.asm):06625         
                      (    forth6809.asm):06626         ; ------------------------------------------------------------
                      (    forth6809.asm):06627         ; 2!  ( x1 x2 a-addr -- )
                      (    forth6809.asm):06628         ; Store the cell pair: x2 at a-addr and x1 at a-addr+2.
                      (    forth6809.asm):06629         ; ------------------------------------------------------------
F37A 3710             (    forth6809.asm):06630         TWOSTOREW:  PULU  X                 ; a-addr
F37C 3706             (    forth6809.asm):06631                     PULU  D                 ; x2
F37E ED84             (    forth6809.asm):06632                     STD   ,X
F380 3706             (    forth6809.asm):06633                     PULU  D                 ; x1
F382 ED02             (    forth6809.asm):06634                     STD   2,X
F384 39               (    forth6809.asm):06635                     RTS
                      (    forth6809.asm):06636         
                      (    forth6809.asm):06637         ; ------------------------------------------------------------
                      (    forth6809.asm):06638         ; CMOVE  ( c-addr1 c-addr2 u -- )
                      (    forth6809.asm):06639         ; Copy u bytes from c-addr1 to c-addr2, starting at the low addresses.
                      (    forth6809.asm):06640         ; ------------------------------------------------------------
F385 ECC4             (    forth6809.asm):06641         CMOVEW:     LDD   ,U                ; u. Parameters stay on the data stack,
F387 2713             (    forth6809.asm):06642                     BEQ   CMDONE            ; addressed relative to U: u at 0, c-addr2
F389 AE44             (    forth6809.asm):06643                     LDX   4,U               ; at 2, c-addr1 at 4. See shadow CMOVEW.2
F38B 308B             (    forth6809.asm):06644                     LEAX  D,X               ; end address = c-addr1 + u
F38D AFC4             (    forth6809.asm):06645                     STX   ,U                ; keep it in u's old slot as the loop limit
F38F AE44             (    forth6809.asm):06646                     LDX   4,U               ; X = source
F391 10AE42           (    forth6809.asm):06647                     LDY   2,U               ; Y = destination
F394 A680             (    forth6809.asm):06648         CMVLOOP:    LDA   ,X+
F396 A7A0             (    forth6809.asm):06649                     STA   ,Y+
F398 ACC4             (    forth6809.asm):06650                     CMPX  ,U                ; reached the end address?
F39A 26F8             (    forth6809.asm):06651                     BNE   CMVLOOP
F39C 3346             (    forth6809.asm):06652         CMDONE:     LEAU  6,U               ; drop the three parameters
F39E 39               (    forth6809.asm):06653                     RTS
                      (    forth6809.asm):06654         
                      (    forth6809.asm):06655         ; ------------------------------------------------------------
                      (    forth6809.asm):06656         ; CMOVE>  ( c-addr1 c-addr2 u -- )
                      (    forth6809.asm):06657         ; Copy u bytes from c-addr1 to c-addr2, starting at the high
                      (    forth6809.asm):06658         ; addresses.
                      (    forth6809.asm):06659         ; ------------------------------------------------------------
F39F ECC4             (    forth6809.asm):06660         CMOVEGTW:   LDD   ,U                ; u. Parameters stay on the data stack:
F3A1 2711             (    forth6809.asm):06661                     BEQ   CGDONE            ; u at 0, c-addr2 at 2, c-addr1 at 4
F3A3 AE44             (    forth6809.asm):06662                     LDX   4,U
F3A5 308B             (    forth6809.asm):06663                     LEAX  D,X               ; X = one past the end of the source
F3A7 10AE42           (    forth6809.asm):06664                     LDY   2,U
F3AA 31AB             (    forth6809.asm):06665                     LEAY  D,Y               ; Y = one past the end of the destination
F3AC A682             (    forth6809.asm):06666         CGLOOP:     LDA   ,-X
F3AE A7A2             (    forth6809.asm):06667                     STA   ,-Y
F3B0 AC44             (    forth6809.asm):06668                     CMPX  4,U               ; back at the start of the source?
F3B2 26F8             (    forth6809.asm):06669                     BNE   CGLOOP
F3B4 3346             (    forth6809.asm):06670         CGDONE:     LEAU  6,U               ; drop the three parameters
F3B6 39               (    forth6809.asm):06671                     RTS
                      (    forth6809.asm):06672         
                      (    forth6809.asm):06673         ; ------------------------------------------------------------
                      (    forth6809.asm):06674         ; MOVE  ( addr1 addr2 u -- )
                      (    forth6809.asm):06675         ; Copy u bytes from addr1 to addr2, choosing CMOVE or CMOVE> so that
                      (    forth6809.asm):06676         ; overlapping regions are handled correctly.
                      (    forth6809.asm):06677         ; ------------------------------------------------------------
F3B7 EC42             (    forth6809.asm):06678         MOVEW:      LDD   2,U               ; addr2
F3B9 10A344           (    forth6809.asm):06679                     CMPD  4,U               ; addr1
F3BC 22E1             (    forth6809.asm):06680                     BHI   CMOVEGTW          ; addr2 above addr1: copy from the top
F3BE 7EF385           (    forth6809.asm):06681                     JMP   CMOVEW
                      (    forth6809.asm):06682         
                      (    forth6809.asm):06683         ; ------------------------------------------------------------
                      (    forth6809.asm):06684         ; FILL  ( c-addr u char -- )
                      (    forth6809.asm):06685         ; Store char in each of u bytes starting at c-addr.
                      (    forth6809.asm):06686         ; ------------------------------------------------------------
F3C1 EC42             (    forth6809.asm):06687         FILLW:      LDD   2,U               ; u. char is at 0, c-addr at 4
F3C3 270F             (    forth6809.asm):06688                     BEQ   FDONE
F3C5 AE44             (    forth6809.asm):06689                     LDX   4,U
F3C7 318B             (    forth6809.asm):06690                     LEAY  D,X               ; end address
F3C9 10AF42           (    forth6809.asm):06691                     STY   2,U               ; keep it in u's slot as the loop limit
F3CC A641             (    forth6809.asm):06692                     LDA   1,U               ; fill byte. See bugfix: FILLW.1
F3CE A780             (    forth6809.asm):06693         FILLOOP:    STA   ,X+
F3D0 AC42             (    forth6809.asm):06694                     CMPX  2,U
F3D2 26FA             (    forth6809.asm):06695                     BNE   FILLOOP
F3D4 3346             (    forth6809.asm):06696         FDONE:      LEAU  6,U               ; drop the three parameters
F3D6 39               (    forth6809.asm):06697                     RTS
                      (    forth6809.asm):06698         
                      (    forth6809.asm):06699         ; ------------------------------------------------------------
                      (    forth6809.asm):06700         ; ERASE  ( c-addr u -- )

DEB8                  (    forth6809.asm):05423         COMPILECOMMAW:
DEB8 7EDEBB           (    forth6809.asm):05424                     JMP   CCALL
                      (    forth6809.asm):05425         
                      (    forth6809.asm):05426         ; ------------------------------------------------------------
                      (    forth6809.asm):05427         ; Append a JSR to xt at the code pointer CODEHERE.
                      (    forth6809.asm):05428         ; CCALL   ( xt -- )
                      (    forth6809.asm):05429         ;    Inputs:
                      (    forth6809.asm):05430         ;        xt on the data stack
                      (    forth6809.asm):05431         ;    Outputs:
                      (    forth6809.asm):05432         ;        JSR xt appended at CODEHERE; CODEHERE advanced by 3
                      (    forth6809.asm):05433         ;    Registers: RegA, RegB, RegD and RegX changed.
                      (    forth6809.asm):05434         ; ------------------------------------------------------------
DEBB 9E08             (    forth6809.asm):05435         CCALL:      LDX   CODEHERE          ; X = code pointer

                      (    forth6809.asm):03485         ; ============================================================
                      (    forth6809.asm):03486         ; SECTION 9: OUTER INTERPRETER (INTERPRET / WORD / FIND / NUMBER?)
                      (    forth6809.asm):03487         ; ============================================================
                      (    forth6809.asm):03488         ; ------------------------------------------------------------
                      (    forth6809.asm):03489         ; INTERPRET  ( -- )
                      (    forth6809.asm):03490         ; Interpret the rest of the input source: parse each word and look it
                      (    forth6809.asm):03491         ; up. A found word is executed, or compiled when STATE is compile and
                      (    forth6809.asm):03492         ; it is not immediate. Anything else is converted as a single or
                      (    forth6809.asm):03493         ; double number (compiled as literals when compiling). An unknown word
                      (    forth6809.asm):03494         ; is typed and THROW -13 is raised.
                      (    forth6809.asm):03495         ; ------------------------------------------------------------
D4F8                  (    forth6809.asm):03496         INTERPRET:
D4F8 CC0020           (    forth6809.asm):03497         ILOOP:      LDD   #32               ; Delimiter: space. See bugfix: INTERPRET.1
D4FB 3606             (    forth6809.asm):03498                     PSHU  D                 ; char
D4FD BDD578           (    forth6809.asm):03499                     JSR   WORDW
D500 AEC4             (    forth6809.asm):03500                     LDX   ,U
D502 A684             (    forth6809.asm):03501                     LDA   ,X
D504 276F             (    forth6809.asm):03502                     BEQ   IDONE
                      (    forth6809.asm):03503         
D506 BDD661           (    forth6809.asm):03504                     JSR   FINDW
D509 3706             (    forth6809.asm):03505                     PULU  D
D50B 5D               (    forth6809.asm):03506                     TSTB
D50C 10270011         (    forth6809.asm):03507                     LBEQ  TRYNUM
                      (    forth6809.asm):03508         
D510 9601             (    forth6809.asm):03509                     LDA   STATE+1
D512 2708             (    forth6809.asm):03510                     BEQ   DOEXEC
D514 5D               (    forth6809.asm):03511                     TSTB
D515 2A05             (    forth6809.asm):03512                     BPL   DOEXEC
D517 BDDEBB           (    forth6809.asm):03513                     JSR   CCALL
D51A 20DC             (    forth6809.asm):03514                     BRA   ILOOP
                      (    forth6809.asm):03515         
D51C BDD1AE           (    forth6809.asm):03516         DOEXEC:     JSR   EXECUTEW
D51F 20D7             (    forth6809.asm):03517                     BRA   ILOOP
                      (    forth6809.asm):03518         
D521 BDD909           (    forth6809.asm):03519         TRYNUM:     JSR   NUMBERQ
D524 3706             (    forth6809.asm):03520                     PULU  D
D526 10830000         (    forth6809.asm):03521                     CMPD  #0                ; flag (PULU does not set CC)
D52A 273B             (    forth6809.asm):03522                     BEQ   BADWORD
                      (    forth6809.asm):03523         
D52C 10830001         (    forth6809.asm):03524                     CMPD  #1                ; 1 = double-number result
D530 2711             (    forth6809.asm):03525                     BEQ   TNDOUBLE          ; See shadow: INTERPRET.3
                      (    forth6809.asm):03526         
D532 DC00             (    forth6809.asm):03527                     LDD   STATE
D534 27C2             (    forth6809.asm):03528                     BEQ   ILOOP
D536 CCD129           (    forth6809.asm):03529                     LDD   #LIT
D539 3606             (    forth6809.asm):03530                     PSHU  D
D53B BDDEBB           (    forth6809.asm):03531                     JSR   CCALL
D53E BDD1CF           (    forth6809.asm):03532                     JSR   CODECOMMA
D541 20B5             (    forth6809.asm):03533                     BRA   ILOOP
                      (    forth6809.asm):03534         
D543                  (    forth6809.asm):03535         TNDOUBLE:                           ; U currently holds [UDLO(bottom), UDHI(top)], matching
                      (    forth6809.asm):03536                                             ; ANS's (ud1) stack order directly.
D543 DC00             (    forth6809.asm):03537                     LDD   STATE
D545 27B1             (    forth6809.asm):03538                     BEQ   ILOOP             ; interpreting: already correctly placed,
                      (    forth6809.asm):03539                                             ; nothing more to do
                      (    forth6809.asm):03540                     ; compiling: need two literals compiled in the order they
                      (    forth6809.asm):03541                     ; must execute at runtime - low first (lands deep), high
                      (    forth6809.asm):03542                     ; second (lands on top). UDHI is currently on top of U, so
                      (    forth6809.asm):03543                     ; pop it aside first, freeing UDLO to be compiled first.
D547 3706             (    forth6809.asm):03544                     PULU  D
D549 DD1A             (    forth6809.asm):03545                     STD   MSCR4             ; stash UDHI - confirmed safe scratch,
                      (    forth6809.asm):03546                                             ; untouched by CCALL/CODECOMMA
D54B CCD129           (    forth6809.asm):03547                     LDD   #LIT
D54E 3606             (    forth6809.asm):03548                     PSHU  D
D550 BDDEBB           (    forth6809.asm):03549                     JSR   CCALL
D553 BDD1CF           (    forth6809.asm):03550                     JSR   CODECOMMA         ; compiles UDLO (still on U underneath)
D556 CCD129           (    forth6809.asm):03551                     LDD   #LIT
D559 3606             (    forth6809.asm):03552                     PSHU  D
D55B BDDEBB           (    forth6809.asm):03553                     JSR   CCALL
D55E DC1A             (    forth6809.asm):03554                     LDD   MSCR4
D560 3606             (    forth6809.asm):03555                     PSHU  D
D562 BDD1CF           (    forth6809.asm):03556                     JSR   CODECOMMA         ; compiles UDHI
D565 2091             (    forth6809.asm):03557                     BRA   ILOOP
                      (    forth6809.asm):03558         
D567 BDEA93           (    forth6809.asm):03559         BADWORD:    JSR   COUNTW
D56A BDEA75           (    forth6809.asm):03560                     JSR   TYPEW
D56D CCFFF3           (    forth6809.asm):03561                     LDD   #-13
D570 3606             (    forth6809.asm):03562                     PSHU  D
D572 BDDA80           (    forth6809.asm):03563                     JSR   THROWW
                      (    forth6809.asm):03564         
D575 3710             (    forth6809.asm):03565         IDONE:      PULU  X                 ; c-addr from WORD (empty). See bugfix: INTERPRET.4
D577 39               (    forth6809.asm):03566                     RTS
                      (    forth6809.asm):03567         
                      (    forth6809.asm):03568         ; ------------------------------------------------------------
                      (    forth6809.asm):03569         ; WORD  ( char "<chars>ccc<char>" -- c-addr )
                      (    forth6809.asm):03570         ; Skip leading delimiters, then parse text up to the next char from
                      (    forth6809.asm):03571         ; the input source. The text is stored as a counted string at
                      (    forth6809.asm):03572         ; CODEHERE, which is not advanced. An exhausted input gives a zero
                      (    forth6809.asm):03573         ; count. Its scratch lives in an S frame; see shadow WORDW.7.
                      (    forth6809.asm):03574         ; ------------------------------------------------------------
D578 3706             (    forth6809.asm):03575         WORDW:      PULU  D                 ; char
D57A 327D             (    forth6809.asm):03576                     LEAS  -3,S              ; frame (5k): 0,S = delimiter,
D57C E7E4             (    forth6809.asm):03577                     STB   ,S                ; 1,S = start of the text
D57E DC10             (    forth6809.asm):03578                     LDD   TOIN
D580 9E39             (    forth6809.asm):03579                     LDX   SRCADDR
D582 308B             (    forth6809.asm):03580                     LEAX  D,X
D584 DC3B             (    forth6809.asm):03581                     LDD   SRCLEN
D586 9310             (    forth6809.asm):03582                     SUBD  TOIN
D588 10250055         (    forth6809.asm):03583                     LBLO  EMPTY             ; See bugfix: WORDW.1
D58C 1F02             (    forth6809.asm):03584                     TFR   D,Y
                      (    forth6809.asm):03585         
D58E 108C0000         (    forth6809.asm):03586         SKIPLP:     CMPY  #0
D592 274D             (    forth6809.asm):03587                     BEQ   EMPTY
D594 A684             (    forth6809.asm):03588                     LDA   ,X
D596 A1E4             (    forth6809.asm):03589                     CMPA  ,S
D598 2606             (    forth6809.asm):03590                     BNE   STARTW
D59A 3001             (    forth6809.asm):03591                     LEAX  1,X
D59C 313F             (    forth6809.asm):03592                     LEAY  -1,Y
D59E 20EE             (    forth6809.asm):03593                     BRA   SKIPLP
                      (    forth6809.asm):03594         
D5A0 AF61             (    forth6809.asm):03595         STARTW:     STX   1,S
D5A2 C600             (    forth6809.asm):03596                     LDB   #0
                      (    forth6809.asm):03597         
D5A4 108C0000         (    forth6809.asm):03598         SCANLP:     CMPY  #0
D5A8 2715             (    forth6809.asm):03599                     BEQ   ENDW
D5AA A684             (    forth6809.asm):03600                     LDA   ,X
D5AC A1E4             (    forth6809.asm):03601                     CMPA  ,S
D5AE 270B             (    forth6809.asm):03602                     BEQ   CONSUME
D5B0 C15A             (    forth6809.asm):03603                     CMPB  #WORDMAXCHARS     ; Length limit. See shadow: WORDW.2
D5B2 270B             (    forth6809.asm):03604                     BEQ   ENDW
D5B4 3001             (    forth6809.asm):03605                     LEAX  1,X
D5B6 313F             (    forth6809.asm):03606                     LEAY  -1,Y
D5B8 5C               (    forth6809.asm):03607                     INCB
D5B9 20E9             (    forth6809.asm):03608                     BRA   SCANLP
                      (    forth6809.asm):03609         
D5BB 3001             (    forth6809.asm):03610         CONSUME:    LEAX  1,X
D5BD 313F             (    forth6809.asm):03611                     LEAY  -1,Y
D5BF 3404             (    forth6809.asm):03612         ENDW:       PSHS  B                 ; Save the count. See bugfix: WORDW.3

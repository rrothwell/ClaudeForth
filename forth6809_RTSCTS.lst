D97E 3606             (    forth6809.asm):04582                     PSHU  D
D980 39               (    forth6809.asm):04583                     RTS
D981 CC0089           (    forth6809.asm):04584         KEYQVW:     LDD   #KEYQV
D984 3606             (    forth6809.asm):04585                     PSHU  D
D986 39               (    forth6809.asm):04586                     RTS
                      (    forth6809.asm):04587         
D987 CCCF5A           (    forth6809.asm):04588         COLDIO:     LDD   #IRQRTI           ; cold start only: no extra interrupt

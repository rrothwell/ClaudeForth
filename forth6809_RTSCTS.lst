                      (    forth6809.asm):07212         ; ------------------------------------------------------------
                      (    forth6809.asm):07213         ; COMPARE  ( c-addr1 u1 c-addr2 u2 -- n )
                      (    forth6809.asm):07214         ; Compare two strings byte by byte. n is -1, 0 or 1 as the first
                      (    forth6809.asm):07215         ; string is less than, equal to or greater than the second; if one is
                      (    forth6809.asm):07216         ; a prefix of the other, the shorter is less.

                      (    forth6809.asm):01996         ;        RTSSTATE, OUTACTIVITY
                      (    forth6809.asm):01997         ;    Outputs:
                      (    forth6809.asm):01998         ;        ACIACR written (OUTACTIVITY cleared when RTS is high)
                      (    forth6809.asm):01999         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02000         ; ------------------------------------------------------------
D9AB                  (    forth6809.asm):02001         UPDATE_RTS:
D9AB 7D0178           (    forth6809.asm):02002                     TST   RTSSTATE

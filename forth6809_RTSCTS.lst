                      (    forth6809.asm):04938         ; Compile ZBRANCH with a placeholder operand. Leave orig (its operand
                      (    forth6809.asm):04939         ; address) and TAGFWD on top of the BEGIN frame.
                      (    forth6809.asm):04940         ; ------------------------------------------------------------
DB6A CCD0BD           (    forth6809.asm):04941         WHILEW:     LDD   #ZBRANCH
DB6D 3606             (    forth6809.asm):04942                     PSHU  D
DB6F BDDE9C           (    forth6809.asm):04943                     JSR   CCALL
DB72 CC0000           (    forth6809.asm):04944                     LDD   #0
DB75 3606             (    forth6809.asm):04945                     PSHU  D
DB77 BDD15A           (    forth6809.asm):04946                     JSR   CODECOMMA
DB7A DC08             (    forth6809.asm):04947                     LDD   CODEHERE
DB7C 830002           (    forth6809.asm):04948                     SUBD  #2
DB7F 3606             (    forth6809.asm):04949                     PSHU  D                 ; orig
DB81 CC0001           (    forth6809.asm):04950                     LDD   #TAGFWD
DB84 3606             (    forth6809.asm):04951                     PSHU  D
DB86 39               (    forth6809.asm):04952                     RTS
                      (    forth6809.asm):04953         
                      (    forth6809.asm):04954         ; ------------------------------------------------------------
                      (    forth6809.asm):04955         ; REPEAT  ( C: orig dest -- )
                      (    forth6809.asm):04956         ; Compile BRANCH back to the BEGIN address and resolve the WHILE
                      (    forth6809.asm):04957         ; branch to just after it. A BEGIN frame beneath further open WHILE
                      (    forth6809.asm):04958         ; frames is found by scanning, and removed from beneath them.
                      (    forth6809.asm):04959         ; ------------------------------------------------------------
DB87 3706             (    forth6809.asm):04960         REPEATW:    PULU  D
DB89 10830001         (    forth6809.asm):04961                     CMPD  #TAGFWD
DB8D 2703             (    forth6809.asm):04962                     BEQ   RPOK1
DB8F BDDA2C           (    forth6809.asm):04963                     JSR   CFERR
DB92 3710             (    forth6809.asm):04964         RPOK1:      PULU  X                 ; orig
DB94 3410             (    forth6809.asm):04965                     PSHS  X                 ; 2,S = orig (5k: S-frame)
                      (    forth6809.asm):04966         
                      (    forth6809.asm):04967                     ; Find the BEGIN frame, scanning past any open TAGFWD frames.
                      (    forth6809.asm):04968                     ; See bugfix: REPEATW.1
DB96 3040             (    forth6809.asm):04969                     LEAX  0,U               ; scan from top of control stack
DB98 9F16             (    forth6809.asm):04970                     STX   MSCR2             ; MSCR2 = base of scan region
DB9A 9F1A             (    forth6809.asm):04971                     STX   MSCR4             ; MSCR4 = scan pointer
DB9C DC1A             (    forth6809.asm):04972         RPSCAN:     LDD   MSCR4
DB9E 109321           (    forth6809.asm):04973                     CMPD  CSP
DBA1 2603             (    forth6809.asm):04974                     BNE   RPSCANOK
DBA3 BDDA2C           (    forth6809.asm):04975                     JSR   CFERR             ; no matching BEGIN
DBA6 9E1A             (    forth6809.asm):04976         RPSCANOK:   LDX   MSCR4
DBA8 EC84             (    forth6809.asm):04977                     LDD   ,X
DBAA 10830002         (    forth6809.asm):04978                     CMPD  #TAGBACK
DBAE 2712             (    forth6809.asm):04979                     BEQ   RPFOUND
DBB0 10830001         (    forth6809.asm):04980                     CMPD  #TAGFWD
DBB4 2703             (    forth6809.asm):04981                     BEQ   RPSKIP
DBB6 BDDA2C           (    forth6809.asm):04982                     JSR   CFERR             ; anything else is a genuine mismatch
DBB9 DC1A             (    forth6809.asm):04983         RPSKIP:     LDD   MSCR4
DBBB C30004           (    forth6809.asm):04984                     ADDD  #4
DBBE DD1A             (    forth6809.asm):04985                     STD   MSCR4
DBC0 20DA             (    forth6809.asm):04986                     BRA   RPSCAN
DBC2 9E1A             (    forth6809.asm):04987         RPFOUND:    LDX   MSCR4             ; X = found BEGIN frame
DBC4 EC02             (    forth6809.asm):04988                     LDD   2,X               ; dest = BEGIN's address
DBC6 3406             (    forth6809.asm):04989                     PSHS  D                 ; 0,S = dest
                      (    forth6809.asm):04990         
                      (    forth6809.asm):04991                     ; Close the gap: move the frames above the BEGIN frame down 4
                      (    forth6809.asm):04992                     ; bytes, highest word first.
DBC8 DC1A             (    forth6809.asm):04993                     LDD   MSCR4
DBCA 9316             (    forth6809.asm):04994                     SUBD  MSCR2
DBCC DD18             (    forth6809.asm):04995                     STD   MSCR3             ; MSCR3 = bytes to shift
DBCE 2715             (    forth6809.asm):04996                     BEQ   RPSHIFTDONE
DBD0 DC18             (    forth6809.asm):04997         RPSHIFT:    LDD   MSCR3
DBD2 830002           (    forth6809.asm):04998                     SUBD  #2
DBD5 DD18             (    forth6809.asm):04999                     STD   MSCR3
DBD7 9E16             (    forth6809.asm):05000                     LDX   MSCR2
DBD9 308B             (    forth6809.asm):05001                     LEAX  D,X               ; X = MSCR2 + this pass's offset
DBDB EC84             (    forth6809.asm):05002                     LDD   ,X
DBDD 3004             (    forth6809.asm):05003                     LEAX  4,X
DBDF ED84             (    forth6809.asm):05004                     STD   ,X                ; copy one word 4 bytes higher
DBE1 DC18             (    forth6809.asm):05005                     LDD   MSCR3
DBE3 26EB             (    forth6809.asm):05006                     BNE   RPSHIFT
DBE5                  (    forth6809.asm):05007         RPSHIFTDONE:
DBE5 9E16             (    forth6809.asm):05008                     LDX   MSCR2
DBE7 3004             (    forth6809.asm):05009                     LEAX  4,X
DBE9 1F13             (    forth6809.asm):05010                     TFR   X,U               ; U now excludes BEGIN frame
                      (    forth6809.asm):05011         
DBEB CCD0D3           (    forth6809.asm):05012                     LDD   #BRANCH
DBEE 3606             (    forth6809.asm):05013                     PSHU  D
DBF0 BDDE9C           (    forth6809.asm):05014                     JSR   CCALL
DBF3 CC0000           (    forth6809.asm):05015                     LDD   #0
DBF6 3606             (    forth6809.asm):05016                     PSHU  D
DBF8 BDD15A           (    forth6809.asm):05017                     JSR   CODECOMMA
DBFB EC60             (    forth6809.asm):05018                     LDD   0,S               ; target = BEGIN's address
DBFD 3606             (    forth6809.asm):05019                     PSHU  D
DBFF DC08             (    forth6809.asm):05020                     LDD   CODEHERE
DC01 830002           (    forth6809.asm):05021                     SUBD  #2                ; location = the operand just compiled
DC04 3606             (    forth6809.asm):05022                     PSHU  D
DC06 BDDA96           (    forth6809.asm):05023                     JSR   PATCH
DC09 DC08             (    forth6809.asm):05024                     LDD   CODEHERE
DC0B 3606             (    forth6809.asm):05025                     PSHU  D
DC0D EC62             (    forth6809.asm):05026                     LDD   2,S               ; orig
DC0F 3606             (    forth6809.asm):05027                     PSHU  D
DC11 BDDA96           (    forth6809.asm):05028                     JSR   PATCH
DC14 3264             (    forth6809.asm):05029                     LEAS  4,S               ; drop the frame
DC16 39               (    forth6809.asm):05030                     RTS
                      (    forth6809.asm):05031         
                      (    forth6809.asm):05032         ; ------------------------------------------------------------
                      (    forth6809.asm):05033         ; RECURSE  ( -- )
                      (    forth6809.asm):05034         ; Compile a call to the word being defined (named or :NONAME), using
                      (    forth6809.asm):05035         ; the xt held in CURXT.
                      (    forth6809.asm):05036         ; ------------------------------------------------------------
DC17 DC1F             (    forth6809.asm):05037         RECURSEW:   LDD   CURXT             ; xt of word being compiled
DC19 3606             (    forth6809.asm):05038                     PSHU  D                 ; See bugfix: RECURSEW.1
DC1B BDDE9C           (    forth6809.asm):05039                     JSR   CCALL
DC1E 39               (    forth6809.asm):05040                     RTS
                      (    forth6809.asm):05041         
                      (    forth6809.asm):05042         ; ------------------------------------------------------------
                      (    forth6809.asm):05043         ; DO  ( C: -- dest )
                      (    forth6809.asm):05044         ; Compile a call to DOSETUP and leave the loop start address and TAGDO
                      (    forth6809.asm):05045         ; on the control-flow stack for LOOP or +LOOP.
                      (    forth6809.asm):05046         ; ------------------------------------------------------------
DC1F CCDC31           (    forth6809.asm):05047         DOW:        LDD   #DOSETUP
DC22 3606             (    forth6809.asm):05048                     PSHU  D
DC24 BDDE9C           (    forth6809.asm):05049                     JSR   CCALL
DC27 DC08             (    forth6809.asm):05050                     LDD   CODEHERE
DC29 3606             (    forth6809.asm):05051                     PSHU  D                 ; dest
DC2B CC0003           (    forth6809.asm):05052                     LDD   #TAGDO
DC2E 3606             (    forth6809.asm):05053                     PSHU  D
DC30 39               (    forth6809.asm):05054                     RTS
                      (    forth6809.asm):05055         
                      (    forth6809.asm):05056         ; ------------------------------------------------------------
                      (    forth6809.asm):05057         ; Run-time start of DO and ?DO: build the loop frame on S, beneath the
                      (    forth6809.asm):05058         ; return address.
                      (    forth6809.asm):05059         ; DOSETUP   ( limit index -- )
                      (    forth6809.asm):05060         ;    Inputs:
                      (    forth6809.asm):05061         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):05062         ;    Outputs:
                      (    forth6809.asm):05063         ;        S holds index, limit and a zero leave flag (top first)
                      (    forth6809.asm):05064         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):05065         ; ------------------------------------------------------------
DC31 3706             (    forth6809.asm):05066         DOSETUP:    PULU  D                 ; index
DC33 DD14             (    forth6809.asm):05067                     STD   MSCR
DC35 3706             (    forth6809.asm):05068                     PULU  D                 ; limit
DC37 DD16             (    forth6809.asm):05069                     STD   MSCR2
DC39 3510             (    forth6809.asm):05070                     PULS  X
DC3B CC0000           (    forth6809.asm):05071                     LDD   #0
DC3E 3406             (    forth6809.asm):05072                     PSHS  D
DC40 DC16             (    forth6809.asm):05073                     LDD   MSCR2
DC42 3406             (    forth6809.asm):05074                     PSHS  D
DC44 DC14             (    forth6809.asm):05075                     LDD   MSCR
DC46 3406             (    forth6809.asm):05076                     PSHS  D
DC48 3410             (    forth6809.asm):05077                     PSHS  X
DC4A 39               (    forth6809.asm):05078                     RTS
                      (    forth6809.asm):05079         
                      (    forth6809.asm):05080         ; ------------------------------------------------------------
                      (    forth6809.asm):05081         ; I  ( -- n )
                      (    forth6809.asm):05082         ; Push the index of the innermost loop (2,S, beyond the return
                      (    forth6809.asm):05083         ; address).
                      (    forth6809.asm):05084         ; ------------------------------------------------------------
DC4B EC62             (    forth6809.asm):05085         IW:         LDD   2,S               ; n. See bugfix: IW.1
DC4D 3606             (    forth6809.asm):05086                     PSHU  D
DC4F 39               (    forth6809.asm):05087                     RTS
                      (    forth6809.asm):05088         
                      (    forth6809.asm):05089         ; ------------------------------------------------------------
                      (    forth6809.asm):05090         ; J  ( -- n )
                      (    forth6809.asm):05091         ; Push the index of the next outer loop (8,S, beyond the return
                      (    forth6809.asm):05092         ; address and the inner loop frame).
                      (    forth6809.asm):05093         ; ------------------------------------------------------------
DC50 EC68             (    forth6809.asm):05094         JW:         LDD   8,S               ; n. See bugfix: JW.1
DC52 3606             (    forth6809.asm):05095                     PSHU  D
DC54 39               (    forth6809.asm):05096                     RTS
                      (    forth6809.asm):05097         
                      (    forth6809.asm):05098         ; ------------------------------------------------------------
                      (    forth6809.asm):05099         ; LEAVE  ( -- )
                      (    forth6809.asm):05100         ; Set the leave flag in the innermost loop frame. The loop exits at
                      (    forth6809.asm):05101         ; its next LOOP or +LOOP test.
                      (    forth6809.asm):05102         ; ------------------------------------------------------------
DC55 CCFFFF           (    forth6809.asm):05103         LEAVEW:     LDD   #TRUEV            ; true
DC58 ED66             (    forth6809.asm):05104                     STD   6,S               ; See bugfix: LEAVEW.1
DC5A 39               (    forth6809.asm):05105                     RTS
                      (    forth6809.asm):05106         
                      (    forth6809.asm):05107         ; ------------------------------------------------------------
                      (    forth6809.asm):05108         ; LOOP  ( C: dest -- )
                      (    forth6809.asm):05109         ; Compile a call to DOTEST followed by a displacement back to dest.
                      (    forth6809.asm):05110         ; For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):05111         ; ------------------------------------------------------------
DC5B 3706             (    forth6809.asm):05112         LOOPW:      PULU  D
DC5D 10830003         (    forth6809.asm):05113                     CMPD  #TAGDO
DC61 2703             (    forth6809.asm):05114                     BEQ   LOOPOK
DC63 BDDA2C           (    forth6809.asm):05115                     JSR   CFERR
DC66 3706             (    forth6809.asm):05116         LOOPOK:     PULU  D                 ; dest
DC68 3606             (    forth6809.asm):05117                     PSHU  D                 ; park dest. See bugfix: LOOPW.1
DC6A CCDC9A           (    forth6809.asm):05118                     LDD   #DOTEST
DC6D 3606             (    forth6809.asm):05119                     PSHU  D
DC6F BDDE9C           (    forth6809.asm):05120                     JSR   CCALL
DC72 CC0000           (    forth6809.asm):05121                     LDD   #0
DC75 3606             (    forth6809.asm):05122                     PSHU  D
DC77 BDD15A           (    forth6809.asm):05123                     JSR   CODECOMMA
DC7A DC08             (    forth6809.asm):05124                     LDD   CODEHERE
DC7C 830002           (    forth6809.asm):05125                     SUBD  #2
DC7F 3606             (    forth6809.asm):05126                     PSHU  D                 ; location; the parked dest is beneath
DC81 BDDA96           (    forth6809.asm):05127                     JSR   PATCH
                      (    forth6809.asm):05128         
DC84 ECC4             (    forth6809.asm):05129                     LDD   ,U
DC86 10830007         (    forth6809.asm):05130                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: LOOPW.2
DC8A 260D             (    forth6809.asm):05131                     BNE   LOOPDONE
DC8C 3706             (    forth6809.asm):05132                     PULU  D
DC8E 3710             (    forth6809.asm):05133                     PULU  X                 ; ?DO skip operand
DC90 DC08             (    forth6809.asm):05134                     LDD   CODEHERE
DC92 3606             (    forth6809.asm):05135                     PSHU  D
DC94 3610             (    forth6809.asm):05136                     PSHU  X
DC96 BDDA96           (    forth6809.asm):05137                     JSR   PATCH
DC99 39               (    forth6809.asm):05138         LOOPDONE:   RTS
                      (    forth6809.asm):05139         
                      (    forth6809.asm):05140         ; ------------------------------------------------------------
                      (    forth6809.asm):05141         ; Run-time end of LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):05142         ; the back-branch operand. Add 1 to the index. If the leave flag is
                      (    forth6809.asm):05143         ; set or the index has reached the limit, discard the loop frame and
                      (    forth6809.asm):05144         ; skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):05145         ; DOTEST
                      (    forth6809.asm):05146         ;    Inputs:
                      (    forth6809.asm):05147         ;        S holds return address, index, limit and leave flag (top
                      (    forth6809.asm):05148         ;        first)
                      (    forth6809.asm):05149         ;    Outputs:
                      (    forth6809.asm):05150         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):05151         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):05152         ; ------------------------------------------------------------
DC9A EC66             (    forth6809.asm):05153         DOTEST:     LDD   6,S               ; leave flag. See bugfix: DOTEST.1
DC9C 2615             (    forth6809.asm):05154                     BNE   DTEXIT            ; set: exit
DC9E EC62             (    forth6809.asm):05155                     LDD   2,S               ; index
DCA0 C30001           (    forth6809.asm):05156                     ADDD  #1
DCA3 ED62             (    forth6809.asm):05157                     STD   2,S
DCA5 10A364           (    forth6809.asm):05158                     CMPD  4,S               ; limit
DCA8 2709             (    forth6809.asm):05159                     BEQ   DTEXIT
DCAA 3510             (    forth6809.asm):05160                     PULS  X                 ; X = branch operand address
DCAC EC84             (    forth6809.asm):05161                     LDD   ,X
DCAE 308B             (    forth6809.asm):05162                     LEAX  D,X
DCB0 3410             (    forth6809.asm):05163                     PSHS  X                 ; return to loop start
DCB2 39               (    forth6809.asm):05164                     RTS
DCB3 3510             (    forth6809.asm):05165         DTEXIT:     PULS  X
DCB5 3002             (    forth6809.asm):05166                     LEAX  2,X               ; skip the branch operand
DCB7 3266             (    forth6809.asm):05167                     LEAS  6,S               ; discard the loop frame
DCB9 3410             (    forth6809.asm):05168                     PSHS  X
DCBB 39               (    forth6809.asm):05169                     RTS
                      (    forth6809.asm):05170         
                      (    forth6809.asm):05171         ; ------------------------------------------------------------
                      (    forth6809.asm):05172         ; +LOOP  ( C: dest -- )
                      (    forth6809.asm):05173         ; Compile a call to DOPLUSTEST followed by a displacement back to
                      (    forth6809.asm):05174         ; dest. For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):05175         ; ------------------------------------------------------------
DCBC 3706             (    forth6809.asm):05176         PLUSLOOPW:  PULU  D
DCBE 10830003         (    forth6809.asm):05177                     CMPD  #TAGDO
DCC2 2703             (    forth6809.asm):05178                     BEQ   PLOOPOK
DCC4 BDDA2C           (    forth6809.asm):05179                     JSR   CFERR
DCC7 3706             (    forth6809.asm):05180         PLOOPOK:    PULU  D                 ; dest
DCC9 3606             (    forth6809.asm):05181                     PSHU  D                 ; park dest. See bugfix: PLUSLOOPW.1
DCCB CCDCFB           (    forth6809.asm):05182                     LDD   #DOPLUSTEST
DCCE 3606             (    forth6809.asm):05183                     PSHU  D
DCD0 BDDE9C           (    forth6809.asm):05184                     JSR   CCALL
DCD3 CC0000           (    forth6809.asm):05185                     LDD   #0
DCD6 3606             (    forth6809.asm):05186                     PSHU  D
DCD8 BDD15A           (    forth6809.asm):05187                     JSR   CODECOMMA
DCDB DC08             (    forth6809.asm):05188                     LDD   CODEHERE
DCDD 830002           (    forth6809.asm):05189                     SUBD  #2
DCE0 3606             (    forth6809.asm):05190                     PSHU  D                 ; location; the parked dest is beneath
DCE2 BDDA96           (    forth6809.asm):05191                     JSR   PATCH
                      (    forth6809.asm):05192         
DCE5 ECC4             (    forth6809.asm):05193                     LDD   ,U
DCE7 10830007         (    forth6809.asm):05194                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: PLUSLOOPW.2
DCEB 260D             (    forth6809.asm):05195                     BNE   PLOOPDONE
DCED 3706             (    forth6809.asm):05196                     PULU  D
DCEF 3710             (    forth6809.asm):05197                     PULU  X                 ; ?DO skip operand
DCF1 DC08             (    forth6809.asm):05198                     LDD   CODEHERE
DCF3 3606             (    forth6809.asm):05199                     PSHU  D
DCF5 3610             (    forth6809.asm):05200                     PSHU  X
DCF7 BDDA96           (    forth6809.asm):05201                     JSR   PATCH
DCFA 39               (    forth6809.asm):05202         PLOOPDONE:  RTS
                      (    forth6809.asm):05203         
                      (    forth6809.asm):05204         ; ------------------------------------------------------------
                      (    forth6809.asm):05205         ; Run-time end of +LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):05206         ; the back-branch operand. Add the step to the index. If the leave
                      (    forth6809.asm):05207         ; flag is set or the index crossed the limit, discard the loop frame
                      (    forth6809.asm):05208         ; and skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):05209         ; DOPLUSTEST   ( n -- )
                      (    forth6809.asm):05210         ;    Inputs:
                      (    forth6809.asm):05211         ;        step n on the data stack; S as for DOTEST
                      (    forth6809.asm):05212         ;    Outputs:
                      (    forth6809.asm):05213         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):05214         ;    Registers: RegD and RegX changed; MSCR, MSCR2 and MSCR3 used as
                      (    forth6809.asm):05215         ;        scratch.
                      (    forth6809.asm):05216         ; ------------------------------------------------------------
DCFB 3706             (    forth6809.asm):05217         DOPLUSTEST: PULU  D                 ; n = step. See bugfix: DOPLUSTEST.1
DCFD DD14             (    forth6809.asm):05218                     STD   MSCR              ; MSCR = step
DCFF EC66             (    forth6809.asm):05219                     LDD   6,S               ; leave flag. See bugfix: DOPLUSTEST.2
DD01 262D             (    forth6809.asm):05220                     BNE   DPTEXIT           ; set: exit
DD03 EC62             (    forth6809.asm):05221                     LDD   2,S               ; old index
DD05 A364             (    forth6809.asm):05222                     SUBD  4,S               ; old_u = old_index - limit, mod 65536
DD07 DD16             (    forth6809.asm):05223                     STD   MSCR2
DD09 EC62             (    forth6809.asm):05224                     LDD   2,S
DD0B D314             (    forth6809.asm):05225                     ADDD  MSCR              ; new_index = old_index + step
DD0D ED62             (    forth6809.asm):05226                     STD   2,S
DD0F A364             (    forth6809.asm):05227                     SUBD  4,S               ; new_u = new_index - limit, mod 65536
DD11 DD18             (    forth6809.asm):05228                     STD   MSCR3
                      (    forth6809.asm):05229                     ; Crossing test on the unsigned distances old_u and new_u: with a
                      (    forth6809.asm):05230                     ; positive step the limit was crossed if new_u < old_u, with a
                      (    forth6809.asm):05231                     ; negative step if new_u > old_u. See bugfix: DOPLUSTEST.3
DD13 DC14             (    forth6809.asm):05232                     LDD   MSCR              ; reload the step to test its sign
DD15 2B09             (    forth6809.asm):05233                     BMI   DPNEG
DD17 DC18             (    forth6809.asm):05234         DPPOS:      LDD   MSCR3             ; step > 0: crossed if new_u < old_u
DD19 109316           (    forth6809.asm):05235                     CMPD  MSCR2
DD1C 2512             (    forth6809.asm):05236                     BLO   DPTEXIT
DD1E 2007             (    forth6809.asm):05237                     BRA   DPCONT
DD20 DC18             (    forth6809.asm):05238         DPNEG:      LDD   MSCR3             ; step < 0: crossed if new_u > old_u
DD22 109316           (    forth6809.asm):05239                     CMPD  MSCR2
DD25 2209             (    forth6809.asm):05240                     BHI   DPTEXIT
DD27 3510             (    forth6809.asm):05241         DPCONT:     PULS  X                 ; X = branch operand address
DD29 EC84             (    forth6809.asm):05242                     LDD   ,X
DD2B 308B             (    forth6809.asm):05243                     LEAX  D,X
DD2D 3410             (    forth6809.asm):05244                     PSHS  X
DD2F 39               (    forth6809.asm):05245                     RTS
DD30 3510             (    forth6809.asm):05246         DPTEXIT:    PULS  X
DD32 3002             (    forth6809.asm):05247                     LEAX  2,X               ; skip the branch operand
DD34 3266             (    forth6809.asm):05248                     LEAS  6,S               ; discard the loop frame
DD36 3410             (    forth6809.asm):05249                     PSHS  X
DD38 39               (    forth6809.asm):05250                     RTS
                      (    forth6809.asm):05251         
                      (    forth6809.asm):05252         ; ------------------------------------------------------------
                      (    forth6809.asm):05253         ; ?DO  ( C: -- orig dest )
                      (    forth6809.asm):05254         ; Compile a call to QDOSETUP with a placeholder skip operand. Leave
                      (    forth6809.asm):05255         ; orig (the skip operand address) and TAGQDO, then dest and TAGDO.

E52C 3406             (    forth6809.asm):04292                     PSHS  D
E52E 1F40             (    forth6809.asm):04293                     TFR   S,D
E530 DD0C             (    forth6809.asm):04294                     STD   HANDLER
                      (    forth6809.asm):04295         
E532 AD84             (    forth6809.asm):04296                     JSR   ,X
                      (    forth6809.asm):04297         
E534 3268             (    forth6809.asm):04298                     LEAS  8,S               ; drop saved input source
E536 3262             (    forth6809.asm):04299                     LEAS  2,S               ; saved U
E538 3506             (    forth6809.asm):04300                     PULS  D
E53A DD0C             (    forth6809.asm):04301                     STD   HANDLER
E53C CC0000           (    forth6809.asm):04302                     LDD   #0

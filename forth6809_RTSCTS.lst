                      (    forth6809.asm):05363         ; SECTION 13: COMPILING WORDS (IMMEDIATE/[/]/'/COMPILE,/
                      (    forth6809.asm):05364         ; LITERAL/[']/POSTPONE/>BODY, SLITERAL, ABORT")
                      (    forth6809.asm):05365         ; ============================================================

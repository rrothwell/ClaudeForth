EB6A AF42             (    forth6809.asm):05677                     STX   2,U
EB6C 39               (    forth6809.asm):05678                     RTS
                      (    forth6809.asm):05679         
                      (    forth6809.asm):05680         ; ------------------------------------------------------------
                      (    forth6809.asm):05681         ; >R  ( x -- )  ( R: -- x )
                      (    forth6809.asm):05682         ; Move x from the data stack to the return stack. The return address
                      (    forth6809.asm):05683         ; of this call is on top of S, so it is lifted off and put back around
                      (    forth6809.asm):05684         ; the transfer.
                      (    forth6809.asm):05685         ; ------------------------------------------------------------
EB6D 3706             (    forth6809.asm):05686         TORW:       PULU  D                 ; x
EB6F 3510             (    forth6809.asm):05687                     PULS  X
EB71 3406             (    forth6809.asm):05688                     PSHS  D
EB73 3410             (    forth6809.asm):05689                     PSHS  X
EB75 39               (    forth6809.asm):05690                     RTS
                      (    forth6809.asm):05691         
                      (    forth6809.asm):05692         ; ------------------------------------------------------------
                      (    forth6809.asm):05693         ; R>  ( -- x )  ( R: x -- )
                      (    forth6809.asm):05694         ; Move x from the return stack to the data stack. The return address
                      (    forth6809.asm):05695         ; of this call is on top of S, so it is lifted off and put back around
                      (    forth6809.asm):05696         ; the transfer.
                      (    forth6809.asm):05697         ; ------------------------------------------------------------
EB76 3510             (    forth6809.asm):05698         FROMRW:     PULS  X
EB78 3506             (    forth6809.asm):05699                     PULS  D                 ; x
EB7A 3410             (    forth6809.asm):05700                     PSHS  X
EB7C 3606             (    forth6809.asm):05701                     PSHU  D
EB7E 39               (    forth6809.asm):05702                     RTS
                      (    forth6809.asm):05703         
                      (    forth6809.asm):05704         ; ------------------------------------------------------------
                      (    forth6809.asm):05705         ; R@  ( -- x )  ( R: x -- x )
                      (    forth6809.asm):05706         ; Copy the top of the return stack to the data stack. The return
                      (    forth6809.asm):05707         ; address of this call is on top of S, so it is lifted off and put
                      (    forth6809.asm):05708         ; back around the transfer.
                      (    forth6809.asm):05709         ; ------------------------------------------------------------
EB7F 3510             (    forth6809.asm):05710         RFETCHW:    PULS  X
EB81 ECE4             (    forth6809.asm):05711                     LDD   ,S                ; x
EB83 3410             (    forth6809.asm):05712                     PSHS  X
EB85 3606             (    forth6809.asm):05713                     PSHU  D
EB87 39               (    forth6809.asm):05714                     RTS
                      (    forth6809.asm):05715         
                      (    forth6809.asm):05716         ; ------------------------------------------------------------
                      (    forth6809.asm):05717         ; 2>R  ( x1 x2 -- )  ( R: -- x1 x2 )
                      (    forth6809.asm):05718         ; Move a cell pair to the return stack. R2A and R2B are scratch. The
                      (    forth6809.asm):05719         ; return address of this call is on top of S, so it is lifted off and
                      (    forth6809.asm):05720         ; put back around the transfer.
                      (    forth6809.asm):05721         ; ------------------------------------------------------------
EB88 3510             (    forth6809.asm):05722         TWOTORW:    PULS  X                 ; return address
EB8A 3706             (    forth6809.asm):05723                     PULU  D                 ; x2
EB8C 3720             (    forth6809.asm):05724                     PULU  Y                 ; x1
EB8E 3420             (    forth6809.asm):05725                     PSHS  Y
EB90 3406             (    forth6809.asm):05726                     PSHS  D
EB92 3410             (    forth6809.asm):05727                     PSHS  X
EB94 39               (    forth6809.asm):05728                     RTS
                      (    forth6809.asm):05729         
                      (    forth6809.asm):05730         ; ------------------------------------------------------------
                      (    forth6809.asm):05731         ; 2R>  ( -- x1 x2 )  ( R: x1 x2 -- )
                      (    forth6809.asm):05732         ; Move a cell pair from the return stack. The
                      (    forth6809.asm):05733         ; return address of this call is on top of S, so it is lifted off and
                      (    forth6809.asm):05734         ; put back around the transfer.
                      (    forth6809.asm):05735         ; ------------------------------------------------------------
EB95 3510             (    forth6809.asm):05736         TWOFROMRW:  PULS  X                 ; return address
EB97 3506             (    forth6809.asm):05737                     PULS  D                 ; x2
EB99 3520             (    forth6809.asm):05738                     PULS  Y                 ; x1
EB9B 3410             (    forth6809.asm):05739                     PSHS  X
EB9D 3620             (    forth6809.asm):05740                     PSHU  Y
EB9F 3606             (    forth6809.asm):05741                     PSHU  D
EBA1 39               (    forth6809.asm):05742                     RTS
                      (    forth6809.asm):05743         
                      (    forth6809.asm):05744         ; ------------------------------------------------------------
                      (    forth6809.asm):05745         ; 2R@  ( -- x1 x2 )  ( R: x1 x2 -- x1 x2 )
                      (    forth6809.asm):05746         ; Copy the top cell pair of the return stack.
                      (    forth6809.asm):05747         ; The return address of this call is on top of S, so it is lifted off
                      (    forth6809.asm):05748         ; and put back around the transfer.
                      (    forth6809.asm):05749         ; ------------------------------------------------------------
EBA2 3510             (    forth6809.asm):05750         TWORFETCHW: PULS  X                 ; return address
EBA4 ECE4             (    forth6809.asm):05751                     LDD   ,S                ; x2
EBA6 10AE62           (    forth6809.asm):05752                     LDY   2,S               ; x1
EBA9 3410             (    forth6809.asm):05753                     PSHS  X
EBAB 3620             (    forth6809.asm):05754                     PSHU  Y
EBAD 3606             (    forth6809.asm):05755                     PSHU  D
EBAF 39               (    forth6809.asm):05756                     RTS
                      (    forth6809.asm):05757         
                      (    forth6809.asm):05758         ; ============================================================
                      (    forth6809.asm):05759         ; SECTION 15: ARITHMETIC (single + double + mixed precision)
                      (    forth6809.asm):05760         ; ============================================================
                      (    forth6809.asm):05761         ; ------------------------------------------------------------
                      (    forth6809.asm):05762         ; +  ( n1 n2 -- n3 )
                      (    forth6809.asm):05763         ; Add n2 to n1.
                      (    forth6809.asm):05764         ; ------------------------------------------------------------
EBB0 3706             (    forth6809.asm):05765         PLUSW:      PULU  D                 ; n2

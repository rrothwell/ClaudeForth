                      (    forth6809.asm):05662         ; 2ROT  ( x1 x2 x3 x4 x5 x6 -- x3 x4 x5 x6 x1 x2 )
                      (    forth6809.asm):05663         ; Rotate the third cell pair to the top. X and Y hold the pair
                      (    forth6809.asm):05664         ; while the others move.
                      (    forth6809.asm):05665         ; ------------------------------------------------------------
EB52 AE4A             (    forth6809.asm):05666         DROTW:      LDX   10,U              ; x1
EB54 10AE48           (    forth6809.asm):05667                     LDY   8,U               ; x2
EB57 EC46             (    forth6809.asm):05668                     LDD   6,U
EB59 ED4A             (    forth6809.asm):05669                     STD   10,U
EB5B EC44             (    forth6809.asm):05670                     LDD   4,U
EB5D ED48             (    forth6809.asm):05671                     STD   8,U
EB5F EC42             (    forth6809.asm):05672                     LDD   2,U
EB61 ED46             (    forth6809.asm):05673                     STD   6,U

                      (    forth6809.asm):01860         ; Reset the serial ring buffers, flow-control state and
                      (    forth6809.asm):01861         ; receiver-error counters to zero.
                      (    forth6809.asm):01862         ; SERBUFCLR
                      (    forth6809.asm):01863         ;    Inputs:
                      (    forth6809.asm):01864         ;        none
                      (    forth6809.asm):01865         ;    Outputs:
                      (    forth6809.asm):01866         ;        INHEAD, INTAIL, OUTHEAD, OUTTAIL, RTSSTATE, OUTACTIVITY,
                      (    forth6809.asm):01867         ;        FECOUNT, OVRNCOUNT, PECOUNT and POLLREADYCNT all cleared
                      (    forth6809.asm):01868         ;    Registers: only CC changed.
                      (    forth6809.asm):01869         ; Original comment: shadow SERBUFCLR.0.
                      (    forth6809.asm):01870         ; See bugfix: SERBUFCLR.1.
                      (    forth6809.asm):01871         ; ------------------------------------------------------------
                      (    forth6809.asm):01872         

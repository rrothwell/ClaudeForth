E3F5 3620             (    forth6809.asm):04122                     PSHU  Y                 ; ud low
E3F7 3620             (    forth6809.asm):04123                     PSHU  Y                 ; ud high
E3F9 3610             (    forth6809.asm):04124                     PSHU  X                 ; c-addr
E3FB 4F               (    forth6809.asm):04125                     CLRA
E3FC 3606             (    forth6809.asm):04126                     PSHU  D                 ; u
                      (    forth6809.asm):04127         

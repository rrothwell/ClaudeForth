EA78 7EF40C           (    forth6809.asm):04821                     JMP   CSTRCOMP          ; compile DOSTR and the counted string
                      (    forth6809.asm):04822         
                      (    forth6809.asm):04823         ; ------------------------------------------------------------
                      (    forth6809.asm):04824         ; Run-time part of ABORT". The counted string follows the call. If
                      (    forth6809.asm):04825         ; flag is non-zero, TYPE the string and THROW -2; otherwise skip over
                      (    forth6809.asm):04826         ; the string.
                      (    forth6809.asm):04827         ; DOABORTQUOTE   ( flag -- )
                      (    forth6809.asm):04828         ;    Inputs:
                      (    forth6809.asm):04829         ;        flag on the data stack; return address on S points at the
                      (    forth6809.asm):04830         ;        count byte
                      (    forth6809.asm):04831         ;    Outputs:
                      (    forth6809.asm):04832         ;        execution continues after the string, or THROW -2
                      (    forth6809.asm):04833         ;    Registers: RegA, RegB, RegD, RegX, RegY changed.
                      (    forth6809.asm):04834         ; ------------------------------------------------------------
EA7B                  (    forth6809.asm):04835         DOABORTQUOTE:
EA7B 3510             (    forth6809.asm):04836                     PULS  X
EA7D E684             (    forth6809.asm):04837                     LDB   ,X
EA7F 3001             (    forth6809.asm):04838                     LEAX  1,X               ; X = text, B = length
EA81 4F               (    forth6809.asm):04839                     CLRA
EA82 3720             (    forth6809.asm):04840                     PULU  Y                 ; flag
EA84 108C0000         (    forth6809.asm):04841                     CMPY  #0
EA88 2605             (    forth6809.asm):04842                     BNE   AQTHROW
EA8A 3085             (    forth6809.asm):04843                     LEAX  B,X
EA8C 3410             (    forth6809.asm):04844                     PSHS  X
EA8E 39               (    forth6809.asm):04845                     RTS
EA8F 3610             (    forth6809.asm):04846         AQTHROW:    PSHU  X
EA91 3606             (    forth6809.asm):04847                     PSHU  D
EA93 BDF570           (    forth6809.asm):04848                     JSR   TYPEW
EA96 CCFFFE           (    forth6809.asm):04849                     LDD   #-2               ; -2
EA99 3606             (    forth6809.asm):04850                     PSHU  D
EA9B 7EE561           (    forth6809.asm):04851                     JMP   THROWW
                      (    forth6809.asm):04852         
                      (    forth6809.asm):04853         ; ------------------------------------------------------------
                      (    forth6809.asm):04854         ; ABORT"  ( "ccc<quote>" -- )
                      (    forth6809.asm):04855         ; Compile DOABORTQUOTE followed by the string up to the closing quote
                      (    forth6809.asm):04856         ; as a counted string. THROW -14 if not compiling.
                      (    forth6809.asm):04857         ; ------------------------------------------------------------
EA9E                  (    forth6809.asm):04858         ABORTQUOTEW:

                      (    forth6809.asm):07549         ; S\"  ( "ccc<quote>" -- c-addr u )
                      (    forth6809.asm):07550         ; As S", but the text may contain escape sequences introduced by a
                      (    forth6809.asm):07551         ; backslash, and a backslash-quote does not end the string. The
                      (    forth6809.asm):07552         ; translated text is built at PAD and then handled exactly like S" text
                      (    forth6809.asm):07553         ; (SQSTATE). The escapes are: \a 7, \b 8, \e 27, \f 12, \l 10, \m the
                      (    forth6809.asm):07554         ; pair 13 10, \n 10, \q 34, \r 13, \t 9, \v 11, \z 0, \" 34, \\ 92 and
                      (    forth6809.asm):07555         ; \xhh (one or two hex digits). Any other character after a backslash
                      (    forth6809.asm):07556         ; stands for itself. An unterminated string ends at the end of the line.
                      (    forth6809.asm):07557         ; A result over 255 characters throws -18.
                      (    forth6809.asm):07558         ; Frame on S: 0,S input end, 2,S output start, 4,S output pointer.
                      (    forth6809.asm):07559         ; ------------------------------------------------------------
E950 BDD209           (    forth6809.asm):07560         SQUOTEESCW: JSR   PADW              ; leaves PAD on the data stack
E953 ECC4             (    forth6809.asm):07561                     LDD   ,U
E955 3406             (    forth6809.asm):07562                     PSHS  D                 ; output pointer
E957 3406             (    forth6809.asm):07563                     PSHS  D                 ; output start
E959 DC39             (    forth6809.asm):07564                     LDD   SRCADDR
E95B D33B             (    forth6809.asm):07565                     ADDD  SRCLEN
E95D 3406             (    forth6809.asm):07566                     PSHS  D                 ; input end
E95F DC39             (    forth6809.asm):07567                     LDD   SRCADDR
E961 D310             (    forth6809.asm):07568                     ADDD  TOIN
E963 1F02             (    forth6809.asm):07569                     TFR   D,Y               ; input pointer
E965 10AC60           (    forth6809.asm):07570         SQEL:       CMPY  0,S
E968 247E             (    forth6809.asm):07571                     BHS   SQEND
E96A A6A0             (    forth6809.asm):07572                     LDA   ,Y+
E96C 8122             (    forth6809.asm):07573                     CMPA  #34
E96E 2778             (    forth6809.asm):07574                     BEQ   SQEND
E970 815C             (    forth6809.asm):07575                     CMPA  #92
E972 261C             (    forth6809.asm):07576                     BNE   SQEPUT
E974 10AC60           (    forth6809.asm):07577                     CMPY  0,S
E977 246F             (    forth6809.asm):07578                     BHS   SQEND
E979 A6A0             (    forth6809.asm):07579                     LDA   ,Y+               ; the escaped character
E97B 8178             (    forth6809.asm):07580                     CMPA  #'x'
E97D 2727             (    forth6809.asm):07581                     BEQ   SQEHEX
E97F 816D             (    forth6809.asm):07582                     CMPA  #'m'

FF34 26C4             (    forth6809.asm):08946                     BNE   BRNEXT
FF36 ECE4             (    forth6809.asm):08947                     LDD   ,S                ; [THEN]: one level less
FF38 830001           (    forth6809.asm):08948                     SUBD  #1
FF3B EDE4             (    forth6809.asm):08949                     STD   ,S
FF3D 2721             (    forth6809.asm):08950                     BEQ   BRDONE
FF3F 20B9             (    forth6809.asm):08951                     BRA   BRNEXT
FF41 C604             (    forth6809.asm):08952         BR4:        LDB   #4
FF43 108EFF6D         (    forth6809.asm):08953                     LDY   #BRSIF
FF47 BDFF63           (    forth6809.asm):08954                     JSR   BRCMP
FF4A 26AE             (    forth6809.asm):08955                     BNE   BRNEXT
FF4C ECE4             (    forth6809.asm):08956                     LDD   ,S                ; [IF]: one level more
FF4E C30001           (    forth6809.asm):08957                     ADDD  #1
FF51 EDE4             (    forth6809.asm):08958                     STD   ,S
FF53 20A5             (    forth6809.asm):08959                     BRA   BRNEXT

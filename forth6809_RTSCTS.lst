E8F7 3706             (    forth6809.asm):07591                     PULU  D                 ; u
E8F9 3720             (    forth6809.asm):07592                     PULU  Y                 ; c-addr
E8FB 9E08             (    forth6809.asm):07593                     LDX   CODEHERE
E8FD E780             (    forth6809.asm):07594                     STB   ,X+
E8FF 5D               (    forth6809.asm):07595                     TSTB
E900 2707             (    forth6809.asm):07596                     BEQ   CSEND

D06B 3610             (    forth6809.asm):02519                     PSHU  X                 ; c-addr
D06D CC000F           (    forth6809.asm):02520                     LDD   #SIGNONL
D070 3606             (    forth6809.asm):02521                     PSHU  D                 ; u

                      (    forth6809.asm):03495         ; Convert a counted string to a number in BASE. A leading "-" negates
                      (    forth6809.asm):03496         ; it; a trailing "." makes it a double-cell number.
                      (    forth6809.asm):03497         ; NUMBERQ   ( c-addr -- n -1 | ud 1 | c-addr 0 )
                      (    forth6809.asm):03498         ;    Inputs:
                      (    forth6809.asm):03499         ;        c-addr of the counted string on the data stack
                      (    forth6809.asm):03500         ;    Outputs:
                      (    forth6809.asm):03501         ;        single number: n and -1
                      (    forth6809.asm):03502         ;        double number: ud (low cell below high cell) and 1
                      (    forth6809.asm):03503         ;        not a number: c-addr and 0
                      (    forth6809.asm):03504         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):03505         ; The original c-addr and the negate flag live in an S frame (0,S and
                      (    forth6809.asm):03506         ; 2,S); the count is kept in RegB. See shadow NUMBERQ.1 and
                      (    forth6809.asm):03507         ; NUMBERQ.6.
                      (    forth6809.asm):03508         ; ------------------------------------------------------------

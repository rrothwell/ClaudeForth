                      (    forth6809.asm):04546         ; ------------------------------------------------------------
D963                  (    forth6809.asm):04547         EMITACIA:    PULU  D                 ; char
                      (    forth6809.asm):04548                     STB   EMITCH
D963                  (    forth6809.asm):04549         EMITWT:     LDA   ACIASR
                      (    forth6809.asm):04550                     BITA  #SR_TDRE
                      (    forth6809.asm):04551                     BEQ   EMITWT
                      (    forth6809.asm):04552                     LDA   EMITCH
                      (    forth6809.asm):04553                     STA   ACIADR
                      (    forth6809.asm):04554                     RTS
                      (    forth6809.asm):04555         
                      (    forth6809.asm):04556                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):04557         
                      (    forth6809.asm):04558         ; ------------------------------------------------------------
                      (    forth6809.asm):04559         ; KEY, KEY? and EMIT go through the vectors KEYV, KEYQV and EMITV
                      (    forth6809.asm):04560         ; (page zero) so character I/O can be redirected. IOVINIT points

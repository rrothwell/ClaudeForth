                      (    forth6809.asm):07497         ;        RegD = xt of the run-time word (DOSTR, DOTSTR, DOABORTQUOTE)
                      (    forth6809.asm):07498         ;        c-addr u on the data stack
                      (    forth6809.asm):07499         ;    Outputs:
                      (    forth6809.asm):07500         ;        JSR xt, the count byte and the text compiled at CODEHERE
                      (    forth6809.asm):07501         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):07502         ; ------------------------------------------------------------
E911 3606             (    forth6809.asm):07503         CSTRCOMP:   PSHU  D
E913 BDDEBB           (    forth6809.asm):07504                     JSR   CCALL
E916 3706             (    forth6809.asm):07505                     PULU  D                 ; u
E918 3720             (    forth6809.asm):07506                     PULU  Y                 ; c-addr
E91A 9E08             (    forth6809.asm):07507                     LDX   CODEHERE
E91C E780             (    forth6809.asm):07508                     STB   ,X+
E91E 5D               (    forth6809.asm):07509                     TSTB
E91F 2707             (    forth6809.asm):07510                     BEQ   CSEND

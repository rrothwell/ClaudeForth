E4AF EDC4             (    forth6809.asm):04186                     STD   ,U
                      (    forth6809.asm):04187         
E4B1 1F20             (    forth6809.asm):04188                     TFR   Y,D
E4B3 4F               (    forth6809.asm):04189                     CLRA
E4B4 3606             (    forth6809.asm):04190                     PSHU  D

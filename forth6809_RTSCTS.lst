                      (    forth6809.asm):03472         ; ------------------------------------------------------------
                      (    forth6809.asm):03473         ; Search one chain of headers for a name, ignoring smudged entries.
                      (    forth6809.asm):03474         ; Case matters. A zero-length name matches a zero-length header.
                      (    forth6809.asm):03475         ; The Search-Order design is in shadow SEARCHORDER.1.
                      (    forth6809.asm):03476         ; FDSEARCH
                      (    forth6809.asm):03477         ;    Inputs:
                      (    forth6809.asm):03478         ;        RegX = first header of the chain (0 = empty chain)
                      (    forth6809.asm):03479         ;        RegY = address of the name text
                      (    forth6809.asm):03480         ;        RegB = name length
                      (    forth6809.asm):03481         ;    Outputs:
                      (    forth6809.asm):03482         ;        RegX = the matching header, or 0 if there is none
                      (    forth6809.asm):03483         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):03484         ; ------------------------------------------------------------
E0AC 3424             (    forth6809.asm):03485         FDSEARCH:   PSHS  Y,B               ; 0,S = length, 1,S = name text
E0AE 8C0000           (    forth6809.asm):03486         FDLOOP:     CMPX  #0
E0B1 2733             (    forth6809.asm):03487                     BEQ   FDRET
E0B3 A684             (    forth6809.asm):03488                     LDA   ,X
E0B5 8540             (    forth6809.asm):03489                     BITA  #$40
E0B7 2620             (    forth6809.asm):03490                     BNE   FDNEXT            ; smudged
E0B9 841F             (    forth6809.asm):03491                     ANDA  #$1F
E0BB A1E4             (    forth6809.asm):03492                     CMPA  ,S
E0BD 261A             (    forth6809.asm):03493                     BNE   FDNEXT
E0BF 3410             (    forth6809.asm):03494                     PSHS  X                 ; header, kept across the compare
E0C1 3001             (    forth6809.asm):03495                     LEAX  1,X
E0C3 10AE63           (    forth6809.asm):03496                     LDY   3,S               ; name text
E0C6 E662             (    forth6809.asm):03497                     LDB   2,S               ; length
E0C8 2709             (    forth6809.asm):03498                     BEQ   FDHIT
E0CA A680             (    forth6809.asm):03499         FDCMP:      LDA   ,X+
E0CC A1A0             (    forth6809.asm):03500                     CMPA  ,Y+
E0CE 2607             (    forth6809.asm):03501                     BNE   FDMISS
E0D0 5A               (    forth6809.asm):03502                     DECB
E0D1 26F7             (    forth6809.asm):03503                     BNE   FDCMP
E0D3 3510             (    forth6809.asm):03504         FDHIT:      PULS  X                 ; header
E0D5 200F             (    forth6809.asm):03505                     BRA   FDRET
E0D7 3510             (    forth6809.asm):03506         FDMISS:     PULS  X
E0D9 E684             (    forth6809.asm):03507         FDNEXT:     LDB   ,X

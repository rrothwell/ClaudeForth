DF7D 3610             (    forth6809.asm):05672         AQTHROW:    PSHU  X
DF7F 3606             (    forth6809.asm):05673                     PSHU  D
DF81 BDEA56           (    forth6809.asm):05674                     JSR   TYPEW
DF84 CCFFFE           (    forth6809.asm):05675                     LDD   #-2               ; -2
DF87 3606             (    forth6809.asm):05676                     PSHU  D
DF89 7EDA61           (    forth6809.asm):05677                     JMP   THROWW
                      (    forth6809.asm):05678         

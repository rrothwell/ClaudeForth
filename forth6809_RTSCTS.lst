                      (    forth6809.asm):04202         
                      (    forth6809.asm):04203         ; ------------------------------------------------------------
                      (    forth6809.asm):04204         ; >NUMBER  ( ud1 c-addr1 u1 -- ud2 c-addr2 u2 )
                      (    forth6809.asm):04205         ; Convert the string into ud1, in BASE, stopping at the first
                      (    forth6809.asm):04206         ; unconvertible character. Returns the accumulated ud2 and the
                      (    forth6809.asm):04207         ; remaining string. The conversion works in place on the three
                      (    forth6809.asm):04208         ; parameters (NUMLOOP), which are also the frame NUMBERQ builds.
                      (    forth6809.asm):04209         ; NUMLOOP
                      (    forth6809.asm):04210         ;    Inputs:
                      (    forth6809.asm):04211         ;        ( ud c-addr u ) on the data stack
                      (    forth6809.asm):04212         ;    Outputs:
                      (    forth6809.asm):04213         ;        ud accumulated; c-addr u = first unconverted character and
                      (    forth6809.asm):04214         ;        the count remaining
                      (    forth6809.asm):04215         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):04216         ; ------------------------------------------------------------
D8D0                  (    forth6809.asm):04217         TONUMBERW:
D8D0 ECC4             (    forth6809.asm):04218         NUMLOOP:    LDD   ,U
D8D2 2734             (    forth6809.asm):04219                     BEQ   NLDONE
D8D4 AE42             (    forth6809.asm):04220                     LDX   2,U
D8D6 A684             (    forth6809.asm):04221                     LDA   ,X
D8D8 8130             (    forth6809.asm):04222                     CMPA  #'0'
D8DA 252C             (    forth6809.asm):04223                     BLO   NLDONE
D8DC 8139             (    forth6809.asm):04224                     CMPA  #'9'
D8DE 2204             (    forth6809.asm):04225                     BHI   NLALPHA

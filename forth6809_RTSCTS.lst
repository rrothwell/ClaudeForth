EB29 ED44             (    forth6809.asm):05624                     STD   4,U
EB2B 39               (    forth6809.asm):05625                     RTS
                      (    forth6809.asm):05626         
                      (    forth6809.asm):05627         ; ------------------------------------------------------------
                      (    forth6809.asm):05628         ; PICK  ( xu ... x0 u -- xu ... x0 xu )
                      (    forth6809.asm):05629         ; Copy the cell u deep (0 PICK is DUP) to the top.
                      (    forth6809.asm):05630         ; ------------------------------------------------------------
EB2C 3706             (    forth6809.asm):05631         PICKW:      PULU  D                 ; u
EB2E 58               (    forth6809.asm):05632                     LSLB
EB2F 49               (    forth6809.asm):05633                     ROLA
EB30 ECCB             (    forth6809.asm):05634                     LDD   D,U
EB32 3606             (    forth6809.asm):05635                     PSHU  D
EB34 39               (    forth6809.asm):05636                     RTS
                      (    forth6809.asm):05637         
                      (    forth6809.asm):05638         ; ------------------------------------------------------------
                      (    forth6809.asm):05639         ; ROLL  ( xu xu-1 ... x0 u -- xu-1 ... x0 xu )
                      (    forth6809.asm):05640         ; Move the cell u deep (0 ROLL does nothing) to the top, shifting the
                      (    forth6809.asm):05641         ; cells above it down one place. RDST holds the byte offset and RVAL
                      (    forth6809.asm):05642         ; the cell being moved.
                      (    forth6809.asm):05643         ; ------------------------------------------------------------
EB35 ECC1             (    forth6809.asm):05644         ROLLW:      LDD   ,U++              ; u (LDD sets CC; PULU would not). See
EB37 2718             (    forth6809.asm):05645                     BEQ   ROLLDONE          ; bugfix: ROLLW.1
EB39 1F02             (    forth6809.asm):05646                     TFR   D,Y               ; Y = cells to shift
EB3B 58               (    forth6809.asm):05647                     LSLB
EB3C 49               (    forth6809.asm):05648                     ROLA

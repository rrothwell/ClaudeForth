E906 5A               (    forth6809.asm):07599                     DECB
E907 26F9             (    forth6809.asm):07600                     BNE   CSCPY
E909 9F08             (    forth6809.asm):07601         CSEND:      STX   CODEHERE
E90B 39               (    forth6809.asm):07602                     RTS
                      (    forth6809.asm):07603         
                      (    forth6809.asm):07604         ; ------------------------------------------------------------
                      (    forth6809.asm):07605         ; S"  ( "ccc<quote>" -- c-addr u )
                      (    forth6809.asm):07606         ; Parse up to the closing quote (PARSEQUOTE). When compiling, compile
                      (    forth6809.asm):07607         ; DOSTR followed by the counted string. When interpreting, copy the
                      (    forth6809.asm):07608         ; string to PAD and return its address and length. An empty string is
                      (    forth6809.asm):07609         ; valid. See shadow SQUOTEW.3.
                      (    forth6809.asm):07610         ; ------------------------------------------------------------

                      (    forth6809.asm):04188         ; ------------------------------------------------------------
                      (    forth6809.asm):04189         ; KEY  ( -- char )
                      (    forth6809.asm):04190         ; Wait for the next received character and return it. While waiting,
                      (    forth6809.asm):04191         ; drain the output ring by polling if RTS is high.
                      (    forth6809.asm):04192         ; ------------------------------------------------------------
E44E                  (    forth6809.asm):04193         KEYW:
                      (    forth6809.asm):04194         
E44E 7D0178           (    forth6809.asm):04195                     TST   RTSSTATE          ; Is throttling?
E451 2703             (    forth6809.asm):04196                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):04197         
                      (    forth6809.asm):04198                     ; IRQ stays unmasked during the flush. See bugfix: KEYW.1
E453 BDD9EA           (    forth6809.asm):04199                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):04200                                             ; by transmitting all chars.
                      (    forth6809.asm):04201         

D9D8 C110             (    forth6809.asm):02056                     CMPB  #INLOWATER        ; RegB = fill level. Near empty?
D9DA 240D             (    forth6809.asm):02057                     BHS   CHKLODONE         ; No! Do nothing.
D9DC 7D0178           (    forth6809.asm):02058                     TST   RTSSTATE
D9DF 2708             (    forth6809.asm):02059                     BEQ   CHKLODONE         ; already low - nothing to do
D9E1 8600             (    forth6809.asm):02060                     LDA   #INACCEPT         ; Yes! Assert RTS.
D9E3 B70178           (    forth6809.asm):02061                     STA   RTSSTATE

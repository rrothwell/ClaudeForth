VUNUSEDW:   LDD   #APPVARSEND       ; was #APPCODE - a real bug, not just a
            SUBD  VARHERE           ; missing check: computed a meaningless
            PSHU  D                 ; distance to an unrelated region instead
            RTS                     ; of remaining APPVARS space


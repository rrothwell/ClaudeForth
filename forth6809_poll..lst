E853 BDDB27           (    forth6809.asm):05284                     JSR   CODECOMMA         ; x
E856 39               (    forth6809.asm):05285                     RTS
                      (    forth6809.asm):05286         
                      (    forth6809.asm):05287         ; ------------------------------------------------------------
                      (    forth6809.asm):05288         ; 2LITERAL  ( x1 x2 -- )  IMMEDIATE
                      (    forth6809.asm):05289         ; Compile two LITs so that x1 x2 are pushed when the definition runs.
                      (    forth6809.asm):05290         ; ------------------------------------------------------------
E857                  (    forth6809.asm):05291         TWOLITERALW:
E857 3706             (    forth6809.asm):05292                     PULU  D                 ; x2
E859 3406             (    forth6809.asm):05293                     PSHS  D
E85B BDE84B           (    forth6809.asm):05294                     JSR   LITERALW          ; x1 first, so it lands below x2
E85E 3506             (    forth6809.asm):05295                     PULS  D
E860 3606             (    forth6809.asm):05296                     PSHU  D
E862 BDE84B           (    forth6809.asm):05297                     JSR   LITERALW
E865 39               (    forth6809.asm):05298                     RTS
                      (    forth6809.asm):05299         
                      (    forth6809.asm):05300         ; ------------------------------------------------------------
                      (    forth6809.asm):05301         ; [']  ( "name" -- )

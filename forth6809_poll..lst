DFA4 8DBF             (    forth6809.asm):03576                     BSR   SRCHORD
DFA6 8C0000           (    forth6809.asm):03577                     CMPX  #0
DFA9 2712             (    forth6809.asm):03578                     BEQ   NOTFOUND
DFAB 8DE6             (    forth6809.asm):03579                     BSR   HDRXT
DFAD AFC4             (    forth6809.asm):03580                     STX   ,U                ; xt replaces c-addr
DFAF 4D               (    forth6809.asm):03581                     TSTA
DFB0 2A05             (    forth6809.asm):03582                     BPL   FISNORM
DFB2 CC0001           (    forth6809.asm):03583                     LDD   #1
DFB5 2003             (    forth6809.asm):03584                     BRA   FPUSH
DFB7 CCFFFF           (    forth6809.asm):03585         FISNORM:    LDD   #-1
DFBA 3606             (    forth6809.asm):03586         FPUSH:      PSHU  D                 ; 1 = immediate, -1 = normal
DFBC 39               (    forth6809.asm):03587                     RTS
                      (    forth6809.asm):03588         
DFBD CC0000           (    forth6809.asm):03589         NOTFOUND:   LDD   #0
DFC0 3606             (    forth6809.asm):03590                     PSHU  D                 ; 0 = not found, c-addr still beneath
DFC2 39               (    forth6809.asm):03591                     RTS
                      (    forth6809.asm):03592         
                      (    forth6809.asm):03593         ; ------------------------------------------------------------
                      (    forth6809.asm):03594         ; SEARCH-WORDLIST  ( c-addr u wid -- 0 | xt 1 | xt -1 )
                      (    forth6809.asm):03595         ; Search the one wordlist wid for the name c-addr u. Returns 0 if it is
                      (    forth6809.asm):03596         ; not found, else its xt and 1 if the word is immediate or -1 if not.
                      (    forth6809.asm):03597         ; Throws -11 for an invalid wid.
                      (    forth6809.asm):03598         ; ------------------------------------------------------------
DFC3 3710             (    forth6809.asm):03599         SEARCHWLW:  PULU  X                 ; wid
DFC5 8D2D             (    forth6809.asm):03600                     BSR   WIDCHK
DFC7 AE84             (    forth6809.asm):03601                     LDX   ,X                ; newest header of the wordlist
DFC9 3706             (    forth6809.asm):03602                     PULU  D                 ; u
DFCB 3720             (    forth6809.asm):03603                     PULU  Y                 ; c-addr
DFCD 4D               (    forth6809.asm):03604                     TSTA
DFCE 261E             (    forth6809.asm):03605                     BNE   SWNOT             ; longer than any name
DFD0 C11F             (    forth6809.asm):03606                     CMPB  #31
DFD2 221A             (    forth6809.asm):03607                     BHI   SWNOT
DFD4 BDDF28           (    forth6809.asm):03608                     JSR   FDSEARCH
DFD7 8C0000           (    forth6809.asm):03609                     CMPX  #0
DFDA 2712             (    forth6809.asm):03610                     BEQ   SWNOT
DFDC 8DB5             (    forth6809.asm):03611                     BSR   HDRXT
DFDE 3610             (    forth6809.asm):03612                     PSHU  X                 ; xt
DFE0 4D               (    forth6809.asm):03613                     TSTA
DFE1 2A05             (    forth6809.asm):03614                     BPL   SWNORM
DFE3 CC0001           (    forth6809.asm):03615                     LDD   #1
DFE6 2003             (    forth6809.asm):03616                     BRA   SWPUSH
DFE8 CCFFFF           (    forth6809.asm):03617         SWNORM:     LDD   #-1
DFEB 3606             (    forth6809.asm):03618         SWPUSH:     PSHU  D
DFED 39               (    forth6809.asm):03619                     RTS
DFEE CC0000           (    forth6809.asm):03620         SWNOT:      LDD   #0
DFF1 3606             (    forth6809.asm):03621                     PSHU  D
DFF3 39               (    forth6809.asm):03622                     RTS
                      (    forth6809.asm):03623         
                      (    forth6809.asm):03624         ; ------------------------------------------------------------
                      (    forth6809.asm):03625         ; Throw -11 unless RegX is the address of a wordlist cell in use.
                      (    forth6809.asm):03626         ; WIDCHK
                      (    forth6809.asm):03627         ;    Inputs:
                      (    forth6809.asm):03628         ;        RegX = candidate WID
                      (    forth6809.asm):03629         ;    Outputs:
                      (    forth6809.asm):03630         ;        none if valid (RegX and RegY unchanged); THROW -11 if not
                      (    forth6809.asm):03631         ;    Registers: RegD and CC changed.
                      (    forth6809.asm):03632         ; ------------------------------------------------------------
DFF4 1F10             (    forth6809.asm):03633         WIDCHK:     TFR   X,D
DFF6 83005B           (    forth6809.asm):03634                     SUBD  #WLHEADS
DFF9 2509             (    forth6809.asm):03635                     BCS   WIDBAD
DFFB C501             (    forth6809.asm):03636                     BITB  #1
DFFD 2605             (    forth6809.asm):03637                     BNE   WIDBAD
DFFF 9C45             (    forth6809.asm):03638                     CMPX  WLEND
E001 2401             (    forth6809.asm):03639                     BHS   WIDBAD
E003 39               (    forth6809.asm):03640                     RTS
E004 CCFFF5           (    forth6809.asm):03641         WIDBAD:     LDD   #-11
E007 3606             (    forth6809.asm):03642                     PSHU  D
E009 7EE403           (    forth6809.asm):03643                     JMP   THROWW
                      (    forth6809.asm):03644         
                      (    forth6809.asm):03645         ; ------------------------------------------------------------
                      (    forth6809.asm):03646         ; Set the Search-Order state to its initial value: two wordlists
                      (    forth6809.asm):03647         ; (FORTH, holding the ROM dictionary, and ROOT), the search order
                      (    forth6809.asm):03648         ; FORTH, and CURRENT = FORTH.
                      (    forth6809.asm):03649         ; WLINIT
                      (    forth6809.asm):03650         ;    Inputs:
                      (    forth6809.asm):03651         ;        none
                      (    forth6809.asm):03652         ;    Outputs:
                      (    forth6809.asm):03653         ;        WLHEADS, WLNAMES (FORTH, ROOT), WLEND, CURRENT, ORDER, ORDEND set
                      (    forth6809.asm):03654         ;    Registers: RegD and CC changed.
                      (    forth6809.asm):03655         ; ------------------------------------------------------------
E00C CCD956           (    forth6809.asm):03656         WLINIT:     LDD   #BASELATEST
E00F DD5B             (    forth6809.asm):03657                     STD   WLHEADS
E011 CCD084           (    forth6809.asm):03658                     LDD   #BASEROOTLATEST
E014 DD5D             (    forth6809.asm):03659                     STD   WLHEADS+2
E016 CCD084           (    forth6809.asm):03660                     LDD   #H_FORTH
E019 DD6F             (    forth6809.asm):03661                     STD   WLNAMES
E01B CCD07B           (    forth6809.asm):03662                     LDD   #H_ROOT
E01E DD71             (    forth6809.asm):03663                     STD   WLNAMES+2
E020 CC005F           (    forth6809.asm):03664                     LDD   #WLHEADS+4
E023 DD45             (    forth6809.asm):03665                     STD   WLEND
E025 CC005B           (    forth6809.asm):03666                     LDD   #WLHEADS
E028 DD47             (    forth6809.asm):03667                     STD   CURRENT
E02A 7EE0FA           (    forth6809.asm):03668                     JMP   ONLYW             ; the order is FORTH only
                      (    forth6809.asm):03669         
                      (    forth6809.asm):03670         ; ------------------------------------------------------------
                      (    forth6809.asm):03671         ; Remove from every wordlist the RAM headers that are at or above a
                      (    forth6809.asm):03672         ; mark. Headers are allocated upwards from DPHERE, so these are the
                      (    forth6809.asm):03673         ; newest ones of each chain. ROM headers are never touched.
                      (    forth6809.asm):03674         ; PRUNE
                      (    forth6809.asm):03675         ;    Inputs:
                      (    forth6809.asm):03676         ;        RegD = mark (a DPHERE value)
                      (    forth6809.asm):03677         ;    Outputs:
                      (    forth6809.asm):03678         ;        the head of every wordlist in use points below the mark or
                      (    forth6809.asm):03679         ;        into ROM
                      (    forth6809.asm):03680         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):03681         ; ------------------------------------------------------------
E02D 3406             (    forth6809.asm):03682         PRUNE:      PSHS  D                 ; 0,S = mark
E02F 8E005B           (    forth6809.asm):03683                     LDX   #WLHEADS
E032 9C45             (    forth6809.asm):03684         PRLOOP:     CMPX  WLEND
E034 2421             (    forth6809.asm):03685                     BHS   PRNDONE
E036 10AE84           (    forth6809.asm):03686                     LDY   ,X                ; newest header of this wordlist
E039 108CC000         (    forth6809.asm):03687         PRWALK:     CMPY  #ROMSTRT
E03D 2413             (    forth6809.asm):03688                     BHS   PRSTORE           ; ROM header: keep
E03F 10ACE4           (    forth6809.asm):03689                     CMPY  ,S
E042 250E             (    forth6809.asm):03690                     BLO   PRSTORE           ; below the mark (or empty): keep
E044 E6A4             (    forth6809.asm):03691                     LDB   ,Y
E046 C41F             (    forth6809.asm):03692                     ANDB  #$1F
E048 4F               (    forth6809.asm):03693                     CLRA
E049 3121             (    forth6809.asm):03694                     LEAY  1,Y
E04B 31AB             (    forth6809.asm):03695                     LEAY  D,Y
E04D 10AEA4           (    forth6809.asm):03696                     LDY   ,Y                ; follow the LINK
E050 20E7             (    forth6809.asm):03697                     BRA   PRWALK
E052 10AF81           (    forth6809.asm):03698         PRSTORE:    STY   ,X++
E055 20DB             (    forth6809.asm):03699                     BRA   PRLOOP
E057 3262             (    forth6809.asm):03700         PRNDONE:     LEAS  2,S
E059 39               (    forth6809.asm):03701                     RTS
                      (    forth6809.asm):03702         
                      (    forth6809.asm):03703         ; ============================================================
                      (    forth6809.asm):03704         ; SECTION 9A: SEARCH-ORDER WORD SET
                      (    forth6809.asm):03705         ; ============================================================
                      (    forth6809.asm):03706         ; ------------------------------------------------------------
                      (    forth6809.asm):03707         ; WORDLIST  ( -- wid )
                      (    forth6809.asm):03708         ; Create a new, empty wordlist. Throws -8 when all WLCELLS are in use.
                      (    forth6809.asm):03709         ; ------------------------------------------------------------
E05A 9E45             (    forth6809.asm):03710         WORDLISTW:  LDX   WLEND
E05C 8C006F           (    forth6809.asm):03711                     CMPX  #WLHEADS+2*WLCELLS
E05F 240F             (    forth6809.asm):03712                     BHS   WLFULL
E061 CC0000           (    forth6809.asm):03713                     LDD   #0
E064 ED84             (    forth6809.asm):03714                     STD   ,X
E066 ED8814           (    forth6809.asm):03715                     STD   WLNOFF,X
E069 3610             (    forth6809.asm):03716                     PSHU  X
E06B 3002             (    forth6809.asm):03717                     LEAX  2,X
E06D 9F45             (    forth6809.asm):03718                     STX   WLEND
E06F 39               (    forth6809.asm):03719                     RTS
E070 CCFFF8           (    forth6809.asm):03720         WLFULL:     LDD   #-8
E073 3606             (    forth6809.asm):03721                     PSHU  D
E075 7EE403           (    forth6809.asm):03722                     JMP   THROWW
                      (    forth6809.asm):03723         
                      (    forth6809.asm):03724         ; ------------------------------------------------------------
                      (    forth6809.asm):03725         ; FORTH-WORDLIST  ( -- wid )
                      (    forth6809.asm):03726         ; Push the WID of the wordlist holding the standard words.
                      (    forth6809.asm):03727         ; ------------------------------------------------------------
E078 CC005B           (    forth6809.asm):03728         FORTHWLW:   LDD   #WLHEADS
E07B 3606             (    forth6809.asm):03729                     PSHU  D
E07D 39               (    forth6809.asm):03730                     RTS
                      (    forth6809.asm):03731         
                      (    forth6809.asm):03732         ; ------------------------------------------------------------
                      (    forth6809.asm):03733         ; GET-ORDER  ( -- widn ... wid1 n )
                      (    forth6809.asm):03734         ; Return the search order: wid1 is searched first. ROOT is not part of
                      (    forth6809.asm):03735         ; it, as it is always searched last.
                      (    forth6809.asm):03736         ; ------------------------------------------------------------
E07E 9E49             (    forth6809.asm):03737         GETORDERW:  LDX   ORDEND
E080 8C004B           (    forth6809.asm):03738         GOLOOP:     CMPX  #ORDER
E083 2306             (    forth6809.asm):03739                     BLS   GODONE
E085 EC83             (    forth6809.asm):03740                     LDD   ,--X
E087 3606             (    forth6809.asm):03741                     PSHU  D
E089 20F5             (    forth6809.asm):03742                     BRA   GOLOOP
E08B DC49             (    forth6809.asm):03743         GODONE:     LDD   ORDEND
E08D 83004B           (    forth6809.asm):03744                     SUBD  #ORDER
E090 44               (    forth6809.asm):03745                     LSRA
E091 56               (    forth6809.asm):03746                     RORB
E092 3606             (    forth6809.asm):03747                     PSHU  D                 ; n
E094 39               (    forth6809.asm):03748                     RTS
                      (    forth6809.asm):03749         
                      (    forth6809.asm):03750         ; ------------------------------------------------------------
                      (    forth6809.asm):03751         ; SET-ORDER  ( widn ... wid1 n -- )
                      (    forth6809.asm):03752         ; Set the search order. n = -1 selects the minimum order (FORTH only).
                      (    forth6809.asm):03753         ; n = 0 empties it (ROOT can still be searched). Throws -49 when n is
                      (    forth6809.asm):03754         ; more than 8, -50 when n is less than -1 and -11 for an invalid wid.
                      (    forth6809.asm):03755         ; ------------------------------------------------------------
E095 3706             (    forth6809.asm):03756         SETORDERW:  PULU  D                 ; n
E097 1083FFFF         (    forth6809.asm):03757                     CMPD  #-1
E09B 275D             (    forth6809.asm):03758                     BEQ   ONLYW             ; the minimum order
E09D 4D               (    forth6809.asm):03759         SO1:        TSTA
E09E 2B31             (    forth6809.asm):03760                     BMI   SOUNDER
E0A0 262A             (    forth6809.asm):03761                     BNE   SOOVER
E0A2 C108             (    forth6809.asm):03762                     CMPB  #WLMAX
E0A4 2226             (    forth6809.asm):03763                     BHI   SOOVER
E0A6 3404             (    forth6809.asm):03764                     PSHS  B                 ; 1,S = n
E0A8 3404             (    forth6809.asm):03765                     PSHS  B                 ; 0,S = count down
E0AA 1F32             (    forth6809.asm):03766                     TFR   U,Y
E0AC 6DE4             (    forth6809.asm):03767         SOCHK:      TST   ,S
E0AE 2709             (    forth6809.asm):03768                     BEQ   SOCOPY
E0B0 AEA1             (    forth6809.asm):03769                     LDX   ,Y++
E0B2 BDDFF4           (    forth6809.asm):03770                     JSR   WIDCHK            ; keeps Y
E0B5 6AE4             (    forth6809.asm):03771                     DEC   ,S
E0B7 20F3             (    forth6809.asm):03772                     BRA   SOCHK
E0B9 3506             (    forth6809.asm):03773         SOCOPY:     PULS  A,B               ; B = n
E0BB 8E004B           (    forth6809.asm):03774                     LDX   #ORDER
E0BE 5D               (    forth6809.asm):03775         SOCP2:      TSTB
E0BF 2708             (    forth6809.asm):03776                     BEQ   SOCPEND
E0C1 3720             (    forth6809.asm):03777                     PULU  Y
E0C3 10AF81           (    forth6809.asm):03778                     STY   ,X++
E0C6 5A               (    forth6809.asm):03779                     DECB
E0C7 20F5             (    forth6809.asm):03780                     BRA   SOCP2
E0C9 9F49             (    forth6809.asm):03781         SOCPEND:    STX   ORDEND
E0CB 39               (    forth6809.asm):03782                     RTS
E0CC CCFFCF           (    forth6809.asm):03783         SOOVER:     LDD   #-49
E0CF 2003             (    forth6809.asm):03784                     BRA   SOTHROW
E0D1 CCFFCE           (    forth6809.asm):03785         SOUNDER:    LDD   #-50
E0D4 3606             (    forth6809.asm):03786         SOTHROW:    PSHU  D
E0D6 7EE403           (    forth6809.asm):03787                     JMP   THROWW
                      (    forth6809.asm):03788         
                      (    forth6809.asm):03789         ; ------------------------------------------------------------
                      (    forth6809.asm):03790         ; GET-CURRENT  ( -- wid )
                      (    forth6809.asm):03791         ; Return the WID of the wordlist that receives new definitions.
                      (    forth6809.asm):03792         ; ------------------------------------------------------------
E0D9 DC47             (    forth6809.asm):03793         GETCURW:    LDD   CURRENT
E0DB 3606             (    forth6809.asm):03794                     PSHU  D
E0DD 39               (    forth6809.asm):03795                     RTS
                      (    forth6809.asm):03796         
                      (    forth6809.asm):03797         ; ------------------------------------------------------------
                      (    forth6809.asm):03798         ; SET-CURRENT  ( wid -- )
                      (    forth6809.asm):03799         ; Make wid the wordlist that receives new definitions. Throws -11 for
                      (    forth6809.asm):03800         ; an invalid wid.
                      (    forth6809.asm):03801         ; ------------------------------------------------------------
E0DE 3710             (    forth6809.asm):03802         SETCURW:    PULU  X
E0E0 BDDFF4           (    forth6809.asm):03803                     JSR   WIDCHK
E0E3 9F47             (    forth6809.asm):03804                     STX   CURRENT
E0E5 39               (    forth6809.asm):03805                     RTS
                      (    forth6809.asm):03806         
                      (    forth6809.asm):03807         ; ------------------------------------------------------------
                      (    forth6809.asm):03808         ; DEFINITIONS  ( -- )
                      (    forth6809.asm):03809         ; Make the first wordlist of the search order the one that receives new
                      (    forth6809.asm):03810         ; definitions. Throws -50 when the search order is empty.
                      (    forth6809.asm):03811         ; ------------------------------------------------------------
E0E6                  (    forth6809.asm):03812         DEFINITIONSW:
E0E6 8E004B           (    forth6809.asm):03813                     LDX   #ORDER
E0E9 9C49             (    forth6809.asm):03814                     CMPX  ORDEND
E0EB 2405             (    forth6809.asm):03815                     BHS   DFUNDER
E0ED EC84             (    forth6809.asm):03816                     LDD   ,X
E0EF DD47             (    forth6809.asm):03817                     STD   CURRENT
E0F1 39               (    forth6809.asm):03818                     RTS
E0F2 CCFFCE           (    forth6809.asm):03819         DFUNDER:    LDD   #-50
E0F5 3606             (    forth6809.asm):03820                     PSHU  D
E0F7 7EE403           (    forth6809.asm):03821                     JMP   THROWW
                      (    forth6809.asm):03822         
                      (    forth6809.asm):03823         ; ------------------------------------------------------------
                      (    forth6809.asm):03824         ; ONLY  ( -- )
                      (    forth6809.asm):03825         ; Set the minimum search order: FORTH only (ROOT is still searched).
                      (    forth6809.asm):03826         ; ------------------------------------------------------------
E0FA CC005B           (    forth6809.asm):03827         ONLYW:      LDD   #WLHEADS
E0FD DD4B             (    forth6809.asm):03828                     STD   ORDER
E0FF CC004D           (    forth6809.asm):03829                     LDD   #ORDER+2
E102 DD49             (    forth6809.asm):03830                     STD   ORDEND
E104 39               (    forth6809.asm):03831                     RTS
                      (    forth6809.asm):03832         
                      (    forth6809.asm):03833         ; ------------------------------------------------------------
                      (    forth6809.asm):03834         ; Replace the first wordlist of the search order with the WID in RegX,
                      (    forth6809.asm):03835         ; or make it the only one if the order is empty.
                      (    forth6809.asm):03836         ; SETTOP
                      (    forth6809.asm):03837         ;    Inputs:
                      (    forth6809.asm):03838         ;        RegX = WID
                      (    forth6809.asm):03839         ;    Outputs:
                      (    forth6809.asm):03840         ;        ORDER(0) = WID; ORDEND at least ORDER+2
                      (    forth6809.asm):03841         ;    Registers: RegD and CC changed.
                      (    forth6809.asm):03842         ; ------------------------------------------------------------
E105 9F4B             (    forth6809.asm):03843         SETTOP:     STX   ORDER
E107 DC49             (    forth6809.asm):03844                     LDD   ORDEND
E109 1083004D         (    forth6809.asm):03845                     CMPD  #ORDER+2
E10D 2405             (    forth6809.asm):03846                     BHS   STDONE
E10F CC004D           (    forth6809.asm):03847                     LDD   #ORDER+2
E112 DD49             (    forth6809.asm):03848                     STD   ORDEND
E114 39               (    forth6809.asm):03849         STDONE:     RTS
                      (    forth6809.asm):03850         
                      (    forth6809.asm):03851         ; ------------------------------------------------------------
                      (    forth6809.asm):03852         ; FORTH  ( -- )
                      (    forth6809.asm):03853         ; Replace the first wordlist of the search order with FORTH-WORDLIST.
                      (    forth6809.asm):03854         ; ------------------------------------------------------------
E115 8E005B           (    forth6809.asm):03855         FORTHW:     LDX   #WLHEADS
E118 20EB             (    forth6809.asm):03856                     BRA   SETTOP
                      (    forth6809.asm):03857         
                      (    forth6809.asm):03858         ; ------------------------------------------------------------
                      (    forth6809.asm):03859         ; ROOT  ( -- )
                      (    forth6809.asm):03860         ; Replace the first wordlist of the search order with ROOT.
                      (    forth6809.asm):03861         ; ------------------------------------------------------------
E11A 8E005D           (    forth6809.asm):03862         ROOTW:      LDX   #WLHEADS+2
E11D 20E6             (    forth6809.asm):03863                     BRA   SETTOP
                      (    forth6809.asm):03864         
                      (    forth6809.asm):03865         ; ------------------------------------------------------------
                      (    forth6809.asm):03866         ; PREVIOUS  ( -- )
                      (    forth6809.asm):03867         ; Remove the first wordlist from the search order. Throws -50 if the
                      (    forth6809.asm):03868         ; order is empty.
                      (    forth6809.asm):03869         ; ------------------------------------------------------------
E11F 9E49             (    forth6809.asm):03870         PREVIOUSW:  LDX   ORDEND
E121 8C004B           (    forth6809.asm):03871                     CMPX  #ORDER
E124 23CC             (    forth6809.asm):03872                     BLS   DFUNDER
E126 301E             (    forth6809.asm):03873                     LEAX  -2,X
E128 9F49             (    forth6809.asm):03874                     STX   ORDEND
E12A 8E004B           (    forth6809.asm):03875                     LDX   #ORDER            ; close the gap at the front
E12D 9C49             (    forth6809.asm):03876         PVLOOP:     CMPX  ORDEND
E12F 2406             (    forth6809.asm):03877                     BHS   PVDONE
E131 EC02             (    forth6809.asm):03878                     LDD   2,X
E133 ED81             (    forth6809.asm):03879                     STD   ,X++
E135 20F6             (    forth6809.asm):03880                     BRA   PVLOOP
E137 39               (    forth6809.asm):03881         PVDONE:     RTS
                      (    forth6809.asm):03882         
                      (    forth6809.asm):03883         ; ------------------------------------------------------------
                      (    forth6809.asm):03884         ; ALSO  ( -- )
                      (    forth6809.asm):03885         ; Duplicate the first wordlist of the search order. Throws -50 if the
                      (    forth6809.asm):03886         ; order is empty and -49 if it is full.
                      (    forth6809.asm):03887         ; ------------------------------------------------------------
E138 9E49             (    forth6809.asm):03888         ALSOW:      LDX   ORDEND
E13A 8C004B           (    forth6809.asm):03889                     CMPX  #ORDER
E13D 23B3             (    forth6809.asm):03890                     BLS   DFUNDER
E13F 8C005B           (    forth6809.asm):03891                     CMPX  #ORDER+2*WLMAX
E142 2488             (    forth6809.asm):03892                     BHS   SOOVER
E144 3002             (    forth6809.asm):03893                     LEAX  2,X
E146 9F49             (    forth6809.asm):03894                     STX   ORDEND
E148 EC1C             (    forth6809.asm):03895         ALLOOP:     LDD   -4,X              ; open a gap at the front
E14A ED1E             (    forth6809.asm):03896                     STD   -2,X
E14C 301E             (    forth6809.asm):03897                     LEAX  -2,X
E14E 8C004D           (    forth6809.asm):03898                     CMPX  #ORDER+2
E151 22F5             (    forth6809.asm):03899                     BHI   ALLOOP
E153 39               (    forth6809.asm):03900                     RTS
                      (    forth6809.asm):03901         
                      (    forth6809.asm):03902         ; ------------------------------------------------------------
                      (    forth6809.asm):03903         ; The behaviour of a word made by VOCABULARY: replace the first
                      (    forth6809.asm):03904         ; wordlist of the search order with the wordlist whose WID is in the
                      (    forth6809.asm):03905         ; word's data field.
                      (    forth6809.asm):03906         ; DOVOCAB   ( pfa -- )
                      (    forth6809.asm):03907         ; ------------------------------------------------------------
E154 3710             (    forth6809.asm):03908         DOVOCAB:    PULU  X

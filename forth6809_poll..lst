E5D2 39               (    forth6809.asm):04801                     RTS
                      (    forth6809.asm):04802         
                      (    forth6809.asm):04803         ; ------------------------------------------------------------
                      (    forth6809.asm):04804         ; Run-time start of DO and ?DO: build the loop frame on S, beneath the
                      (    forth6809.asm):04805         ; return address.
                      (    forth6809.asm):04806         ; DOSETUP   ( limit index -- )
                      (    forth6809.asm):04807         ;    Inputs:
                      (    forth6809.asm):04808         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):04809         ;    Outputs:
                      (    forth6809.asm):04810         ;        S holds index, limit and a zero leave flag (top first)
                      (    forth6809.asm):04811         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):04812         ; ------------------------------------------------------------
E5D3 3706             (    forth6809.asm):04813         DOSETUP:    PULU  D                 ; index
E5D5 DD14             (    forth6809.asm):04814                     STD   MSCR
E5D7 3706             (    forth6809.asm):04815                     PULU  D                 ; limit
E5D9 DD16             (    forth6809.asm):04816                     STD   MSCR2
E5DB 3510             (    forth6809.asm):04817                     PULS  X
E5DD CC0000           (    forth6809.asm):04818                     LDD   #0
E5E0 3406             (    forth6809.asm):04819                     PSHS  D
E5E2 DC16             (    forth6809.asm):04820                     LDD   MSCR2
E5E4 3406             (    forth6809.asm):04821                     PSHS  D
E5E6 DC14             (    forth6809.asm):04822                     LDD   MSCR
E5E8 3406             (    forth6809.asm):04823                     PSHS  D
E5EA 3410             (    forth6809.asm):04824                     PSHS  X
E5EC 39               (    forth6809.asm):04825                     RTS
                      (    forth6809.asm):04826         
                      (    forth6809.asm):04827         ; ------------------------------------------------------------
                      (    forth6809.asm):04828         ; I  ( -- n )
                      (    forth6809.asm):04829         ; Push the index of the innermost loop (2,S, beyond the return
                      (    forth6809.asm):04830         ; address).
                      (    forth6809.asm):04831         ; ------------------------------------------------------------
E5ED EC62             (    forth6809.asm):04832         IW:         LDD   2,S               ; n. See bugfix: IW.1
E5EF 3606             (    forth6809.asm):04833                     PSHU  D
E5F1 39               (    forth6809.asm):04834                     RTS
                      (    forth6809.asm):04835         
                      (    forth6809.asm):04836         ; ------------------------------------------------------------
                      (    forth6809.asm):04837         ; J  ( -- n )
                      (    forth6809.asm):04838         ; Push the index of the next outer loop (8,S, beyond the return
                      (    forth6809.asm):04839         ; address and the inner loop frame).
                      (    forth6809.asm):04840         ; ------------------------------------------------------------
E5F2 EC68             (    forth6809.asm):04841         JW:         LDD   8,S               ; n. See bugfix: JW.1
E5F4 3606             (    forth6809.asm):04842                     PSHU  D
E5F6 39               (    forth6809.asm):04843                     RTS
                      (    forth6809.asm):04844         
                      (    forth6809.asm):04845         ; ------------------------------------------------------------
                      (    forth6809.asm):04846         ; LEAVE  ( -- )
                      (    forth6809.asm):04847         ; Set the leave flag in the innermost loop frame. The loop exits at
                      (    forth6809.asm):04848         ; its next LOOP or +LOOP test.
                      (    forth6809.asm):04849         ; ------------------------------------------------------------
E5F7 CCFFFF           (    forth6809.asm):04850         LEAVEW:     LDD   #TRUEV            ; true
E5FA ED66             (    forth6809.asm):04851                     STD   6,S               ; See bugfix: LEAVEW.1
E5FC 39               (    forth6809.asm):04852                     RTS
                      (    forth6809.asm):04853         
                      (    forth6809.asm):04854         ; ------------------------------------------------------------
                      (    forth6809.asm):04855         ; LOOP  ( C: dest -- )
                      (    forth6809.asm):04856         ; Compile a call to DOTEST followed by a displacement back to dest.
                      (    forth6809.asm):04857         ; For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):04858         ; ------------------------------------------------------------
E5FD 3706             (    forth6809.asm):04859         LOOPW:      PULU  D
E5FF 10830003         (    forth6809.asm):04860                     CMPD  #TAGDO
E603 2703             (    forth6809.asm):04861                     BEQ   LOOPOK
E605 BDE3CE           (    forth6809.asm):04862                     JSR   CFERR
E608 3706             (    forth6809.asm):04863         LOOPOK:     PULU  D                 ; dest
E60A 3606             (    forth6809.asm):04864                     PSHU  D                 ; park dest. See bugfix: LOOPW.1
E60C CCE63C           (    forth6809.asm):04865                     LDD   #DOTEST
E60F 3606             (    forth6809.asm):04866                     PSHU  D
E611 BDE83E           (    forth6809.asm):04867                     JSR   CCALL
E614 CC0000           (    forth6809.asm):04868                     LDD   #0
E617 3606             (    forth6809.asm):04869                     PSHU  D
E619 BDDB27           (    forth6809.asm):04870                     JSR   CODECOMMA
E61C DC08             (    forth6809.asm):04871                     LDD   CODEHERE
E61E 830002           (    forth6809.asm):04872                     SUBD  #2
E621 3606             (    forth6809.asm):04873                     PSHU  D                 ; location; the parked dest is beneath
E623 BDE438           (    forth6809.asm):04874                     JSR   PATCH
                      (    forth6809.asm):04875         
E626 ECC4             (    forth6809.asm):04876                     LDD   ,U
E628 10830007         (    forth6809.asm):04877                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: LOOPW.2
E62C 260D             (    forth6809.asm):04878                     BNE   LOOPDONE
E62E 3706             (    forth6809.asm):04879                     PULU  D
E630 3710             (    forth6809.asm):04880                     PULU  X                 ; ?DO skip operand
E632 DC08             (    forth6809.asm):04881                     LDD   CODEHERE
E634 3606             (    forth6809.asm):04882                     PSHU  D
E636 3610             (    forth6809.asm):04883                     PSHU  X
E638 BDE438           (    forth6809.asm):04884                     JSR   PATCH
E63B 39               (    forth6809.asm):04885         LOOPDONE:   RTS
                      (    forth6809.asm):04886         
                      (    forth6809.asm):04887         ; ------------------------------------------------------------
                      (    forth6809.asm):04888         ; Run-time end of LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):04889         ; the back-branch operand. Add 1 to the index. If the leave flag is
                      (    forth6809.asm):04890         ; set or the index has reached the limit, discard the loop frame and
                      (    forth6809.asm):04891         ; skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):04892         ; DOTEST
                      (    forth6809.asm):04893         ;    Inputs:
                      (    forth6809.asm):04894         ;        S holds return address, index, limit and leave flag (top
                      (    forth6809.asm):04895         ;        first)
                      (    forth6809.asm):04896         ;    Outputs:
                      (    forth6809.asm):04897         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):04898         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):04899         ; ------------------------------------------------------------
E63C EC66             (    forth6809.asm):04900         DOTEST:     LDD   6,S               ; leave flag. See bugfix: DOTEST.1
E63E 2615             (    forth6809.asm):04901                     BNE   DTEXIT            ; set: exit
E640 EC62             (    forth6809.asm):04902                     LDD   2,S               ; index
E642 C30001           (    forth6809.asm):04903                     ADDD  #1
E645 ED62             (    forth6809.asm):04904                     STD   2,S
E647 10A364           (    forth6809.asm):04905                     CMPD  4,S               ; limit
E64A 2709             (    forth6809.asm):04906                     BEQ   DTEXIT

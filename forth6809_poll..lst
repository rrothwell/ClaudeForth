                      (    forth6809.asm):04182         ; ============================================================
                      (    forth6809.asm):04183         ; SECTION 10: QUERY / ACCEPT / EXPECT / KEY / KEY? / EMIT
                      (    forth6809.asm):04184         ; ============================================================
                      (    forth6809.asm):04185                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):04186         ; Unused alternative to KEY removed; see shadow X_KEY.1.
                      (    forth6809.asm):04187         
                      (    forth6809.asm):04188         ; ------------------------------------------------------------
                      (    forth6809.asm):04189         ; KEY  ( -- char )
                      (    forth6809.asm):04190         ; Wait for the next received character and return it. While waiting,
                      (    forth6809.asm):04191         ; drain the output ring by polling if RTS is high.
                      (    forth6809.asm):04192         ; ------------------------------------------------------------
E2CA                  (    forth6809.asm):04193         KEYW:
                      (    forth6809.asm):04194         
                      (    forth6809.asm):04195                     TST   RTSSTATE          ; Is throttling?
                      (    forth6809.asm):04196                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):04197         
                      (    forth6809.asm):04198                     ; IRQ stays unmasked during the flush. See bugfix: KEYW.1
                      (    forth6809.asm):04199                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):04200                                             ; by transmitting all chars.
                      (    forth6809.asm):04201         
E2CA                  (    forth6809.asm):04202         TRY_READ:
                      (    forth6809.asm):04203                     JSR   GETCHAR           ; Is char available in input buffer.
                      (    forth6809.asm):04204                     BCS   KEYW              ; No? Try again to receive a char,
                      (    forth6809.asm):04205                                             ; while still transmitting!
                      (    forth6809.asm):04206         
                      (    forth6809.asm):04207                     TFR   A,B               ; Move char result to Reg B (LSB of D)
                      (    forth6809.asm):04208                     CLRA                    ; Clear MSB.
                      (    forth6809.asm):04209                     PSHU  D                 ; char
                      (    forth6809.asm):04210         
                      (    forth6809.asm):04211                     RTS
                      (    forth6809.asm):04212         
                      (    forth6809.asm):04213         ; ------------------------------------------------------------
                      (    forth6809.asm):04214         ; KEY?  ( -- flag )
                      (    forth6809.asm):04215         ; Return true if a received character is waiting in the input ring.
                      (    forth6809.asm):04216         ; ------------------------------------------------------------
E2CA                  (    forth6809.asm):04217         KEYQW:
                      (    forth6809.asm):04218                     ; Commented-out code moved to shadow: KEYQW.1
                      (    forth6809.asm):04219         
                      (    forth6809.asm):04220                     LDA   INHEAD            ; Characters received?
                      (    forth6809.asm):04221                     CMPA  INTAIL
                      (    forth6809.asm):04222         
                      (    forth6809.asm):04223                     ; Commented-out code moved to shadow: KEYQW.2
                      (    forth6809.asm):04224         
                      (    forth6809.asm):04225                     BNE   KQTRUE            ; Yes!
                      (    forth6809.asm):04226         
                      (    forth6809.asm):04227                     LDD   #FALSEV           ; No! Return false result.
                      (    forth6809.asm):04228                     PSHU  D                 ; flag = false
                      (    forth6809.asm):04229         
                      (    forth6809.asm):04230                     RTS
                      (    forth6809.asm):04231         
E2CA                  (    forth6809.asm):04232         KQTRUE:
                      (    forth6809.asm):04233                     LDD   #TRUEV            ; Yes! Return true result.
                      (    forth6809.asm):04234                     PSHU  D                 ; flag = true
                      (    forth6809.asm):04235                     RTS
                      (    forth6809.asm):04236         
                      (    forth6809.asm):04237         ; Unused alternative to EMIT removed; see shadow X_EMIT.1.
                      (    forth6809.asm):04238         
                      (    forth6809.asm):04239         ; ------------------------------------------------------------
                      (    forth6809.asm):04240         ; EMIT  ( char -- )
                      (    forth6809.asm):04241         ; Transmit char through PUTCHAR (the output ring). The character is
                      (    forth6809.asm):04242         ; discarded if the ring is full.
                      (    forth6809.asm):04243         ; ------------------------------------------------------------
E2CA                  (    forth6809.asm):04244         EMITW:
                      (    forth6809.asm):04245                     PULU  D                 ; char
                      (    forth6809.asm):04246                     TFR   B,A
                      (    forth6809.asm):04247                     JSR   PUTCHAR           ; Transmit char.
                      (    forth6809.asm):04248                     RTS
                      (    forth6809.asm):04249         
                      (    forth6809.asm):04250                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):04251         ; ------------------------------------------------------------
                      (    forth6809.asm):04252         ; KEY  ( -- char )  [polling build, SERIALPOLL=1]
                      (    forth6809.asm):04253         ; Wait for RDRF and return the received character. There are no ring
                      (    forth6809.asm):04254         ; buffers, interrupts or hardware handshaking in this build; ACCEPT
                      (    forth6809.asm):04255         ; uses software XON/XOFF instead. Framing, overrun and parity errors
                      (    forth6809.asm):04256         ; are counted in FECOUNT, OVRNCOUNT and PECOUNT, and POLLREADYCNT
                      (    forth6809.asm):04257         ; counts characters already waiting when KEY was called.
                      (    forth6809.asm):04258         ; Original comment: shadow KEYW.2. KEY?, EMIT, PUTXON and PUTXOFF
                      (    forth6809.asm):04259         ; follow.
                      (    forth6809.asm):04260         ; ------------------------------------------------------------
E2CA                  (    forth6809.asm):04261         KEYW:
E2CA B6C008           (    forth6809.asm):04262                     LDA   ACIASR
E2CD 8501             (    forth6809.asm):04263                     BITA  #SR_RDRF
E2CF 2705             (    forth6809.asm):04264                     BEQ   KWAIT
E2D1 7C017F           (    forth6809.asm):04265                     INC   POLLREADYCNT      ; character was already queued when we
E2D4 2007             (    forth6809.asm):04266                     BRA   KGOTSTAT          ; came back to poll - didn't need to wait
E2D6                  (    forth6809.asm):04267         KWAIT:
E2D6 B6C008           (    forth6809.asm):04268         KSPIN:      LDA   ACIASR
E2D9 8501             (    forth6809.asm):04269                     BITA  #SR_RDRF
E2DB 27F9             (    forth6809.asm):04270                     BEQ   KSPIN
E2DD                  (    forth6809.asm):04271         KGOTSTAT:                           ; A holds the status byte exactly as it was
                      (    forth6809.asm):04272                                             ; when RDRF first went true - check the
                      (    forth6809.asm):04273                                             ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):04274                                             ; read, since reading ACIADR below clears
                      (    forth6809.asm):04275                                             ; RDRF and the latched error bits together
E2DD 8570             (    forth6809.asm):04276                     BITA  #SR_FE+SR_OVRN+SR_PE
E2DF 2715             (    forth6809.asm):04277                     BEQ   KGETCH
E2E1 8510             (    forth6809.asm):04278                     BITA  #SR_FE
E2E3 2703             (    forth6809.asm):04279                     BEQ   KXFE
E2E5 7C017C           (    forth6809.asm):04280                     INC   FECOUNT
E2E8 8520             (    forth6809.asm):04281         KXFE:       BITA  #SR_OVRN
E2EA 2703             (    forth6809.asm):04282                     BEQ   KXOVRN
E2EC 7C017D           (    forth6809.asm):04283                     INC   OVRNCOUNT
E2EF 8540             (    forth6809.asm):04284         KXOVRN:     BITA  #SR_PE
E2F1 2703             (    forth6809.asm):04285                     BEQ   KGETCH
E2F3 7C017E           (    forth6809.asm):04286                     INC   PECOUNT
E2F6 B6C009           (    forth6809.asm):04287         KGETCH:     LDA   ACIADR
E2F9 1F89             (    forth6809.asm):04288                     TFR   A,B
E2FB 4F               (    forth6809.asm):04289                     CLRA
E2FC 3606             (    forth6809.asm):04290                     PSHU  D                 ; char
E2FE 39               (    forth6809.asm):04291                     RTS
                      (    forth6809.asm):04292         
                      (    forth6809.asm):04293         ; ------------------------------------------------------------
                      (    forth6809.asm):04294         ; Send the software flow-control character XOFF (PUTXOFF) or XON
                      (    forth6809.asm):04295         ; (PUTXON) straight to the ACIA, waiting for TDRE. The data stack is
                      (    forth6809.asm):04296         ; not touched, so ACCEPT can call these at any point.
                      (    forth6809.asm):04297         ; PUTXON / PUTXOFF
                      (    forth6809.asm):04298         ;    Inputs:
                      (    forth6809.asm):04299         ;        none
                      (    forth6809.asm):04300         ;    Outputs:
                      (    forth6809.asm):04301         ;        XON or XOFF transmitted
                      (    forth6809.asm):04302         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):04303         ; Original comment: shadow PUTXON.0.
                      (    forth6809.asm):04304         ; ------------------------------------------------------------
E2FF 8613             (    forth6809.asm):04305         PUTXOFF:    LDA   #XOFFCH
E301 2002             (    forth6809.asm):04306                     BRA   PUTXCH
E303 8611             (    forth6809.asm):04307         PUTXON:     LDA   #XONCH
E305 3402             (    forth6809.asm):04308         PUTXCH:     PSHS  A
E307 F6C008           (    forth6809.asm):04309         PXWT:       LDB   ACIASR
E30A C502             (    forth6809.asm):04310                     BITB  #SR_TDRE
E30C 27F9             (    forth6809.asm):04311                     BEQ   PXWT
E30E 3502             (    forth6809.asm):04312                     PULS  A
E310 B7C009           (    forth6809.asm):04313                     STA   ACIADR
E313 39               (    forth6809.asm):04314                     RTS
                      (    forth6809.asm):04315         
                      (    forth6809.asm):04316         ; ------------------------------------------------------------
                      (    forth6809.asm):04317         ; KEY?  ( -- flag )  [polling build]
                      (    forth6809.asm):04318         ; Return true if the ACIA has a received character (RDRF set).
                      (    forth6809.asm):04319         ; ------------------------------------------------------------
E314 B6C008           (    forth6809.asm):04320         KEYQW:      LDA   ACIASR
E317 8501             (    forth6809.asm):04321                     BITA  #SR_RDRF
E319 2706             (    forth6809.asm):04322                     BEQ   KQFALSE
E31B CCFFFF           (    forth6809.asm):04323                     LDD   #TRUEV
E31E 3606             (    forth6809.asm):04324                     PSHU  D                 ; flag = true
E320 39               (    forth6809.asm):04325                     RTS

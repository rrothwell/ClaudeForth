                      (    forth6809.asm):04423         ; EXPECT  ( c-addr +n -- )
                      (    forth6809.asm):04424         ; Read a line as ACCEPT does and store the count in SPAN.
                      (    forth6809.asm):04425         ; ------------------------------------------------------------

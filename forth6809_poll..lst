                      (    forth6809.asm):08856         ; ------------------------------------------------------------
                      (    forth6809.asm):08857         ; ENVTABLE
                      (    forth6809.asm):08858         ; Single-cell ENVIRONMENT? entries: name address, name length, value.
                      (    forth6809.asm):08859         ; A zero ends the table.

E2AE CC0001           (    forth6809.asm):04165                     LDD   #1
E2B1 3606             (    forth6809.asm):04166                     PSHU  D
E2B3 39               (    forth6809.asm):04167                     RTS
                      (    forth6809.asm):04168         

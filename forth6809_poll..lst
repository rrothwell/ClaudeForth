                      (    forth6809.asm):05022         ; Run-time start of ?DO. If index equals limit, branch over the whole
                      (    forth6809.asm):05023         ; loop; otherwise build the loop frame as DOSETUP does and skip the
                      (    forth6809.asm):05024         ; branch operand.
                      (    forth6809.asm):05025         ; QDOSETUP   ( limit index -- )
                      (    forth6809.asm):05026         ;    Inputs:
                      (    forth6809.asm):05027         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):05028         ;    Outputs:
                      (    forth6809.asm):05029         ;        loop skipped, or loop frame on S and operand skipped
                      (    forth6809.asm):05030         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):05031         ; ------------------------------------------------------------
E701 3706             (    forth6809.asm):05032         QDOSETUP:   PULU  D                 ; index
E703 DD14             (    forth6809.asm):05033                     STD   MSCR
E705 3706             (    forth6809.asm):05034                     PULU  D                 ; limit

D95C 7F0176           (    forth6809.asm):01913         SERBUFCLR:  CLR   INHEAD
D95F 7F0177           (    forth6809.asm):01914                     CLR   INTAIL
D962 7F0178           (    forth6809.asm):01915                     CLR   RTSSTATE          ; $00 = RTS Low (Clear)
D965 7F0179           (    forth6809.asm):01916                     CLR   OUTHEAD
D968 7F017A           (    forth6809.asm):01917                     CLR   OUTTAIL
D96B 7F017B           (    forth6809.asm):01918                     CLR   OUTACTIVITY       ; $00 = Idle
                      (    forth6809.asm):01919         
                      (    forth6809.asm):01920         
D96E 7F017C           (    forth6809.asm):01921                     CLR   FECOUNT
D971 7F017D           (    forth6809.asm):01922                     CLR   OVRNCOUNT
D974 7F017E           (    forth6809.asm):01923                     CLR   PECOUNT
D977 7F017F           (    forth6809.asm):01924                     CLR   POLLREADYCNT
D97A 39               (    forth6809.asm):01925                     RTS
                      (    forth6809.asm):01926         
                      (    forth6809.asm):01927         ; ------------------------------------------------------------
                      (    forth6809.asm):01928         ; Initialise the ACIA (6850): master reset, then select
                      (    forth6809.asm):01929         ; interrupt-driven or polling operation per SERIALPOLL.
                      (    forth6809.asm):01930         ; INITSERIAL
                      (    forth6809.asm):01931         ;    Inputs:
                      (    forth6809.asm):01932         ;        none
                      (    forth6809.asm):01933         ;    Outputs:
                      (    forth6809.asm):01934         ;        ring buffers cleared (SERBUFCLR); ACIACR set to the run mode
                      (    forth6809.asm):01935         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01936         ; Original comment: shadow INITSERIAL.0.
                      (    forth6809.asm):01937         ; See bugfix: INITSERIAL.1.
                      (    forth6809.asm):01938         ; ------------------------------------------------------------
D97B BDD95C           (    forth6809.asm):01939         INITSERIAL: JSR   SERBUFCLR
D97E 8603             (    forth6809.asm):01940                     LDA   #CR_RESET         ; Master Software Reset. See bugfix: INITSERIAL.2
D980 B7C008           (    forth6809.asm):01941                     STA   ACIACR
D983 12               (    forth6809.asm):01942                     NOP                     ; Settling Delay
D984 12               (    forth6809.asm):01943                     NOP
                      (    forth6809.asm):01944         
                      (    forth6809.asm):01945                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):01946                     LDA   #CR_RXON          ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):01947                     ELSE                    ; <<<<<>>>>>
D985 8615             (    forth6809.asm):01948                     LDA   #CR_POLL          ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):01949                     ENDC                    ; <<<<<<<<<<
D987 B7C008           (    forth6809.asm):01950                     STA   ACIACR            ; See bugfix: INITSERIAL.1
D98A 39               (    forth6809.asm):01951                     RTS
                      (    forth6809.asm):01952         
                      (    forth6809.asm):01953                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):01954         ; ------------------------------------------------------------
                      (    forth6809.asm):01955         ; Return the input ring buffer fill level (0 to INBUFSZ-1).
                      (    forth6809.asm):01956         ; INBUFSZ is a power of two and both indices stay in range, so a
                      (    forth6809.asm):01957         ; masked subtraction gives the true distance across the wrap.
                      (    forth6809.asm):01958         ; INFILL
                      (    forth6809.asm):01959         ;    Inputs:
                      (    forth6809.asm):01960         ;        none
                      (    forth6809.asm):01961         ;    Outputs:
                      (    forth6809.asm):01962         ;        RegA = (INHEAD - INTAIL) mod INBUFSZ
                      (    forth6809.asm):01963         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01964         ; ------------------------------------------------------------
D98B                  (    forth6809.asm):01965         INFILL:     LDA   INHEAD
                      (    forth6809.asm):01966                     SUBA  INTAIL
                      (    forth6809.asm):01967                     ANDA  #INBUFSZ-1        ; Output: RegA = fill level
                      (    forth6809.asm):01968                     RTS
                      (    forth6809.asm):01969         ; ------------------------------------------------------------
                      (    forth6809.asm):01970         ; Assert RTS high (ask the sender to pause) if the input ring has
                      (    forth6809.asm):01971         ; reached INHIWATER and RTS is not already high. Called from the
                      (    forth6809.asm):01972         ; receive path with interrupts already masked.
                      (    forth6809.asm):01973         ; RTSCHECKHI
                      (    forth6809.asm):01974         ;    Inputs:
                      (    forth6809.asm):01975         ;        none
                      (    forth6809.asm):01976         ;    Outputs:
                      (    forth6809.asm):01977         ;        RTSSTATE = 1 and ACIACR = CR_RTSHI if the threshold was reached
                      (    forth6809.asm):01978         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01979         ; ------------------------------------------------------------
D98B                  (    forth6809.asm):01980         RTSCHECKHI: JSR   INFILL
                      (    forth6809.asm):01981                     CMPA  #INHIWATER
                      (    forth6809.asm):01982                     BLO   RTSCHIDONE
                      (    forth6809.asm):01983                     TST   RTSSTATE
                      (    forth6809.asm):01984                     BNE   RTSCHIDONE        ; already high - nothing to do
                      (    forth6809.asm):01985                     LDA   #CR_RTSHI
                      (    forth6809.asm):01986                     STA   ACIACR
                      (    forth6809.asm):01987                     LDA   #1
                      (    forth6809.asm):01988                     STA   RTSSTATE
D98B                  (    forth6809.asm):01989         RTSCHIDONE: RTS
                      (    forth6809.asm):01990         ; ------------------------------------------------------------
                      (    forth6809.asm):01991         ; Write the ACIA control byte for the current RTSSTATE and
                      (    forth6809.asm):01992         ; OUTACTIVITY: RTS high disables the Tx interrupt; RTS low
                      (    forth6809.asm):01993         ; enables it only while output is pending.
                      (    forth6809.asm):01994         ; UPDATE_RTS
                      (    forth6809.asm):01995         ;    Inputs:
                      (    forth6809.asm):01996         ;        RTSSTATE, OUTACTIVITY
                      (    forth6809.asm):01997         ;    Outputs:
                      (    forth6809.asm):01998         ;        ACIACR written (OUTACTIVITY cleared when RTS is high)
                      (    forth6809.asm):01999         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02000         ; ------------------------------------------------------------
D98B                  (    forth6809.asm):02001         UPDATE_RTS:
                      (    forth6809.asm):02002                     TST   RTSSTATE
                      (    forth6809.asm):02003                     BNE   SET_RTS_HI_TX_OFF
                      (    forth6809.asm):02004         
                      (    forth6809.asm):02005                     TST   OUTACTIVITY       ; Is active?
                      (    forth6809.asm):02006                     BEQ   SET_RTS_LO_TX_OFF ; No! Disable Transmit interrupt.
                      (    forth6809.asm):02007         
                      (    forth6809.asm):02008                                             ; $B5/%1011_0101
                      (    forth6809.asm):02009                     LDA   #CR_RXTX          ; Yes! Accept input & transmit output
                      (    forth6809.asm):02010                     BRA   WRITE_CR          ; RTS = Low, Tx Interrupt = Enabled
                      (    forth6809.asm):02011         
D98B                  (    forth6809.asm):02012         SET_RTS_LO_TX_OFF:                  ; $95/%10010101
                      (    forth6809.asm):02013                     LDA   #CR_RXON          ; RTS = Low, Tx Interrupt = Disabled
                      (    forth6809.asm):02014                     BRA   WRITE_CR          ; Open question moved to shadow: UPDATE_RTS.1
                      (    forth6809.asm):02015         
D98B                  (    forth6809.asm):02016         SET_RTS_HI_TX_OFF:                  ; $D5/%1101_0101
                      (    forth6809.asm):02017                     LDA   #CR_RTSHI         ; RTS = High, Tx Interrupt = Disabled
                      (    forth6809.asm):02018                     CLR   OUTACTIVITY       ; Interrupts are hardware-disabled; clear state
D98B                  (    forth6809.asm):02019         WRITE_CR:
                      (    forth6809.asm):02020                     STA   ACIACR
                      (    forth6809.asm):02021                     RTS
                      (    forth6809.asm):02022         ; ------------------------------------------------------------
                      (    forth6809.asm):02023         ; If the input ring is near full and RTS is not already high,
                      (    forth6809.asm):02024         ; set RTSSTATE to INREJECT and update the ACIA to drop RTS.
                      (    forth6809.asm):02025         ; Called after a character is added to the ring.
                      (    forth6809.asm):02026         ; CHKHI
                      (    forth6809.asm):02027         ;    Inputs:
                      (    forth6809.asm):02028         ;        RegB = input ring fill level
                      (    forth6809.asm):02029         ;    Outputs:
                      (    forth6809.asm):02030         ;        RTSSTATE and ACIACR updated if the high-water mark was reached
                      (    forth6809.asm):02031         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02032         ; Original comment: shadow CHKHI.0.
                      (    forth6809.asm):02033         ; ------------------------------------------------------------
D98B                  (    forth6809.asm):02034         CHKHI:
                      (    forth6809.asm):02035                     CMPB  #INHIWATER        ; RegB = fill level. Near full?
                      (    forth6809.asm):02036                     BLO   CHKHIDONE         ; No! Do nothing.
                      (    forth6809.asm):02037                     TST   RTSSTATE
                      (    forth6809.asm):02038                     BNE   CHKHIDONE         ; already high - nothing to do
                      (    forth6809.asm):02039                     LDA   #INREJECT         ; Yes! De-assert RTS.
                      (    forth6809.asm):02040                     STA   RTSSTATE
                      (    forth6809.asm):02041                     JSR   UPDATE_RTS
D98B                  (    forth6809.asm):02042         CHKHIDONE:  RTS
                      (    forth6809.asm):02043         
                      (    forth6809.asm):02044         ; ------------------------------------------------------------
                      (    forth6809.asm):02045         ; If the input ring is near empty and RTS is high, set
                      (    forth6809.asm):02046         ; RTSSTATE to INACCEPT and update the ACIA to raise RTS.
                      (    forth6809.asm):02047         ; Called after a character is removed from the ring.
                      (    forth6809.asm):02048         ; CHKLO
                      (    forth6809.asm):02049         ;    Inputs:
                      (    forth6809.asm):02050         ;        RegB = input ring fill level
                      (    forth6809.asm):02051         ;    Outputs:
                      (    forth6809.asm):02052         ;        RTSSTATE and ACIACR updated if the low-water mark was reached
                      (    forth6809.asm):02053         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02054         ; ------------------------------------------------------------
D98B                  (    forth6809.asm):02055         CHKLO:
                      (    forth6809.asm):02056                     CMPB  #INLOWATER        ; RegB = fill level. Near empty?
                      (    forth6809.asm):02057                     BHS   CHKLODONE         ; No! Do nothing.
                      (    forth6809.asm):02058                     TST   RTSSTATE
                      (    forth6809.asm):02059                     BEQ   CHKLODONE         ; already low - nothing to do
                      (    forth6809.asm):02060                     LDA   #INACCEPT         ; Yes! Assert RTS.
                      (    forth6809.asm):02061                     STA   RTSSTATE
                      (    forth6809.asm):02062                     JSR   UPDATE_RTS
D98B                  (    forth6809.asm):02063         CHKLODONE:  RTS
                      (    forth6809.asm):02064         ; ------------------------------------------------------------
                      (    forth6809.asm):02065         ; Send at most one character from the output ring to the ACIA
                      (    forth6809.asm):02066         ; by polling, then return. Nothing is sent if the ring is empty,
                      (    forth6809.asm):02067         ; the remote receiver is blocking (CTS) or the transmitter is not
                      (    forth6809.asm):02068         ; ready; the caller simply tries again on its next call.
                      (    forth6809.asm):02069         ; FLUSHOUTBUFFER
                      (    forth6809.asm):02070         ;    Inputs:
                      (    forth6809.asm):02071         ;        none
                      (    forth6809.asm):02072         ;    Outputs:
                      (    forth6809.asm):02073         ;        one character sent and OUTTAIL advanced, or no change
                      (    forth6809.asm):02074         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):02075         ; See bugfix: FLUSHOUTBUFFER.1.
                      (    forth6809.asm):02076         ; ------------------------------------------------------------
D98B                  (    forth6809.asm):02077         FLUSHOUTBUFFER:
                      (    forth6809.asm):02078                     LDB   OUTTAIL
                      (    forth6809.asm):02079                     CMPB  OUTHEAD           ; Is transmit buffer empty?
                      (    forth6809.asm):02080                     BEQ   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):02081         
                      (    forth6809.asm):02082                     LDA   ACIASR            ; Is transmission blocked by remote receiver?
                      (    forth6809.asm):02083                     BITA  #SR_CTS
                      (    forth6809.asm):02084                     BNE   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):02085         
                      (    forth6809.asm):02086                     BITA  #SR_TDRE          ; Is transmit register empty?
                      (    forth6809.asm):02087                     BEQ   FLUSHED           ; No! Exit - try again next call rather
                      (    forth6809.asm):02088                                             ; than spin-wait here.
                      (    forth6809.asm):02089         
                      (    forth6809.asm):02090                     LDX   #OUTBUF           ; The out buffer is occupied.
                      (    forth6809.asm):02091                     LDA   B,X               ; Get the character from the out buffer.
                      (    forth6809.asm):02092                     STA   ACIADR            ; Transmit character.
                      (    forth6809.asm):02093         
                      (    forth6809.asm):02094                     INCB                    ; Update tail pointer to next character slot.
                      (    forth6809.asm):02095                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02096                     STB   OUTTAIL
                      (    forth6809.asm):02097                                             ; One character sent - return rather than
                      (    forth6809.asm):02098                                             ; loop back for more (see header comment).
D98B                  (    forth6809.asm):02099         FLUSHED:
                      (    forth6809.asm):02100                     RTS
                      (    forth6809.asm):02101         ; ------------------------------------------------------------
                      (    forth6809.asm):02102         ; Queue a character for transmission. The character is discarded
                      (    forth6809.asm):02103         ; if the output ring is full. Runs as a critical section.
                      (    forth6809.asm):02104         ; PUTCHAR
                      (    forth6809.asm):02105         ;    Inputs:
                      (    forth6809.asm):02106         ;        RegA = character to insert into transmit buffer
                      (    forth6809.asm):02107         ;    Outputs:
                      (    forth6809.asm):02108         ;        none
                      (    forth6809.asm):02109         ;    Registers: RegA and RegB changed; RegX and CC preserved.
                      (    forth6809.asm):02110         ; ------------------------------------------------------------
D98B                  (    forth6809.asm):02111         PUTCHAR:
                      (    forth6809.asm):02112                     PSHS  CC,X
                      (    forth6809.asm):02113                     ORCC  #$50              ; Enter Critical Section. Disable IRQ & FIRQ
                      (    forth6809.asm):02114         
                      (    forth6809.asm):02115                     LDB   OUTHEAD           ; Is buffer full?
                      (    forth6809.asm):02116                     INCB
                      (    forth6809.asm):02117                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02118                     CMPB  OUTTAIL
                      (    forth6809.asm):02119                     BEQ   PUT_EXIT          ; Yes! Exit discarding character.
                      (    forth6809.asm):02120         
                      (    forth6809.asm):02121                     LDX   #OUTBUF           ; Put character into character slot.
                      (    forth6809.asm):02122                     LDB   OUTHEAD
                      (    forth6809.asm):02123                     STA   B,X               ; Input: RegA = character
                      (    forth6809.asm):02124         
                      (    forth6809.asm):02125                     INCB                    ; Update tail pointer to next character slot.
                      (    forth6809.asm):02126                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02127                     STB   OUTHEAD
                      (    forth6809.asm):02128         
                      (    forth6809.asm):02129                     TST   RTSSTATE          ; Is RTS currently low (chars still being accepted)?
                      (    forth6809.asm):02130                     BEQ   CHK_INT_PATH      ; Yes! Interrupt-driven TX is still available.
                      (    forth6809.asm):02131         
                      (    forth6809.asm):02132                     ; RTS is high so the Tx interrupt is off: drain by polling,
                      (    forth6809.asm):02133                     ; with IRQ and FIRQ unmasked meanwhile. See bugfix: PUTCHAR.1
                      (    forth6809.asm):02134                     ANDCC #$AF              ; unmask IRQ+FIRQ for the flush only
                      (    forth6809.asm):02135                     JSR   FLUSHOUTBUFFER    ; Fallback to transmit by polling.
                      (    forth6809.asm):02136                     ORCC  #$50              ; re-mask - PUT_EXIT below still
                      (    forth6809.asm):02137                                             ; expects the critical section active
                      (    forth6809.asm):02138         
                      (    forth6809.asm):02139                     BRA   PUT_EXIT
                      (    forth6809.asm):02140         
                      (    forth6809.asm):02141         ; Re-start the interrupt driven character pump,
                      (    forth6809.asm):02142         ; priming the pump by transmitting a character.
D98B                  (    forth6809.asm):02143         CHK_INT_PATH:
                      (    forth6809.asm):02144                     TST   OUTACTIVITY       ; Is the interrupt handler transmitting?
                      (    forth6809.asm):02145                     BNE   PUT_EXIT          ; Yes! Exit, no action required.
                      (    forth6809.asm):02146         
                      (    forth6809.asm):02147                                             ; No! Restart.
                      (    forth6809.asm):02148                     LDX   #OUTBUF           ; Pull character from the out buffer.
                      (    forth6809.asm):02149                     LDB   OUTTAIL
                      (    forth6809.asm):02150                     LDA   B,X
                      (    forth6809.asm):02151                     STA   ACIADR            ; Load the char for transmission.
                      (    forth6809.asm):02152         
                      (    forth6809.asm):02153                     INCB                    ; Update the tail pointer
                      (    forth6809.asm):02154                     ANDB  #OUTBUFSZ-1       ; to point to the next character.
                      (    forth6809.asm):02155                     STB   OUTTAIL
                      (    forth6809.asm):02156         
                      (    forth6809.asm):02157                     LDA   #OUTBUSY          ; Flag restart of transmit interrupt handler.
                      (    forth6809.asm):02158                     STA   OUTACTIVITY
                      (    forth6809.asm):02159                     JSR   UPDATE_RTS        ; Turn on the Tx interrupt.
                      (    forth6809.asm):02160         
D98B                  (    forth6809.asm):02161         PUT_EXIT:
                      (    forth6809.asm):02162                     PULS  CC,X,PC           ; Leaving the critical section,
                      (    forth6809.asm):02163                                             ; by restoring the CC.
                      (    forth6809.asm):02164         ; ------------------------------------------------------------
                      (    forth6809.asm):02165         ; Fetch the next character from the input ring, if any, and let
                      (    forth6809.asm):02166         ; the flow-control check re-assert RTS when the ring has drained.
                      (    forth6809.asm):02167         ; GETCHAR
                      (    forth6809.asm):02168         ;    Inputs:
                      (    forth6809.asm):02169         ;        none
                      (    forth6809.asm):02170         ;    Outputs:
                      (    forth6809.asm):02171         ;        RegA = next character from the receive buffer
                      (    forth6809.asm):02172         ;        Carry clear = character returned, set = ring empty
                      (    forth6809.asm):02173         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):02174         ; ------------------------------------------------------------
D98B                  (    forth6809.asm):02175         GETCHAR:
                      (    forth6809.asm):02176                     LDB   INTAIL            ; Is the out buffer populated?
                      (    forth6809.asm):02177                     CMPB  INHEAD
                      (    forth6809.asm):02178                     BEQ   GET_NO_CHAR       ; No! Exit.
                      (    forth6809.asm):02179         
                      (    forth6809.asm):02180                     LDX   #INBUF            ; Pull character from the out buffer.
                      (    forth6809.asm):02181                     LDA   B,X               ; Output: RegA = character
                      (    forth6809.asm):02182         
                      (    forth6809.asm):02183                     INCB                    ; Update the tail pointer
                      (    forth6809.asm):02184                     ANDB  #INBUFSZ-1        ; to point to the next character.
                      (    forth6809.asm):02185                     STB   INTAIL
                      (    forth6809.asm):02186         
                      (    forth6809.asm):02187                     ; Mask IRQ so the flow-control check cannot race the
                      (    forth6809.asm):02188                     ; receive interrupt. See bugfix: GETCHAR.1
                      (    forth6809.asm):02189                     ORCC  #$10
                      (    forth6809.asm):02190                     LDB   INHEAD            ; Calculate current fill level fresh -
                      (    forth6809.asm):02191                     SUBB  INTAIL            ; both pointers may have moved since
                      (    forth6809.asm):02192                     ANDB  #INBUFSZ-1        ; the ISR last ran, so (unlike INCHAR)
                      (    forth6809.asm):02193                                             ; there's no already-loaded value here
                      (    forth6809.asm):02194                                             ; worth reusing.
                      (    forth6809.asm):02195                     JSR   CHKLO
                      (    forth6809.asm):02196                     ANDCC #$EF
                      (    forth6809.asm):02197         
                      (    forth6809.asm):02198                     ANDCC #$FE              ; Carry flag %0 = valid character
                      (    forth6809.asm):02199                     RTS
                      (    forth6809.asm):02200         
D98B                  (    forth6809.asm):02201         GET_NO_CHAR:
                      (    forth6809.asm):02202                     ORCC  #$01              ; Carry flag %1 = no valid character.
                      (    forth6809.asm):02203                     RTS
                      (    forth6809.asm):02204         ; ------------------------------------------------------------
                      (    forth6809.asm):02205         ; Raise RTS (accept input again) once the input ring has drained
                      (    forth6809.asm):02206         ; to INLOWATER or below, re-enabling the Tx interrupt if output is
                      (    forth6809.asm):02207         ; pending. Called from mainline code, so IRQ is masked while it runs.
                      (    forth6809.asm):02208         ; RTSCHECKLO
                      (    forth6809.asm):02209         ;    Inputs:
                      (    forth6809.asm):02210         ;        none
                      (    forth6809.asm):02211         ;    Outputs:
                      (    forth6809.asm):02212         ;        RTSSTATE = 0 and ACIACR rewritten if RTS was high and the ring is low
                      (    forth6809.asm):02213         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):02214         ; Original comment: shadow RTSCHECKLO.0.
                      (    forth6809.asm):02215         ; ------------------------------------------------------------
D98B                  (    forth6809.asm):02216         RTSCHECKLO:
                      (    forth6809.asm):02217                     ORCC  #$10              ; mask IRQ for the critical section
                      (    forth6809.asm):02218         
                      (    forth6809.asm):02219                     JSR   INFILL
                      (    forth6809.asm):02220                     CMPA  #INLOWATER
                      (    forth6809.asm):02221                     BHI   RTSCLODONE
                      (    forth6809.asm):02222                     TST   RTSSTATE
                      (    forth6809.asm):02223                     BEQ   RTSCLODONE        ; already low - nothing to do
                      (    forth6809.asm):02224         
                      (    forth6809.asm):02225         
                      (    forth6809.asm):02226                     CLR   RTSSTATE          ; Set flag asserting acceptance of chars
                      (    forth6809.asm):02227         
                      (    forth6809.asm):02228                     LDB   OUTTAIL           ; Check if chars are available.
                      (    forth6809.asm):02229                     CMPB  OUTHEAD
                      (    forth6809.asm):02230                     BEQ   RTSCLONOTX        ; No! Just configure the ACIA to accept chars.
                      (    forth6809.asm):02231         
                      (    forth6809.asm):02232                     LDA   #CR_RXTX          ; Yes! Configure the ACIA to accept chars.
                      (    forth6809.asm):02233                     STA   ACIACR            ; & to generate transmit slot available interrupts.
                      (    forth6809.asm):02234                     BRA   RTSCLOUNMASK
                      (    forth6809.asm):02235         
D98B                  (    forth6809.asm):02236         RTSCLONOTX: LDA   #CR_RXON          ; Configure the ACIA to accept chars.
                      (    forth6809.asm):02237                     STA   ACIACR
                      (    forth6809.asm):02238         
D98B                  (    forth6809.asm):02239         RTSCLOUNMASK:
                      (    forth6809.asm):02240                     ANDCC #$EF
                      (    forth6809.asm):02241         
D98B                  (    forth6809.asm):02242         RTSCLODONE: RTS
                      (    forth6809.asm):02243         
                      (    forth6809.asm):02244         ; ------------------------------------------------------------
                      (    forth6809.asm):02245         ; ACIA (6850) interrupt handler (SERIALPOLL=0). Services received
                      (    forth6809.asm):02246         ; characters (into the input ring, counting framing, overrun and
                      (    forth6809.asm):02247         ; parity errors) and transmit-ready (from the output ring), with a
                      (    forth6809.asm):02248         ; single exit point. IRQ is hardware-masked while it runs.
                      (    forth6809.asm):02249         ; IRQH
                      (    forth6809.asm):02250         ;    Inputs:
                      (    forth6809.asm):02251         ;        none (hardware interrupt entry)
                      (    forth6809.asm):02252         ;    Outputs:
                      (    forth6809.asm):02253         ;        none (returns with RTI)
                      (    forth6809.asm):02254         ;    Registers: all registers are saved and restored by the interrupt.
                      (    forth6809.asm):02255         ; Original comment: shadow IRQH.0.
                      (    forth6809.asm):02256         ; ------------------------------------------------------------
D98B                  (    forth6809.asm):02257         IRQH:       LDA   ACIASR            ; Get the status.
                      (    forth6809.asm):02258         
                      (    forth6809.asm):02259                     BITA  #SR_IRQ           ; Is the ACIA the interrupt source?
                      (    forth6809.asm):02260                     BEQ   IRQDONE0          ; No! Just exit.
                      (    forth6809.asm):02261                     BITA  #SR_RDRF          ; Is an incoming character available?
                      (    forth6809.asm):02262                     BNE   INCHAR
                      (    forth6809.asm):02263                     BITA  #SR_TDRE          ; Is the slot for an outgoing character available?
                      (    forth6809.asm):02264                     BNE   OUTCHAR
                      (    forth6809.asm):02265                                             ; Ignore all other interrupts such as DCD change.
D98B                  (    forth6809.asm):02266         IRQDONE0:   RTI                     ; Single point of exit - re-enables interrupts
                      (    forth6809.asm):02267                                             ; & restores state.
                      (    forth6809.asm):02268         
D98B                  (    forth6809.asm):02269         INCHAR:
                      (    forth6809.asm):02270                     LDB   ACIADR            ; Get the char & clear RDRF & error flags.
                      (    forth6809.asm):02271                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):02272                                             ; Any receiver error flagged?
                      (    forth6809.asm):02273                     BEQ   INOK              ; No! - character is good, keep it.
                      (    forth6809.asm):02274         
                      (    forth6809.asm):02275                     BITA  #SR_FE            ; Yes! char is corrupted, discard it.
                      (    forth6809.asm):02276                     BEQ   INXFE             ; Tally each flagged error independently -
                      (    forth6809.asm):02277                     INC   FECOUNT           ; more than one bit can be set at once.
D98B                  (    forth6809.asm):02278         INXFE:      BITA  #SR_OVRN
                      (    forth6809.asm):02279                     BEQ   INXOVRN
                      (    forth6809.asm):02280                     INC   OVRNCOUNT
D98B                  (    forth6809.asm):02281         INXOVRN:    BITA  #SR_PE
                      (    forth6809.asm):02282                     BEQ   INXPE
                      (    forth6809.asm):02283                     INC   PECOUNT
D98B                  (    forth6809.asm):02284         INXPE:      RTI
                      (    forth6809.asm):02285         
D98B                  (    forth6809.asm):02286         INOK:       TFR   B,A               ; Transfer good character from the receiver.
                      (    forth6809.asm):02287                     LDX   #INBUF            ; Store it in the empty in buffer slot.
                      (    forth6809.asm):02288                     LDB   INHEAD
                      (    forth6809.asm):02289                     STA   B,X
                      (    forth6809.asm):02290                     INCB                    ; Figure out the new head,
                      (    forth6809.asm):02291                     ANDB  #INBUFSZ-1        ; pointing to the next the empty in buffer slot.
                      (    forth6809.asm):02292                     CMPB  INTAIL            ; Would the new head slot meet the tail?
                      (    forth6809.asm):02293                     BEQ   IRQDONE1          ; Don't allow it - buffer full, drop the character.
                      (    forth6809.asm):02294                     STB   INHEAD            ; New head pointer is OK so store it.
                      (    forth6809.asm):02295                     ; Commented-out code moved to shadow: INCHAR.2
                      (    forth6809.asm):02296                     ; Reuse RegB (the new head) for the fill level.
                      (    forth6809.asm):02297                     ; See shadow: INCHAR.1
                      (    forth6809.asm):02298                     SUBB  INTAIL            ; RegB: new head - tail = current fill level.
                      (    forth6809.asm):02299                     ANDB  #INBUFSZ-1
                      (    forth6809.asm):02300                     JSR   CHKHI             ; Protect the in buffer from overflow.
D98B                  (    forth6809.asm):02301         IRQDONE1:   RTI
                      (    forth6809.asm):02302         
                      (    forth6809.asm):02303                     ; Commented-out code moved to shadow: OUTCHAR.1
                      (    forth6809.asm):02304         
D98B                  (    forth6809.asm):02305         OUTCHAR:    LDB   OUTTAIL           ; Is the out buffer empty?
                      (    forth6809.asm):02306                     CMPB  OUTHEAD
                      (    forth6809.asm):02307                     BEQ   TXOFF             ; Yes! Stop transmitting.
                      (    forth6809.asm):02308         
                      (    forth6809.asm):02309                     LDX   #OUTBUF           ; No! The out buffer is occupied.
                      (    forth6809.asm):02310                     LDA   B,X               ; Get the character from the out buffer.
                      (    forth6809.asm):02311                     STA   ACIADR            ; Transmit the char.
                      (    forth6809.asm):02312         
                      (    forth6809.asm):02313                     INCB                    ; Update the tail pointer pointing to the next char.
                      (    forth6809.asm):02314                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02315                     STB   OUTTAIL
D98B                  (    forth6809.asm):02316         IRQDONE2    RTI
                      (    forth6809.asm):02317         
D98B                  (    forth6809.asm):02318         TXOFF:                              ; The output ring is empty.
                      (    forth6809.asm):02319                     ; Commented-out code moved to shadow: TXOFF.1
                      (    forth6809.asm):02320                     CLR   OUTACTIVITY
                      (    forth6809.asm):02321                     JSR   UPDATE_RTS
D98B                  (    forth6809.asm):02322         IRQDONE3    RTI
                      (    forth6809.asm):02323         
                      (    forth6809.asm):02324                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):02325         
D98B 3B               (    forth6809.asm):02326         IRQH:       RTI                     ; polling mode (SERIALPOLL=1) - ACIA
                      (    forth6809.asm):02327                                             ; interrupts are never enabled (see
                      (    forth6809.asm):02328                                             ; COLDSTRT's CR_POLL init), so this should
                      (    forth6809.asm):02329                                             ; never fire; kept as a safe stub matching
                      (    forth6809.asm):02330                                             ; the other unused vectors below
                      (    forth6809.asm):02331                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):02332         
                      (    forth6809.asm):02333         ; ------------------------------------------------------------
                      (    forth6809.asm):02334         ; Unused interrupt handlers: return immediately. SWIH instead
                      (    forth6809.asm):02335         ; pushes the throw code -99 and jumps to THROW.
                      (    forth6809.asm):02336         ; ------------------------------------------------------------
D98C 3B               (    forth6809.asm):02337         SWI3H:      RTI
D98D 3B               (    forth6809.asm):02338         SWI2H:      RTI
D98E 3B               (    forth6809.asm):02339         FIRQH:      RTI
D98F 3B               (    forth6809.asm):02340         NMIH:       RTI                     ; unused now that NMI -> WARM
D990 CCFF9D           (    forth6809.asm):02341         SWIH:       LDD   #-99              ; placeholder hardware-trap code; push and
D993 3606             (    forth6809.asm):02342                     PSHU  D                 ; JMP THROW, per the CATCH/THROW turn
D995 7EE403           (    forth6809.asm):02343                     JMP   THROWW
                      (    forth6809.asm):02344         
                      (    forth6809.asm):02345         ; ============================================================
                      (    forth6809.asm):02346         ; SECTION 4: COLD / ABORT / QUIT  (with CATCH-wrapped INTERPRET)
                      (    forth6809.asm):02347         ; ============================================================
                      (    forth6809.asm):02348         ; ------------------------------------------------------------
                      (    forth6809.asm):02349         ; Cold start: set the dictionary, code and variable pointers to
                      (    forth6809.asm):02350         ; their application areas, BASE to 10 and the input source to the
                      (    forth6809.asm):02351         ; terminal buffer, print the sign-on banner, then enter ABORT.
                      (    forth6809.asm):02352         ; COLD
                      (    forth6809.asm):02353         ;    Inputs:
                      (    forth6809.asm):02354         ;        none (entered at reset)
                      (    forth6809.asm):02355         ;    Outputs:
                      (    forth6809.asm):02356         ;        none (does not return)
                      (    forth6809.asm):02357         ;    Registers: all changed.
                      (    forth6809.asm):02358         ; ------------------------------------------------------------
D998 CC0240           (    forth6809.asm):02359         COLD:       LDD   #APPVARS
D99B DD0A             (    forth6809.asm):02360                     STD   VARHERE
D99D CC7000           (    forth6809.asm):02361                     LDD   #APPCODE
D9A0 DD08             (    forth6809.asm):02362                     STD   CODEHERE
D9A2 CC2000           (    forth6809.asm):02363                     LDD   #APPDICT
D9A5 DD06             (    forth6809.asm):02364                     STD   DPHERE
D9A7 CCD956           (    forth6809.asm):02365                     LDD   #BASELATEST
D9AA DD04             (    forth6809.asm):02366                     STD   LATEST
D9AC BDE00C           (    forth6809.asm):02367                     JSR   WLINIT            ; FORTH wordlist, search order and CURRENT
                      (    forth6809.asm):02368         
D9AF CC000A           (    forth6809.asm):02369                     LDD   #10
D9B2 DD02             (    forth6809.asm):02370                     STD   BASE
                      (    forth6809.asm):02371         
D9B4 CC0106           (    forth6809.asm):02372                     LDD   #TIBBUF
D9B7 DD39             (    forth6809.asm):02373                     STD   SRCADDR
D9B9 CC0000           (    forth6809.asm):02374                     LDD   #0
D9BC DD3B             (    forth6809.asm):02375                     STD   SRCLEN
D9BE DD3D             (    forth6809.asm):02376                     STD   SRCID
                      (    forth6809.asm):02377         
D9C0 8EDA66           (    forth6809.asm):02378                     LDX   #SIGNON
D9C3 3610             (    forth6809.asm):02379                     PSHU  X                 ; c-addr
D9C5 CC000F           (    forth6809.asm):02380                     LDD   #SIGNONL
D9C8 3606             (    forth6809.asm):02381                     PSHU  D                 ; u
D9CA BDF412           (    forth6809.asm):02382                     JSR   TYPEW
D9CD BDFA21           (    forth6809.asm):02383                     JSR   CRW
D9D0 2008             (    forth6809.asm):02384                     BRA   ABORT             ; Go to ABORT, skipping the ABORTW word.
                      (    forth6809.asm):02385         
                      (    forth6809.asm):02386         ; ------------------------------------------------------------
                      (    forth6809.asm):02387         ; ABORT  ( i*x -- ) ( R: j*x -- )
                      (    forth6809.asm):02388         ; Throw -1. With no CATCH frame, THROW falls into the ABORT reset below.
                      (    forth6809.asm):02389         ; ------------------------------------------------------------
D9D2 CCFFFF           (    forth6809.asm):02390         ABORTW:     LDD   #-1
D9D5 3606             (    forth6809.asm):02391                     PSHU  D                 ; throw code (-1)
D9D7 7EE403           (    forth6809.asm):02392                     JMP   THROWW
                      (    forth6809.asm):02393         
                      (    forth6809.asm):02394         ; ------------------------------------------------------------
                      (    forth6809.asm):02395         ; Reset the data stack to its base, then fall through into QUITW.
                      (    forth6809.asm):02396         ; ABORT
                      (    forth6809.asm):02397         ;    Inputs:
                      (    forth6809.asm):02398         ;        none
                      (    forth6809.asm):02399         ;    Outputs:
                      (    forth6809.asm):02400         ;        none (does not return)
                      (    forth6809.asm):02401         ;    Registers: RegU changed.
                      (    forth6809.asm):02402         ; ------------------------------------------------------------
D9DA CEBD00           (    forth6809.asm):02403         ABORT:      LDU   #SP0
                      (    forth6809.asm):02404                     ; falls through into QUIT
                      (    forth6809.asm):02405         
                      (    forth6809.asm):02406         ; ------------------------------------------------------------
                      (    forth6809.asm):02407         ; QUIT  ( -- ) ( R: i*x -- )
                      (    forth6809.asm):02408         ; Empty the return stack, set interpretation state, then loop reading
                      (    forth6809.asm):02409         ; a line and interpreting it under CATCH. Errors are reported as
                      (    forth6809.asm):02410         ; "ERROR n"; -1 (ABORT) is silent. Never returns.
                      (    forth6809.asm):02411         ; ------------------------------------------------------------
D9DD 10CEC000         (    forth6809.asm):02412         QUITW:      LDS   #RP0
D9E1 CC0000           (    forth6809.asm):02413                     LDD   #0
D9E4 DD00             (    forth6809.asm):02414                     STD   STATE             ; See bugfix: QUITW.1
                      (    forth6809.asm):02415         
D9E6 BDE3AE           (    forth6809.asm):02416         QLOOP:      JSR   QUERYW
                      (    forth6809.asm):02417         
D9E9 DC06             (    forth6809.asm):02418                     LDD   DPHERE            ; Checkpoint on the return stack. CATCH
D9EB 3406             (    forth6809.asm):02419                     PSHS  D                 ; and THROW restore S, so the frame is
D9ED DC08             (    forth6809.asm):02420                     LDD   CODEHERE          ; intact whichever way INTERPRET ends.
D9EF 3406             (    forth6809.asm):02421                     PSHS  D                 ; See shadow QLOOP.2
D9F1 DC0A             (    forth6809.asm):02422                     LDD   VARHERE
D9F3 3406             (    forth6809.asm):02423                     PSHS  D
D9F5 DC04             (    forth6809.asm):02424                     LDD   LATEST
D9F7 3406             (    forth6809.asm):02425                     PSHS  D
                      (    forth6809.asm):02426         
D9F9 CCDE36           (    forth6809.asm):02427                     LDD   #INTERPRET
D9FC 3606             (    forth6809.asm):02428                     PSHU  D                 ; xt
D9FE BDE3D7           (    forth6809.asm):02429                     JSR   CATCHW
DA01 3706             (    forth6809.asm):02430                     PULU  D                 ; throw code (0 = no error)
DA03 3406             (    forth6809.asm):02431                     PSHS  D                 ; frame: 0,S code  2,S LATEST  4,S VARHERE
DA05 10830000         (    forth6809.asm):02432                     CMPD  #0                ;        6,S CODEHERE  8,S DPHERE
DA09 2743             (    forth6809.asm):02433                     BEQ   QOK
                      (    forth6809.asm):02434         
DA0B EC68             (    forth6809.asm):02435                     LDD   8,S
DA0D DD06             (    forth6809.asm):02436                     STD   DPHERE
DA0F BDE02D           (    forth6809.asm):02437                     JSR   PRUNE             ; unlink headers newer than DPHERE
DA12 EC66             (    forth6809.asm):02438                     LDD   6,S
DA14 DD08             (    forth6809.asm):02439                     STD   CODEHERE
DA16 EC64             (    forth6809.asm):02440                     LDD   4,S
DA18 DD0A             (    forth6809.asm):02441                     STD   VARHERE
DA1A EC62             (    forth6809.asm):02442                     LDD   2,S
DA1C DD04             (    forth6809.asm):02443                     STD   LATEST
DA1E CEBD00           (    forth6809.asm):02444                     LDU   #SP0
                      (    forth6809.asm):02445         
                      (    forth6809.asm):02446                     ; Return to interpretation state after a caught error.
                      (    forth6809.asm):02447                     ; See bugfix: QLOOP.1
DA21 CC0000           (    forth6809.asm):02448                     LDD   #0
DA24 DD00             (    forth6809.asm):02449                     STD   STATE
                      (    forth6809.asm):02450         
DA26 ECE4             (    forth6809.asm):02451                     LDD   ,S                ; -1 is ABORT: reset silently, no "ERROR -1"
DA28 1083FFFF         (    forth6809.asm):02452                     CMPD  #-1
DA2C 2605             (    forth6809.asm):02453                     BNE   QSHOWERR
DA2E 326A             (    forth6809.asm):02454                     LEAS  10,S              ; drop the frame
DA30 16FFB3           (    forth6809.asm):02455                     LBRA  QLOOP
                      (    forth6809.asm):02456         
DA33 BDFA21           (    forth6809.asm):02457         QSHOWERR:   JSR   CRW
DA36 8EDA79           (    forth6809.asm):02458                     LDX   #ERRMSG
DA39 3610             (    forth6809.asm):02459                     PSHU  X                 ; c-addr
DA3B CC0008           (    forth6809.asm):02460                     LDD   #ERRMSGL
DA3E 3606             (    forth6809.asm):02461                     PSHU  D                 ; u
DA40 BDF412           (    forth6809.asm):02462                     JSR   TYPEW
DA43 ECE4             (    forth6809.asm):02463                     LDD   ,S
DA45 3606             (    forth6809.asm):02464                     PSHU  D                 ; n
DA47 BDF8F0           (    forth6809.asm):02465                     JSR   DOTW
DA4A 326A             (    forth6809.asm):02466                     LEAS  10,S              ; drop the frame
DA4C 2098             (    forth6809.asm):02467                     BRA   QLOOP
                      (    forth6809.asm):02468         
DA4E 326A             (    forth6809.asm):02469         QOK:        LEAS  10,S              ; drop the frame
DA50 BDFA21           (    forth6809.asm):02470                     JSR   CRW               ; See bugfix: QOK.1
DA53 DC00             (    forth6809.asm):02471                     LDD   STATE
DA55 268F             (    forth6809.asm):02472                     BNE   QLOOP
DA57 8EDA75           (    forth6809.asm):02473                     LDX   #OKMSG
DA5A 3610             (    forth6809.asm):02474                     PSHU  X                 ; c-addr
DA5C CC0004           (    forth6809.asm):02475                     LDD   #OKMSGL
DA5F 3606             (    forth6809.asm):02476                     PSHU  D                 ; u
DA61 BDF412           (    forth6809.asm):02477                     JSR   TYPEW
DA64 2080             (    forth6809.asm):02478                     BRA   QLOOP
                      (    forth6809.asm):02479         
DA66 3638303920464F52 (    forth6809.asm):02480         SIGNON:     FCC   "6809 FORTH v1.0"
     54482076312E30
     000F             (    forth6809.asm):02481         SIGNONL     EQU   *-SIGNON
DA75 20206F6B         (    forth6809.asm):02482         OKMSG:      FCC   "  ok"
     0004             (    forth6809.asm):02483         OKMSGL      EQU   *-OKMSG
DA79 20204552524F5220 (    forth6809.asm):02484         ERRMSG:     FCC   "  ERROR "
     0008             (    forth6809.asm):02485         ERRMSGL     EQU   *-ERRMSG
                      (    forth6809.asm):02486         
                      (    forth6809.asm):02487         ; ============================================================
                      (    forth6809.asm):02488         ; SECTION 5: INNER-INTERPRETER SUPPORT (LIT, ZBRANCH, BRANCH,
                      (    forth6809.asm):02489         ; DODOES, DODEFER, EXECUTE)
                      (    forth6809.asm):02490         ; ============================================================
                      (    forth6809.asm):02491         ; ------------------------------------------------------------
                      (    forth6809.asm):02492         ; Run-time for a literal: fetch the inline cell that follows the
                      (    forth6809.asm):02493         ; calling JSR, push it, and advance the return address past it.
                      (    forth6809.asm):02494         ; LIT   ( -- x )
                      (    forth6809.asm):02495         ;    Inputs:
                      (    forth6809.asm):02496         ;        return stack top = address of the inline 16-bit literal
                      (    forth6809.asm):02497         ;    Outputs:
                      (    forth6809.asm):02498         ;        x pushed on the data stack; return address advanced by 2
                      (    forth6809.asm):02499         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02500         ; ------------------------------------------------------------
DA81 3510             (    forth6809.asm):02501         LIT:        PULS  X
DA83 EC81             (    forth6809.asm):02502                     LDD   ,X++
DA85 3606             (    forth6809.asm):02503                     PSHU  D                 ; x
DA87 3410             (    forth6809.asm):02504                     PSHS  X
DA89 39               (    forth6809.asm):02505                     RTS
                      (    forth6809.asm):02506         
                      (    forth6809.asm):02507         ; ------------------------------------------------------------
                      (    forth6809.asm):02508         ; Run-time for a conditional branch: take the inline offset if the
                      (    forth6809.asm):02509         ; flag is false, otherwise skip it. The offset is relative to its own
                      (    forth6809.asm):02510         ; address.
                      (    forth6809.asm):02511         ; ZBRANCH   ( flag -- )
                      (    forth6809.asm):02512         ;    Inputs:
                      (    forth6809.asm):02513         ;        flag on the data stack
                      (    forth6809.asm):02514         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02515         ;    Outputs:
                      (    forth6809.asm):02516         ;        flag removed; return address set to the branch target or past
                      (    forth6809.asm):02517         ;        the offset
                      (    forth6809.asm):02518         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02519         ; ------------------------------------------------------------
DA8A 3706             (    forth6809.asm):02520         ZBRANCH:    PULU  D                 ; flag
DA8C 3510             (    forth6809.asm):02521                     PULS  X
DA8E 10830000         (    forth6809.asm):02522                     CMPD  #0
DA92 2607             (    forth6809.asm):02523                     BNE   ZSKIP
DA94 EC84             (    forth6809.asm):02524                     LDD   ,X
DA96 308B             (    forth6809.asm):02525                     LEAX  D,X
DA98 3410             (    forth6809.asm):02526                     PSHS  X
DA9A 39               (    forth6809.asm):02527                     RTS
DA9B 3002             (    forth6809.asm):02528         ZSKIP:      LEAX  2,X
DA9D 3410             (    forth6809.asm):02529                     PSHS  X
DA9F 39               (    forth6809.asm):02530                     RTS
                      (    forth6809.asm):02531         
                      (    forth6809.asm):02532         ; ------------------------------------------------------------
                      (    forth6809.asm):02533         ; Run-time for an unconditional branch: add the inline offset
                      (    forth6809.asm):02534         ; (relative to its own address) to the return address.
                      (    forth6809.asm):02535         ; BRANCH
                      (    forth6809.asm):02536         ;    Inputs:
                      (    forth6809.asm):02537         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02538         ;    Outputs:
                      (    forth6809.asm):02539         ;        return address set to the branch target
                      (    forth6809.asm):02540         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02541         ; ------------------------------------------------------------
DAA0 3510             (    forth6809.asm):02542         BRANCH:     PULS  X
DAA2 EC84             (    forth6809.asm):02543                     LDD   ,X
DAA4 308B             (    forth6809.asm):02544                     LEAX  D,X
DAA6 3410             (    forth6809.asm):02545                     PSHS  X
DAA8 39               (    forth6809.asm):02546                     RTS
                      (    forth6809.asm):02547         
                      (    forth6809.asm):02548         ; ------------------------------------------------------------
                      (    forth6809.asm):02549         ; Run-time entry of a CREATEd or DOES>-defined word. Its code is a
                      (    forth6809.asm):02550         ; trampoline: JSR DODOES, a BEHAVIOR address, then the data-field
                      (    forth6809.asm):02551         ; address. Pushes the data-field address and jumps to BEHAVIOR.
                      (    forth6809.asm):02552         ; DODOES   ( -- pfa )
                      (    forth6809.asm):02553         ;    Inputs:
                      (    forth6809.asm):02554         ;        return stack top = address of the BEHAVIOR cell in the
                      (    forth6809.asm):02555         ;        trampoline
                      (    forth6809.asm):02556         ;    Outputs:
                      (    forth6809.asm):02557         ;        pfa pushed on the data stack; control passes to BEHAVIOR
                      (    forth6809.asm):02558         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02559         ; ------------------------------------------------------------
DAA9 3510             (    forth6809.asm):02560         DODOES:     PULS  X
DAAB 10AE81           (    forth6809.asm):02561                     LDY   ,X++
DAAE EC84             (    forth6809.asm):02562                     LDD   ,X
DAB0 3606             (    forth6809.asm):02563                     PSHU  D                 ; pfa
DAB2 6EA4             (    forth6809.asm):02564                     JMP   ,Y
                      (    forth6809.asm):02565         
                      (    forth6809.asm):02566         ; ------------------------------------------------------------
                      (    forth6809.asm):02567         ; Default BEHAVIOR for a CREATEd word: do nothing, leaving the data-
                      (    forth6809.asm):02568         ; field address on the stack.
                      (    forth6809.asm):02569         ; DOESRT0
                      (    forth6809.asm):02570         ;    Inputs:
                      (    forth6809.asm):02571         ;        none
                      (    forth6809.asm):02572         ;    Outputs:
                      (    forth6809.asm):02573         ;        none
                      (    forth6809.asm):02574         ;    Registers: none.
                      (    forth6809.asm):02575         ; ------------------------------------------------------------
DAB4 39               (    forth6809.asm):02576         DOESRT0:    RTS
                      (    forth6809.asm):02577         
                      (    forth6809.asm):02578         ; ------------------------------------------------------------
                      (    forth6809.asm):02579         ; Run-time for DOES>: patch the BEHAVIOR cell of the most recent
                      (    forth6809.asm):02580         ; definition with the code that follows the calling JSR, then return
                      (    forth6809.asm):02581         ; two levels up, skipping the rest of the defining word.
                      (    forth6809.asm):02582         ; SETDOES
                      (    forth6809.asm):02583         ;    Inputs:
                      (    forth6809.asm):02584         ;        return stack top = address after "JSR SETDOES" (the new
                      (    forth6809.asm):02585         ;        BEHAVIOR)
                      (    forth6809.asm):02586         ;        next on the return stack = the defining word's own return
                      (    forth6809.asm):02587         ;        address
                      (    forth6809.asm):02588         ;    Outputs:
                      (    forth6809.asm):02589         ;        BEHAVIOR cell of LATEST patched; control returns to the
                      (    forth6809.asm):02590         ;        defining word's caller
                      (    forth6809.asm):02591         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02592         ; ------------------------------------------------------------
DAB5 3510             (    forth6809.asm):02593         SETDOES:    PULS  X                 ; X = addr right after "JSR SETDOES" - new BEHAVIOR
DAB7 1F12             (    forth6809.asm):02594                     TFR   X,Y               ; Y = new BEHAVIOR, kept across the walk
                      (    forth6809.asm):02595         
DAB9 9E04             (    forth6809.asm):02596                     LDX   LATEST
DABB E684             (    forth6809.asm):02597                     LDB   ,X
DABD C41F             (    forth6809.asm):02598                     ANDB  #$1F
DABF 4F               (    forth6809.asm):02599                     CLRA
DAC0 308B             (    forth6809.asm):02600                     LEAX  D,X               ; header + name length
DAC2 EC03             (    forth6809.asm):02601                     LDD   3,X               ; D = CFA (trampoline address), past name and LINK
DAC4 C30003           (    forth6809.asm):02602                     ADDD  #3                ; +3 -> BEHAVIOR field (past JSR DODOES)
DAC7 1F01             (    forth6809.asm):02603                     TFR   D,X
                      (    forth6809.asm):02604         
DAC9 10AF84           (    forth6809.asm):02605                     STY   ,X                ; patch it
                      (    forth6809.asm):02606         
DACC 3510             (    forth6809.asm):02607                     PULS  X                 ; X = the OUTER defining word's own return addr
DACE 6E84             (    forth6809.asm):02608                     JMP   ,X                ; jump there directly - "double RTS"
                      (    forth6809.asm):02609         
                      (    forth6809.asm):02610         ; ------------------------------------------------------------
                      (    forth6809.asm):02611         ; BEHAVIOR of a DEFERred word: execute the xt stored in its data
                      (    forth6809.asm):02612         ; field. Tail-calls the xt, so it returns to the original caller.
                      (    forth6809.asm):02613         ; DODEFER   ( pfa -- )
                      (    forth6809.asm):02614         ;    Inputs:
                      (    forth6809.asm):02615         ;        pfa on the data stack
                      (    forth6809.asm):02616         ;    Outputs:
                      (    forth6809.asm):02617         ;        pfa removed; the stored xt is executed
                      (    forth6809.asm):02618         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02619         ; ------------------------------------------------------------
DAD0 3710             (    forth6809.asm):02620         DODEFER:    PULU  X                 ; pfa
DAD2 EC84             (    forth6809.asm):02621                     LDD   ,X
DAD4 1F01             (    forth6809.asm):02622                     TFR   D,X
DAD6 6E84             (    forth6809.asm):02623                     JMP   ,X
                      (    forth6809.asm):02624         
                      (    forth6809.asm):02625         ; ------------------------------------------------------------
                      (    forth6809.asm):02626         ; Initial xt of a DEFER: throws -21 until IS stores a real xt.
                      (    forth6809.asm):02627         ; DOABORTUNDEF
                      (    forth6809.asm):02628         ;    Inputs:
                      (    forth6809.asm):02629         ;        none
                      (    forth6809.asm):02630         ;    Outputs:
                      (    forth6809.asm):02631         ;        none (does not return)
                      (    forth6809.asm):02632         ;    Registers: RegD changed.
                      (    forth6809.asm):02633         ; ------------------------------------------------------------
DAD8                  (    forth6809.asm):02634         DOABORTUNDEF:
DAD8 CCFFEB           (    forth6809.asm):02635                     LDD   #-21
DADB 3606             (    forth6809.asm):02636                     PSHU  D                 ; throw code (-21)
DADD 7EE403           (    forth6809.asm):02637                     JMP   THROWW
                      (    forth6809.asm):02638         
                      (    forth6809.asm):02639         ; ------------------------------------------------------------
                      (    forth6809.asm):02640         ; BEHAVIOR of a MARKER word: restore the dictionary, code and variable
                      (    forth6809.asm):02641         ; pointers and LATEST from the four cells saved when it was defined,
                      (    forth6809.asm):02642         ; then the search order state (SRCHSAVESZ bytes after them), then
                      (    forth6809.asm):02643         ; unlink every RAM header newer than DPHERE from every wordlist.
                      (    forth6809.asm):02644         ; DOMARKER   ( pfa -- )
                      (    forth6809.asm):02645         ;    Inputs:
                      (    forth6809.asm):02646         ;        pfa on the data stack (the saved cells)
                      (    forth6809.asm):02647         ;    Outputs:
                      (    forth6809.asm):02648         ;        pfa removed; DPHERE, CODEHERE, VARHERE, LATEST, WLEND, CURRENT
                      (    forth6809.asm):02649         ;        and the search order restored; wordlists pruned
                      (    forth6809.asm):02650         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02651         ; ------------------------------------------------------------
DAE0 3710             (    forth6809.asm):02652         DOMARKER:   PULU  X                 ; pfa
DAE2 EC84             (    forth6809.asm):02653                     LDD   ,X
DAE4 DD06             (    forth6809.asm):02654                     STD   DPHERE
DAE6 EC02             (    forth6809.asm):02655                     LDD   2,X
DAE8 DD08             (    forth6809.asm):02656                     STD   CODEHERE
DAEA EC04             (    forth6809.asm):02657                     LDD   4,X
DAEC DD0A             (    forth6809.asm):02658                     STD   VARHERE
DAEE EC06             (    forth6809.asm):02659                     LDD   6,X
DAF0 DD04             (    forth6809.asm):02660                     STD   LATEST
DAF2 3008             (    forth6809.asm):02661                     LEAX  8,X               ; the saved search-order state follows
DAF4 108E0045         (    forth6809.asm):02662                     LDY   #SRCHSAVE
DAF8 C616             (    forth6809.asm):02663                     LDB   #SRCHSAVESZ
DAFA A680             (    forth6809.asm):02664         DMCOPY:     LDA   ,X+
DAFC A7A0             (    forth6809.asm):02665                     STA   ,Y+
DAFE 5A               (    forth6809.asm):02666                     DECB
DAFF 26F9             (    forth6809.asm):02667                     BNE   DMCOPY
DB01 DC06             (    forth6809.asm):02668                     LDD   DPHERE
DB03 7EE02D           (    forth6809.asm):02669                     JMP   PRUNE             ; unlink headers newer than DPHERE
                      (    forth6809.asm):02670         
                      (    forth6809.asm):02671         ; ------------------------------------------------------------
                      (    forth6809.asm):02672         ; EXECUTE  ( i*x xt -- j*x )
                      (    forth6809.asm):02673         ; Execute the word whose execution token is xt.
                      (    forth6809.asm):02674         ; ------------------------------------------------------------
DB06 3710             (    forth6809.asm):02675         EXECUTEW:   PULU  X                 ; xt
DB08 AD84             (    forth6809.asm):02676                     JSR   ,X
DB0A 39               (    forth6809.asm):02677                     RTS
                      (    forth6809.asm):02678         
                      (    forth6809.asm):02679         ; ============================================================
                      (    forth6809.asm):02680         ; SECTION 6: COMMA FAMILY (factored via APPENDCELL/APPENDBYTE)
                      (    forth6809.asm):02681         ; ============================================================
                      (    forth6809.asm):02682         ; ------------------------------------------------------------
                      (    forth6809.asm):02683         ; Append a 16-bit cell to the area whose "here" pointer is at RegX
                      (    forth6809.asm):02684         ; (CODEHERE or VARHERE), and advance that pointer by 2.
                      (    forth6809.asm):02685         ; APPENDCELL   ( x -- )
                      (    forth6809.asm):02686         ;    Inputs:
                      (    forth6809.asm):02687         ;        RegX = address of the here pointer
                      (    forth6809.asm):02688         ;        x on the data stack
                      (    forth6809.asm):02689         ;    Outputs:
                      (    forth6809.asm):02690         ;        x stored at the old here value; pointer advanced by 2
                      (    forth6809.asm):02691         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02692         ; ------------------------------------------------------------
DB0B 3706             (    forth6809.asm):02693         APPENDCELL: PULU  D                 ; x
DB0D 10AE84           (    forth6809.asm):02694                     LDY   ,X
DB10 EDA1             (    forth6809.asm):02695                     STD   ,Y++
DB12 10AF84           (    forth6809.asm):02696                     STY   ,X
DB15 39               (    forth6809.asm):02697                     RTS
                      (    forth6809.asm):02698         
                      (    forth6809.asm):02699         ; ------------------------------------------------------------
                      (    forth6809.asm):02700         ; Append the low byte of the top cell to the area whose "here" pointer
                      (    forth6809.asm):02701         ; is at RegX (CODEHERE or VARHERE), and advance that pointer by 1.
                      (    forth6809.asm):02702         ; APPENDBYTE   ( char -- )
                      (    forth6809.asm):02703         ;    Inputs:
                      (    forth6809.asm):02704         ;        RegX = address of the here pointer
                      (    forth6809.asm):02705         ;        char on the data stack
                      (    forth6809.asm):02706         ;    Outputs:
                      (    forth6809.asm):02707         ;        char stored at the old here value; pointer advanced by 1
                      (    forth6809.asm):02708         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02709         ; ------------------------------------------------------------
DB16 3706             (    forth6809.asm):02710         APPENDBYTE: PULU  D                 ; char
DB18 10AE84           (    forth6809.asm):02711                     LDY   ,X
DB1B E7A0             (    forth6809.asm):02712                     STB   ,Y+
DB1D 10AF84           (    forth6809.asm):02713                     STY   ,X
DB20 39               (    forth6809.asm):02714                     RTS
                      (    forth6809.asm):02715         
                      (    forth6809.asm):02716         ; ------------------------------------------------------------
                      (    forth6809.asm):02717         ; ,  ( x -- )
                      (    forth6809.asm):02718         ; Append x to the code/data area (CODEHERE).
                      (    forth6809.asm):02719         ; ------------------------------------------------------------
DB21 8E0008           (    forth6809.asm):02720         COMMAW:     LDX   #CODEHERE
DB24 7EDB0B           (    forth6809.asm):02721                     JMP   APPENDCELL
                      (    forth6809.asm):02722         
                      (    forth6809.asm):02723         ; ------------------------------------------------------------
                      (    forth6809.asm):02724         ; CODECOMMA  ( x -- )
                      (    forth6809.asm):02725         ; Internal name for ",": append x at CODEHERE.
                      (    forth6809.asm):02726         ; ------------------------------------------------------------
DB27 8E0008           (    forth6809.asm):02727         CODECOMMA:  LDX   #CODEHERE
DB2A 7EDB0B           (    forth6809.asm):02728                     JMP   APPENDCELL
                      (    forth6809.asm):02729         
                      (    forth6809.asm):02730         ; ------------------------------------------------------------
                      (    forth6809.asm):02731         ; C,  ( char -- )
                      (    forth6809.asm):02732         ; Append char to the code/data area (CODEHERE).
                      (    forth6809.asm):02733         ; ------------------------------------------------------------
DB2D 8E0008           (    forth6809.asm):02734         CCOMMAW:    LDX   #CODEHERE
DB30 7EDB16           (    forth6809.asm):02735                     JMP   APPENDBYTE
                      (    forth6809.asm):02736         
                      (    forth6809.asm):02737         ; ------------------------------------------------------------
                      (    forth6809.asm):02738         ; CCOMMA1  ( char -- )
                      (    forth6809.asm):02739         ; Internal name for "C,": append char at CODEHERE.
                      (    forth6809.asm):02740         ; ------------------------------------------------------------
DB33 8E0008           (    forth6809.asm):02741         CCOMMA1:    LDX   #CODEHERE
DB36 7EDB16           (    forth6809.asm):02742                     JMP   APPENDBYTE
                      (    forth6809.asm):02743         
                      (    forth6809.asm):02744         ; ------------------------------------------------------------
                      (    forth6809.asm):02745         ; V,  ( x -- )
                      (    forth6809.asm):02746         ; Append x to the variable area (VARHERE).
                      (    forth6809.asm):02747         ; ------------------------------------------------------------
DB39 8E000A           (    forth6809.asm):02748         VCOMMAW:    LDX   #VARHERE
DB3C 7EDB0B           (    forth6809.asm):02749                     JMP   APPENDCELL
                      (    forth6809.asm):02750         
                      (    forth6809.asm):02751         ; ------------------------------------------------------------
                      (    forth6809.asm):02752         ; VC,  ( char -- )
                      (    forth6809.asm):02753         ; Append char to the variable area (VARHERE).
                      (    forth6809.asm):02754         ; ------------------------------------------------------------
DB3F 8E000A           (    forth6809.asm):02755         VCCOMMAW:   LDX   #VARHERE
DB42 7EDB16           (    forth6809.asm):02756                     JMP   APPENDBYTE
                      (    forth6809.asm):02757         
                      (    forth6809.asm):02758         ; ------------------------------------------------------------
                      (    forth6809.asm):02759         ; ALLOT  ( n -- )
                      (    forth6809.asm):02760         ; Reserve n bytes in the code/data area by advancing CODEHERE.
                      (    forth6809.asm):02761         ; ------------------------------------------------------------
DB45 3706             (    forth6809.asm):02762         ALLOTW:     PULU  D                 ; n
DB47 9E08             (    forth6809.asm):02763                     LDX   CODEHERE
DB49 308B             (    forth6809.asm):02764                     LEAX  D,X
DB4B 9F08             (    forth6809.asm):02765                     STX   CODEHERE
DB4D 39               (    forth6809.asm):02766                     RTS
                      (    forth6809.asm):02767         
                      (    forth6809.asm):02768         ; ------------------------------------------------------------
                      (    forth6809.asm):02769         ; VALLOT  ( n -- )
                      (    forth6809.asm):02770         ; Reserve n bytes in the variable area by advancing VARHERE.
                      (    forth6809.asm):02771         ; ------------------------------------------------------------
DB4E 3706             (    forth6809.asm):02772         VALLOTW:    PULU  D                 ; n
DB50 9E0A             (    forth6809.asm):02773                     LDX   VARHERE
DB52 308B             (    forth6809.asm):02774                     LEAX  D,X
DB54 9F0A             (    forth6809.asm):02775                     STX   VARHERE
DB56 39               (    forth6809.asm):02776                     RTS
                      (    forth6809.asm):02777         
                      (    forth6809.asm):02778         ; ------------------------------------------------------------
                      (    forth6809.asm):02779         ; HERE  ( -- addr )
                      (    forth6809.asm):02780         ; Return the next free address in the code/data area (CODEHERE).
                      (    forth6809.asm):02781         ; ------------------------------------------------------------
DB57 DC08             (    forth6809.asm):02782         HEREW:      LDD   CODEHERE
DB59 3606             (    forth6809.asm):02783                     PSHU  D                 ; addr
DB5B 39               (    forth6809.asm):02784                     RTS
                      (    forth6809.asm):02785         
                      (    forth6809.asm):02786         ; ------------------------------------------------------------
                      (    forth6809.asm):02787         ; VHERE  ( -- addr )
                      (    forth6809.asm):02788         ; Return the next free address in the variable area (VARHERE).
                      (    forth6809.asm):02789         ; ------------------------------------------------------------
DB5C DC0A             (    forth6809.asm):02790         VHEREW:     LDD   VARHERE
DB5E 3606             (    forth6809.asm):02791                     PSHU  D                 ; addr
DB60 39               (    forth6809.asm):02792                     RTS
                      (    forth6809.asm):02793         
                      (    forth6809.asm):02794         ; ------------------------------------------------------------
                      (    forth6809.asm):02795         ; PAD  ( -- c-addr )
                      (    forth6809.asm):02796         ; Return the scratch buffer address, PADOFFSET bytes above CODEHERE.
                      (    forth6809.asm):02797         ; ------------------------------------------------------------
DB61 DC08             (    forth6809.asm):02798         PADW:       LDD   CODEHERE
DB63 C30080           (    forth6809.asm):02799                     ADDD  #PADOFFSET
DB66 3606             (    forth6809.asm):02800                     PSHU  D                 ; c-addr
DB68 39               (    forth6809.asm):02801                     RTS
                      (    forth6809.asm):02802         
                      (    forth6809.asm):02803         ; ------------------------------------------------------------
                      (    forth6809.asm):02804         ; UNUSED  ( -- u )
                      (    forth6809.asm):02805         ; Return the number of free bytes remaining in the code/data area.
                      (    forth6809.asm):02806         ; ------------------------------------------------------------
DB69 CCB900           (    forth6809.asm):02807         UNUSEDW:    LDD   #CODETOP
DB6C 9308             (    forth6809.asm):02808                     SUBD  CODEHERE
DB6E 3606             (    forth6809.asm):02809                     PSHU  D                 ; u
DB70 39               (    forth6809.asm):02810                     RTS
                      (    forth6809.asm):02811         
                      (    forth6809.asm):02812         ; ------------------------------------------------------------
                      (    forth6809.asm):02813         ; VUNUSED  ( -- u )
                      (    forth6809.asm):02814         ; Return the number of free bytes remaining in the variable area.
                      (    forth6809.asm):02815         ; ------------------------------------------------------------
DB71 CC1FFF           (    forth6809.asm):02816         VUNUSEDW:   LDD   #APPVARSEND       ; See bugfix: VUNUSEDW.1
DB74 930A             (    forth6809.asm):02817                     SUBD  VARHERE
DB76 3606             (    forth6809.asm):02818                     PSHU  D                 ; u
DB78 39               (    forth6809.asm):02819                     RTS
                      (    forth6809.asm):02820         
                      (    forth6809.asm):02821         ; ============================================================
                      (    forth6809.asm):02822         ; SECTION 7: HEADER (factored from :/CREATE/VARIABLE)
                      (    forth6809.asm):02823         ; ============================================================
                      (    forth6809.asm):02824         ; ------------------------------------------------------------
                      (    forth6809.asm):02825         ; Build a dictionary header for the next name in the input: parse the
                      (    forth6809.asm):02826         ; name, then lay down the length byte (with the smudge bit set if
                      (    forth6809.asm):02827         ; requested), the name, the link to the previous header and the code
                      (    forth6809.asm):02828         ; field address (CODEHERE). LATEST, DPHERE and the head of the CURRENT
                      (    forth6809.asm):02829         ; wordlist are updated.
                      (    forth6809.asm):02830         ; HEADER   ( smudge-flag "name" -- )
                      (    forth6809.asm):02831         ;    Inputs:
                      (    forth6809.asm):02832         ;        smudge-flag on the data stack (non-zero hides the new word)
                      (    forth6809.asm):02833         ;        name parsed from the input stream
                      (    forth6809.asm):02834         ;    Outputs:
                      (    forth6809.asm):02835         ;        header built at DPHERE, linked into the CURRENT wordlist;
                      (    forth6809.asm):02836         ;        LATEST = address of the new header
                      (    forth6809.asm):02837         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02838         ; ------------------------------------------------------------
DB79 CC0020           (    forth6809.asm):02839         HEADER:     LDD   #32
DB7C 3606             (    forth6809.asm):02840                     PSHU  D
DB7E BDDEB6           (    forth6809.asm):02841                     JSR   WORDW
DB81 3710             (    forth6809.asm):02842                     PULU  X                 ; c-addr of the name
DB83 3706             (    forth6809.asm):02843                     PULU  D                 ; smudge flag in B
DB85 A680             (    forth6809.asm):02844                     LDA   ,X+               ; name length, X = name text
DB87 3402             (    forth6809.asm):02845                     PSHS  A                 ; 2,S = length (5k: S-frame, no scratch)
DB89 5D               (    forth6809.asm):02846                     TSTB
DB8A 2702             (    forth6809.asm):02847                     BEQ   HDNOSM
DB8C 8A40             (    forth6809.asm):02848                     ORA   #$40
DB8E 109E06           (    forth6809.asm):02849         HDNOSM:     LDY   DPHERE
DB91 3420             (    forth6809.asm):02850                     PSHS  Y                 ; 0,S = address of the new header
DB93 A7A0             (    forth6809.asm):02851                     STA   ,Y+
DB95 E662             (    forth6809.asm):02852                     LDB   2,S
DB97 2707             (    forth6809.asm):02853                     BEQ   HDNONM
DB99 A680             (    forth6809.asm):02854         HDCPY:      LDA   ,X+
DB9B A7A0             (    forth6809.asm):02855                     STA   ,Y+
DB9D 5A               (    forth6809.asm):02856                     DECB
DB9E 26F9             (    forth6809.asm):02857                     BNE   HDCPY
DBA0 9E47             (    forth6809.asm):02858         HDNONM:     LDX   CURRENT           ; X = WID of the wordlist receiving the word
DBA2 EC84             (    forth6809.asm):02859                     LDD   ,X
DBA4 EDA1             (    forth6809.asm):02860                     STD   ,Y++              ; LINK = old head of that wordlist
DBA6 DC08             (    forth6809.asm):02861                     LDD   CODEHERE
DBA8 EDA1             (    forth6809.asm):02862                     STD   ,Y++
DBAA 109F06           (    forth6809.asm):02863                     STY   DPHERE
DBAD 3506             (    forth6809.asm):02864                     PULS  D
DBAF DD04             (    forth6809.asm):02865                     STD   LATEST            ; LATEST = newest header of any wordlist
DBB1 ED84             (    forth6809.asm):02866                     STD   ,X                ; and the new head of the CURRENT wordlist
DBB3 3261             (    forth6809.asm):02867                     LEAS  1,S
DBB5 39               (    forth6809.asm):02868                     RTS
                      (    forth6809.asm):02869         
                      (    forth6809.asm):02870         ; ============================================================
                      (    forth6809.asm):02871         ; SECTION 8: DEFINING WORDS
                      (    forth6809.asm):02872         ; ============================================================
                      (    forth6809.asm):02873         ; ------------------------------------------------------------
                      (    forth6809.asm):02874         ; :  ( "name" -- )
                      (    forth6809.asm):02875         ; Start a colon definition: parse the name, build a smudged header,
                      (    forth6809.asm):02876         ; record the new xt in CURXT, note the control-flow stack position in
                      (    forth6809.asm):02877         ; CSP and enter compile state.
                      (    forth6809.asm):02878         ; ------------------------------------------------------------
DBB6 CCFFFF           (    forth6809.asm):02879         COLONW:     LDD   #TRUEV
DBB9 3606             (    forth6809.asm):02880                     PSHU  D
DBBB BDDB79           (    forth6809.asm):02881                     JSR   HEADER
DBBE DC08             (    forth6809.asm):02882                     LDD   CODEHERE          ; Record this word's xt for RECURSE.
DBC0 DD1F             (    forth6809.asm):02883                     STD   CURXT             ; See bugfix: COLONW.1
DBC2 1F30             (    forth6809.asm):02884                     TFR   U,D
DBC4 DD21             (    forth6809.asm):02885                     STD   CSP
DBC6 CCFFFF           (    forth6809.asm):02886                     LDD   #-1
DBC9 DD00             (    forth6809.asm):02887                     STD   STATE
DBCB 39               (    forth6809.asm):02888                     RTS
                      (    forth6809.asm):02889         
                      (    forth6809.asm):02890         ; ------------------------------------------------------------
                      (    forth6809.asm):02891         ; ;  ( -- )  IMMEDIATE
                      (    forth6809.asm):02892         ; End a colon definition: compile RTS, check that the control-flow
                      (    forth6809.asm):02893         ; stack is balanced (error -22 if not), clear the smudge bit of the
                      (    forth6809.asm):02894         ; new word and return to interpret state.
                      (    forth6809.asm):02895         ; ------------------------------------------------------------
DBCC CC0039           (    forth6809.asm):02896         SEMIW:      LDD   #RTSOPC
DBCF 3606             (    forth6809.asm):02897                     PSHU  D
DBD1 BDDB33           (    forth6809.asm):02898                     JSR   CCOMMA1
DBD4 1F30             (    forth6809.asm):02899                     TFR   U,D
DBD6 109321           (    forth6809.asm):02900                     CMPD  CSP
DBD9 2703             (    forth6809.asm):02901                     BEQ   SEMIOK
DBDB BDE3CE           (    forth6809.asm):02902                     JSR   CFERR
DBDE 9E04             (    forth6809.asm):02903         SEMIOK:     LDX   LATEST
DBE0 A684             (    forth6809.asm):02904                     LDA   ,X
DBE2 84BF             (    forth6809.asm):02905                     ANDA  #$BF
DBE4 A784             (    forth6809.asm):02906                     STA   ,X
DBE6 CC0000           (    forth6809.asm):02907                     LDD   #0
DBE9 DD00             (    forth6809.asm):02908                     STD   STATE
DBEB 39               (    forth6809.asm):02909                     RTS
                      (    forth6809.asm):02910         
                      (    forth6809.asm):02911         ; ------------------------------------------------------------
                      (    forth6809.asm):02912         ; :NONAME  ( -- xt )
                      (    forth6809.asm):02913         ; Start an anonymous definition: no header is built and LATEST is left
                      (    forth6809.asm):02914         ; alone, so the word can never be found. Leaves the xt (the current
                      (    forth6809.asm):02915         ; CODEHERE) on the stack, records it in CURXT, notes the control-flow
                      (    forth6809.asm):02916         ; stack position in CSP and enters compile state.
                      (    forth6809.asm):02917         ; Original comment: shadow NONAMEW.0.
                      (    forth6809.asm):02918         ; ------------------------------------------------------------
DBEC DC08             (    forth6809.asm):02919         NONAMEW:    LDD   CODEHERE
DBEE 3606             (    forth6809.asm):02920                     PSHU  D                 ; xt
DBF0 DD1F             (    forth6809.asm):02921                     STD   CURXT             ; See bugfix: NONAMEW.1
DBF2 1F30             (    forth6809.asm):02922                     TFR   U,D
DBF4 DD21             (    forth6809.asm):02923                     STD   CSP
DBF6 CCFFFF           (    forth6809.asm):02924                     LDD   #-1
DBF9 DD00             (    forth6809.asm):02925                     STD   STATE
DBFB 39               (    forth6809.asm):02926                     RTS
                      (    forth6809.asm):02927         
                      (    forth6809.asm):02928         ; ------------------------------------------------------------
                      (    forth6809.asm):02929         ; Common start of every DODOES-style defining word: build a header
                      (    forth6809.asm):02930         ; and compile the DODOES trampoline followed by the behaviour address.
                      (    forth6809.asm):02931         ; BLDDOES
                      (    forth6809.asm):02932         ;    Inputs:
                      (    forth6809.asm):02933         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):02934         ;    Outputs:
                      (    forth6809.asm):02935         ;        header built, trampoline and behaviour cell compiled
                      (    forth6809.asm):02936         ;    Registers: all changed.
                      (    forth6809.asm):02937         ; BLDSELF
                      (    forth6809.asm):02938         ;    Inputs:
                      (    forth6809.asm):02939         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):02940         ;    Outputs:
                      (    forth6809.asm):02941         ;        as BLDDOES, then the PFA cell compiled pointing at the
                      (    forth6809.asm):02942         ;        cell that follows it (the word's own data field)
                      (    forth6809.asm):02943         ;    Registers: all changed.
                      (    forth6809.asm):02944         ; Used by CREATE, CONSTANT, 2CONSTANT, DEFER and MARKER (BLDSELF)
                      (    forth6809.asm):02945         ; and by VALUE (BLDDOES, which supplies its own PFA).
                      (    forth6809.asm):02946         ; ------------------------------------------------------------
DBFC 3406             (    forth6809.asm):02947         BLDDOES:    PSHS  D                 ; behaviour address
DBFE CC0000           (    forth6809.asm):02948                     LDD   #0
DC01 3606             (    forth6809.asm):02949                     PSHU  D
DC03 BDDB79           (    forth6809.asm):02950                     JSR   HEADER
DC06 CCDAA9           (    forth6809.asm):02951                     LDD   #DODOES
DC09 3606             (    forth6809.asm):02952                     PSHU  D
DC0B BDE83E           (    forth6809.asm):02953                     JSR   CCALL
DC0E 3506             (    forth6809.asm):02954                     PULS  D
DC10 3606             (    forth6809.asm):02955                     PSHU  D                 ; behaviour address
DC12 BDDB27           (    forth6809.asm):02956                     JSR   CODECOMMA
DC15 39               (    forth6809.asm):02957                     RTS
                      (    forth6809.asm):02958         
DC16 BDDBFC           (    forth6809.asm):02959         BLDSELF:    JSR   BLDDOES
DC19 DC08             (    forth6809.asm):02960                     LDD   CODEHERE          ; PFA = the cell after this one
DC1B C30002           (    forth6809.asm):02961                     ADDD  #2                ; See bugfix: CONSTANTW.1
DC1E 3606             (    forth6809.asm):02962                     PSHU  D
DC20 BDDB27           (    forth6809.asm):02963                     JSR   CODECOMMA
DC23 39               (    forth6809.asm):02964                     RTS
                      (    forth6809.asm):02965         
                      (    forth6809.asm):02966         ; ------------------------------------------------------------
                      (    forth6809.asm):02967         ; CREATE  ( "name" -- )
                      (    forth6809.asm):02968         ; Build a header whose code is a DODOES trampoline. The default
                      (    forth6809.asm):02969         ; behaviour (DOESRT0) leaves the data-field address, the next free
                      (    forth6809.asm):02970         ; address in the code area, on the stack.
                      (    forth6809.asm):02971         ; ------------------------------------------------------------
DC24 CCDAB4           (    forth6809.asm):02972         CREATEW:    LDD   #DOESRT0
DC27 BDDC16           (    forth6809.asm):02973                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
DC2A 39               (    forth6809.asm):02974                     RTS
                      (    forth6809.asm):02975         
                      (    forth6809.asm):02976         ; ------------------------------------------------------------
                      (    forth6809.asm):02977         ; DOES>  ( -- )  IMMEDIATE, compile-only
                      (    forth6809.asm):02978         ; Compile a call to SETDOES, which at run time patches the behaviour
                      (    forth6809.asm):02979         ; of the word being defined.
                      (    forth6809.asm):02980         ; Original comment: shadow DOESGTW.0.
                      (    forth6809.asm):02981         ; ------------------------------------------------------------
DC2B CCDAB5           (    forth6809.asm):02982         DOESGTW:    LDD   #SETDOES
DC2E 3606             (    forth6809.asm):02983                     PSHU  D
DC30 BDE83E           (    forth6809.asm):02984                     JSR   CCALL
DC33 39               (    forth6809.asm):02985                     RTS
                      (    forth6809.asm):02986         
                      (    forth6809.asm):02987         ; ------------------------------------------------------------
                      (    forth6809.asm):02988         ; VARIABLE  ( "name" -- )
                      (    forth6809.asm):02989         ; Build a word that returns the address of a new cell in the variable
                      (    forth6809.asm):02990         ; area, initialised to zero.
                      (    forth6809.asm):02991         ; ------------------------------------------------------------
DC34 CC0000           (    forth6809.asm):02992         VARIABLEW:  LDD   #0
DC37 3606             (    forth6809.asm):02993                     PSHU  D
DC39 BDDB79           (    forth6809.asm):02994                     JSR   HEADER
DC3C CCDAA9           (    forth6809.asm):02995                     LDD   #DODOES
DC3F 3606             (    forth6809.asm):02996                     PSHU  D
DC41 BDE83E           (    forth6809.asm):02997                     JSR   CCALL
DC44 CCDAB4           (    forth6809.asm):02998                     LDD   #DOESRT0
DC47 3606             (    forth6809.asm):02999                     PSHU  D
DC49 BDDB27           (    forth6809.asm):03000                     JSR   CODECOMMA
DC4C DC0A             (    forth6809.asm):03001                     LDD   VARHERE
DC4E 3606             (    forth6809.asm):03002                     PSHU  D
DC50 BDDB27           (    forth6809.asm):03003                     JSR   CODECOMMA
DC53 CC0000           (    forth6809.asm):03004                     LDD   #0
DC56 9E0A             (    forth6809.asm):03005                     LDX   VARHERE
DC58 ED81             (    forth6809.asm):03006                     STD   ,X++
DC5A 9F0A             (    forth6809.asm):03007                     STX   VARHERE
DC5C 39               (    forth6809.asm):03008                     RTS
                      (    forth6809.asm):03009         
                      (    forth6809.asm):03010         ; ------------------------------------------------------------
                      (    forth6809.asm):03011         ; @  ( a-addr -- x )
                      (    forth6809.asm):03012         ; Fetch the cell at a-addr. Also the behaviour of CONSTANT words.
                      (    forth6809.asm):03013         ; ------------------------------------------------------------
DC5D 3710             (    forth6809.asm):03014         FETCHW:     PULU  X                 ; a-addr
DC5F EC84             (    forth6809.asm):03015                     LDD   ,X
DC61 3606             (    forth6809.asm):03016                     PSHU  D                 ; x
DC63 39               (    forth6809.asm):03017                     RTS
                      (    forth6809.asm):03018         
                      (    forth6809.asm):03019         ; ------------------------------------------------------------
                      (    forth6809.asm):03020         ; CONSTANT  ( x "name" -- )
                      (    forth6809.asm):03021         ; Build a word that returns x. The value is stored in the code area
                      (    forth6809.asm):03022         ; after the trampoline and fetched with @.
                      (    forth6809.asm):03023         ; ------------------------------------------------------------
DC64 CCDC5D           (    forth6809.asm):03024         CONSTANTW:  LDD   #FETCHW
DC67 BDDC16           (    forth6809.asm):03025                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
DC6A BDDB21           (    forth6809.asm):03026                     JSR   COMMAW
DC6D 39               (    forth6809.asm):03027                     RTS
                      (    forth6809.asm):03028         
                      (    forth6809.asm):03029         ; ------------------------------------------------------------
                      (    forth6809.asm):03030         ; Behaviour of a VALUE word: fetch the value cell.
                      (    forth6809.asm):03031         ; DOVALUE   ( pfa -- x )
                      (    forth6809.asm):03032         ;    Inputs:
                      (    forth6809.asm):03033         ;        pfa on the data stack (address of the value cell)
                      (    forth6809.asm):03034         ;    Outputs:
                      (    forth6809.asm):03035         ;        pfa replaced by the value
                      (    forth6809.asm):03036         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):03037         ; ------------------------------------------------------------
DC6E 3710             (    forth6809.asm):03038         DOVALUE:    PULU  X                 ; pfa
DC70 EC84             (    forth6809.asm):03039                     LDD   ,X
DC72 3606             (    forth6809.asm):03040                     PSHU  D                 ; x
DC74 39               (    forth6809.asm):03041                     RTS
                      (    forth6809.asm):03042         
                      (    forth6809.asm):03043         ; ------------------------------------------------------------
                      (    forth6809.asm):03044         ; VALUE  ( x "name" -- )
                      (    forth6809.asm):03045         ; Build a word that returns x, which can be changed with TO. The value
                      (    forth6809.asm):03046         ; cell is kept in the variable area so that it is writable.
                      (    forth6809.asm):03047         ; ------------------------------------------------------------
DC75 CCDC6E           (    forth6809.asm):03048         VALUEW:     LDD   #DOVALUE
DC78 BDDBFC           (    forth6809.asm):03049                     JSR   BLDDOES
DC7B DC0A             (    forth6809.asm):03050                     LDD   VARHERE           ; PFA = VARHERE (writable space)
DC7D 3606             (    forth6809.asm):03051                     PSHU  D                 ; See bugfix: VALUEW.1
DC7F BDDB27           (    forth6809.asm):03052                     JSR   CODECOMMA
DC82 BDDB39           (    forth6809.asm):03053                     JSR   VCOMMAW           ; store x in the variable area
DC85 39               (    forth6809.asm):03054                     RTS
                      (    forth6809.asm):03055         
                      (    forth6809.asm):03056         ; ------------------------------------------------------------
                      (    forth6809.asm):03057         ; Behaviour of a 2VALUE word: fetch the two-cell value, x2 at the
                      (    forth6809.asm):03058         ; lower address as 2@ expects.
                      (    forth6809.asm):03059         ; DO2VALUE   ( pfa -- x1 x2 )
                      (    forth6809.asm):03060         ; ------------------------------------------------------------
DC86 7EF211           (    forth6809.asm):03061         DO2VALUE:   JMP   TWOFETCHW
                      (    forth6809.asm):03062         
                      (    forth6809.asm):03063         ; ------------------------------------------------------------
                      (    forth6809.asm):03064         ; 2VALUE  ( x1 x2 "name" -- )
                      (    forth6809.asm):03065         ; Build a word that returns x1 x2, which can be changed with TO. The
                      (    forth6809.asm):03066         ; two cells are kept in the variable area so that they are writable.
                      (    forth6809.asm):03067         ; ------------------------------------------------------------
DC89 CCDC86           (    forth6809.asm):03068         TWOVALUEW:  LDD   #DO2VALUE
DC8C BDDBFC           (    forth6809.asm):03069                     JSR   BLDDOES
DC8F DC0A             (    forth6809.asm):03070                     LDD   VARHERE           ; PFA = VARHERE (writable space)
DC91 3606             (    forth6809.asm):03071                     PSHU  D
DC93 BDDB27           (    forth6809.asm):03072                     JSR   CODECOMMA
DC96 BDDB39           (    forth6809.asm):03073                     JSR   VCOMMAW           ; x2 at the lower address
DC99 BDDB39           (    forth6809.asm):03074                     JSR   VCOMMAW           ; then x1
DC9C 39               (    forth6809.asm):03075                     RTS
                      (    forth6809.asm):03076         
                      (    forth6809.asm):03077         ; ------------------------------------------------------------
                      (    forth6809.asm):03078         ; TO  ( x "name" -- )  IMMEDIATE
                      (    forth6809.asm):03079         ; Store x in the named VALUE. When compiling, instead compile code to
                      (    forth6809.asm):03080         ; store a run-time x in it. Error -13 if the name is not found.
                      (    forth6809.asm):03081         ; ------------------------------------------------------------
DC9D CC0020           (    forth6809.asm):03082         TOW:        LDD   #32
DCA0 3606             (    forth6809.asm):03083                     PSHU  D
DCA2 BDDEB6           (    forth6809.asm):03084                     JSR   WORDW
DCA5 BDDF9F           (    forth6809.asm):03085                     JSR   FINDW
DCA8 3706             (    forth6809.asm):03086                     PULU  D
DCAA 10830000         (    forth6809.asm):03087                     CMPD  #0
DCAE 260A             (    forth6809.asm):03088                     BNE   TOFOUND
DCB0 3706             (    forth6809.asm):03089                     PULU  D
DCB2 CCFFF3           (    forth6809.asm):03090                     LDD   #-13

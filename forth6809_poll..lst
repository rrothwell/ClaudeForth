                      (    forth6809.asm):07349         ; CSTRCOMP   ( c-addr u -- )
                      (    forth6809.asm):07350         ;    Inputs:
                      (    forth6809.asm):07351         ;        RegD = xt of the run-time word (DOSTR, DOTSTR, DOABORTQUOTE)
                      (    forth6809.asm):07352         ;        c-addr u on the data stack
                      (    forth6809.asm):07353         ;    Outputs:
                      (    forth6809.asm):07354         ;        JSR xt, the count byte and the text compiled at CODEHERE
                      (    forth6809.asm):07355         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):07356         ; ------------------------------------------------------------
F2AE 3606             (    forth6809.asm):07357         CSTRCOMP:   PSHU  D

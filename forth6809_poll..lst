E2B6 CCFFFF           (    forth6809.asm):04170                     LDD   #-1
E2B9 3606             (    forth6809.asm):04171                     PSHU  D
E2BB 39               (    forth6809.asm):04172                     RTS
                      (    forth6809.asm):04173         
E2BC 3348             (    forth6809.asm):04174         NQBADF:     LEAU  8,U               ; drop the frame
E2BE AEE4             (    forth6809.asm):04175         NQBAD:      LDX   ,S
E2C0 3263             (    forth6809.asm):04176                     LEAS  3,S
E2C2 3610             (    forth6809.asm):04177                     PSHU  X
E2C4 CC0000           (    forth6809.asm):04178                     LDD   #0
E2C7 3606             (    forth6809.asm):04179                     PSHU  D
E2C9 39               (    forth6809.asm):04180                     RTS

                      (    forth6809.asm):08841         ; ENVTABLE2
                      (    forth6809.asm):08842         ; Double-cell ENVIRONMENT? entries: name address, name length, low
                      (    forth6809.asm):08843         ; cell, high cell. A zero ends the table.
                      (    forth6809.asm):08844         ; ------------------------------------------------------------
FB7A                  (    forth6809.asm):08845         ENVTABLE2:

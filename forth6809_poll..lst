                      (    forth6809.asm):07224         ; CMOVE  ( c-addr1 c-addr2 u -- )
                      (    forth6809.asm):07225         ; Copy u bytes from c-addr1 to c-addr2, starting at the low addresses.
                      (    forth6809.asm):07226         ; ------------------------------------------------------------
F227 ECC4             (    forth6809.asm):07227         CMOVEW:     LDD   ,U                ; u. Parameters stay on the data stack,
F229 2713             (    forth6809.asm):07228                     BEQ   CMDONE            ; addressed relative to U: u at 0, c-addr2
F22B AE44             (    forth6809.asm):07229                     LDX   4,U               ; at 2, c-addr1 at 4. See shadow CMOVEW.2
F22D 308B             (    forth6809.asm):07230                     LEAX  D,X               ; end address = c-addr1 + u

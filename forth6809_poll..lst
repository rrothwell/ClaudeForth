                      (    forth6809.asm):05494         ; ============================================================
                      (    forth6809.asm):05495         ; SECTION 14: STACK MANIPULATION (Core + Core Ext + return stack)
                      (    forth6809.asm):05496         ; ============================================================
                      (    forth6809.asm):05497         ; ------------------------------------------------------------
                      (    forth6809.asm):05498         ; DUP  ( x -- x x )
                      (    forth6809.asm):05499         ; Duplicate the top cell.
                      (    forth6809.asm):05500         ; ------------------------------------------------------------
E973 ECC4             (    forth6809.asm):05501         DUPW:       LDD   ,U                ; x
E975 3606             (    forth6809.asm):05502                     PSHU  D
E977 39               (    forth6809.asm):05503                     RTS
                      (    forth6809.asm):05504         
                      (    forth6809.asm):05505         ; ------------------------------------------------------------
                      (    forth6809.asm):05506         ; DROP  ( x -- )
                      (    forth6809.asm):05507         ; Discard the top cell.
                      (    forth6809.asm):05508         ; ------------------------------------------------------------
E978 3342             (    forth6809.asm):05509         DROPW:      LEAU  2,U               ; x
E97A 39               (    forth6809.asm):05510                     RTS
                      (    forth6809.asm):05511         
                      (    forth6809.asm):05512         ; ------------------------------------------------------------
                      (    forth6809.asm):05513         ; SWAP  ( x1 x2 -- x2 x1 )
                      (    forth6809.asm):05514         ; Exchange the top two cells.

DCF1 7EF21C           (    forth6809.asm):03117         TOTWOIMM:   JMP   TWOSTOREW
                      (    forth6809.asm):03118         
                      (    forth6809.asm):03119         ; ------------------------------------------------------------
                      (    forth6809.asm):03120         ; 2VARIABLE  ( "name" -- )
                      (    forth6809.asm):03121         ; Build a word that returns the address of a new two-cell variable in

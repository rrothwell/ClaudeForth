                      (    forth6809.asm):05096         ;        address
                      (    forth6809.asm):05097         ;    Outputs:
                      (    forth6809.asm):05098         ;        returns to the caller of the definition
                      (    forth6809.asm):05099         ;    Registers: RegX and RegY changed.
                      (    forth6809.asm):05100         ; ------------------------------------------------------------

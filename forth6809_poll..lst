                      (    forth6809.asm):04544         ; ============================================================
                      (    forth6809.asm):04545         ; SECTION 12: CONTROL FLOW (IF/THEN/ELSE, BEGIN family,
                      (    forth6809.asm):04546         ; DO/LOOP/+LOOP/I/J/LEAVE/UNLOOP/?DO, EXIT, CASE family)
                      (    forth6809.asm):04547         ; ============================================================
                      (    forth6809.asm):04548         ; ------------------------------------------------------------
                      (    forth6809.asm):04549         ; Store a branch displacement: the cell at location receives target -
                      (    forth6809.asm):04550         ; location.
                      (    forth6809.asm):04551         ; PATCH   ( target location -- )
                      (    forth6809.asm):04552         ;    Inputs:
                      (    forth6809.asm):04553         ;        target and location on the data stack (location on top)
                      (    forth6809.asm):04554         ;    Outputs:
                      (    forth6809.asm):04555         ;        the cell at location holds target - location
                      (    forth6809.asm):04556         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):04557         ; ------------------------------------------------------------
E438 3710             (    forth6809.asm):04558         PATCH:      PULU  X                 ; location
E43A 3706             (    forth6809.asm):04559                     PULU  D                 ; target
E43C 3410             (    forth6809.asm):04560                     PSHS  X
E43E A3E1             (    forth6809.asm):04561                     SUBD  ,S++              ; target - location
E440 ED84             (    forth6809.asm):04562                     STD   ,X
E442 39               (    forth6809.asm):04563                     RTS

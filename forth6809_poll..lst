                      (    forth6809.asm):04452         ; ============================================================
                      (    forth6809.asm):04453         ; SECTION 11: EXCEPTIONS (CFERR, CATCH, THROW)
                      (    forth6809.asm):04454         ; ============================================================
                      (    forth6809.asm):04455         ; ------------------------------------------------------------
                      (    forth6809.asm):04456         ; Report a control-structure mismatch: throw -22. Called by the
                      (    forth6809.asm):04457         ; control-flow words when the tag on the control-flow stack is not the
                      (    forth6809.asm):04458         ; one expected.
                      (    forth6809.asm):04459         ; CFERR
                      (    forth6809.asm):04460         ;    Inputs:
                      (    forth6809.asm):04461         ;        none
                      (    forth6809.asm):04462         ;    Outputs:
                      (    forth6809.asm):04463         ;        does not return (THROW -22)
                      (    forth6809.asm):04464         ;    Registers: RegD changed; THROW decides the rest.
                      (    forth6809.asm):04465         ; ------------------------------------------------------------
E3CE CCFFEA           (    forth6809.asm):04466         CFERR:      LDD   #-22
E3D1 3606             (    forth6809.asm):04467                     PSHU  D                 ; -22
E3D3 BDE403           (    forth6809.asm):04468                     JSR   THROWW
E3D6 39               (    forth6809.asm):04469                     RTS
                      (    forth6809.asm):04470         
                      (    forth6809.asm):04471         ; ------------------------------------------------------------
                      (    forth6809.asm):04472         ; CATCH  ( i*x xt -- j*x 0 | i*x n )
                      (    forth6809.asm):04473         ; Execute xt with an exception frame in place. On normal return push
                      (    forth6809.asm):04474         ; 0. If xt (or anything it calls) executes THROW with a non-zero n,
                      (    forth6809.asm):04475         ; THROW unwinds to this frame and CATCH returns n.
                      (    forth6809.asm):04476         ; Frame on S, top first: >IN, SRCID, SRCLEN, SRCADDR, saved U,
                      (    forth6809.asm):04477         ; previous HANDLER. HANDLER points at the >IN cell.
                      (    forth6809.asm):04478         ; ------------------------------------------------------------
E3D7 3710             (    forth6809.asm):04479         CATCHW:     PULU  X                 ; xt
E3D9 DC0C             (    forth6809.asm):04480                     LDD   HANDLER
E3DB 3406             (    forth6809.asm):04481                     PSHS  D
E3DD 3440             (    forth6809.asm):04482                     PSHS  U
                      (    forth6809.asm):04483                     ; Save the input source specification.
                      (    forth6809.asm):04484                     ; See bugfix: CATCHW.1
E3DF DC39             (    forth6809.asm):04485                     LDD   SRCADDR
E3E1 3406             (    forth6809.asm):04486                     PSHS  D
E3E3 DC3B             (    forth6809.asm):04487                     LDD   SRCLEN
E3E5 3406             (    forth6809.asm):04488                     PSHS  D
E3E7 DC3D             (    forth6809.asm):04489                     LDD   SRCID
E3E9 3406             (    forth6809.asm):04490                     PSHS  D
E3EB DC10             (    forth6809.asm):04491                     LDD   TOIN
E3ED 3406             (    forth6809.asm):04492                     PSHS  D
E3EF 1F40             (    forth6809.asm):04493                     TFR   S,D
E3F1 DD0C             (    forth6809.asm):04494                     STD   HANDLER
                      (    forth6809.asm):04495         
E3F3 AD84             (    forth6809.asm):04496                     JSR   ,X
                      (    forth6809.asm):04497         
E3F5 3268             (    forth6809.asm):04498                     LEAS  8,S               ; drop saved input source
E3F7 3262             (    forth6809.asm):04499                     LEAS  2,S               ; saved U
E3F9 3506             (    forth6809.asm):04500                     PULS  D
E3FB DD0C             (    forth6809.asm):04501                     STD   HANDLER
E3FD CC0000           (    forth6809.asm):04502                     LDD   #0
E400 3606             (    forth6809.asm):04503                     PSHU  D                 ; 0 = no exception
E402 39               (    forth6809.asm):04504                     RTS
                      (    forth6809.asm):04505         
                      (    forth6809.asm):04506         ; ------------------------------------------------------------
                      (    forth6809.asm):04507         ; THROW  ( k*x n -- k*x | i*x n )
                      (    forth6809.asm):04508         ; If n is zero, do nothing. Otherwise restore the state saved by the
                      (    forth6809.asm):04509         ; most recent CATCH (S, U, input source, >IN, HANDLER) and make that
                      (    forth6809.asm):04510         ; CATCH return n. With no CATCH active, push n and ABORT.
                      (    forth6809.asm):04511         ; ------------------------------------------------------------
E403 3706             (    forth6809.asm):04512         THROWW:     PULU  D                 ; n
E405 10830000         (    forth6809.asm):04513                     CMPD  #0
E409 2725             (    forth6809.asm):04514                     BEQ   THDONE
                      (    forth6809.asm):04515         
E40B DD0E             (    forth6809.asm):04516                     STD   THROWN
E40D 9E0C             (    forth6809.asm):04517                     LDX   HANDLER
E40F 2720             (    forth6809.asm):04518                     BEQ   THUNCAU
                      (    forth6809.asm):04519         
E411 1F14             (    forth6809.asm):04520                     TFR   X,S
E413 3506             (    forth6809.asm):04521                     PULS  D                 ; restore input source saved by CATCH
E415 DD10             (    forth6809.asm):04522                     STD   TOIN
E417 3506             (    forth6809.asm):04523                     PULS  D
E419 DD3D             (    forth6809.asm):04524                     STD   SRCID
E41B 3506             (    forth6809.asm):04525                     PULS  D
E41D DD3B             (    forth6809.asm):04526                     STD   SRCLEN
E41F 3506             (    forth6809.asm):04527                     PULS  D
E421 DD39             (    forth6809.asm):04528                     STD   SRCADDR
E423 3506             (    forth6809.asm):04529                     PULS  D
E425 1F03             (    forth6809.asm):04530                     TFR   D,U
E427 3506             (    forth6809.asm):04531                     PULS  D
E429 DD0C             (    forth6809.asm):04532                     STD   HANDLER
                      (    forth6809.asm):04533         
E42B DC0E             (    forth6809.asm):04534                     LDD   THROWN
E42D 3606             (    forth6809.asm):04535                     PSHU  D
E42F 39               (    forth6809.asm):04536                     RTS
E430 39               (    forth6809.asm):04537         THDONE:     RTS
                      (    forth6809.asm):04538         
                      (    forth6809.asm):04539                     ; No CATCH is active: leave n on the stack and ABORT.
E431 DC0E             (    forth6809.asm):04540         THUNCAU:    LDD   THROWN

                      (    forth6809.asm):04700         
                      (    forth6809.asm):04701         ; ------------------------------------------------------------
                      (    forth6809.asm):04702         ; REPEAT  ( C: orig dest -- )
                      (    forth6809.asm):04703         ; Compile BRANCH back to the BEGIN address and resolve the WHILE
                      (    forth6809.asm):04704         ; branch to just after it. A BEGIN frame beneath further open WHILE
                      (    forth6809.asm):04705         ; frames is found by scanning, and removed from beneath them.
                      (    forth6809.asm):04706         ; ------------------------------------------------------------
E529 3706             (    forth6809.asm):04707         REPEATW:    PULU  D
E52B 10830001         (    forth6809.asm):04708                     CMPD  #TAGFWD
E52F 2703             (    forth6809.asm):04709                     BEQ   RPOK1
E531 BDE3CE           (    forth6809.asm):04710                     JSR   CFERR
E534 3710             (    forth6809.asm):04711         RPOK1:      PULU  X                 ; orig
E536 3410             (    forth6809.asm):04712                     PSHS  X                 ; 2,S = orig (5k: S-frame)
                      (    forth6809.asm):04713         
                      (    forth6809.asm):04714                     ; Find the BEGIN frame, scanning past any open TAGFWD frames.
                      (    forth6809.asm):04715                     ; See bugfix: REPEATW.1
E538 3040             (    forth6809.asm):04716                     LEAX  0,U               ; scan from top of control stack
E53A 9F16             (    forth6809.asm):04717                     STX   MSCR2             ; MSCR2 = base of scan region
E53C 9F1A             (    forth6809.asm):04718                     STX   MSCR4             ; MSCR4 = scan pointer
E53E DC1A             (    forth6809.asm):04719         RPSCAN:     LDD   MSCR4
E540 109321           (    forth6809.asm):04720                     CMPD  CSP
E543 2603             (    forth6809.asm):04721                     BNE   RPSCANOK
E545 BDE3CE           (    forth6809.asm):04722                     JSR   CFERR             ; no matching BEGIN
E548 9E1A             (    forth6809.asm):04723         RPSCANOK:   LDX   MSCR4
E54A EC84             (    forth6809.asm):04724                     LDD   ,X
E54C 10830002         (    forth6809.asm):04725                     CMPD  #TAGBACK
E550 2712             (    forth6809.asm):04726                     BEQ   RPFOUND
E552 10830001         (    forth6809.asm):04727                     CMPD  #TAGFWD
E556 2703             (    forth6809.asm):04728                     BEQ   RPSKIP
E558 BDE3CE           (    forth6809.asm):04729                     JSR   CFERR             ; anything else is a genuine mismatch
E55B DC1A             (    forth6809.asm):04730         RPSKIP:     LDD   MSCR4
E55D C30004           (    forth6809.asm):04731                     ADDD  #4
E560 DD1A             (    forth6809.asm):04732                     STD   MSCR4
E562 20DA             (    forth6809.asm):04733                     BRA   RPSCAN
E564 9E1A             (    forth6809.asm):04734         RPFOUND:    LDX   MSCR4             ; X = found BEGIN frame
E566 EC02             (    forth6809.asm):04735                     LDD   2,X               ; dest = BEGIN's address
E568 3406             (    forth6809.asm):04736                     PSHS  D                 ; 0,S = dest
                      (    forth6809.asm):04737         
                      (    forth6809.asm):04738                     ; Close the gap: move the frames above the BEGIN frame down 4
                      (    forth6809.asm):04739                     ; bytes, highest word first.
E56A DC1A             (    forth6809.asm):04740                     LDD   MSCR4
E56C 9316             (    forth6809.asm):04741                     SUBD  MSCR2
E56E DD18             (    forth6809.asm):04742                     STD   MSCR3             ; MSCR3 = bytes to shift
E570 2715             (    forth6809.asm):04743                     BEQ   RPSHIFTDONE
E572 DC18             (    forth6809.asm):04744         RPSHIFT:    LDD   MSCR3
E574 830002           (    forth6809.asm):04745                     SUBD  #2
E577 DD18             (    forth6809.asm):04746                     STD   MSCR3
E579 9E16             (    forth6809.asm):04747                     LDX   MSCR2
E57B 308B             (    forth6809.asm):04748                     LEAX  D,X               ; X = MSCR2 + this pass's offset
E57D EC84             (    forth6809.asm):04749                     LDD   ,X
E57F 3004             (    forth6809.asm):04750                     LEAX  4,X
E581 ED84             (    forth6809.asm):04751                     STD   ,X                ; copy one word 4 bytes higher
E583 DC18             (    forth6809.asm):04752                     LDD   MSCR3
E585 26EB             (    forth6809.asm):04753                     BNE   RPSHIFT
E587                  (    forth6809.asm):04754         RPSHIFTDONE:
E587 9E16             (    forth6809.asm):04755                     LDX   MSCR2
E589 3004             (    forth6809.asm):04756                     LEAX  4,X
E58B 1F13             (    forth6809.asm):04757                     TFR   X,U               ; U now excludes BEGIN frame
                      (    forth6809.asm):04758         
E58D CCDAA0           (    forth6809.asm):04759                     LDD   #BRANCH
E590 3606             (    forth6809.asm):04760                     PSHU  D
E592 BDE83E           (    forth6809.asm):04761                     JSR   CCALL
E595 CC0000           (    forth6809.asm):04762                     LDD   #0
E598 3606             (    forth6809.asm):04763                     PSHU  D
E59A BDDB27           (    forth6809.asm):04764                     JSR   CODECOMMA
E59D EC60             (    forth6809.asm):04765                     LDD   0,S               ; target = BEGIN's address
E59F 3606             (    forth6809.asm):04766                     PSHU  D
E5A1 DC08             (    forth6809.asm):04767                     LDD   CODEHERE
E5A3 830002           (    forth6809.asm):04768                     SUBD  #2                ; location = the operand just compiled
E5A6 3606             (    forth6809.asm):04769                     PSHU  D
E5A8 BDE438           (    forth6809.asm):04770                     JSR   PATCH
E5AB DC08             (    forth6809.asm):04771                     LDD   CODEHERE
E5AD 3606             (    forth6809.asm):04772                     PSHU  D
E5AF EC62             (    forth6809.asm):04773                     LDD   2,S               ; orig
E5B1 3606             (    forth6809.asm):04774                     PSHU  D
E5B3 BDE438           (    forth6809.asm):04775                     JSR   PATCH
E5B6 3264             (    forth6809.asm):04776                     LEAS  4,S               ; drop the frame
E5B8 39               (    forth6809.asm):04777                     RTS
                      (    forth6809.asm):04778         
                      (    forth6809.asm):04779         ; ------------------------------------------------------------
                      (    forth6809.asm):04780         ; RECURSE  ( -- )
                      (    forth6809.asm):04781         ; Compile a call to the word being defined (named or :NONAME), using
                      (    forth6809.asm):04782         ; the xt held in CURXT.
                      (    forth6809.asm):04783         ; ------------------------------------------------------------
E5B9 DC1F             (    forth6809.asm):04784         RECURSEW:   LDD   CURXT             ; xt of word being compiled
E5BB 3606             (    forth6809.asm):04785                     PSHU  D                 ; See bugfix: RECURSEW.1
E5BD BDE83E           (    forth6809.asm):04786                     JSR   CCALL
E5C0 39               (    forth6809.asm):04787                     RTS
                      (    forth6809.asm):04788         
                      (    forth6809.asm):04789         ; ------------------------------------------------------------
                      (    forth6809.asm):04790         ; DO  ( C: -- dest )
                      (    forth6809.asm):04791         ; Compile a call to DOSETUP and leave the loop start address and TAGDO
                      (    forth6809.asm):04792         ; on the control-flow stack for LOOP or +LOOP.
                      (    forth6809.asm):04793         ; ------------------------------------------------------------
E5C1 CCE5D3           (    forth6809.asm):04794         DOW:        LDD   #DOSETUP
E5C4 3606             (    forth6809.asm):04795                     PSHU  D
E5C6 BDE83E           (    forth6809.asm):04796                     JSR   CCALL
E5C9 DC08             (    forth6809.asm):04797                     LDD   CODEHERE
E5CB 3606             (    forth6809.asm):04798                     PSHU  D                 ; dest
E5CD CC0003           (    forth6809.asm):04799                     LDD   #TAGDO

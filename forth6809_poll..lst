                      (    forth6809.asm):08328         ; ------------------------------------------------------------
                      (    forth6809.asm):08329         ; Divide the unsigned double on the data stack (high cell at 0,U, low
                      (    forth6809.asm):08330         ; cell at 2,U) by BASE (restoring division, 32 iterations). Only the
                      (    forth6809.asm):08331         ; low byte of BASE is used.
                      (    forth6809.asm):08332         ; UDDIGIT

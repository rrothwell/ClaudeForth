E220 200C             (    forth6809.asm):04060                     BRA   NLGOT
E222 84DF             (    forth6809.asm):04061         NLALPHA:    ANDA  #$DF
E224 8141             (    forth6809.asm):04062                     CMPA  #'A'
E226 251E             (    forth6809.asm):04063                     BLO   NLDONE
E228 815A             (    forth6809.asm):04064                     CMPA  #'Z'
E22A 221A             (    forth6809.asm):04065                     BHI   NLDONE
E22C 8037             (    forth6809.asm):04066                     SUBA  #'A'-10
E22E 9103             (    forth6809.asm):04067         NLGOT:      CMPA  BASE+1
E230 2414             (    forth6809.asm):04068                     BHS   NLDONE
E232 1F89             (    forth6809.asm):04069                     TFR   A,B

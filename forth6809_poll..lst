                      (    forth6809.asm):03184         
                      (    forth6809.asm):03185         ; ------------------------------------------------------------
                      (    forth6809.asm):03186         ; DEFER  ( "name" -- )
                      (    forth6809.asm):03187         ; Build a deferred word. Until IS stores an xt in it, executing it
                      (    forth6809.asm):03188         ; throws -21.
                      (    forth6809.asm):03189         ; ------------------------------------------------------------
DD5F CCDAD0           (    forth6809.asm):03190         DEFERW:     LDD   #DODEFER
DD62 BDDC16           (    forth6809.asm):03191                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
DD65 CCDAD8           (    forth6809.asm):03192                     LDD   #DOABORTUNDEF
DD68 3606             (    forth6809.asm):03193                     PSHU  D
DD6A BDDB21           (    forth6809.asm):03194                     JSR   COMMAW
DD6D 39               (    forth6809.asm):03195                     RTS
                      (    forth6809.asm):03196         
                      (    forth6809.asm):03197         ; ------------------------------------------------------------
                      (    forth6809.asm):03198         ; DEFER@  ( xt1 -- xt2 )
                      (    forth6809.asm):03199         ; Return the xt currently stored in the deferred word xt1.
                      (    forth6809.asm):03200         ; ------------------------------------------------------------
DD6E                  (    forth6809.asm):03201         DEFERFETCHW:
DD6E BDE8FF           (    forth6809.asm):03202                     JSR   TOBODYW
DD71 3710             (    forth6809.asm):03203                     PULU  X                 ; body address
DD73 EC84             (    forth6809.asm):03204                     LDD   ,X
DD75 3606             (    forth6809.asm):03205                     PSHU  D                 ; xt2
DD77 39               (    forth6809.asm):03206                     RTS
                      (    forth6809.asm):03207         
                      (    forth6809.asm):03208         ; ------------------------------------------------------------
                      (    forth6809.asm):03209         ; DEFER!  ( xt2 xt1 -- )
                      (    forth6809.asm):03210         ; Store xt2 as the action of the deferred word xt1.
                      (    forth6809.asm):03211         ; ------------------------------------------------------------
DD78                  (    forth6809.asm):03212         DEFERSTOREW:
DD78 BDE8FF           (    forth6809.asm):03213                     JSR   TOBODYW
DD7B 3710             (    forth6809.asm):03214                     PULU  X                 ; body address of xt1
DD7D 3706             (    forth6809.asm):03215                     PULU  D                 ; xt2
DD7F ED84             (    forth6809.asm):03216                     STD   ,X
DD81 39               (    forth6809.asm):03217                     RTS
                      (    forth6809.asm):03218         
                      (    forth6809.asm):03219         ; ------------------------------------------------------------
                      (    forth6809.asm):03220         ; IS  ( xt "name" -- )  IMMEDIATE
                      (    forth6809.asm):03221         ; Store xt as the action of the named deferred word. When compiling,
                      (    forth6809.asm):03222         ; compile code to do so at run time. Error -13 if the name is not
                      (    forth6809.asm):03223         ; found.
                      (    forth6809.asm):03224         ; ------------------------------------------------------------
DD82 CC0020           (    forth6809.asm):03225         ISW:        LDD   #32
DD85 3606             (    forth6809.asm):03226                     PSHU  D
DD87 BDDEB6           (    forth6809.asm):03227                     JSR   WORDW

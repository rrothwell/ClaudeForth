E212 AE42             (    forth6809.asm):04053                     LDX   2,U
E214 A684             (    forth6809.asm):04054                     LDA   ,X
E216 8130             (    forth6809.asm):04055                     CMPA  #'0'
E218 252C             (    forth6809.asm):04056                     BLO   NLDONE
E21A 8139             (    forth6809.asm):04057                     CMPA  #'9'

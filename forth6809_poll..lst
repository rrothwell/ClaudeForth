FB39 EC84             (    forth6809.asm):08807         ENV2LOOP:   LDD   ,X
FB3B 10830000         (    forth6809.asm):08808                     CMPD  #0
FB3F 2731             (    forth6809.asm):08809                     BEQ   ENVNOTFOUND
FB41 3410             (    forth6809.asm):08810                     PSHS  X                 ; See bugfix: ENVQW.2
FB43 3606             (    forth6809.asm):08811                     PSHU  D
FB45 EC02             (    forth6809.asm):08812                     LDD   2,X
FB47 3606             (    forth6809.asm):08813                     PSHU  D
FB49 EC62             (    forth6809.asm):08814                     LDD   2,S               ; c-addr
FB4B 3606             (    forth6809.asm):08815                     PSHU  D
FB4D EC64             (    forth6809.asm):08816                     LDD   4,S               ; u
FB4F 3606             (    forth6809.asm):08817                     PSHU  D
FB51 BDF542           (    forth6809.asm):08818                     JSR   COMPAREW
FB54 3510             (    forth6809.asm):08819                     PULS  X
FB56 3706             (    forth6809.asm):08820                     PULU  D
FB58 10830000         (    forth6809.asm):08821                     CMPD  #0
FB5C 2704             (    forth6809.asm):08822                     BEQ   ENV2FOUND
FB5E 3008             (    forth6809.asm):08823                     LEAX  8,X               ; 8-byte entries
FB60 20D7             (    forth6809.asm):08824                     BRA   ENV2LOOP

                      (    forth6809.asm):04951         ; ------------------------------------------------------------
                      (    forth6809.asm):04952         ; Run-time end of +LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):04953         ; the back-branch operand. Add the step to the index. If the leave
                      (    forth6809.asm):04954         ; flag is set or the index crossed the limit, discard the loop frame
                      (    forth6809.asm):04955         ; and skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):04956         ; DOPLUSTEST   ( n -- )
                      (    forth6809.asm):04957         ;    Inputs:
                      (    forth6809.asm):04958         ;        step n on the data stack; S as for DOTEST
                      (    forth6809.asm):04959         ;    Outputs:
                      (    forth6809.asm):04960         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):04961         ;    Registers: RegD and RegX changed; MSCR, MSCR2 and MSCR3 used as
                      (    forth6809.asm):04962         ;        scratch.
                      (    forth6809.asm):04963         ; ------------------------------------------------------------
E69D 3706             (    forth6809.asm):04964         DOPLUSTEST: PULU  D                 ; n = step. See bugfix: DOPLUSTEST.1
E69F DD14             (    forth6809.asm):04965                     STD   MSCR              ; MSCR = step
E6A1 EC66             (    forth6809.asm):04966                     LDD   6,S               ; leave flag. See bugfix: DOPLUSTEST.2
E6A3 262D             (    forth6809.asm):04967                     BNE   DPTEXIT           ; set: exit
E6A5 EC62             (    forth6809.asm):04968                     LDD   2,S               ; old index
E6A7 A364             (    forth6809.asm):04969                     SUBD  4,S               ; old_u = old_index - limit, mod 65536
E6A9 DD16             (    forth6809.asm):04970                     STD   MSCR2
E6AB EC62             (    forth6809.asm):04971                     LDD   2,S
E6AD D314             (    forth6809.asm):04972                     ADDD  MSCR              ; new_index = old_index + step
E6AF ED62             (    forth6809.asm):04973                     STD   2,S
E6B1 A364             (    forth6809.asm):04974                     SUBD  4,S               ; new_u = new_index - limit, mod 65536
E6B3 DD18             (    forth6809.asm):04975                     STD   MSCR3
                      (    forth6809.asm):04976                     ; Crossing test on the unsigned distances old_u and new_u: with a
                      (    forth6809.asm):04977                     ; positive step the limit was crossed if new_u < old_u, with a
                      (    forth6809.asm):04978                     ; negative step if new_u > old_u. See bugfix: DOPLUSTEST.3
E6B5 DC14             (    forth6809.asm):04979                     LDD   MSCR              ; reload the step to test its sign
E6B7 2B09             (    forth6809.asm):04980                     BMI   DPNEG
E6B9 DC18             (    forth6809.asm):04981         DPPOS:      LDD   MSCR3             ; step > 0: crossed if new_u < old_u
E6BB 109316           (    forth6809.asm):04982                     CMPD  MSCR2
E6BE 2512             (    forth6809.asm):04983                     BLO   DPTEXIT
E6C0 2007             (    forth6809.asm):04984                     BRA   DPCONT
E6C2 DC18             (    forth6809.asm):04985         DPNEG:      LDD   MSCR3             ; step < 0: crossed if new_u > old_u
E6C4 109316           (    forth6809.asm):04986                     CMPD  MSCR2
E6C7 2209             (    forth6809.asm):04987                     BHI   DPTEXIT
E6C9 3510             (    forth6809.asm):04988         DPCONT:     PULS  X                 ; X = branch operand address
E6CB EC84             (    forth6809.asm):04989                     LDD   ,X
E6CD 308B             (    forth6809.asm):04990                     LEAX  D,X
E6CF 3410             (    forth6809.asm):04991                     PSHS  X
E6D1 39               (    forth6809.asm):04992                     RTS
E6D2 3510             (    forth6809.asm):04993         DPTEXIT:    PULS  X
E6D4 3002             (    forth6809.asm):04994                     LEAX  2,X               ; skip the branch operand
E6D6 3266             (    forth6809.asm):04995                     LEAS  6,S               ; discard the loop frame
E6D8 3410             (    forth6809.asm):04996                     PSHS  X
E6DA 39               (    forth6809.asm):04997                     RTS

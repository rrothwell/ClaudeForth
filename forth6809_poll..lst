E97D AE42             (    forth6809.asm):05517                     LDX   2,U               ; x1
E97F AFC4             (    forth6809.asm):05518                     STX   ,U
E981 ED42             (    forth6809.asm):05519                     STD   2,U
E983 39               (    forth6809.asm):05520                     RTS
                      (    forth6809.asm):05521         
                      (    forth6809.asm):05522         ; ------------------------------------------------------------
                      (    forth6809.asm):05523         ; OVER  ( x1 x2 -- x1 x2 x1 )
                      (    forth6809.asm):05524         ; Copy the second cell to the top.
                      (    forth6809.asm):05525         ; ------------------------------------------------------------
E984 EC42             (    forth6809.asm):05526         OVERW:      LDD   2,U               ; x1
E986 3606             (    forth6809.asm):05527                     PSHU  D
E988 39               (    forth6809.asm):05528                     RTS
                      (    forth6809.asm):05529         
                      (    forth6809.asm):05530         ; ------------------------------------------------------------
                      (    forth6809.asm):05531         ; ROT  ( x1 x2 x3 -- x2 x3 x1 )
                      (    forth6809.asm):05532         ; Rotate the third cell to the top.
                      (    forth6809.asm):05533         ; ------------------------------------------------------------
E989 ECC4             (    forth6809.asm):05534         ROTW:       LDD   ,U                ; x3
E98B AE42             (    forth6809.asm):05535                     LDX   2,U               ; x2
E98D 10AE44           (    forth6809.asm):05536                     LDY   4,U               ; x1
E990 10AFC4           (    forth6809.asm):05537                     STY   ,U
E993 ED42             (    forth6809.asm):05538                     STD   2,U
E995 AF44             (    forth6809.asm):05539                     STX   4,U
E997 39               (    forth6809.asm):05540                     RTS
                      (    forth6809.asm):05541         
                      (    forth6809.asm):05542         ; ------------------------------------------------------------
                      (    forth6809.asm):05543         ; ?DUP  ( x -- 0 | x x )
                      (    forth6809.asm):05544         ; Duplicate the top cell if it is non-zero.
                      (    forth6809.asm):05545         ; ------------------------------------------------------------
E998 ECC4             (    forth6809.asm):05546         QDUPW:      LDD   ,U                ; x
E99A 10830000         (    forth6809.asm):05547                     CMPD  #0
E99E 2702             (    forth6809.asm):05548                     BEQ   QDUPDONE
E9A0 3606             (    forth6809.asm):05549                     PSHU  D
E9A2 39               (    forth6809.asm):05550         QDUPDONE:   RTS
                      (    forth6809.asm):05551         
                      (    forth6809.asm):05552         ; ------------------------------------------------------------
                      (    forth6809.asm):05553         ; DEPTH  ( -- +n )

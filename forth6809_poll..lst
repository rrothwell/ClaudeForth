                      (    forth6809.asm):04332         ; Wait for TDRE, then transmit char directly.
                      (    forth6809.asm):04333         ; ------------------------------------------------------------
E327 3706             (    forth6809.asm):04334         EMITW:      PULU  D                 ; char
E329 D71E             (    forth6809.asm):04335                     STB   EMITCH
E32B B6C008           (    forth6809.asm):04336         EMITWT:     LDA   ACIASR
E32E 8502             (    forth6809.asm):04337                     BITA  #SR_TDRE
E330 27F9             (    forth6809.asm):04338                     BEQ   EMITWT
E332 961E             (    forth6809.asm):04339                     LDA   EMITCH
E334 B7C009           (    forth6809.asm):04340                     STA   ACIADR
E337 39               (    forth6809.asm):04341                     RTS
                      (    forth6809.asm):04342         
                      (    forth6809.asm):04343                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):04344         
                      (    forth6809.asm):04345         ; ------------------------------------------------------------
                      (    forth6809.asm):04346         ; ACCEPT  ( c-addr +n1 -- +n2 )
                      (    forth6809.asm):04347         ; Read a line of up to +n1 characters into the buffer at c-addr,
                      (    forth6809.asm):04348         ; echoing as it goes. Backspace and DEL erase the last character; LF
                      (    forth6809.asm):04349         ; is ignored; CR ends the line. Returns the count +n2.
                      (    forth6809.asm):04350         ; ------------------------------------------------------------
E338 335E             (    forth6809.asm):04351         ACCEPTW:    LEAU  -2,U              ; local count at 0,U; then +n1 at 2,U and
E33A CC0000           (    forth6809.asm):04352                     LDD   #0                ; c-addr at 4,U. See shadow ACCEPTW.5
E33D EDC4             (    forth6809.asm):04353                     STD   ,U
                      (    forth6809.asm):04354         
                      (    forth6809.asm):04355                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: real
                      (    forth6809.asm):04356                                             ; RTS/CTS hardware flow control already
                      (    forth6809.asm):04357                                             ; covers this, nothing extra needed
                      (    forth6809.asm):04358                     ELSE                    ; <<<<<>>>>>  polling build: tell the host it's safe to
                      (    forth6809.asm):04359                                             ; stream this line's characters

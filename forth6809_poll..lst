E868 2608             (    forth6809.asm):05306                     BNE   BTSTOK
E86A CCFFF2           (    forth6809.asm):05307                     LDD   #-14              ; -14
E86D 3606             (    forth6809.asm):05308                     PSHU  D
E86F BDE403           (    forth6809.asm):05309                     JSR   THROWW

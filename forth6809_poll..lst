E8E1 3606             (    forth6809.asm):05371                     PSHU  D
E8E3 BDDEB6           (    forth6809.asm):05372                     JSR   WORDW
E8E6 BDDF9F           (    forth6809.asm):05373                     JSR   FINDW
E8E9 3706             (    forth6809.asm):05374                     PULU  D
E8EB 10830000         (    forth6809.asm):05375                     CMPD  #0
E8EF 260A             (    forth6809.asm):05376                     BNE   XCFOUND
E8F1 3706             (    forth6809.asm):05377                     PULU  D
E8F3 CCFFF3           (    forth6809.asm):05378                     LDD   #-13
E8F6 3606             (    forth6809.asm):05379                     PSHU  D
E8F8 BDE403           (    forth6809.asm):05380                     JSR   THROWW
E8FB BDE83B           (    forth6809.asm):05381         XCFOUND:    JSR   COMPILECOMMAW
E8FE 39               (    forth6809.asm):05382                     RTS

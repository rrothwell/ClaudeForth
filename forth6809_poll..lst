                      (    forth6809.asm):09253         ; Cold start, entered from the reset vector: mask interrupts, set up
                      (    forth6809.asm):09254         ; the stacks and the direct page, clear GLOBALS, initialise the ACIA,
                      (    forth6809.asm):09255         ; unmask interrupts, run the unit tests if they are built in, then
                      (    forth6809.asm):09256         ; enter COLD.
                      (    forth6809.asm):09257         ; COLDSTRT
                      (    forth6809.asm):09258         ;    Inputs:
                      (    forth6809.asm):09259         ;        hardware reset
                      (    forth6809.asm):09260         ;    Outputs:
                      (    forth6809.asm):09261         ;        does not return
                      (    forth6809.asm):09262         ;    Registers: all registers initialised.
                      (    forth6809.asm):09263         ; ------------------------------------------------------------
FFA4                  (    forth6809.asm):09264         COLDSTRT:
FFA4 1A50             (    forth6809.asm):09265                     ORCC  #$50              ; Disable IRQ & FIRQ
FFA6 10CEC000         (    forth6809.asm):09266                     LDS   #RSTACK+1
FFAA CEBD00           (    forth6809.asm):09267                     LDU   #DSTACK+1
FFAD 4F               (    forth6809.asm):09268                     CLRA
FFAE 1F8B             (    forth6809.asm):09269                     TFR   A,DP
                      (    forth6809.asm):09270         
FFB0 8E0000           (    forth6809.asm):09271                     LDX   #GLOBALS
FFB3 C600             (    forth6809.asm):09272                     LDB   #0
FFB5 6F80             (    forth6809.asm):09273         CLRGLOB:    CLR   ,X+
FFB7 5A               (    forth6809.asm):09274                     DECB
FFB8 26FB             (    forth6809.asm):09275                     BNE   CLRGLOB
                      (    forth6809.asm):09276         
FFBA BDE00C           (    forth6809.asm):09277                     JSR   WLINIT            ; FIND must work for the unit tests too
                      (    forth6809.asm):09278         
FFBD BDD97B           (    forth6809.asm):09279                     JSR   INITSERIAL
                      (    forth6809.asm):09280         
FFC0 1CAF             (    forth6809.asm):09281                     ANDCC #$AF              ; Enable IRQ & FIRQ
                      (    forth6809.asm):09282         
                      (    forth6809.asm):09283                     ; IRQ and FIRQ are unmasked above. See bugfix: COLDSTRT.1
                      (    forth6809.asm):09284         
                      (    forth6809.asm):09285                     IFNE  UNITTESTS         ; >>>>>>>>>>
                      (    forth6809.asm):09286                     JSR   TSTRUNNER
                      (    forth6809.asm):09287                     ELSE                    ; <<<<<>>>>>
FFC2 12               (    forth6809.asm):09288                     NOP                     ; same size as JSR TSTRUNNER
FFC3 12               (    forth6809.asm):09289                     NOP                     ; See bugfix: COLDSTRT.2
FFC4 12               (    forth6809.asm):09290                     NOP
                      (    forth6809.asm):09291                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):09292         

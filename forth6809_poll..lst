                      (    forth6809.asm):09106         ; ------------------------------------------------------------
                      (    forth6809.asm):09107         ; [IF]  ( flag -- )     [ELSE]  ( -- )     [THEN]  ( -- )
                      (    forth6809.asm):09108         ; Programming-Tools conditional compilation. All three are
                      (    forth6809.asm):09109         ; immediate, so they work while interpreting and while compiling.
                      (    forth6809.asm):09110         ; [IF] with a true flag does nothing. With a false flag, and for
                      (    forth6809.asm):09111         ; [ELSE], the input is skipped word by word, counting nested
                      (    forth6809.asm):09112         ; [IF]s, up to the matching [ELSE] or [THEN]. The three names are
                      (    forth6809.asm):09113         ; matched exactly, as the dictionary matches every name. If the line
                      (    forth6809.asm):09114         ; runs out, the next line is read with REFILL; if no more input is
                      (    forth6809.asm):09115         ; available the skip ends.
                      (    forth6809.asm):09116         ; [THEN] is a marker and does nothing when it is executed.
                      (    forth6809.asm):09117         ; The nesting level is kept at 0,S.
                      (    forth6809.asm):09118         ; ------------------------------------------------------------
FDAE 3706             (    forth6809.asm):09119         BRIFW:      PULU  D
FDB0 10830000         (    forth6809.asm):09120                     CMPD  #0
FDB4 266D             (    forth6809.asm):09121                     BNE   BRTHENW           ; true: nothing to skip
FDB6 CC0001           (    forth6809.asm):09122         BRELSEW:    LDD   #1
FDB9 3406             (    forth6809.asm):09123                     PSHS  D                 ; level
FDBB BDF4B5           (    forth6809.asm):09124         BRNEXT:     JSR   PARSENAMEW
FDBE 3706             (    forth6809.asm):09125                     PULU  D                 ; length
FDC0 3710             (    forth6809.asm):09126                     PULU  X                 ; address
FDC2 10830000         (    forth6809.asm):09127                     CMPD  #0
FDC6 274E             (    forth6809.asm):09128                     BEQ   BRREFILL
FDC8 10830004         (    forth6809.asm):09129                     CMPD  #4
FDCC 2734             (    forth6809.asm):09130                     BEQ   BR4
FDCE 10830006         (    forth6809.asm):09131                     CMPD  #6
FDD2 26E7             (    forth6809.asm):09132                     BNE   BRNEXT
FDD4 C606             (    forth6809.asm):09133                     LDB   #6
FDD6 108EFE32         (    forth6809.asm):09134                     LDY   #BRSELSE
FDDA 3410             (    forth6809.asm):09135                     PSHS  X
FDDC BDFE24           (    forth6809.asm):09136                     JSR   BRCMP
FDDF 3510             (    forth6809.asm):09137                     PULS  X
FDE1 2609             (    forth6809.asm):09138                     BNE   BR6B
FDE3 ECE4             (    forth6809.asm):09139                     LDD   ,S                ; [ELSE]: ends the skip at level 1
FDE5 830001           (    forth6809.asm):09140                     SUBD  #1
FDE8 2737             (    forth6809.asm):09141                     BEQ   BRDONE
FDEA 20CF             (    forth6809.asm):09142                     BRA   BRNEXT
FDEC C606             (    forth6809.asm):09143         BR6B:       LDB   #6
FDEE 108EFE38         (    forth6809.asm):09144                     LDY   #BRSTHEN
FDF2 BDFE24           (    forth6809.asm):09145                     JSR   BRCMP
FDF5 26C4             (    forth6809.asm):09146                     BNE   BRNEXT
FDF7 ECE4             (    forth6809.asm):09147                     LDD   ,S                ; [THEN]: one level less
FDF9 830001           (    forth6809.asm):09148                     SUBD  #1
FDFC EDE4             (    forth6809.asm):09149                     STD   ,S
FDFE 2721             (    forth6809.asm):09150                     BEQ   BRDONE
FE00 20B9             (    forth6809.asm):09151                     BRA   BRNEXT
FE02 C604             (    forth6809.asm):09152         BR4:        LDB   #4
FE04 108EFE2E         (    forth6809.asm):09153                     LDY   #BRSIF
FE08 BDFE24           (    forth6809.asm):09154                     JSR   BRCMP
FE0B 26AE             (    forth6809.asm):09155                     BNE   BRNEXT
FE0D ECE4             (    forth6809.asm):09156                     LDD   ,S                ; [IF]: one level more
FE0F C30001           (    forth6809.asm):09157                     ADDD  #1
FE12 EDE4             (    forth6809.asm):09158                     STD   ,S
FE14 20A5             (    forth6809.asm):09159                     BRA   BRNEXT
FE16 BDFAAD           (    forth6809.asm):09160         BRREFILL:   JSR   REFILLW
FE19 3706             (    forth6809.asm):09161                     PULU  D
FE1B 10830000         (    forth6809.asm):09162                     CMPD  #0
FE1F 269A             (    forth6809.asm):09163                     BNE   BRNEXT
FE21 3262             (    forth6809.asm):09164         BRDONE:     LEAS  2,S
FE23 39               (    forth6809.asm):09165         BRTHENW:    RTS
                      (    forth6809.asm):09166         
                      (    forth6809.asm):09167         ; Compare B characters at X with the pattern at Y. Case matters, as it
                      (    forth6809.asm):09168         ; does for every name in this system. Z is set if equal.
FE24 A680             (    forth6809.asm):09169         BRCMP:      LDA   ,X+
FE26 A1A0             (    forth6809.asm):09170                     CMPA  ,Y+
FE28 2603             (    forth6809.asm):09171                     BNE   BRCX
FE2A 5A               (    forth6809.asm):09172                     DECB
FE2B 26F7             (    forth6809.asm):09173                     BNE   BRCMP
FE2D 39               (    forth6809.asm):09174         BRCX:       RTS
                      (    forth6809.asm):09175         
FE2E 5B49465D         (    forth6809.asm):09176         BRSIF:      FCC   "[IF]"
FE32 5B454C53455D     (    forth6809.asm):09177         BRSELSE:    FCC   "[ELSE]"
FE38 5B5448454E5D     (    forth6809.asm):09178         BRSTHEN:    FCC   "[THEN]"

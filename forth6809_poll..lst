FB13 3606             (    forth6809.asm):08789                     PSHU  D
FB15 EC64             (    forth6809.asm):08790                     LDD   4,S               ; u
FB17 3606             (    forth6809.asm):08791                     PSHU  D
FB19 BDF542           (    forth6809.asm):08792                     JSR   COMPAREW
FB1C 3510             (    forth6809.asm):08793                     PULS  X                 ; restore X before using it again
FB1E 3706             (    forth6809.asm):08794                     PULU  D
FB20 10830000         (    forth6809.asm):08795                     CMPD  #0
FB24 2704             (    forth6809.asm):08796                     BEQ   ENVFOUND

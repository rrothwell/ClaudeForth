                      (    forth6809.asm):07051         ; M*/  ( d1 n1 +n2 -- d2 )
                      (    forth6809.asm):07052         ; Multiply d1 by n1 into a 48-bit intermediate product and divide it
                      (    forth6809.asm):07053         ; by n2. The quotient is truncated toward zero (like */ and symmetric
                      (    forth6809.asm):07054         ; division in this system) and its low 32 bits are returned. THROW -10
                      (    forth6809.asm):07055         ; if n2 is zero. Method: take the magnitudes; form |d1.lo|*|n1| and
                      (    forth6809.asm):07056         ; |d1.hi|*|n1| with UMUL32 and add them into three words P2:P1:P0;
                      (    forth6809.asm):07057         ; then divide P2, then R:P1, then R:P0 by |n2| with UDIV32, each a
                      (    forth6809.asm):07058         ; 32/16 division whose quotient fits in 16 bits. The sign is applied
                      (    forth6809.asm):07059         ; to the 32-bit result at the end. See shadow M*/W.1.
                      (    forth6809.asm):07060         ; M*/W
                      (    forth6809.asm):07061         ;    Inputs:
                      (    forth6809.asm):07062         ;        d1 n1 n2 on the data stack (n2 on top)
                      (    forth6809.asm):07063         ;    Outputs:
                      (    forth6809.asm):07064         ;        d2 on the data stack
                      (    forth6809.asm):07065         ;    Registers: RegD, RegX changed; PRODHI/PRODLO, DIVDEN, DIVREM,
                      (    forth6809.asm):07066         ;        MAHI-MBLO used. S frame: 0,S sign, 1,S P0, 3,S P1, 5,S P2.
                      (    forth6809.asm):07067         ; ------------------------------------------------------------

E455 830002           (    forth6809.asm):04577                     SUBD  #2
E458 3606             (    forth6809.asm):04578                     PSHU  D                 ; orig
E45A CC0001           (    forth6809.asm):04579                     LDD   #TAGFWD
E45D 3606             (    forth6809.asm):04580                     PSHU  D
E45F 39               (    forth6809.asm):04581                     RTS

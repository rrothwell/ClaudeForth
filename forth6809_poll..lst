                      (    forth6809.asm):05233         
                      (    forth6809.asm):05234         ; ------------------------------------------------------------
                      (    forth6809.asm):05235         ; '  ( "name" -- xt )
                      (    forth6809.asm):05236         ; Parse the next blank-delimited name and return its xt. THROW -13 if
                      (    forth6809.asm):05237         ; the name is not found.
                      (    forth6809.asm):05238         ; ------------------------------------------------------------
E81D CC0020           (    forth6809.asm):05239         TICKW:      LDD   #32
E820 3606             (    forth6809.asm):05240                     PSHU  D                 ; BL delimiter
E822 BDDEB6           (    forth6809.asm):05241                     JSR   WORDW
E825 BDDF9F           (    forth6809.asm):05242                     JSR   FINDW
E828 3706             (    forth6809.asm):05243                     PULU  D                 ; found flag
E82A 10830000         (    forth6809.asm):05244                     CMPD  #0
E82E 260A             (    forth6809.asm):05245                     BNE   TICKOK
E830 3706             (    forth6809.asm):05246                     PULU  D                 ; drop the name
E832 CCFFF3           (    forth6809.asm):05247                     LDD   #-13              ; -13
E835 3606             (    forth6809.asm):05248                     PSHU  D
E837 BDE403           (    forth6809.asm):05249                     JSR   THROWW
E83A 39               (    forth6809.asm):05250         TICKOK:     RTS
                      (    forth6809.asm):05251         
                      (    forth6809.asm):05252         ; ------------------------------------------------------------
                      (    forth6809.asm):05253         ; COMPILE,  ( xt -- )
                      (    forth6809.asm):05254         ; Compile a call to xt (see CCALL).
                      (    forth6809.asm):05255         ; ------------------------------------------------------------
E83B                  (    forth6809.asm):05256         COMPILECOMMAW:
E83B 7EE83E           (    forth6809.asm):05257                     JMP   CCALL
                      (    forth6809.asm):05258         
                      (    forth6809.asm):05259         ; ------------------------------------------------------------
                      (    forth6809.asm):05260         ; Append a JSR to xt at the code pointer CODEHERE.
                      (    forth6809.asm):05261         ; CCALL   ( xt -- )
                      (    forth6809.asm):05262         ;    Inputs:
                      (    forth6809.asm):05263         ;        xt on the data stack
                      (    forth6809.asm):05264         ;    Outputs:
                      (    forth6809.asm):05265         ;        JSR xt appended at CODEHERE; CODEHERE advanced by 3
                      (    forth6809.asm):05266         ;    Registers: RegA, RegB, RegD and RegX changed.
                      (    forth6809.asm):05267         ; ------------------------------------------------------------
E83E 9E08             (    forth6809.asm):05268         CCALL:      LDX   CODEHERE          ; X = code pointer
E840 86BD             (    forth6809.asm):05269                     LDA   #OPJSR            ; JSR opcode
E842 A780             (    forth6809.asm):05270                     STA   ,X+
E844 3706             (    forth6809.asm):05271                     PULU  D                 ; xt
E846 ED81             (    forth6809.asm):05272                     STD   ,X++              ; See bugfix: CCALL.1
E848 9F08             (    forth6809.asm):05273                     STX   CODEHERE
E84A 39               (    forth6809.asm):05274                     RTS
                      (    forth6809.asm):05275         
                      (    forth6809.asm):05276         ; ------------------------------------------------------------
                      (    forth6809.asm):05277         ; LITERAL  ( x -- )
                      (    forth6809.asm):05278         ; Compile LIT followed by x, so that x is pushed when the definition
                      (    forth6809.asm):05279         ; runs.
                      (    forth6809.asm):05280         ; ------------------------------------------------------------
E84B CCDA81           (    forth6809.asm):05281         LITERALW:   LDD   #LIT
E84E 3606             (    forth6809.asm):05282                     PSHU  D

FBA9 FC0C00110008     (    forth6809.asm):08865                     FDB   EN6,EN6L,8        ; ADDRESS-UNIT-BITS
FBAF FC1D00050022     (    forth6809.asm):08866                     FDB   EN7,EN7L,HOLDMINSIZE
                      (    forth6809.asm):08867                                             ; /HOLD

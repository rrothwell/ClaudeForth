DD8D 3706             (    forth6809.asm):03229                     PULU  D
DD8F 10830000         (    forth6809.asm):03230                     CMPD  #0
DD93 260A             (    forth6809.asm):03231                     BNE   ISFOUND
DD95 3706             (    forth6809.asm):03232                     PULU  D
DD97 CCFFF3           (    forth6809.asm):03233                     LDD   #-13
DD9A 3606             (    forth6809.asm):03234                     PSHU  D
DD9C BDE403           (    forth6809.asm):03235                     JSR   THROWW
DD9F 3710             (    forth6809.asm):03236         ISFOUND:    PULU  X
DDA1 DC00             (    forth6809.asm):03237                     LDD   STATE
DDA3 270E             (    forth6809.asm):03238                     BEQ   ISIMMED
DDA5 3610             (    forth6809.asm):03239                     PSHU  X
DDA7 BDE84B           (    forth6809.asm):03240                     JSR   LITERALW
DDAA CCDD78           (    forth6809.asm):03241                     LDD   #DEFERSTOREW
DDAD 3606             (    forth6809.asm):03242                     PSHU  D
DDAF BDE83E           (    forth6809.asm):03243                     JSR   CCALL
DDB2 39               (    forth6809.asm):03244                     RTS
DDB3 3610             (    forth6809.asm):03245         ISIMMED:    PSHU  X
DDB5 BDDD78           (    forth6809.asm):03246                     JSR   DEFERSTOREW
DDB8 39               (    forth6809.asm):03247                     RTS
                      (    forth6809.asm):03248         
                      (    forth6809.asm):03249         ; ------------------------------------------------------------
                      (    forth6809.asm):03250         ; ACTION-OF  ( "name" -- xt )  IMMEDIATE
                      (    forth6809.asm):03251         ; Return the xt currently stored in the named deferred word. When
                      (    forth6809.asm):03252         ; compiling, compile code to do so at run time. Error -13 if the name
                      (    forth6809.asm):03253         ; is not found.
                      (    forth6809.asm):03254         ; ------------------------------------------------------------

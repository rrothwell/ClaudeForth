                      (    forth6809.asm):07373         ; S"  ( "ccc<quote>" -- c-addr u )
                      (    forth6809.asm):07374         ; Parse up to the closing quote (PARSEQUOTE). When compiling, compile
                      (    forth6809.asm):07375         ; DOSTR followed by the counted string. When interpreting, copy the

                      (    forth6809.asm):08768         ; ENVIRONMENT?  ( c-addr u -- false | i*x true )
                      (    forth6809.asm):08769         ; Look up the attribute name c-addr u first in ENVTABLE (single-cell
                      (    forth6809.asm):08770         ; values), then in ENVTABLE2 (double-cell values). If found, return
                      (    forth6809.asm):08771         ; the value and true; otherwise return false. WORDLISTS is 8, the
                      (    forth6809.asm):08772         ; number of wordlists that can exist. FLOORED is false because /, MOD and /MOD use symmetric
                      (    forth6809.asm):08773         ; division.
                      (    forth6809.asm):08774         ; Original comment: shadow ENVQW.0.
                      (    forth6809.asm):08775         ; ------------------------------------------------------------
FAF6 3706             (    forth6809.asm):08776         ENVQW:      PULU  D                 ; u
FAF8 3406             (    forth6809.asm):08777                     PSHS  D                 ; frame: 2,S = u, 0,S = c-addr (5k)
FAFA 3706             (    forth6809.asm):08778                     PULU  D                 ; c-addr
FAFC 3406             (    forth6809.asm):08779                     PSHS  D
FAFE 8EFB97           (    forth6809.asm):08780                     LDX   #ENVTABLE

E87A BDDF9F           (    forth6809.asm):05313                     JSR   FINDW
E87D 3706             (    forth6809.asm):05314                     PULU  D
E87F 10830000         (    forth6809.asm):05315                     CMPD  #0
E883 260A             (    forth6809.asm):05316                     BNE   BTOK
E885 3706             (    forth6809.asm):05317                     PULU  D
E887 CCFFF3           (    forth6809.asm):05318                     LDD   #-13              ; -13
E88A 3606             (    forth6809.asm):05319                     PSHU  D
E88C BDE403           (    forth6809.asm):05320                     JSR   THROWW
E88F BDE84B           (    forth6809.asm):05321         BTOK:       JSR   LITERALW
E892 39               (    forth6809.asm):05322                     RTS
                      (    forth6809.asm):05323         
                      (    forth6809.asm):05324         ; ------------------------------------------------------------
                      (    forth6809.asm):05325         ; POSTPONE  ( "name" -- )
                      (    forth6809.asm):05326         ; If the name is immediate, compile a call to it now. Otherwise
                      (    forth6809.asm):05327         ; compile its xt as a literal followed by a call to COMPILE, so that
                      (    forth6809.asm):05328         ; it is compiled when the enclosing definition runs. THROW -14 if not
                      (    forth6809.asm):05329         ; compiling, -13 if the name is not found.
                      (    forth6809.asm):05330         ; ------------------------------------------------------------
E893 DC00             (    forth6809.asm):05331         POSTPONEW:  LDD   STATE
E895 2608             (    forth6809.asm):05332                     BNE   PPSTOK
E897 CCFFF2           (    forth6809.asm):05333                     LDD   #-14              ; -14
E89A 3606             (    forth6809.asm):05334                     PSHU  D
E89C BDE403           (    forth6809.asm):05335                     JSR   THROWW
E89F CC0020           (    forth6809.asm):05336         PPSTOK:     LDD   #32
E8A2 3606             (    forth6809.asm):05337                     PSHU  D
E8A4 BDDEB6           (    forth6809.asm):05338                     JSR   WORDW
E8A7 BDDF9F           (    forth6809.asm):05339                     JSR   FINDW
E8AA 3706             (    forth6809.asm):05340                     PULU  D
E8AC 10830000         (    forth6809.asm):05341                     CMPD  #0
E8B0 260A             (    forth6809.asm):05342                     BNE   PPFOUND
E8B2 3706             (    forth6809.asm):05343                     PULU  D
E8B4 CCFFF3           (    forth6809.asm):05344                     LDD   #-13              ; -13
E8B7 3606             (    forth6809.asm):05345                     PSHU  D
E8B9 BDE403           (    forth6809.asm):05346                     JSR   THROWW
E8BC 10830001         (    forth6809.asm):05347         PPFOUND:    CMPD  #1                ; 1 = immediate
E8C0 270C             (    forth6809.asm):05348                     BEQ   PPIMM
E8C2 BDE84B           (    forth6809.asm):05349                     JSR   LITERALW
E8C5 CCE83B           (    forth6809.asm):05350                     LDD   #COMPILECOMMAW
E8C8 3606             (    forth6809.asm):05351                     PSHU  D
E8CA BDE83E           (    forth6809.asm):05352                     JSR   CCALL
E8CD 39               (    forth6809.asm):05353                     RTS
E8CE BDE83B           (    forth6809.asm):05354         PPIMM:      JSR   COMPILECOMMAW
E8D1 39               (    forth6809.asm):05355                     RTS
                      (    forth6809.asm):05356         
                      (    forth6809.asm):05357         ; ------------------------------------------------------------
                      (    forth6809.asm):05358         ; [COMPILE]  ( "name" -- )
                      (    forth6809.asm):05359         ; Compile a call to the next name, whether or not it is immediate.
                      (    forth6809.asm):05360         ; Obsolescent: POSTPONE is the general replacement. THROW -14 if not
                      (    forth6809.asm):05361         ; compiling, -13 if the name is not found.
                      (    forth6809.asm):05362         ; Original comment: shadow BRACKCOMPILEW.0.
                      (    forth6809.asm):05363         ; ------------------------------------------------------------
E8D2                  (    forth6809.asm):05364         BRACKCOMPILEW:
E8D2 DC00             (    forth6809.asm):05365                     LDD   STATE

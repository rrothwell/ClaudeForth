                      (    forth6809.asm):05396         ; ------------------------------------------------------------
                      (    forth6809.asm):05397         ; SLITERAL  ( c-addr u -- )
                      (    forth6809.asm):05398         ; Compile DOSTR followed by a count byte and a copy of the string.
                      (    forth6809.asm):05399         ; THROW -14 if not compiling.
                      (    forth6809.asm):05400         ; ------------------------------------------------------------
E90B DC00             (    forth6809.asm):05401         SLITERALW:  LDD   STATE
E90D 2608             (    forth6809.asm):05402                     BNE   SLSTOK
E90F CCFFF2           (    forth6809.asm):05403                     LDD   #-14
E912 3606             (    forth6809.asm):05404                     PSHU  D
E914 BDE403           (    forth6809.asm):05405                     JSR   THROWW
E917 CCF289           (    forth6809.asm):05406         SLSTOK:     LDD   #DOSTR
E91A 7EF2AE           (    forth6809.asm):05407                     JMP   CSTRCOMP          ; compile DOSTR and the counted string
                      (    forth6809.asm):05408         
                      (    forth6809.asm):05409         ; ------------------------------------------------------------
                      (    forth6809.asm):05410         ; Run-time part of ABORT". The counted string follows the call. If
                      (    forth6809.asm):05411         ; flag is non-zero, TYPE the string and THROW -2; otherwise skip over
                      (    forth6809.asm):05412         ; the string.
                      (    forth6809.asm):05413         ; DOABORTQUOTE   ( flag -- )
                      (    forth6809.asm):05414         ;    Inputs:
                      (    forth6809.asm):05415         ;        flag on the data stack; return address on S points at the
                      (    forth6809.asm):05416         ;        count byte
                      (    forth6809.asm):05417         ;    Outputs:
                      (    forth6809.asm):05418         ;        execution continues after the string, or THROW -2
                      (    forth6809.asm):05419         ;    Registers: RegA, RegB, RegD, RegX, RegY changed.
                      (    forth6809.asm):05420         ; ------------------------------------------------------------
E91D                  (    forth6809.asm):05421         DOABORTQUOTE:
E91D 3510             (    forth6809.asm):05422                     PULS  X
E91F E684             (    forth6809.asm):05423                     LDB   ,X
E921 3001             (    forth6809.asm):05424                     LEAX  1,X               ; X = text, B = length
E923 4F               (    forth6809.asm):05425                     CLRA
E924 3720             (    forth6809.asm):05426                     PULU  Y                 ; flag
E926 108C0000         (    forth6809.asm):05427                     CMPY  #0
E92A 2605             (    forth6809.asm):05428                     BNE   AQTHROW
E92C 3085             (    forth6809.asm):05429                     LEAX  B,X
E92E 3410             (    forth6809.asm):05430                     PSHS  X
E930 39               (    forth6809.asm):05431                     RTS
E931 3610             (    forth6809.asm):05432         AQTHROW:    PSHU  X
E933 3606             (    forth6809.asm):05433                     PSHU  D
E935 BDF412           (    forth6809.asm):05434                     JSR   TYPEW
E938 CCFFFE           (    forth6809.asm):05435                     LDD   #-2               ; -2
E93B 3606             (    forth6809.asm):05436                     PSHU  D
E93D 7EE403           (    forth6809.asm):05437                     JMP   THROWW
                      (    forth6809.asm):05438         
                      (    forth6809.asm):05439         ; ------------------------------------------------------------
                      (    forth6809.asm):05440         ; ABORT"  ( "ccc<quote>" -- )
                      (    forth6809.asm):05441         ; Compile DOABORTQUOTE followed by the string up to the closing quote
                      (    forth6809.asm):05442         ; as a counted string. THROW -14 if not compiling.
                      (    forth6809.asm):05443         ; ------------------------------------------------------------
E940                  (    forth6809.asm):05444         ABORTQUOTEW:
E940 DC00             (    forth6809.asm):05445                     LDD   STATE
E942 2608             (    forth6809.asm):05446                     BNE   AQSTOK
E944 CCFFF2           (    forth6809.asm):05447                     LDD   #-14
E947 3606             (    forth6809.asm):05448                     PSHU  D
E949 BDE403           (    forth6809.asm):05449                     JSR   THROWW
E94C BDF299           (    forth6809.asm):05450         AQSTOK:     JSR   PARSEQUOTE        ; See bugfix: SQUOTEW.3
E94F CCE91D           (    forth6809.asm):05451                     LDD   #DOABORTQUOTE
E952 7EF2AE           (    forth6809.asm):05452                     JMP   CSTRCOMP

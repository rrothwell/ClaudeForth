                      (    forth6809.asm):04080         ; ------------------------------------------------------------
                      (    forth6809.asm):04081         ; Convert a counted string to a number in BASE. A leading "-" negates
                      (    forth6809.asm):04082         ; it; a trailing "." makes it a double-cell number.
                      (    forth6809.asm):04083         ; NUMBERQ   ( c-addr -- n -1 | ud 1 | c-addr 0 )
                      (    forth6809.asm):04084         ;    Inputs:
                      (    forth6809.asm):04085         ;        c-addr of the counted string on the data stack
                      (    forth6809.asm):04086         ;    Outputs:
                      (    forth6809.asm):04087         ;        single number: n and -1
                      (    forth6809.asm):04088         ;        double number: ud (low cell below high cell) and 1
                      (    forth6809.asm):04089         ;        not a number: c-addr and 0
                      (    forth6809.asm):04090         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):04091         ; The original c-addr and the negate flag live in an S frame (0,S and
                      (    forth6809.asm):04092         ; 2,S); the count is kept in RegB. See shadow NUMBERQ.1 and
                      (    forth6809.asm):04093         ; NUMBERQ.6.
                      (    forth6809.asm):04094         ; ------------------------------------------------------------
E247 3710             (    forth6809.asm):04095         NUMBERQ:    PULU  X                 ; c-addr
E249 327D             (    forth6809.asm):04096                     LEAS  -3,S
E24B AFE4             (    forth6809.asm):04097                     STX   ,S
E24D E684             (    forth6809.asm):04098                     LDB   ,X
E24F 276D             (    forth6809.asm):04099                     BEQ   NQBAD
E251 3001             (    forth6809.asm):04100                     LEAX  1,X
                      (    forth6809.asm):04101         
                      (    forth6809.asm):04102                     ; A trailing "." means a double number: leave it out of the
                      (    forth6809.asm):04103                     ; digit count. See shadow: NUMBERQ.1
E253 5A               (    forth6809.asm):04104                     DECB
E254 A685             (    forth6809.asm):04105                     LDA   B,X
E256 5C               (    forth6809.asm):04106                     INCB
E257 812E             (    forth6809.asm):04107                     CMPA  #'.'
E259 2603             (    forth6809.asm):04108                     BNE   NQNOSIGN
E25B 5A               (    forth6809.asm):04109                     DECB
E25C 2760             (    forth6809.asm):04110                     BEQ   NQBAD             ; lone "." with nothing before it
                      (    forth6809.asm):04111         
E25E 6F62             (    forth6809.asm):04112         NQNOSIGN:   CLR   2,S
E260 A684             (    forth6809.asm):04113                     LDA   ,X
E262 812D             (    forth6809.asm):04114                     CMPA  #'-'
E264 2607             (    forth6809.asm):04115                     BNE   NQNOSIGN2
E266 6362             (    forth6809.asm):04116                     COM   2,S
E268 3001             (    forth6809.asm):04117                     LEAX  1,X
E26A 5A               (    forth6809.asm):04118                     DECB
E26B 2751             (    forth6809.asm):04119                     BEQ   NQBAD
                      (    forth6809.asm):04120         
E26D 108E0000         (    forth6809.asm):04121         NQNOSIGN2:  LDY   #0
E271 3620             (    forth6809.asm):04122                     PSHU  Y                 ; ud low
E273 3620             (    forth6809.asm):04123                     PSHU  Y                 ; ud high
E275 3610             (    forth6809.asm):04124                     PSHU  X                 ; c-addr
E277 4F               (    forth6809.asm):04125                     CLRA
E278 3606             (    forth6809.asm):04126                     PSHU  D                 ; u
                      (    forth6809.asm):04127         
E27A BDE20E           (    forth6809.asm):04128                     JSR   NUMLOOP
                      (    forth6809.asm):04129         
E27D ECC4             (    forth6809.asm):04130                     LDD   ,U
E27F 263B             (    forth6809.asm):04131                     BNE   NQBADF            ; unconverted characters remain
E281 3344             (    forth6809.asm):04132                     LEAU  4,U               ; drop u and c-addr: ud remains
                      (    forth6809.asm):04133         
                      (    forth6809.asm):04134                     ; Negate the full 32-bit value. See bugfix: NUMBERQ.2
E283 6D62             (    forth6809.asm):04135                     TST   2,S
E285 2718             (    forth6809.asm):04136                     BEQ   NQPOS32
E287 ECC4             (    forth6809.asm):04137                     LDD   ,U
E289 43               (    forth6809.asm):04138                     COMA
E28A 53               (    forth6809.asm):04139                     COMB
E28B EDC4             (    forth6809.asm):04140                     STD   ,U
E28D EC42             (    forth6809.asm):04141                     LDD   2,U
E28F 43               (    forth6809.asm):04142                     COMA
E290 53               (    forth6809.asm):04143                     COMB
E291 C30001           (    forth6809.asm):04144                     ADDD  #1
E294 ED42             (    forth6809.asm):04145                     STD   2,U
E296 2407             (    forth6809.asm):04146                     BCC   NQPOS32
E298 ECC4             (    forth6809.asm):04147                     LDD   ,U
E29A C30001           (    forth6809.asm):04148                     ADDD  #1
E29D EDC4             (    forth6809.asm):04149                     STD   ,U
                      (    forth6809.asm):04150         
E29F                  (    forth6809.asm):04151         NQPOS32:                            ; re-derive from the original c-addr whether the
                      (    forth6809.asm):04152                     ; last character was '.' - determines which return convention
E29F AEE4             (    forth6809.asm):04153                     LDX   ,S
E2A1 E684             (    forth6809.asm):04154                     LDB   ,X
E2A3 5A               (    forth6809.asm):04155                     DECB
E2A4 3001             (    forth6809.asm):04156                     LEAX  1,X
E2A6 A685             (    forth6809.asm):04157                     LDA   B,X
E2A8 3263             (    forth6809.asm):04158                     LEAS  3,S
E2AA 812E             (    forth6809.asm):04159                     CMPA  #'.'
E2AC 2606             (    forth6809.asm):04160                     BNE   NQSINGLE
                      (    forth6809.asm):04161         

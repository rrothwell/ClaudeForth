                      (    forth6809.asm):05384         ; ------------------------------------------------------------
                      (    forth6809.asm):05385         ; >BODY  ( xt -- a-addr )
                      (    forth6809.asm):05386         ; Return the data-field address of a CREATEd word: the cell at xt+5 of
                      (    forth6809.asm):05387         ; its JSR DODOES trampoline.
                      (    forth6809.asm):05388         ; ------------------------------------------------------------
E8FF 3706             (    forth6809.asm):05389         TOBODYW:    PULU  D                 ; xt

E9AA 44               (    forth6809.asm):05559                     LSRA
E9AB 56               (    forth6809.asm):05560                     RORB
E9AC 3606             (    forth6809.asm):05561                     PSHU  D                 ; +n
E9AE 39               (    forth6809.asm):05562                     RTS
                      (    forth6809.asm):05563         

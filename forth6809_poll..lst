                      (    forth6809.asm):08272         ; ------------------------------------------------------------
                      (    forth6809.asm):08273         ; <#  ( -- )
                      (    forth6809.asm):08274         ; Start a pictured numeric output string: HLD is set to the end of
                      (    forth6809.asm):08275         ; PAD. The string is built backwards from there.
                      (    forth6809.asm):08276         ; ------------------------------------------------------------
F86A BDDB61           (    forth6809.asm):08277         LTNUMW:     JSR   PADW

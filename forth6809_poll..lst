FBC1 FC2D000800FF     (    forth6809.asm):08871                     FDB   EN10,EN10L,255    ; MAX-CHAR
FBC7 FC3500120180     (    forth6809.asm):08872                     FDB   EN13,EN13L,(RSTACK-DSTACK)/2
                      (    forth6809.asm):08873                                             ; RETURN-STACK-CELLS
